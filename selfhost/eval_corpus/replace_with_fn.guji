# §13 / §15.3 (I7g): replace_with with FUNCTION-VALUED callbacks — bound
# lambda (named + positional captures), bare top-level `sub` as a Func value
# (free form), and alias of a bound callback. Pins D materializing NamedSub
# keys so `shout` is no longer `undefined name`.
sub shout($m: Match): Str {
    '<' ~ $m.text ~ '>'
}

sub main(): Int {
    $f = sub($m: Match): Str {
        '[' ~ $m<word>.unwrap() ~ ':' ~ $m[1].unwrap() ~ ']'
    }
    $r1 = 'one two'.replace_with(/(?<word>\w+)/, $f)
    print($r1)

    $r2 = replace_with('a1b2', /\d/, shout)
    print($r2)

    # alias: copying a callback binding keeps its signature
    $g = $f
    $r3 = 'hi'.replace_with(/(?<word>h)/, $g)
    print($r3)

    # method form also accepts a bare top-level sub as the callback
    $r4 = 'x9'.replace_with(/\d/, shout)
    print($r4)

    0
}
