# I8b3 twin of ident_left with distinct method bodies.
pub class Point {
    has $.x: Int
    sub label($self): Str { "right-{ $self.x }" }
}
pub enum Tag {
    Hot
    Cold
    sub pick($n: Int): Tag {
        if $n > 0 { Hot } else { Cold }
    }
    sub mark($self): Str {
        match $self {
            Hot { "RH" }
            Cold { "RC" }
        }
    }
}
