# §11.1 `?` operator — early-return propagation of an Option through a chain.
sub lookup($n: Int): Option[Int] {
    if $n > 0 { Some($n) } else { None }
}
sub chained($n: Int): Option[Int] {
    $v = lookup($n)?
    Some($v + 100)
}
sub main(): Int {
    print("{ chained(5).unwrap_or(-1) }")
    print("{ chained(-2).unwrap_or(-1) }")
    0
}
