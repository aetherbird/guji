# I10c2b: drain List[Int] / Map[Str,Str] / scalar-payload enum channels. Wire
# payloads convert back to VList/VMap/VVariant before binding the loop variable.
sub eval_for_chan_list_int($vars: StrList, $ch: Chan[WireIntList], $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
