# §11.1 `?`: success unwraps in place; absence/failure uses the existing
# returned-flow channel so every enclosing expression/statement stops and the
# nearest user-call boundary receives the original carrier. If the operand
# itself already triggered an early return, preserve it unchanged. Kept outside
# the exhaustive evaluator match to preserve its bootstrap-critical flat shape.
sub apply_question_variant($tag: Str, $fields: ValueList, $carrier: Value, $env: Env): Result[EvalResult, Str] {
    if $tag == "Some" || $tag == "Ok" {
        match $fields {
            ValCons($v, ValNil) { Ok(flow($v, $env)) }
            _ { Err(eval_err("? requires an Option or Result value")) }
        }
    } else if $tag == "None" {
        match $fields {
            ValNil { Ok(return_flow($carrier, $env)) }
            _ { Err(eval_err("? requires an Option or Result value")) }
        }
    } else if $tag == "Err" {
        match $fields {
            ValCons($e, ValNil) { Ok(return_flow($carrier, $env)) }
            _ { Err(eval_err("? requires an Option or Result value")) }
        }
    } else {
        Err(eval_err("? requires an Option or Result value"))
    }
}

sub apply_question_value($value: Value, $env: Env): Result[EvalResult, Str] {
    match $value {
        VVariant($tag, $fields, $eid) { apply_question_variant($tag, $fields, $value, $env) }
        _ { Err(eval_err("? requires an Option or Result value")) }
    }
}

sub eval_question($x: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($x, $subs, $env) {
        Err($e) { Err($e) }
        Ok($r) {
            if $r.returned {
                Ok($r)
            } else {
                apply_question_value($r.value, $r.env)
            }
        }
    }
}

# The core expression evaluator. EXHAUSTIVE over Expr; arms marked "(E2)"/"(E3)"
# are filled in by the corresponding later slice.
sub eval_expr_flow($e: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $e {
        EInt($t) {
            match parse_int_lit($t) {
                Ok($n) { Ok(flow(VInt($n), $env)) }
                Err($m) { Err($m) }
            }
        }
        EFloat($t) { Ok(flow(VFloat(eval_float_literal($t)), $env)) }
        EStr($t) { eval_interpolated_str($t, $subs, $env) }
        ERawStr($t) { Ok(flow(VStr($t), $env)) }
        # §13 Regex literals are first-class values. I7d evaluates dynamic
        # splice parts with the same host-text/Str/Regex rules as native C.
        ERegex($p, $l, $c) {
            if g6_regex_pattern_has_splice($p) {
                eval_spliced_regex($p, $l, $c, $subs, $env)
            } else {
                Ok(flow(VRegex($p, false), $env))
            }
        }
        EQualified($m, $n) {
            $qualified = import_qualified_name($m, $n)
            match subtable_lookup($subs, $qualified) {
                Some($s) { Ok(flow(VFunction(named_sub_fn_key($qualified), EnvNil), $env)) }
                None { Err(eval_err("module " ~ $m ~ " has no value member " ~ $n)) }
            }
        }
        EBool($t) { Ok(flow(VBool($t == "true"), $env)) }
        EName($n) {
            # Value-position bare names: Env bindings first, then a top-level
            # `sub` materialized as a §7.4 function value (I7g). Matches the
            # typechecker's SemSubTable fallback so `replace_with(..., shout)`
            # and HOF callbacks agree with C. Calls still resolve via
            # eval_call's subtable path without needing this materialization.
            match env_lookup($env, $n) {
                Some($v) { Ok(flow($v, $env)) }
                None {
                    match subtable_lookup($subs, $n) {
                        Some($s) { Ok(flow(VFunction(named_sub_fn_key($n), EnvNil), $env)) }
                        None {
                            # §15.4 standard Handle values (not calls). User subs /
                            # bindings above still win, matching the typechecker.
                            if $n == "stdin" || $n == "stdout" || $n == "stderr" {
                                Ok(flow(VHandle($n), $env))
                            } else {
                                Err(eval_err("undefined name: " ~ $n))
                            }
                        }
                    }
                }
            }
        }
        # A bare PascalCase name is a zero-field variant constructor (`None` /
        # user-enum nullary). User enums stamp a stable eid (I8b3).
        ETypeName($n) {
            $eid = match enum_for_variant($subs, $n) {
                Some($e) { enum_instance_id($e, $subs) }
                None { "" }
            }
            Ok(flow(VVariant($n, ValNil, $eid), $env))
        }
        EUnit { Ok(flow(VUnit, $env)) }
        EUnary($op, $x) { eval_unary($op, $x, $subs, $env) }
        EBinary($op, $l, $r) { eval_binary($op, $l, $r, $subs, $env) }
        ENamedArg($n, $v) { eval_expr_flow($v, $subs, $env) }
        ECall($callee, $args) { eval_call($callee, $args, $subs, $env) }
        EList($items) { eval_list($items, $subs, $env) }
        EMap($items) { eval_map($items, $subs, $env) }
        EField($o, $n) { eval_field($o, $n, $subs, $env) }
        EIndex($o, $i) { eval_index($o, $i, $subs, $env) }
        ECapture($o, $n) { eval_capture($o, $n, $subs, $env) }
        EIf($c, $then, $elifs, $els) { eval_if($c, $then, $elifs, $els, $subs, $env) }
        EMatch($subject, $arms) { eval_match($subject, $arms, $subs, $env) }
        ELambda($params, $ret, $body, $topic) {
            # I4a–I4c: parameterized and topic-block lambdas are both function
            # values. Topic blocks are already one-param lambdas over `$_`
            # (parser); each nested topic gets its own frame binding for `$_`.
            # Snapshot the creation-time Env for §7.4 immutable lexical capture.
            Ok(flow(VFunction(canon_expr($e), $env), $env))
        }
        EQuestion($x) { eval_question($x, $subs, $env) }
    }
}

pub sub eval_expr($e: Expr, $subs: SubTable, $env: Env): Result[Value, Str] {
    match eval_expr_flow($e, $subs, $env) {
        Err($err) { Err($err) }
        Ok($r) { Ok($r.value) }
    }
}

# ---- statement / block evaluation (E2) ----

# Option/Result channel arms that WireEnum can carry. I10g2 added flat
# scalar/Str arms; recursive List/Map graphs use the same WEWire* encoding at
# every depth. I10g4 adds Match/Bush/Regex text carriers (and their
# Option/Result forms).
sub chan_elem_key_flat($ty: TypeRef): Bool {
    $ty.name == "Int" || $ty.name == "Bool" || $ty.name == "Float" || $ty.name == "Str"
}

# Channel collection payloads are recursively representable as WEWireListCons /
# WEWireMapCons nodes. Maps remain Str-keyed, matching the language's Map ABI.
sub chan_elem_key_collection($ty: TypeRef): Bool {
    if chan_elem_key_flat($ty) {
        true
    } else if $ty.name == "List" {
        match $ty.args {
            TypeCons($inner, TypeNil) { chan_elem_key_collection($inner) }
            _ { false }
        }
    } else if $ty.name == "Map" {
        match $ty.args {
            TypeCons($key, TypeCons($value, TypeNil)) {
                $key.name == "Str" && chan_elem_key_collection($value)
            }
            _ { false }
        }
    } else {
        false
    }
}

sub chan_elem_key_option_payload($ty: TypeRef): Bool {
    if $ty.name == "Match" || $ty.name == "Bush" || $ty.name == "Regex" {
        true
    } else {
        chan_elem_key_collection($ty)
    }
}

sub chan_elem_key_result_slot($ty: TypeRef): Bool {
    if $ty.name == "Match" || $ty.name == "Bush" || $ty.name == "Regex" {
        true
    } else {
        chan_elem_key_collection($ty)
    }
}

# Mirrors g11_chan_list_elem_supported: recursively supported collection leaves.
# List[Int] keeps the dedicated WireIntList path; other admitted List shapes
# ride WireEnum collection nodes (I10g3).
sub chan_elem_key_list_channel($ty: TypeRef): Bool {
    $ty.name == "List" && chan_elem_key_collection($ty)
}

# Mirrors g11_chan_map_val_supported: recursively supported collection leaves.
# Map[Str,Str] keeps WireStrMap; other admitted Map shapes ride WireEnum.
sub chan_elem_key_map_channel($ty: TypeRef): Bool {
    $ty.name == "Map" && chan_elem_key_collection($ty)
}

# Chan[T] element key from a TypeRef for channel()/for builders. Scalars keep
# their type name; List[Int]/Map[Str,Str]/user-enum keys are I10c2b;
# nested List/Map channel shapes reuse WireEnum (I10g3); Option/Result collection
# graphs use that same recursive representation. Unknown shapes return "" so
# callers fall through as undefined function: channel.
sub chan_elem_key($ty: TypeRef, $subs: SubTable): Str {
    if $ty.name != "Chan" {
        ""
    } else {
        match $ty.args {
            TypeCons($el, TypeNil) {
                if $el.name == "Unit" || $el.name == "Int" || $el.name == "Bool" || $el.name == "Float" || $el.name == "Str" {
                    $el.name
                } else if $el.name == "List" {
                    match $el.args {
                        TypeCons($inner, TypeNil) {
                            if $inner.name == "Int" {
                                "ListInt"
                            } else if chan_elem_key_list_channel($el) {
                                "Enum"
                            } else {
                                ""
                            }
                        }
                        _ { "" }
                    }
                } else if $el.name == "Map" {
                    match $el.args {
                        TypeCons($k, TypeCons($v, TypeNil)) {
                            if $k.name == "Str" && $v.name == "Str" {
                                "MapStr"
                            } else if chan_elem_key_map_channel($el) {
                                "Enum"
                            } else {
                                ""
                            }
                        }
                        _ { "" }
                    }
                } else if $el.name == "Option" {
                    match $el.args {
                        TypeCons($inner, TypeNil) {
                            if chan_elem_key_option_payload($inner) { "Enum" } else { "" }
                        }
                        _ { "" }
                    }
                } else if $el.name == "Result" {
                    match $el.args {
                        TypeCons($ok, TypeCons($err, TypeNil)) {
                            if chan_elem_key_result_slot($ok) && chan_elem_key_result_slot($err) { "Enum" } else { "" }
                        }
                        _ { "" }
                    }
                } else if $el.name == "Func" {
                    # I10g5b: Func payloads ride Chan[WireEnum] as WEFunction.
                    "Enum"
                } else {
                    match enumtable_lookup($subs, $el.name) {
                        Some($en) { "Enum" }
                        None { "" }
                    }
                }
            }
            _ { "" }
        }
    }
}

# Host channel() for one supported element kind. Capacity must already be >= 0.
sub eval_channel_make($elem: Str, $cap: Int): Result[Value, Str] {
    if $elem == "Unit" {
        $ch: Chan[Unit] = channel($cap)
        Ok(VChanUnit($ch))
    } else if $elem == "Int" {
        $ch: Chan[Int] = channel($cap)
        Ok(VChanInt($ch))
    } else if $elem == "Bool" {
        $ch: Chan[Bool] = channel($cap)
        Ok(VChanBool($ch))
    } else if $elem == "Float" {
        $ch: Chan[Float] = channel($cap)
        Ok(VChanFloat($ch))
    } else if $elem == "Str" {
        $ch: Chan[Str] = channel($cap)
        Ok(VChanStr($ch))
    } else if $elem == "ListInt" {
        $ch: Chan[WireIntList] = channel($cap)
        Ok(VChanListInt($ch))
    } else if $elem == "MapStr" {
        $ch: Chan[WireStrMap] = channel($cap)
        Ok(VChanMapStr($ch))
    } else if $elem == "Enum" {
        $ch: Chan[WireEnum] = channel($cap)
        Ok(VChanEnum($ch))
    } else {
        Err(eval_err("undefined function: channel"))
    }
}

# §17.2 channel([capacity]) after a concrete scalar Chan[T] context is known.
# Negative capacity matches C's guji_chan_new panic text.
sub eval_channel_call($elem: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $args {
        ExprNil {
            match eval_channel_make($elem, 0) {
                Err($e) { Err($e) }
                Ok($v) { Ok(flow($v, $env)) }
            }
        }
        ExprCons($cap_expr, ExprNil) {
            match eval_expr_flow($cap_expr, $subs, $env) {
                Err($e) { Err($e) }
                Ok($r) {
                    if $r.returned {
                        Ok($r)
                    } else {
                        match $r.value {
                            VInt($n) {
                                if $n < 0 {
                                    Err(eval_err("channel capacity must be non-negative"))
                                } else {
                                    match eval_channel_make($elem, $n) {
                                        Err($e) { Err($e) }
                                        Ok($v) { Ok(flow($v, $r.env)) }
                                    }
                                }
                            }
                            _ { Err(eval_err("channel capacity must be Int")) }
                        }
                    }
                }
            }
        }
        _ { Err(eval_err("channel() takes at most one argument (the buffer capacity)")) }
    }
}

# True when `$e` is a bare `channel(...)` call and no user `sub channel` shadows.
sub is_channel_builder_call($e: Expr, $subs: SubTable): Bool {
    match $e {
        ECall(EName($n), $args) {
            if $n == "channel" {
                match subtable_lookup($subs, "channel") {
                    Some($s) { false }
                    None { true }
                }
            } else {
                false
            }
        }
        _ { false }
    }
}

sub channel_builder_args($e: Expr): ExprList {
    match $e {
        ECall($c, $args) { $args }
        _ { ExprNil }
    }
}

# Evaluate an expression that may be context-typed `channel()` under `$ty`.
sub eval_expr_chan_ctx($e: Expr, $ty: Option[TypeRef], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $ty {
        Some($tr) {
            $elem = chan_elem_key($tr, $subs)
            if $elem == "" || !is_channel_builder_call($e, $subs) {
                eval_expr_flow($e, $subs, $env)
            } else {
                eval_channel_call($elem, channel_builder_args($e), $subs, $env)
            }
        }
        None { eval_expr_flow($e, $subs, $env) }
    }
}

sub eval_bind_stmt($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value_expr: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_chan_ctx($value_expr, $ty, $subs, $env) {
        Err($e) { Err($e) }
        Ok($r) {
            if $r.returned {
                Ok($r)
            } else if $mutable {
                Ok(flow(VUnit, env_define_mut($r.env, $name, $r.value)))
            } else {
                match env_set($r.env, $name, $r.value) {
                    Err($e) { Err($e) }
                    Ok($new_env) { Ok(flow(VUnit, $new_env)) }
                }
            }
        }
    }
}

# Strip the evaluator's "panic: " prefix so host `panic` prints the guest
# message exactly once (guji_panic adds its own prefix).
sub hatch_panic_msg($e: Str): Str {
    if starts_with($e, "panic: ") {
        drop(split($e, ""), 7).join("")
    } else {
        $e
    }
}

# Guest hatch body runner invoked from the I10d1 private Func. Lives in a
# named sub (not the lambda body) so Result match / panic / exit lower; the
# lambda only forwards captured StmtList/SubTable/Env. Status 0 is success;
# panic/exit terminate the process before returning.
sub eval_hatch_task_run($body: StmtList, $subs: SubTable, $env: Env): Int {
    match eval_stmt_list($body, $subs, EnvFrame(BindNil, $env)) {
        Err($e) {
            match parse_exit_signal($e) {
                Some($code) { exit($code) }
                None { panic(hatch_panic_msg($e)) }
            }
        }
        Ok($r) { 0 }
    }
}

# I12a: deep-snapshot one guest Value for a hatch task. Counted payloads
# (Str/List/Map/class/enum/…) round-trip through the existing function-channel
# wire so the child owns an independent graph; Chan and file Handle values keep
# host identity (same rendezvous / reader); ranges copy by value.
#
# §17 / I12b: Str leaves must be detached (`~ ""` = guji_str_copy) so parent and
# child never share non-atomic Str RC. Match/Bush/Regex rebuild without WireEnum
# so a drained Chan[Result[Bush]] still sitting in the full Env cannot race the
# recursive WireEnum heap when the hatch only needs Match text carriers.
sub str_detach($s: Str): Str {
    $s ~ ""
}

sub hatch_snapshot_strlist($ns: StrList): StrList {
    match $ns {
        StrNil { StrNil }
        StrCons($h, $t) { StrCons(str_detach($h), hatch_snapshot_strlist($t)) }
    }
}

sub hatch_snapshot_value_list($xs: ValueList): Result[ValueList, Str] {
    match $xs {
        ValNil { Ok(ValNil) }
        ValCons($h, $t) {
            match hatch_snapshot_value($h) {
                Err($e) { Err($e) }
                Ok($sh) {
                    match hatch_snapshot_value_list($t) {
                        Err($e) { Err($e) }
                        Ok($st) { Ok(ValCons($sh, $st)) }
                    }
                }
            }
        }
    }
}

sub hatch_snapshot_value($v: Value): Result[Value, Str] {
    match $v {
        VChanUnit($ch) { Ok(VChanUnit($ch)) }
        VChanInt($ch) { Ok(VChanInt($ch)) }
        VChanBool($ch) { Ok(VChanBool($ch)) }
        VChanFloat($ch) { Ok(VChanFloat($ch)) }
        VChanStr($ch) { Ok(VChanStr($ch)) }
        VChanListInt($ch) { Ok(VChanListInt($ch)) }
        VChanMapStr($ch) { Ok(VChanMapStr($ch)) }
        VChanEnum($ch) { Ok(VChanEnum($ch)) }
        VFileHandle($h) { Ok(VFileHandle($h)) }
        VHandle($stream) { Ok(VHandle($stream)) }
        VRange($from, $to, $open) { Ok(VRange($from, $to, $open)) }
        VStr($s) { Ok(VStr(str_detach($s))) }
        VRegex($p, $private) { Ok(VRegex(str_detach($p), $private)) }
        VMatch($text, $names, $groups) {
            match hatch_snapshot_value_list($groups) {
                Err($e) { Err($e) }
                Ok($gs) {
                    Ok(VMatch(str_detach($text), hatch_snapshot_strlist($names), $gs))
                }
            }
        }
        VBush($name, $text, $caps) {
            match hatch_snapshot_value_list($caps) {
                Err($e) { Err($e) }
                Ok($cs) {
                    Ok(VBush(str_detach($name), str_detach($text), $cs))
                }
            }
        }
        VVariant($tag, $fields, $eid) {
            match hatch_snapshot_value_list($fields) {
                Err($e) { Err($e) }
                Ok($fs) {
                    Ok(VVariant(str_detach($tag), $fs, str_detach($eid)))
                }
            }
        }
        _ {
            match wire_cap_value($v) {
                Err($e) { Err($e) }
                Ok($w) { Ok(value_from_cap_wire($w)) }
            }
        }
    }
}

# I12b: only snapshot bindings whose names are free in the hatch body. Capturing
# the entire Env shared drained Chan[Result[Bush]] / WireEnum handles into tasks
# that only need Match/Bush/Regex text carriers, and that concurrent release
# raced the allocator (channel_text_carriers). C already captures free vars only.
sub strlist_has($xs: StrList, $want: Str): Bool {
    match $xs {
        StrNil { false }
        StrCons($h, $t) { if $h == $want { true } else { strlist_has($t, $want) } }
    }
}

sub strlist_add($xs: StrList, $name: Str): StrList {
    if strlist_has($xs, $name) { $xs } else { StrCons($name, $xs) }
}

sub strlist_union($a: StrList, $b: StrList): StrList {
    match $a {
        StrNil { $b }
        StrCons($h, $t) { strlist_add(strlist_union($t, $b), $h) }
    }
}

sub strlist_without($xs: StrList, $drop: StrList): StrList {
    match $xs {
        StrNil { StrNil }
        StrCons($h, $t) {
            if strlist_has($drop, $h) {
                strlist_without($t, $drop)
            } else {
                StrCons($h, strlist_without($t, $drop))
            }
        }
    }
}

sub hatch_expr_names($e: Expr): StrList {
    match $e {
        EName($n) { StrCons($n, StrNil) }
        EStr($text) { hatch_interp_names($text) }
        ERawStr($text) { StrNil }
        EUnary($op, $x) { hatch_expr_names($x) }
        EBinary($op, $l, $r) { strlist_union(hatch_expr_names($l), hatch_expr_names($r)) }
        ECall($c, $args) { strlist_union(hatch_expr_names($c), hatch_expr_list_names($args)) }
        EField($obj, $name) { hatch_expr_names($obj) }
        EIndex($obj, $idx) { strlist_union(hatch_expr_names($obj), hatch_expr_names($idx)) }
        ECapture($obj, $name) { hatch_expr_names($obj) }
        ENamedArg($n, $v) { hatch_expr_names($v) }
        EQuestion($x) { hatch_expr_names($x) }
        EIf($cond, $then, $elifs, $els) {
            strlist_union(
                hatch_expr_names($cond),
                strlist_union(
                    hatch_stmt_list_names($then),
                    strlist_union(hatch_elif_names($elifs), hatch_opt_stmt_list_names($els))
                )
            )
        }
        EMatch($subj, $arms) {
            strlist_union(hatch_expr_names($subj), hatch_arm_list_names($arms))
        }
        ELambda($params, $ret, $body, $topic) {
            strlist_without(hatch_stmt_list_names($body), hatch_param_names($params))
        }
        EList($xs) { hatch_expr_list_names($xs) }
        EMap($ents) { hatch_map_entry_names($ents) }
        _ { StrNil }
    }
}

# Collect free names from §12 interpolations inside an EStr payload (bare
# `$name` / `@name` / `%name` and `{ expr }` splices). Escaped starters are
# skipped the same way as eval_interp_parts.
sub hatch_interp_names($text: Str): StrList {
    @chars: List[Str] = split($text, "")
    hatch_interp_scan(@chars, 0, @chars.count(), StrNil)
}

sub hatch_interp_scan(@chars: List[Str], $i: Int, $n: Int, $acc: StrList): StrList {
    if $i >= $n {
        $acc
    } else {
        $c = at(@chars, $i)
        $next = at(@chars, $i + 1)
        if $c == "\\" && ($next == '{' || $next == '}' || $next == '$' || $next == '@' || $next == '%') {
            hatch_interp_scan(@chars, $i + 2, $n, $acc)
        } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start($next) {
            $run = take_ident(@chars, $i + 1, $c)
            hatch_interp_scan(@chars, $run.next, $n, strlist_add($acc, $run.text))
        } else if $c == '{' {
            match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                None { hatch_interp_scan(@chars, $i + 1, $n, $acc) }
                Some($scan) {
                    $nested = match parse_interpolation_expr($scan.text) {
                        Err($e) { StrNil }
                        Ok($expr) { hatch_expr_names($expr) }
                    }
                    hatch_interp_scan(@chars, $scan.next, $n, strlist_union($acc, $nested))
                }
            }
        } else {
            hatch_interp_scan(@chars, $i + 1, $n, $acc)
        }
    }
}

sub hatch_expr_list_names($xs: ExprList): StrList {
    match $xs {
        ExprNil { StrNil }
        ExprCons($h, $t) { strlist_union(hatch_expr_names($h), hatch_expr_list_names($t)) }
    }
}

sub hatch_param_names($ps: ParamList): StrList {
    match $ps {
        ParamNil { StrNil }
        ParamCons($p, $t) { StrCons($p.name, hatch_param_names($t)) }
    }
}

sub hatch_opt_stmt_list_names($b: Option[StmtList]): StrList {
    match $b {
        None { StrNil }
        Some($stmts) { hatch_stmt_list_names($stmts) }
    }
}

sub hatch_elif_names($xs: ElifList): StrList {
    match $xs {
        ElifNil { StrNil }
        ElifCons($h, $t) {
            strlist_union(
                strlist_union(hatch_expr_names($h.cond), hatch_stmt_list_names($h.body)),
                hatch_elif_names($t)
            )
        }
    }
}

sub hatch_arm_list_names($xs: ArmList): StrList {
    match $xs {
        ArmNil { StrNil }
        ArmCons($h, $t) {
            $bound = hatch_pattern_bind_names($h.pat)
            $body_free = strlist_without(hatch_stmt_list_names($h.body), $bound)
            $guard_free = match $h.guard {
                None { StrNil }
                Some($g) { strlist_without(hatch_expr_names($g), $bound) }
            }
            strlist_union(strlist_union($body_free, $guard_free), hatch_arm_list_names($t))
        }
    }
}

sub hatch_pattern_bind_names($p: Pattern): StrList {
    match $p {
        PBind($n) { StrCons($n, StrNil) }
        PVariant($tag, $args) { hatch_pattern_list_bind_names($args) }
        _ { StrNil }
    }
}

sub hatch_pattern_list_bind_names($xs: PatternList): StrList {
    match $xs {
        PatNil { StrNil }
        PatCons($h, $t) {
            strlist_union(hatch_pattern_bind_names($h), hatch_pattern_list_bind_names($t))
        }
    }
}

sub hatch_map_entry_names($xs: MapEntryList): StrList {
    match $xs {
        MapEntryNil { StrNil }
        MapEntryCons($h, $t) {
            strlist_union(
                strlist_union(hatch_expr_names($h.key), hatch_expr_names($h.value)),
                hatch_map_entry_names($t)
            )
        }
    }
}

sub hatch_stmt_names($s: Stmt): StrList {
    match $s {
        SExpr($e) { hatch_expr_names($e) }
        SBind($m, $n, $ty, $v) { hatch_expr_names($v) }
        SReturn($v) { hatch_opt_expr_names($v) }
        SWhile($cond, $body) {
            strlist_union(hatch_expr_names($cond), hatch_stmt_list_names($body))
        }
        SFor($vars, $iter, $body) {
            strlist_union(
                hatch_expr_names($iter),
                strlist_without(hatch_stmt_list_names($body), $vars)
            )
        }
        SHatch($body) { hatch_stmt_list_names($body) }
        SSelect($arms, $els) {
            strlist_union(hatch_select_arm_names($arms), hatch_opt_stmt_list_names($els))
        }
    }
}

sub hatch_opt_expr_names($e: Option[Expr]): StrList {
    match $e {
        None { StrNil }
        Some($x) { hatch_expr_names($x) }
    }
}

sub hatch_select_arm_names($xs: SelectArmList): StrList {
    match $xs {
        SelectArmNil { StrNil }
        SelectArmCons($h, $t) {
            $bound = match $h.bind {
                None { StrNil }
                Some($n) { StrCons($n, StrNil) }
            }
            strlist_union(
                strlist_union(
                    hatch_expr_names($h.op),
                    strlist_without(hatch_stmt_list_names($h.body), $bound)
                ),
                hatch_select_arm_names($t)
            )
        }
    }
}

sub hatch_stmt_list_names($xs: StmtList): StrList {
    match $xs {
        StmtNil { StrNil }
        StmtCons($h, $t) {
            match $h {
                SBind($m, $n, $ty, $v) {
                    strlist_union(
                        hatch_expr_names($v),
                        strlist_without(hatch_stmt_list_names($t), StrCons($n, StrNil))
                    )
                }
                _ { strlist_union(hatch_stmt_names($h), hatch_stmt_list_names($t)) }
            }
        }
    }
}

sub hatch_snapshot_bindings_filtered($binds: Bindings, $want: StrList): Result[Bindings, Str] {
    match $binds {
        BindNil { Ok(BindNil) }
        BindCons($name, $mutable, $value, $tail) {
            match hatch_snapshot_bindings_filtered($tail, $want) {
                Err($e) { Err($e) }
                Ok($st) {
                    if !strlist_has($want, $name) {
                        Ok($st)
                    } else if $mutable {
                        Ok(BindCons(str_detach($name), true, $value, $st))
                    } else {
                        match hatch_snapshot_value($value) {
                            Err($e) { Err($e) }
                            Ok($sv) { Ok(BindCons(str_detach($name), false, $sv, $st)) }
                        }
                    }
                }
            }
        }
    }
}

sub hatch_snapshot_env_filtered($env: Env, $want: StrList): Result[Env, Str] {
    match $env {
        EnvNil { Ok(EnvNil) }
        EnvFrame($binds, $parent) {
            match hatch_snapshot_bindings_filtered($binds, $want) {
                Err($e) { Err($e) }
                Ok($sb) {
                    match hatch_snapshot_env_filtered($parent, $want) {
                        Err($e) { Err($e) }
                        Ok($sp) { Ok(EnvFrame($sb, $sp)) }
                    }
                }
            }
        }
    }
}

sub hatch_snapshot_bindings($binds: Bindings): Result[Bindings, Str] {
    hatch_snapshot_bindings_filtered($binds, hatch_all_binding_names($binds))
}

sub hatch_all_binding_names($binds: Bindings): StrList {
    match $binds {
        BindNil { StrNil }
        BindCons($name, $mutable, $value, $tail) {
            StrCons($name, hatch_all_binding_names($tail))
        }
    }
}

sub hatch_snapshot_env($env: Env): Result[Env, Str] {
    match $env {
        EnvNil { Ok(EnvNil) }
        EnvFrame($binds, $parent) {
            match hatch_snapshot_bindings($binds) {
                Err($e) { Err($e) }
                Ok($sb) {
                    match hatch_snapshot_env($parent) {
                        Err($e) { Err($e) }
                        Ok($sp) { Ok(EnvFrame($sb, $sp)) }
                    }
                }
            }
        }
    }
}

# §17.1 hatch: deep-snapshot the creation-time free Vars into a private closure
# (I12a/I12b), spawn a host task through `$__guji_eval_hatch_task` (I10d1), and
# return Unit to the parent immediately. Channel joins inside the guest body
# make completion observable; unrecovered guest panic/exit abort the whole
# process. StmtList/SubTable stay shared read-only AST (immutable after parse).
sub eval_hatch($body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    $want = hatch_stmt_list_names($body)
    match hatch_snapshot_env_filtered($env, $want) {
        Err($e) { Err($e) }
        Ok($snap) {
            $__guji_eval_hatch_task = sub(): Int {
                eval_hatch_task_run($body, $subs, $snap)
            }
            hatch {
                $st = $__guji_eval_hatch_task()
                if $st != 0 {
                    panic("hatch task failed")
                }
            }
            Ok(flow(VUnit, $env))
        }
    }
}

# I10e1 §17.5 scalar/Str select. A guest select may contain a runtime-sized
# SelectArmList, while host select syntax has a compile-time arm count. Probe one
# typed guest arm at a time with a host select+else, preserving source order; a
# no-else guest select parks on the I10f1 scheduler wait after a full miss.
#
# I10e2 widens the same poller to VChanListInt / VChanMapStr / VChanEnum via the
# I10c2b wire carriers (flat recv probes; send converts then calls *_wired).
#
# I10f2 snapshots scheduler progress BEFORE each arm pass and calls
# `__guji_select_wait(seen)` only when there is no `else`, so all-blocked
# programs participate in §17.6 deadlock accounting instead of busy-spinning.
#
# VBool(false) is an internal would-block marker. A selected arm is normalized to
# VUnit unless its body returned, so the marker cannot collide with guest flow.
sub eval_select_wait($env: Env): EvalResult {
    flow(VBool(false), $env)
}

sub eval_select_is_wait($r: EvalResult): Bool {
    if $r.returned {
        false
    } else {
        match $r.value {
            VBool($b) { !$b }
            _ { false }
        }
    }
}

sub eval_select_run_arm($arm: SelectArm, $value: Value, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    $child = match $arm.bind {
        None { EnvFrame(BindNil, $env) }
        Some($name) { EnvFrame(BindCons($name, false, $value, BindNil), $env) }
    }
    match run_scope($arm.body, $subs, $child) {
        Err($e) { Err($e) }
        Ok($r) {
            if $r.returned {
                Ok($r)
            } else {
                Ok(flow(VUnit, $r.env))
            }
        }
    }
}

sub eval_select_got_int($got: Option[Int]): Value {
    if $got.is_some() { option_some_val(VInt($got.unwrap())) } else { option_none_val() }
}

sub eval_select_got_bool($got: Option[Bool]): Value {
    if $got.is_some() { option_some_val(VBool($got.unwrap())) } else { option_none_val() }
}

sub eval_select_got_float($got: Option[Float]): Value {
    if $got.is_some() { option_some_val(VFloat($got.unwrap())) } else { option_none_val() }
}

sub eval_select_got_str($got: Option[Str]): Value {
    if $got.is_some() { option_some_val(VStr($got.unwrap())) } else { option_none_val() }
}

# I10e2: wire Option → guest Option[List|Map|enum]. Keep is_some/unwrap helpers
# (no host match inside these Result-returning select probes).
sub eval_select_got_list_int($got: Option[WireIntList]): Value {
    if $got.is_some() {
        option_some_val(VList(vlist_from_wire_int($got.unwrap())))
    } else {
        option_none_val()
    }
}

sub eval_select_got_map_str($got: Option[WireStrMap]): Value {
    if $got.is_some() {
        option_some_val(VMap(vmap_from_wire_str($got.unwrap(), ValMapNil)))
    } else {
        option_none_val()
    }
}

sub eval_select_got_enum($got: Option[WireEnum]): Value {
    if $got.is_some() {
        option_some_val(vvariant_from_wire($got.unwrap()))
    } else {
        option_none_val()
    }
}

sub eval_select_recv_int($arm: SelectArm, $ch: Chan[Int], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $got = $ch.recv() {
            return eval_select_run_arm($arm, eval_select_got_int($got), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_recv_bool($arm: SelectArm, $ch: Chan[Bool], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $got = $ch.recv() {
            return eval_select_run_arm($arm, eval_select_got_bool($got), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

