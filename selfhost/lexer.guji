            match run_scope($body, $subs, EnvFrame(BindCons($v, false, VBool($got.unwrap()), BindNil), $cur_env)) {
                Err($e) { return Err($e) }
                Ok($br) {
                    if $br.returned {
                        return Ok($br)
                    }
                    $cur_env = $br.env
                }
            }
        } else {
            $going = false
        }
    }
    Ok(flow(VUnit, $cur_env))
}

sub eval_for_chan_float($vars: StrList, $ch: Chan[Float], $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
