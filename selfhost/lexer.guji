    Ok(eval_select_wait($env))
}

sub eval_select_recv_str($arm: SelectArm, $ch: Chan[Str], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $got = $ch.recv() {
            return eval_select_run_arm($arm, eval_select_got_str($got), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_send_int($arm: SelectArm, $ch: Chan[Int], $value: Int, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $sent = $ch.send($value) {
            return eval_select_run_arm($arm, eval_channel_closed_result($sent.is_ok()), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_send_bool($arm: SelectArm, $ch: Chan[Bool], $value: Bool, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $sent = $ch.send($value) {
            return eval_select_run_arm($arm, eval_channel_closed_result($sent.is_ok()), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

