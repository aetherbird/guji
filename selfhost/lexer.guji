# selfhost/lexer.guji -- the canonical Guji-written front end, evaluator, and
# native compiler implementation. guji-spec.md defines the language; the
# self-hosting and exact Guji interpreter/compiler gates enforce this source.
#
# Slice 1 (SH1): Str -> token stream for a CORE SUBSET of guji (spec Section 2):
# identifiers + sigil-names ($x / @xs / %m), keywords (Section 2.5), Int / Float /
# Str / Bool literals, operators and punctuation, line and block comments, and
# newlines. Errors carry a 1-based line:col position.
#
# DESIGN NOTES (verified facts about the shipped v0 surface):
#  * guji has NO Str char-index or substring primitive (`$s.get(0)` errors), so
#    the source is exploded once with `split($src, "")` into a List[Str] of
#    single characters and scanned by index with `get(@chars, $i)`. Character
#    *classes* are tested with the `~~` regex operator on the single char.
#  * guji v0 has NO list builder (no append / prepend / concat; `~` is Str-only).
#    A variable-length sequence therefore cannot be grown as a List, so the token
#    stream is a recursive `enum` cons-list (`TokenList`), built front-to-back by
#    recursion. This is a real v0 limitation, surfaced for the next slices.
#  * There is no `to_str`; Ints are rendered into messages via interpolation
#    ("{ $n }").
#  * String interpolation is NOT lexed this slice; a double-quoted string's
#    interpolation markers are kept as literal text in the decoded content.

# ---------------------------------------------------------------------------
# Token model: a coarse kind tag (the exact spelling lives in `lexeme`) plus the
# source position. A coarse TokKind keeps the enum small; the parser (SH2) reads
# operator/punctuation spellings from `lexeme`.
# ---------------------------------------------------------------------------

pub enum TokKind {
    KInt, KFloat, KStr, KRawStr, KBool,
    KRegex, KRxBody,
    KIdent, KUpper, KSigil, KKeyword,
    KOp, KPunct, KNewline, KEof
}

pub class Token {
    has $.kind: TokKind
    has $.lexeme: Str
    has $.line: Int
    has $.col: Int
}

# The token stream as a cons-list (see DESIGN NOTES: no List builder in v0).
pub enum TokenList {
    TEnd
    TMore($tok: Token, $rest: TokenList)
}

# ---------------------------------------------------------------------------
# Small result carriers for the scanners. `Run` is a consumed lexeme plus the
# next index (single-line runs); `Scan` adds line/col for scans that may cross
# newlines (strings); `Pos` is a position-only result (comment skips).
# ---------------------------------------------------------------------------

class Run {
    has $.text: Str
    has $.next: Int
}

class Scan {
    has $.text: Str
    has $.next: Int
    has $.line: Int
    has $.col: Int
}

class Pos {
    has $.next: Int
    has $.line: Int
    has $.col: Int
}

# ---------------------------------------------------------------------------
# Character classification. `split($src, "")` yields Unicode scalar values, so
# the emoji continuation characters below are recognized individually. An
# out-of-range read yields "" which matches no class.
# ---------------------------------------------------------------------------

sub is_digit($c: Str): Bool { ($c ~~ /(?a)[0-9]/).is_some() }
sub is_hex($c: Str): Bool { ($c ~~ /(?a)[0-9A-Fa-f]/).is_some() }
sub is_nonascii_emoji($c: Str): Bool {
    !($c ~~ /(?a)[\x00-\x7f]/).is_some() && ($c ~~ /^\p{Emoji}$/).is_some()
}
sub is_emoji_sequence_cont($c: Str): Bool {
    # ZWJ, COMBINING ENCLOSING KEYCAP, text/emoji variation selectors, and the
    # tag characters used by emoji flag sequences (§2.3, Unicode 15.0).
    ($c ~~ /^[\x{200d}\x{20e3}\x{fe0e}\x{fe0f}\x{e0020}-\x{e007f}]$/).is_some()
}
sub is_ident_start($c: Str): Bool {
    ($c ~~ /(?a)[A-Za-z_]/).is_some() || is_nonascii_emoji($c)
}
sub is_ident_cont($c: Str): Bool {
    ($c ~~ /(?a)[A-Za-z0-9_]/).is_some() || is_nonascii_emoji($c) || is_emoji_sequence_cont($c)
}
sub is_upper($c: Str): Bool { ($c ~~ /(?a)[A-Z]/).is_some() }

sub is_punct_char($c: Str): Bool {
    ["(", ")", "[", "]", '{', '}', ",", ";"].contains($c)
}

# Single-character operators. `&` and `|` are intentionally excluded: only the
# two-char `&&` / `||` are valid, so a lone one is a lex error.
sub is_op_char($c: Str): Bool {
    ["+", "-", "*", "/", "%", "~", "<", ">", "=", "!", "?", ".", ":"].contains($c)
}

# §2.5 reserved words, excluding `true`/`false` (lexed as KBool literals).
sub is_keyword($w: Str): Bool {
    ["sub", "class", "enum", "has", "match", "if", "else", "for", "while",
     "in", "mut", "pub", "import", "return", "grammar", "rule", "token",
     "regex", "hatch", "select", "and", "not", "or"].contains($w)
}

# Classify a completed word into its token kind.
sub kind_for_word($w: Str): TokKind {
    if $w == "true" || $w == "false" {
        KBool
    } else if is_keyword($w) {
        KKeyword
    } else if is_upper(first_char($w)) {
        KUpper
    } else {
        KIdent
    }
}

sub first_char($w: Str): Str {
    match get(split($w, ""), 0) {
        Some($c) { $c }
        None { "" }
    }
}

# Read the char at $i, or "" past the end (so lookahead never panics).
sub at(@chars: List[Str], $i: Int): Str {
    match get(@chars, $i) {
        Some($c) { $c }
        None { "" }
    }
}

sub tok($k: TokKind, $lex: Str, $line: Int, $col: Int): Token {
    Token(kind: $k, lexeme: $lex, line: $line, col: $col)
}

sub lex_err($line: Int, $col: Int, $msg: Str): Str {
    "lex error at { $line }:{ $col }: { $msg }"
}

# ---------------------------------------------------------------------------
# Run scanners: consume a maximal run of one character class, accumulating the
# lexeme text, and report the index just past it.
# ---------------------------------------------------------------------------

sub take_ident(@chars: List[Str], $i: Int, $acc: Str): Run {
    match get(@chars, $i) {
        None { Run(text: $acc, next: $i) }
        Some($c) {
            if is_ident_cont($c) {
                take_ident(@chars, $i + 1, $acc ~ $c)
            } else {
                Run(text: $acc, next: $i)
            }
        }
    }
}

sub take_dec(@chars: List[Str], $i: Int, $acc: Str): Run {
    match get(@chars, $i) {
        None { Run(text: $acc, next: $i) }
        Some($c) {
            if is_digit($c) || $c == "_" {
                take_dec(@chars, $i + 1, $acc ~ $c)
            } else {
                Run(text: $acc, next: $i)
            }
        }
    }
}

sub take_hex(@chars: List[Str], $i: Int, $acc: Str): Run {
    match get(@chars, $i) {
        None { Run(text: $acc, next: $i) }
        Some($c) {
            if is_hex($c) || $c == "_" {
                take_hex(@chars, $i + 1, $acc ~ $c)
            } else {
                Run(text: $acc, next: $i)
            }
        }
    }
}

sub take_bin(@chars: List[Str], $i: Int, $acc: Str): Run {
    match get(@chars, $i) {
        None { Run(text: $acc, next: $i) }
        Some($c) {
            if $c == "0" || $c == "1" || $c == "_" {
                take_bin(@chars, $i + 1, $acc ~ $c)
            } else {
                Run(text: $acc, next: $i)
            }
        }
    }
}

# A float exponent suffix: (e|E) (+|-)? digit+. Consumed only when a digit
# actually follows, otherwise the `e`/`E` is left for the next token.
sub scan_exponent(@chars: List[Str], $i: Int, $acc: Str): Run {
    $e = at(@chars, $i)
    if $e == "e" || $e == "E" {
        $sign = at(@chars, $i + 1)
        if $sign == "+" || $sign == "-" {
            if is_digit(at(@chars, $i + 2)) {
                take_dec(@chars, $i + 2, $acc ~ $e ~ $sign)
            } else {
                Run(text: $acc, next: $i)
            }
        } else if is_digit($sign) {
            take_dec(@chars, $i + 1, $acc ~ $e)
        } else {
            Run(text: $acc, next: $i)
        }
    } else {
        Run(text: $acc, next: $i)
    }
}

# A whole numeric literal: hex (0x..), binary (0b..), or decimal with an
# optional fraction (only when a digit follows the `.`, so `3..4` stays an Int
# then a range operator) and an optional exponent on the fractional form.
sub scan_number(@chars: List[Str], $i: Int): Run {
    $c0 = at(@chars, $i)
    $c1 = at(@chars, $i + 1)
    if $c0 == "0" && ($c1 == "x" || $c1 == "X") {
        take_hex(@chars, $i + 2, "0" ~ $c1)
    } else if $c0 == "0" && ($c1 == "b" || $c1 == "B") {
        take_bin(@chars, $i + 2, "0" ~ $c1)
    } else {
        $intpart = take_dec(@chars, $i, "")
        $dotc = at(@chars, $intpart.next)
        $afterdot = at(@chars, $intpart.next + 1)
        if $dotc == "." && is_digit($afterdot) {
            $frac = take_dec(@chars, $intpart.next + 1, $intpart.text ~ ".")
            scan_exponent(@chars, $frac.next, $frac.text)
        } else {
            # No fraction: still allow a bare exponent suffix (`1e3`, `1e-3`),
            # matching the Go lexer's single Float for `6.022e23`-style literals
            # (spec §2). scan_exponent only consumes when a digit follows the
            # `e`, so `1e` stays an Int then the identifier `e`.
            scan_exponent(@chars, $intpart.next, $intpart.text)
        }
    }
}

# A completed numeric lexeme's token kind (§2). Hex/binary literals are always
# Int (their digits may include `e`/`E`/`b`, which must NOT be read as a float
# exponent — `0xe5` is hex, not a float). A decimal lexeme is a Float when it
# carries a fraction `.` or an exponent `e`/`E`, otherwise an Int.
sub number_kind($text: Str): TokKind {
    @nc = split($text, "")
    $pfx = at(@nc, 0) ~ at(@nc, 1)
    if $pfx == "0x" || $pfx == "0X" || $pfx == "0b" || $pfx == "0B" {
        KInt
    } else if has_char($text, ".") || has_char($text, "e") || has_char($text, "E") {
        KFloat
    } else {
        KInt
    }
}

sub has_char($s: Str, $ch: Str): Bool {
    split($s, $ch).count() > 1
}

sub is_empty_numeric_prefix($text: Str): Bool {
    $text == "0x" || $text == "0X" || $text == "0b" || $text == "0B"
}

# ---------------------------------------------------------------------------
# String scanners. Double-quoted strings decode the §12 escapes. The token keeps
# interpolation markers in the decoded content; codegen lowers `{ expr }` later
# so escaped literal braces used by generated-C templates can still stay literal
# when the braced text is not an expression. Single-quoted strings are literal
# with only \' as an escape.
# ---------------------------------------------------------------------------

sub decode_escape($e: Str): Str {
    if $e == "n" {
        "\n"
    } else if $e == "t" {
        "\t"
    } else if $e == "\\" || $e == "\"" {
        # The escapes the Go lexer's `interpolate` (eval.go) decodes to the bare
        # character immediately and which cannot be confused with interpolation.
        # Drop the backslash.
        $e
    } else if $e == "$" || $e == "@" || $e == "%" {
        # Keep escaped sigils marked until interpolation lowering. Otherwise
        # `\$x` is indistinguishable from the bare-sigil interpolation `$x`.
        "\\" ~ $e
    } else {
        # Everything else keeps a backslash + the char. Two roles:
        #   - LITERAL braces: a backslash marker so the EB-3a interpolation lowerer
        #     (g3_interp_parts) treats the brace as text, not a `{ expr }` splice.
        #   - UNKNOWN escapes (`\r`, `\0`, ...): mirror the Go lexer, which keeps
        #     BOTH the backslash and the char verbatim. The previous code dropped
        #     the backslash, so a self-compiled carriage-return constant collapsed
        #     to the bare letter and the C/JSON escapers' CR branch went live — a
        #     bootstrap divergence vs the interpreter (which keeps the backslash,
        #     2 chars, leaving that branch dead).
        # Built by concatenation (never a literal brace) so the Go interpreter does
        # not try to interpolate the marker when it evaluates this sub.
        "\\" ~ $e
    }
}

sub scan_dquote(@chars: List[Str], $i: Int, $line: Int, $col: Int, $acc: Str): Result[Scan, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($line, $col, "unterminated string")) }
        Some($c) {
            if $c == "\"" {
                Ok(Scan(text: $acc, next: $i + 1, line: $line, col: $col + 1))
            } else if $c == "\\" {
                match get(@chars, $i + 1) {
                    None { Err(lex_err($line, $col, "unterminated escape in string")) }
                    Some($e) {
                        scan_dquote(@chars, $i + 2, $line, $col + 2, $acc ~ decode_escape($e))
                    }
                }
            } else if $c == "\n" {
                # A string literal may not span a physical newline (spec §2): the
                # Go lexer rejects this as an unterminated string. (A newline is
                # written with the `\n` escape, handled above.)
                Err(lex_err($line, $col, "unterminated string"))
            } else {
                scan_dquote(@chars, $i + 1, $line, $col + 1, $acc ~ $c)
            }
        }
    }
}

sub scan_squote(@chars: List[Str], $i: Int, $line: Int, $col: Int, $acc: Str): Result[Scan, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($line, $col, "unterminated string")) }
        Some($c) {
            if $c == "'" {
                Ok(Scan(text: $acc, next: $i + 1, line: $line, col: $col + 1))
            } else if $c == "\\" && at(@chars, $i + 1) == "'" {
                scan_squote(@chars, $i + 2, $line, $col + 2, $acc ~ "'")
            } else if $c == "\n" {
                # Single-quoted strings also may not span a physical newline
                # (spec §2); the Go lexer rejects it as unterminated.
                Err(lex_err($line, $col, "unterminated string"))
            } else {
                scan_squote(@chars, $i + 1, $line, $col + 1, $acc ~ $c)
            }
        }
    }
}

# Regex literal scanner (§13). The token lexeme stores the pattern body without
# the surrounding slashes, matching the parser AST's `ERegex(pattern, line, col)` carrier.
# Closing `/` is ignored inside bracket classes, after `\`, and inside `<{...}>`
# splice expressions so the lexer does not split a single literal.
sub scan_regex(@chars: List[Str], $i: Int, $line: Int, $col: Int, $brackets: Int, $acc: Str): Result[Scan, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($line, $col, "unterminated regex literal: missing closing /")) }
        Some($c) {
            if $c == "\n" {
                Err(lex_err($line, $col, "unterminated regex literal: missing closing /"))
            } else if $c == "\\" {
                match get(@chars, $i + 1) {
                    None { Err(lex_err($line, $col, "unterminated regex literal: dangling \\ escape")) }
                    Some($e) {
                        if $e == "\n" {
                            Err(lex_err($line, $col, "unterminated regex literal: dangling \\ escape"))
                        } else {
                            scan_regex(@chars, $i + 2, $line, $col + 2, $brackets, $acc ~ "\\" ~ $e)
                        }
                    }
                }
            } else if $c == "[" {
                scan_regex(@chars, $i + 1, $line, $col + 1, $brackets + 1, $acc ~ $c)
            } else if $c == "]" && $brackets > 0 {
                scan_regex(@chars, $i + 1, $line, $col + 1, $brackets - 1, $acc ~ $c)
            } else if $c == "<" && at(@chars, $i + 1) == '{' && $brackets == 0 {
                match scan_regex_splice(@chars, $i + 2, $line, $col + 2, 1, '<{') {
                    Err($e) { Err($e) }
                    Ok($s) { scan_regex(@chars, $s.next, $s.line, $s.col, $brackets, $acc ~ $s.text) }
                }
            } else if $c == "/" && $brackets == 0 {
                Ok(Scan(text: $acc, next: $i + 1, line: $line, col: $col + 1))
            } else {
                scan_regex(@chars, $i + 1, $line, $col + 1, $brackets, $acc ~ $c)
            }
        }
    }
}

sub scan_regex_splice(@chars: List[Str], $i: Int, $line: Int, $col: Int, $depth: Int, $acc: Str): Result[Scan, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($line, $col, "unterminated regex splice: missing closing }")) }
        Some($c) {
            if $c == "\n" {
                Err(lex_err($line, $col, "unterminated regex splice: missing closing }"))
            } else if $c == "\"" || $c == "'" {
                match scan_regex_splice_quoted(@chars, $i + 1, $line, $col + 1, $c, $c) {
                    Err($e) { Err($e) }
                    Ok($s) { scan_regex_splice(@chars, $s.next, $s.line, $s.col, $depth, $acc ~ $s.text) }
                }
            } else if $c == '{' {
                scan_regex_splice(@chars, $i + 1, $line, $col + 1, $depth + 1, $acc ~ $c)
            } else if $c == '}' {
                if $depth == 1 {
                    if at(@chars, $i + 1) == ">" {
                        Ok(Scan(text: $acc ~ '}>', next: $i + 2, line: $line, col: $col + 2))
                    } else {
                        Err(lex_err($line, $col, "unterminated regex splice: missing closing >"))
                    }
                } else {
                    scan_regex_splice(@chars, $i + 1, $line, $col + 1, $depth - 1, $acc ~ $c)
                }
            } else {
                scan_regex_splice(@chars, $i + 1, $line, $col + 1, $depth, $acc ~ $c)
            }
        }
    }
}

sub scan_regex_splice_quoted(@chars: List[Str], $i: Int, $line: Int, $col: Int, $quote: Str, $acc: Str): Result[Scan, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($line, $col, "unterminated regex splice string")) }
        Some($c) {
            if $c == "\n" {
                Err(lex_err($line, $col, "unterminated regex splice string"))
            } else if $c == "\\" {
                match get(@chars, $i + 1) {
                    None { Err(lex_err($line, $col, "unterminated regex splice string")) }
                    Some($e) {
                        if $e == "\n" {
                            Err(lex_err($line, $col, "unterminated regex splice string"))
                        } else {
                            scan_regex_splice_quoted(@chars, $i + 2, $line, $col + 2, $quote, $acc ~ "\\" ~ $e)
                        }
                    }
                }
            } else if $c == $quote {
                Ok(Scan(text: $acc ~ $c, next: $i + 1, line: $line, col: $col + 1))
            } else {
                scan_regex_splice_quoted(@chars, $i + 1, $line, $col + 1, $quote, $acc ~ $c)
            }
        }
    }
}

# A grammar production body (§14.1) is one raw token. The scanner stops before
# the production's closing `}` while ignoring braces inside quoted literals and
# bracket classes; nested braces cover regex quantifiers such as `\d{2,4}`.
# `$mode` is 0 for ordinary body text, 1 for a single-quoted literal, and 2 for
# a bracket class. Backslash escapes always consume the following character.
sub scan_rx_body(@chars: List[Str], $i: Int, $line: Int, $col: Int, $depth: Int, $mode: Int, $acc: Str): Result[Scan, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($line, $col, 'unterminated grammar production body: missing closing }')) }
        Some($c) {
            if $c == "\\" {
                $next = at(@chars, $i + 1)
                if $next == "" {
                    scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, $mode, $acc ~ $c)
                } else {
                    scan_rx_body(@chars, $i + 2, $line, $col + 2, $depth, $mode, $acc ~ $c ~ $next)
                }
            } else if $c == "\n" {
                scan_rx_body(@chars, $i + 1, $line + 1, 1, $depth, $mode, $acc ~ $c)
            } else if $c == "\r" {
                if at(@chars, $i + 1) == "\n" {
                    scan_rx_body(@chars, $i + 2, $line + 1, 1, $depth, $mode, $acc ~ "\r\n")
                } else {
                    scan_rx_body(@chars, $i + 1, $line + 1, 1, $depth, $mode, $acc ~ $c)
                }
            } else if $mode == 1 {
                if $c == "'" {
                    scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, 0, $acc ~ $c)
                } else {
                    scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, $mode, $acc ~ $c)
                }
            } else if $mode == 2 {
                if $c == "]" {
                    scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, 0, $acc ~ $c)
                } else {
                    scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, $mode, $acc ~ $c)
                }
            } else if $c == "'" {
                scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, 1, $acc ~ $c)
            } else if $c == "[" {
                scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, 2, $acc ~ $c)
            } else if $c == '{' {
                scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth + 1, 0, $acc ~ $c)
            } else if $c == '}' {
                if $depth == 0 {
                    Ok(Scan(text: trim($acc), next: $i, line: $line, col: $col))
                } else {
                    scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth - 1, 0, $acc ~ $c)
                }
            } else {
                scan_rx_body(@chars, $i + 1, $line, $col + 1, $depth, 0, $acc ~ $c)
            }
        }
    }
}

# ---------------------------------------------------------------------------
# Comment skippers. A line comment runs to (but does not consume) the newline;
# a block comment runs to the closing `]#`, tracking newlines, and is a lex
# error if it reaches EOF unclosed (spec §2; the Go lexer rejects it).
# ---------------------------------------------------------------------------

sub scan_line_comment(@chars: List[Str], $i: Int, $line: Int, $col: Int): Pos {
    match get(@chars, $i) {
        None { Pos(next: $i, line: $line, col: $col) }
        Some($c) {
            if $c == "\n" {
                Pos(next: $i, line: $line, col: $col)
            } else {
                scan_line_comment(@chars, $i + 1, $line, $col + 1)
            }
        }
    }
}

sub scan_block_comment(@chars: List[Str], $i: Int, $line: Int, $col: Int, $sl: Int, $sc: Int): Result[Pos, Str] {
    match get(@chars, $i) {
        None { Err(lex_err($sl, $sc, "unterminated block comment")) }
        Some($c) {
            if $c == "]" && at(@chars, $i + 1) == "#" {
                Ok(Pos(next: $i + 2, line: $line, col: $col + 2))
            } else if $c == "\n" {
                scan_block_comment(@chars, $i + 1, $line + 1, 1, $sl, $sc)
            } else {
                scan_block_comment(@chars, $i + 1, $line, $col + 1, $sl, $sc)
            }
        }
    }
}

# ---------------------------------------------------------------------------
# The main scanner (slice 5 E5c — ITERATIVE). Earlier the scanner threaded
# (index, line, col) by RECURSION: `scan` -> `cont` -> `scan`, wrapping each
# token in `TMore($tok, scan(...))`. That is one Go stack frame per token AND
# not a tail call, so lexing the ~88K-token compiler source overflowed the
# interpreter stack (slice 5 BLOCKER 1). The loop is now driven by `lex` with a
# `mut` cursor + an accumulator (built reversed, then reversed once at the end —
# the subset has no list `append`). `lex_step` classifies the char at the cursor
# and returns exactly ONE outcome; the per-token scanners
# (`scan_number`/`scan_dquote`/`take_ident`/`scan_*_comment`) are unchanged and
# only recurse per-character WITHIN a single (bounded-length) token.
# ---------------------------------------------------------------------------

# One tokenizer step: emit a token, skip (whitespace/comment), reach EOF, or err.
enum LexStep {
    LSEmit($tok: Token, $i: Int, $line: Int, $col: Int)
    LSSkip($i: Int, $line: Int, $col: Int)
    LSEof($tok: Token)
    LSErr($msg: Str)
}

sub slash_is_division($prev: Token): Bool {
    match $prev.kind {
        KIdent { true }
        KSigil { true }
        KUpper { true }
        KInt { true }
        KFloat { true }
        KStr { true }
        KRawStr { true }
        KRegex { true }
        KBool { true }
        KPunct { $prev.lexeme == ")" || $prev.lexeme == "]" || $prev.lexeme == "}" }
        KOp { $prev.lexeme == "?" || $prev.lexeme == ">" }
        _ { false }
    }
}

sub opens_rx_body($t: Token, $prev: Token, $prevprev: Token): Bool {
    if $t.lexeme != '{' {
        false
    } else {
        $name = match $prev.kind {
            KIdent { true }
            KUpper { true }
            _ { false }
        }
        $name && ($prevprev.lexeme == "rule" || $prevprev.lexeme == "token" || $prevprev.lexeme == "regex")
    }
}

sub lex_step(@chars: List[Str], $i: Int, $line: Int, $col: Int, $prev: Token): LexStep {
    match get(@chars, $i) {
        None { LSEof(tok(KEof, "", $line, $col)) }
        Some($c) {
            if $c == "\n" {
                LSEmit(tok(KNewline, "", $line, $col), $i + 1, $line + 1, 1)
            } else if $c == "\r" {
                if at(@chars, $i + 1) == "\n" {
                    LSEmit(tok(KNewline, "", $line, $col), $i + 2, $line + 1, 1)
                } else {
                    LSEmit(tok(KNewline, "", $line, $col), $i + 1, $line + 1, 1)
                }
            } else if $c == " " || $c == "\t" {
                LSSkip($i + 1, $line, $col + 1)
            } else if $c == "#" {
                if at(@chars, $i + 1) == "[" {
                    match scan_block_comment(@chars, $i + 2, $line, $col + 2, $line, $col) {
                        Ok($p) { LSSkip($p.next, $p.line, $p.col) }
                        Err($e) { LSErr($e) }
                    }
                } else {
                    $p = scan_line_comment(@chars, $i + 1, $line, $col + 1)
                    LSSkip($p.next, $p.line, $p.col)
                }
            } else if is_digit($c) {
                $num = scan_number(@chars, $i)
                if is_empty_numeric_prefix($num.text) {
                    LSErr(lex_err($line, $col, "invalid integer literal { $num.text }"))
                } else {
                    $knd = number_kind($num.text)
                    LSEmit(tok($knd, $num.text, $line, $col), $num.next, $line, $col + ($num.next - $i))
                }
            } else if is_ident_start($c) {
                $id = take_ident(@chars, $i, "")
                LSEmit(tok(kind_for_word($id.text), $id.text, $line, $col), $id.next, $line, $col + ($id.next - $i))
            } else if $c == "$" || $c == "@" || $c == "%" {
                $nxt = at(@chars, $i + 1)
                if is_ident_start($nxt) {
                    $id = take_ident(@chars, $i + 1, $c)
                    LSEmit(tok(KSigil, $id.text, $line, $col), $id.next, $line, $col + ($id.next - $i))
                } else {
                    # Standalone sigil (§8.1 twigil field decl `$.name`/`$!name`,
                    # also `%` modulo §5.1). The Go lexer emits a lone DOLLAR/AT/
                    # PERCENT token here; mirror it as a one-char KOp so the next
                    # `.`/`!`/ident lexes normally instead of erroring at `$.`.
                    LSEmit(tok(KOp, $c, $line, $col), $i + 1, $line, $col + 1)
                }
            } else if $c == "\"" {
                match scan_dquote(@chars, $i + 1, $line, $col + 1, "") {
                    Ok($s) { LSEmit(tok(KStr, $s.text, $line, $col), $s.next, $s.line, $s.col) }
                    Err($e) { LSErr($e) }
                }
            } else if $c == "'" {
                match scan_squote(@chars, $i + 1, $line, $col + 1, "") {
                    Ok($s) { LSEmit(tok(KRawStr, $s.text, $line, $col), $s.next, $s.line, $s.col) }
                    Err($e) { LSErr($e) }
                }
            } else if $c == "/" {
                if slash_is_division($prev) {
                    LSEmit(tok(KOp, "/", $line, $col), $i + 1, $line, $col + 1)
                } else {
                    match scan_regex(@chars, $i + 1, $line, $col + 1, 0, "") {
                        Ok($s) { LSEmit(tok(KRegex, $s.text, $line, $col), $s.next, $s.line, $s.col) }
                        Err($e) { LSErr($e) }
                    }
                }
            } else {
                lex_step_symbol(@chars, $c, $i, $line, $col)
            }
        }
    }
}

# Operators and punctuation, longest match first (one step; folds the old
# `scan_symbol` + `emit_op`/`emit_punct` into a single `LexStep`).
sub lex_step_symbol(@chars: List[Str], $c: Str, $i: Int, $line: Int, $col: Int): LexStep {
    $c1 = at(@chars, $i + 1)
    $c2 = at(@chars, $i + 2)
    if $c == "." && $c1 == "." && $c2 == "<" {
        LSEmit(tok(KOp, "..<", $line, $col), $i + 3, $line, $col + 3)
    } else if $c == "." && $c1 == "." {
        LSEmit(tok(KOp, "..", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == ":" && $c1 == ":" {
        LSEmit(tok(KOp, "::", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "=" && $c1 == "=" {
        LSEmit(tok(KOp, "==", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "!" && $c1 == "=" {
        LSEmit(tok(KOp, "!=", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "<" && $c1 == "=" {
        LSEmit(tok(KOp, "<=", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == ">" && $c1 == "=" {
        LSEmit(tok(KOp, ">=", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "&" && $c1 == "&" {
        LSEmit(tok(KOp, "&&", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "|" && $c1 == "|" {
        LSEmit(tok(KOp, "||", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "~" && $c1 == "~" {
        LSEmit(tok(KOp, "~~", $line, $col), $i + 2, $line, $col + 2)
    } else if $c == "*" && $c1 == "*" {
        LSEmit(tok(KOp, "**", $line, $col), $i + 2, $line, $col + 2)
    } else if is_punct_char($c) {
        LSEmit(tok(KPunct, $c, $line, $col), $i + 1, $line, $col + 1)
    } else if is_op_char($c) {
        LSEmit(tok(KOp, $c, $line, $col), $i + 1, $line, $col + 1)
    } else {
        LSErr(lex_err($line, $col, "unexpected character { $c }"))
    }
}

# Reverse a token cons-list iteratively (no per-token recursion). `lex`
# accumulates tokens reversed (cons prepends); this restores source order once.
sub reverse_tokens($rev: TokenList): TokenList {
    mut $cur = $rev
    mut $out = TEnd
    mut $going = true
    while $going {
        match $cur {
            TEnd { $going = false }
            TMore($t, $r) {
                $out = TMore($t, $out)
                $cur = $r
            }
        }
    }
    $out
}

# ---------------------------------------------------------------------------
# Public entry points.
# ---------------------------------------------------------------------------

# Tokenize a whole source string into the token cons-list, or a positioned
# lex error. The stream always ends with a KEof token followed by TEnd.
pub sub lex($src: Str): Result[TokenList, Str] {
    @chars = split($src, "")
    mut $i = 0
    mut $line = 1
    mut $col = 1
    mut $rev = TEnd
    mut $prev = tok(KNewline, "", 1, 1)
    mut $prevprev = $prev
    mut $pending_rx = false
    mut $err = ""
    mut $failed = false
    mut $done = false
    while !$done {
        if $pending_rx {
            match scan_rx_body(@chars, $i, $line, $col, 0, 0, "") {
                Err($m) {
                    $err = $m
                    $failed = true
                    $done = true
                }
                Ok($s) {
                    $t = tok(KRxBody, $s.text, $line, $col)
                    $rev = TMore($t, $rev)
                    $prevprev = $prev
                    $prev = $t
                    $pending_rx = false
                    $i = $s.next
                    $line = $s.line
                    $col = $s.col
                }
            }
        } else {
            match lex_step(@chars, $i, $line, $col, $prev) {
                LSEmit($t, $ni, $nl, $nc) {
                    $rev = TMore($t, $rev)
                    $pending_rx = opens_rx_body($t, $prev, $prevprev)
                    $prevprev = $prev
                    $prev = $t
                    $i = $ni
                    $line = $nl
                    $col = $nc
                }
                LSSkip($ni, $nl, $nc) {
                    $i = $ni
                    $line = $nl
                    $col = $nc
                }
                LSEof($t) {
                    $rev = TMore($t, $rev)
                    $done = true
                }
                LSErr($m) {
                    $err = $m
                    $failed = true
                    $done = true
                }
            }
        }
    }
    if $failed {
        Err($err)
    } else {
        Ok(reverse_tokens($rev))
    }
}

# A canonical one-token-per-line rendering, for self-checking the lexer.
# On a lex error, the single error line is returned instead.
pub sub lex_to_string($src: Str): Str {
    match lex($src) {
        Ok($toks) { render_tokens($toks) }
        Err($e) { $e }
    }
}

# Iterative (slice 5 E5c): one frame per token in the old recursive form
# overflowed the interpreter stack on the ~88K-token compiler source, so the
# headline "own source lexes clean" check could not actually run to completion.
sub render_tokens($toks: TokenList): Str {
    mut $cur = $toks
    mut $out = ""
    mut $going = true
    while $going {
        match $cur {
            TEnd { $going = false }
            TMore($t, $rest) {
                $out = $out ~ render_token($t) ~ "\n"
                $cur = $rest
            }
        }
    }
    $out
}

sub render_token($t: Token): Str {
    match $t.kind {
        KNewline { "{ label_of($t.kind) } @{ $t.line }:{ $t.col }" }
        KEof { "{ label_of($t.kind) } @{ $t.line }:{ $t.col }" }
        _ { "{ label_of($t.kind) } \"{ $t.lexeme }\" @{ $t.line }:{ $t.col }" }
    }
}

sub label_of($k: TokKind): Str {
    match $k {
        KInt { "INT" }
        KFloat { "FLOAT" }
        KStr { "STR" }
        KRawStr { "RAWSTR" }
        KBool { "BOOL" }
        KRegex { "REGEX" }
        KRxBody { "RXBODY" }
        KIdent { "IDENT" }
        KUpper { "UPPER" }
        KSigil { "SIGIL" }
        KKeyword { "KEYWORD" }
        KOp { "OP" }
        KPunct { "PUNCT" }
        KNewline { "NEWLINE" }
        KEof { "EOF" }
    }
}

# ---------------------------------------------------------------------------
# SH2a parser increment: AST model + recursive descent parser for top-level
# subs, bindings, calls/dot-calls, collection literals, and Section 5.5 binary
# precedence. Control-flow expressions (`if`/`match`) are intentionally the next
# slice; this parser reports a positioned error instead of accepting them.
# ---------------------------------------------------------------------------

pub enum TypeList {
    TypeNil
    TypeCons($head: TypeRef, $tail: TypeList)
}

pub class TypeRef {
    has $.name: Str
    has $.args: TypeList
}

pub class Param {
    has $.name: Str
    has $.ty: Option[TypeRef]
}

pub enum ParamList {
    ParamNil
    ParamCons($head: Param, $tail: ParamList)
}

pub enum ExprList {
    ExprNil
    ExprCons($head: Expr, $tail: ExprList)
}

pub class MapEntry {
    has $.key: Expr
    has $.value: Expr
}

pub enum MapEntryList {
    MapEntryNil
    MapEntryCons($head: MapEntry, $tail: MapEntryList)
}

pub enum Expr {
    EInt($text: Str)
    EFloat($text: Str)
    EStr($text: Str)
    ERawStr($text: Str)
    # $line/$col are the opening `/` token position — needed for spliced
    # match/replace runtime diagnostics (`guji_regex_match_parts_engine` loc).
    ERegex($pattern: Str, $line: Int, $col: Int)
    EBool($text: Str)
    EName($name: Str)
    ETypeName($name: Str)
    # §16.1 `module::member` access. The parser keeps the module alias and member
    # name separate (mirroring the Go ast.QualifiedExpr); module resolution is a
    # later slice (E5d-7c), so semantic/codegen stages treat it permissively /
    # out-of-subset for now.
    EQualified($module: Str, $member: Str)
    EUnit
    EList($items: ExprList)
    EMap($items: MapEntryList)
    EUnary($op: Str, $expr: Expr)
    EBinary($op: Str, $left: Expr, $right: Expr)
    ENamedArg($name: Str, $value: Expr)
    ECall($callee: Expr, $args: ExprList)
    EField($object: Expr, $name: Str)
    EIndex($object: Expr, $index: Expr)
    # §13.3 named regex capture access: `$match<name>`. This is distinct from
    # list indexing (`[]`) because the capture name is an identifier, not an
    # expression, and the receiver must be a Match value.
    ECapture($object: Expr, $name: Str)
    EIf($cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList])
    EMatch($subject: Expr, $arms: ArmList)
    # §7.4 anonymous functions. Topic blocks are represented as a one-param
    # lambda with the implicit `$_` param plus topic=true, so later typecheck /
    # codegen slices can still distinguish source spelling.
    ELambda($params: ParamList, $ret: Option[TypeRef], $body: StmtList, $topic: Bool)
    # §11.1 postfix `?` — propagate an Option `None` / Result `Err` out of the
    # enclosing carrier-returning sub, otherwise yield the `Some`/`Ok` payload.
    # Parsed as a postfix operator at the same precedence as call/field/index, so
    # a chain like `parse_int($s).map_err(f)?` attaches `?` to the whole receiver
    # (mirrors the Go `ast.QuestionExpr` + the parser's postfix loop). The front
    # end (parse + typecheck) handles it; codegen lands in a later P3b slice.
    EQuestion($expr: Expr)
}

pub enum Stmt {
    SBind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr)
    SReturn($value: Option[Expr])
    SExpr($expr: Expr)
    # §6.3 `while expr block` — side-effecting iteration. The condition is a Bool
    # expression (parsed before the body block, like `if`); the body is a child
    # statement list. This is the first iteration primitive in the selfhost subset;
    # codegen still declines it (E5b) so a `while` program is out-of-subset for the
    # codegen path until then.
    SWhile($cond: Expr, $body: StmtList)
    # §6.3 `for vars in expr block` — side-effecting iteration over a list, map, or
    # range. `$vars` holds one loop variable (list/range) or two (map: key then
    # value) in source order, encoded as a StrList. Mirrors the Go `ast.ForStmt`
    # (`Vars []string`, `Iter`, `Body`). The front end (parse + typecheck + eval)
    # handles it; the codegen path declines it until the P3c codegen slice.
    SFor($vars: StrList, $iter: Expr, $body: StmtList)
    # §17.1 `hatch block` starts a concurrent task and yields Unit. P8a carries
    # the block through the front end; native task emission lands separately.
    SHatch($body: StmtList)
    # §17.5 `select` preserves source-ordered channel operation arms plus an
    # optional non-blocking else. P8c carries the typed tree; emission is P8f.
    SSelect($arms: SelectArmList, $els: Option[StmtList])
}

pub enum StmtList {
    StmtNil
    StmtCons($head: Stmt, $tail: StmtList)
}

pub class SelectArm {
    has $.bind: Option[Str]
    has $.op: Expr
    has $.body: StmtList
}

pub enum SelectArmList {
    SelectArmNil
    SelectArmCons($head: SelectArm, $tail: SelectArmList)
}

pub enum Body {
    BlockBody($stmts: StmtList)
    ExprBody($expr: Expr)
}

# Control-flow AST (SH2b). An `if` carries its condition + then-block, an ordered
# list of `else if` clauses, and an optional final `else` block (§6.1). A `match`
# carries its subject and an ordered list of arms (§6.2); each arm is a pattern
# (§10.1) with an optional `if` guard (§10.2) and a block body. Branch/arm bodies
# are blocks, represented as StmtList exactly like a sub's BlockBody.

pub class Elif {
    has $.cond: Expr
    has $.body: StmtList
}

pub enum ElifList {
    ElifNil
    ElifCons($head: Elif, $tail: ElifList)
}

pub enum Pattern {
    PLit($expr: Expr)
    PWild
    PBind($name: Str)
    PVariant($name: Str, $args: PatternList)
}

pub enum PatternList {
    PatNil
    PatCons($head: Pattern, $tail: PatternList)
}

pub class Arm {
    has $.pat: Pattern
    has $.guard: Option[Expr]
    has $.body: StmtList
}

pub enum ArmList {
    ArmNil
    ArmCons($head: Arm, $tail: ArmList)
}

pub class SubDecl {
    has $.public: Bool
    has $.name: Str
    has $.line: Int
    has $.col: Int
    has $.body_line: Int
    has $.body_col: Int
    has $.tparams: StrList
    has $.params: ParamList
    has $.ret: Option[TypeRef]
    has $.body: Body
}

pub class ClassField {
    has $.public: Bool
    has $.sigil: Str
    has $.name: Str
    has $.ty: Option[TypeRef]
}

pub enum ClassFieldList {
    ClassFieldNil
    ClassFieldCons($head: ClassField, $tail: ClassFieldList)
}

# Methods (§8.3) and associated functions (§7.5) declared inside a class body: a
# `sub` whose first parameter is `$self` is an instance method, any other `sub` is
# an associated function. Both are stored here as ordinary `SubDecl`s (mirroring
# native's `ClassDecl.Subs []SubDecl`); the method/associated split is a downstream
# typecheck/codegen concern, not a parse-time one.
pub enum SubDeclList {
    SubDeclNil
    SubDeclCons($head: SubDecl, $tail: SubDeclList)
}

pub class ClassDecl {
    has $.public: Bool
    has $.name: Str
    has $.tparams: StrList
    has $.fields: ClassFieldList
    has $.subs: SubDeclList
}

# A single enum variant: a Pascal name with an optional list of typed fields
# (reusing `Param` for `sigil_name [: type]`). A fieldless variant has `ParamNil`.
pub class Variant {
    has $.name: Str
    has $.fields: ParamList
}

pub enum VariantList {
    VariantNil
    VariantCons($head: Variant, $tail: VariantList)
}

# Generic type-parameter names of an enum (e.g. the `T` in `enum Tree[T]`).
pub enum StrList {
    StrNil
    StrCons($head: Str, $tail: StrList)
}

pub class ImportDecl {
    has $.path: StrList
    has $.alias_line: Int
    has $.alias_col: Int
}

# A top-level `enum` declaration (§9). Methods and associated functions inside
# the enum body are ordinary `SubDecl`s collected in source order (mirroring
# native's `EnumDecl.Subs []SubDecl`, the enum twin of `ClassDecl.subs`); the
# method/associated split is a downstream typecheck/codegen concern.
pub class EnumDecl {
    has $.public: Bool
    has $.name: Str
    has $.tparams: StrList
    has $.variants: VariantList
    has $.subs: SubDeclList
}

# A single grammar production (§14.1): `rule|token|regex name { RXBODY }`.
# The body is the lexer's trimmed raw PEG/regex text (KRxBody). P7c-2a re-parses
# it into PegExpr for validation; native matcher emission is the next P7c chunk.
pub class Production {
    has $.kind: Str
    has $.name: Str
    has $.body: Str
}

pub enum ProductionList {
    ProductionNil
    ProductionCons($head: Production, $tail: ProductionList)
}

# A top-level `grammar` declaration (§14.1). Typecheck registers TGrammar; P7c-2a
# validates opaque bodies. Bush lowering / packrat emission remain later P7c.
pub class GrammarDecl {
    has $.public: Bool
    has $.name: Str
    has $.productions: ProductionList
}

# Shared PEG body AST (§14.1) used by both evaluator and code generator so the
# maintained consumers cannot drift. Choice/Seq nest; atoms are leaves.
pub enum PegExpr {
    PegChoice($alts: PegExprList)
    PegSeq($terms: PegExprList)
    PegRef($name: Str)
    PegLit($text: Str)
    PegRegex($pattern: Str)
    PegWhitespace
}

pub enum PegExprList {
    PegNil
    PegCons($head: PegExpr, $tail: PegExprList)
}

# name → parsed body, preserving declaration order for diagnostics.
enum PegProdTable {
    PPTNil
    PPTCons($name: Str, $kind: Str, $expr: PegExpr, $rest: PegProdTable)
}

class PegScan {
    has $.expr: PegExpr
    has $.next: Int
}

class PegTerms {
    has $.terms: PegExprList
    has $.next: Int
}

pub enum Decl {
    DImport($imp: ImportDecl)
    DSub($sub: SubDecl)
    DClass($cd: ClassDecl)
    DEnum($ed: EnumDecl)
    DGrammar($gd: GrammarDecl)
}

pub enum DeclList {
    DeclNil
    DeclCons($head: Decl, $tail: DeclList)
}

pub class Program {
    has $.decls: DeclList
}

class Parser {
    has $.toks: TokenList
    has $.layout: Bool
}

class RType {
    has $.node: TypeRef
    has $.p: Parser
}

class RParamList {
    has $.nodes: ParamList
    has $.p: Parser
}

class RExpr {
    has $.node: Expr
    has $.p: Parser
}

class RExprList {
    has $.nodes: ExprList
    has $.p: Parser
}

class RMapEntries {
    has $.nodes: MapEntryList
    has $.p: Parser
}

class RStmt {
    has $.node: Stmt
    has $.p: Parser
}

class RStmtList {
    has $.nodes: StmtList
    has $.p: Parser
}

class RDecl {
    has $.node: Decl
    has $.p: Parser
}

class RDeclList {
    has $.nodes: DeclList
    has $.p: Parser
}

class RClassField {
    has $.node: ClassField
    has $.p: Parser
}

class RSubDecl {
    has $.node: SubDecl
    has $.p: Parser
}

# The parsed body of a class: its `has` fields and its `sub` methods/associated
# functions, each collected in source order.
class RClassBody {
    has $.fields: ClassFieldList
    has $.subs: SubDeclList
    has $.p: Parser
}

class RPattern {
    has $.node: Pattern
    has $.p: Parser
}

class RPatternList {
    has $.nodes: PatternList
    has $.p: Parser
}

class RArm {
    has $.node: Arm
    has $.p: Parser
}

class RArmList {
    has $.nodes: ArmList
    has $.p: Parser
}

# The tail of an `if`: the collected `else if` clauses plus the optional final
# `else` block, and the parser position after them.
class RElseChain {
    has $.elifs: ElifList
    has $.els: Option[StmtList]
    has $.p: Parser
}

sub eof_token(): Token {
    tok(KEof, "", 0, 0)
}

sub peek($p: Parser): Token {
    match $p.toks {
        TEnd { eof_token() }
        TMore($t, $rest) { $t }
    }
}

sub advance($p: Parser): Parser {
    match $p.toks {
        TEnd { $p }
        TMore($t, $rest) { Parser(toks: $rest, layout: $p.layout) }
    }
}

sub parse_err($t: Token, $msg: Str): Str {
    "parse error at { $t.line }:{ $t.col }: { $msg }"
}

sub is_kind($t: Token, $k: TokKind): Bool {
    match $t.kind {
        KInt { match $k { KInt { true } _ { false } } }
        KFloat { match $k { KFloat { true } _ { false } } }
        KStr { match $k { KStr { true } _ { false } } }
        KRawStr { match $k { KRawStr { true } _ { false } } }
        KRegex { match $k { KRegex { true } _ { false } } }
        KRxBody { match $k { KRxBody { true } _ { false } } }
        KBool { match $k { KBool { true } _ { false } } }
        KIdent { match $k { KIdent { true } _ { false } } }
        KUpper { match $k { KUpper { true } _ { false } } }
        KSigil { match $k { KSigil { true } _ { false } } }
        KKeyword { match $k { KKeyword { true } _ { false } } }
        KOp { match $k { KOp { true } _ { false } } }
        KPunct { match $k { KPunct { true } _ { false } } }
        KNewline { match $k { KNewline { true } _ { false } } }
        KEof { match $k { KEof { true } _ { false } } }
    }
}

sub is_kw($t: Token, $kw: Str): Bool { is_kind($t, KKeyword) && $t.lexeme == $kw }
sub is_op($t: Token, $op: Str): Bool { is_kind($t, KOp) && $t.lexeme == $op }
sub is_punct($t: Token, $pun: Str): Bool { is_kind($t, KPunct) && $t.lexeme == $pun }

sub skip_seps($p: Parser): Parser {
    $t = peek($p)
    if is_kind($t, KNewline) || is_punct($t, ";") {
        skip_seps(advance($p))
    } else {
        $p
    }
}

sub maybe_sep($p: Parser): Parser {
    $t = peek($p)
    if is_kind($t, KNewline) || is_punct($t, ";") {
        skip_seps(advance($p))
    } else {
        $p
    }
}

# Skip layout newlines without consuming `;`. Newlines may continue a construct
# inside expression delimiters or before a required body (§2.7); a semicolon is
# always an item separator and is never expression whitespace.
sub skip_newlines($p: Parser): Parser {
    $t = peek($p)
    if is_kind($t, KNewline) {
        skip_newlines(advance($p))
    } else {
        $p
    }
}

sub enter_layout($p: Parser): Parser {
    Parser(toks: $p.toks, layout: true)
}

sub enter_items($p: Parser): Parser {
    Parser(toks: $p.toks, layout: false)
}

sub restore_layout($p: Parser, $outer: Parser): Parser {
    Parser(toks: $p.toks, layout: $outer.layout)
}

sub skip_layout_newlines($p: Parser): Parser {
    if $p.layout { skip_newlines($p) } else { $p }
}

sub expect_lex($p: Parser, $lex: Str): Result[Parser, Str] {
    $t = peek($p)
    if $t.lexeme == $lex {
        Ok(advance($p))
    } else {
        Err(parse_err($t, "expected { $lex }"))
    }
}

sub expect_kind($p: Parser, $k: TokKind, $label: Str): Result[Token, Str] {
    $t = peek($p)
    if is_kind($t, $k) {
        Ok($t)
    } else {
        Err(parse_err($t, "expected { $label }"))
    }
}

class RTypeList {
    has $.nodes: TypeList
    has $.p: Parser
}

sub parse_type_list_items($p: Parser, $end: Str): Result[RTypeList, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), $end) {
        Err(parse_err(peek($p0), "expected type name in type argument list"))
    } else {
        match parse_type_ref($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = skip_newlines($head.p)
                if is_punct(peek($after), ",") {
                    match parse_type_list_items(advance($after), $end) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RTypeList(nodes: TypeCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                } else if is_punct(peek($after), $end) {
                    Ok(RTypeList(nodes: TypeCons($head.node, TypeNil), p: advance($after)))
                } else {
                    Err(parse_err(peek($after), "expected , or { $end } in type argument list"))
                }
            }
        }
    }
}

sub parse_type_ref($p: Parser): Result[RType, Str] {
    $p0 = skip_layout_newlines($p)
    match expect_kind($p0, KUpper, "type name") {
        Err($e) { Err($e) }
        Ok($name_tok) {
            $p1 = skip_layout_newlines(advance($p0))
            if is_punct(peek($p1), "[") {
                match parse_type_list_items(enter_layout(advance($p1)), "]") {
                    Err($e) { Err($e) }
                    Ok($args) {
                        Ok(RType(
                            node: TypeRef(name: $name_tok.lexeme, args: $args.nodes),
                            p: restore_layout($args.p, $p0)
                        ))
                    }
                }
            } else {
                Ok(RType(node: TypeRef(name: $name_tok.lexeme, args: TypeNil), p: $p1))
            }
        }
    }
}

sub parse_optional_type($p: Parser): Result[ROptType, Str] {
    $p0 = skip_layout_newlines($p)
    if is_op(peek($p0), ":") {
        match parse_type_ref(advance($p0)) {
            Err($e) { Err($e) }
            Ok($r) { Ok(ROptType(node: Some($r.node), p: $r.p)) }
        }
    } else {
        Ok(ROptType(node: None, p: $p0))
    }
}

class ROptType {
    has $.node: Option[TypeRef]
    has $.p: Parser
}

sub parse_param($p: Parser): Result[RParam, Str] {
    match expect_kind($p, KSigil, "parameter name") {
        Err($e) { Err($e) }
        Ok($name_tok) {
            match parse_optional_type(advance($p)) {
                Err($e) { Err($e) }
                Ok($ty) { Ok(RParam(node: Param(name: $name_tok.lexeme, ty: $ty.node), p: $ty.p)) }
            }
        }
    }
}

class RParam {
    has $.node: Param
    has $.p: Parser
}

sub parse_params($p: Parser): Result[RParamList, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), ")") {
        Ok(RParamList(nodes: ParamNil, p: advance($p0)))
    } else {
        match parse_param($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = skip_newlines($head.p)
                if is_punct(peek($after), ",") {
                    match parse_params(advance($after)) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RParamList(nodes: ParamCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                } else if is_punct(peek($after), ")") {
                    Ok(RParamList(nodes: ParamCons($head.node, ParamNil), p: advance($after)))
                } else {
                    Err(parse_err(peek($after), "expected , or ) in parameter list"))
                }
            }
        }
    }
}

sub infix_prec($op: Str): Int {
    if $op == "||" {
        1
    } else if $op == "&&" {
        2
    } else if $op == "==" || $op == "!=" || $op == "~~" {
        3
    } else if $op == "<" || $op == "<=" || $op == ">" || $op == ">=" {
        4
    } else if $op == ".." || $op == "..<" {
        5
    } else if $op == "+" || $op == "-" || $op == "~" {
        6
    } else if $op == "*" || $op == "/" || $op == "%" {
        7
    } else if $op == "**" {
        8
    } else {
        0
    }
}

# expr = match_expr | if_expr | binary (§20). `if`/`match` are full expression
# forms, not binary operands: they are recognized here, before the binary
# grammar, so an unparenthesized `if`/`match` never appears mid-expression.
sub parse_expr($p: Parser): Result[RExpr, Str] {
    parse_expr_x($p, false)
}

# The condition/subject/iterator of an `if`/`while`/`for`/`match` (and a match-arm
# guard) is parsed here so that a following `{` opens the control-flow BLOCK rather
# than being eaten as a postfix map index. Mirrors the Go parser's
# `parseExprBeforeBlock` / `stopAtBlockBrace` counter (§6.1-§6.3, §7.2): postfix
# `{` map-index consumption is suppressed for the duration of this expression.
sub parse_expr_before_block($p: Parser): Result[RExpr, Str] {
    parse_expr_x($p, true)
}

# `$stop` = suppress postfix map-index braces (the block-brace disambiguation
# above). It is threaded down the binary/unary/postfix chain and PERSISTS through
# call arguments, `[...]` index, and `(...)` grouping (mirroring native, whose
# stopAtBlockBrace counter is not reset there); it is only cleared inside list and
# map literals (parse_expr_list / parse_map_entries call the default parse_expr).
sub parse_expr_x($p: Parser, $stop: Bool): Result[RExpr, Str] {
    $p0 = skip_layout_newlines($p)
    $t = peek($p0)
    if is_kw($t, "if") {
        parse_if($p0)
    } else if is_kw($t, "match") {
        parse_match($p0)
    } else if is_kw($t, "sub") {
        parse_lambda_sub($p0)
    } else {
        parse_bin($p0, 1, $stop)
    }
}

sub parse_bin($p: Parser, $min_prec: Int, $stop: Bool): Result[RExpr, Str] {
    match parse_unary($p, $stop) {
        Err($e) { Err($e) }
        Ok($left) { parse_bin_tail($left.node, $left.p, $min_prec, $stop) }
    }
}

sub parse_bin_tail($left: Expr, $p: Parser, $min_prec: Int, $stop: Bool): Result[RExpr, Str] {
    $p0 = skip_layout_newlines($p)
    $t = peek($p0)
    $prec = if is_kind($t, KOp) { infix_prec($t.lexeme) } else { 0 }
    if $prec < $min_prec || $prec == 0 {
        Ok(RExpr(node: $left, p: $p0))
    } else {
        $next_min = if $t.lexeme == "**" { $prec } else { $prec + 1 }
        # Line-continuation: skip newlines after the operator before the RHS so
        # a trailing-operator multi-line expression (e.g. `"a" ~\n "b" ~\n "c"`)
        # parses as one binary expression, matching the Go lexer's suppression
        # of newlines inside brackets.
        match parse_bin(skip_newlines(advance($p0)), $next_min, $stop) {
            Err($e) { Err($e) }
            Ok($right) {
                parse_bin_tail(EBinary($t.lexeme, $left, $right.node), $right.p, $min_prec, $stop)
            }
        }
    }
}

sub parse_unary($p: Parser, $stop: Bool): Result[RExpr, Str] {
    $p0 = skip_layout_newlines($p)
    $t = peek($p0)
    if is_op($t, "!") || is_op($t, "-") {
        match parse_unary(advance($p0), $stop) {
            Err($e) { Err($e) }
            Ok($r) { Ok(RExpr(node: EUnary($t.lexeme, $r.node), p: $r.p)) }
        }
    } else {
        parse_postfix($p0, $stop)
    }
}

sub parse_postfix($p: Parser, $stop: Bool): Result[RExpr, Str] {
    match parse_primary($p, $stop) {
        Err($e) { Err($e) }
        Ok($base) { parse_postfix_tail($base.node, $base.p, $stop) }
    }
}

sub parse_postfix_tail($expr: Expr, $p: Parser, $stop: Bool): Result[RExpr, Str] {
    $p0 = skip_layout_newlines($p)
    $t = peek($p0)
    $after_t0 = advance($p0)
    $after_t = skip_layout_newlines($after_t0)
    $after_capture_name0 = advance($after_t)
    $after_capture_name = skip_layout_newlines($after_capture_name0)
    if is_punct($t, "(") {
        match parse_call_args(enter_layout($after_t0), ")", $stop) {
            Err($e) { Err($e) }
            Ok($args) {
                parse_postfix_tail(ECall($expr, $args.nodes), restore_layout($args.p, $p0), $stop)
            }
        }
    } else if is_op($t, "::") {
        # §16.1 `module::member`. Mirror the Go parser: the left side must be a bare
        # name (EName), and the member is an identifier or a Pascal name (KIdent or
        # KUpper). Parsed in postfix position so chains continue normally.
        match $expr {
            EName($mod) {
                $p1 = $after_t
                $member = peek($p1)
                if is_kind($member, KIdent) || is_kind($member, KUpper) {
                    parse_postfix_tail(EQualified($mod, $member.lexeme), advance($p1), $stop)
                } else {
                    Err(parse_err($member, "expected module member after ::"))
                }
            }
            _ { Err(parse_err($t, "left side of :: must be an imported module name")) }
        }
    } else if is_op($t, ".") {
        $p1 = $after_t
        $name = peek($p1)
        if is_kind($name, KIdent) {
            parse_postfix_tail(EField($expr, $name.lexeme), advance($p1), $stop)
        } else {
            Err(parse_err($name, "expected field or method name after ."))
        }
    } else if is_punct($t, "[") {
        match parse_expr_x(enter_layout($after_t0), $stop) {
            Err($e) { Err($e) }
            Ok($idx) {
                match expect_lex(skip_newlines($idx.p), "]") {
                    Err($e) { Err($e) }
                    Ok($p2) {
                        parse_postfix_tail(EIndex($expr, $idx.node), restore_layout($p2, $p0), $stop)
                    }
                }
            }
        }
    } else if is_op($t, "<") && is_kind(peek($after_t), KIdent) && is_op(peek($after_capture_name), ">") {
        # §13.3 named Match capture. Any other `<` remains available to the binary
        # parser as less-than; an enclosing delimiter permits layout newlines
        # between the capture tokens.
        $name = peek($after_t)
        parse_postfix_tail(ECapture($expr, $name.lexeme), advance($after_capture_name), $stop)
    } else if is_punct($t, '{') && !$stop {
        # §7.2 postfix map index `receiver{key}`: `%m{"k"}`, `$obj.field{k}`, etc.,
        # lowered to an EIndex like `[...]`. Consumed at the same precedence as
        # call/field/index. Suppressed in before-block contexts ($stop) so an
        # `if`/`while`/`for`/`match` block-opening `{` is not eaten as an index.
        # The key parses in an ordinary (non-stop) context. Mirrors the Go parser's
        # `case token.LBRACE` guarded by stopAtBlockBrace (§6.1-§6.3).
        match parse_expr(enter_layout($after_t0)) {
            Err($e) { Err($e) }
            Ok($idx) {
                match expect_lex(skip_newlines($idx.p), "}") {
                    Err($e) { Err($e) }
                    Ok($p2) {
                        parse_postfix_tail(EIndex($expr, $idx.node), restore_layout($p2, $p0), $stop)
                    }
                }
            }
        }
    } else if is_op($t, "?") {
        # §11.1 postfix `?`: propagate absence/failure. Consumed in the postfix
        # loop at the same precedence as call/field/index, so it attaches to the
        # whole receiver and chains continue normally. Mirrors the Go parser's
        # `case token.QUESTION` in its postfix loop.
        parse_postfix_tail(EQuestion($expr), $after_t0, $stop)
    } else {
        Ok(RExpr(node: $expr, p: $p0))
    }
}

sub parse_call_arg($p: Parser, $stop: Bool): Result[RExpr, Str] {
    $t = peek($p)
    $after_name = skip_newlines(advance($p))
    if is_kind($t, KIdent) && is_op(peek($after_name), ":") {
        match parse_expr_x(skip_newlines(advance($after_name)), $stop) {
            Err($e) { Err($e) }
            Ok($v) { Ok(RExpr(node: ENamedArg($t.lexeme, $v.node), p: $v.p)) }
        }
    } else {
        parse_expr_x($p, $stop)
    }
}

sub parse_call_args($p: Parser, $end: Str, $stop: Bool): Result[RExprList, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), $end) {
        Ok(RExprList(nodes: ExprNil, p: advance($p0)))
    } else {
        match parse_call_arg($p0, $stop) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = skip_newlines($head.p)
                if is_punct(peek($after), ",") {
                    match parse_call_args(advance($after), $end, $stop) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RExprList(nodes: ExprCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                } else if is_punct(peek($after), $end) {
                    Ok(RExprList(nodes: ExprCons($head.node, ExprNil), p: advance($after)))
                } else {
                    Err(parse_err(peek($after), "expected , or { $end } in argument list"))
                }
            }
        }
    }
}

sub parse_expr_list($p: Parser, $end: Str): Result[RExprList, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), $end) {
        Ok(RExprList(nodes: ExprNil, p: advance($p0)))
    } else {
        match parse_expr($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = skip_newlines($head.p)
                if is_punct(peek($after), ",") {
                    match parse_expr_list(advance($after), $end) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RExprList(nodes: ExprCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                } else if is_punct(peek($after), $end) {
                    Ok(RExprList(nodes: ExprCons($head.node, ExprNil), p: advance($after)))
                } else {
                    Err(parse_err(peek($after), "expected , or { $end } in expression list"))
                }
            }
        }
    }
}

sub parse_map_entries($p: Parser): Result[RMapEntries, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), '}') {
        Ok(RMapEntries(nodes: MapEntryNil, p: advance($p0)))
    } else {
        match parse_expr($p0) {
            Err($e) { Err($e) }
            Ok($key) {
                $after_key = skip_newlines($key.p)
                if is_op(peek($after_key), ":") {
                    match parse_expr(skip_newlines(advance($after_key))) {
                        Err($e) { Err($e) }
                        Ok($value) {
                            $after = skip_newlines($value.p)
                            if is_punct(peek($after), ",") {
                                match parse_map_entries(advance($after)) {
                                    Err($e) { Err($e) }
                                    Ok($tail) {
                                        Ok(RMapEntries(nodes: MapEntryCons(MapEntry(key: $key.node, value: $value.node), $tail.nodes), p: $tail.p))
                                    }
                                }
                            } else if is_punct(peek($after), '}') {
                                Ok(RMapEntries(nodes: MapEntryCons(MapEntry(key: $key.node, value: $value.node), MapEntryNil), p: advance($after)))
                            } else {
                                Err(parse_err(peek($after), "expected , or } in map literal"))
                            }
                        }
                    }
                } else {
                    Err(parse_err(peek($after_key), "expected : in map literal"))
                }
            }
        }
    }
}

sub parse_topic_lambda($p: Parser): Result[RExpr, Str] {
    match parse_stmt_list(enter_items(advance($p))) {
        Err($e) { Err($e) }
        Ok($body) {
            Ok(RExpr(
                node: ELambda(ParamCons(Param(name: '$_', ty: None), ParamNil), None, $body.nodes, true),
                p: restore_layout($body.p, $p)
            ))
        }
    }
}

sub parse_lambda_sub($p: Parser): Result[RExpr, Str] {
    match expect_lex($p, "sub") {
        Err($e) { Err($e) }
        Ok($p1) {
            match expect_lex(skip_layout_newlines($p1), "(") {
                Err($e) { Err($e) }
                Ok($p2) {
                    match parse_params(enter_layout($p2)) {
                        Err($e) { Err($e) }
                        Ok($params) {
                            $after_params = restore_layout($params.p, $p)
                            match parse_optional_type($after_params) {
                                Err($e) { Err($e) }
                                Ok($ret) {
                                    match parse_block($ret.p) {
                                        Err($e) { Err($e) }
                                        Ok($body) {
                                            Ok(RExpr(node: ELambda($params.nodes, $ret.node, $body.nodes, false), p: $body.p))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub parse_primary($p: Parser, $stop: Bool): Result[RExpr, Str] {
    $t = peek($p)
    if is_kind($t, KInt) {
        Ok(RExpr(node: EInt($t.lexeme), p: advance($p)))
    } else if is_kind($t, KFloat) {
        Ok(RExpr(node: EFloat($t.lexeme), p: advance($p)))
    } else if is_kind($t, KStr) {
        Ok(RExpr(node: EStr($t.lexeme), p: advance($p)))
    } else if is_kind($t, KRawStr) {
        Ok(RExpr(node: ERawStr($t.lexeme), p: advance($p)))
    } else if is_kind($t, KRegex) {
        Ok(RExpr(node: ERegex($t.lexeme, $t.line, $t.col), p: advance($p)))
    } else if is_kind($t, KBool) {
        Ok(RExpr(node: EBool($t.lexeme), p: advance($p)))
    } else if is_kind($t, KSigil) || is_kind($t, KIdent) {
        Ok(RExpr(node: EName($t.lexeme), p: advance($p)))
    } else if is_kind($t, KUpper) {
        Ok(RExpr(node: ETypeName($t.lexeme), p: advance($p)))
    } else if is_punct($t, "(") {
        # A `( expr )` grouping persists $stop (native does not reset its
        # stopAtBlockBrace counter inside parentheses), so a control-flow `{`
        # after a parenthesized condition still opens the block.
        $p1 = skip_newlines(enter_layout(advance($p)))
        if is_punct(peek($p1), ")") {
            Ok(RExpr(node: EUnit, p: restore_layout(advance($p1), $p)))
        } else {
            match parse_expr_x($p1, $stop) {
                Err($e) { Err($e) }
                Ok($inner) {
                    match expect_lex(skip_newlines($inner.p), ")") {
                        Err($e) { Err($e) }
                        Ok($p2) { Ok(RExpr(node: $inner.node, p: restore_layout($p2, $p))) }
                    }
                }
            }
        }
    } else if is_punct($t, "[") {
        match parse_expr_list(enter_layout(advance($p)), "]") {
            Err($e) { Err($e) }
            Ok($items) {
                Ok(RExpr(node: EList($items.nodes), p: restore_layout($items.p, $p)))
            }
        }
    } else if is_punct($t, '{') {
        $p1 = skip_newlines(enter_layout(advance($p)))
        if is_punct(peek($p1), '}') {
            Ok(RExpr(node: EMap(MapEntryNil), p: restore_layout(advance($p1), $p)))
        } else {
            match parse_map_entries(enter_layout(advance($p))) {
                Ok($items) {
                    Ok(RExpr(node: EMap($items.nodes), p: restore_layout($items.p, $p)))
                }
                Err($e) { parse_topic_lambda($p) }
            }
        }
    } else if is_field_sigil($t) {
        # §8.3 private-field shorthand in expression position: `$!name` (also
        # `@!items` / `%!opts`). Mirrors the Go parser's primary case: a lone
        # sigil token followed by BANG IDENT folds into a single ident
        # expression whose name is `sigil!name`; anything else is an error.
        $p1 = skip_layout_newlines(advance($p))
        $after_bang = skip_layout_newlines(advance($p1))
        if is_op(peek($p1), "!") && is_kind(peek($after_bang), KIdent) {
            $n = peek($after_bang)
            Ok(RExpr(node: EName($t.lexeme ~ "!" ~ $n.lexeme), p: advance($after_bang)))
        } else {
            Err(parse_err($t, "expected private field name after " ~ $t.lexeme))
        }
    } else if is_kw($t, "if") || is_kw($t, "match") {
        Err(parse_err($t, "if/match is not a binary operand; wrap it in ( )"))
    } else {
        Err(parse_err($t, "expected expression"))
    }
}

# ---------------------------------------------------------------------------
# Control-flow expressions (SH2b): `if`/`else if`/`else` and `match` arms with
# patterns and optional guards. Branch and arm bodies are blocks parsed by
# parse_block; statement separators (newlines / `;`) between an arm and the next,
# and before an `else`, are skipped — guji suppresses those newlines inside an
# enclosing block, so the selfhost parser skips them to accept the same programs.
# ---------------------------------------------------------------------------

# A `{ stmt* }` block. Leading separators are skipped first: guji suppresses the
# newline between a condition/subject (or `else`) and its `{` inside an enclosing
# block, but the selfhost lexer emits it, so the parser skips it here to accept
# the same programs. Consumes the opening `{`, the statements, and the `}`.
sub parse_block($p: Parser): Result[RStmtList, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), '{') {
        match parse_stmt_list(enter_items(advance($p0))) {
            Err($e) { Err($e) }
            Ok($body) {
                Ok(RStmtList(nodes: $body.nodes, p: restore_layout($body.p, $p0)))
            }
        }
    } else {
        Err(parse_err(peek($p0), 'expected { to open block'))
    }
}

# if_expr = "if" expr block { "else" "if" expr block } [ "else" block ] (§6.1).
sub parse_if($p: Parser): Result[RExpr, Str] {
    match parse_expr_before_block(advance($p)) {
        Err($e) { Err($e) }
        Ok($cond) {
            match parse_block($cond.p) {
                Err($e) { Err($e) }
                Ok($then) {
                    match parse_else_chain($then.p) {
                        Err($e) { Err($e) }
                        Ok($ch) {
                            Ok(RExpr(node: EIf($cond.node, $then.nodes, $ch.elifs, $ch.els), p: $ch.p))
                        }
                    }
                }
            }
        }
    }
}

# Collect the `else if` clauses (in source order) and the optional final `else`
# block. When no `else` follows, the separators skipped while looking for it are
# not consumed (the original position is returned) so the enclosing statement
# list keeps its separator.
sub parse_else_chain($p: Parser): Result[RElseChain, Str] {
    $p0 = skip_newlines($p)
    if is_kw(peek($p0), "else") {
        $p1 = skip_newlines(advance($p0))
        if is_kw(peek($p1), "if") {
            match parse_expr_before_block(advance($p1)) {
                Err($e) { Err($e) }
                Ok($cond) {
                    match parse_block($cond.p) {
                        Err($e) { Err($e) }
                        Ok($body) {
                            match parse_else_chain($body.p) {
                                Err($e) { Err($e) }
                                Ok($rest) {
                                    Ok(RElseChain(elifs: ElifCons(Elif(cond: $cond.node, body: $body.nodes), $rest.elifs), els: $rest.els, p: $rest.p))
                                }
                            }
                        }
                    }
                }
            }
        } else {
            match parse_block($p1) {
                Err($e) { Err($e) }
                Ok($body) { Ok(RElseChain(elifs: ElifNil, els: Some($body.nodes), p: $body.p)) }
            }
        }
    } else {
        Ok(RElseChain(elifs: ElifNil, els: None, p: $p))
    }
}

# match_expr = "match" expr "{" { arm } "}" (§6.2).
sub parse_match($p: Parser): Result[RExpr, Str] {
    match parse_expr_before_block(advance($p)) {
        Err($e) { Err($e) }
        Ok($subj) {
            $sp = skip_newlines($subj.p)
            if is_punct(peek($sp), '{') {
                match parse_arms(enter_items(advance($sp))) {
                    Err($e) { Err($e) }
                    Ok($arms) {
                        Ok(RExpr(
                            node: EMatch($subj.node, $arms.nodes),
                            p: restore_layout($arms.p, $sp)
                        ))
                    }
                }
            } else {
                Err(parse_err(peek($sp), 'expected { to open match arms'))
            }
        }
    }
}

sub parse_arms($p: Parser): Result[RArmList, Str] {
    $p0 = skip_seps($p)
    if is_punct(peek($p0), '}') {
        Ok(RArmList(nodes: ArmNil, p: advance($p0)))
    } else {
        match parse_arm($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = maybe_sep($head.p)
                match parse_arms($after) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RArmList(nodes: ArmCons($head.node, $tail.nodes), p: $tail.p)) }
                }
            }
        }
    }
}

# arm = pattern [ "if" expr ] block (§6.2, §10.2).
sub parse_arm($p: Parser): Result[RArm, Str] {
    match parse_pattern($p) {
        Err($e) { Err($e) }
        Ok($pat) {
            if is_kw(peek($pat.p), "if") {
                match parse_expr_before_block(advance($pat.p)) {
                    Err($e) { Err($e) }
                    Ok($guard) {
                        match parse_block($guard.p) {
                            Err($e) { Err($e) }
                            Ok($body) { Ok(RArm(node: Arm(pat: $pat.node, guard: Some($guard.node), body: $body.nodes), p: $body.p)) }
                        }
                    }
                }
            } else {
                match parse_block($pat.p) {
                    Err($e) { Err($e) }
                    Ok($body) { Ok(RArm(node: Arm(pat: $pat.node, guard: None, body: $body.nodes), p: $body.p)) }
                }
            }
        }
    }
}

# pattern = pattern_literal | "_" | sigil_name
#         | Pascal [ "(" pattern { "," pattern } ")" ] (§10.1).
# List, Map, Regex, and interpolated Str expressions are not pattern literals.
sub parse_pattern($p: Parser): Result[RPattern, Str] {
    $p0 = skip_layout_newlines($p)
    $t = peek($p0)
    if is_kind($t, KInt) {
        Ok(RPattern(node: PLit(EInt($t.lexeme)), p: advance($p0)))
    } else if is_kind($t, KFloat) {
        Ok(RPattern(node: PLit(EFloat($t.lexeme)), p: advance($p0)))
    } else if is_kind($t, KStr) {
        Ok(RPattern(node: PLit(EStr($t.lexeme)), p: advance($p0)))
    } else if is_kind($t, KRawStr) {
        Ok(RPattern(node: PLit(ERawStr($t.lexeme)), p: advance($p0)))
    } else if is_kind($t, KBool) {
        Ok(RPattern(node: PLit(EBool($t.lexeme)), p: advance($p0)))
    } else if is_kind($t, KSigil) {
        Ok(RPattern(node: PBind($t.lexeme), p: advance($p0)))
    } else if is_kind($t, KIdent) {
        if $t.lexeme == "_" {
            Ok(RPattern(node: PWild, p: advance($p0)))
        } else {
            Err(parse_err($t, "expected pattern"))
        }
    } else if is_kind($t, KUpper) {
        $p1 = skip_layout_newlines(advance($p0))
        if is_punct(peek($p1), "(") {
            match parse_pattern_list(enter_layout(advance($p1))) {
                Err($e) { Err($e) }
                Ok($args) {
                    Ok(RPattern(
                        node: PVariant($t.lexeme, $args.nodes),
                        p: restore_layout($args.p, $p0)
                    ))
                }
            }
        } else {
            Ok(RPattern(node: PVariant($t.lexeme, PatNil), p: $p1))
        }
    } else if is_punct($t, "(") {
        $p1 = skip_newlines(enter_layout(advance($p0)))
        if is_punct(peek($p1), ")") {
            Ok(RPattern(node: PLit(EUnit), p: restore_layout(advance($p1), $p0)))
        } else {
            Err(parse_err(peek($p1), "expected ) in unit pattern"))
        }
    } else {
        Err(parse_err($t, "expected pattern"))
    }
}

# Comma-separated variant field patterns, up to the closing `)`. The caller has
# already consumed the opening `(`.
sub parse_pattern_list($p: Parser): Result[RPatternList, Str] {
    $p0 = skip_newlines($p)
    if is_punct(peek($p0), ")") {
        Ok(RPatternList(nodes: PatNil, p: advance($p0)))
    } else {
        match parse_pattern($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = skip_newlines($head.p)
                if is_punct(peek($after), ",") {
                    match parse_pattern_list(advance($after)) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RPatternList(nodes: PatCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                } else if is_punct(peek($after), ")") {
                    Ok(RPatternList(nodes: PatCons($head.node, PatNil), p: advance($after)))
                } else {
                    Err(parse_err(peek($after), "expected , or ) in pattern"))
                }
            }
        }
    }
}

sub local_sub_body_stmts($body: Body): StmtList {
    match $body {
        BlockBody($stmts) { $stmts }
        ExprBody($expr) { StmtCons(SExpr($expr), StmtNil) }
    }
}

sub parse_stmt($p: Parser): Result[RStmt, Str] {
    $p0 = skip_seps($p)
    $t = peek($p0)
    if is_kw($t, "return") {
        $p1 = advance($p0)
        if is_kind(peek($p1), KNewline) || is_punct(peek($p1), ";") || is_punct(peek($p1), '}') {
            Ok(RStmt(node: SReturn(None), p: $p1))
        } else {
            match parse_expr($p1) {
                Err($e) { Err($e) }
                Ok($r) { Ok(RStmt(node: SReturn(Some($r.node)), p: $r.p)) }
            }
        }
    } else if is_kw($t, "sub") && is_kind(peek(advance($p0)), KIdent) {
        # Named local subs use the existing immutable closure machinery after
        # parsing. A bare internal binding name keeps calls in their source
        # spelling (`add(...)`) while remaining distinct from `$` bindings.
        match parse_sub_decl_node($p0, false) {
            Err($e) { Err($e) }
            Ok($sub) {
                if strlist_empty($sub.node.tparams) {
                    Ok(RStmt(
                        node: SBind(
                            false,
                            $sub.node.name,
                            None,
                            ELambda($sub.node.params, $sub.node.ret, local_sub_body_stmts($sub.node.body), false)
                        ),
                        p: $sub.p
                    ))
                } else {
                    Err(parse_err($t, "generic named local subs are not yet supported"))
                }
            }
        }
    } else if is_kw($t, "mut") {
        parse_binding(true, advance($p0))
    } else if is_kw($t, "while") {
        parse_while($p0)
    } else if is_kw($t, "for") {
        parse_for($p0)
    } else if is_kw($t, "hatch") {
        parse_hatch($p0)
    } else if is_kw($t, "select") {
        parse_select($p0)
    } else if is_kind($t, KSigil) {
        $p1 = advance($p0)
        $next = peek($p1)
        if is_op($next, "=") || is_op($next, ":") {
            parse_binding(false, $p0)
        } else {
            match parse_expr($p0) {
                Err($e) { Err($e) }
                Ok($e1) { Ok(RStmt(node: SExpr($e1.node), p: $e1.p)) }
            }
        }
    } else {
        match parse_expr($p0) {
            Err($e) { Err($e) }
            Ok($e1) { Ok(RStmt(node: SExpr($e1.node), p: $e1.p)) }
        }
    }
}

# hatch_stmt = "hatch" block (§17.1, §20). The block is represented directly
# as a child statement list, matching the Go ast.HatchStmt body.
sub parse_hatch($p: Parser): Result[RStmt, Str] {
    match parse_block(advance($p)) {
        Err($e) { Err($e) }
        Ok($body) { Ok(RStmt(node: SHatch($body.nodes), p: $body.p)) }
    }
}

class RSelectItems {
    has $.arms: SelectArmList
    has $.els: Option[StmtList]
    has $.p: Parser
}

# select_stmt = "select" "{" { select_arm } [ "else" block ] "}" (§17.5,
# §20). Arms stay in source order; a binding is optional and belongs only to
# its arm body. Like the Go parser, an else may occur amid arms but may occur once.
sub parse_select($p: Parser): Result[RStmt, Str] {
    $p1 = skip_newlines(advance($p))
    if is_punct(peek($p1), '{') {
        match parse_select_items(advance($p1)) {
            Err($e) { Err($e) }
            Ok($r) { Ok(RStmt(node: SSelect($r.arms, $r.els), p: $r.p)) }
        }
    } else {
        Err(parse_err(peek($p1), "expected \{ to open select"))
    }
}

sub parse_select_items($p: Parser): Result[RSelectItems, Str] {
    $p0 = skip_seps($p)
    if is_punct(peek($p0), "}") {
        Ok(RSelectItems(arms: SelectArmNil, els: None, p: advance($p0)))
    } else if is_kw(peek($p0), "else") {
        match parse_block(advance($p0)) {
            Err($e) { Err($e) }
            Ok($body) {
                match parse_select_items($body.p) {
                    Err($e) { Err($e) }
                    Ok($tail) {
                        match $tail.els {
                            Some($prior) { Err(parse_err(peek($p0), "duplicate select else arm")) }
                            None { Ok(RSelectItems(arms: $tail.arms, els: Some($body.nodes), p: $tail.p)) }
                        }
                    }
                }
            }
        }
    } else {
        parse_select_arm($p0)
    }
}

sub parse_select_arm($p: Parser): Result[RSelectItems, Str] {
    $t = peek($p)
    if is_kind($t, KSigil) && is_op(peek(advance($p)), "=") {
        parse_select_arm_tail(advance(advance($p)), Some($t.lexeme))
    } else {
        parse_select_arm_tail($p, None)
    }
}

sub parse_select_arm_tail($p: Parser, $bind: Option[Str]): Result[RSelectItems, Str] {
    match parse_expr_before_block($p) {
        Err($e) { Err($e) }
        Ok($op) {
            match parse_block($op.p) {
                Err($e) { Err($e) }
                Ok($body) {
                    match parse_select_items($body.p) {
                        Err($e) { Err($e) }
                        Ok($tail) {
                            Ok(RSelectItems(
                                arms: SelectArmCons(SelectArm(bind: $bind, op: $op.node, body: $body.nodes), $tail.arms),
                                els: $tail.els,
                                p: $tail.p
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub parse_binding($mutable: Bool, $p: Parser): Result[RStmt, Str] {
    match expect_kind($p, KSigil, "binding name") {
        Err($e) { Err($e) }
        Ok($name_tok) {
            match parse_optional_type(advance($p)) {
                Err($e) { Err($e) }
                Ok($ty) {
                    if is_op(peek($ty.p), "=") {
                        match parse_expr(advance($ty.p)) {
                            Err($e) { Err($e) }
                            Ok($value) { Ok(RStmt(node: SBind($mutable, $name_tok.lexeme, $ty.node, $value.node), p: $value.p)) }
                        }
                    } else {
                        Err(parse_err(peek($ty.p), "expected = in binding"))
                    }
                }
            }
        }
    }
}

# while_stmt = "while" expr block (§6.3, §20). The condition is parsed before the
# block exactly like `if` (parse_expr stops at the opening `{`), then a brace block
# becomes the loop body. Mirrors the Go parser's parseWhileStmt.
sub parse_while($p: Parser): Result[RStmt, Str] {
    match parse_expr_before_block(advance($p)) {
        Err($e) { Err($e) }
        Ok($cond) {
            match parse_block($cond.p) {
                Err($e) { Err($e) }
                Ok($body) { Ok(RStmt(node: SWhile($cond.node, $body.nodes), p: $body.p)) }
            }
        }
    }
}

# for_stmt = "for" sigil [ "," sigil ] "in" expr block (§6.3, §20). One loop
# variable for lists/ranges, two (key, value) for maps. The iterator expression is
# parsed before the block (parse_expr stops at the opening `{`, like `while`), then
# a brace block becomes the loop body. Mirrors the Go parser's parseForStmt.
sub parse_for($p: Parser): Result[RStmt, Str] {
    $p1 = advance($p)
    match expect_kind($p1, KSigil, "loop variable") {
        Err($e) { Err($e) }
        Ok($first) {
            $p2 = advance($p1)
            if is_punct(peek($p2), ",") {
                match expect_kind(advance($p2), KSigil, "loop variable") {
                    Err($e) { Err($e) }
                    Ok($second) {
                        parse_for_tail(advance(advance($p2)), StrCons($first.lexeme, StrCons($second.lexeme, StrNil)))
                    }
                }
            } else {
                parse_for_tail($p2, StrCons($first.lexeme, StrNil))
            }
        }
    }
}

# After the loop variable list: expect `in`, the iterator expression, and the body.
sub parse_for_tail($p: Parser, $vars: StrList): Result[RStmt, Str] {
    if is_kw(peek($p), "in") {
        match parse_expr_before_block(advance($p)) {
            Err($e) { Err($e) }
            Ok($iter) {
                match parse_block($iter.p) {
                    Err($e) { Err($e) }
                    Ok($body) { Ok(RStmt(node: SFor($vars, $iter.node, $body.nodes), p: $body.p)) }
                }
            }
        }
    } else {
        Err(parse_err(peek($p), "expected in"))
    }
}

sub parse_stmt_list($p: Parser): Result[RStmtList, Str] {
    $p0 = skip_seps($p)
    if is_punct(peek($p0), '}') {
        Ok(RStmtList(nodes: StmtNil, p: advance($p0)))
    } else {
        match parse_stmt($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                $after = maybe_sep($head.p)
                match parse_stmt_list($after) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RStmtList(nodes: StmtCons($head.node, $tail.nodes), p: $tail.p)) }
                }
            }
        }
    }
}

# REPL statements terminate at EOF instead of `}`. Each input line is parsed as
# one independent statement sequence, matching the public CLI contract.
sub parse_repl_stmt_list($p: Parser): Result[RStmtList, Str] {
    $p0 = skip_seps($p)
    if is_kind(peek($p0), KEof) {
        Ok(RStmtList(nodes: StmtNil, p: $p0))
    } else {
        match parse_stmt($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                match parse_repl_stmt_list(maybe_sep($head.p)) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RStmtList(nodes: StmtCons($head.node, $tail.nodes), p: $tail.p)) }
                }
            }
        }
    }
}

sub parse_repl_statements($src: Str): Result[StmtList, Str] {
    match lex($src) {
        Err($e) { Err($e) }
        Ok($toks) {
            match parse_repl_stmt_list(Parser(toks: $toks, layout: false)) {
                Err($e) { Err($e) }
                Ok($stmts) { Ok($stmts.nodes) }
            }
        }
    }
}

# Parse a `sub` declaration to a bare `SubDecl` (no `DSub`/`RDecl` wrapper). Reused
# by both the top-level `parse_sub_decl` and the class-body parser (§8.3 methods).
sub parse_sub_decl_node($p: Parser, $public: Bool): Result[RSubDecl, Str] {
    $start_tok = peek($p)
    match expect_lex($p, "sub") {
        Err($e) { Err($e) }
        Ok($p1) {
            match expect_kind($p1, KIdent, "sub name") {
                Err($e) { Err($e) }
                Ok($name_tok) {
                    match parse_opt_type_params(advance($p1)) {
                        Err($e) { Err($e) }
                        Ok($tp) {
                            match expect_lex($tp.p, "(") {
                                Err($e) { Err($e) }
                                Ok($p2) {
                                    match parse_params(enter_layout($p2)) {
                                        Err($e) { Err($e) }
                                        Ok($params) {
                                            $after_params = restore_layout($params.p, $p)
                                            match parse_optional_type($after_params) {
                                                Err($e) { Err($e) }
                                                Ok($ret) {
                                                    $body_start = skip_newlines($ret.p)
                                                    if is_punct(peek($body_start), '{') {
                                                        match parse_stmt_list(enter_items(advance($body_start))) {
                                                            Err($e) { Err($e) }
                                                            Ok($body) {
                                                                $body_tok = peek($body_start)
                                                                Ok(RSubDecl(node: SubDecl(public: $public, name: $name_tok.lexeme, line: $start_tok.line, col: $start_tok.col, body_line: $body_tok.line, body_col: $body_tok.col, tparams: $tp.node, params: $params.nodes, ret: $ret.node, body: BlockBody($body.nodes)), p: restore_layout($body.p, $body_start)))
                                                            }
                                                        }
                                                    } else if is_op(peek($body_start), "=") {
                                                        match parse_expr(advance($body_start)) {
                                                            Err($e) { Err($e) }
                                                            Ok($expr) {
                                                                $body_tok = peek($body_start)
                                                                Ok(RSubDecl(node: SubDecl(public: $public, name: $name_tok.lexeme, line: $start_tok.line, col: $start_tok.col, body_line: $body_tok.line, body_col: $body_tok.col, tparams: $tp.node, params: $params.nodes, ret: $ret.node, body: ExprBody($expr.node)), p: $expr.p))
                                                            }
                                                        }
                                                    } else {
                                                        Err(parse_err(peek($body_start), "expected sub body"))
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Top-level `sub`: parse the bare declaration and wrap it as a `DSub` top-level decl.
sub parse_sub_decl($p: Parser, $public: Bool): Result[RDecl, Str] {
    match parse_sub_decl_node($p, $public) {
        Err($e) { Err($e) }
        Ok($r) { Ok(RDecl(node: DSub($r.node), p: $r.p)) }
    }
}

sub parse_decl($p: Parser): Result[RDecl, Str] {
    $p0 = skip_seps($p)
    if is_kw(peek($p0), "pub") {
        $p1 = advance($p0)
        if is_kw(peek($p1), "class") {
            parse_class_decl($p1, true)
        } else if is_kw(peek($p1), "enum") {
            parse_enum_decl($p1, true)
        } else if is_kw(peek($p1), "grammar") {
            parse_grammar_decl($p1, true)
        } else if is_kw(peek($p1), "sub") {
            parse_sub_decl($p1, true)
        } else {
            Err(parse_err(peek($p1), "expected declaration after pub"))
        }
    } else if is_kw(peek($p0), "sub") {
        parse_sub_decl($p0, false)
    } else if is_kw(peek($p0), "class") {
        parse_class_decl($p0, false)
    } else if is_kw(peek($p0), "enum") {
        parse_enum_decl($p0, false)
    } else if is_kw(peek($p0), "grammar") {
        parse_grammar_decl($p0, false)
    } else {
        Err(parse_err(peek($p0), "expected declaration"))
    }
}

class RVariant {
    has $.node: Variant
    has $.p: Parser
}

# The parsed body of an enum: its variants and its `sub` methods/associated
# functions (§9), each collected in source order (the enum twin of RClassBody).
class REnumBody {
    has $.variants: VariantList
    has $.subs: SubDeclList
    has $.p: Parser
}

class RTypeParams {
    has $.node: StrList
    has $.p: Parser
}

class RImportPath {
    has $.node: StrList
    has $.alias_line: Int
    has $.alias_col: Int
    has $.p: Parser
}

sub parse_import_path($p: Parser): Result[RImportPath, Str] {
    match expect_kind($p, KIdent, "import path segment") {
        Err($e) { Err($e) }
        Ok($seg) {
            $after = advance($p)
            if is_op(peek($after), "::") {
                match parse_import_path(advance($after)) {
                    Err($e) { Err($e) }
                    Ok($tail) {
                        Ok(RImportPath(
                            node: StrCons($seg.lexeme, $tail.node),
                            alias_line: $tail.alias_line,
                            alias_col: $tail.alias_col,
                            p: $tail.p
                        ))
                    }
                }
            } else {
                Ok(RImportPath(
                    node: StrCons($seg.lexeme, StrNil),
                    alias_line: $seg.line,
                    alias_col: $seg.col,
                    p: $after
                ))
            }
        }
    }
}

sub parse_import_decl($p: Parser): Result[RDecl, Str] {
    match expect_lex($p, "import") {
        Err($e) { Err($e) }
        Ok($p1) {
            match parse_import_path($p1) {
                Err($e) { Err($e) }
                Ok($path) {
                    Ok(RDecl(
                        node: DImport(ImportDecl(
                            path: $path.node,
                            alias_line: $path.alias_line,
                            alias_col: $path.alias_col
                        )),
                        p: $path.p
                    ))
                }
            }
        }
    }
}

sub is_field_sigil($t: Token): Bool {
    is_op($t, "$") || is_op($t, "@") || is_op($t, "%")
}

sub parse_class_decl($p: Parser, $public: Bool): Result[RDecl, Str] {
    match expect_lex($p, "class") {
        Err($e) { Err($e) }
        Ok($p1) {
            match expect_kind($p1, KUpper, "class name") {
                Err($e) { Err($e) }
                Ok($name_tok) {
                    match parse_opt_type_params(advance($p1)) {
                        Err($e) { Err($e) }
                        Ok($tp) {
                            $brace = skip_newlines($tp.p)
                            match expect_lex($brace, '{') {
                                Err($e) { Err($e) }
                                Ok($p2) {
                                    match parse_class_body($p2) {
                                        Err($e) { Err($e) }
                                        Ok($body) {
                                            Ok(RDecl(node: DClass(ClassDecl(public: $public, name: $name_tok.lexeme, tparams: $tp.node, fields: $body.fields, subs: $body.subs)), p: $body.p))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub skip_class_seps($p: Parser): Parser {
    $t = peek($p)
    if is_kind($t, KNewline) || is_punct($t, ";") {
        skip_class_seps(advance($p))
    } else {
        $p
    }
}

# Parse a class body: a mix of `has` fields and `sub` methods/associated functions
# (§8.3), each collected into its own list in source order. Mirrors native's
# parseClassDecl loop (HAS -> Fields, SUB -> Subs), reached recursively so both
# lists preserve order.
sub parse_class_body($p: Parser): Result[RClassBody, Str] {
    $p0 = skip_class_seps($p)
    if is_punct(peek($p0), '}') {
        Ok(RClassBody(fields: ClassFieldNil, subs: SubDeclNil, p: advance($p0)))
    } else if is_kw(peek($p0), "sub") {
        match parse_sub_decl_node($p0, false) {
            Err($e) { Err($e) }
            Ok($head) {
                match parse_class_body($head.p) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RClassBody(fields: $tail.fields, subs: SubDeclCons($head.node, $tail.subs), p: $tail.p)) }
                }
            }
        }
    } else {
        match parse_class_field($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                match parse_class_body($head.p) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RClassBody(fields: ClassFieldCons($head.node, $tail.fields), subs: $tail.subs, p: $tail.p)) }
                }
            }
        }
    }
}

sub parse_class_field($p: Parser): Result[RClassField, Str] {
    match expect_lex($p, "has") {
        Err($e) { Err($e) }
        Ok($p1) {
            $sig = peek($p1)
            if !is_field_sigil($sig) {
                Err(parse_err($sig, "expected field sigil"))
            } else {
                $p2 = advance($p1)
                $vis = peek($p2)
                if is_op($vis, ".") || is_op($vis, "!") {
                    $p3 = advance($p2)
                    match expect_kind($p3, KIdent, "field name") {
                        Err($e) { Err($e) }
                        Ok($name_tok) {
                            match parse_optional_type(advance($p3)) {
                                Err($e) { Err($e) }
                                Ok($ty) {
                                    Ok(RClassField(node: ClassField(public: is_op($vis, "."), sigil: $sig.lexeme, name: $name_tok.lexeme, ty: $ty.node), p: $ty.p))
                                }
                            }
                        }
                    }
                } else {
                    Err(parse_err($vis, "expected . or ! in field name"))
                }
            }
        }
    }
}

# enum_decl = "enum" Pascal [ type_params ] "{" { variant | sub_decl } "}" (§9, §14).
# Variant separators are newlines, semicolons, or commas; `sub` declarations
# (methods / associated functions, §9) may interleave with variants and are
# collected into EnumDecl.subs in source order, mirroring parse_class_body.
sub parse_enum_decl($p: Parser, $public: Bool): Result[RDecl, Str] {
    match expect_lex($p, "enum") {
        Err($e) { Err($e) }
        Ok($p1) {
            match expect_kind($p1, KUpper, "enum name") {
                Err($e) { Err($e) }
                Ok($name_tok) {
                    match parse_opt_type_params(advance($p1)) {
                        Err($e) { Err($e) }
                        Ok($tp) {
                            $brace = skip_newlines($tp.p)
                            match expect_lex($brace, '{') {
                                Err($e) { Err($e) }
                                Ok($p2) {
                                    match parse_enum_body($p2) {
                                        Err($e) { Err($e) }
                                        Ok($vs) {
                                            Ok(RDecl(node: DEnum(EnumDecl(public: $public, name: $name_tok.lexeme, tparams: $tp.node, variants: $vs.variants, subs: $vs.subs)), p: $vs.p))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# type_params = "[" Pascal { "," Pascal } "]" (§20). Optional; absent → StrNil.
sub parse_opt_type_params($p: Parser): Result[RTypeParams, Str] {
    $p0 = skip_layout_newlines($p)
    if is_punct(peek($p0), "[") {
        match parse_type_param_items(enter_layout(advance($p0))) {
            Err($e) { Err($e) }
            Ok($items) {
                Ok(RTypeParams(node: $items.node, p: restore_layout($items.p, $p0)))
            }
        }
    } else {
        Ok(RTypeParams(node: StrNil, p: $p0))
    }
}

sub parse_type_param_items($p: Parser): Result[RTypeParams, Str] {
    $p0 = skip_newlines($p)
    match expect_kind($p0, KUpper, "type parameter name") {
        Err($e) { Err($e) }
        Ok($t) {
            $after = skip_newlines(advance($p0))
            if is_punct(peek($after), ",") {
                match parse_type_param_items(advance($after)) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RTypeParams(node: StrCons($t.lexeme, $tail.node), p: $tail.p)) }
                }
            } else if is_punct(peek($after), "]") {
                Ok(RTypeParams(node: StrCons($t.lexeme, StrNil), p: advance($after)))
            } else {
                Err(parse_err(peek($after), "expected , or ] in type parameters"))
            }
        }
    }
}

# Separators between variants are newlines, semicolons, or commas; collapse any
# run of them (so `North, South` and newline-separated variants both parse).
sub skip_variant_seps($p: Parser): Parser {
    $t = peek($p)
    if is_kind($t, KNewline) || is_punct($t, ";") || is_punct($t, ",") {
        skip_variant_seps(advance($p))
    } else {
        $p
    }
}

# Parse an enum body: a mix of variants and `sub` methods/associated functions
# (§9), each collected into its own list in source order. The enum twin of
# parse_class_body (SUB -> Subs, anything else -> a variant).
sub parse_enum_body($p: Parser): Result[REnumBody, Str] {
    $p0 = skip_variant_seps($p)
    if is_punct(peek($p0), '}') {
        Ok(REnumBody(variants: VariantNil, subs: SubDeclNil, p: advance($p0)))
    } else if is_kw(peek($p0), "sub") {
        match parse_sub_decl_node($p0, false) {
            Err($e) { Err($e) }
            Ok($head) {
                match parse_enum_body($head.p) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(REnumBody(variants: $tail.variants, subs: SubDeclCons($head.node, $tail.subs), p: $tail.p)) }
                }
            }
        }
    } else {
        match parse_variant($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                match parse_enum_body($head.p) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(REnumBody(variants: VariantCons($head.node, $tail.variants), subs: $tail.subs, p: $tail.p)) }
                }
            }
        }
    }
}

# variant = Pascal [ "(" params ")" ]. Fieldless variants carry ParamNil.
sub parse_variant($p: Parser): Result[RVariant, Str] {
    match expect_kind($p, KUpper, "variant name") {
        Err($e) { Err($e) }
        Ok($name_tok) {
            $p1 = advance($p)
            if is_punct(peek($p1), "(") {
                match parse_params(enter_layout(advance($p1))) {
                    Err($e) { Err($e) }
                    Ok($fields) {
                        Ok(RVariant(
                            node: Variant(name: $name_tok.lexeme, fields: $fields.nodes),
                            p: restore_layout($fields.p, $p)
                        ))
                    }
                }
            } else {
                Ok(RVariant(node: Variant(name: $name_tok.lexeme, fields: ParamNil), p: $p1))
            }
        }
    }
}

# grammar_decl = "grammar" Pascal "{" { production } "}" (§14.1).
# production = ( "rule" | "token" | "regex" ) name "{" rx_body "}"
# Each body is one KRxBody token from the lexer (P7a); this stage only nests
# productions under GrammarDecl. Typecheck/eval/codegen skip DGrammar until later P7.
class RProduction {
    has $.node: Production
    has $.p: Parser
}

class RGrammarBody {
    has $.productions: ProductionList
    has $.p: Parser
}

sub parse_grammar_decl($p: Parser, $public: Bool): Result[RDecl, Str] {
    match expect_lex($p, "grammar") {
        Err($e) { Err($e) }
        Ok($p1) {
            match expect_kind($p1, KUpper, "grammar name") {
                Err($e) { Err($e) }
                Ok($name_tok) {
                    $brace = skip_newlines(advance($p1))
                    match expect_lex($brace, '{') {
                        Err($e) { Err($e) }
                        Ok($p2) {
                            match parse_grammar_body($p2) {
                                Err($e) { Err($e) }
                                Ok($body) {
                                    Ok(RDecl(node: DGrammar(GrammarDecl(public: $public, name: $name_tok.lexeme, productions: $body.productions)), p: $body.p))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub skip_grammar_seps($p: Parser): Parser {
    $t = peek($p)
    if is_kind($t, KNewline) || is_punct($t, ";") {
        skip_grammar_seps(advance($p))
    } else {
        $p
    }
}

sub parse_grammar_body($p: Parser): Result[RGrammarBody, Str] {
    $p0 = skip_grammar_seps($p)
    if is_punct(peek($p0), '}') {
        Ok(RGrammarBody(productions: ProductionNil, p: advance($p0)))
    } else {
        match parse_production($p0) {
            Err($e) { Err($e) }
            Ok($head) {
                match parse_grammar_body($head.p) {
                    Err($e) { Err($e) }
                    Ok($tail) { Ok(RGrammarBody(productions: ProductionCons($head.node, $tail.productions), p: $tail.p)) }
                }
            }
        }
    }
}

sub parse_production($p: Parser): Result[RProduction, Str] {
    $kw = peek($p)
    if is_kw($kw, "rule") || is_kw($kw, "token") || is_kw($kw, "regex") {
        $kind = $kw.lexeme
        $p1 = advance($p)
        $name_tok = peek($p1)
        if is_kind($name_tok, KIdent) || is_kind($name_tok, KUpper) {
            $p2 = advance($p1)
            match expect_lex($p2, '{') {
                Err($e) { Err($e) }
                Ok($p3) {
                    match expect_kind($p3, KRxBody, "grammar production body") {
                        Err($e) { Err($e) }
                        Ok($body) {
                            match expect_lex(advance($p3), '}') {
                                Err($e) { Err($e) }
                                Ok($p4) {
                                    Ok(RProduction(node: Production(kind: $kind, name: $name_tok.lexeme, body: $body.lexeme), p: $p4))
                                }
                            }
                        }
                    }
                }
            }
        } else {
            Err(parse_err($name_tok, "expected production name after { $kind }"))
        }
    } else {
        Err(parse_err($kw, "expected rule, token, or regex in grammar body"))
    }
}

# ---------------------------------------------------------------------------
# P7c-2a: PEG production-body parser + grammar validation (§14.1–§14.2).
# Keeps grammar parsing and validation shared so ill-formed bodies fail the
# self-hosted compile driver with exit 1 (the same class as interpreter load),
# before subset emission declines.
# ---------------------------------------------------------------------------

sub peg_is_space($c: Str): Bool {
    $c == " " || $c == "\t" || $c == "\r" || $c == "\n"
}

sub peg_list_rev($xs: PegExprList, $acc: PegExprList): PegExprList {
    match $xs {
        PegNil { $acc }
        PegCons($h, $t) { peg_list_rev($t, PegCons($h, $acc)) }
    }
}

sub peg_list_len($xs: PegExprList): Int {
    match $xs {
        PegNil { 0 }
        PegCons($h, $t) { 1 + peg_list_len($t) }
    }
}

sub peg_interleave_ws($terms: PegExprList, $acc: PegExprList, $first: Bool): PegExprList {
    match $terms {
        PegNil { peg_list_rev($acc, PegNil) }
        PegCons($h, $t) {
            if $first {
                peg_interleave_ws($t, PegCons($h, $acc), false)
            } else {
                peg_interleave_ws($t, PegCons($h, PegCons(PegWhitespace, $acc)), false)
            }
        }
    }
}

# Split a body at top-level `|`, respecting quotes / classes / escapes.
sub peg_split_alts(@chars: List[Str], $i: Int, $start: Int, $in_quote: Bool, $in_class: Bool, $esc: Bool, $acc: StrList): Result[StrList, Str] {
    match get(@chars, $i) {
        None {
            if $in_quote {
                Err("unterminated quoted literal")
            } else if $in_class {
                Err("unterminated character class")
            } else {
                $slice = peg_slice(@chars, $start, $i)
                Ok(peg_strlist_rev(StrCons(trim($slice), $acc), StrNil))
            }
        }
        Some($c) {
            if $esc {
                peg_split_alts(@chars, $i + 1, $start, $in_quote, $in_class, false, $acc)
            } else if $c == "\\" {
                peg_split_alts(@chars, $i + 1, $start, $in_quote, $in_class, true, $acc)
            } else if $c == "'" && !$in_class {
                peg_split_alts(@chars, $i + 1, $start, !$in_quote, $in_class, false, $acc)
            } else if $c == "[" && !$in_quote {
                peg_split_alts(@chars, $i + 1, $start, $in_quote, true, false, $acc)
            } else if $c == "]" && $in_class {
                peg_split_alts(@chars, $i + 1, $start, $in_quote, false, false, $acc)
            } else if $c == "|" && !$in_quote && !$in_class {
                $slice = peg_slice(@chars, $start, $i)
                peg_split_alts(@chars, $i + 1, $i + 1, false, false, false, StrCons(trim($slice), $acc))
            } else {
                peg_split_alts(@chars, $i + 1, $start, $in_quote, $in_class, false, $acc)
            }
        }
    }
}

sub peg_slice(@chars: List[Str], $start: Int, $end: Int): Str {
    peg_slice_acc(@chars, $start, $end, "")
}

sub peg_slice_acc(@chars: List[Str], $i: Int, $end: Int, $acc: Str): Str {
    if $i >= $end {
        $acc
    } else {
        peg_slice_acc(@chars, $i + 1, $end, $acc ~ at(@chars, $i))
    }
}

sub peg_strlist_rev($xs: StrList, $acc: StrList): StrList {
    match $xs {
        StrNil { $acc }
        StrCons($h, $t) { peg_strlist_rev($t, StrCons($h, $acc)) }
    }
}

sub peg_skip_ws(@chars: List[Str], $i: Int): Int {
    if peg_is_space(at(@chars, $i)) {
        peg_skip_ws(@chars, $i + 1)
    } else {
        $i
    }
}

sub peg_scan_ref(@chars: List[Str], $i: Int): Result[PegScan, Str] {
    # $i points at '<'
    peg_scan_ref_name(@chars, $i + 1, "")
}

sub peg_scan_ref_name(@chars: List[Str], $i: Int, $acc: Str): Result[PegScan, Str] {
    match get(@chars, $i) {
        None { Err("unterminated production reference") }
        Some($c) {
            if $c == ">" {
                $name = trim($acc)
                if $name == "" {
                    Err("empty production reference")
                } else {
                    Ok(PegScan(expr: PegRef($name), next: $i + 1))
                }
            } else {
                peg_scan_ref_name(@chars, $i + 1, $acc ~ $c)
            }
        }
    }
}

sub peg_scan_lit(@chars: List[Str], $i: Int): Result[PegScan, Str] {
    # $i points at opening '
    peg_scan_lit_body(@chars, $i + 1, "", false)
}

sub peg_scan_lit_body(@chars: List[Str], $i: Int, $acc: Str, $esc: Bool): Result[PegScan, Str] {
    match get(@chars, $i) {
        None { Err("unterminated quoted literal") }
        Some($c) {
            if $esc {
                if $c == "'" || $c == "\\" {
                    peg_scan_lit_body(@chars, $i + 1, $acc ~ $c, false)
                } else if $c == "n" {
                    peg_scan_lit_body(@chars, $i + 1, $acc ~ "\n", false)
                } else if $c == "t" {
                    peg_scan_lit_body(@chars, $i + 1, $acc ~ "\t", false)
                } else {
                    peg_scan_lit_body(@chars, $i + 1, $acc ~ $c, false)
                }
            } else if $c == "\\" {
                peg_scan_lit_body(@chars, $i + 1, $acc, true)
            } else if $c == "'" {
                Ok(PegScan(expr: PegLit($acc), next: $i + 1))
            } else {
                peg_scan_lit_body(@chars, $i + 1, $acc ~ $c, false)
            }
        }
    }
}

sub peg_scan_regex(@chars: List[Str], $i: Int): Result[PegScan, Str] {
    peg_scan_regex_body(@chars, $i, $i, false, false)
}

sub peg_scan_regex_body(@chars: List[Str], $i: Int, $start: Int, $in_class: Bool, $esc: Bool): Result[PegScan, Str] {
    match get(@chars, $i) {
        None {
            if $in_class {
                Err("unterminated character class")
            } else {
                $raw = trim(peg_slice(@chars, $start, $i))
                if $raw == "" {
                    Err("empty regex atom")
                } else {
                    Ok(PegScan(expr: PegRegex($raw), next: $i))
                }
            }
        }
        Some($c) {
            if $esc {
                peg_scan_regex_body(@chars, $i + 1, $start, $in_class, false)
            } else if $c == "\\" {
                peg_scan_regex_body(@chars, $i + 1, $start, $in_class, true)
            } else if $c == "[" {
                peg_scan_regex_body(@chars, $i + 1, $start, true, false)
            } else if $c == "]" && $in_class {
                peg_scan_regex_body(@chars, $i + 1, $start, false, false)
            } else if !$in_class && peg_is_space($c) {
                $raw = trim(peg_slice(@chars, $start, $i))
                if $raw == "" {
                    Err("empty regex atom")
                } else {
                    Ok(PegScan(expr: PegRegex($raw), next: $i))
                }
            } else {
                peg_scan_regex_body(@chars, $i + 1, $start, $in_class, false)
            }
        }
    }
}

sub peg_scan_terms(@chars: List[Str], $i: Int, $acc: PegExprList): Result[PegTerms, Str] {
    $j = peg_skip_ws(@chars, $i)
    match get(@chars, $j) {
        None { Ok(PegTerms(terms: peg_list_rev($acc, PegNil), next: $j)) }
        Some($c) {
            if $c == "<" {
                match peg_scan_ref(@chars, $j) {
                    Err($e) { Err($e) }
                    Ok($sc) { peg_scan_terms(@chars, $sc.next, PegCons($sc.expr, $acc)) }
                }
            } else if $c == "'" {
                match peg_scan_lit(@chars, $j) {
                    Err($e) { Err($e) }
                    Ok($sc) { peg_scan_terms(@chars, $sc.next, PegCons($sc.expr, $acc)) }
                }
            } else {
                match peg_scan_regex(@chars, $j) {
                    Err($e) { Err($e) }
                    Ok($sc) { peg_scan_terms(@chars, $sc.next, PegCons($sc.expr, $acc)) }
                }
            }
        }
    }
}

sub peg_parse_alt($alt: Str, $implicit_ws: Bool): Result[PegExpr, Str] {
    @chars = split($alt, "")
    match peg_scan_terms(@chars, 0, PegNil) {
        Err($e) { Err($e) }
        Ok($got) {
            $terms = if $implicit_ws && peg_list_len($got.terms) > 1 {
                peg_interleave_ws($got.terms, PegNil, true)
            } else {
                $got.terms
            }
            Ok(PegSeq($terms))
        }
    }
}

sub peg_parse_alts($alts: StrList, $implicit_ws: Bool, $acc: PegExprList): Result[PegExprList, Str] {
    match $alts {
        StrNil { Ok(peg_list_rev($acc, PegNil)) }
        StrCons($h, $t) {
            match peg_parse_alt($h, $implicit_ws) {
                Err($e) { Err($e) }
                Ok($e) { peg_parse_alts($t, $implicit_ws, PegCons($e, $acc)) }
            }
        }
    }
}

# Parse one production body. When $implicit_ws is true (`rule`), insert
# PegWhitespace between adjacent terms of every alternative (§14.1).
pub sub peg_parse_body($body: Str, $implicit_ws: Bool): Result[PegExpr, Str] {
    @chars = split($body, "")
    match peg_split_alts(@chars, 0, 0, false, false, false, StrNil) {
        Err($e) { Err($e) }
        Ok($alts) {
            match peg_parse_alts($alts, $implicit_ws, PegNil) {
                Err($e) { Err($e) }
                Ok($choices) {
                    match $choices {
                        PegCons($only, PegNil) { Ok($only) }
                        _ { Ok(PegChoice($choices)) }
                    }
                }
            }
        }
    }
}

pub sub peg_expr_to_string($e: PegExpr): Str {
    match $e {
        PegChoice($alts) { "Choice[" ~ peg_list_to_string($alts) ~ "]" }
        PegSeq($terms) { "Seq[" ~ peg_list_to_string($terms) ~ "]" }
        PegRef($n) { "Ref(" ~ $n ~ ")" }
        PegLit($t) { "Lit(" ~ $t ~ ")" }
        PegRegex($p) { "Regex(" ~ $p ~ ")" }
        PegWhitespace { "WS" }
    }
}

sub peg_list_to_string($xs: PegExprList): Str {
    match $xs {
        PegNil { "" }
        PegCons($h, PegNil) { peg_expr_to_string($h) }
        PegCons($h, $t) { peg_expr_to_string($h) ~ "," ~ peg_list_to_string($t) }
    }
}

sub peg_prod_lookup($tab: PegProdTable, $name: Str): Option[PegExpr] {
    match $tab {
        PPTNil { None }
        PPTCons($n, $k, $e, $rest) {
            if $n == $name {
                Some($e)
            } else {
                peg_prod_lookup($rest, $name)
            }
        }
    }
}

sub peg_prod_has($tab: PegProdTable, $name: Str): Bool {
    match peg_prod_lookup($tab, $name) {
        Some($e) { true }
        None { false }
    }
}

sub peg_first_refs($e: PegExpr): StrList {
    match $e {
        PegRef($n) { StrCons($n, StrNil) }
        PegSeq($terms) {
            match $terms {
                PegNil { StrNil }
                PegCons($h, $t) { peg_first_refs($h) }
            }
        }
        PegChoice($alts) { peg_first_refs_list($alts) }
        PegLit($t) { StrNil }
        PegRegex($p) { StrNil }
        PegWhitespace { StrNil }
    }
}

sub peg_first_refs_list($xs: PegExprList): StrList {
    match $xs {
        PegNil { StrNil }
        PegCons($h, $t) { peg_strlist_concat(peg_first_refs($h), peg_first_refs_list($t)) }
    }
}

sub peg_strlist_concat($a: StrList, $b: StrList): StrList {
    match $a {
        StrNil { $b }
        StrCons($h, $t) { StrCons($h, peg_strlist_concat($t, $b)) }
    }
}

sub peg_collect_refs($e: PegExpr, $acc: StrList): StrList {
    match $e {
        PegRef($n) { StrCons($n, $acc) }
        PegSeq($terms) { peg_collect_refs_list($terms, $acc) }
        PegChoice($alts) { peg_collect_refs_list($alts, $acc) }
        PegLit($t) { $acc }
        PegRegex($p) { $acc }
        PegWhitespace { $acc }
    }
}

sub peg_collect_refs_list($xs: PegExprList, $acc: StrList): StrList {
    match $xs {
        PegNil { $acc }
        PegCons($h, $t) { peg_collect_refs_list($t, peg_collect_refs($h, $acc)) }
    }
}

sub peg_collect_regexes($e: PegExpr, $acc: StrList): StrList {
    match $e {
        PegRegex($p) { StrCons($p, $acc) }
        PegSeq($terms) { peg_collect_regexes_list($terms, $acc) }
        PegChoice($alts) { peg_collect_regexes_list($alts, $acc) }
        PegRef($n) { $acc }
        PegLit($t) { $acc }
        PegWhitespace { $acc }
    }
}

sub peg_collect_regexes_list($xs: PegExprList, $acc: StrList): StrList {
    match $xs {
        PegNil { $acc }
        PegCons($h, $t) { peg_collect_regexes_list($t, peg_collect_regexes($h, $acc)) }
    }
}

sub peg_check_refs($refs: StrList, $tab: PegProdTable, $gname: Str, $kind: Str, $pname: Str): Result[Str, Str] {
    match $refs {
        StrNil { Ok("ok") }
        StrCons($n, $rest) {
            if peg_prod_has($tab, $n) {
                peg_check_refs($rest, $tab, $gname, $kind, $pname)
            } else {
                Err("grammar " ~ $gname ~ " " ~ $kind ~ " " ~ $pname ~ ": unknown production reference <" ~ $n ~ ">")
            }
        }
    }
}

sub peg_check_regexes($pats: StrList, $gname: Str, $kind: Str, $pname: Str): Result[Str, Str] {
    match $pats {
        StrNil { Ok("ok") }
        StrCons($p, $rest) {
            match Regex.compile($p) {
                Ok($r) { peg_check_regexes($rest, $gname, $kind, $pname) }
                Err($e) {
                    Err("grammar " ~ $gname ~ " " ~ $kind ~ " " ~ $pname ~ ": invalid regex atom \"" ~ $p ~ "\"")
                }
            }
        }
    }
}

sub peg_left_rec_visit($start: Str, $name: Str, $tab: PegProdTable, $seen: StrList, $gname: Str): Result[Str, Str] {
    if strlist_contains($seen, $name) {
        Ok("ok")
    } else {
        match peg_prod_lookup($tab, $name) {
            None { Ok("ok") }
            Some($expr) {
                peg_left_rec_firsts($start, peg_first_refs($expr), $tab, StrCons($name, $seen), $gname)
            }
        }
    }
}

sub peg_left_rec_firsts($start: Str, $refs: StrList, $tab: PegProdTable, $seen: StrList, $gname: Str): Result[Str, Str] {
    match $refs {
        StrNil { Ok("ok") }
        StrCons($next, $rest) {
            if $next == $start {
                Err("grammar " ~ $gname ~ ": left-recursive production " ~ $start ~ " is unsupported for codegen")
            } else {
                match peg_left_rec_visit($start, $next, $tab, $seen, $gname) {
                    Err($e) { Err($e) }
                    Ok($u) { peg_left_rec_firsts($start, $rest, $tab, $seen, $gname) }
                }
            }
        }
    }
}

sub peg_check_left_rec_all($names: StrList, $tab: PegProdTable, $gname: Str): Result[Str, Str] {
    match $names {
        StrNil { Ok("ok") }
        StrCons($n, $rest) {
            match peg_left_rec_visit($n, $n, $tab, StrNil, $gname) {
                Err($e) { Err($e) }
                Ok($u) { peg_check_left_rec_all($rest, $tab, $gname) }
            }
        }
    }
}

sub peg_build_prod_table($ps: ProductionList, $gname: Str, $acc: PegProdTable): Result[PegProdTable, Str] {
    match $ps {
        ProductionNil { Ok($acc) }
        ProductionCons($p, $rest) {
            match peg_parse_body($p.body, $p.kind == "rule") {
                Err($e) {
                    Err("grammar " ~ $gname ~ " " ~ $p.kind ~ " " ~ $p.name ~ ": " ~ $e)
                }
                Ok($expr) {
                    peg_build_prod_table($rest, $gname, PPTCons($p.name, $p.kind, $expr, $acc))
                }
            }
        }
    }
}

sub peg_validate_prods($cursor: PegProdTable, $all: PegProdTable, $gname: Str): Result[Str, Str] {
    match $cursor {
        PPTNil { Ok("ok") }
        PPTCons($name, $kind, $expr, $rest) {
            match peg_check_refs(peg_collect_refs($expr, StrNil), $all, $gname, $kind, $name) {
                Err($e) { Err($e) }
                Ok($u) {
                    match peg_check_regexes(peg_collect_regexes($expr, StrNil), $gname, $kind, $name) {
                        Err($e) { Err($e) }
                        Ok($v) { peg_validate_prods($rest, $all, $gname) }
                    }
                }
            }
        }
    }
}

# Validate one grammar the way native compileGrammars does: parse every body,
# require TOP, reject unknown refs / invalid regex atoms / left recursion.
pub sub validate_grammar_decl($g: GrammarDecl): Result[Str, Str] {
    match peg_build_prod_table($g.productions, $g.name, PPTNil) {
        Err($e) { Err($e) }
        Ok($tab) {
            if !peg_prod_has($tab, "TOP") {
                Err("grammar " ~ $g.name ~ " has no TOP production")
            } else {
                match peg_validate_prods($tab, $tab, $g.name) {
                    Err($e) { Err($e) }
                    Ok($u) {
                        peg_check_left_rec_all(production_names($g.productions), $tab, $g.name)
                    }
                }
            }
        }
    }
}

sub validate_grammar_decls($decls: DeclList): Result[Str, Str] {
    match $decls {
        DeclNil { Ok("ok") }
        DeclCons($d, $rest) {
            match $d {
                DGrammar($g) {
                    match validate_grammar_decl($g) {
                        Err($e) { Err($e) }
                        Ok($u) { validate_grammar_decls($rest) }
                    }
                }
                _ { validate_grammar_decls($rest) }
            }
        }
    }
}

# Public compile-driver hook: after typecheck accept, reject ill-formed PEG
# bodies with exit 1 (not out-of-subset exit 4).
pub sub validate_src_grammars($src: Str): Result[Str, Str] {
    match parse($src) {
        Err($e) { Err($e) }
        Ok($prog) { validate_grammar_decls($prog.decls) }
    }
}

# Conform helper: render every grammar's parsed production bodies.
pub sub grammar_pegs_to_string($src: Str): Result[Str, Str] {
    match parse($src) {
        Err($e) { Err($e) }
        Ok($prog) { Ok(grammar_pegs_render_decls($prog.decls)) }
    }
}

sub grammar_pegs_render_decls($decls: DeclList): Str {
    match $decls {
        DeclNil { "" }
        DeclCons($d, $rest) {
            match $d {
                DGrammar($g) {
                    grammar_pegs_render_one($g) ~ grammar_pegs_render_decls($rest)
                }
                _ { grammar_pegs_render_decls($rest) }
            }
        }
    }
}

sub grammar_pegs_render_one($g: GrammarDecl): Str {
    grammar_pegs_render_prods($g.name, $g.productions)
}

sub grammar_pegs_render_prods($gname: Str, $ps: ProductionList): Str {
    match $ps {
        ProductionNil { "" }
        ProductionCons($p, $rest) {
            $line = match peg_parse_body($p.body, $p.kind == "rule") {
                Ok($e) { $gname ~ "." ~ $p.name ~ "=" ~ peg_expr_to_string($e) }
                Err($err) { $gname ~ "." ~ $p.name ~ "=ERR(" ~ $err ~ ")" }
            }
            match $rest {
                ProductionNil { $line }
                _ { $line ~ "\n" ~ grammar_pegs_render_prods($gname, $rest) }
            }
        }
    }
}

sub parse_decls($p: Parser, $allow_import: Bool): Result[RDeclList, Str] {
    $p0 = skip_seps($p)
    if is_kind(peek($p0), KEof) {
        Ok(RDeclList(nodes: DeclNil, p: $p0))
    } else {
        $is_import = is_kw(peek($p0), "import")
        if $allow_import && $is_import {
            match parse_import_decl($p0) {
                Err($e) { Err($e) }
                Ok($head) {
                    match parse_decls($head.p, true) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RDeclList(nodes: DeclCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                }
            }
        } else {
            match parse_decl($p0) {
                Err($e) { Err($e) }
                Ok($head) {
                    match parse_decls($head.p, false) {
                        Err($e) { Err($e) }
                        Ok($tail) { Ok(RDeclList(nodes: DeclCons($head.node, $tail.nodes), p: $tail.p)) }
                    }
                }
            }
        }
    }
}

pub sub parse($src: Str): Result[Program, Str] {
    match lex($src) {
        Err($e) { Err($e) }
        Ok($toks) {
            match parse_decls(Parser(toks: $toks, layout: false), true) {
                Err($e) { Err($e) }
                Ok($decls) { Ok(Program(decls: $decls.nodes)) }
            }
        }
    }
}

# Temporary SH2 dev rendering. SH3 will replace this with the canonical
# user-facing AST printer; this one exists to prove the parser structure now.
pub sub parse_debug_string($src: Str): Str {
    match parse($src) {
        Err($e) { $e }
        Ok($program) { render_program($program) }
    }
}

sub render_program($p: Program): Str {
    "Program(" ~ render_decls($p.decls) ~ ")"
}

sub render_decls($ds: DeclList): Str {
    match $ds {
        DeclNil { "" }
        DeclCons($d, DeclNil) { render_decl($d) }
        DeclCons($d, $rest) { render_decl($d) ~ "," ~ render_decls($rest) }
    }
}

sub render_decl($d: Decl): Str {
    match $d {
        DImport($i) { "Import(" ~ render_import_path($i.path) ~ ")" }
        DSub($s) { render_sub($s) }
        DClass($c) { "Class(" ~ $c.name ~ ",[" ~ render_class_fields($c.fields) ~ "],[" ~ render_subs($c.subs) ~ "])" }
        DEnum($e) { "Enum(" ~ $e.name ~ ",[" ~ render_variants($e.variants) ~ "],[" ~ render_subs($e.subs) ~ "])" }
        DGrammar($g) { "Grammar(" ~ $g.name ~ ",[" ~ render_productions($g.productions) ~ "])" }
    }
}

sub render_productions($ps: ProductionList): Str {
    match $ps {
        ProductionNil { "" }
        ProductionCons($p, ProductionNil) { render_production($p) }
        ProductionCons($p, $rest) { render_production($p) ~ "," ~ render_productions($rest) }
    }
}

sub render_production($p: Production): Str {
    "Production(" ~ $p.kind ~ "," ~ $p.name ~ "," ~ $p.body ~ ")"
}

sub render_sub($s: SubDecl): Str {
    match $s.tparams {
        StrNil { "Sub(" ~ $s.name ~ "," ~ render_params($s.params) ~ "," ~ render_opt_type($s.ret) ~ "," ~ render_body($s.body) ~ ")" }
        _ { "Sub(" ~ $s.name ~ ",[" ~ render_tparams($s.tparams) ~ "]," ~ render_params($s.params) ~ "," ~ render_opt_type($s.ret) ~ "," ~ render_body($s.body) ~ ")" }
    }
}

sub render_subs($ss: SubDeclList): Str {
    match $ss {
        SubDeclNil { "" }
        SubDeclCons($s, SubDeclNil) { render_sub($s) }
        SubDeclCons($s, $rest) { render_sub($s) ~ "," ~ render_subs($rest) }
    }
}

sub render_tparams($ts: StrList): Str {
    match $ts {
        StrNil { "" }
        StrCons($t, StrNil) { $t }
        StrCons($t, $rest) { $t ~ "," ~ render_tparams($rest) }
    }
}

sub render_import_path($path: StrList): Str {
    match $path {
        StrNil { "" }
        StrCons($h, StrNil) { $h }
        StrCons($h, $rest) { $h ~ "::" ~ render_import_path($rest) }
    }
}

sub render_class_fields($fs: ClassFieldList): Str {
    match $fs {
        ClassFieldNil { "" }
        ClassFieldCons($f, ClassFieldNil) { render_class_field($f) }
        ClassFieldCons($f, $rest) { render_class_field($f) ~ "," ~ render_class_fields($rest) }
    }
}

sub render_class_field($f: ClassField): Str {
    $vis = if $f.public { "." } else { "!" }
    $f.sigil ~ $vis ~ $f.name ~ render_opt_type_suffix($f.ty)
}

sub render_variants($vs: VariantList): Str {
    match $vs {
        VariantNil { "" }
        VariantCons($v, VariantNil) { render_variant($v) }
        VariantCons($v, $rest) { render_variant($v) ~ "," ~ render_variants($rest) }
    }
}

sub render_variant($v: Variant): Str {
    $v.name ~ render_params($v.fields)
}

sub render_params($ps: ParamList): Str {
    match $ps {
        ParamNil { "[]" }
        _ { "[" ~ render_param_items($ps) ~ "]" }
    }
}

sub render_param_items($ps: ParamList): Str {
    match $ps {
        ParamNil { "" }
        ParamCons($p, ParamNil) { $p.name ~ render_opt_type_suffix($p.ty) }
        ParamCons($p, $rest) { $p.name ~ render_opt_type_suffix($p.ty) ~ "," ~ render_param_items($rest) }
    }
}

sub render_opt_type_suffix($t: Option[TypeRef]): Str {
    match $t {
        None { "" }
        Some($ty) { ":" ~ render_type($ty) }
    }
}

sub render_opt_type($t: Option[TypeRef]): Str {
    match $t {
        None { "_" }
        Some($ty) { render_type($ty) }
    }
}

sub render_type($t: TypeRef): Str {
    match $t.args {
        TypeNil { $t.name }
        _ { $t.name ~ "[" ~ render_type_items($t.args) ~ "]" }
    }
}

sub render_type_items($ts: TypeList): Str {
    match $ts {
        TypeNil { "" }
        TypeCons($t, TypeNil) { render_type($t) }
        TypeCons($t, $rest) { render_type($t) ~ "," ~ render_type_items($rest) }
    }
}

sub render_body($b: Body): Str {
    match $b {
        ExprBody($e) { "ExprBody(" ~ render_expr($e) ~ ")" }
        BlockBody($ss) { "BlockBody(" ~ render_stmts($ss) ~ ")" }
    }
}

sub render_stmts($ss: StmtList): Str {
    match $ss {
        StmtNil { "" }
        StmtCons($s, StmtNil) { render_stmt($s) }
        StmtCons($s, $rest) { render_stmt($s) ~ "," ~ render_stmts($rest) }
    }
}

sub render_stmt($s: Stmt): Str {
    match $s {
        SBind($m, $n, $ty, $v) { "Bind(" ~ bool_word($m) ~ "," ~ $n ~ render_opt_type_suffix($ty) ~ "," ~ render_expr($v) ~ ")" }
        SReturn(None) { "Return()" }
        SReturn(Some($v)) { "Return(" ~ render_expr($v) ~ ")" }
        SExpr($e) { "Expr(" ~ render_expr($e) ~ ")" }
        SWhile($cond, $body) { "While(" ~ render_expr($cond) ~ "," ~ render_block($body) ~ ")" }
        SFor($vars, $iter, $body) { "For(" ~ render_var_names($vars) ~ "," ~ render_expr($iter) ~ "," ~ render_block($body) ~ ")" }
        SHatch($body) { "Hatch(" ~ render_block($body) ~ ")" }
        SSelect($arms, $els) { "Select([" ~ render_select_arms($arms) ~ "]," ~ render_select_else($els) ~ ")" }
    }
}

sub render_select_arms($arms: SelectArmList): Str {
    match $arms {
        SelectArmNil { "" }
        SelectArmCons($h, SelectArmNil) { render_select_arm($h) }
        SelectArmCons($h, $t) { render_select_arm($h) ~ "," ~ render_select_arms($t) }
    }
}

sub render_select_arm($arm: SelectArm): Str {
    "SelectArm(" ~ render_opt_bind($arm.bind) ~ "," ~ render_expr($arm.op) ~ "," ~ render_block($arm.body) ~ ")"
}

sub render_opt_bind($bind: Option[Str]): Str {
    match $bind { None { "None" } Some($n) { "Some(" ~ $n ~ ")" } }
}

sub render_select_else($els: Option[StmtList]): Str {
    match $els { None { "None" } Some($b) { "Some(" ~ render_block($b) ~ ")" } }
}

# Loop-variable names joined by spaces (render/debug format only).
sub render_var_names($xs: StrList): Str {
    match $xs {
        StrNil { "" }
        StrCons($h, StrNil) { $h }
        StrCons($h, $t) { $h ~ " " ~ render_var_names($t) }
    }
}

sub bool_word($b: Bool): Str {
    if $b { "true" } else { "false" }
}

sub render_exprs($xs: ExprList): Str {
    match $xs {
        ExprNil { "" }
        ExprCons($e, ExprNil) { render_expr($e) }
        ExprCons($e, $rest) { render_expr($e) ~ "," ~ render_exprs($rest) }
    }
}

sub render_map_entries($xs: MapEntryList): Str {
    match $xs {
        MapEntryNil { "" }
        MapEntryCons($e, MapEntryNil) { render_expr($e.key) ~ ":" ~ render_expr($e.value) }
        MapEntryCons($e, $rest) { render_expr($e.key) ~ ":" ~ render_expr($e.value) ~ "," ~ render_map_entries($rest) }
    }
}

sub render_expr($e: Expr): Str {
    match $e {
        EInt($x) { "Int(" ~ $x ~ ")" }
        EFloat($x) { "Float(" ~ $x ~ ")" }
        EStr($x) { "Str(" ~ $x ~ ")" }
        ERawStr($x) { "RawStr(" ~ $x ~ ")" }
        ERegex($x, $l, $c) { "Regex(/" ~ $x ~ "/)" }
        EBool($x) { "Bool(" ~ $x ~ ")" }
        EName($x) { "Name(" ~ $x ~ ")" }
        ETypeName($x) { "Type(" ~ $x ~ ")" }
        EQualified($m, $n) { "Qualified(" ~ $m ~ "::" ~ $n ~ ")" }
        EUnit { "Unit" }
        EList($xs) { "List[" ~ render_exprs($xs) ~ "]" }
        EMap($xs) { 'Map{' ~ render_map_entries($xs) ~ '}' }
        EUnary($op, $x) { "Unary(" ~ $op ~ "," ~ render_expr($x) ~ ")" }
        EBinary($op, $l, $r) { "Binary(" ~ $op ~ "," ~ render_expr($l) ~ "," ~ render_expr($r) ~ ")" }
        ENamedArg($n, $v) { "Named(" ~ $n ~ "," ~ render_expr($v) ~ ")" }
        ECall($c, $args) { "Call(" ~ render_expr($c) ~ ",[" ~ render_exprs($args) ~ "])" }
        EField($o, $n) { "Field(" ~ render_expr($o) ~ "," ~ $n ~ ")" }
        EIndex($o, $i) { "Index(" ~ render_expr($o) ~ "," ~ render_expr($i) ~ ")" }
        ECapture($o, $n) { "Capture(" ~ render_expr($o) ~ "," ~ $n ~ ")" }
        EIf($cond, $then, $elifs, $els) {
            "If(" ~ render_expr($cond) ~ "," ~ render_block($then) ~ ",[" ~ render_elifs($elifs) ~ "]," ~ render_opt_block($els) ~ ")"
        }
        EMatch($subj, $arms) { "Match(" ~ render_expr($subj) ~ ",[" ~ render_arms($arms) ~ "])" }
        ELambda($params, $ret, $body, $topic) {
            "Lambda(" ~ bool_word($topic) ~ "," ~ render_params($params) ~ "," ~ render_opt_type($ret) ~ "," ~ render_block($body) ~ ")"
        }
        EQuestion($x) { "Question(" ~ render_expr($x) ~ ")" }
    }
}

sub render_block($ss: StmtList): Str {
    "Block(" ~ render_stmts($ss) ~ ")"
}

sub render_opt_block($b: Option[StmtList]): Str {
    match $b {
        None { "_" }
        Some($ss) { render_block($ss) }
    }
}

sub render_elifs($es: ElifList): Str {
    match $es {
        ElifNil { "" }
        ElifCons($e, ElifNil) { render_elif($e) }
        ElifCons($e, $rest) { render_elif($e) ~ "," ~ render_elifs($rest) }
    }
}

sub render_elif($e: Elif): Str {
    "Elif(" ~ render_expr($e.cond) ~ "," ~ render_block($e.body) ~ ")"
}

sub render_arms($as: ArmList): Str {
    match $as {
        ArmNil { "" }
        ArmCons($a, ArmNil) { render_arm($a) }
        ArmCons($a, $rest) { render_arm($a) ~ "," ~ render_arms($rest) }
    }
}

sub render_arm($a: Arm): Str {
    "Arm(" ~ render_pattern($a.pat) ~ "," ~ render_opt_guard($a.guard) ~ "," ~ render_block($a.body) ~ ")"
}

sub render_opt_guard($g: Option[Expr]): Str {
    match $g {
        None { "_" }
        Some($e) { render_expr($e) }
    }
}

sub render_pattern($pat: Pattern): Str {
    match $pat {
        PLit($e) { "PLit(" ~ render_expr($e) ~ ")" }
        PWild { "PWild" }
        PBind($n) { "PBind(" ~ $n ~ ")" }
        PVariant($n, $args) { "PVariant(" ~ $n ~ ",[" ~ render_patterns($args) ~ "])" }
    }
}

sub render_patterns($ps: PatternList): Str {
    match $ps {
        PatNil { "" }
        PatCons($p, PatNil) { render_pattern($p) }
        PatCons($p, $rest) { render_pattern($p) ~ "," ~ render_patterns($rest) }
    }
}

# ---------------------------------------------------------------------------
# SH3 canonical AST printer. This is the user-facing rendering for the dogfood
# parser: field names are explicit, list order is source order, and all source
# strings are escaped so punctuation/newlines inside literals are unambiguous.
# ---------------------------------------------------------------------------

pub sub ast_to_string($p: Program): Str {
    canon_program($p)
}

pub sub parse_to_string($src: Str): Result[Str, Str] {
    match parse($src) {
        Err($e) { Err($e) }
        Ok($program) { Ok(ast_to_string($program)) }
    }
}

sub q($s: Str): Str {
    "\"" ~ escape_chars(split($s, ""), 0) ~ "\""
}

sub escape_chars(@chars: List[Str], $i: Int): Str {
    match get(@chars, $i) {
        None { "" }
        Some($c) {
            escape_char($c) ~ escape_chars(@chars, $i + 1)
        }
    }
}

sub escape_char($c: Str): Str {
    if $c == "\\" {
        "\\\\"
    } else if $c == "\"" {
        "\\\""
    } else if $c == "\n" {
        "\\n"
    } else if $c == "\r" {
        "\\r"
    } else if $c == "\t" {
        "\\t"
    } else {
        $c
    }
}

sub canon_program($p: Program): Str {
    "Program(decls=[" ~ canon_decls($p.decls) ~ "])"
}

sub canon_decls($ds: DeclList): Str {
    match $ds {
        DeclNil { "" }
        DeclCons($d, DeclNil) { canon_decl($d) }
        DeclCons($d, $rest) { canon_decl($d) ~ "," ~ canon_decls($rest) }
    }
}

sub canon_decl($d: Decl): Str {
    match $d {
        DImport($i) { "Import(path=[" ~ canon_import_path($i.path) ~ "])" }
        DSub($s) { canon_sub($s) }
        DClass($c) { "Class(public=" ~ bool_word($c.public) ~ ",name=" ~ q($c.name) ~ ",tparams=[" ~ canon_tparams($c.tparams) ~ "],fields=[" ~ canon_class_fields($c.fields) ~ "],subs=[" ~ canon_subs($c.subs) ~ "])" }
        DEnum($e) { "Enum(public=" ~ bool_word($e.public) ~ ",name=" ~ q($e.name) ~ ",tparams=[" ~ canon_tparams($e.tparams) ~ "],variants=[" ~ canon_variants($e.variants) ~ "],subs=[" ~ canon_subs($e.subs) ~ "])" }
        DGrammar($g) { "Grammar(public=" ~ bool_word($g.public) ~ ",name=" ~ q($g.name) ~ ",productions=[" ~ canon_productions($g.productions) ~ "])" }
    }
}

sub canon_productions($ps: ProductionList): Str {
    match $ps {
        ProductionNil { "" }
        ProductionCons($p, ProductionNil) { canon_production($p) }
        ProductionCons($p, $rest) { canon_production($p) ~ "," ~ canon_productions($rest) }
    }
}

sub canon_production($p: Production): Str {
    "Production(kind=" ~ q($p.kind) ~ ",name=" ~ q($p.name) ~ ",body=" ~ q($p.body) ~ ")"
}

sub canon_import_path($path: StrList): Str {
    match $path {
        StrNil { "" }
        StrCons($h, StrNil) { q($h) }
        StrCons($h, $rest) { q($h) ~ "," ~ canon_import_path($rest) }
    }
}

sub canon_class_fields($fs: ClassFieldList): Str {
    match $fs {
        ClassFieldNil { "" }
        ClassFieldCons($f, ClassFieldNil) { canon_class_field($f) }
        ClassFieldCons($f, $rest) { canon_class_field($f) ~ "," ~ canon_class_fields($rest) }
    }
}

sub canon_class_field($f: ClassField): Str {
    "Field(public=" ~ bool_word($f.public) ~ ",sigil=" ~ q($f.sigil) ~ ",name=" ~ q($f.name) ~ ",type=" ~ canon_opt_type($f.ty) ~ ")"
}

sub canon_sub($s: SubDecl): Str {
    match $s.tparams {
        StrNil { "Sub(public=" ~ bool_word($s.public) ~ ",name=" ~ q($s.name) ~ ",params=[" ~ canon_params($s.params) ~ "],ret=" ~ canon_opt_type($s.ret) ~ ",body=" ~ canon_body($s.body) ~ ")" }
        _ { "Sub(public=" ~ bool_word($s.public) ~ ",name=" ~ q($s.name) ~ ",tparams=[" ~ canon_tparams($s.tparams) ~ "],params=[" ~ canon_params($s.params) ~ "],ret=" ~ canon_opt_type($s.ret) ~ ",body=" ~ canon_body($s.body) ~ ")" }
    }
}

sub canon_subs($ss: SubDeclList): Str {
    match $ss {
        SubDeclNil { "" }
        SubDeclCons($s, SubDeclNil) { canon_sub($s) }
        SubDeclCons($s, $rest) { canon_sub($s) ~ "," ~ canon_subs($rest) }
    }
}

sub canon_tparams($ts: StrList): Str {
    match $ts {
        StrNil { "" }
        StrCons($t, StrNil) { q($t) }
        StrCons($t, $rest) { q($t) ~ "," ~ canon_tparams($rest) }
    }
}

sub canon_variants($vs: VariantList): Str {
    match $vs {
        VariantNil { "" }
        VariantCons($v, VariantNil) { canon_variant($v) }
        VariantCons($v, $rest) { canon_variant($v) ~ "," ~ canon_variants($rest) }
    }
}

sub canon_variant($v: Variant): Str {
    "Variant(name=" ~ q($v.name) ~ ",fields=[" ~ canon_params($v.fields) ~ "])"
}

sub canon_params($ps: ParamList): Str {
    match $ps {
        ParamNil { "" }
        ParamCons($p, ParamNil) { canon_param($p) }
        ParamCons($p, $rest) { canon_param($p) ~ "," ~ canon_params($rest) }
    }
}

sub canon_param($p: Param): Str {
    "Param(name=" ~ q($p.name) ~ ",type=" ~ canon_opt_type($p.ty) ~ ")"
}

sub canon_opt_type($t: Option[TypeRef]): Str {
    match $t {
        None { "None" }
        Some($ty) { "Some(" ~ canon_type($ty) ~ ")" }
    }
}

sub canon_type($t: TypeRef): Str {
    "Type(name=" ~ q($t.name) ~ ",args=[" ~ canon_type_items($t.args) ~ "])"
}

sub canon_type_items($ts: TypeList): Str {
    match $ts {
        TypeNil { "" }
        TypeCons($t, TypeNil) { canon_type($t) }
        TypeCons($t, $rest) { canon_type($t) ~ "," ~ canon_type_items($rest) }
    }
}

sub canon_body($b: Body): Str {
    match $b {
        ExprBody($e) { "ExprBody(expr=" ~ canon_expr($e) ~ ")" }
        BlockBody($ss) { "BlockBody(stmts=[" ~ canon_stmts($ss) ~ "])" }
    }
}

sub canon_block($ss: StmtList): Str {
    "Block(stmts=[" ~ canon_stmts($ss) ~ "])"
}

sub canon_stmts($ss: StmtList): Str {
    match $ss {
        StmtNil { "" }
        StmtCons($s, StmtNil) { canon_stmt($s) }
        StmtCons($s, $rest) { canon_stmt($s) ~ "," ~ canon_stmts($rest) }
    }
}

sub canon_stmt($s: Stmt): Str {
    match $s {
        SBind($m, $n, $ty, $v) { "Bind(mut=" ~ bool_word($m) ~ ",name=" ~ q($n) ~ ",type=" ~ canon_opt_type($ty) ~ ",value=" ~ canon_expr($v) ~ ")" }
        SReturn(None) { "Return(value=None)" }
        SReturn(Some($v)) { "Return(value=Some(" ~ canon_expr($v) ~ "))" }
        SExpr($e) { "Expr(value=" ~ canon_expr($e) ~ ")" }
        SWhile($cond, $body) { "While(cond=" ~ canon_expr($cond) ~ ",body=" ~ canon_block($body) ~ ")" }
        SFor($vars, $iter, $body) { "For(vars=[" ~ canon_tparams($vars) ~ "],iter=" ~ canon_expr($iter) ~ ",body=" ~ canon_block($body) ~ ")" }
        SHatch($body) { "Hatch(body=" ~ canon_block($body) ~ ")" }
        SSelect($arms, $els) { "Select(arms=[" ~ canon_select_arms($arms) ~ "],else=" ~ canon_select_else($els) ~ ")" }
    }
}

sub canon_select_arms($arms: SelectArmList): Str {
    match $arms {
        SelectArmNil { "" }
        SelectArmCons($h, SelectArmNil) { canon_select_arm($h) }
        SelectArmCons($h, $t) { canon_select_arm($h) ~ "," ~ canon_select_arms($t) }
    }
}

sub canon_select_arm($arm: SelectArm): Str {
    "SelectArm(bind=" ~ canon_select_bind($arm.bind) ~ ",op=" ~ canon_expr($arm.op) ~ ",body=" ~ canon_block($arm.body) ~ ")"
}

sub canon_select_bind($bind: Option[Str]): Str {
    match $bind { None { "None" } Some($n) { "Some(" ~ q($n) ~ ")" } }
}

sub canon_select_else($els: Option[StmtList]): Str {
    match $els { None { "None" } Some($b) { "Some(" ~ canon_block($b) ~ ")" } }
}

sub canon_exprs($xs: ExprList): Str {
    match $xs {
        ExprNil { "" }
        ExprCons($e, ExprNil) { canon_expr($e) }
        ExprCons($e, $rest) { canon_expr($e) ~ "," ~ canon_exprs($rest) }
    }
}

sub canon_map_entries($xs: MapEntryList): Str {
    match $xs {
        MapEntryNil { "" }
        MapEntryCons($e, MapEntryNil) { canon_map_entry($e) }
        MapEntryCons($e, $rest) { canon_map_entry($e) ~ "," ~ canon_map_entries($rest) }
    }
}

sub canon_map_entry($e: MapEntry): Str {
    "Entry(key=" ~ canon_expr($e.key) ~ ",value=" ~ canon_expr($e.value) ~ ")"
}

sub canon_expr($e: Expr): Str {
    match $e {
        EInt($x) { "Int(text=" ~ q($x) ~ ")" }
        EFloat($x) { "Float(text=" ~ q($x) ~ ")" }
        EStr($x) { "Str(value=" ~ q($x) ~ ")" }
        ERawStr($x) { "RawStr(value=" ~ q($x) ~ ")" }
        ERegex($x, $l, $c) { "Regex(pattern=" ~ q($x) ~ ")" }
        EBool($x) { "Bool(value=" ~ q($x) ~ ")" }
        EName($x) { "Name(value=" ~ q($x) ~ ")" }
        ETypeName($x) { "TypeName(value=" ~ q($x) ~ ")" }
        EQualified($m, $n) { "Qualified(module=" ~ q($m) ~ ",member=" ~ q($n) ~ ")" }
        EUnit { "Unit" }
        EList($xs) { "List(items=[" ~ canon_exprs($xs) ~ "])" }
        EMap($xs) { "Map(entries=[" ~ canon_map_entries($xs) ~ "])" }
        EUnary($op, $x) { "Unary(op=" ~ q($op) ~ ",expr=" ~ canon_expr($x) ~ ")" }
        EBinary($op, $l, $r) { "Binary(op=" ~ q($op) ~ ",left=" ~ canon_expr($l) ~ ",right=" ~ canon_expr($r) ~ ")" }
        ENamedArg($n, $v) { "NamedArg(name=" ~ q($n) ~ ",value=" ~ canon_expr($v) ~ ")" }
        ECall($c, $args) { "Call(callee=" ~ canon_expr($c) ~ ",args=[" ~ canon_exprs($args) ~ "])" }
        EField($o, $n) { "Field(object=" ~ canon_expr($o) ~ ",name=" ~ q($n) ~ ")" }
        EIndex($o, $i) { "Index(object=" ~ canon_expr($o) ~ ",index=" ~ canon_expr($i) ~ ")" }
        ECapture($o, $n) { "Capture(object=" ~ canon_expr($o) ~ ",name=" ~ q($n) ~ ")" }
        EIf($cond, $then, $elifs, $els) { "If(cond=" ~ canon_expr($cond) ~ ",then=" ~ canon_block($then) ~ ",elifs=[" ~ canon_elifs($elifs) ~ "],else=" ~ canon_opt_block($els) ~ ")" }
        EMatch($subj, $arms) { "Match(subject=" ~ canon_expr($subj) ~ ",arms=[" ~ canon_arms($arms) ~ "])" }
        ELambda($params, $ret, $body, $topic) {
            "Lambda(topic=" ~ bool_word($topic) ~ ",params=[" ~ canon_params($params) ~ "],ret=" ~ canon_opt_type($ret) ~ ",body=" ~ canon_block($body) ~ ")"
        }
        EQuestion($x) { "Question(expr=" ~ canon_expr($x) ~ ")" }
    }
}

sub canon_opt_block($b: Option[StmtList]): Str {
    match $b {
        None { "None" }
        Some($ss) { "Some(" ~ canon_block($ss) ~ ")" }
    }
}

sub canon_elifs($es: ElifList): Str {
    match $es {
        ElifNil { "" }
        ElifCons($e, ElifNil) { canon_elif($e) }
        ElifCons($e, $rest) { canon_elif($e) ~ "," ~ canon_elifs($rest) }
    }
}

sub canon_elif($e: Elif): Str {
    "Elif(cond=" ~ canon_expr($e.cond) ~ ",body=" ~ canon_block($e.body) ~ ")"
}

sub canon_arms($as: ArmList): Str {
    match $as {
        ArmNil { "" }
        ArmCons($a, ArmNil) { canon_arm($a) }
        ArmCons($a, $rest) { canon_arm($a) ~ "," ~ canon_arms($rest) }
    }
}

sub canon_arm($a: Arm): Str {
    "Arm(pattern=" ~ canon_pattern($a.pat) ~ ",guard=" ~ canon_opt_guard($a.guard) ~ ",body=" ~ canon_block($a.body) ~ ")"
}

sub canon_opt_guard($g: Option[Expr]): Str {
    match $g {
        None { "None" }
        Some($e) { "Some(" ~ canon_expr($e) ~ ")" }
    }
}

sub canon_pattern($pat: Pattern): Str {
    match $pat {
        PLit($e) { "PLit(expr=" ~ canon_expr($e) ~ ")" }
        PWild { "PWild" }
        PBind($n) { "PBind(name=" ~ q($n) ~ ")" }
        PVariant($n, $args) { "PVariant(name=" ~ q($n) ~ ",args=[" ~ canon_patterns($args) ~ "])" }
    }
}

sub canon_patterns($ps: PatternList): Str {
    match $ps {
        PatNil { "" }
        PatCons($p, PatNil) { canon_pattern($p) }
        PatCons($p, $rest) { canon_pattern($p) ~ "," ~ canon_patterns($rest) }
    }
}

# ===========================================================================
# SELFHOST SLICE 2 -- the canonical tree-walking EVALUATOR (E1: value model +
# environment + core-expression eval), checked exactly against compiled Guji
# programs and spec-pinned expected results.
#
# E1 SCOPE (this slice): the runtime `Value` model, an `Env` scope chain, a
# sub-table (name -> SubDecl), and evaluation of the atom expressions
# (EInt/EFloat/EStr/EBool/EName/EUnit), `EUnary`, and `EBinary`
# (arithmetic/comparison/logical per spec Sections 5.1-5.2; `&&`/`||`
# short-circuit; precedence already baked into the parse tree). Div/mod-by-zero
# and Int overflow are detected explicitly and surface as a runtime error whose
# accept/reject matches the Go oracle. `print` (-> stdout) is the first builtin.
#
# The `match` over `Expr` is EXHAUSTIVE, so every parser-emitted variant has an
# arm. Variants whose evaluation belongs to a LATER slice (statements/if -> E2;
# calls/match/collections/field/index/type-name -> E3) return a clean runtime
# error here and are replaced in those slices. This is staged behaviour, not a
# stub: each arm has fully defined semantics for E1.
#
# DESIGN NOTES (verified facts about the shipped v0 surface):
#  * guji sigils are shape-invariant ($ scalar / @ list / % map). To keep every
#    runtime structure a `$`-scalar (and dodge the no-list-builder limitation),
#    Value sequences and the environment are recursive cons-list `enum`s, exactly
#    like the lexer's TokenList. Built-in List[Str] is used only for transient
#    char work inside helpers (split/take/drop/join).
#  * There is no public `parse_float` and no Int->Float conversion in guji v0.
#    The evaluator nevertheless needs the IEEE-754 value of an EFloat's source
#    text. `eval_float_literal` below builds it using Float digit constants and
#    Float arithmetic, so `Value` carries a real Float without extending the
#    language prelude. This is also bootstrap-safe: the previous compiler already
#    supports the scalar Float operations used by that helper.
#  * The Expr AST carries no source positions, so evaluator errors are unpositioned;
#    the differential only needs accept/reject + stdout agreement, so this is fine.
# ---------------------------------------------------------------------------

# Runtime values. Int/Float/Bool carry native scalars; List/Map/Variant are
# cons-list-backed compound carriers
# (constructed in E3, defined here so the Value `match` domain is complete).
pub enum ValueList {
    ValNil
    ValCons($head: Value, $tail: ValueList)
}

pub class ValMapEntry {
    has $.key: Str
    has $.value: Value
}

pub enum ValMapList {
    ValMapNil
    ValMapCons($head: ValMapEntry, $tail: ValMapList)
}

# I10c2b: host wire payloads for collection/enum channels. Guest List/Map/enum
# Values cannot ride a typed host Chan[List|Map|UserEnum] directly (arbitrary
# guest enums are not host types), so D stores recursive wire enums that preserve
# Int/Str leaves and variant tag/eid without flattening nested Value structure.
enum WireIntList {
    WILNil
    WILCons($n: Int, $t: WireIntList)
}

enum WireStrMap {
    WSMNil
    WSMCons($k: Str, $v: Str, $t: WireStrMap)
}

enum WireEnum {
    WENullary($tag: Str, $eid: Str)
    WEInt($tag: Str, $eid: Str, $n: Int)
    WEStr($tag: Str, $eid: Str, $s: Str)
    WEBool($tag: Str, $eid: Str, $b: Bool)
    WEFloat($tag: Str, $eid: Str, $f: Float)
    # I10g2b uses recursive SELF boxes so the wire stays inside C's established
    # user-enum channel ABI; nested by-value enum fields are not admitted.
    WEWireInt($n: Int)
    WEWireStr($s: Str)
    WEWireBool($b: Bool)
    WEWireFloat($f: Float)
    WEWireUnit
    WEWireListNil
    WEWireListCons($h: WireEnum, $t: WireEnum)
    WEWireMapNil
    WEWireMapCons($k: Str, $v: WireEnum, $t: WireEnum)
    WEList($tag: Str, $eid: Str, $xs: WireEnum)
    WEMap($tag: Str, $eid: Str, $es: WireEnum)
    # I10g3b: multi-field variants and recursive SELF-boxed enum fields ride a
    # field spine of WireEnum nodes (scalars/collections/nested guest variants).
    WEFields($tag: Str, $eid: Str, $xs: WireEnum)
    # I10g4: Option/Result text carriers. Regex is pattern text (distinct from
    # WEStr so recv reconstitutes VRegex). Match stores source-order names plus
    # Some(Str)/None group carriers. Bush stores recursive child nodes as
    # WEBushVal spines (bare trees, not guest variants).
    WERegex($tag: Str, $eid: Str, $p: Str, $private: Bool)
    WEMatch($tag: Str, $eid: Str, $text: Str, $names: WireEnum, $groups: WireEnum)
    WEBush($tag: Str, $eid: Str, $name: Str, $text: Str, $caps: WireEnum)
    WEBushVal($name: Str, $text: Str, $caps: WireEnum)
    # I10g5b: guest VFunction(key,caps) over Chan[Func]. Env is a recursive
    # frame/bind spine; class captures ride WEInstance map fields. Non-wireable
    # Env slots (channels, handles, mut) are omitted at encode time so D's fat
    # lexical snapshot still detaches the free vars C would have captured.
    WEFunction($key: Str, $caps: WireEnum)
    WEEnvNil
    WEEnvFrame($binds: WireEnum, $parent: WireEnum)
    WEBindNil
    WEBindCons($name: Str, $mutable: Bool, $value: WireEnum, $tail: WireEnum)
    WEInstance($cls: Str, $fields: WireEnum)
}

pub enum Value {
    VInt($i: Int)
    VFloat($value: Float)
    VStr($s: Str)
    VBool($b: Bool)
    VUnit
    VList($items: ValueList)
    VMap($entries: ValMapList)
    # §5.4 Int range value. `$open` distinguishes inclusive `..` from
    # half-open `..<`; empty/reversed ranges retain their written bounds and
    # become empty only when iterated (I9b).
    VRange($from: Int, $to: Int, $open: Bool)
    # $eid is "" for built-in Some/None/Ok/Err; otherwise a stable
    # module key (alias::Name / alias#local#Name / bare Name) for user enums.
    VVariant($tag: Str, $fields: ValueList, $eid: Str)
    # §8.2 class instance: class name + bare-field-name -> value entries in
    # field-declaration order (mirrors the oracle's InstanceVal; display sorts).
    VInstance($cls: Str, $fields: ValMapList)
    # §7.4 parameterized lambda. The canonical AST key resolves back to the
    # already-owned lambda node in SubTable when called. `$caps` is the lexical
    # Env at creation time (immutable bindings only are readable: typecheck
    # rejects mut capture). Capture-by-value and capture-by-reference are
    # observationally identical for immutables; the Env snapshot is shared.
    # Do not embed compiler AST nodes here — that pulls opaque helpers into C.
    VFunction($key: Str, $caps: Env)
    # §13 first-class Regex value: validated pattern text. A spliced literal is
    # flattened when it is evaluated: Str parts are escaped and Regex parts have
    # their captures demoted inside one non-capturing atom (I7d). C stores the
    # same resulting pattern bytes as a counted Str with a private-provenance
    # header bit. Raw literals/Regex.compile carry false; splice materialization
    # carries true so only compiler-generated reserved captures use internal mode.
    VRegex($pattern: Str, $private: Bool)
    # §13.3 Match value from a successful `~~`. Capture names are stored in
    # positional order ("" for an unnamed group); `$groups` stores the matching
    # Some(Str)/None value for each group. Keeping participation separately from
    # text distinguishes an optional group that did not run from one that matched
    # the empty string.
    VMatch($text: Str, $names: StrList, $groups: ValueList)
    # §14.2 Bush parse-tree node. `$caps` contains the directly referenced child
    # productions in source order; each child carries its own production name,
    # text, and descendants. I7e exposes TOP parsing and `.text`; I7f exposes
    # named lookup over this stored tree.
    VBush($name: Str, $text: Str, $caps: ValueList)
    # §15.4 standard Handle value. `$stream` is "stdin" / "stdout" / "stderr".
    # Standard streams stay tagged so I8c capability checks do not depend on
    # host Handle identity; file-backed open/create use VFileHandle (I8d1
    # admitted Handle enum fields).
    VHandle($stream: Str)
    # §15.4 file-backed Handle from open/create. Host Handle is a counted
    # guji_reader_t*; final release closes non-standard files (no close builtin).
    VFileHandle($h: Handle)
    # §17.2 / §15.4 channel handles. Scalar builders use typed variants; Str also
    # carries Handle.lines() results (I8c2b). List/Map/enum builders use wire
    # payloads (I10c2b). Identity equality compares host handles; display is
    # always opaque `<chan>`.
    VChanUnit($ch: Chan[Unit])
    VChanInt($ch: Chan[Int])
    VChanBool($ch: Chan[Bool])
    VChanFloat($ch: Chan[Float])
    VChanStr($ch: Chan[Str])
    VChanListInt($ch: Chan[WireIntList])
    VChanMapStr($ch: Chan[WireStrMap])
    VChanEnum($ch: Chan[WireEnum])
}

# The environment is a chain of frames; each frame is a cons-list of bindings in
# first-assignment order (so the E4 env dump can render declaration order). Each
# binding records its mutability for the E2 reassign-immutable check.
pub enum Bindings {
    BindNil
    BindCons($name: Str, $mutable: Bool, $value: Value, $tail: Bindings)
}

pub enum Env {
    EnvNil
    EnvFrame($binds: Bindings, $parent: Env)
}

# The sub-table: a name -> SubDecl map for resolving user calls (E3). Built from a
# parsed Program's DeclList.
pub enum SubTable {
    SubTNil
    SubTCons($name: Str, $sub: SubDecl, $tail: SubTable)
    # §8 classes ride the same table (name -> ClassDecl) so construction, field
    # access, and method dispatch resolve without threading a second table.
    SubTClass($name: Str, $cls: ClassDecl, $tail: SubTable)
    # §9 enums ride the same table (name -> EnumDecl) so associated functions,
    # instance methods on VVariant receivers, and nullary-variant receivers
    # (`Red.label()`) resolve without a second table.
    SubTEnum($name: Str, $en: EnumDecl, $tail: SubTable)
    # §14 grammar declarations share the runtime dispatch table. Their opaque
    # production bodies are parsed into the existing PegExpr representation when
    # `Grammar.parse` is invoked.
    SubTGrammar($name: Str, $grammar: GrammarDecl, $tail: SubTable)
}

sub eval_err($msg: Str): Str {
    "panic: " ~ $msg
}

# Int64 bounds. INT_MIN is written as -(MAX) - 1 because the literal
# 9223372036854775808 would itself overflow at parse time.
sub int_max(): Int { 9223372036854775807 }
sub int_min(): Int { 0 - 9223372036854775807 - 1 }

# ---- environment lookup and update ----

sub bind_lookup($binds: Bindings, $name: Str): Option[Value] {
    match $binds {
        BindNil { None }
        BindCons($n, $m, $v, $tail) {
            if $n == $name { Some($v) } else { bind_lookup($tail, $name) }
        }
    }
}

sub bind_has($binds: Bindings, $name: Str): Bool {
    match $binds {
        BindNil { false }
        BindCons($n, $m, $v, $tail) {
            if $n == $name { true } else { bind_has($tail, $name) }
        }
    }
}

sub bind_is_mutable($binds: Bindings, $name: Str): Bool {
    match $binds {
        BindNil { false }
        BindCons($n, $m, $v, $tail) {
            if $n == $name { $m } else { bind_is_mutable($tail, $name) }
        }
    }
}

sub bind_update($binds: Bindings, $name: Str, $value: Value, $mutable: Bool): Bindings {
    match $binds {
        BindNil { BindNil }
        BindCons($n, $m, $v, $tail) {
            if $n == $name {
                BindCons($n, $mutable, $value, $tail)
            } else {
                BindCons($n, $m, $v, bind_update($tail, $name, $value, $mutable))
            }
        }
    }
}

sub bind_append($binds: Bindings, $name: Str, $mutable: Bool, $value: Value): Bindings {
    match $binds {
        BindNil { BindCons($name, $mutable, $value, BindNil) }
        BindCons($n, $m, $v, $tail) { BindCons($n, $m, $v, bind_append($tail, $name, $mutable, $value)) }
    }
}

sub env_lookup($env: Env, $name: Str): Option[Value] {
    match $env {
        EnvNil { None }
        EnvFrame($binds, $parent) {
            match bind_lookup($binds, $name) {
                Some($v) { Some($v) }
                None { env_lookup($parent, $name) }
            }
        }
    }
}

sub env_define_mut($env: Env, $name: Str, $value: Value): Env {
    match $env {
        EnvNil { EnvFrame(BindCons($name, true, $value, BindNil), EnvNil) }
        EnvFrame($binds, $parent) {
            if bind_has($binds, $name) {
                EnvFrame(bind_update($binds, $name, $value, true), $parent)
            } else {
                EnvFrame(bind_append($binds, $name, true, $value), $parent)
            }
        }
    }
}

sub env_update_mutable($env: Env, $name: Str, $value: Value): Option[Env] {
    match $env {
        EnvNil { None }
        EnvFrame($binds, $parent) {
            if bind_has($binds, $name) {
                if bind_is_mutable($binds, $name) {
                    Some(EnvFrame(bind_update($binds, $name, $value, true), $parent))
                } else {
                    None
                }
            } else {
                match env_update_mutable($parent, $name, $value) {
                    Some($new_parent) { Some(EnvFrame($binds, $new_parent)) }
                    None { None }
                }
            }
        }
    }
}

sub env_set($env: Env, $name: Str, $value: Value): Result[Env, Str] {
    match $env {
        EnvNil { Ok(EnvFrame(BindCons($name, false, $value, BindNil), EnvNil)) }
        EnvFrame($binds, $parent) {
            if bind_has($binds, $name) {
                if bind_is_mutable($binds, $name) {
                    Ok(EnvFrame(bind_update($binds, $name, $value, true), $parent))
                } else {
                    Err(eval_err("runtime error: cannot reassign immutable binding"))
                }
            } else {
                match env_update_mutable($parent, $name, $value) {
                    Some($new_parent) { Ok(EnvFrame($binds, $new_parent)) }
                    None { Ok(EnvFrame(bind_append($binds, $name, false, $value), $parent)) }
                }
            }
        }
    }
}

# ---- sub-table (built once by the driver; used by E3 calls) ----

sub subtable_lookup($t: SubTable, $name: Str): Option[SubDecl] {
    match $t {
        SubTNil { None }
        SubTClass($n, $c, $tail) { subtable_lookup($tail, $name) }
        SubTEnum($n, $e, $tail) { subtable_lookup($tail, $name) }
        SubTGrammar($n, $g, $tail) { subtable_lookup($tail, $name) }
        SubTCons($n, $s, $tail) {
            if $n == $name { Some($s) } else { subtable_lookup($tail, $name) }
        }
    }
}

sub classtable_lookup($t: SubTable, $name: Str): Option[ClassDecl] {
    match $t {
        SubTNil { None }
        SubTCons($n, $s, $tail) { classtable_lookup($tail, $name) }
        SubTEnum($n, $e, $tail) { classtable_lookup($tail, $name) }
        SubTGrammar($n, $g, $tail) { classtable_lookup($tail, $name) }
        SubTClass($n, $c, $tail) {
            if $n == $name { Some($c) } else { classtable_lookup($tail, $name) }
        }
    }
}

sub enumtable_lookup($t: SubTable, $name: Str): Option[EnumDecl] {
    match $t {
        SubTNil { None }
        SubTCons($n, $s, $tail) { enumtable_lookup($tail, $name) }
        SubTClass($n, $c, $tail) { enumtable_lookup($tail, $name) }
        SubTGrammar($n, $g, $tail) { enumtable_lookup($tail, $name) }
        SubTEnum($n, $e, $tail) {
            if $n == $name { Some($e) } else { enumtable_lookup($tail, $name) }
        }
    }
}

sub grammartable_lookup($t: SubTable, $name: Str): Option[GrammarDecl] {
    match $t {
        SubTNil { None }
        SubTCons($n, $s, $tail) { grammartable_lookup($tail, $name) }
        SubTClass($n, $c, $tail) { grammartable_lookup($tail, $name) }
        SubTEnum($n, $e, $tail) { grammartable_lookup($tail, $name) }
        SubTGrammar($n, $g, $tail) {
            if $n == $name { Some($g) } else { grammartable_lookup($tail, $name) }
        }
    }
}

sub enum_has_variant($vs: VariantList, $tag: Str): Bool {
    match $vs {
        VariantNil { false }
        VariantCons($v, $rest) {
            if $v.name == $tag { true } else { enum_has_variant($rest, $tag) }
        }
    }
}

# Payload ParamList for a variant tag (declaration order). Used so a direct
# `channel(cap)` argument can inherit that payload's Chan[T] annotation (§17.2).
sub variant_fields_of($vs: VariantList, $tag: Str): Option[ParamList] {
    match $vs {
        VariantNil { None }
        VariantCons($v, $rest) {
            if $v.name == $tag { Some($v.fields) } else { variant_fields_of($rest, $tag) }
        }
    }
}

# Resolve the enum declaration that owns a variant tag. Built-in carriers
# (Some/None/Ok/Err) are not stored here, so their tags yield None and fall
# through to UFCS / other paths.
sub enum_for_variant($t: SubTable, $tag: Str): Option[EnumDecl] {
    match $t {
        SubTNil { None }
        SubTCons($n, $s, $tail) { enum_for_variant($tail, $tag) }
        SubTClass($n, $c, $tail) { enum_for_variant($tail, $tag) }
        SubTGrammar($n, $g, $tail) { enum_for_variant($tail, $tag) }
        SubTEnum($n, $e, $tail) {
            if enum_has_variant($e.variants, $tag) {
                Some($e)
            } else {
                enum_for_variant($tail, $tag)
            }
        }
    }
}

sub build_sub_table($decls: DeclList): SubTable {
    match $decls {
        DeclNil { SubTNil }
        DeclCons($d, $rest) {
            match $d {
                DImport($i) { build_sub_table($rest) }
                DSub($s) { SubTCons($s.name, $s, build_sub_table($rest)) }
                DClass($c) { SubTClass($c.name, $c, build_sub_table($rest)) }
                DEnum($e) { SubTEnum($e.name, $e, build_sub_table($rest)) }
                DGrammar($g) { SubTGrammar($g.name, $g, build_sub_table($rest)) }
            }
        }
    }
}

# §16.1 evaluator module table. Imported declarations keep their ordinary bare
# names so code inside the imported module resolves its own helpers, and public
# top-level declarations additionally receive the source-visible `alias::name`
# key used by the importing module. The path-aware entry below loads only the
# direct import set; graph traversal and cycle/repeat diagnostics belong to I8b.
sub subtable_append($left: SubTable, $right: SubTable): SubTable {
    match $left {
        SubTNil { $right }
        SubTCons($n, $s, $tail) { SubTCons($n, $s, subtable_append($tail, $right)) }
        SubTClass($n, $c, $tail) { SubTClass($n, $c, subtable_append($tail, $right)) }
        SubTEnum($n, $e, $tail) { SubTEnum($n, $e, subtable_append($tail, $right)) }
        SubTGrammar($n, $g, $tail) { SubTGrammar($n, $g, subtable_append($tail, $right)) }
    }
}

sub import_local_name($alias: Str, $name: Str): Str {
    $alias ~ "#local#" ~ $name
}

# Display/print spelling for a class identity key. Imported instances store
# `alias::Name` or `alias#local#Name`; user-visible rendering stays the bare
# PascalCase type name (matching C after alias_Type mangling).
sub nominal_display_name($id: Str): Str {
    @parts: List[Str] = split($id, "::")
    if @parts.count() >= 2 {
        @parts[@parts.count() - 1]
    } else {
        @local: List[Str] = split($id, "#local#")
        if @local.count() == 2 {
            @local[1]
        } else {
            $id
        }
    }
}

# Fingerprint a sub list via canon_body so same-named decls from different
# modules can be disambiguated without emitting ClassDecl/EnumDecl `==`.
sub subdecl_list_fingerprint($ss: SubDeclList): Str {
    match $ss {
        SubDeclNil { "" }
        SubDeclCons($h, $t) { $h.name ~ "=" ~ canon_body($h.body) ~ ";" ~ subdecl_list_fingerprint($t) }
    }
}

sub find_class_key_by_fp($t: SubTable, $name: Str, $fp: Str, $want_local: Bool): Option[Str] {
    match $t {
        SubTNil { None }
        SubTCons($n, $s, $tail) { find_class_key_by_fp($tail, $name, $fp, $want_local) }
        SubTEnum($n, $e, $tail) { find_class_key_by_fp($tail, $name, $fp, $want_local) }
        SubTGrammar($n, $g, $tail) { find_class_key_by_fp($tail, $name, $fp, $want_local) }
        SubTClass($n, $cls, $tail) {
            $shape = if $want_local {
                str_contains($n, "#local#")
            } else {
                str_contains($n, "::")
            }
            if $shape && $cls.name == $name && subdecl_list_fingerprint($cls.subs) == $fp {
                Some($n)
            } else {
                find_class_key_by_fp($tail, $name, $fp, $want_local)
            }
        }
    }
}

sub class_instance_id($lookup: Str, $c: ClassDecl, $subs: SubTable): Str {
    if str_contains($lookup, "::") || str_contains($lookup, "#local#") {
        $lookup
    } else {
        $fp = subdecl_list_fingerprint($c.subs)
        match find_class_key_by_fp($subs, $c.name, $fp, false) {
            Some($k) { $k }
            None {
                match find_class_key_by_fp($subs, $c.name, $fp, true) {
                    Some($k) { $k }
                    None { $lookup }
                }
            }
        }
    }
}

sub find_enum_key_by_fp($t: SubTable, $name: Str, $fp: Str, $want_local: Bool): Option[Str] {
    match $t {
        SubTNil { None }
        SubTCons($n, $s, $tail) { find_enum_key_by_fp($tail, $name, $fp, $want_local) }
        SubTClass($n, $c, $tail) { find_enum_key_by_fp($tail, $name, $fp, $want_local) }
        SubTGrammar($n, $g, $tail) { find_enum_key_by_fp($tail, $name, $fp, $want_local) }
        SubTEnum($n, $en, $tail) {
            $shape = if $want_local {
                str_contains($n, "#local#")
            } else {
                str_contains($n, "::")
            }
            if $shape && $en.name == $name && subdecl_list_fingerprint($en.subs) == $fp {
                Some($n)
            } else {
                find_enum_key_by_fp($tail, $name, $fp, $want_local)
            }
        }
    }
}

sub enum_instance_id($e: EnumDecl, $subs: SubTable): Str {
    $fp = subdecl_list_fingerprint($e.subs)
    match find_enum_key_by_fp($subs, $e.name, $fp, false) {
        Some($k) { $k }
        None {
            match find_enum_key_by_fp($subs, $e.name, $fp, true) {
                Some($k) { $k }
                None { $e.name }
            }
        }
    }
}

sub str_contains($s: Str, $needle: Str): Bool {
    @parts: List[Str] = split($s, $needle)
    @parts.count() > 1
}

sub build_public_eval_symbols($alias: Str, $decls: DeclList, $tail: SubTable): SubTable {
    match $decls {
        DeclNil { $tail }
        DeclCons($d, $rest) {
            match $d {
                DImport($i) { build_public_eval_symbols($alias, $rest, $tail) }
                DSub($s) {
                    $local = SubTCons(import_local_name($alias, $s.name), $s, build_public_eval_symbols($alias, $rest, $tail))
                    if $s.public {
                        SubTCons(import_qualified_name($alias, $s.name), $s, $local)
                    } else {
                        $local
                    }
                }
                DClass($c) {
                    $local = SubTClass(import_local_name($alias, $c.name), $c, build_public_eval_symbols($alias, $rest, $tail))
                    if $c.public {
                        SubTClass(import_qualified_name($alias, $c.name), $c, $local)
                    } else {
                        $local
                    }
                }
                DEnum($e) {
                    $local = SubTEnum(import_local_name($alias, $e.name), $e, build_public_eval_symbols($alias, $rest, $tail))
                    if $e.public {
                        SubTEnum(import_qualified_name($alias, $e.name), $e, $local)
                    } else {
                        $local
                    }
                }
                DGrammar($g) {
                    $local = SubTGrammar(import_local_name($alias, $g.name), $g, build_public_eval_symbols($alias, $rest, $tail))
                    if $g.public {
                        SubTGrammar(import_qualified_name($alias, $g.name), $g, $local)
                    } else {
                        $local
                    }
                }
            }
        }
    }
}

# Rebuild one imported module's private runtime scope from its reserved local
# keys. A qualified entry call evaluates with this table before the caller's
# table, so a caller declaration with the same name cannot hijack the imported
# body's unqualified helper calls.
sub module_scope_table($alias: Str, $table: SubTable): SubTable {
    $prefix = import_local_name($alias, "")
    match $table {
        SubTNil { SubTNil }
        SubTCons($n, $s, $tail) {
            $rest = module_scope_table($alias, $tail)
            if starts_with($n, $prefix) { SubTCons($s.name, $s, $rest) } else { $rest }
        }
        SubTClass($n, $c, $tail) {
            $rest = module_scope_table($alias, $tail)
            if starts_with($n, $prefix) { SubTClass($c.name, $c, $rest) } else { $rest }
        }
        SubTEnum($n, $e, $tail) {
            $rest = module_scope_table($alias, $tail)
            if starts_with($n, $prefix) { SubTEnum($e.name, $e, $rest) } else { $rest }
        }
        SubTGrammar($n, $g, $tail) {
            $rest = module_scope_table($alias, $tail)
            if starts_with($n, $prefix) { SubTGrammar($g.name, $g, $rest) } else { $rest }
        }
    }
}

sub imported_eval_scope($alias: Str, $table: SubTable): SubTable {
    subtable_append(module_scope_table($alias, $table), $table)
}

# Oldest-first append for the import loading stack (cycle paths mirror Go).
sub strlist_snoc($xs: StrList, $s: Str): StrList {
    match $xs {
        StrNil { StrCons($s, StrNil) }
        StrCons($h, $t) { StrCons($h, strlist_snoc($t, $s)) }
    }
}

sub strlist_join_arrow($xs: StrList): Str {
    match $xs {
        StrNil { "" }
        StrCons($h, StrNil) { $h }
        StrCons($h, $t) { $h ~ " -> " ~ strlist_join_arrow($t) }
    }
}

# stack[i:] where stack[i] == $path; empty if absent.
sub import_cycle_suffix($stack: StrList, $path: Str): StrList {
    match $stack {
        StrNil { StrNil }
        StrCons($h, $t) {
            if $h == $path { $stack } else { import_cycle_suffix($t, $path) }
        }
    }
}

sub import_cycle_message($stack: StrList, $path: Str): Str {
    $suffix = import_cycle_suffix($stack, $path)
    "import cycle detected: " ~ strlist_join_arrow(peg_strlist_concat($suffix, StrCons($path, StrNil)))
}

# Load one import, then its own import closure, so bodies such as `b::base()`
# inside module `a` resolve. Nested public symbols stay in the flat evaluator
# table for that closure; they are not added to the parent's pub surface.
# $stack is the oldest-first path chain of modules currently being loaded.
sub load_eval_import($source_path: Str, $imp: ImportDecl, $tail: SubTable, $stack: StrList): Result[SubTable, Str] {
    $path = import_source_path($source_path, $imp)
    if strlist_contains($stack, $path) {
        Err(import_cycle_message($stack, $path))
    } else {
        $alias = strlist_last($imp.path)
        match read_file($path) {
            Err($e) { Err($e) }
            Ok($src) {
                match parse($src) {
                    Err($e) { Err($e) }
                    Ok($prog) {
                        $stack2 = strlist_snoc($stack, $path)
                        match build_eval_imports($path, $prog.decls, $stack2) {
                            Err($e) { Err($e) }
                            Ok($nested) {
                                # Reserved local + qualified keys provide
                                # collision-safe identity. Bare names are only
                                # rebuilt in imported_eval_scope for body
                                # execution — putting them in the flat caller
                                # table made same-named imports collide on
                                # method dispatch (I8b3).
                                $with_nested = subtable_append($nested, $tail)
                                Ok(build_public_eval_symbols($alias, $prog.decls, $with_nested))
                            }
                        }
                    }
                }
            }
        }
    }
}

sub build_eval_imports($source_path: Str, $decls: DeclList, $stack: StrList): Result[SubTable, Str] {
    match $decls {
        DeclNil { Ok(SubTNil) }
        DeclCons($d, $rest) {
            match build_eval_imports($source_path, $rest, $stack) {
                Err($e) { Err($e) }
                Ok($tail) {
                    match $d {
                        DImport($imp) { load_eval_import($source_path, $imp, $tail, $stack) }
                        _ { Ok($tail) }
                    }
                }
            }
        }
    }
}

# ---- integer-literal parsing (decimal/hex/binary, underscores stripped) ----

sub starts_with($s: Str, $p: Str): Bool {
    @sc = split($s, "")
    @pc = split($p, "")
    if @pc.count() > @sc.count() {
        false
    } else {
        take(@sc, @pc.count()).join("") == $p
    }
}

sub hex_digit_val($c: Str): Int {
    $lc = lower($c)
    if $lc == "a" {
        10
    } else if $lc == "b" {
        11
    } else if $lc == "c" {
        12
    } else if $lc == "d" {
        13
    } else if $lc == "e" {
        14
    } else if $lc == "f" {
        15
    } else {
        match parse_int($c) {
            Ok($n) { $n }
            Err($e) { 0 }
        }
    }
}

sub radix_fold(@cs: List[Str], $base: Int, $i: Int, $acc: Int): Int {
    if $i >= @cs.count() {
        $acc
    } else {
        radix_fold(@cs, $base, $i + 1, $acc * $base + hex_digit_val(@cs[$i]))
    }
}

sub parse_radix($digits: Str, $base: Int): Int {
    radix_fold(split($digits, ""), $base, 0, 0)
}

sub drop_two($s: Str): Str {
    drop(split($s, ""), 2).join("")
}

sub parse_int_lit($text: Str): Result[Int, Str] {
    $clean = split($text, "_").join("")
    if starts_with($clean, "0x") || starts_with($clean, "0X") {
        Ok(parse_radix(drop_two($clean), 16))
    } else if starts_with($clean, "0b") || starts_with($clean, "0B") {
        Ok(parse_radix(drop_two($clean), 2))
    } else {
        match parse_int($clean) {
            Ok($n) { Ok($n) }
            Err($e) { Err(eval_err("invalid integer literal: " ~ $text)) }
        }
    }
}

# Build a Float literal's IEEE-754 value without a public Str->Float conversion.
# The lexer has already validated the spelling. Digit selection uses Float
# constants directly (rather than an unavailable Int->Float cast), then the
# decimal exponent is applied with Float arithmetic. This makes equivalent
# spellings (`1e3` / `1000.0`, `-0.0` / `0.0`) compare numerically and lets the
# ordinary Float interpolation path provide the canonical shortest display.
sub eval_float_digit($c: Str): Float {
    if $c == "0" { 0.0 }
    else if $c == "1" { 1.0 }
    else if $c == "2" { 2.0 }
    else if $c == "3" { 3.0 }
    else if $c == "4" { 4.0 }
    else if $c == "5" { 5.0 }
    else if $c == "6" { 6.0 }
    else if $c == "7" { 7.0 }
    else if $c == "8" { 8.0 }
    else { 9.0 }
}

sub eval_float_exponent($text: Str): Int {
    $clean = if starts_with($text, "+") {
        drop(split($text, ""), 1).join("")
    } else {
        $text
    }
    match parse_int($clean) {
        Ok($n) { $n }
        Err($e) { 0 }
    }
}

sub eval_float_scale($value: Float, $exponent: Int): Float {
    mut $v = $value
    mut $i = 0
    if $exponent >= 0 {
        while $i < $exponent {
            $v = $v * 10.0
            $i = $i + 1
        }
    } else {
        while $i > $exponent {
            $v = $v / 10.0
            $i = $i - 1
        }
    }
    $v
}

sub eval_float_literal($text: Str): Float {
    $clean = split($text, "_").join("")
    $negative = starts_with($clean, "-")
    $unsigned = if $negative { drop(split($clean, ""), 1).join("") } else { $clean }

    @lower_exp = split($unsigned, "e")
    @upper_exp = split($unsigned, "E")
    mut $mantissa = $unsigned
    mut $exponent = 0
    if @lower_exp.count() == 2 {
        $mantissa = @lower_exp[0]
        $exponent = eval_float_exponent(@lower_exp[1])
    } else if @upper_exp.count() == 2 {
        $mantissa = @upper_exp[0]
        $exponent = eval_float_exponent(@upper_exp[1])
    }

    @parts = split($mantissa, ".")
    mut $digits = $mantissa
    mut $fractional = 0
    if @parts.count() == 2 {
        $digits = @parts[0] ~ @parts[1]
        $fractional = split(@parts[1], "").count()
    }

    mut $value = 0.0
    for $digit in split($digits, "") {
        $value = $value * 10.0 + eval_float_digit($digit)
    }
    $scaled = eval_float_scale($value, $exponent - $fractional)
    if $negative { 0.0 - $scaled } else { $scaled }
}

# ---- overflow-safe integer arithmetic (mirrors the Go oracle, Section 5.1) ----

sub add_overflows($a: Int, $b: Int): Bool {
    if $b > 0 {
        $a > int_max() - $b
    } else if $b < 0 {
        $a < int_min() - $b
    } else {
        false
    }
}

sub sub_overflows($a: Int, $b: Int): Bool {
    if $b < 0 {
        $a > int_max() + $b
    } else if $b > 0 {
        $a < int_min() + $b
    } else {
        false
    }
}

sub mul_overflows($a: Int, $b: Int): Bool {
    if $a == 0 || $b == 0 {
        false
    } else if $a > 0 {
        if $b > 0 {
            $a > int_max() / $b
        } else {
            $b < int_min() / $a
        }
    } else {
        if $b > 0 {
            $a < int_min() / $b
        } else {
            $b < int_max() / $a
        }
    }
}

# a ** b by repeated multiplication, checking overflow at every step. The final
# overflow verdict matches the oracle's exponentiation-by-squaring (a power
# overflows iff some partial product does). Negative exponent -> error (cannot
# produce an Int), matching the oracle.
sub int_pow_loop($base: Int, $exp: Int, $acc: Int): Result[Value, Str] {
    if $exp == 0 {
        Ok(VInt($acc))
    } else if mul_overflows($acc, $base) {
        Err(eval_err("integer overflow"))
    } else {
        int_pow_loop($base, $exp - 1, $acc * $base)
    }
}

sub int_pow($a: Int, $b: Int): Result[Value, Str] {
    if $b < 0 {
        Err(eval_err("negative exponent for integer power"))
    } else {
        int_pow_loop($a, $b, 1)
    }
}

sub int_arith($op: Str, $a: Int, $b: Int): Result[Value, Str] {
    if $op == "+" {
        if add_overflows($a, $b) { Err(eval_err("integer overflow")) } else { Ok(VInt($a + $b)) }
    } else if $op == "-" {
        if sub_overflows($a, $b) { Err(eval_err("integer overflow")) } else { Ok(VInt($a - $b)) }
    } else if $op == "*" {
        if mul_overflows($a, $b) { Err(eval_err("integer overflow")) } else { Ok(VInt($a * $b)) }
    } else if $op == "/" {
        if $b == 0 {
            Err(eval_err("integer division by zero"))
        } else if $a == int_min() && $b == -1 {
            Err(eval_err("integer overflow"))
        } else {
            Ok(VInt($a / $b))
        }
    } else if $op == "%" {
        if $b == 0 {
            Err(eval_err("integer modulo by zero"))
        } else if $a == int_min() && $b == -1 {
            Ok(VInt(0))
        } else {
            Ok(VInt($a % $b))
        }
    } else if $op == "**" {
        int_pow($a, $b)
    } else {
        Err(eval_err("unknown arithmetic operator: " ~ $op))
    }
}

# Float arithmetic follows the host's IEEE-754 operations exactly. Unlike Int,
# division or modulo by zero does not panic: it yields Inf or NaN, and `**`
# delegates to the host Float power operation just as native C delegates to pow.
sub float_arith($op: Str, $a: Float, $b: Float): Result[Value, Str] {
    if $op == "+" {
        Ok(VFloat($a + $b))
    } else if $op == "-" {
        Ok(VFloat($a - $b))
    } else if $op == "*" {
        Ok(VFloat($a * $b))
    } else if $op == "/" {
        Ok(VFloat($a / $b))
    } else if $op == "%" {
        Ok(VFloat($a % $b))
    } else if $op == "**" {
        Ok(VFloat($a ** $b))
    } else {
        Err(eval_err("unknown arithmetic operator: " ~ $op))
    }
}

sub eval_arith($op: Str, $a: Value, $b: Value): Result[Value, Str] {
    match $a {
        VInt($x) {
            match $b {
                VInt($y) { int_arith($op, $x, $y) }
                _ { Err(eval_err("arithmetic operands must match: Int " ~ $op ~ " non-Int")) }
            }
        }
        VFloat($x) {
            match $b {
                VFloat($y) { float_arith($op, $x, $y) }
                _ { Err(eval_err("arithmetic operands must match: Float " ~ $op ~ " non-Float")) }
            }
        }
        _ { Err(eval_err("operator " ~ $op ~ " requires numeric operands")) }
    }
}

# ---- comparison / equality ----

sub cmp_int($x: Int, $y: Int): Int {
    if $x < $y { -1 } else if $x > $y { 1 } else { 0 }
}

sub cmp_str($x: Str, $y: Str): Int {
    if $x < $y { -1 } else if $x > $y { 1 } else { 0 }
}

# Float ordering uses the host's IEEE relational ops (matching C `double`
# compares). Equivalent zeros compare equal; NaN is not constructible in v0
# scalar fixtures, so the three-way collapse matches native for admitted inputs.
sub cmp_float($x: Float, $y: Float): Int {
    if $x < $y { -1 } else if $x > $y { 1 } else { 0 }
}

sub value_cmp($a: Value, $b: Value): Result[Int, Str] {
    match $a {
        VInt($x) {
            match $b {
                VInt($y) { Ok(cmp_int($x, $y)) }
                _ { Err(eval_err("cannot compare Int with a different type")) }
            }
        }
        VFloat($x) {
            match $b {
                VFloat($y) { Ok(cmp_float($x, $y)) }
                _ { Err(eval_err("cannot compare Float with a different type")) }
            }
        }
        VStr($x) {
            match $b {
                VStr($y) { Ok(cmp_str($x, $y)) }
                _ { Err(eval_err("cannot compare Str with a different type")) }
            }
        }
        _ { Err(eval_err("ordering requires Int, Float, or Str operands")) }
    }
}

sub eval_order($op: Str, $a: Value, $b: Value): Result[Value, Str] {
    match $a {
        # A three-way comparison cannot represent IEEE unordered (NaN), so use
        # the native Float predicates directly once arithmetic can produce NaN.
        VFloat($x) {
            match $b {
                VFloat($y) {
                    if $op == "<" {
                        Ok(VBool($x < $y))
                    } else if $op == "<=" {
                        Ok(VBool($x <= $y))
                    } else if $op == ">" {
                        Ok(VBool($x > $y))
                    } else {
                        Ok(VBool($x >= $y))
                    }
                }
                _ { Err(eval_err("cannot compare Float with a different type")) }
            }
        }
        _ {
            match value_cmp($a, $b) {
                Err($e) { Err($e) }
                Ok($c) {
                    if $op == "<" {
                        Ok(VBool($c < 0))
                    } else if $op == "<=" {
                        Ok(VBool($c <= 0))
                    } else if $op == ">" {
                        Ok(VBool($c > 0))
                    } else {
                        Ok(VBool($c >= 0))
                    }
                }
            }
        }
    }
}

sub vlist_eq($xs: ValueList, $ys: ValueList): Bool {
    match $xs {
        ValNil {
            match $ys {
                ValNil { true }
                _ { false }
            }
        }
        ValCons($x, $xt) {
            match $ys {
                ValNil { false }
                ValCons($y, $yt) { value_eq($x, $y) && vlist_eq($xt, $yt) }
            }
        }
    }
}

sub vmap_len($es: ValMapList): Int {
    match $es {
        ValMapNil { 0 }
        ValMapCons($e, $rest) { 1 + vmap_len($rest) }
    }
}

sub vmap_find($es: ValMapList, $k: Str): Option[Value] {
    match $es {
        ValMapNil { None }
        ValMapCons($e, $rest) {
            if $e.key == $k { Some($e.value) } else { vmap_find($rest, $k) }
        }
    }
}

# Order-insensitive map equality: same size and every entry of xs matches ys.
sub vmap_subset($xs: ValMapList, $ys: ValMapList): Bool {
    match $xs {
        ValMapNil { true }
        ValMapCons($e, $rest) {
            match vmap_find($ys, $e.key) {
                Some($v) { value_eq($e.value, $v) && vmap_subset($rest, $ys) }
                None { false }
            }
        }
    }
}

sub vmap_eq($xs: ValMapList, $ys: ValMapList): Bool {
    vmap_len($xs) == vmap_len($ys) && vmap_subset($xs, $ys)
}

sub eval_strlist_eq($xs: StrList, $ys: StrList): Bool {
    match $xs {
        StrNil {
            match $ys { StrNil { true } _ { false } }
        }
        StrCons($x, $xt) {
            match $ys {
                StrNil { false }
                StrCons($y, $yt) { $x == $y && eval_strlist_eq($xt, $yt) }
            }
        }
    }
}

sub value_eq($a: Value, $b: Value): Bool {
    match $a {
        VInt($x) {
            match $b {
                VInt($y) { $x == $y }
                _ { false }
            }
        }
        VFloat($x) {
            match $b {
                VFloat($y) { $x == $y }
                _ { false }
            }
        }
        VStr($x) {
            match $b {
                VStr($y) { $x == $y }
                _ { false }
            }
        }
        VBool($x) {
            match $b {
                VBool($y) { $x == $y }
                _ { false }
            }
        }
        VUnit {
            match $b {
                VUnit { true }
                _ { false }
            }
        }
        VList($xs) {
            match $b {
                VList($ys) { vlist_eq($xs, $ys) }
                _ { false }
            }
        }
        VMap($xs) {
            match $b {
                VMap($ys) { vmap_eq($xs, $ys) }
                _ { false }
            }
        }
        VRange($from, $to, $open) {
            match $b {
                VRange($from2, $to2, $open2) { $from == $from2 && $to == $to2 && $open == $open2 }
                _ { false }
            }
        }
        VVariant($tag, $fs, $eid) {
            match $b {
                VVariant($tag2, $fs2, $eid2) {
                    $tag == $tag2 && $eid == $eid2 && vlist_eq($fs, $fs2)
                }
                _ { false }
            }
        }
        VInstance($c1, $f1) {
            match $b {
                # Same class + per-field equality (key-based, like the oracle's
                # InstanceVal.Equal); same-class instances share the field set.
                VInstance($c2, $f2) { $c1 == $c2 && vmap_eq($f1, $f2) }
                _ { false }
            }
        }
        # §7.4: function values are opaque and always compare unequal, including
        # aliases of the same closure. Capture/code identity is not observable.
        VFunction($key, $caps) { false }
        # §13: Regex values compare by pattern text (C's Str-rep equality).
        VRegex($p, $private) {
            match $b {
                VRegex($q, $private2) { $p == $q }
                _ { false }
            }
        }
        # §13.3: Match equality is structural. In particular, capture names and
        # participation are observable even when the whole/group text agrees.
        VMatch($t, $ns, $gs) {
            match $b {
                VMatch($u, $ns2, $gs2) { $t == $u && eval_strlist_eq($ns, $ns2) && vlist_eq($gs, $gs2) }
                _ { false }
            }
        }
        # Bush identity is structural: production name, matched text, and the
        # ordered child tree must all agree.
        VBush($n, $t, $cs) {
            match $b {
                VBush($n2, $t2, $cs2) { $n == $n2 && $t == $t2 && vlist_eq($cs, $cs2) }
                _ { false }
            }
        }
        # Standard handles compare by stream identity (stdin/stdout/stderr).
        VHandle($s) {
            match $b {
                VHandle($t) { $s == $t }
                _ { false }
            }
        }
        # File handles are opaque (C declines Handle ==); never equal, like
        # functions. Do not compare host pointers.
        VFileHandle($h) { false }
        # §17.2: channel equality is handle identity (aliases equal; distinct
        # channels unequal). Buffered contents and closed state are ignored.
        VChanUnit($ch) {
            match $b {
                VChanUnit($other) { $ch == $other }
                _ { false }
            }
        }
        VChanInt($ch) {
            match $b {
                VChanInt($other) { $ch == $other }
                _ { false }
            }
        }
        VChanBool($ch) {
            match $b {
                VChanBool($other) { $ch == $other }
                _ { false }
            }
        }
        VChanFloat($ch) {
            match $b {
                VChanFloat($other) { $ch == $other }
                _ { false }
            }
        }
        VChanStr($ch) {
            match $b {
                VChanStr($other) { $ch == $other }
                _ { false }
            }
        }
        VChanListInt($ch) {
            match $b {
                VChanListInt($other) { $ch == $other }
                _ { false }
            }
        }
        VChanMapStr($ch) {
            match $b {
                VChanMapStr($other) { $ch == $other }
                _ { false }
            }
        }
        VChanEnum($ch) {
            match $b {
                VChanEnum($other) { $ch == $other }
                _ { false }
            }
        }
    }
}

sub eval_concat($a: Value, $b: Value): Result[Value, Str] {
    match $a {
        VStr($x) {
            match $b {
                VStr($y) { Ok(VStr($x ~ $y)) }
                _ { Err(eval_err("~ requires Str operands")) }
            }
        }
        _ { Err(eval_err("~ requires Str operands")) }
    }
}

# Snapshot host Match captures into evaluator Values. `$names` is the compiler's
# existing source-order capture scan, so its length is the positional group count.
sub eval_match_groups($m: Match, $i: Int, $count: Int): ValueList {
    if $i > $count {
        ValNil
    } else {
        $cap = match $m[$i] {
            Some($s) { VVariant("Some", ValCons(VStr($s), ValNil), "") }
            None { VVariant("None", ValNil, "") }
        }
        ValCons($cap, eval_match_groups($m, $i + 1, $count))
    }
}

enum RegexSpliceNames {
    RegexSpliceNameNil
    RegexSpliceNameCons($source: Str, $hidden: Str, $rest: RegexSpliceNames)
}

enum RegexSpliceModes {
    RegexSpliceModeNil
    RegexSpliceModeCons($verbose: Bool, $rest: RegexSpliceModes)
}

class RegexSpliceFlagInfo {
    has $.next: Int
    has $.scoped: Bool
    has $.verbose: Bool
}

sub regex_splice_name_lookup($names: RegexSpliceNames, $source: Str): Option[Str] {
    match $names {
        RegexSpliceNameNil { None }
        RegexSpliceNameCons($name, $hidden, $rest) {
            if $name == $source { Some($hidden) } else { regex_splice_name_lookup($rest, $source) }
        }
    }
}

sub regex_splice_hidden_name($scope: Int, $index: Str): Str {
    "0H{ $scope }_" ~ $index
}

sub regex_splice_scope($used: Str, $pattern: Str, $scope: Int): Int {
    $prefix = "0H{ $scope }_"
    if str_contains($used, $prefix) || str_contains($pattern, $prefix) {
        regex_splice_scope($used, $pattern, $scope + 1)
    } else {
        $scope
    }
}

sub regex_splice_try_cap_at(@chars: List[Str], $i: Int): Option[NamedCapInfo] {
    match g6_try_named_cap_at(@chars, $i) {
        Some($info) { Some($info) }
        None {
            if at(@chars, $i) == "<" && at(@chars, $i + 1) == "0" && at(@chars, $i + 2) == "H" {
                $id = g6_take_cap_ident(@chars, $i + 2, "0")
                if at(@chars, $id.next) == ">" {
                    Some(NamedCapInfo(name: $id.name, next: $id.next + 1))
                } else {
                    None
                }
            } else {
                None
            }
        }
    }
}

sub regex_splice_try_cap(@chars: List[Str], $i: Int): Option[NamedCapInfo] {
    if at(@chars, $i) == "P" {
        regex_splice_try_cap_at(@chars, $i + 1)
    } else {
        regex_splice_try_cap_at(@chars, $i)
    }
}

sub regex_splice_is_numeric_backref($c: Str): Bool {
    if $c == "1" {
        true
    } else if $c == "2" {
        true
    } else if $c == "3" {
        true
    } else if $c == "4" {
        true
    } else if $c == "5" {
        true
    } else if $c == "6" {
        true
    } else if $c == "7" {
        true
    } else if $c == "8" {
        true
    } else {
        $c == "9"
    }
}

sub regex_splice_is_named_backref(@chars: List[Str], $i: Int): Bool {
    if at(@chars, $i + 1) == "k" {
        at(@chars, $i + 2) == "<"
    } else {
        false
    }
}

sub regex_splice_is_named_group(@chars: List[Str], $i: Int): Bool {
    if at(@chars, $i) != "(" {
        false
    } else if at(@chars, $i + 1) != "?" {
        false
    } else if at(@chars, $i + 2) == "<" {
        if at(@chars, $i + 3) == "=" {
            false
        } else {
            at(@chars, $i + 3) != "!"
        }
    } else if at(@chars, $i + 2) == "P" {
        at(@chars, $i + 3) == "<"
    } else {
        false
    }
}

sub regex_splice_is_verbose_space($c: Str): Bool {
    if $c == " " {
        true
    } else if $c == "\t" {
        true
    } else if $c == "\n" {
        true
    } else if $c == "\r" {
        true
    } else if $c == "\f" {
        true
    } else {
        $c == "\v"
    }
}

sub regex_splice_comment_end(@chars: List[Str], $i: Int): Int {
    mut $pos = $i
    mut $going = true
    while $going {
        $c = at(@chars, $pos)
        if $c == "" {
            $going = false
        } else if $c == "\n" {
            $pos = $pos + 1
            $going = false
        } else {
            $pos = $pos + 1
        }
    }
    $pos
}

sub regex_splice_flag_scan(@chars: List[Str], $i: Int, $verbose: Bool, $neg: Bool): Option[RegexSpliceFlagInfo] {
    $c = at(@chars, $i)
    if $c == "" {
        None
    } else if $verbose {
        if regex_splice_is_verbose_space($c) {
            regex_splice_flag_scan(@chars, $i + 1, $verbose, $neg)
        } else if $c == "#" {
            regex_splice_flag_scan(@chars, regex_splice_comment_end(@chars, $i), $verbose, $neg)
        } else if $c == "x" {
            regex_splice_flag_scan(@chars, $i + 1, !$neg, $neg)
        } else if $c == "a" || $c == "i" || $c == "m" || $c == "s" {
            regex_splice_flag_scan(@chars, $i + 1, $verbose, $neg)
        } else if $c == "-" {
            regex_splice_flag_scan(@chars, $i + 1, $verbose, true)
        } else if $c == ":" {
            Some(RegexSpliceFlagInfo(next: $i + 1, scoped: true, verbose: $verbose))
        } else if $c == ")" {
            Some(RegexSpliceFlagInfo(next: $i + 1, scoped: false, verbose: $verbose))
        } else {
            None
        }
    } else if $c == "x" {
        regex_splice_flag_scan(@chars, $i + 1, !$neg, $neg)
    } else if $c == "a" || $c == "i" || $c == "m" || $c == "s" {
        regex_splice_flag_scan(@chars, $i + 1, $verbose, $neg)
    } else if $c == "-" {
        regex_splice_flag_scan(@chars, $i + 1, $verbose, true)
    } else if $c == ":" {
        Some(RegexSpliceFlagInfo(next: $i + 1, scoped: true, verbose: $verbose))
    } else if $c == ")" {
        Some(RegexSpliceFlagInfo(next: $i + 1, scoped: false, verbose: $verbose))
    } else {
        None
    }
}

sub regex_splice_flag_info(@chars: List[Str], $i: Int, $verbose: Bool): Option[RegexSpliceFlagInfo] {
    if at(@chars, $i) == "(" {
        if at(@chars, $i + 1) == "?" {
            regex_splice_flag_scan(@chars, $i + 2, $verbose, false)
        } else {
            None
        }
    } else {
        None
    }
}

sub regex_splice_chars($chars: List[Str], $from: Int, $to: Int): Str {
    join(take(drop($chars, $from), $to - $from), "")
}

sub regex_splice_starts_comment($verbose: Bool, $c: Str): Bool {
    if $verbose { $c == "#" } else { false }
}

# A Regex-valued splice is one non-capturing host atom and exposes none of its
# captures (§13.4), but its own backreferences remain scoped and operational.
# Reserved names retain those private VM slots while the runtime's public-slot
# map keeps them out of Match. class_phase is 0=start, 1=after leading ^,
# 2=after the first ordinary class member.
sub regex_splice_demote_scan(@chars: List[Str], $i: Int, $in_class: Bool, $class_phase: Int, $out: Str, $captures: Int, $publics: Int, $names: RegexSpliceNames, $scope: Int, $verbose: Bool, $modes: RegexSpliceModes): Result[Str, Str] {
    mut $pos = $i
    mut $inside = $in_class
    mut $phase = $class_phase
    mut $text = $out
    mut $caps = $captures
    mut $pubs = $publics
    mut $known = $names
    mut $loud = $verbose
    mut $mode_stack = $modes
    mut $going = true
    mut $failed = false
    mut $err = ""
    while $going {
        $c = at(@chars, $pos)
        if $c == "" {
            $going = false
        } else if $c == "\\" {
            $e = at(@chars, $pos + 1)
            if $e == "" {
                $text = $text ~ "\\"
                $going = false
            } else if $inside {
                $text = $text ~ "\\" ~ $e
                $pos = $pos + 2
                $phase = 2
            } else if regex_splice_is_numeric_backref($e) {
                match regex_splice_name_lookup($known, "#" ~ $e) {
                    None {
                        $err = "invalid numeric backreference in spliced pattern"
                        $failed = true
                        $going = false
                    }
                    Some($hidden) {
                        $text = $text ~ "\\k<" ~ $hidden ~ ">"
                        $pos = $pos + 2
                    }
                }
            } else if regex_splice_is_named_backref(@chars, $pos) {
                match regex_splice_try_cap_at(@chars, $pos + 2) {
                    None {
                        $text = $text ~ "\\" ~ $e
                        $pos = $pos + 2
                    }
                    Some($info) {
                        match regex_splice_name_lookup($known, $info.name) {
                            None {
                                $err = "invalid named backreference in spliced pattern"
                                $failed = true
                                $going = false
                            }
                            Some($hidden) {
                                $text = $text ~ "\\k<" ~ $hidden ~ ">"
                                $pos = $info.next
                            }
                        }
                    }
                }
            } else {
                $text = $text ~ "\\" ~ $e
                $pos = $pos + 2
            }
        } else if $inside {
            $text = $text ~ $c
            $pos = $pos + 1
            if $c == "]" {
                if $phase == 2 {
                    $inside = false
                } else {
                    $phase = 2
                }
            } else if $phase == 0 {
                if $c == "^" {
                    $phase = 1
                } else {
                    $phase = 2
                }
            } else {
                $phase = 2
            }
        } else if regex_splice_starts_comment($loud, $c) {
            $end = regex_splice_comment_end(@chars, $pos)
            $text = $text ~ regex_splice_chars(@chars, $pos, $end)
            $pos = $end
        } else if $c == "[" {
            $text = $text ~ $c
            $pos = $pos + 1
            $inside = true
            $phase = 0
        } else if $c == "(" {
            if at(@chars, $pos + 1) != "?" {
                $mode_stack = RegexSpliceModeCons($loud, $mode_stack)
                $caps = $caps + 1
                $pubs = $pubs + 1
                $hidden = regex_splice_hidden_name($scope, "{ $caps }")
                $known = RegexSpliceNameCons("#{ $pubs }", $hidden, $known)
                $text = $text ~ "(?<" ~ $hidden ~ ">"
                $pos = $pos + 1
            } else {
                match regex_splice_flag_info(@chars, $pos, $loud) {
                    Some($flags) {
                        $text = $text ~ regex_splice_chars(@chars, $pos, $flags.next)
                        $pos = $flags.next
                        if $flags.scoped {
                            $mode_stack = RegexSpliceModeCons($loud, $mode_stack)
                        }
                        $loud = $flags.verbose
                    }
                    None {
                        $mode_stack = RegexSpliceModeCons($loud, $mode_stack)
                        if regex_splice_is_named_group(@chars, $pos) {
                            match regex_splice_try_cap(@chars, $pos + 2) {
                                Some($info) {
                                    $caps = $caps + 1
                                    $hidden = regex_splice_hidden_name($scope, "{ $caps }")
                                    $known = RegexSpliceNameCons($info.name, $hidden, $known)
                                    if !starts_with($info.name, "0H") {
                                        $pubs = $pubs + 1
                                        $known = RegexSpliceNameCons("#{ $pubs }", $hidden, $known)
                                    }
                                    $text = $text ~ "(?<" ~ $hidden ~ ">"
                                    $pos = $info.next
                                }
                                None {
                                    $text = $text ~ $c
                                    $pos = $pos + 1
                                }
                            }
                        } else {
                            $text = $text ~ $c
                            $pos = $pos + 1
                        }
                    }
                }
            }
        } else if $c == ")" {
            $text = $text ~ $c
            $pos = $pos + 1
            match $mode_stack {
                RegexSpliceModeNil { $loud = false }
                RegexSpliceModeCons($outer, $rest) {
                    $loud = $outer
                    $mode_stack = $rest
                }
            }
        } else {
            $text = $text ~ $c
            $pos = $pos + 1
        }
    }
    if $failed { Err($err) } else { Ok($text) }
}

sub regex_splice_demote($pattern: Str, $used: Str): Result[Str, Str] {
    $scope = regex_splice_scope($used, $pattern, 0)
    regex_splice_demote_scan(split($pattern, ""), 0, false, 0, "", 0, 0, RegexSpliceNameNil, $scope, false, RegexSpliceModeNil)
}

sub regex_splice_runtime_error($line: Int, $col: Int, $msg: Str): Str {
    "{ $line }:{ $col }: runtime error: invalid regex: " ~ $msg
}

# Bootstrap-compatible private bridge. The previous verified compiler emits the
# ordinary wrapper body; a compiler containing this slice recognizes only calls
# to this exact internal name and lowers them to the provenance-aware runtime
# entry point. User-facing Regex.compile always keeps the public parser mode.
sub __guji_regex_compile_internal($pattern: Str): Result[Regex, Str] {
    Regex.compile($pattern)
}

sub regex_compile_value($pattern: Str, $private: Bool): Result[Regex, Str] {
    if $private {
        __guji_regex_compile_internal($pattern)
    } else {
        Regex.compile($pattern)
    }
}

# Evaluate splice expressions left-to-right while threading the evaluator Env.
# Host text remains regex source, Str values become escaped literal source, and
# Regex values become one capture-stripped atom. An early `?`/`return` from a
# splice expression follows the ordinary expression-flow channel.
sub eval_regex_parts($parts: RegexPartList, $line: Int, $col: Int, $subs: SubTable, $env: Env, $out: Str): Result[EvalResult, Str] {
    match $parts {
        RPNil {
            match __guji_regex_compile_internal($out) {
                Ok($re) { Ok(flow(VRegex($out, true), $env)) }
                Err($e) { Err(regex_splice_runtime_error($line, $col, $e)) }
            }
        }
        RPCons($head, $tail) {
            match $head {
                RPText($text) { eval_regex_parts($tail, $line, $col, $subs, $env, $out ~ $text) }
                RPSplice($expr) {
                    match eval_expr_flow($expr, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                match $r.value {
                                    VStr($s) { eval_regex_parts($tail, $line, $col, $subs, $r.env, $out ~ Regex.escape($s)) }
                                    VRegex($p, $private) {
                                        match regex_compile_value($p, $private) {
                                            Err($e) { Err(regex_splice_runtime_error($line, $col, $e)) }
                                            Ok($validated) {
                                                match regex_splice_demote($p, $out) {
                                                    Err($e) { Err(regex_splice_runtime_error($line, $col, $e)) }
                                                    Ok($flat) { eval_regex_parts($tail, $line, $col, $subs, $r.env, $out ~ "(?:" ~ $flat ~ ")") }
                                                }
                                            }
                                        }
                                    }
                                    _ { Err("{ $line }:{ $col }: runtime error: regex splice expression must evaluate to Regex or Str, got " ~ value_type_name($r.value)) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub eval_spliced_regex($pattern: Str, $line: Int, $col: Int, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match g6_regex_parse_parts($pattern) {
        Err($e) { Err($e) }
        Ok($parts) { eval_regex_parts($parts, $line, $col, $subs, $env, "") }
    }
}

# §13.2 `~~`: Str left, Regex right → Option[Match]. Host Regex.compile + ~~
# run in the compiled evaluator (native C engine). User-facing Regex.compile /
# escape / literal and Str replace/replace_with live in the I7c prelude below.
sub eval_match_op($a: Value, $b: Value): Result[Value, Str] {
    match $a {
        VStr($s) {
            match $b {
                VRegex($p, $private) {
                    match regex_compile_value($p, $private) {
                        Ok($re) {
                            match $s ~~ $re {
                                Some($m) {
                                    $names = g6_regex_cap_names($p)
                                    $groups = eval_match_groups($m, 1, g6_strlist_len($names))
                                    Ok(VVariant("Some", ValCons(VMatch($m.text, $names, $groups), ValNil), ""))
                                }
                                None { Ok(VVariant("None", ValNil, "")) }
                            }
                        }
                        Err($e) { Err(eval_err("invalid regex: " ~ $e)) }
                    }
                }
                _ { Err(eval_err("match operator requires Regex right operand, got " ~ value_type_name($b))) }
            }
        }
        _ { Err(eval_err("match operator requires Str left operand, got " ~ value_type_name($a))) }
    }
}

# §13.4 / §15.3 (I7c): snapshot a host Match with the pattern's capture names.
sub host_match_to_vmatch($m: Match, $names: StrList): Value {
    VMatch($m.text, $names, eval_match_groups($m, 1, g6_strlist_len($names)))
}

# Find-result carrier for replace loops (avoids deep Option[ValueList] patterns).
class ReHit {
    has $.start: Int
    has $.end: Int
    has $.m: Value
}

# Leftmost match of an \A-anchored pattern at or after character offset $i.
# Lookbehind that reaches before $i is out of this slice (exact rows avoid it).
sub regex_find_from($suffix: Str, $anchored: Regex, $names: StrList, $i: Int): Option[ReHit] {
    match $suffix ~~ $anchored {
        Some($m) {
            $len: Int = count(split($m.text, ""))
            Some(ReHit(start: $i, end: $i + $len, m: host_match_to_vmatch($m, $names)))
        }
        None {
            if $suffix == "" {
                None
            } else {
                regex_find_from(join(drop(split($suffix, ""), 1), ""), $anchored, $names, $i + 1)
            }
        }
    }
}

sub opt_str_text($v: Value): Str {
    match $v {
        VVariant($tag, $fields, $eid) {
            if $tag == "Some" {
                match $fields {
                    ValCons(VStr($s), ValNil) { $s }
                    _ { "" }
                }
            } else {
                ""
            }
        }
        _ { "" }
    }
}

sub vmatch_group_text($vm: Value, $idx: Int): Str {
    match $vm {
        VMatch($text, $names, $groups) {
            if $idx == 0 {
                $text
            } else {
                match vlist_index($groups, $idx - 1) {
                    Some($cap) { opt_str_text($cap) }
                    None { "" }
                }
            }
        }
        _ { "" }
    }
}

sub vmatch_named_text($vm: Value, $want: Str): Str {
    match $vm {
        VMatch($text, $names, $groups) { opt_str_text(vmatch_named($want, $names, $groups)) }
        _ { "" }
    }
}

sub is_template_digit($c: Str): Bool {
    $c == "0" || $c == "1" || $c == "2" || $c == "3" || $c == "4" ||
        $c == "5" || $c == "6" || $c == "7" || $c == "8" || $c == "9"
}

# §15.3 replace template: $0…$9, $<name>, $$; unknown/absent → "".
sub expand_replace_template($tmpl: Str, $vm: Value, $i: Int, $out: Str): Str {
    @chars = split($tmpl, "")
    $n: Int = count(@chars)
    if $i >= $n {
        $out
    } else if @chars[$i] != '$' {
        expand_replace_template($tmpl, $vm, $i + 1, $out ~ @chars[$i])
    } else if $i + 1 >= $n {
        $out ~ '$'
    } else if @chars[$i + 1] == '$' {
        expand_replace_template($tmpl, $vm, $i + 2, $out ~ '$')
    } else if is_template_digit(@chars[$i + 1]) {
        expand_replace_template($tmpl, $vm, $i + 2, $out ~ vmatch_group_text($vm, parse_int(@chars[$i + 1]).unwrap_or(0)))
    } else if @chars[$i + 1] == "<" {
        expand_replace_named($tmpl, $vm, $i + 2, $out, "")
    } else {
        expand_replace_template($tmpl, $vm, $i + 1, $out ~ '$')
    }
}

sub expand_replace_named($tmpl: Str, $vm: Value, $i: Int, $out: Str, $name: Str): Str {
    @chars = split($tmpl, "")
    $n: Int = count(@chars)
    if $i >= $n {
        $out ~ '$<' ~ $name
    } else if @chars[$i] == ">" {
        expand_replace_template($tmpl, $vm, $i + 1, $out ~ vmatch_named_text($vm, $name))
    } else {
        expand_replace_named($tmpl, $vm, $i + 1, $out, $name ~ @chars[$i])
    }
}

# Mirror guji_regex_replace_engine: leftmost-first, empty-match advance, prevEnd dedup.
sub regex_replace_loop($s: Str, $anchored: Regex, $names: StrList, $tmpl: Str, $pos: Int, $prev_end: Int, $last: Int, $out: Str): Str {
    @chars = split($s, "")
    $n: Int = count(@chars)
    if $pos > $n {
        $out ~ join(drop(@chars, $last), "")
    } else {
        match regex_find_from(join(drop(@chars, $pos), ""), $anchored, $names, $pos) {
            None { $out ~ join(drop(@chars, $last), "") }
            Some($hit) {
                $start = $hit.start
                $end = $hit.end
                $vm = $hit.m
                mut $accept = true
                mut $new_pos = $end
                if $start == $pos && $end == $pos {
                    if $start == $prev_end {
                        $accept = false
                    }
                    if $pos < $n {
                        $new_pos = $pos + 1
                    } else {
                        $new_pos = $n + 1
                    }
                }
                if !$accept {
                    regex_replace_loop($s, $anchored, $names, $tmpl, $new_pos, $end, $last, $out)
                } else {
                    $gap = join(take(drop(@chars, $last), $start - $last), "")
                    $piece = expand_replace_template($tmpl, $vm, 0, "")
                    regex_replace_loop($s, $anchored, $names, $tmpl, $new_pos, $end, $end, $out ~ $gap ~ $piece)
                }
            }
        }
    }
}

sub regex_replace_with_loop($s: Str, $anchored: Regex, $names: StrList, $fn: Value, $subs: SubTable, $pos: Int, $prev_end: Int, $last: Int, $out: Str): Result[Str, Str] {
    @chars = split($s, "")
    $n: Int = count(@chars)
    if $pos > $n {
        Ok($out ~ join(drop(@chars, $last), ""))
    } else {
        match regex_find_from(join(drop(@chars, $pos), ""), $anchored, $names, $pos) {
            None { Ok($out ~ join(drop(@chars, $last), "")) }
            Some($hit) {
                $start = $hit.start
                $end = $hit.end
                $vm = $hit.m
                mut $accept = true
                mut $new_pos = $end
                if $start == $pos && $end == $pos {
                    if $start == $prev_end {
                        $accept = false
                    }
                    if $pos < $n {
                        $new_pos = $pos + 1
                    } else {
                        $new_pos = $n + 1
                    }
                }
                if !$accept {
                    regex_replace_with_loop($s, $anchored, $names, $fn, $subs, $new_pos, $end, $last, $out)
                } else {
                    match call_list_hof_fn($fn, ValCons($vm, ValNil), $subs) {
                        Err($e) { Err($e) }
                        Ok($ret) {
                            match $ret {
                                VStr($piece) {
                                    $gap = join(take(drop(@chars, $last), $start - $last), "")
                                    regex_replace_with_loop($s, $anchored, $names, $fn, $subs, $new_pos, $end, $end, $out ~ $gap ~ $piece)
                                }
                                _ { Err(eval_err("replace_with callback must return Str, got " ~ value_type_name($ret))) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub apply_regex_replace($s: Str, $p: Str, $private: Bool, $tmpl: Str): Result[Str, Str] {
    match regex_compile_value("\\A(?:" ~ $p ~ ")", $private) {
        Err($e) { Err(eval_err("invalid regex: " ~ $e)) }
        Ok($anchored) {
            Ok(regex_replace_loop($s, $anchored, g6_regex_cap_names($p), $tmpl, 0, -1, 0, ""))
        }
    }
}

sub apply_regex_replace_with($s: Str, $p: Str, $private: Bool, $fn: Value, $subs: SubTable): Result[Str, Str] {
    match regex_compile_value("\\A(?:" ~ $p ~ ")", $private) {
        Err($e) { Err(eval_err("invalid regex: " ~ $e)) }
        Ok($anchored) {
            regex_replace_with_loop($s, $anchored, g6_regex_cap_names($p), $fn, $subs, 0, -1, 0, "")
        }
    }
}

# §13.4 associated functions on the Regex type name.
sub eval_regex_assoc($method: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None {
                    if $method == "compile" {
                        match $ar.values {
                            ValCons(VStr($s), ValNil) {
                                match Regex.compile($s) {
                                    Ok($re) { Ok(flow(VVariant("Ok", ValCons(VRegex($s, false), ValNil), ""), $ar.env)) }
                                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $ar.env)) }
                                }
                            }
                            _ { Err(eval_err("Regex.compile expects 1 Str argument")) }
                        }
                    } else if $method == "escape" {
                        match $ar.values {
                            ValCons(VStr($s), ValNil) { Ok(flow(VStr(Regex.escape($s)), $ar.env)) }
                            _ { Err(eval_err("Regex.escape expects 1 Str argument")) }
                        }
                    } else if $method == "literal" {
                        match $ar.values {
                            ValCons(VStr($s), ValNil) { Ok(flow(VRegex(Regex.escape($s), false), $ar.env)) }
                            _ { Err(eval_err("Regex.literal expects 1 Str argument")) }
                        }
                    } else {
                        Err(eval_err("Regex has no associated function " ~ $method))
                    }
                }
            }
        }
    }
}

# ---------------------------------------------------------------------------
# §14 PEG evaluation (I7e): interpret the shared PegExpr tree used by native C.
# TOP must consume the complete input. `rule` whitespace is already represented
# by PegWhitespace nodes from peg_parse_body; token/regex productions receive no
# implicit nodes. Named Bush lookup and recursive/error fixtures remain I7f.
# ---------------------------------------------------------------------------

sub peg_eval_caps_concat($a: ValueList, $b: ValueList): ValueList {
    match $a {
        ValNil { $b }
        ValCons($h, $t) { ValCons($h, peg_eval_caps_concat($t, $b)) }
    }
}

sub peg_eval_slice(@chars: List[Str], $start: Int, $end: Int): Str {
    take(drop(@chars, $start), $end - $start).join("")
}

sub peg_eval_literal_at(@chars: List[Str], $pos: Int, $text: Str): Bool {
    @lit: List[Str] = split($text, "")
    $n = @lit.count()
    $pos >= 0 && $pos + $n <= @chars.count() && take(drop(@chars, $pos), $n) == @lit
}

sub peg_eval_space($c: Str): Bool {
    # Native guji_peg_ws uses exactly [\t\n\f\r ], not Unicode White_Space.
    ($c ~~ /[ \t\n\f\r]/).is_some()
}

sub peg_eval_skip_ws(@chars: List[Str], $pos: Int): Int {
    if $pos < @chars.count() && peg_eval_space(@chars[$pos]) {
        peg_eval_skip_ws(@chars, $pos + 1)
    } else {
        $pos
    }
}

sub peg_eval_seq($xs: PegExprList, $tab: PegProdTable, @chars: List[Str], $state: PegEval): Result[PegEval, Str] {
    match $xs {
        PegNil { Ok($state) }
        PegCons($h, $t) {
            match peg_eval_expr($h, $tab, @chars, $state.pos) {
                Err($e) { Err($e) }
                Ok($got) {
                    if !$got.ok {
                        Ok(PegEval(ok: false, pos: $state.pos, caps: ValNil))
                    } else {
                        peg_eval_seq($t, $tab, @chars, PegEval(
                            ok: true,
                            pos: $got.pos,
                            caps: peg_eval_caps_concat($state.caps, $got.caps)
                        ))
                    }
                }
            }
        }
    }
}

sub peg_eval_choice($xs: PegExprList, $tab: PegProdTable, @chars: List[Str], $pos: Int): Result[PegEval, Str] {
    match $xs {
        PegNil { Ok(PegEval(ok: false, pos: $pos, caps: ValNil)) }
        PegCons($h, $t) {
            match peg_eval_expr($h, $tab, @chars, $pos) {
                Err($e) { Err($e) }
                Ok($got) {
                    if $got.ok { Ok($got) } else { peg_eval_choice($t, $tab, @chars, $pos) }
                }
            }
        }
    }
}

sub peg_eval_regex($pattern: Str, @chars: List[Str], $pos: Int): Result[PegEval, Str] {
    $suffix: Str = drop(@chars, $pos).join("")
    # Grammar regex atoms are anchored at the current position and run under
    # dot-all, matching compileGrammarRegex / guji_peg_regex.
    match Regex.compile("\\A(?s:" ~ $pattern ~ ")") {
        Err($e) { Err(eval_err("invalid regex in grammar: " ~ $e)) }
        Ok($anchored) {
            match $suffix ~~ $anchored {
                None { Ok(PegEval(ok: false, pos: $pos, caps: ValNil)) }
                Some($m) {
                    Ok(PegEval(ok: true, pos: $pos + split($m.text, "").count(), caps: ValNil))
                }
            }
        }
    }
}

sub peg_eval_prod($name: Str, $tab: PegProdTable, @chars: List[Str], $pos: Int): Result[PegEval, Str] {
    match peg_prod_lookup($tab, $name) {
        None { Err(eval_err("unknown grammar production: " ~ $name)) }
        Some($expr) { peg_eval_expr($expr, $tab, @chars, $pos) }
    }
}

sub peg_eval_expr($expr: PegExpr, $tab: PegProdTable, @chars: List[Str], $pos: Int): Result[PegEval, Str] {
    match $expr {
        PegChoice($alts) { peg_eval_choice($alts, $tab, @chars, $pos) }
        PegSeq($terms) { peg_eval_seq($terms, $tab, @chars, PegEval(ok: true, pos: $pos, caps: ValNil)) }
        PegRef($name) {
            match peg_eval_prod($name, $tab, @chars, $pos) {
                Err($e) { Err($e) }
                Ok($got) {
                    if !$got.ok {
                        Ok(PegEval(ok: false, pos: $pos, caps: ValNil))
                    } else {
                        Ok(PegEval(
                            ok: true,
                            pos: $got.pos,
                            caps: ValCons(VBush($name, peg_eval_slice(@chars, $pos, $got.pos), $got.caps), ValNil)
                        ))
                    }
                }
            }
        }
        PegLit($text) {
            if peg_eval_literal_at(@chars, $pos, $text) {
                Ok(PegEval(ok: true, pos: $pos + split($text, "").count(), caps: ValNil))
            } else {
                Ok(PegEval(ok: false, pos: $pos, caps: ValNil))
            }
        }
        PegRegex($pattern) { peg_eval_regex($pattern, @chars, $pos) }
        PegWhitespace { Ok(PegEval(ok: true, pos: peg_eval_skip_ws(@chars, $pos), caps: ValNil)) }
    }
}

sub eval_grammar_assoc($g: GrammarDecl, $method: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $method != "parse" {
        Err(eval_err("grammar " ~ $g.name ~ " has no associated function " ~ $method))
    } else {
        match eval_args($args, $subs, $env) {
            Err($e) { Err($e) }
            Ok($ar) {
                match $ar.early {
                    Some($er) { Ok($er) }
                    None {
                        match $ar.values {
                            ValCons(VStr($input), ValNil) {
                                match peg_build_prod_table($g.productions, $g.name, PPTNil) {
                                    Err($e) { Err(eval_err($e)) }
                                    Ok($tab) {
                                        @chars: List[Str] = split($input, "")
                                        match peg_eval_prod("TOP", $tab, @chars, 0) {
                                            Err($e) { Err($e) }
                                            Ok($got) {
                                                if $got.ok && $got.pos == @chars.count() {
                                                    Ok(flow(VVariant("Some", ValCons(
                                                        VBush("TOP", peg_eval_slice(@chars, 0, $got.pos), $got.caps),
                                                        ValNil
                                                    ), ""), $ar.env))
                                                } else {
                                                    Ok(flow(VVariant("None", ValNil, ""), $ar.env))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            _ { Err(eval_err($g.name ~ ".parse expects 1 Str argument")) }
                        }
                    }
                }
            }
        }
    }
}

sub eval_binop($op: Str, $a: Value, $b: Value): Result[Value, Str] {
    if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" {
        eval_arith($op, $a, $b)
    } else if $op == "==" {
        Ok(VBool(value_eq($a, $b)))
    } else if $op == "!=" {
        Ok(VBool(!value_eq($a, $b)))
    } else if $op == "<" || $op == "<=" || $op == ">" || $op == ">=" {
        eval_order($op, $a, $b)
    } else if $op == "~" {
        eval_concat($a, $b)
    } else if $op == "~~" {
        eval_match_op($a, $b)
    } else if $op == ".." || $op == "..<" {
        match $a {
            VInt($from) {
                match $b {
                    VInt($to) { Ok(VRange($from, $to, $op == "..<")) }
                    _ { Err(eval_err("range bound must be Int, got " ~ value_type_name($b))) }
                }
            }
            _ { Err(eval_err("range bound must be Int, got " ~ value_type_name($a))) }
        }
    } else {
        Err(eval_err("operator '" ~ $op ~ "' not supported in slice E1"))
    }
}

# ---- display form (Section 15.4): matches the Go oracle's value display ----

# Map display, keys/values, and iteration use deterministic lexicographic key
# order. Keep each linear walk iterative: the old insertion sort was O(n^2) and
# put one native stack frame around every map entry. This top-down merge sort is
# O(n log n), and only the balanced sort calls recurse (O(log n) stack).
class ValMapSplit {
    has $.left: ValMapList
    has $.right: ValMapList
}

sub vmap_reverse_onto($es: ValMapList, $onto: ValMapList): ValMapList {
    mut $cur = $es
    mut $out = $onto
    mut $going = true
    while $going {
        match $cur {
            ValMapNil { $going = false }
            ValMapCons($head, $tail) {
                $out = ValMapCons($head, $out)
                $cur = $tail
            }
        }
    }
    $out
}

# Alternate entries into two reversed accumulators, then restore each half's
# source order. Alternation keeps their lengths within one without a length pass.
sub vmap_split($es: ValMapList): ValMapSplit {
    mut $cur = $es
    mut $left_rev = ValMapNil
    mut $right_rev = ValMapNil
    mut $take_left = true
    mut $going = true
    while $going {
        match $cur {
            ValMapNil { $going = false }
            ValMapCons($head, $tail) {
                if $take_left {
                    $left_rev = ValMapCons($head, $left_rev)
                } else {
                    $right_rev = ValMapCons($head, $right_rev)
                }
                $take_left = !$take_left
                $cur = $tail
            }
        }
    }
    ValMapSplit(
        left: vmap_reverse_onto($left_rev, ValMapNil),
        right: vmap_reverse_onto($right_rev, ValMapNil)
    )
}

# Merge to a reversed accumulator, including the final non-empty tail, then
# reverse once. Equal keys choose the left half first; valid maps have unique
# keys, and the tie rule keeps malformed internal values deterministic too.
sub vmap_merge($left_in: ValMapList, $right_in: ValMapList): ValMapList {
    mut $left = $left_in
    mut $right = $right_in
    mut $rev = ValMapNil
    mut $going = true
    while $going {
        match $left {
            ValMapNil {
                match $right {
                    ValMapNil { $going = false }
                    ValMapCons($head, $tail) {
                        $rev = ValMapCons($head, $rev)
                        $right = $tail
                    }
                }
            }
            ValMapCons($left_head, $left_tail) {
                match $right {
                    ValMapNil {
                        $rev = ValMapCons($left_head, $rev)
                        $left = $left_tail
                    }
                    ValMapCons($right_head, $right_tail) {
                        if $left_head.key <= $right_head.key {
                            $rev = ValMapCons($left_head, $rev)
                            $left = $left_tail
                        } else {
                            $rev = ValMapCons($right_head, $rev)
                            $right = $right_tail
                        }
                    }
                }
            }
        }
    }
    vmap_reverse_onto($rev, ValMapNil)
}

sub vmap_sort($es: ValMapList): ValMapList {
    match $es {
        ValMapNil { ValMapNil }
        ValMapCons($head, $tail) {
            match $tail {
                ValMapNil { $es }
                _ {
                    $halves = vmap_split($es)
                    vmap_merge(vmap_sort($halves.left), vmap_sort($halves.right))
                }
            }
        }
    }
}

sub display_list_items($xs: ValueList): Str {
    match $xs {
        ValNil { "" }
        ValCons($x, ValNil) { display_value($x) }
        ValCons($x, $rest) { display_value($x) ~ ", " ~ display_list_items($rest) }
    }
}

# Map display keys use the same quoted text contract as the maintained C
# runtime. Guji literals intentionally decode only the §12 escapes, so
# runtime-only control scalars are recognized by regex rather than by widening
# literal escape semantics. Escape backslash first; later replacement text does
# not match any remaining control pattern.
sub display_map_key_quote($s: Str): Str {
    mut $out = $s.replace(/\\/, "\\\\")
    $out = $out.replace(/"/, "\\\"")
    $out = $out.replace(/\x07/, "\\a")
    $out = $out.replace(/\x08/, "\\b")
    $out = $out.replace(/\x09/, "\\t")
    $out = $out.replace(/\x0a/, "\\n")
    $out = $out.replace(/\x0b/, "\\v")
    $out = $out.replace(/\x0c/, "\\f")
    $out = $out.replace(/\x0d/, "\\r")
    $out = $out.replace(/\x00/, "\\x00")
    $out = $out.replace(/\x01/, "\\x01")
    $out = $out.replace(/\x02/, "\\x02")
    $out = $out.replace(/\x03/, "\\x03")
    $out = $out.replace(/\x04/, "\\x04")
    $out = $out.replace(/\x05/, "\\x05")
    $out = $out.replace(/\x06/, "\\x06")
    $out = $out.replace(/\x0e/, "\\x0e")
    $out = $out.replace(/\x0f/, "\\x0f")
    $out = $out.replace(/\x10/, "\\x10")
    $out = $out.replace(/\x11/, "\\x11")
    $out = $out.replace(/\x12/, "\\x12")
    $out = $out.replace(/\x13/, "\\x13")
    $out = $out.replace(/\x14/, "\\x14")
    $out = $out.replace(/\x15/, "\\x15")
    $out = $out.replace(/\x16/, "\\x16")
    $out = $out.replace(/\x17/, "\\x17")
    $out = $out.replace(/\x18/, "\\x18")
    $out = $out.replace(/\x19/, "\\x19")
    $out = $out.replace(/\x1a/, "\\x1a")
    $out = $out.replace(/\x1b/, "\\x1b")
    $out = $out.replace(/\x1c/, "\\x1c")
    $out = $out.replace(/\x1d/, "\\x1d")
    $out = $out.replace(/\x1e/, "\\x1e")
    $out = $out.replace(/\x1f/, "\\x1f")
    $out = $out.replace(/\x7f/, "\\x7f")
    "\"" ~ $out ~ "\""
}

sub display_map_entry($e: ValMapEntry): Str {
    display_map_key_quote($e.key) ~ ": " ~ display_value($e.value)
}

sub display_map_items($es: ValMapList): Str {
    match $es {
        ValMapNil { "" }
        ValMapCons($e, ValMapNil) { display_map_entry($e) }
        ValMapCons($e, $rest) { display_map_entry($e) ~ ", " ~ display_map_items($rest) }
    }
}

sub display_variant($tag: Str, $fs: ValueList): Str {
    match $fs {
        ValNil { $tag }
        _ { $tag ~ "(" ~ display_list_items($fs) ~ ")" }
    }
}

# Class instance display (oracle InstanceVal.String): `Cls(k: v, k2: v2)` with
# the field names SORTED and values in display form (Str fields unquoted).
sub display_inst_items($es: ValMapList): Str {
    match $es {
        ValMapNil { "" }
        ValMapCons($e, ValMapNil) { $e.key ~ ": " ~ display_value($e.value) }
        ValMapCons($e, $rest) { $e.key ~ ": " ~ display_value($e.value) ~ ", " ~ display_inst_items($rest) }
    }
}

pub sub display_value($v: Value): Str {
    match $v {
        VInt($n) { "{ $n }" }
        VFloat($x) { "{ $x }" }
        VStr($s) { $s }
        VBool($b) { if $b { "true" } else { "false" } }
        VUnit { "()" }
        VList($xs) { "[" ~ display_list_items($xs) ~ "]" }
        VMap($es) { '{' ~ display_map_items(vmap_sort($es)) ~ '}' }
        VRange($from, $to, $open) { "{ $from }" ~ (if $open { "..<" } else { ".." }) ~ "{ $to }" }
        VVariant($tag, $fs, $eid) { display_variant($tag, $fs) }
        VInstance($cn, $fs) { nominal_display_name($cn) ~ "(" ~ display_inst_items(vmap_sort($fs)) ~ ")" }
        VFunction($key, $caps) { "<function>" }
        # §13: display position renders `/<pattern>/` (C: g3_regex_display_wrap).
        VRegex($p, $private) { "/" ~ $p ~ "/" }
        # §13.3: Match display mirrors Go/C `<match "…">` (quoted whole-match text).
        VMatch($t, $names, $groups) { "<match " ~ q($t) ~ ">" }
        # Native C intentionally keeps Bush display opaque; `.text` is the
        # specified way to observe a node's matched span.
        VBush($name, $text, $caps) { "<bush>" }
        # §15.4: Handle display is the legacy alpha spelling `<reader>` for both
        # read and write handles (byte-compat with C/Go).
        VHandle($stream) { "<reader>" }
        VFileHandle($h) { "<reader>" }
        # §17.2 channel display is the opaque `<chan>` spelling.
        VChanUnit($ch) { "<chan>" }
        VChanInt($ch) { "<chan>" }
        VChanBool($ch) { "<chan>" }
        VChanFloat($ch) { "<chan>" }
        VChanStr($ch) { "<chan>" }
        VChanListInt($ch) { "<chan>" }
        VChanMapStr($ch) { "<chan>" }
        VChanEnum($ch) { "<chan>" }
    }
}

# ---- the core expression evaluator ----

class EvalResult {
    has $.value: Value
    has $.env: Env
    has $.returned: Bool
}

# One PEG-expression attempt in the tree evaluator. A failed attempt carries no
# captures; ordered choice retries from its original position. Successful refs
# append one VBush child to `$caps`, matching the native matcher ownership tree.
class PegEval {
    has $.ok: Bool
    has $.pos: Int
    has $.caps: ValueList
}

sub flow($value: Value, $env: Env): EvalResult {
    EvalResult(value: $value, env: $env, returned: false)
}

sub return_flow($value: Value, $env: Env): EvalResult {
    EvalResult(value: $value, env: $env, returned: true)
}

# §12 double-quoted strings retain interpolation markers in EStr so the same
# parsed AST works for the typechecker and code generator. Evaluate those
# markers here, left-to-right, threading the environment produced by each
# embedded expression. The lexer has already decoded unambiguous escapes
# (`\n`, `\t`, `\\`, `\"`) and deliberately retained a backslash marker for
# escaped interpolation starters (`\$`, `\@`, `\%`, `\{`).
sub parse_interpolation_expr($src: Str): Result[Expr, Str] {
    match lex($src) {
        Err($e) { Err($e) }
        Ok($toks) {
            match parse_expr(Parser(toks: $toks, layout: true)) {
                Err($e) { Err($e) }
                Ok($r) {
                    $p0 = skip_newlines($r.p)
                    if is_kind(peek($p0), KEof) {
                        Ok($r.node)
                    } else {
                        Err(parse_err(peek($p0), "unexpected token after interpolation expression"))
                    }
                }
            }
        }
    }
}

sub eval_interp_parts(@chars: List[Str], $i: Int, $n: Int, $acc: Str, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $i >= $n {
        Ok(flow(VStr($acc), $env))
    } else {
        $c = at(@chars, $i)
        $next = at(@chars, $i + 1)
        if $c == "\\" && $next == '{' {
            eval_interp_parts(@chars, $i + 2, $n, $acc ~ '{', $subs, $env)
        } else if $c == "\\" && $next == '}' {
            # `\}` is not a §12 escape, so both bytes remain verbatim.
            eval_interp_parts(@chars, $i + 2, $n, $acc ~ "\\" ~ '}', $subs, $env)
        } else if $c == "\\" && ($next == '$' || $next == '@' || $next == '%') {
            eval_interp_parts(@chars, $i + 2, $n, $acc ~ $next, $subs, $env)
        } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start($next) {
            $run = take_ident(@chars, $i + 1, $c)
            match env_lookup($env, $run.text) {
                None { Err(eval_err("undefined binding " ~ $run.text ~ " in interpolation")) }
                Some($v) {
                    eval_interp_parts(@chars, $run.next, $n, $acc ~ display_value($v), $subs, $env)
                }
            }
        } else if $c == '{' {
            match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                None { Err(eval_err("unterminated \{ interpolation in string")) }
                Some($scan) {
                    match parse_interpolation_expr($scan.text) {
                        Err($e) { Err(eval_err("in interpolation " ~ q($scan.text) ~ ": " ~ $e)) }
                        Ok($expr) {
                            match eval_expr_flow($expr, $subs, $env) {
                                Err($e) { Err($e) }
                                Ok($r) {
                                    if $r.returned {
                                        Ok($r)
                                    } else {
                                        eval_interp_parts(@chars, $scan.next, $n, $acc ~ display_value($r.value), $subs, $r.env)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            eval_interp_parts(@chars, $i + 1, $n, $acc ~ $c, $subs, $env)
        }
    }
}

sub eval_interpolated_str($text: Str, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if has_char($text, '{') || has_char($text, '$') || has_char($text, '@') || has_char($text, '%') {
        @chars = split($text, "")
        eval_interp_parts(@chars, 0, @chars.count(), "", $subs, $env)
    } else {
        Ok(flow(VStr($text), $env))
    }
}

sub eval_unary($op: Str, $x: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($x, $subs, $env) {
        Err($e) { Err($e) }
        Ok($r) {
            if $r.returned {
                Ok($r)
            } else if $op == "-" {
                match $r.value {
                    VInt($n) {
                        if $n == int_min() {
                            Err(eval_err("integer overflow"))
                        } else {
                            Ok(flow(VInt(0 - $n), $r.env))
                        }
                    }
                    # Multiplication by -1.0 toggles the IEEE sign bit even for
                    # zero; `0.0 - 0.0` would incorrectly produce positive zero.
                    VFloat($x) { Ok(flow(VFloat($x * -1.0), $r.env)) }
                    _ { Err(eval_err("unary - requires Int or Float")) }
                }
            } else if $op == "!" {
                match $r.value {
                    VBool($b) { Ok(flow(VBool(!$b), $r.env)) }
                    _ { Err(eval_err("unary ! requires Bool")) }
                }
            } else {
                Err(eval_err("unknown unary operator: " ~ $op))
            }
        }
    }
}

sub eval_logical($op: Str, $l: Expr, $r: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($l, $subs, $env) {
        Err($e) { Err($e) }
        Ok($lr) {
            if $lr.returned {
                Ok($lr)
            } else {
            match $lr.value {
                VBool($lb) {
                    if $op == "&&" && !$lb {
                        Ok(flow(VBool(false), $lr.env))
                    } else if $op == "||" && $lb {
                        Ok(flow(VBool(true), $lr.env))
                    } else {
                        match eval_expr_flow($r, $subs, $lr.env) {
                            Err($e) { Err($e) }
                            Ok($rr) {
                                if $rr.returned {
                                    Ok($rr)
                                } else {
                                match $rr.value {
                                    VBool($rb) { Ok(flow(VBool($rb), $rr.env)) }
                                    _ { Err(eval_err($op ~ " requires Bool operands")) }
                                }
                                }
                            }
                        }
                    }
                }
                _ { Err(eval_err($op ~ " requires Bool operands")) }
            }
            }
        }
    }
}

sub eval_binary($op: Str, $l: Expr, $r: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $op == "&&" || $op == "||" {
        eval_logical($op, $l, $r, $subs, $env)
    } else {
        match eval_expr_flow($l, $subs, $env) {
            Err($e) { Err($e) }
            Ok($lr) {
                if $lr.returned {
                    Ok($lr)
                } else {
                match eval_expr_flow($r, $subs, $lr.env) {
                    Err($e) { Err($e) }
                    Ok($rr) {
                        if $rr.returned {
                            Ok($rr)
                        } else {
                            match eval_binop($op, $lr.value, $rr.value) {
                                Err($e) { Err($e) }
                                Ok($v) { Ok(flow($v, $rr.env)) }
                            }
                        }
                    }
                }
                }
            }
        }
    }
}

# `print`/`note` builtins (the minimal pinned set, decision 3): evaluate the
# single argument and write its display form (+ a newline, supplied by the host)
# to stdout (`print`) or stderr (`note`). `print` is the differential's basis.
sub eval_print_to($args: ExprList, $subs: SubTable, $env: Env, $to_err: Bool): Result[EvalResult, Str] {
    match $args {
        ExprNil { Err(eval_err("print expects 1 argument, got 0")) }
        ExprCons($a, $rest) {
            match $rest {
                ExprNil {
                    match eval_expr_flow($a, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                if $to_err {
                                    note(display_value($r.value))
                                } else {
                                    print(display_value($r.value))
                                }
                                Ok(flow(VUnit, $r.env))
                            }
                        }
                    }
                }
                _ { Err(eval_err("print expects 1 argument, got more")) }
            }
        }
    }
}

# §15.4 exit must unwind past every call frame with a caller-chosen status and
# write nothing to stderr. Ordinary `returned` stops at `eval_call_user`, so exit
# rides the Err channel with a private sentinel that `eval_main` converts into
# MainEvalResult.exit_code. The prefix never appears in eval_err messages
# (those always start with "panic: ").
sub exit_signal($code: Int): Str {
    "__guji_exit__:" ~ "{ $code }"
}

sub parse_exit_signal($e: Str): Option[Int] {
    if starts_with($e, "__guji_exit__:") {
        $rest = drop(split($e, ""), 14).join("")
        match parse_int($rest) {
            Ok($n) { Some($n) }
            Err($x) { None }
        }
    } else {
        None
    }
}

# §11.2 panic($message: Str): Never — evaluate the message, then abort like the
# runtime's guji_panic: stderr "panic: <msg>" and process exit 1. User `sub panic`
# shadows the builtin (same rule as C's g4_panic_arg).
sub eval_builtin_panic($args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $args {
        ExprNil { Err(eval_err("panic expects 1 argument, got 0")) }
        ExprCons($a, $rest) {
            match $rest {
                ExprNil {
                    match eval_expr_flow($a, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                match $r.value {
                                    VStr($msg) { Err(eval_err($msg)) }
                                    _ { Err(eval_err("panic expects Str argument")) }
                                }
                            }
                        }
                    }
                }
                _ { Err(eval_err("panic expects 1 argument, got more")) }
            }
        }
    }
}

# §15.4 exit($code: Int): Never — evaluate the status, flush happens when the
# driver process ends after printing prior stdout, and terminate with `$code`.
# User `sub exit` shadows the builtin.
sub eval_builtin_exit($args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $args {
        ExprNil { Err(eval_err("exit expects 1 argument, got 0")) }
        ExprCons($a, $rest) {
            match $rest {
                ExprNil {
                    match eval_expr_flow($a, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                match $r.value {
                                    VInt($code) { Err(exit_signal($code)) }
                                    _ { Err(eval_err("exit expects Int argument")) }
                                }
                            }
                        }
                    }
                }
                _ { Err(eval_err("exit expects 1 argument, got more")) }
            }
        }
    }
}

# §15.4 args(): List[Str]. The canonical interpreter's host argv is
# [source.guji, ...guest]; drop the source path so guest args() matches a
# compiled binary's argv-after-program-name. Empty host argv (stdin mode) yields
# []. Free form remains user-shadowable via subtable-first dispatch.
sub eval_builtin_args($args: ExprList, $env: Env): Result[EvalResult, Str] {
    match $args {
        ExprNil {
            @host = args()
            if @host.count() == 0 {
                Ok(flow(VList(ValNil), $env))
            } else {
                Ok(flow(VList(value_list_from_strs(@host.drop(1), 0)), $env))
            }
        }
        _ { Err(eval_err("args expects 0 argument(s), got more")) }
    }
}

# §15.4 Handle.slurp / Handle.write / Handle.lines for standard streams and
# file-backed VFileHandle values. lines returns a real closed Chan[Str]
# (VChanStr); general channel()/send/select remain I10.
sub eval_handle_slurp_val($recv: Value, $env: Env): Result[EvalResult, Str] {
    match $recv {
        VHandle($stream) {
            if $stream == "stdin" {
                Ok(flow(VStr(stdin.slurp()), $env))
            } else {
                Err(eval_err("slurp: handle is not readable"))
            }
        }
        VFileHandle($h) {
            # Host slurp panics on write-only handles with the exact C text.
            Ok(flow(VStr($h.slurp()), $env))
        }
        _ { Err(eval_err("slurp expects a Handle")) }
    }
}

sub eval_handle_write_val($recv: Value, $text: Value, $env: Env): Result[EvalResult, Str] {
    match $recv {
        VHandle($stream) {
            match $text {
                VStr($s) {
                    if $stream == "stdout" {
                        stdout.write($s)
                        Ok(flow(VUnit, $env))
                    } else if $stream == "stderr" {
                        stderr.write($s)
                        Ok(flow(VUnit, $env))
                    } else {
                        Err(eval_err("write: handle is not writable"))
                    }
                }
                _ { Err(eval_err("write expects Str text")) }
            }
        }
        VFileHandle($h) {
            match $text {
                VStr($s) {
                    # Host write panics on read-only handles with the exact C text.
                    $h.write($s)
                    Ok(flow(VUnit, $env))
                }
                _ { Err(eval_err("write expects Str text")) }
            }
        }
        _ { Err(eval_err("write expects a Handle")) }
    }
}

# §15.4 Handle.lines → closed Chan[Str]. Call the host Handle.lines builtin
# (guji_reader_lines) so D and C share one eager split/close path. Inline the
# call into VChanStr — an annotated Chan local inside the if-arm was declined
# by the trusted seed's statement subset.
sub eval_handle_lines_val($recv: Value, $env: Env): Result[EvalResult, Str] {
    match $recv {
        VHandle($stream) {
            if $stream != "stdin" {
                Err(eval_err("slurp: handle is not readable"))
            } else {
                Ok(flow(VChanStr(stdin.lines()), $env))
            }
        }
        VFileHandle($h) {
            Ok(flow(VChanStr($h.lines()), $env))
        }
        _ { Err(eval_err("lines expects a Handle")) }
    }
}

sub eval_handle_method($n: Str, $recv: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $n == "slurp" {
        match $args {
            ExprNil { eval_handle_slurp_val($recv, $env) }
            _ { Err(eval_err("slurp expects 0 argument(s), got more")) }
        }
    } else if $n == "lines" {
        match $args {
            ExprNil { eval_handle_lines_val($recv, $env) }
            _ { Err(eval_err("lines expects 0 argument(s), got more")) }
        }
    } else if $n == "write" {
        match $args {
            ExprCons($a, ExprNil) {
                match eval_expr_flow($a, $subs, $env) {
                    Err($e) { Err($e) }
                    Ok($r) {
                        if $r.returned {
                            Ok($r)
                        } else {
                            eval_handle_write_val($recv, $r.value, $r.env)
                        }
                    }
                }
            }
            ExprNil { Err(eval_err("write expects 1 argument, got 0")) }
            _ { Err(eval_err("write expects 1 argument, got more")) }
        }
    } else {
        Err(eval_err("undefined function: " ~ $n))
    }
}

# Free-form slurp(handle) / write(handle, text) / lines(handle) after args
# evaluate. lines(Str) stays on the string-unary mutation edge.
sub eval_handle_free($n: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None {
                    if $n == "slurp" {
                        match $ar.values {
                            ValCons($h, ValNil) { eval_handle_slurp_val($h, $ar.env) }
                            _ { Err(eval_err("slurp expects 1 Handle argument")) }
                        }
                    } else if $n == "lines" {
                        match $ar.values {
                            ValCons($h, ValNil) { eval_handle_lines_val($h, $ar.env) }
                            _ { Err(eval_err("lines expects 1 Handle argument")) }
                        }
                    } else {
                        match $ar.values {
                            ValCons($h, ValCons($text, ValNil)) { eval_handle_write_val($h, $text, $ar.env) }
                            _ { Err(eval_err("write expects a Handle and Str")) }
                        }
                    }
                }
            }
        }
    }
}

# §15.4 path/file prelude names. Free form lets a user `sub` shadow; method
# form on a Str path is always the prelude (matching C).
sub is_file_path_prelude($n: Str): Bool {
    $n == "read_file" || $n == "write_file" || $n == "append_file" ||
        $n == "open" || $n == "create"
}

# Wrap host Result[Str, Str] / Result[Unit, Str] / Result[Handle, Str] as
# evaluator VVariant carriers. Keep each arm flat for bootstrap headroom.
sub eval_file_path_apply($n: Str, $vals: ValueList, $env: Env): Result[EvalResult, Str] {
    $argc = vlist_len($vals)
    if $n == "read_file" {
        match $vals {
            ValCons(VStr($path), ValNil) {
                match read_file($path) {
                    Ok($s) { Ok(flow(VVariant("Ok", ValCons(VStr($s), ValNil), ""), $env)) }
                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env)) }
                }
            }
            _ { Err(eval_err("read_file expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "write_file" {
        match $vals {
            ValCons(VStr($path), ValCons(VStr($content), ValNil)) {
                match write_file($path, $content) {
                    Ok($u) { Ok(flow(VVariant("Ok", ValCons(VUnit, ValNil), ""), $env)) }
                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env)) }
                }
            }
            _ { Err(eval_err("write_file expects 2 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "append_file" {
        match $vals {
            ValCons(VStr($path), ValCons(VStr($content), ValNil)) {
                match append_file($path, $content) {
                    Ok($u) { Ok(flow(VVariant("Ok", ValCons(VUnit, ValNil), ""), $env)) }
                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env)) }
                }
            }
            _ { Err(eval_err("append_file expects 2 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "open" {
        match $vals {
            ValCons(VStr($path), ValNil) {
                match open($path) {
                    Ok($h) { Ok(flow(VVariant("Ok", ValCons(VFileHandle($h), ValNil), ""), $env)) }
                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env)) }
                }
            }
            _ { Err(eval_err("open expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else {
        # create
        match $vals {
            ValCons(VStr($path), ValNil) {
                match create($path) {
                    Ok($h) { Ok(flow(VVariant("Ok", ValCons(VFileHandle($h), ValNil), ""), $env)) }
                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env)) }
                }
            }
            _ { Err(eval_err("create expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    }
}

sub eval_file_path_call($n: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { eval_file_path_apply($n, $ar.values, $ar.env) }
            }
        }
    }
}

# Method form: path is the pre-evaluated Str receiver; remaining args follow.
sub eval_file_path_ufcs($n: Str, $recv: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { eval_file_path_apply($n, ValCons($recv, $ar.values), $ar.env) }
            }
        }
    }
}

# §15.6 process spawning. Evaluator Lists use the recursive ValueList carrier,
# while the host `run` builtin requires a native List[Str]. Encode each argument
# before joining so one host split can materialize that list without losing empty
# arguments or literal separator/escape characters. Decode order is significant:
# `%7C` first, then `%25`, so an original literal "%7C" round-trips unchanged.
sub process_arg_encode($s: Str): Str {
    replace(replace($s, /%/, '%25'), /\|/, '%7C')
}

sub process_arg_decode($s: Str): Str {
    replace(replace($s, /%7C/, '|'), /%25/, '%')
}

sub process_args_encode($xs: ValueList): Result[Str, Str] {
    match $xs {
        ValNil { Ok("") }
        ValCons(VStr($s), ValNil) { Ok(process_arg_encode($s)) }
        ValCons(VStr($s), $tail) {
            match process_args_encode($tail) {
                Ok($rest) { Ok(process_arg_encode($s) ~ "|" ~ $rest) }
                Err($e) { Err($e) }
            }
        }
        _ { Err("run expects List[Str] arguments") }
    }
}

sub process_value($p: Proc): Value {
    VInstance("Proc",
        ValMapCons(ValMapEntry(key: "exit_code", value: VInt($p.exit_code)),
        ValMapCons(ValMapEntry(key: "stdout", value: VStr($p.stdout)),
        ValMapCons(ValMapEntry(key: "stderr", value: VStr($p.stderr)), ValMapNil))))
}

sub eval_process_host($cmd: Str, @argv: List[Str], $env: Env): Result[EvalResult, Str] {
    match run($cmd, @argv) {
        Ok($p) {
            Ok(flow(VVariant("Ok", ValCons(process_value($p), ValNil), ""), $env))
        }
        Err($e) {
            Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env))
        }
    }
}

sub eval_process_apply($vals: ValueList, $env: Env): Result[EvalResult, Str] {
    match $vals {
        ValCons(VStr($cmd), ValCons(VList($argv), ValNil)) {
            match $argv {
                ValNil { eval_process_host($cmd, [], $env) }
                _ {
                    match process_args_encode($argv) {
                        Ok($encoded) {
                            eval_process_host($cmd, split($encoded, "|").map({ process_arg_decode($_) }), $env)
                        }
                        Err($e) { Err(eval_err($e)) }
                    }
                }
            }
        }
        _ { Err(eval_err("run expects a Str command and List[Str] arguments")) }
    }
}

sub eval_process_call($args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { eval_process_apply($ar.values, $ar.env) }
            }
        }
    }
}

sub eval_process_ufcs($recv: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { eval_process_apply(ValCons($recv, $ar.values), $ar.env) }
            }
        }
    }
}

# §15.1/§15.2 collection query prelude names. Function form lets a user `sub`
# shadow the builtin. Method form normally selects the prelude directly; `is_empty`
# is the exception because C deliberately defers both spellings to a user shadow.
sub is_collection_query_prelude($n: Str): Bool {
    $n == "count" || $n == "is_empty" || $n == "contains" || $n == "get" ||
        $n == "has_key" || $n == "keys" || $n == "values"
}

# §15.2 persistent Map updates. As with query builtins, a user sub shadows the
# free-function spelling while method form always selects the prelude.
sub is_collection_mutation_prelude($n: Str): Bool {
    $n == "set" || $n == "remove"
}

# §15.1 List higher-order functions. Free/method spellings allow a user-sub
# shadow (matching C). All six share one dispatch arm and one recursive walker:
# adding sibling mutation arms or walkers exceeds the bootstrap stack budget.
sub is_list_hof_prelude($n: Str): Bool {
    $n == "map" || $n == "filter" || $n == "each" || $n == "find" ||
        $n == "reduce" || $n == "sort_by"
}

# §15.1 List folds and ordering (I5f). Non-callback aggregates/transforms share
# the mutation eval_args edge; reduce (2-arg fold) is I5f2. Free/method forms
# both allow a user-sub shadow (matching C).
sub is_list_fold_prelude($n: Str): Bool {
    $n == "sum" || $n == "min" || $n == "max" || $n == "reverse" ||
        $n == "take" || $n == "drop" || $n == "sort"
}

# §15.1 List join (I5i). Free/method spellings allow a user-sub shadow (matching
# C's g7_join_value decline). Hosted on the mutation eval_args edge beside the
# string/fold arms — not a fresh wrapper (bootstrap stack budget).
sub is_list_join_prelude($n: Str): Bool {
    $n == "join"
}

# §15.5 Option/Result extraction. Keep these on the existing mutation/HOF
# eval_args edge: every argument (including an unused default/fallback) is eager,
# and adding a sibling evaluator wrapper would deepen the bootstrap-critical
# eval_call cycle. Function form is shadowable; method form is the prelude.
sub is_carrier_extract_prelude($n: Str): Bool {
    $n == "unwrap" || $n == "unwrap_or" || $n == "unwrap_or_else" ||
        $n == "expect"
}

# §15.5 carrier predicates/combinators/conversions (I6c/I6h). Same eager
# eval_args edge as extraction. `map` stays on the List HOF name and dispatches
# by receiver kind inside apply_collection_mutation. Function form is
# shadowable; method form is the prelude (matching C).
sub is_carrier_combinator_prelude($n: Str): Bool {
    $n == "is_some" || $n == "is_none" || $n == "is_ok" || $n == "is_err" ||
        $n == "map_err" || $n == "and_then" || $n == "or_else" ||
        $n == "ok" || $n == "err" || $n == "ok_or"
}

sub option_some_val($v: Value): Value {
    VVariant("Some", ValCons($v, ValNil), "")
}

sub option_none_val(): Value {
    VVariant("None", ValNil, "")
}

sub vlist_len($xs: ValueList): Int {
    match $xs {
        ValNil { 0 }
        ValCons($h, $t) { 1 + vlist_len($t) }
    }
}

sub vlist_contains($xs: ValueList, $needle: Value): Bool {
    match $xs {
        ValNil { false }
        ValCons($h, $t) {
            if value_eq($h, $needle) { true } else { vlist_contains($t, $needle) }
        }
    }
}

sub vmap_keys_list($es: ValMapList): ValueList {
    match $es {
        ValMapNil { ValNil }
        ValMapCons($e, $rest) { ValCons(VStr($e.key), vmap_keys_list($rest)) }
    }
}

sub vmap_values_list($es: ValMapList): ValueList {
    match $es {
        ValMapNil { ValNil }
        ValMapCons($e, $rest) { ValCons($e.value, vmap_values_list($rest)) }
    }
}

# Apply a §15.1/§15.2 query builtin to already-evaluated data-first arguments.
# `keys`/`values` walk the map in sorted-key order so they agree with display
# and with C's `sort.Strings` snapshot.
sub apply_collection_query($n: Str, $vals: ValueList, $env: Env): Result[EvalResult, Str] {
    $argc = vlist_len($vals)
    if $n == "count" {
        if $argc != 1 {
            Err(eval_err("count expects 1 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValNil) {
                    match $recv {
                        VList($xs) { Ok(flow(VInt(vlist_len($xs)), $env)) }
                        _ { Err(eval_err("count expects a List, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("count expects 1 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else if $n == "is_empty" {
        if $argc != 1 {
            Err(eval_err("is_empty expects 1 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValNil) {
                    match $recv {
                        VList($xs) { Ok(flow(VBool(vlist_len($xs) == 0), $env)) }
                        _ { Err(eval_err("is_empty expects a List, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("is_empty expects 1 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else if $n == "contains" {
        if $argc != 2 {
            Err(eval_err("contains expects 2 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValCons($needle, ValNil)) {
                    match $recv {
                        VList($xs) { Ok(flow(VBool(vlist_contains($xs, $needle)), $env)) }
                        _ { Err(eval_err("contains expects a List, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("contains expects 2 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else if $n == "has_key" {
        if $argc != 2 {
            Err(eval_err("has_key expects 2 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValCons($keyv, ValNil)) {
                    match $recv {
                        VMap($entries) {
                            match $keyv {
                                VStr($k) {
                                    match vmap_lookup($entries, $k) {
                                        Some($v) { Ok(flow(VBool(true), $env)) }
                                        None { Ok(flow(VBool(false), $env)) }
                                    }
                                }
                                _ { Err(eval_err("has_key expects a Str, got " ~ value_type_name($keyv))) }
                            }
                        }
                        _ { Err(eval_err("has_key expects a Map, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("has_key expects 2 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else if $n == "keys" {
        if $argc != 1 {
            Err(eval_err("keys expects 1 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValNil) {
                    match $recv {
                        VMap($entries) { Ok(flow(VList(vmap_keys_list(vmap_sort($entries))), $env)) }
                        _ { Err(eval_err("keys expects a Map, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("keys expects 1 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else if $n == "values" {
        if $argc != 1 {
            Err(eval_err("values expects 1 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValNil) {
                    match $recv {
                        VMap($entries) { Ok(flow(VList(vmap_values_list(vmap_sort($entries))), $env)) }
                        _ { Err(eval_err("values expects a Map, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("values expects 1 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else if $n == "get" {
        if $argc != 2 {
            Err(eval_err("get expects 2 argument(s), got " ~ "{ $argc }"))
        } else {
            match $vals {
                ValCons($recv, ValCons($idx, ValNil)) {
                    match $recv {
                        VList($xs) {
                            match $idx {
                                VInt($i) {
                                    match vlist_index($xs, $i) {
                                        Some($v) { Ok(flow(option_some_val($v), $env)) }
                                        None { Ok(flow(option_none_val(), $env)) }
                                    }
                                }
                                _ { Err(eval_err("get expects an Int, got " ~ value_type_name($idx))) }
                            }
                        }
                        VMap($entries) {
                            match $idx {
                                VStr($k) {
                                    match vmap_lookup($entries, $k) {
                                        Some($v) { Ok(flow(option_some_val($v), $env)) }
                                        None { Ok(flow(option_none_val(), $env)) }
                                    }
                                }
                                _ { Err(eval_err("get expects a Str, got " ~ value_type_name($idx))) }
                            }
                        }
                        _ { Err(eval_err("get expects a List or Map, got " ~ value_type_name($recv))) }
                    }
                }
                _ { Err(eval_err("get expects 2 argument(s), got " ~ "{ $argc }")) }
            }
        }
    } else {
        Err(eval_err("undefined function: " ~ $n))
    }
}

sub eval_collection_query_call($n: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { apply_collection_query($n, $ar.values, $ar.env) }
            }
        }
    }
}

sub eval_collection_query_ufcs($n: Str, $recv: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { apply_collection_query($n, ValCons($recv, $ar.values), $ar.env) }
            }
        }
    }
}

# Convert a host List[Str] from split/lines into the evaluator's recursive list.
# The caller has already evaluated and typechecked the source operation.
sub value_list_from_strs(@xs: List[Str], $i: Int): ValueList {
    if $i >= @xs.count() {
        ValNil
    } else {
        ValCons(VStr(@xs[$i]), value_list_from_strs(@xs, $i + 1))
    }
}

# §15.1 join(@xs, $sep): concatenate List[Str] with $sep between elements.
# Empty list → ""; mirrors C's guji_str_cat accumulator (no leading sep).
sub vlist_join($xs: ValueList, $sep: Str, $acc: Str, $first: Bool): Result[Str, Str] {
    match $xs {
        ValNil { Ok($acc) }
        ValCons($h, $t) {
            match $h {
                VStr($s) {
                    if $first {
                        vlist_join($t, $sep, $s, false)
                    } else {
                        vlist_join($t, $sep, $acc ~ $sep ~ $s, false)
                    }
                }
                _ { Err(eval_err("join expects List[Str], got element " ~ value_type_name($h))) }
            }
        }
    }
}

# Apply §15.5 extraction to already-evaluated arguments. Option and Result use
# the evaluator's ordinary VVariant representation, so payload identity and
# nested values are preserved without a second carrier representation.
sub apply_carrier_extract($n: Str, $vals: ValueList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $n == "unwrap" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValNil) {
                match $fields {
                    ValCons($v, ValNil) {
                        if $tag == "Some" || $tag == "Ok" {
                            Ok(flow($v, $env))
                        } else if $tag == "Err" {
                            Err(eval_err("unwrap on Err(" ~ display_value($v) ~ ")"))
                        } else {
                            Err(eval_err("unwrap expects Option or Result"))
                        }
                    }
                    ValNil {
                        if $tag == "None" {
                            Err(eval_err("unwrap on None"))
                        } else {
                            Err(eval_err("unwrap expects Option or Result"))
                        }
                    }
                    _ { Err(eval_err("unwrap expects Option or Result")) }
                }
            }
            _ { Err(eval_err("unwrap expects 1 argument")) }
        }
    } else if $n == "expect" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons(VStr($msg), ValNil)) {
                match $fields {
                    ValCons($v, ValNil) {
                        if $tag == "Some" || $tag == "Ok" { Ok(flow($v, $env)) }
                        else if $tag == "Err" { Err(eval_err($msg)) }
                        else { Err(eval_err("expect expects Option or Result")) }
                    }
                    ValNil {
                        if $tag == "None" { Err(eval_err($msg)) }
                        else { Err(eval_err("expect expects Option or Result")) }
                    }
                    _ { Err(eval_err("expect expects Option or Result")) }
                }
            }
            _ { Err(eval_err("expect expects a carrier and Str message")) }
        }
    } else if $n == "unwrap_or" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($dflt, ValNil)) {
                match $fields {
                    ValCons($v, ValNil) {
                        if $tag == "Some" || $tag == "Ok" { Ok(flow($v, $env)) }
                        else if $tag == "Err" { Ok(flow($dflt, $env)) }
                        else { Err(eval_err("unwrap_or expects Option or Result")) }
                    }
                    ValNil {
                        if $tag == "None" { Ok(flow($dflt, $env)) }
                        else { Err(eval_err("unwrap_or expects Option or Result")) }
                    }
                    _ { Err(eval_err("unwrap_or expects Option or Result")) }
                }
            }
            _ { Err(eval_err("unwrap_or expects a carrier and default")) }
        }
    } else {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($fn, ValNil)) {
                match $fields {
                    ValCons($v, ValNil) {
                        if $tag == "Some" || $tag == "Ok" {
                            Ok(flow($v, $env))
                        } else if $tag == "Err" {
                            match call_list_hof_fn($fn, ValCons($v, ValNil), $subs) {
                                Err($e) { Err($e) }
                                Ok($out) { Ok(flow($out, $env)) }
                            }
                        } else {
                            Err(eval_err("unwrap_or_else expects Option or Result"))
                        }
                    }
                    ValNil {
                        if $tag == "None" {
                            match call_list_hof_fn($fn, ValNil, $subs) {
                                Err($e) { Err($e) }
                                Ok($out) { Ok(flow($out, $env)) }
                            }
                        } else {
                            Err(eval_err("unwrap_or_else expects Option or Result"))
                        }
                    }
                    _ { Err(eval_err("unwrap_or_else expects Option or Result")) }
                }
            }
            _ { Err(eval_err("unwrap_or_else expects a carrier and function")) }
        }
    }
}

# §15.5 Option/Result map over an already-matched carrier tag+fields. Some/Ok
# apply `$fn` once; None/Err propagate unchanged. Shared by List-named `map`
# when the receiver is a carrier rather than a List.
sub apply_carrier_map($tag: Str, $fields: ValueList, $fn: Value, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $tag == "Some" || $tag == "Ok" {
        match $fields {
            ValCons($v, ValNil) {
                match call_list_hof_fn($fn, ValCons($v, ValNil), $subs) {
                    Err($e) { Err($e) }
                    Ok($out) {
                        if $tag == "Some" {
                            Ok(flow(VVariant("Some", ValCons($out, ValNil), ""), $env))
                        } else {
                            Ok(flow(VVariant("Ok", ValCons($out, ValNil), ""), $env))
                        }
                    }
                }
            }
            _ { Err(eval_err("map expects Option or Result")) }
        }
    } else if $tag == "None" || $tag == "Err" {
        Ok(flow(VVariant($tag, $fields, ""), $env))
    } else {
        Err(eval_err("map expects a List, Option, or Result"))
    }
}

# §15.5 Option filter (I6g). Keep Some only when `$pred` is true; None never
# invokes the predicate. Result is Option[T] — same payload, not a mapped U.
# Shares List-named `filter` and dispatches by receiver kind like carrier map.
sub apply_carrier_filter($tag: Str, $fields: ValueList, $fn: Value, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $tag == "Some" {
        match $fields {
            ValCons($v, ValNil) {
                match call_list_hof_fn($fn, ValCons($v, ValNil), $subs) {
                    Err($e) { Err($e) }
                    Ok($out) {
                        match $out {
                            VBool($keep) {
                                if $keep {
                                    Ok(flow(VVariant("Some", ValCons($v, ValNil), ""), $env))
                                } else {
                                    Ok(flow(option_none_val(), $env))
                                }
                            }
                            _ { Err(eval_err("filter predicate must return Bool")) }
                        }
                    }
                }
            }
            _ { Err(eval_err("filter expects Option")) }
        }
    } else if $tag == "None" {
        Ok(flow(option_none_val(), $env))
    } else {
        Err(eval_err("filter expects Option"))
    }
}

# §17.3 scalar channel operations. Guest Result/Option values must stay in the
# evaluator's Value model; the host channel carriers are unwrapped immediately.
# This helper receives already-evaluated arguments through the existing mutation
# apply edge, preserving left-to-right/single-evaluation behavior without adding
# another eval_args cycle on the bootstrap-critical call path.
sub eval_channel_closed_result($ok: Bool): Value {
    if $ok {
        VVariant("Ok", ValCons(VUnit, ValNil), "")
    } else {
        VVariant("Err", ValCons(VVariant("Closed", ValNil, ""), ValNil), "")
    }
}

sub eval_channel_recv_unit($ch: Chan[Unit], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(VVariant("Some", ValCons(VUnit, ValNil), ""), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub eval_channel_recv_int($ch: Chan[Int], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(VVariant("Some", ValCons(VInt($got.unwrap()), ValNil), ""), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub eval_channel_recv_bool($ch: Chan[Bool], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(VVariant("Some", ValCons(VBool($got.unwrap()), ValNil), ""), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub eval_channel_recv_float($ch: Chan[Float], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(VVariant("Some", ValCons(VFloat($got.unwrap()), ValNil), ""), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub eval_channel_recv_str($ch: Chan[Str], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(VVariant("Some", ValCons(VStr($got.unwrap()), ValNil), ""), $env))
    }
    Ok(flow(option_none_val(), $env))
}

# ---- I10c2b collection/enum channel wire helpers ----

sub wire_from_vlist_int($xs: ValueList): Result[WireIntList, Str] {
    match $xs {
        ValNil { Ok(WILNil) }
        ValCons($h, $t) {
            match $h {
                VInt($n) {
                    match wire_from_vlist_int($t) {
                        Err($e) { Err($e) }
                        Ok($w) { Ok(WILCons($n, $w)) }
                    }
                }
                _ { Err(eval_err("send expects List[Int]")) }
            }
        }
    }
}

sub vlist_from_wire_int($w: WireIntList): ValueList {
    match $w {
        WILNil { ValNil }
        WILCons($n, $t) { ValCons(VInt($n), vlist_from_wire_int($t)) }
    }
}

sub wire_from_vmap_str($es: ValMapList): Result[WireStrMap, Str] {
    match $es {
        ValMapNil { Ok(WSMNil) }
        ValMapCons($e, $rest) {
            match $e.value {
                VStr($v) {
                    match wire_from_vmap_str($rest) {
                        Err($err) { Err($err) }
                        Ok($w) { Ok(WSMCons($e.key, $v, $w)) }
                    }
                }
                _ { Err(eval_err("send expects Map[Str, Str]")) }
            }
        }
    }
}

sub vmap_from_wire_str($w: WireStrMap, $acc: ValMapList): ValMapList {
    match $w {
        WSMNil { $acc }
        WSMCons($k, $v, $t) {
            vmap_from_wire_str($t, ValMapCons(ValMapEntry(key: $k, value: VStr($v)), $acc))
        }
    }
}

sub wire_scalar_from_value($v: Value): Result[WireEnum, Str] {
    match $v {
        VInt($n) { Ok(WEWireInt($n)) }
        VStr($s) { Ok(WEWireStr($s)) }
        VBool($b) { Ok(WEWireBool($b)) }
        VFloat($f) { Ok(WEWireFloat($f)) }
        VList($xs) { wire_scalar_list_from_values($xs) }
        VMap($es) { wire_scalar_map_from_values($es) }
        _ { Err(eval_err("channel carrier collection value must contain scalar, Str, List, or Map")) }
    }
}

sub value_from_wire_scalar($w: WireEnum): Value {
    match $w {
        WEWireInt($n) { VInt($n) }
        WEWireStr($s) { VStr($s) }
        WEWireBool($b) { VBool($b) }
        WEWireFloat($f) { VFloat($f) }
        WEWireListNil { VList(ValNil) }
        WEWireListCons($h, $t) { VList(values_from_wire_scalar_list($w)) }
        WEWireMapNil { VMap(ValMapNil) }
        WEWireMapCons($k, $v, $t) { VMap(values_from_wire_scalar_map($w, ValMapNil)) }
        _ { VUnit }
    }
}

sub wire_scalar_list_from_values($xs: ValueList): Result[WireEnum, Str] {
    match $xs {
        ValNil { Ok(WEWireListNil) }
        ValCons($h, $t) {
            match wire_scalar_from_value($h) {
                Err($e) { Err($e) }
                Ok($wh) {
                    match wire_scalar_list_from_values($t) {
                        Err($e) { Err($e) }
                        Ok($wt) { Ok(WEWireListCons($wh, $wt)) }
                    }
                }
            }
        }
    }
}

sub values_from_wire_scalar_list($w: WireEnum): ValueList {
    match $w {
        WEWireListNil { ValNil }
        WEWireListCons($h, $t) {
            ValCons(value_from_wire_scalar($h), values_from_wire_scalar_list($t))
        }
        _ { ValNil }
    }
}

sub wire_scalar_map_from_values($es: ValMapList): Result[WireEnum, Str] {
    match $es {
        ValMapNil { Ok(WEWireMapNil) }
        ValMapCons($e, $rest) {
            match wire_scalar_from_value($e.value) {
                Err($err) { Err($err) }
                Ok($wv) {
                    match wire_scalar_map_from_values($rest) {
                        Err($err) { Err($err) }
                        Ok($wt) { Ok(WEWireMapCons($e.key, $wv, $wt)) }
                    }
                }
            }
        }
    }
}

sub values_from_wire_scalar_map($w: WireEnum, $acc: ValMapList): ValMapList {
    match $w {
        WEWireMapNil { $acc }
        WEWireMapCons($k, $v, $t) {
            values_from_wire_scalar_map(
                $t,
                ValMapCons(ValMapEntry(key: $k, value: value_from_wire_scalar($v)), $acc)
            )
        }
        _ { $acc }
    }
}

# I10g4: StrList ↔ WEWireListCons(WEWireStr, …) for Match capture names.
sub wire_strlist_from_names($ns: StrList): WireEnum {
    match $ns {
        StrNil { WEWireListNil }
        StrCons($h, $t) { WEWireListCons(WEWireStr($h), wire_strlist_from_names($t)) }
    }
}

sub names_from_wire_strlist($w: WireEnum): StrList {
    match $w {
        WEWireListNil { StrNil }
        WEWireListCons($h, $t) {
            match $h {
                WEWireStr($s) { StrCons($s, names_from_wire_strlist($t)) }
                _ { names_from_wire_strlist($t) }
            }
        }
        _ { StrNil }
    }
}

# Match groups are Option[Str] VVariants; reuse the ordinary carrier wire.
sub wire_match_groups_from_values($xs: ValueList): Result[WireEnum, Str] {
    match $xs {
        ValNil { Ok(WEWireListNil) }
        ValCons($h, $t) {
            match $h {
                VVariant($tag, $fields, $eid) {
                    match wire_from_vvariant($tag, $fields, $eid) {
                        Err($e) { Err($e) }
                        Ok($wh) {
                            match wire_match_groups_from_values($t) {
                                Err($e) { Err($e) }
                                Ok($wt) { Ok(WEWireListCons($wh, $wt)) }
                            }
                        }
                    }
                }
                _ { Err(eval_err("channel Match group must be Option[Str]")) }
            }
        }
    }
}

sub match_groups_from_wire($w: WireEnum): ValueList {
    match $w {
        WEWireListNil { ValNil }
        WEWireListCons($h, $t) {
            ValCons(vvariant_from_wire($h), match_groups_from_wire($t))
        }
        _ { ValNil }
    }
}

sub wire_bush_val_from_value($v: Value): Result[WireEnum, Str] {
    match $v {
        VBush($name, $text, $caps) {
            match wire_bush_caps_from_values($caps) {
                Err($e) { Err($e) }
                Ok($wc) { Ok(WEBushVal($name, $text, $wc)) }
            }
        }
        _ { Err(eval_err("channel Bush child must be a Bush value")) }
    }
}

sub wire_bush_caps_from_values($xs: ValueList): Result[WireEnum, Str] {
    match $xs {
        ValNil { Ok(WEWireListNil) }
        ValCons($h, $t) {
            match wire_bush_val_from_value($h) {
                Err($e) { Err($e) }
                Ok($wh) {
                    match wire_bush_caps_from_values($t) {
                        Err($e) { Err($e) }
                        Ok($wt) { Ok(WEWireListCons($wh, $wt)) }
                    }
                }
            }
        }
    }
}

sub bush_caps_from_wire($w: WireEnum): ValueList {
    match $w {
        WEWireListNil { ValNil }
        WEWireListCons($h, $t) {
            ValCons(value_from_wire_bush_node($h), bush_caps_from_wire($t))
        }
        _ { ValNil }
    }
}

sub value_from_wire_bush_node($w: WireEnum): Value {
    match $w {
        WEBushVal($name, $text, $caps) { VBush($name, $text, bush_caps_from_wire($caps)) }
        _ { VUnit }
    }
}

sub wire_match_from_value($tag: Str, $eid: Str, $text: Str, $names: StrList, $groups: ValueList): Result[WireEnum, Str] {
    match wire_match_groups_from_values($groups) {
        Err($e) { Err($e) }
        Ok($wg) { Ok(WEMatch($tag, $eid, $text, wire_strlist_from_names($names), $wg)) }
    }
}

sub wire_bush_from_value($tag: Str, $eid: Str, $name: Str, $text: Str, $caps: ValueList): Result[WireEnum, Str] {
    match wire_bush_caps_from_values($caps) {
        Err($e) { Err($e) }
        Ok($wc) { Ok(WEBush($tag, $eid, $name, $text, $wc)) }
    }
}

# I10g5b: values that can ride a function-channel Env snapshot. Channels,
# handles, ranges, and Unit are omitted — D's creation-time Env is fatter than
# C's free-var capture set, and those slots are never readable captures.
sub cap_env_value_supported($v: Value): Bool {
    match $v {
        VInt($n) { true }
        VFloat($f) { true }
        VStr($s) { true }
        VBool($b) { true }
        VUnit { true }
        VList($xs) { true }
        VMap($es) { true }
        VVariant($tag, $fields, $eid) { true }
        VInstance($cls, $fields) { true }
        VFunction($key, $caps) { true }
        VRegex($p, $private) { true }
        VMatch($text, $names, $groups) { true }
        VBush($name, $text, $caps) { true }
        _ { false }
    }
}

sub wire_from_vinstance($cls: Str, $fields: ValMapList): Result[WireEnum, Str] {
    match wire_instance_fields($fields) {
        Err($e) { Err($e) }
        Ok($w) { Ok(WEInstance($cls, $w)) }
    }
}

sub wire_instance_fields($fields: ValMapList): Result[WireEnum, Str] {
    match $fields {
        ValMapNil { Ok(WEWireMapNil) }
        ValMapCons($e, $rest) {
            match wire_cap_value($e.value) {
                Err($err) { Err($err) }
                Ok($wv) {
                    match wire_instance_fields($rest) {
                        Err($err) { Err($err) }
                        Ok($wt) { Ok(WEWireMapCons($e.key, $wv, $wt)) }
                    }
                }
            }
        }
    }
}

sub instance_fields_from_wire($w: WireEnum, $acc: ValMapList): ValMapList {
    match $w {
        WEWireMapNil { $acc }
        WEWireMapCons($k, $v, $t) {
            instance_fields_from_wire(
                $t,
                ValMapCons(ValMapEntry(key: $k, value: value_from_cap_wire($v)), $acc)
            )
        }
        _ { $acc }
    }
}

sub wire_cap_value($v: Value): Result[WireEnum, Str] {
    match $v {
        VInt($n) { Ok(WEWireInt($n)) }
        VStr($s) { Ok(WEWireStr($s)) }
        VBool($b) { Ok(WEWireBool($b)) }
        VFloat($f) { Ok(WEWireFloat($f)) }
        VUnit { Ok(WEWireUnit) }
        VList($xs) { wire_scalar_list_from_values($xs) }
        VMap($es) { wire_scalar_map_from_values($es) }
        VVariant($tag, $fields, $eid) { wire_from_vvariant($tag, $fields, $eid) }
        VInstance($cls, $fields) { wire_from_vinstance($cls, $fields) }
        VFunction($key, $caps) { wire_from_vfunction($key, $caps) }
        VRegex($p, $private) { Ok(WERegex("", "", $p, $private)) }
        VMatch($text, $names, $groups) {
            wire_match_from_value("", "", $text, $names, $groups)
        }
        VBush($name, $text, $caps) {
            wire_bush_from_value("", "", $name, $text, $caps)
        }
        _ { Err(eval_err("channel function capture value is not supported")) }
    }
}

sub value_from_cap_wire($w: WireEnum): Value {
    match $w {
        WEFunction($key, $caps) { VFunction($key, env_from_wire($caps)) }
        WEInstance($cls, $fields) {
            VInstance($cls, instance_fields_from_wire($fields, ValMapNil))
        }
        WERegex($tag, $eid, $p, $private) {
            if $tag == "" && $eid == "" {
                VRegex($p, $private)
            } else {
                vvariant_from_wire($w)
            }
        }
        WEMatch($tag, $eid, $text, $names, $groups) {
            if $tag == "" && $eid == "" {
                VMatch($text, names_from_wire_strlist($names), match_groups_from_wire($groups))
            } else {
                vvariant_from_wire($w)
            }
        }
        WEBush($tag, $eid, $name, $text, $caps) {
            if $tag == "" && $eid == "" {
                VBush($name, $text, bush_caps_from_wire($caps))
            } else {
                vvariant_from_wire($w)
            }
        }
        WEBushVal($name, $text, $caps) { VBush($name, $text, bush_caps_from_wire($caps)) }
        WEWireInt($n) { VInt($n) }
        WEWireStr($s) { VStr($s) }
        WEWireBool($b) { VBool($b) }
        WEWireFloat($f) { VFloat($f) }
        WEWireUnit { VUnit }
        WEWireListNil { VList(ValNil) }
        WEWireListCons($h, $t) { VList(values_from_wire_scalar_list($w)) }
        WEWireMapNil { VMap(ValMapNil) }
        WEWireMapCons($k, $v, $t) { VMap(values_from_wire_scalar_map($w, ValMapNil)) }
        _ { vvariant_from_wire($w) }
    }
}

sub wire_from_bindings($binds: Bindings): Result[WireEnum, Str] {
    match $binds {
        BindNil { Ok(WEBindNil) }
        BindCons($name, $mutable, $value, $tail) {
            if $mutable {
                wire_from_bindings($tail)
            } else if !cap_env_value_supported($value) {
                wire_from_bindings($tail)
            } else {
                match wire_cap_value($value) {
                    Err($e) { Err($e) }
                    Ok($wv) {
                        match wire_from_bindings($tail) {
                            Err($e) { Err($e) }
                            Ok($wt) { Ok(WEBindCons($name, false, $wv, $wt)) }
                        }
                    }
                }
            }
        }
    }
}

sub bindings_from_wire($w: WireEnum): Bindings {
    match $w {
        WEBindNil { BindNil }
        WEBindCons($name, $mutable, $value, $tail) {
            BindCons($name, $mutable, value_from_cap_wire($value), bindings_from_wire($tail))
        }
        _ { BindNil }
    }
}

sub wire_from_env($env: Env): Result[WireEnum, Str] {
    match $env {
        EnvNil { Ok(WEEnvNil) }
        EnvFrame($binds, $parent) {
            match wire_from_bindings($binds) {
                Err($e) { Err($e) }
                Ok($wb) {
                    match wire_from_env($parent) {
                        Err($e) { Err($e) }
                        Ok($wp) { Ok(WEEnvFrame($wb, $wp)) }
                    }
                }
            }
        }
    }
}

sub env_from_wire($w: WireEnum): Env {
    match $w {
        WEEnvNil { EnvNil }
        WEEnvFrame($binds, $parent) {
            EnvFrame(bindings_from_wire($binds), env_from_wire($parent))
        }
        _ { EnvNil }
    }
}

sub wire_from_vfunction($key: Str, $caps: Env): Result[WireEnum, Str] {
    match wire_from_env($caps) {
        Err($e) { Err($e) }
        Ok($w) { Ok(WEFunction($key, $w)) }
    }
}

# I10g3b: one enum field may be a scalar/collection wire node or a nested
# guest variant (recursive SELF-box). Reuses the existing WEWire* spines.
# I10g4 also admits bare Match/Bush/Regex nodes inside WEFields spines.
sub wire_field_from_value($v: Value): Result[WireEnum, Str] {
    match $v {
        VVariant($tag, $fields, $eid) { wire_from_vvariant($tag, $fields, $eid) }
        VMatch($text, $names, $groups) {
            match wire_match_groups_from_values($groups) {
                Err($e) { Err($e) }
                Ok($wg) { Ok(WEMatch("", "", $text, wire_strlist_from_names($names), $wg)) }
            }
        }
        VBush($name, $text, $caps) { wire_bush_val_from_value(VBush($name, $text, $caps)) }
        VRegex($p, $private) { Ok(WERegex("", "", $p, $private)) }
        VFunction($key, $caps) { wire_from_vfunction($key, $caps) }
        VInstance($cls, $fields) { wire_from_vinstance($cls, $fields) }
        VUnit { Ok(WEWireUnit) }
        _ { wire_scalar_from_value($v) }
    }
}

sub wire_fields_from_values($xs: ValueList): Result[WireEnum, Str] {
    match $xs {
        ValNil { Ok(WEWireListNil) }
        ValCons($h, $t) {
            match wire_field_from_value($h) {
                Err($e) { Err($e) }
                Ok($wh) {
                    match wire_fields_from_values($t) {
                        Err($e) { Err($e) }
                        Ok($wt) { Ok(WEWireListCons($wh, $wt)) }
                    }
                }
            }
        }
    }
}

sub wire_from_vvariant($tag: Str, $fields: ValueList, $eid: Str): Result[WireEnum, Str] {
    match $fields {
        ValNil { Ok(WENullary($tag, $eid)) }
        ValCons($h, ValNil) {
            match $h {
                VInt($n) { Ok(WEInt($tag, $eid, $n)) }
                VStr($s) { Ok(WEStr($tag, $eid, $s)) }
                VBool($b) { Ok(WEBool($tag, $eid, $b)) }
                VFloat($f) { Ok(WEFloat($tag, $eid, $f)) }
                VUnit {
                    Ok(WEFields($tag, $eid, WEWireListCons(WEWireUnit, WEWireListNil)))
                }
                VRegex($p, $private) { Ok(WERegex($tag, $eid, $p, $private)) }
                VMatch($text, $names, $groups) {
                    wire_match_from_value($tag, $eid, $text, $names, $groups)
                }
                VBush($name, $text, $caps) {
                    wire_bush_from_value($tag, $eid, $name, $text, $caps)
                }
                VList($xs) {
                    match wire_scalar_list_from_values($xs) {
                        Err($e) { Err($e) }
                        Ok($w) { Ok(WEList($tag, $eid, $w)) }
                    }
                }
                VMap($es) {
                    match wire_scalar_map_from_values($es) {
                        Err($e) { Err($e) }
                        Ok($w) { Ok(WEMap($tag, $eid, $w)) }
                    }
                }
                VVariant($t2, $f2, $e2) {
                    match wire_from_vvariant($t2, $f2, $e2) {
                        Err($e) { Err($e) }
                        Ok($w) { Ok(WEFields($tag, $eid, WEWireListCons($w, WEWireListNil))) }
                    }
                }
                VFunction($key, $caps) {
                    match wire_from_vfunction($key, $caps) {
                        Err($e) { Err($e) }
                        Ok($w) { Ok(WEFields($tag, $eid, WEWireListCons($w, WEWireListNil))) }
                    }
                }
                VInstance($cls, $fs) {
                    match wire_from_vinstance($cls, $fs) {
                        Err($e) { Err($e) }
                        Ok($w) { Ok(WEFields($tag, $eid, WEWireListCons($w, WEWireListNil))) }
                    }
                }
                _ { Err(eval_err("channel enum payload must be scalar, Str, List, Map, Match, Bush, Regex, function, class, or nested enum")) }
            }
        }
        _ {
            match wire_fields_from_values($fields) {
                Err($e) { Err($e) }
                Ok($xs) { Ok(WEFields($tag, $eid, $xs)) }
            }
        }
    }
}

sub value_from_wire_field($w: WireEnum): Value {
    match $w {
        WEMatch($tag, $eid, $text, $names, $groups) {
            if $tag == "" && $eid == "" {
                VMatch($text, names_from_wire_strlist($names), match_groups_from_wire($groups))
            } else {
                VVariant(
                    $tag,
                    ValCons(VMatch($text, names_from_wire_strlist($names), match_groups_from_wire($groups)), ValNil),
                    $eid
                )
            }
        }
        WEBushVal($name, $text, $caps) { VBush($name, $text, bush_caps_from_wire($caps)) }
        WERegex($tag, $eid, $p, $private) {
            if $tag == "" && $eid == "" {
                VRegex($p, $private)
            } else {
                VVariant($tag, ValCons(VRegex($p, $private), ValNil), $eid)
            }
        }
        _ { vvariant_from_wire($w) }
    }
}

sub values_from_wire_fields($w: WireEnum): ValueList {
    match $w {
        WEWireListNil { ValNil }
        WEWireListCons($h, $t) {
            ValCons(value_from_wire_field($h), values_from_wire_fields($t))
        }
        _ { ValNil }
    }
}

sub vvariant_from_wire($w: WireEnum): Value {
    match $w {
        WENullary($tag, $eid) { VVariant($tag, ValNil, $eid) }
        WEInt($tag, $eid, $n) { VVariant($tag, ValCons(VInt($n), ValNil), $eid) }
        WEStr($tag, $eid, $s) { VVariant($tag, ValCons(VStr($s), ValNil), $eid) }
        WEBool($tag, $eid, $b) { VVariant($tag, ValCons(VBool($b), ValNil), $eid) }
        WEFloat($tag, $eid, $f) { VVariant($tag, ValCons(VFloat($f), ValNil), $eid) }
        WERegex($tag, $eid, $p, $private) { VVariant($tag, ValCons(VRegex($p, $private), ValNil), $eid) }
        WEMatch($tag, $eid, $text, $names, $groups) {
            VVariant(
                $tag,
                ValCons(VMatch($text, names_from_wire_strlist($names), match_groups_from_wire($groups)), ValNil),
                $eid
            )
        }
        WEBush($tag, $eid, $name, $text, $caps) {
            VVariant(
                $tag,
                ValCons(VBush($name, $text, bush_caps_from_wire($caps)), ValNil),
                $eid
            )
        }
        WEBushVal($name, $text, $caps) { VBush($name, $text, bush_caps_from_wire($caps)) }
        WEList($tag, $eid, $xs) {
            VVariant($tag, ValCons(VList(values_from_wire_scalar_list($xs)), ValNil), $eid)
        }
        WEMap($tag, $eid, $es) {
            VVariant($tag, ValCons(VMap(values_from_wire_scalar_map($es, ValMapNil)), ValNil), $eid)
        }
        WEFields($tag, $eid, $xs) {
            VVariant($tag, values_from_wire_fields($xs), $eid)
        }
        WEFunction($key, $caps) { VFunction($key, env_from_wire($caps)) }
        WEInstance($cls, $fields) {
            VInstance($cls, instance_fields_from_wire($fields, ValMapNil))
        }
        WEEnvNil { VUnit }
        WEEnvFrame($binds, $parent) { VUnit }
        WEBindNil { VUnit }
        WEBindCons($name, $mutable, $value, $tail) { VUnit }
        # Internal collection-node variants are never top-level channel
        # messages. Keep this match exhaustive without exposing them as guest
        # enum values if malformed internal data reaches the boundary.
        WEWireInt($n) { VInt($n) }
        WEWireStr($s) { VStr($s) }
        WEWireBool($b) { VBool($b) }
        WEWireFloat($f) { VFloat($f) }
        WEWireUnit { VUnit }
        WEWireListNil { VList(ValNil) }
        WEWireListCons($h, $t) { VList(values_from_wire_scalar_list($w)) }
        WEWireMapNil { VMap(ValMapNil) }
        WEWireMapCons($k, $v, $t) { VMap(values_from_wire_scalar_map($w, ValMapNil)) }
    }
}

sub eval_channel_send_list_int($ch: Chan[WireIntList], $xs: ValueList, $env: Env): Result[EvalResult, Str] {
    match wire_from_vlist_int($xs) {
        Err($e) { Err($e) }
        Ok($w) { Ok(flow(eval_channel_closed_result($ch.send($w).is_ok()), $env)) }
    }
}

sub eval_channel_recv_list_int($ch: Chan[WireIntList], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(option_some_val(VList(vlist_from_wire_int($got.unwrap()))), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub eval_channel_send_map_str($ch: Chan[WireStrMap], $es: ValMapList, $env: Env): Result[EvalResult, Str] {
    match wire_from_vmap_str($es) {
        Err($e) { Err($e) }
        Ok($w) { Ok(flow(eval_channel_closed_result($ch.send($w).is_ok()), $env)) }
    }
}

sub eval_channel_recv_map_str($ch: Chan[WireStrMap], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(option_some_val(VMap(vmap_from_wire_str($got.unwrap(), ValMapNil))), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub eval_channel_send_enum($ch: Chan[WireEnum], $tag: Str, $fields: ValueList, $eid: Str, $env: Env): Result[EvalResult, Str] {
    match wire_from_vvariant($tag, $fields, $eid) {
        Err($e) { Err($e) }
        Ok($w) { Ok(flow(eval_channel_closed_result($ch.send($w).is_ok()), $env)) }
    }
}

# I10g5b: detach VFunction(key,caps) into WEFunction before host send.
sub eval_channel_send_fn($ch: Chan[WireEnum], $key: Str, $caps: Env, $env: Env): Result[EvalResult, Str] {
    match wire_from_vfunction($key, $caps) {
        Err($e) { Err($e) }
        Ok($w) { Ok(flow(eval_channel_closed_result($ch.send($w).is_ok()), $env)) }
    }
}

# I10g3: direct nested List/Map channel payloads reuse the recursive WireEnum
# collection nodes (same encoding as Option/Result carriers). Recv still goes
# through vvariant_from_wire, which reconstitutes WEWire* spines as VList/VMap.
sub eval_channel_send_wire_coll($ch: Chan[WireEnum], $v: Value, $env: Env): Result[EvalResult, Str] {
    match wire_scalar_from_value($v) {
        Err($e) { Err($e) }
        Ok($w) { Ok(flow(eval_channel_closed_result($ch.send($w).is_ok()), $env)) }
    }
}

sub eval_channel_recv_enum($ch: Chan[WireEnum], $env: Env): Result[EvalResult, Str] {
    $got = $ch.recv()
    if $got.is_some() {
        return Ok(flow(option_some_val(vvariant_from_wire($got.unwrap())), $env))
    }
    Ok(flow(option_none_val(), $env))
}

sub apply_channel_op($n: Str, $vals: ValueList, $env: Env): Result[EvalResult, Str] {
    if $n == "send" {
        match $vals {
            ValCons(VChanUnit($ch), ValCons(VUnit, ValNil)) { Ok(flow(eval_channel_closed_result($ch.send(()).is_ok()), $env)) }
            ValCons(VChanInt($ch), ValCons(VInt($v), ValNil)) { Ok(flow(eval_channel_closed_result($ch.send($v).is_ok()), $env)) }
            ValCons(VChanBool($ch), ValCons(VBool($v), ValNil)) { Ok(flow(eval_channel_closed_result($ch.send($v).is_ok()), $env)) }
            ValCons(VChanFloat($ch), ValCons(VFloat($v), ValNil)) { Ok(flow(eval_channel_closed_result($ch.send($v).is_ok()), $env)) }
            ValCons(VChanStr($ch), ValCons(VStr($v), ValNil)) { Ok(flow(eval_channel_closed_result($ch.send($v).is_ok()), $env)) }
            ValCons(VChanListInt($ch), ValCons(VList($xs), ValNil)) { eval_channel_send_list_int($ch, $xs, $env) }
            ValCons(VChanMapStr($ch), ValCons(VMap($es), ValNil)) { eval_channel_send_map_str($ch, $es, $env) }
            ValCons(VChanEnum($ch), ValCons(VVariant($tag, $fields, $eid), ValNil)) { eval_channel_send_enum($ch, $tag, $fields, $eid, $env) }
            ValCons(VChanEnum($ch), ValCons(VFunction($key, $caps), ValNil)) { eval_channel_send_fn($ch, $key, $caps, $env) }
            ValCons(VChanEnum($ch), ValCons(VList($xs), ValNil)) { eval_channel_send_wire_coll($ch, VList($xs), $env) }
            ValCons(VChanEnum($ch), ValCons(VMap($es), ValNil)) { eval_channel_send_wire_coll($ch, VMap($es), $env) }
            _ { Err(eval_err("send expects a channel and matching value")) }
        }
    } else if $n == "recv" {
        match $vals {
            ValCons(VChanUnit($ch), ValNil) { eval_channel_recv_unit($ch, $env) }
            ValCons(VChanInt($ch), ValNil) { eval_channel_recv_int($ch, $env) }
            ValCons(VChanBool($ch), ValNil) { eval_channel_recv_bool($ch, $env) }
            ValCons(VChanFloat($ch), ValNil) { eval_channel_recv_float($ch, $env) }
            ValCons(VChanStr($ch), ValNil) { eval_channel_recv_str($ch, $env) }
            ValCons(VChanListInt($ch), ValNil) { eval_channel_recv_list_int($ch, $env) }
            ValCons(VChanMapStr($ch), ValNil) { eval_channel_recv_map_str($ch, $env) }
            ValCons(VChanEnum($ch), ValNil) { eval_channel_recv_enum($ch, $env) }
            _ { Err(eval_err("recv expects one channel")) }
        }
    } else {
        match $vals {
            ValCons(VChanUnit($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanInt($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanBool($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanFloat($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanStr($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanListInt($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanMapStr($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            ValCons(VChanEnum($ch), ValNil) { Ok(flow(eval_channel_closed_result($ch.close().is_ok()), $env)) }
            _ { Err(eval_err("close expects one channel")) }
        }
    }
}

# §15.5 predicates, conversions, and flat-map combinators. Arguments are
# already evaluated; this makes ok_or's error eager even for Some. Conversions
# move the existing arbitrary Value payload without inspecting its shape.
# Callbacks reuse call_list_hof_fn so no second HOF walker is added.
sub apply_carrier_combinator($n: Str, $vals: ValueList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $n == "is_some" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValNil) {
                if $tag == "Some" { Ok(flow(VBool(true), $env)) }
                else if $tag == "None" { Ok(flow(VBool(false), $env)) }
                else { Err(eval_err("is_some expects Option")) }
            }
            _ { Err(eval_err("is_some expects 1 Option argument")) }
        }
    } else if $n == "is_none" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValNil) {
                if $tag == "None" { Ok(flow(VBool(true), $env)) }
                else if $tag == "Some" { Ok(flow(VBool(false), $env)) }
                else { Err(eval_err("is_none expects Option")) }
            }
            _ { Err(eval_err("is_none expects 1 Option argument")) }
        }
    } else if $n == "is_ok" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValNil) {
                if $tag == "Ok" { Ok(flow(VBool(true), $env)) }
                else if $tag == "Err" { Ok(flow(VBool(false), $env)) }
                else { Err(eval_err("is_ok expects Result")) }
            }
            _ { Err(eval_err("is_ok expects 1 Result argument")) }
        }
    } else if $n == "is_err" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValNil) {
                if $tag == "Err" { Ok(flow(VBool(true), $env)) }
                else if $tag == "Ok" { Ok(flow(VBool(false), $env)) }
                else { Err(eval_err("is_err expects Result")) }
            }
            _ { Err(eval_err("is_err expects 1 Result argument")) }
        }
    } else if $n == "ok" || $n == "err" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValNil) {
                if ($n == "ok" && $tag == "Ok") || ($n == "err" && $tag == "Err") {
                    Ok(flow(VVariant("Some", $fields, ""), $env))
                } else if $tag == "Ok" || $tag == "Err" {
                    Ok(flow(option_none_val(), $env))
                } else {
                    Err(eval_err($n ~ " expects Result"))
                }
            }
            _ { Err(eval_err($n ~ " expects 1 Result argument")) }
        }
    } else if $n == "ok_or" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($err, ValNil)) {
                if $tag == "Some" {
                    Ok(flow(VVariant("Ok", $fields, ""), $env))
                } else if $tag == "None" {
                    Ok(flow(VVariant("Err", ValCons($err, ValNil), ""), $env))
                } else {
                    Err(eval_err("ok_or expects Option"))
                }
            }
            _ { Err(eval_err("ok_or expects an Option and error")) }
        }
    } else if $n == "map_err" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($fn, ValNil)) {
                if $tag == "Ok" {
                    Ok(flow(VVariant($tag, $fields, $eid), $env))
                } else if $tag == "Err" {
                    match $fields {
                        ValCons($v, ValNil) {
                            match call_list_hof_fn($fn, ValCons($v, ValNil), $subs) {
                                Err($e) { Err($e) }
                                Ok($out) { Ok(flow(VVariant("Err", ValCons($out, ValNil), ""), $env)) }
                            }
                        }
                        _ { Err(eval_err("map_err expects Result")) }
                    }
                } else {
                    Err(eval_err("map_err expects Result"))
                }
            }
            _ { Err(eval_err("map_err expects a Result and a function")) }
        }
    } else if $n == "and_then" {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($fn, ValNil)) {
                if $tag == "Some" || $tag == "Ok" {
                    match $fields {
                        ValCons($v, ValNil) {
                            match call_list_hof_fn($fn, ValCons($v, ValNil), $subs) {
                                Err($e) { Err($e) }
                                Ok($out) { Ok(flow($out, $env)) }
                            }
                        }
                        _ { Err(eval_err("and_then expects Option or Result")) }
                    }
                } else if $tag == "None" || $tag == "Err" {
                    Ok(flow(VVariant($tag, $fields, $eid), $env))
                } else {
                    Err(eval_err("and_then expects Option or Result"))
                }
            }
            _ { Err(eval_err("and_then expects a carrier and a function")) }
        }
    } else {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($fn, ValNil)) {
                if $tag == "Ok" {
                    Ok(flow(VVariant($tag, $fields, $eid), $env))
                } else if $tag == "Err" {
                    match $fields {
                        ValCons($v, ValNil) {
                            match call_list_hof_fn($fn, ValCons($v, ValNil), $subs) {
                                Err($e) { Err($e) }
                                Ok($out) { Ok(flow($out, $env)) }
                            }
                        }
                        _ { Err(eval_err("or_else expects Result")) }
                    }
                } else {
                    Err(eval_err("or_else expects Result"))
                }
            }
            _ { Err(eval_err("or_else expects a Result and a function")) }
        }
    }
}

# `set`/`remove` return fresh logical maps (immutable ValMapList may share tails).
# §15.3 string ops and §15.1 List HOFs also live here so they reuse this function's
# sole eval_args edge. Arms stay flat: nested argc/type ladders push bootstrap
# codegen over its stack budget (flaky gen1/gen3 SIGSEGV ~10s).
sub apply_collection_mutation($n: Str, $vals: ValueList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    $argc = vlist_len($vals)
    if $n == "set" {
        match $vals {
            ValCons(VMap($entries), ValCons(VStr($key), ValCons($value, ValNil))) {
                Ok(flow(VMap(vmap_put($entries, $key, $value)), $env))
            }
            _ { Err(eval_err("set expects Map, Str key, and value (got " ~ "{ $argc }" ~ " args)")) }
        }
    } else if $n == "remove" {
        match $vals {
            ValCons(VMap($entries), ValCons(VStr($key), ValNil)) {
                Ok(flow(VMap(vmap_remove($entries, $key)), $env))
            }
            _ { Err(eval_err("remove expects Map and Str key (got " ~ "{ $argc }" ~ " args)")) }
        }
    } else if $n == "trim" {
        match $vals {
            ValCons(VStr($s), ValNil) { Ok(flow(VStr(trim($s)), $env)) }
            _ { Err(eval_err("trim expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "upper" {
        match $vals {
            ValCons(VStr($s), ValNil) { Ok(flow(VStr(upper($s)), $env)) }
            _ { Err(eval_err("upper expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "lower" {
        match $vals {
            ValCons(VStr($s), ValNil) { Ok(flow(VStr(lower($s)), $env)) }
            _ { Err(eval_err("lower expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "split" {
        match $vals {
            ValCons(VStr($s), ValCons(VStr($sep), ValNil)) {
                Ok(flow(VList(value_list_from_strs(split($s, $sep), 0)), $env))
            }
            _ { Err(eval_err("split expects 2 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "lines" {
        match $vals {
            ValCons(VStr($s), ValNil) {
                Ok(flow(VList(value_list_from_strs(lines($s), 0)), $env))
            }
            ValCons(VHandle($stream), ValNil) {
                eval_handle_lines_val(VHandle($stream), $env)
            }
            ValCons(VFileHandle($h), ValNil) {
                eval_handle_lines_val(VFileHandle($h), $env)
            }
            _ { Err(eval_err("lines expects a Str or Handle, got " ~ "{ $argc }" ~ " arg(s)")) }
        }
    } else if $n == "parse_int" {
        match $vals {
            ValCons(VStr($s), ValNil) {
                match parse_int($s) {
                    Ok($i) { Ok(flow(VVariant("Ok", ValCons(VInt($i), ValNil), ""), $env)) }
                    Err($e) { Ok(flow(VVariant("Err", ValCons(VStr($e), ValNil), ""), $env)) }
                }
            }
            _ { Err(eval_err("parse_int expects 1 Str argument(s), got " ~ "{ $argc }")) }
        }
    } else if $n == "replace" {
        match $vals {
            ValCons(VStr($s), ValCons(VRegex($p, $private), ValCons(VStr($tmpl), ValNil))) {
                match apply_regex_replace($s, $p, $private, $tmpl) {
                    Err($e) { Err($e) }
                    Ok($out) { Ok(flow(VStr($out), $env)) }
                }
            }
            _ { Err(eval_err("replace expects Str, Regex, and Str template (got " ~ "{ $argc }" ~ " args)")) }
        }
    } else if $n == "replace_with" {
        match $vals {
            ValCons(VStr($s), ValCons(VRegex($p, $private), ValCons($fn, ValNil))) {
                match apply_regex_replace_with($s, $p, $private, $fn, $subs) {
                    Err($e) { Err($e) }
                    Ok($out) { Ok(flow(VStr($out), $env)) }
                }
            }
            _ { Err(eval_err("replace_with expects Str, Regex, and a Match->Str function (got " ~ "{ $argc }" ~ " args)")) }
        }
    } else if is_channel_op_prelude($n) {
        apply_channel_op($n, $vals, $env)
    } else if is_carrier_extract_prelude($n) {
        apply_carrier_extract($n, $vals, $subs, $env)
    } else if is_carrier_combinator_prelude($n) {
        apply_carrier_combinator($n, $vals, $subs, $env)
    } else if $n == "join" {
        match $vals {
            ValCons(VList($xs), ValCons(VStr($sep), ValNil)) {
                match vlist_join($xs, $sep, "", true) {
                    Err($e) { Err($e) }
                    Ok($s) { Ok(flow(VStr($s), $env)) }
                }
            }
            _ { Err(eval_err("join expects List[Str] and Str separator (got " ~ "{ $argc }" ~ " args)")) }
        }
    } else if is_list_fold_prelude($n) {
        apply_list_fold($n, $vals, $env)
    } else if $n == "sort_by" {
        match $vals {
            ValCons(VList($xs), ValCons($fn, ValNil)) {
                match vlist_hof($n, $xs, $fn, $subs, ValNil) {
                    Err($e) { Err($e) }
                    Ok($pairs) { Ok(flow(VList(vlist_sort_by_values($pairs)), $env)) }
                }
            }
            _ { Err(eval_err("sort_by expects a List and a function")) }
        }
    } else if $n == "reduce" {
        match $vals {
            ValCons(VList($xs), ValCons($seed, ValCons($fn, ValNil))) {
                match vlist_hof($n, $xs, $fn, $subs, ValCons($seed, ValNil)) {
                    Err($e) { Err($e) }
                    Ok($out) {
                        match $out {
                            ValCons($v, ValNil) { Ok(flow($v, $env)) }
                            _ { Err(eval_err("reduce accumulator is unavailable")) }
                        }
                    }
                }
            }
            _ { Err(eval_err("reduce expects a List, a seed, and a function")) }
        }
    } else {
        match $vals {
            ValCons(VVariant($tag, $fields, $eid), ValCons($fn, ValNil)) {
                if $n == "map" {
                    apply_carrier_map($tag, $fields, $fn, $subs, $env)
                } else if $n == "filter" {
                    apply_carrier_filter($tag, $fields, $fn, $subs, $env)
                } else {
                    Err(eval_err($n ~ " expects a List and a function"))
                }
            }
            ValCons(VList($xs), ValCons($fn, ValNil)) {
                match vlist_hof($n, $xs, $fn, $subs, ValNil) {
                    Err($e) { Err($e) }
                    Ok($out) {
                        if $n == "each" {
                            Ok(flow(VUnit, $env))
                        } else if $n == "find" {
                            match $out {
                                ValNil { Ok(flow(VVariant("None", ValNil, ""), $env)) }
                                ValCons($hit, $rest) {
                                    Ok(flow(VVariant("Some", ValCons($hit, ValNil), ""), $env))
                                }
                            }
                        } else {
                            Ok(flow(VList($out), $env))
                        }
                    }
                }
            }
            _ { Err(eval_err($n ~ " expects a List and a function")) }
        }
    }
}

sub eval_collection_mutation_call($n: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { apply_collection_mutation($n, $ar.values, $subs, $ar.env) }
            }
        }
    }
}

sub eval_collection_mutation_ufcs($n: Str, $recv: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { apply_collection_mutation($n, ValCons($recv, $ar.values), $subs, $ar.env) }
            }
        }
    }
}


# §15.3 string prelude (I5d/I5d2), all forwarded into the one existing
# mutation eval_args edge. The redundant forwarding wrappers were removed to
# keep the bootstrap compiler below its recursive codegen stack limit.
sub is_string_unary_prelude($n: Str): Bool {
    $n == "trim" || $n == "upper" || $n == "lower" ||
        $n == "split" || $n == "lines" || $n == "parse_int"
}

# §15.3 regex string prelude (I7c). Method form is always prelude (matching C);
# free form remains user-shadowable via eval_call's subtable-first dispatch.
sub is_regex_str_prelude($n: Str): Bool {
    $n == "replace" || $n == "replace_with"
}

sub is_channel_op_prelude($n: Str): Bool {
    $n == "send" || $n == "recv" || $n == "close"
}

# Call dispatch (E3): a name resolves to a builtin, else a user `sub` in the
# sub-table; a `TypeName` callee constructs a Variant value (decision 1); a field
# callee is UFCS — `$x.f(a)` is evaluated EXACTLY as `f($x, a)` (§7.2).
sub eval_call($callee: Expr, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $callee {
        EQualified($m, $n) {
            $qualified = import_qualified_name($m, $n)
            match subtable_lookup($subs, $qualified) {
                Some($sub) { eval_call_user($sub, $args, imported_eval_scope($m, $subs), $env) }
                None {
                    match classtable_lookup($subs, $qualified) {
                        Some($c) {
                            eval_class_construct($c, $qualified, $args, imported_eval_scope($m, $subs), $env)
                        }
                        None { Err(eval_err("module " ~ $m ~ " has no callable member " ~ $n)) }
                    }
                }
            }
        }
        EName($n) {
            # Sigil-named callees may be first-class function bindings. Bare
            # builtin/sub names are absent from Env and retain the established
            # dispatch below.
            match env_lookup($env, $n) {
                Some($value) { eval_call_value($value, $args, $subs, $env) }
                None {
                    if $n == "print" {
                        eval_print_to($args, $subs, $env, false)
                    } else if $n == "note" {
                        eval_print_to($args, $subs, $env, true)
                    } else if $n == "panic" {
                        match subtable_lookup($subs, "panic") {
                            Some($sub) { eval_call_user($sub, $args, $subs, $env) }
                            None { eval_builtin_panic($args, $subs, $env) }
                        }
                    } else if $n == "exit" {
                        match subtable_lookup($subs, "exit") {
                            Some($sub) { eval_call_user($sub, $args, $subs, $env) }
                            None { eval_builtin_exit($args, $subs, $env) }
                        }
                    } else {
                        match subtable_lookup($subs, $n) {
                            Some($sub) { eval_call_user($sub, $args, $subs, $env) }
                            None {
                                if $n == "args" {
                                    eval_builtin_args($args, $env)
                                } else if $n == "slurp" || $n == "write" {
                                    eval_handle_free($n, $args, $subs, $env)
                                } else if is_file_path_prelude($n) {
                                    eval_file_path_call($n, $args, $subs, $env)
                                } else if $n == "run" {
                                    eval_process_call($args, $subs, $env)
                                } else if is_collection_query_prelude($n) {
                                    eval_collection_query_call($n, $args, $subs, $env)
                                } else if is_channel_op_prelude($n) || is_collection_mutation_prelude($n) || is_string_unary_prelude($n) || is_regex_str_prelude($n) || is_list_hof_prelude($n) || is_list_fold_prelude($n) || is_list_join_prelude($n) || is_carrier_extract_prelude($n) || is_carrier_combinator_prelude($n) {
                                    # Mutation, §15.3 strings/regex, §15.1 List HOF/fold/join,
                                    # and §15.5 carrier extract/combinators share one
                                    # eval_args-backed apply (bootstrap stack budget).
                                    eval_collection_mutation_call($n, $args, $subs, $env)
                                } else {
                                    Err(eval_err("undefined function: " ~ $n))
                                }
                            }
                        }
                    }
                }
            }
        }
        ETypeName($n) {
            match classtable_lookup($subs, $n) {
                Some($c) {
                    eval_class_construct($c, class_instance_id($n, $c, $subs), $args, $subs, $env)
                }
                None { eval_variant_call($n, $args, $subs, $env) }
            }
        }
        EField($recv, $method) { eval_field_call($recv, $method, $args, $subs, $env) }
        _ {
            # A computed callee is an ordinary expression: evaluate it once,
            # before any argument, then invoke the resulting function value.
            match eval_expr_flow($callee, $subs, $env) {
                Err($e) { Err($e) }
                Ok($cr) {
                    if $cr.returned {
                        Ok($cr)
                    } else {
                        eval_call_value($cr.value, $args, $subs, $cr.env)
                    }
                }
            }
        }
    }
}

# §8.3/§7.5 + §9 + §7.2: a field-callee call. Dispatch order mirrors the
# compiler: class associated `Type.f(args)` (no receiver); enum associated
# `EnumName.f(args)`; nullary-variant receiver `Red.f()` (materialize the
# variant, then call its method); otherwise evaluate the receiver once, try
# class/enum instance methods with `$self` prepended, then data-first UFCS.
sub eval_field_call($recv: Expr, $method: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $recv {
        EQualified($module, $member) {
            $qualified = import_qualified_name($module, $member)
            $scoped = imported_eval_scope($module, $subs)
            match grammartable_lookup($subs, $qualified) {
                Some($g) { eval_grammar_assoc($g, $method, $args, $scoped, $env) }
                None {
                    match classtable_lookup($subs, $qualified) {
                        Some($c) {
                            match find_assoc_sub($c.subs, $method) {
                                Some($s) { eval_call_user($s, $args, $scoped, $env) }
                                None { Err(eval_err("class " ~ $member ~ " has no associated function " ~ $method)) }
                            }
                        }
                        None {
                            match enumtable_lookup($subs, $qualified) {
                                Some($e) {
                                    match find_assoc_sub($e.subs, $method) {
                                        Some($s) { eval_call_user($s, $args, $scoped, $env) }
                                        None { Err(eval_err("enum " ~ $member ~ " has no associated function " ~ $method)) }
                                    }
                                }
                                None { Err(eval_err("module " ~ $module ~ " has no member " ~ $member)) }
                            }
                        }
                    }
                }
            }
        }
        ETypeName($tn) {
            if $tn == "Regex" {
                eval_regex_assoc($method, $args, $subs, $env)
            } else {
                match grammartable_lookup($subs, $tn) {
                    Some($g) { eval_grammar_assoc($g, $method, $args, $subs, $env) }
                    None {
                        match classtable_lookup($subs, $tn) {
                            Some($c) {
                                match find_assoc_sub($c.subs, $method) {
                                    Some($s) { eval_call_user($s, $args, $subs, $env) }
                                    None { Err(eval_err("class " ~ $tn ~ " has no associated function " ~ $method)) }
                                }
                            }
                            None {
                                match enumtable_lookup($subs, $tn) {
                                    Some($e) {
                                        match find_assoc_sub($e.subs, $method) {
                                            Some($s) { eval_call_user($s, $args, $subs, $env) }
                                            None { Err(eval_err("enum " ~ $tn ~ " has no associated function " ~ $method)) }
                                        }
                                    }
                                    None {
                                        # Nullary-variant receiver: `Red.label()` is a §9
                                        # method on the materialized variant value, not an
                                        # associated call on the enum type name.
                                        match enum_for_variant($subs, $tn) {
                                            Some($e) {
                                                $vid = VVariant($tn, ValNil, enum_instance_id($e, $subs))
                                                match find_method_sub($e.subs, $method) {
                                                    Some($s) {
                                                        eval_call_user_with_recv($s, $vid, true, $args, $subs, $env)
                                                    }
                                                    None { eval_ufcs_val($method, $vid, $args, $subs, $env) }
                                                }
                                            }
                                            None {
                                                eval_call(EName($method), ExprCons($recv, $args), $subs, $env)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ {
            match eval_expr_flow($recv, $subs, $env) {
                Err($e) { Err($e) }
                Ok($rr) {
                    if $rr.returned {
                        Ok($rr)
                    } else {
                        match method_sub_for($rr.value, $method, $subs) {
                            Some($s) { eval_call_user_with_recv($s, $rr.value, true, $args, $subs, $rr.env) }
                            None { eval_ufcs_val($method, $rr.value, $args, $subs, $rr.env) }
                        }
                    }
                }
            }
        }
    }
}

sub method_sub_for($v: Value, $method: Str, $subs: SubTable): Option[SubDecl] {
    match $v {
        VInstance($cn, $fs) {
            match classtable_lookup($subs, $cn) {
                Some($c) { find_method_sub($c.subs, $method) }
                None { None }
            }
        }
        VVariant($tag, $fs, $eid) {
            if $eid == "" {
                match enum_for_variant($subs, $tag) {
                    Some($e) { find_method_sub($e.subs, $method) }
                    None { None }
                }
            } else {
                match enumtable_lookup($subs, $eid) {
                    Some($e) { find_method_sub($e.subs, $method) }
                    None {
                        match enum_for_variant($subs, $tag) {
                            Some($e) { find_method_sub($e.subs, $method) }
                            None { None }
                        }
                    }
                }
            }
        }
        _ { None }
    }
}

sub find_method_sub($ss: SubDeclList, $name: Str): Option[SubDecl] {
    match $ss {
        SubDeclNil { None }
        SubDeclCons($s, $rest) {
            if $s.name == $name && is_method_sub($s) { Some($s) } else { find_method_sub($rest, $name) }
        }
    }
}

sub find_assoc_sub($ss: SubDeclList, $name: Str): Option[SubDecl] {
    match $ss {
        SubDeclNil { None }
        SubDeclCons($s, $rest) {
            if $s.name == $name && !is_method_sub($s) { Some($s) } else { find_assoc_sub($rest, $name) }
        }
    }
}

# Data-first UFCS fallback with a pre-evaluated receiver value: `print`/`note`
# take the receiver as their single argument; collection-query/mutation prelude
# methods always fire before a user `sub` (matching C); trim/upper/lower permit
# a user-sub shadow (matching C); otherwise a user sub gets the receiver prepended.
sub eval_ufcs_val($n: Str, $recv: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $n == "print" || $n == "note" {
        match $args {
            ExprNil {
                if $n == "note" { note(display_value($recv)) } else { print(display_value($recv)) }
                Ok(flow(VUnit, $env))
            }
            _ { Err(eval_err("print expects 1 argument, got more")) }
        }
    } else if $n == "slurp" || $n == "write" {
        # §15.4 Handle methods. Method form is always the prelude (matching C);
        # free form remains user-shadowable via eval_call's subtable-first path.
        eval_handle_method($n, $recv, $args, $subs, $env)
    } else if is_file_path_prelude($n) {
        # §15.4 path methods: receiver is the path Str; always prelude (matching C).
        eval_file_path_ufcs($n, $recv, $args, $subs, $env)
    } else if $n == "run" {
        # §15.6 method form follows C's user-shadow rule; otherwise the Str
        # receiver is the command and the sole explicit argument is List[Str].
        match subtable_lookup($subs, "run") {
            Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
            None { eval_process_ufcs($recv, $args, $subs, $env) }
        }
    } else if $n == "lines" {
        # Overloaded by receiver: Handle.lines → closed Chan[Str] (always
        # prelude); Str.lines → List[Str] with the usual user-sub shadow.
        match $recv {
            VHandle($stream) { eval_handle_method("lines", $recv, $args, $subs, $env) }
            VFileHandle($h) { eval_handle_method("lines", $recv, $args, $subs, $env) }
            _ {
                match subtable_lookup($subs, $n) {
                    Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
                    None { eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env) }
                }
            }
        }
    } else if is_channel_op_prelude($n) {
        # §17.3 method form is the data-first channel prelude. The receiver was
        # evaluated once by eval_field_call; explicit arguments use the shared
        # mutation apply edge.
        eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env)
    } else if is_collection_query_prelude($n) {
        if $n == "is_empty" {
            # Unlike the other query methods, C's is_empty lowering declines
            # when a top-level user sub exists, so ordinary UFCS dispatch wins.
            match subtable_lookup($subs, $n) {
                Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
                None { eval_collection_query_ufcs($n, $recv, $args, $subs, $env) }
            }
        } else {
            eval_collection_query_ufcs($n, $recv, $args, $subs, $env)
        }
    } else if is_collection_mutation_prelude($n) {
        eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env)
    } else if is_carrier_extract_prelude($n) || is_carrier_combinator_prelude($n) {
        eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env)
    } else if is_regex_str_prelude($n) {
        # C's replace/replace_with method form is always prelude syntax.
        eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env)
    } else if is_string_unary_prelude($n) || is_list_hof_prelude($n) || is_list_fold_prelude($n) || is_list_join_prelude($n) {
        # Free-form user subs already won in eval_call; method form lets a user
        # sub shadow string/HOF/fold/join prelude the same way C does. Carrier
        # `map`/`filter` (Option/Result receiver) is prelude-only like C.
        if $n == "map" || $n == "filter" {
            # Carrier map/filter method form is prelude (matching C); List
            # map/filter still allows a user-sub shadow.
            match $recv {
                VVariant($tag, $fields, $eid) {
                    if $tag == "Some" || $tag == "None" || $tag == "Ok" || $tag == "Err" {
                        eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env)
                    } else {
                        match subtable_lookup($subs, $n) {
                            Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
                            None { eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env) }
                        }
                    }
                }
                _ {
                    match subtable_lookup($subs, $n) {
                        Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
                        None { eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env) }
                    }
                }
            }
        } else {
            match subtable_lookup($subs, $n) {
                Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
                None { eval_collection_mutation_ufcs($n, $recv, $args, $subs, $env) }
            }
        }
    } else {
        match subtable_lookup($subs, $n) {
            Some($sub) { eval_call_user_with_recv($sub, $recv, false, $args, $subs, $env) }
            None { Err(eval_err("undefined function: " ~ $n)) }
        }
    }
}

# Call a user sub with a pre-evaluated receiver value prepended to the argument
# values. For a class METHOD ($priv = true) the receiver binds the declared
# `$self` first param and the class's PRIVATE fields are pre-bound as
# `sigil!name` shorthands in the body frame — instances are immutable, so this
# is observationally the oracle's read-through-$self evalPrivateField.
sub eval_call_user_with_recv($sub: SubDecl, $recv: Value, $priv: Bool, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None {
                    match bind_params($sub.params, ValCons($recv, $ar.values), BindNil) {
                        Err($e) { Err($e) }
                        Ok($frame) {
                            $full = private_binds_opt($priv, $recv, $subs, $frame)
                            match eval_body_ret($sub.body, $sub.ret, $subs, EnvFrame($full, EnvNil)) {
                                Err($e) { Err($e) }
                                Ok($br) { Ok(flow($br.value, $ar.env)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub private_binds_opt($priv: Bool, $recv: Value, $subs: SubTable, $frame: Bindings): Bindings {
    if $priv { private_field_binds($recv, $subs, $frame) } else { $frame }
}

sub private_field_binds($recv: Value, $subs: SubTable, $frame: Bindings): Bindings {
    match $recv {
        VInstance($cn, $fs) {
            match classtable_lookup($subs, $cn) {
                Some($c) { private_binds_from($c.fields, $fs, $frame) }
                None { $frame }
            }
        }
        _ { $frame }
    }
}

sub private_binds_from($cfs: ClassFieldList, $fs: ValMapList, $frame: Bindings): Bindings {
    match $cfs {
        ClassFieldNil { $frame }
        ClassFieldCons($f, $rest) {
            $tail = private_binds_from($rest, $fs, $frame)
            if $f.public {
                $tail
            } else {
                match vmap_lookup($fs, $f.name) {
                    Some($v) { bind_append($tail, $f.sigil ~ "!" ~ $f.name, false, $v) }
                    None { $tail }
                }
            }
        }
    }
}

# Class construction results: the evaluated field entries (decl order) plus the
# threaded env and an early-return carrier, shaped exactly like ArgsEval.
class InstEval {
    has $.fields: ValMapList
    has $.env: Env
    has $.early: Option[EvalResult]
}

sub construct_args_positional($args: ExprList): Bool {
    match $args {
        ExprNil { false }
        ExprCons($a, $rest) {
            match $a {
                ENamedArg($n, $v) { construct_args_positional($rest) }
                _ { true }
            }
        }
    }
}

sub find_construct_arg($args: ExprList, $name: Str): Option[Expr] {
    match $args {
        ExprNil { None }
        ExprCons($a, $rest) {
            match $a {
                ENamedArg($n, $v) { if $n == $name { Some($v) } else { find_construct_arg($rest, $name) } }
                _ { find_construct_arg($rest, $name) }
            }
        }
    }
}

sub class_field_named($fs: ClassFieldList, $name: Str): Bool {
    match $fs {
        ClassFieldNil { false }
        ClassFieldCons($f, $rest) {
            if $f.name == $name { true } else { class_field_named($rest, $name) }
        }
    }
}

sub construct_unknown_named($args: ExprList, $fs: ClassFieldList): Option[Str] {
    match $args {
        ExprNil { None }
        ExprCons($a, $rest) {
            match $a {
                ENamedArg($n, $v) {
                    if class_field_named($fs, $n) { construct_unknown_named($rest, $fs) } else { Some($n) }
                }
                _ { construct_unknown_named($rest, $fs) }
            }
        }
    }
}

# Evaluate one named argument per declared field, in FIELD-DECLARATION order
# (the oracle's constructClass walks Decl.Fields and evaluates named[bare] in
# that order, NOT the written argument order).
sub eval_construct_fields($fs: ClassFieldList, $cname: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[InstEval, Str] {
    match $fs {
        ClassFieldNil { Ok(InstEval(fields: ValMapNil, env: $env, early: None)) }
        ClassFieldCons($f, $rest) {
            match find_construct_arg($args, $f.name) {
                None { Err(eval_err("missing field " ~ $f.name ~ " for " ~ $cname ~ " construction")) }
                Some($e) {
                    match eval_expr_flow($e, $subs, $env) {
                        Err($err) { Err($err) }
                        Ok($r) {
                            if $r.returned {
                                Ok(InstEval(fields: ValMapNil, env: $r.env, early: Some($r)))
                            } else {
                                match eval_construct_fields($rest, $cname, $args, $subs, $r.env) {
                                    Err($err) { Err($err) }
                                    Ok($tail) {
                                        match $tail.early {
                                            Some($er) { Ok($tail) }
                                            None { Ok(InstEval(fields: ValMapCons(ValMapEntry(key: $f.name, value: $r.value), $tail.fields), env: $tail.env, early: None)) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# §8.2 class construction: named arguments only, one per declared field; extra
# names reject AFTER the field walk (the oracle checks missing-during-walk,
# unknown-after). The untyped evaluator's error TEXTS differ from the oracle's
# type errors; only well-typed programs are in-corpus, so accept/reject agrees.
# `$id` is the stable class key stored on the instance (`alias::Name` for
# imports, bare name for entry-local types).
sub eval_class_construct($c: ClassDecl, $id: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if construct_args_positional($args) {
        Err(eval_err("class construction uses named arguments only"))
    } else {
        match eval_construct_fields($c.fields, $c.name, $args, $subs, $env) {
            Err($e) { Err($e) }
            Ok($ie) {
                match $ie.early {
                    Some($er) { Ok($er) }
                    None {
                        match construct_unknown_named($args, $c.fields) {
                            Some($bad) { Err(eval_err($c.name ~ " has no field " ~ $bad)) }
                            None { Ok(flow(VInstance($id, $ie.fields), $ie.env)) }
                        }
                    }
                }
            }
        }
    }
}

# Evaluate constructor payloads left-to-right. When a field annotation is a
# concrete Chan[T], bare `channel(...)` inherits that context (I11a / §17.2).
# Extra args beyond declared fields keep the untyped eval_args path so arity
# diagnostics stay with the checker for well-typed programs.
sub eval_args_chan_fields($fields: ParamList, $args: ExprList, $subs: SubTable, $env: Env): Result[ArgsEval, Str] {
    match $fields {
        ParamNil { eval_args($args, $subs, $env) }
        ParamCons($p, $prest) {
            match $args {
                ExprNil { Ok(ArgsEval(values: ValNil, env: $env, early: None)) }
                ExprCons($a, $arest) {
                    match eval_expr_chan_ctx($a, $p.ty, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok(ArgsEval(values: ValNil, env: $r.env, early: Some($r)))
                            } else {
                                match eval_args_chan_fields($prest, $arest, $subs, $r.env) {
                                    Err($e) { Err($e) }
                                    Ok($tail) {
                                        match $tail.early {
                                            Some($er) { Ok($tail) }
                                            None { Ok(ArgsEval(values: ValCons($r.value, $tail.values), env: $tail.env, early: None)) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Construct a Variant value from a PascalCase constructor call (`Some(3)`, `Ok(v)`)
# or a bare constructor (`None`). User-enum variants carry a stable `$eid` so
# same-named enums from different modules keep distinct method identity (I8b3).
# User-enum field annotations supply Chan[T] context for direct `channel()` args.
sub eval_variant_call($tag: Str, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    $eid_opt = enum_for_variant($subs, $tag)
    $ar_res = match $eid_opt {
        Some($e) {
            match variant_fields_of($e.variants, $tag) {
                Some($fs) { eval_args_chan_fields($fs, $args, $subs, $env) }
                None { eval_args($args, $subs, $env) }
            }
        }
        None { eval_args($args, $subs, $env) }
    }
    match $ar_res {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None {
                    $eid = match $eid_opt {
                        Some($e) { enum_instance_id($e, $subs) }
                        None { "" }
                    }
                    Ok(flow(VVariant($tag, $ar.values, $eid), $ar.env))
                }
            }
        }
    }
}

sub eval_bool_cond($cond: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($cond, $subs, $env) {
        Err($e) { Err($e) }
        Ok($r) {
            if $r.returned {
                Ok($r)
            } else {
                match $r.value {
                    VBool($b) { Ok(flow(VBool($b), $r.env)) }
                    _ { Err(eval_err("if condition must be Bool")) }
                }
            }
        }
    }
}

# Run a statement list in the given pre-built child frame, then strip that frame
# so the block's locals do not leak into the enclosing scope; the block's VALUE
# and any outer-mutable updates (carried in the parent) flow back. Shared by
# `if`/`else` branches (empty child frame) and `match` arms (captures frame).
sub run_scope($stmts: StmtList, $subs: SubTable, $child: Env): Result[EvalResult, Str] {
    match eval_stmt_list($stmts, $subs, $child) {
        Err($e) { Err($e) }
        Ok($r) {
            match $r.env {
                EnvFrame($locals, $parent) { Ok(EvalResult(value: $r.value, env: $parent, returned: $r.returned)) }
                EnvNil { Ok($r) }
            }
        }
    }
}

sub eval_child_block($stmts: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    run_scope($stmts, $subs, EnvFrame(BindNil, $env))
}

sub eval_elifs($elifs: ElifList, $els: Option[StmtList], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $elifs {
        ElifNil {
            match $els {
                Some($body) { eval_child_block($body, $subs, $env) }
                None { Ok(flow(VUnit, $env)) }
            }
        }
        ElifCons($head, $tail) {
            match eval_bool_cond($head.cond, $subs, $env) {
                Err($e) { Err($e) }
                Ok($cr) {
                    if $cr.returned {
                        Ok($cr)
                    } else {
                        match $cr.value {
                            VBool($b) {
                                if $b {
                                    eval_child_block($head.body, $subs, $cr.env)
                                } else {
                                    eval_elifs($tail, $els, $subs, $cr.env)
                                }
                            }
                            _ { Err(eval_err("if condition must be Bool")) }
                        }
                    }
                }
            }
        }
    }
}

sub eval_if($cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_bool_cond($cond, $subs, $env) {
        Err($e) { Err($e) }
        Ok($cr) {
            if $cr.returned {
                Ok($cr)
            } else {
                match $cr.value {
                    VBool($b) {
                        if $b {
                            eval_child_block($then, $subs, $cr.env)
                        } else {
                            eval_elifs($elifs, $els, $subs, $cr.env)
                        }
                    }
                    _ { Err(eval_err("if condition must be Bool")) }
                }
            }
        }
    }
}

# §6.3 `while`: re-evaluate the condition each iteration; while it is true run the
# body in a fresh child frame (so body locals do not leak, but reassignments to
# outer `mut` bindings thread back through the parent — see env_set). A `return`
# inside the body (or the condition) short-circuits the whole loop. The loop value
# is Unit. Keep the evaluator's own iteration native: a recursive call here used
# one C stack frame per guest iteration and crashed the native interpreter on
# otherwise-valid long-running loops.
sub eval_while($cond: Expr, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    mut $cur_env = $env
    mut $going = true
    while $going {
        match eval_bool_cond($cond, $subs, $cur_env) {
            Err($e) { return Err($e) }
            Ok($cr) {
                if $cr.returned {
                    return Ok($cr)
                }
                match $cr.value {
                    VBool($b) {
                        $cur_env = $cr.env
                        if $b {
                            match eval_child_block($body, $subs, $cur_env) {
                                Err($e) { return Err($e) }
                                Ok($br) {
                                    if $br.returned {
                                        return Ok($br)
                                    }
                                    $cur_env = $br.env
                                }
                            }
                        } else {
                            $going = false
                        }
                    }
                    _ { return Err(eval_err("while condition must be Bool")) }
                }
            }
        }
    }
    Ok(flow(VUnit, $cur_env))
}

# §6.3 `for vars in iter block`: evaluate the iterator once, then run the body once
# per element in a fresh child frame with the loop variable(s) bound immutably.
# Reassignments to outer `mut` bindings thread back through the returned env (as in
# `while`); a `return` in the iterator or the body short-circuits the whole loop.
# Lists bind one variable to each element; maps bind key (Str) then value, iterating
# keys in SORTED order (matching the oracle's sort.Strings). Scalar and
# List/Map/enum channels bind one variable and recv until None (I10c/I10c2b).
# Ranges (VRange) bind one Int variable and walk bounds directly (I9b). The loop
# value is Unit. Hatch/select remain I10d/e.
sub eval_for($vars: StrList, $iter: Expr, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($iter, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ir) {
            if $ir.returned {
                Ok($ir)
            } else {
                match $ir.value {
                    VList($items) { eval_for_list($vars, $items, $body, $subs, $ir.env) }
                    VMap($entries) { eval_for_map($vars, vmap_sort($entries), $body, $subs, $ir.env) }
                    VChanInt($ch) { eval_for_chan_int($vars, $ch, $body, $subs, $ir.env) }
                    VChanBool($ch) { eval_for_chan_bool($vars, $ch, $body, $subs, $ir.env) }
                    VChanFloat($ch) { eval_for_chan_float($vars, $ch, $body, $subs, $ir.env) }
                    VChanStr($ch) { eval_for_chan_str($vars, $ch, $body, $subs, $ir.env) }
                    VChanListInt($ch) { eval_for_chan_list_int($vars, $ch, $body, $subs, $ir.env) }
                    VChanMapStr($ch) { eval_for_chan_map_str($vars, $ch, $body, $subs, $ir.env) }
                    VChanEnum($ch) { eval_for_chan_enum($vars, $ch, $body, $subs, $ir.env) }
                    VRange($from, $to, $open) { eval_for_range($vars, $from, $to, $open, $body, $subs, $ir.env) }
                    _ { Err(eval_err("cannot iterate over " ~ value_type_name($ir.value))) }
                }
            }
        }
    }
}

# §5.4/§6.3: iterate VRange without materializing a ValueList. Half-open
# `..< INT64_MIN` is empty (hi-1 would underflow). Inclusive loops stop after
# yielding INT64_MAX — never compute cur+1 past the final element.
sub eval_for_range($vars: StrList, $from: Int, $to: Int, $open: Bool, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $vars {
        StrCons($v, StrNil) {
            if $open {
                if $to == int_min() {
                    Ok(flow(VUnit, $env))
                } else {
                    eval_for_range_bounds($v, $from, $to - 1, $body, $subs, $env)
                }
            } else {
                eval_for_range_bounds($v, $from, $to, $body, $subs, $env)
            }
        }
        _ { Err(eval_err("for over Range requires one loop variable")) }
    }
}

sub eval_for_range_bounds($v: Str, $lo: Int, $hi: Int, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    if $lo > $hi {
        Ok(flow(VUnit, $env))
    } else {
        eval_for_range_go($v, $lo, $hi, $body, $subs, $env)
    }
}

sub eval_for_range_go($v: Str, $cur: Int, $hi: Int, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    mut $next = $cur
    mut $cur_env = $env
    mut $going = true
    while $going {
        match run_scope($body, $subs, EnvFrame(BindCons($v, false, VInt($next), BindNil), $cur_env)) {
            Err($e) { return Err($e) }
            Ok($br) {
                if $br.returned {
                    return Ok($br)
                }
                $cur_env = $br.env
                if $next == $hi {
                    $going = false
                } else {
                    $next = $next + 1
                }
            }
        }
    }
    Ok(flow(VUnit, $cur_env))
}

sub eval_for_list($vars: StrList, $items: ValueList, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $vars {
        StrCons($v, StrNil) { eval_for_list_go($v, $items, $body, $subs, $env) }
        _ { Err(eval_err("for over List requires one loop variable")) }
    }
}

sub eval_for_list_go($v: Str, $items: ValueList, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    mut $cur = $items
    mut $cur_env = $env
    mut $going = true
    while $going {
        match $cur {
            ValNil { $going = false }
            ValCons($head, $tail) {
                match run_scope($body, $subs, EnvFrame(BindCons($v, false, $head, BindNil), $cur_env)) {
                    Err($e) { return Err($e) }
                    Ok($br) {
                        if $br.returned {
                            return Ok($br)
                        }
                        $cur_env = $br.env
                        $cur = $tail
                    }
                }
            }
        }
    }
    Ok(flow(VUnit, $cur_env))
}

sub eval_for_map($vars: StrList, $entries: ValMapList, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $vars {
        StrCons($kv, StrCons($vv, StrNil)) { eval_for_map_go($kv, $vv, $entries, $body, $subs, $env) }
        _ { Err(eval_err("for over Map requires two loop variables")) }
    }
}

sub eval_for_map_go($kv: Str, $vv: Str, $entries: ValMapList, $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    mut $cur = $entries
    mut $cur_env = $env
    mut $going = true
    while $going {
        match $cur {
            ValMapNil { $going = false }
            ValMapCons($e, $rest) {
                match run_scope($body, $subs, EnvFrame(BindCons($kv, false, VStr($e.key), BindCons($vv, false, $e.value, BindNil)), $cur_env)) {
                    Err($er) { return Err($er) }
                    Ok($br) {
                        if $br.returned {
                            return Ok($br)
                        }
                        $cur_env = $br.env
                        $cur = $rest
                    }
                }
            }
        }
    }
    Ok(flow(VUnit, $cur_env))
}

# §17.4: drain a scalar channel until recv yields None. Outer mut rebinds and
# early return match the List for path via run_scope / $br.env. Typed Chan[T]
# helpers stay inside the bootstrap subset (a Value-match Result helper for
# VChan* was declined). Handle.lines reuses the Str path. Chan[Unit] for is
# omitted with C (g5_for_chan_elem_supported declines Unit).
sub eval_for_chan_int($vars: StrList, $ch: Chan[Int], $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $vars {
        StrCons($v, StrNil) { eval_for_chan_int_go($v, $ch, $body, $subs, $env) }
        _ { Err(eval_err("for over Chan requires one loop variable")) }
    }
}

sub eval_for_chan_int_go($v: Str, $ch: Chan[Int], $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    mut $cur_env = $env
    mut $going = true
    while $going {
        $got = $ch.recv()
        if $got.is_some() {
            match run_scope($body, $subs, EnvFrame(BindCons($v, false, VInt($got.unwrap()), BindNil), $cur_env)) {
                Err($e) { return Err($e) }
                Ok($br) {
                    if $br.returned {
                        return Ok($br)
                    }
                    $cur_env = $br.env
                }
            }
        } else {
            $going = false
        }
    }
    Ok(flow(VUnit, $cur_env))
}

sub eval_for_chan_bool($vars: StrList, $ch: Chan[Bool], $body: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $vars {
        StrCons($v, StrNil) { eval_for_chan_bool_go($v, $ch, $body, $subs, $env) }
        _ { Err(eval_err("for over Chan requires one loop variable")) }
    }
}

