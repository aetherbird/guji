# Reassign an existing mutable binding: lower the value under the binding's known
# kind and emit an assignment to its existing C local (no new declaration). The
# value kind must match (else the kind-lowerer Errs -> out of subset); the
# typechecker has already verified it does for accepted programs.
sub g4_lower_reassign($var: CgVar, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $var.kind {
        CgInt {
            match g4_lower_value(CgInt, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env))
                }
            }
        }
        CgFloat {
            match g4_lower_value(CgFloat, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env))
                }
            }
        }
        CgBool {
            match g4_lower_value(CgBool, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($bl) {
                    Ok(BindOut(state: CgState(interns: $bl.state.interns, decls: $bl.state.decls, body: $bl.state.body ~ "\t" ~ $var.cname ~ " = " ~ $bl.c ~ ";\n", nstr: $bl.state.nstr, ntmp: $bl.state.ntmp), env: $env))
                }
            }
        }
        CgStr {
            match g4_lower_value(CgStr, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($sl) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $sl.state.interns,
                            decls: $sl.state.decls,
                            body: $sl.state.body ~ "\tguji_release(" ~ $var.cname ~ ");\n\t" ~ $var.cname ~ " = " ~ $sl.c ~ ";\n",
                            nstr: $sl.state.nstr,
                            ntmp: $sl.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgHandle {
            match g4_handle_owned_value($value, $state, $env) {
                Err($m) { Err($m) }
                Ok($hv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $hv.state.interns,
                            decls: $hv.state.decls,
                            body: $hv.state.body ~ "\tguji_release((const void*)" ~ $var.cname ~ ");\n\t" ~ $var.cname ~ " = " ~ $hv.c ~ ";\n",
                            nstr: $hv.state.nstr,
                            ntmp: $hv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        # Reassigning a `Unit` binding lowers the new value (only `()` is in subset
        # -> "0LL") and assigns the int64_t slot; Unit owns nothing, so there is no
        # release. The source never reassigns a Unit local, but exhaustiveness needs
        # the arm (slice 5 E5d-7c-2d-11).
        CgUnit {
            match g4_lower_value(CgUnit, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) { Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env)) }
            }
        }
        CgOptInt {
            match g4_lower_value(CgOptInt, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) { Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env)) }
            }
        }
        CgOptFloat {
            match g4_lower_value(CgOptFloat, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) { Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env)) }
            }
        }
        CgOptBool {
            match g4_lower_value(CgOptBool, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) { Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env)) }
            }
        }
        CgOptCarrier($inner) {
            match g4_lower_value(CgOptCarrier($inner), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) { Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ g6_option_release(CgOptCarrier($inner), $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env)) }
            }
        }
        CgOptStr {
            match g4_lower_value(CgOptStr, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptStr, $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgOptMatch {
            match g4_lower_value(CgOptMatch, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptMatch, $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgOptBush {
            match g4_lower_value(CgOptBush, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptBush, $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgMatch {
            match g4_lower_value(CgMatch, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ "\tguji_release((const void*)" ~ $var.cname ~ ");\n\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgBush {
            match g4_lower_value(CgBush, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ "\tguji_release((const void*)" ~ $var.cname ~ ");\n\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgOptClass($n) {
            match g4_lower_value(CgOptClass($n), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptClass($n), $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgOptEnum($n) {
            match g4_lower_value(CgOptEnum($n), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptEnum($n), $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgOptList($el) {
            match g4_lower_value(CgOptList($el), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptList($el), $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgOptMap($v) {
            match g4_lower_value(CgOptMap($v), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_option_release(CgOptMap($v), $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgRes($ok, $err) {
            match g4_lower_value($var.kind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g6_result_release($var.kind, $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgEnum($n) {
            match g4_lower_value($var.kind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    # An enum rvalue may be a borrowed struct accessor inside the
                    # value being replaced (for example `$cursor = $tail` while
                    # matching a recursive enum). Its field retains run during
                    # lowering, but releasing the old cursor can still free the
                    # box that stores the accessor itself. Copy the complete
                    # struct to a stack temp before that release; the assignment
                    # then moves the temp's retained fields into the binding.
                    $tmp = g4_value_tmp(CgEnum($n), $rv.state.ntmp)
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls ~ g4_value_decl(CgEnum($n), $tmp),
                            body: $rv.state.body ~ "\t" ~ $tmp ~ " = " ~ $rv.c ~ ";\n" ~ g6e_enum_release($n, $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $tmp ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp + 1
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgBoxEnum($n) { Err(g3_unsupported()) }
        CgBoxClass($n) { Err(g3_unsupported()) }
        CgBoxOptClass($n) { Err(g3_unsupported()) }
        CgBoxOptEnum($n) { Err(g3_unsupported()) }
        CgClass($n) {
            match g4_lower_value($var.kind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ g8_class_release($n, $var.cname) ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        # Whole-list reassignment (`@xs = [...]`) into the existing fixed-size
        # stack array; in subset for a non-empty scalar list literal of length
        # <= the first-bind capacity (P9-6b-9 shorter-ok; longer still declines).
        CgList($el) { g7_lower_list_reassign($var, $el, $value, $state, $env) }
        # Whole-map reassignment (`%m = {...}` / `%m = %m.set(...)` / map-valued
        # RHS): reallocates or steals into the existing two-array binding.
        CgMap($v) { g7_lower_map_reassign($var, $v, $value, $state, $env) }
        CgFn($p, $r) {
            match $value {
                ELambda($params, $ret, $body, $topic) {
                    match g5_param_kinds($params, $env) {
                        Err($m) { Err($m) }
                        Ok($np) {
                            match g5_ret_kind($ret, $env) {
                                Err($m) { Err($m) }
                                Ok($nr) {
                                    if cgkind_list_eq($p, $np) && cg_ret_eq($r, $nr) {
                                        match g5_emit_lambda_value($params, $ret, $body, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($fv) {
                                                Ok(BindOut(
                                                    state: CgState(
                                                        interns: $fv.state.interns,
                                                        decls: $fv.state.decls,
                                                        body: $fv.state.body ~ "\tguji_release(" ~ $var.cname ~ ".env);\n\t" ~ $var.cname ~ " = " ~ $fv.c ~ ";\n",
                                                        nstr: $fv.state.nstr,
                                                        ntmp: $fv.state.ntmp
                                                    ),
                                                    env: $env
                                                ))
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                    }
                }
                # P9-9b-1: non-literal CgFn rebind (`$first = $made`,
                # `$cur = make_adder(2)`). Mirror native emitFnBinding: lower
                # the RHS, retain when it is an alias (not a fresh call/lambda),
                # release the old env, then overwrite the local.
                _ {
                    match g4_lower_value(CgFn($p, $r), $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($fv) {
                            $retain = if g5_fn_init_fresh($value) {
                                ""
                            } else {
                                "\tguji_retain(" ~ $fv.c ~ ".env);\n"
                            }
                            Ok(BindOut(
                                state: CgState(
                                    interns: $fv.state.interns,
                                    decls: $fv.state.decls,
                                    body: $fv.state.body ~ $retain ~ "\tguji_release(" ~ $var.cname ~ ".env);\n\t" ~ $var.cname ~ " = " ~ $fv.c ~ ";\n",
                                    nstr: $fv.state.nstr,
                                    ntmp: $fv.state.ntmp
                                ),
                                env: $env
                            ))
                        }
                    }
                }
            }
        }
        CgChan($el) {
            match g4_lower_value(CgChan($el), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(
                        state: CgState(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls,
                            body: $rv.state.body ~ "\tguji_chan_release(" ~ $var.cname ~ ");\n\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n",
                            nstr: $rv.state.nstr,
                            ntmp: $rv.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
        CgClosed {
            match g4_lower_value(CgClosed, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    Ok(BindOut(state: CgState(interns: $rv.state.interns, decls: $rv.state.decls, body: $rv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $rv.c ~ ";\n", nstr: $rv.state.nstr, ntmp: $rv.state.ntmp), env: $env))
                }
            }
        }
    }
}

# Emit the §4 same-frame immutable-rebind panic. The RHS is still lowered (D
# evaluates it before env_set) so side-effecting right-hand sides run. guji_panic
# uses _exit, so owned temps need not be released for LSan; scalar paths leave
# nothing behind anyway.
sub g4_emit_immutable_rebind_panic($var: CgVar, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g4_lower_value($var.kind, $value, $state, $env) {
        Err($m) { Err($m) }
        Ok($rv) {
            Ok(BindOut(
                state: CgState(
                    interns: $rv.state.interns,
                    decls: $rv.state.decls,
                    body: $rv.state.body ~ "\t(void)(" ~ $rv.c ~ ");\n\tguji_panic(\"runtime error: cannot reassign immutable binding\");\n",
                    nstr: $rv.state.nstr,
                    ntmp: $rv.state.ntmp
                ),
                env: $env
            ))
        }
    }
}

# Dispatch a binding statement under an explicit CURRENT-FRAME base (`$scope_base`
# = cg_env_len at block entry). Mirrors eval `env_set` (§4):
#   - name in current frame + mut → reassign;
#   - name in current frame + immutable → runtime panic;
#   - name only in an outer frame + mut → reassign that outer local;
#   - name only in an outer frame + immutable → fresh shadow in this frame;
#   - absent → fresh bind.
# Re-`mut` (`mut $x = …` when `$x` is already visible) stays out of subset.
sub g4_lower_bind_scoped($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv, $scope_base: Int): Result[BindOut, Str] {
    $n_local = cg_env_len($env) - $scope_base
    match cg_env_lookup_in_frame($env, $name, $n_local) {
        Some($var) {
            if $mutable {
                Err(g3_unsupported())
            } else if $var.mutable {
                g4_lower_reassign($var, $value, $state, $env)
            } else {
                g4_emit_immutable_rebind_panic($var, $value, $state, $env)
            }
        }
        None {
            if $mutable {
                match cg_env_lookup($env, $name) {
                    Some($outer) { Err(g3_unsupported()) }
                    None { g4_lower_fresh_bind($mutable, $name, $ty, $value, $state, $env) }
                }
            } else {
                match cg_env_lookup($env, $name) {
                    None { g4_lower_fresh_bind($mutable, $name, $ty, $value, $state, $env) }
                    Some($var) {
                        if $var.mutable {
                            g4_lower_reassign($var, $value, $state, $env)
                        } else {
                            g4_lower_fresh_bind($mutable, $name, $ty, $value, $state, $env)
                        }
                    }
                }
            }
        }
    }
}

# Function-body / unknown-scope entry: the whole value-binding prefix is the
# current frame (params + prior locals), so scope_base 0.
sub g4_lower_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    g4_lower_bind_scoped($mutable, $name, $ty, $value, $state, $env, 0)
}

# The CgKind a value body of return kind `$r` lowers under. RUnit has no value
# kind: a Unit body ends in `print(...)`/a Unit call/empty, never a value expr.
sub g5_ret_value_kind($r: CgRet): Option[CgKind] {
    match $r {
        RInt { Some(CgInt) }
        RFloat { Some(CgFloat) }
        RBool { Some(CgBool) }
        RStr { Some(CgStr) }
        RUnit { None }
        REnum($n) { Some(CgEnum($n)) }
        RClass($n) { Some(CgClass($n)) }
        ROpt($k) { Some($k) }
        RRes($k) { Some($k) }
        RList($el) { Some(CgList($el)) }
        RMap($v) { Some(CgMap($v)) }
        RBush { Some(CgBush) }
        RChan($el) { Some(CgChan($el)) }
        RFn($p, $r) { Some(CgFn($p, $r)) }
    }
}

sub g5_question_option_carrier_of($expr: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $expr {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) { if g6_is_option_kind($v.kind) { Ok($v.kind) } else { Err(g3_unsupported()) } }
            }
        }
        ECall($callee, $args) {
            match g7_find_option_kind_from_value($expr, $env) {
                Ok($k) { Ok($k) }
                Err($not_find) {
                    match g5_resolve_call_target($callee, $args, $env) {
                        Err($m) { Err($m) }
                        Ok($target) {
                            match $target.sig.ret {
                                ROpt($k) { Ok($k) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_question_scalar_payload_supported($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        _ { false }
    }
}

sub g5_question_bind_payload_supported($k: CgKind): Bool {
    if g5_question_scalar_payload_supported($k) {
        true
    } else {
        match $k {
            CgStr { true }
            # C08c projections move these owned payloads out of the temporary
            # carrier into the synthetic binding.  The carrier temp is not
            # subsequently released; ordinary env cleanup owns the moved value.
            CgList($el) { true }
            CgClass($n) { true }
            _ { false }
        }
    }
}

# Owned (heap-refcounted) success payloads the FINAL carrier constructor path can
# transfer through a `?` (P3b-2b-2b). Only Str for now: the operand carrier owns its
# Some/Ok payload, so the final path retains the payload into the rebuilt result
# carrier BEFORE releasing the operand carrier's slot (native's captured shape —
# `guji_retain(gt0.ok); <success> = {..., gt0.ok, ...}; <release operand>`). List /
# class / enum success payloads stay out until a native-accepted probe drives them.
sub g5_question_final_owned_payload($k: CgKind): Bool {
    match $k {
        CgStr { true }
        _ { false }
    }
}

sub g5_question_bind_type_ok($ty: Option[TypeRef], $payload: CgKind, $env: CgEnv): Bool {
    match $ty {
        None { true }
        Some($tr) {
            match g5_param_kind($ty, $env) {
                Err($m) { false }
                Ok($annotated) { cgkind_eq($annotated, $payload) }
            }
        }
    }
}

sub g5_question_bind_decl($kind: CgKind, $cn: Str): Str {
    g4_value_decl($kind, $cn)
}

sub g5_question_bind_slot($kind: CgKind, $cn: Str, $slot: Str): Str {
    match $kind {
        CgBool { "\t" ~ $cn ~ " = ((" ~ $slot ~ ") ? 1LL : 0LL);\n" }
        _ { "\t" ~ $cn ~ " = " ~ $slot ~ ";\n" }
    }
}

sub g5_question_bind_emit_extra($mutable: Bool, $name: Str, $payload: CgKind, $carrier: CgKind, $carrier_value: CgValueOut, $fail_cond: Str, $success_slot: Str, $early_ret: Str, $state: CgState, $env: CgEnv, $extra_cleanup: Str): Result[BindOut, Str] {
    if g5_question_bind_payload_supported($payload) {
        $qtmp = g4_value_tmp($carrier, $carrier_value.state.ntmp)
        $cn = "gv" ~ c_int($carrier_value.state.ntmp + 1)
        $st2 = CgState(
            interns: $carrier_value.state.interns,
            decls: $carrier_value.state.decls ~ g4_value_decl($carrier, $qtmp) ~ g5_question_bind_decl($payload, $cn),
            body: $carrier_value.state.body ~
                "\t" ~ $qtmp ~ " = " ~ $carrier_value.c ~ ";\n" ~
                "\tif (" ~ $qtmp ~ "." ~ $fail_cond ~ ") \{\n" ~
                $extra_cleanup ~
                cg_env_release_strs($env) ~
                "\t\treturn " ~ $early_ret ~ ";\n" ~
                "\t}\n" ~
                g5_question_bind_slot($payload, $cn, $qtmp ~ "." ~ $success_slot),
            nstr: $carrier_value.state.nstr,
            ntmp: $carrier_value.state.ntmp + 2
        )
        Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $payload, mutable: $mutable, borrowed: false, listlen: 0), $env)))
    } else {
        Err(g3_unsupported())
    }
}

sub g5_question_bind_emit($mutable: Bool, $name: Str, $payload: CgKind, $carrier: CgKind, $carrier_value: CgValueOut, $fail_cond: Str, $success_slot: Str, $early_ret: Str, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    g5_question_bind_emit_extra($mutable, $name, $payload, $carrier, $carrier_value, $fail_cond, $success_slot, $early_ret, $state, $env, "")
}

sub g5_question_option_bind_extra($mutable: Bool, $name: Str, $ty: Option[TypeRef], $expr: Expr, $retopt: CgKind, $state: CgState, $env: CgEnv, $extra_cleanup: Str): Result[BindOut, Str] {
    match g5_question_option_carrier_of($expr, $env) {
        Err($m) { Err($m) }
        Ok($opkind) {
            match g6_option_payload_kind($opkind) {
                Err($m) { Err($m) }
                Ok($payload) {
                    if g5_question_bind_type_ok($ty, $payload, $env) {
                        match g6_option_value($opkind, $expr, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($ov) {
                                g5_question_bind_emit_extra(
                                    $mutable,
                                    $name,
                                    $payload,
                                    $opkind,
                                    $ov,
                                    "tag == 0LL",
                                    "val",
                                    "(" ~ g6_option_ctype($retopt) ~ ")\{0LL, " ~ g6_option_zero($retopt) ~ "}",
                                    $state,
                                    $env,
                                    $extra_cleanup
                                )
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

sub g5_question_result_bind_extra($mutable: Bool, $name: Str, $ty: Option[TypeRef], $expr: Expr, $retres: CgKind, $state: CgState, $env: CgEnv, $extra_cleanup: Str): Result[BindOut, Str] {
    match g6_result_kind_from_value($expr, $env) {
        Err($m) { Err($m) }
        Ok($opkind) {
            $payload = g6_result_ok_kind($opkind)
            $operr = g6_result_err_kind($opkind)
            $reter = g6_result_err_kind($retres)
            if cgkind_eq($operr, $reter) && g5_question_bind_type_ok($ty, $payload, $env) {
                match g6_result_value($opkind, $expr, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($rv) {
                        g5_question_bind_emit_extra(
                            $mutable,
                            $name,
                            $payload,
                            $opkind,
                            $rv,
                            "tag != 0LL",
                            "ok",
                            "(" ~ g6_result_ctype($retres) ~ ")\{1LL, " ~ g6_result_zero(g6_result_ok_kind($retres)) ~ ", " ~ g4_value_tmp($opkind, $rv.state.ntmp) ~ ".err}",
                            $state,
                            $env,
                            $extra_cleanup
                        )
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_question_bind_extra($mutable: Bool, $name: Str, $ty: Option[TypeRef], $expr: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    match $retkind {
        ROpt($retopt) { g5_question_option_bind_extra($mutable, $name, $ty, $expr, $retopt, $state, $env, $extra_cleanup) }
        RRes($retres) { g5_question_result_bind_extra($mutable, $name, $ty, $expr, $retres, $state, $env, $extra_cleanup) }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_question_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $expr: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g5_question_bind_extra($mutable, $name, $ty, $expr, $state, $env, $retkind, "")
}

sub g5_stmt_question_bind_extra($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $s {
        SBind($mutable, $name, $ty, $value) {
            match cg_env_lookup($env, $name) {
                # Existing name: a `?`-bearing RHS is a REASSIGNMENT hoist (P3b-2b-2c-4).
                Some($var) { g5_reassign_question_extra($var, $mutable, $value, $state, $env, $retkind, $extra_cleanup) }
                # Fresh name: the direct `$x = f()?` bind keeps its native-pinned
                # direct guard shape (g5_question_bind); any other RHS holding a
                # hoistable `?` lifts it and lowers through the ordinary fresh bind.
                None {
                    match $value {
                        EQuestion($expr) {
                            match g5_question_bind_extra($mutable, $name, $ty, $expr, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok($b) { Ok(Some($b)) }
                            }
                        }
                        _ {
                            match g5_question_hoist_all_extra($value, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(None) { Ok(None) }
                                Ok(Some($h)) {
                                    match g4_lower_bind($mutable, $name, $ty, $h.expr, $h.state, $h.env) {
                                        Err($m) { Err($m) }
                                        Ok($b) { Ok(Some($b)) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_stmt_question_bind($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    g5_stmt_question_bind_extra($s, $state, $env, $retkind, "")
}

sub g5_if_bind_kind_supported($kind: CgKind): Bool {
    match $kind {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        CgStr { true }
        _ { false }
    }
}

# P3b-2b-2c-4 (unannotated if-value binds): a fresh scalar/Str bind whose RHS is an
# if-value with a branch-final `?` hoist but NO type annotation has no TypeRef to
# derive the result kind from. Infer it the same way g4_lower_fresh_bind's scalar
# cascade does — try Int, then Float, Bool, Str — taking the first kind whose
# retkind-aware branch lowering succeeds. Each attempt threads state by value (no
# side effects), so a mismatched kind (whose g4_lower_value fails inside the branch)
# is discarded before the next kind is tried; if every kind fails the shape is
# genuinely out of subset, so this declines (Ok(None)) and the ordinary statement
# path re-declines it. The lowering is the EXACT branch-final `?` path the annotated
# form (P3b-2b-2c-4j) already proves three-way, so native emits identical C for the
# annotated and unannotated forms (cc-wrapper confirmed).
sub g5_if_value_bind_try($kind: CgKind, $mutable: Bool, $name: Str, $cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match g5_lower_if_value_ret($kind, $cond, $then, $elifs, $els, $state, $env, $retkind) {
        Err($m) { Ok(None) }
        Ok($iv) {
            $cn = "gv" ~ c_int($iv.state.ntmp)
            Ok(Some(BindOut(
                state: CgState(
                    interns: $iv.state.interns,
                    decls: $iv.state.decls ~ g4_value_decl($kind, $cn),
                    body: $iv.state.body ~ "\t" ~ $cn ~ " = " ~ $iv.c ~ ";\n",
                    nstr: $iv.state.nstr,
                    ntmp: $iv.state.ntmp + 1
                ),
                env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: 0), $env)
            )))
        }
    }
}

sub g5_stmt_if_value_bind_infer($mutable: Bool, $name: Str, $cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match g5_if_value_bind_try(CgInt, $mutable, $name, $cond, $then, $elifs, $els, $state, $env, $retkind) {
        Err($m) { Err($m) }
        Ok(Some($b)) { Ok(Some($b)) }
        Ok(None) {
            match g5_if_value_bind_try(CgFloat, $mutable, $name, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                Err($m) { Err($m) }
                Ok(Some($b)) { Ok(Some($b)) }
                Ok(None) {
                    match g5_if_value_bind_try(CgBool, $mutable, $name, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                        Err($m) { Err($m) }
                        Ok(Some($b)) { Ok(Some($b)) }
                        Ok(None) {
                            g5_if_value_bind_try(CgStr, $mutable, $name, $cond, $then, $elifs, $els, $state, $env, $retkind)
                        }
                    }
                }
            }
        }
    }
}

sub g5_if_value_reassign_emit($var: CgVar, $iv: CgValueOut, $env: CgEnv): BindOut {
    match $var.kind {
        CgStr {
            BindOut(
                state: CgState(
                    interns: $iv.state.interns,
                    decls: $iv.state.decls,
                    body: $iv.state.body ~ "\tguji_release(" ~ $var.cname ~ ");\n\t" ~ $var.cname ~ " = " ~ $iv.c ~ ";\n",
                    nstr: $iv.state.nstr,
                    ntmp: $iv.state.ntmp
                ),
                env: $env
            )
        }
        _ {
            BindOut(
                state: CgState(
                    interns: $iv.state.interns,
                    decls: $iv.state.decls,
                    body: $iv.state.body ~ "\t" ~ $var.cname ~ " = " ~ $iv.c ~ ";\n",
                    nstr: $iv.state.nstr,
                    ntmp: $iv.state.ntmp
                ),
                env: $env
            )
        }
    }
}

sub g5_if_value_reassign($var: CgVar, $mutable: Bool, $value: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    if $mutable {
        Ok(None)
    } else if $var.mutable {
        match $value {
            EIf($cond, $then, $elifs, $els) {
                match g4_lower_reassign($var, $value, $state, $env) {
                    Ok($accepted) { Ok(None) }
                    Err($needs_hoist) {
                        if g5_if_bind_kind_supported($var.kind) {
                            match g5_lower_if_value_ret($var.kind, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                                Err($m) { Err($m) }
                                Ok($iv) {
                                    Ok(Some(g5_if_value_reassign_emit($var, $iv, $env)))
                                }
                            }
                        } else {
                            Ok(None)
                        }
                    }
                }
            }
            _ { Ok(None) }
        }
    } else {
        Ok(None)
    }
}

# P3b-2b-2c-4j: annotated fresh scalar/Str binds whose RHS is an if-value can
# reuse the retkind-aware branch lowerer. This covers branch-final `?` hoists in
# non-final statement position without teaching the general fresh-bind inference
# path about the enclosing return carrier. P3b-2b-2c-4 extends the same lowering to
# the UNANNOTATED form via g5_stmt_if_value_bind_infer (kind inferred by cascade).
sub g5_stmt_if_value_bind($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match $s {
        SBind($mutable, $name, $ty, $value) {
            match cg_env_lookup($env, $name) {
                Some($var) { g5_if_value_reassign($var, $mutable, $value, $state, $env, $retkind) }
                None {
                    match $value {
                        EIf($cond, $then, $elifs, $els) {
                            match g5_param_kind($ty, $env) {
                                Err($m) {
                                    # No usable annotation (unannotated, or an
                                    # unsupported annotated type). Only take over when
                                    # the ordinary bind path DECLINES — i.e. the RHS
                                    # carries a `?` that needs the enclosing return
                                    # carrier. A `?`-free if bind still lowers through
                                    # the byte-identical g4_lower_bind path.
                                    match g4_lower_bind($mutable, $name, $ty, $value, $state, $env) {
                                        Ok($accepted) { Ok(None) }
                                        Err($needs_hoist) {
                                            g5_stmt_if_value_bind_infer($mutable, $name, $cond, $then, $elifs, $els, $state, $env, $retkind)
                                        }
                                    }
                                }
                                Ok($kind) {
                                    if g5_if_bind_kind_supported($kind) {
                                        match g5_lower_if_value_ret($kind, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                                            Err($m) { Err($m) }
                                            Ok($iv) {
                                                $cn = "gv" ~ c_int($iv.state.ntmp)
                                                Ok(Some(BindOut(
                                                    state: CgState(
                                                        interns: $iv.state.interns,
                                                        decls: $iv.state.decls ~ g4_value_decl($kind, $cn),
                                                        body: $iv.state.body ~ "\t" ~ $cn ~ " = " ~ $iv.c ~ ";\n",
                                                        nstr: $iv.state.nstr,
                                                        ntmp: $iv.state.ntmp + 1
                                                    ),
                                                    env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: 0), $env)
                                                )))
                                            }
                                        }
                                    } else {
                                        Ok(None)
                                    }
                                }
                            }
                        }
                        _ { Ok(None) }
                    }
                }
            }
        }
        _ { Ok(None) }
    }
}

# P3b-2b-2c-4: an existing-name binding statement is a REASSIGNMENT (§4). When its
# RHS carries a hoistable `?` (`$x = parse_int($s)? + 1`, direct `$x = f()?`), lift
# the carrier guard/early-return into a synthetic scalar/Str bind — the SAME
# value-position hoist the fresh-bind path uses — then lower the rebuilt RHS through
# the ordinary reassign path (g4_lower_reassign), whose existing kind arms emit the
# release-old-then-assign shape. Only a valid mutable reassignment is eligible: a
# statement `mut` on an existing name is re-`mut` shadowing (out of subset) and an
# immutable binding cannot be reassigned — both return Ok(None) to fall through
# exactly as before (they decline downstream). A RHS with no hoistable `?` also
# returns Ok(None), so the plain reassign path handles it unchanged. The synthetic
# `?qN` payload local threads through in `$h.env`, so scope cleanup still releases an
# owned Str payload. Evaluation order matches native: the `?` guard (and its early
# return) fires before the old binding is released/overwritten.
sub g5_reassign_question_extra($var: CgVar, $mutable: Bool, $value: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    if $mutable {
        Ok(None)
    } else if $var.mutable {
        match $value {
            EIf($cond, $then, $elifs, $els) { Ok(None) }
            _ {
                match g5_question_hoist_all_extra($value, $state, $env, $retkind, $extra_cleanup) {
                    Err($m) { Err($m) }
                    Ok(None) { Ok(None) }
                    Ok(Some($h)) {
                        match g4_lower_reassign($var, $h.expr, $h.state, $h.env) {
                            Err($m) { Err($m) }
                            Ok($b) { Ok(Some($b)) }
                        }
                    }
                }
            }
        }
    } else {
        Ok(None)
    }
}

# True for expressions whose evaluation has no user-visible effect and emits no
# owned heap temporary in the current scalar paths. These may sit to the left of
# a right-operand `?` hoist without changing native's observable order.
sub g5_question_left_pure($e: Expr): Bool {
    match $e {
        EInt($t) { true }
        EFloat($t) { true }
        EBool($t) { true }
        EName($n) { true }
        _ { false }
    }
}

# P3b-2b-2b/2c: hoist an evaluation-order-safe `?` subexpression out of a value
# expression (a final carrier-constructor argument, or — via the arg walker below
# — a general call argument `f(x?)`). Left-spine questions are always safe: native
# evaluates a binary's left operand (including the `?` carrier check) before its
# right, and a call's arguments left-to-right. P3b-2b-2c also admits a right
# operand / later call argument only when what precedes it is pure
# (`Ok(100 - parse_int($s)?)`, `Some($base + $o?)`, `Some(add(100, $o?))`), so
# moving the guard before the left read/literal is behavior-identical. Other
# right-operand questions stay unsupported until they can be emitted inline in
# native order. The payload binds to a synthetic local whose name contains `?`,
# which no user binding can spell, so it can never collide or shadow.
# True for call callees the arg hoist can safely emit before: a plain sub name or
# a carrier/enum constructor is side-effect-free, so hoisting a `?` out of its
# argument (whose guard early-returns first) preserves native's evaluation order.
# Any other callee (field/index/method receiver) may itself observe effects, so
# decline it until an inline native-ordered guard exists.
sub g5_hoist_callee_pure($callee: Expr): Bool {
    match $callee {
        EName($n) { true }
        ETypeName($n) { true }
        # After an effectful method receiver has been hoisted into a synthetic
        # name, resolving the field itself has no remaining effect.  Later
        # argument `?` guards may therefore follow that name without moving
        # ahead of receiver evaluation (C08b).
        EField($obj, $name) {
            match $obj {
                EName($n) { true }
                _ { false }
            }
        }
        _ { false }
    }
}

# Walk a call's arguments left-to-right, hoisting the FIRST argument that carries
# a hoistable `?`. A later argument may only be hoisted when every preceding
# argument is pure (literal / bare name) — otherwise moving the `?` guard ahead of
# a preceding argument would reorder its side effects vs native's left-to-right
# argument evaluation. The unchanged prefix/suffix arguments are threaded verbatim;
# a rebuilt suffix that still holds a `?` is picked up by the next
# `g5_question_hoist_all` pass (the hoisted `?qN` prefix names are pure), so
# multi-`?` calls lower guard-by-guard in native's order; anything a later pass
# cannot hoist falls to the ordinary value path, which declines it (no miscompile).
sub g5_question_hoist_args_extra($args: ExprList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[ArgHoistOut], Str] {
    match $args {
        ExprNil { Ok(None) }
        ExprCons($head, $tail) {
            match g5_question_hoist_left_extra($head, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(Some($h)) { Ok(Some(ArgHoistOut(args: ExprCons($h.expr, $tail), state: $h.state, env: $h.env))) }
                Ok(None) {
                    if g5_question_left_pure($head) {
                        match g5_question_hoist_args_extra($tail, $state, $env, $retkind, $extra_cleanup) {
                            Err($m) { Err($m) }
                            Ok(None) { Ok(None) }
                            Ok(Some($ha)) { Ok(Some(ArgHoistOut(args: ExprCons($head, $ha.args), state: $ha.state, env: $ha.env))) }
                        }
                    } else {
                        Ok(None)
                    }
                }
            }
        }
    }
}

# A synthetic name denotes a key whose evaluation has already happened.  Every
# other supported Str expression is materialized once before its value is
# inspected; this keeps §5.6's map order even when the key prints, traps, or
# otherwise has an observable effect.
sub g5_question_map_key_stable($key: Expr): Bool {
    match $key {
        EName($n) { true }
        _ { false }
    }
}

# Walk map entries in native order: key, value, then the next entry.  An
# effectful key becomes an owned synthetic Str first.  Once the key is stable,
# the ordinary question hoister may emit the value's carrier guard.  A
# question-free but effectful value blocks access to later entries until a
# general value materializer exists, so this helper declines rather than
# reordering it.
sub g5_question_hoist_map_extra($items: MapEntryList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[MapHoistOut], Str] {
    match $items {
        MapEntryNil { Ok(None) }
        MapEntryCons($entry, $tail) {
            if g5_question_map_key_stable($entry.key) {
                match g5_question_hoist_left_extra($entry.value, $state, $env, $retkind, $extra_cleanup) {
                    Err($m) { Err($m) }
                    Ok(Some($h)) {
                        Ok(Some(MapHoistOut(
                            items: MapEntryCons(MapEntry(key: $entry.key, value: $h.expr), $tail),
                            state: $h.state,
                            env: $h.env
                        )))
                    }
                    Ok(None) {
                        if g5_question_left_pure($entry.value) {
                            match g5_question_hoist_map_extra($tail, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(None) { Ok(None) }
                                Ok(Some($h)) {
                                    Ok(Some(MapHoistOut(
                                        items: MapEntryCons($entry, $h.items),
                                        state: $h.state,
                                        env: $h.env
                                    )))
                                }
                            }
                        } else {
                            Ok(None)
                        }
                    }
                }
            } else {
                match g3_str_lower($entry.key, $state, $env) {
                    Err($m) { Ok(None) }
                    Ok($key) {
                        $name = "?k" ~ c_int($key.state.ntmp)
                        $kenv = CgEnvCons(CgVar(
                            name: $name,
                            cname: $key.tmp,
                            kind: CgStr,
                            mutable: false,
                            borrowed: false,
                            listlen: 0
                        ), $env)
                        Ok(Some(MapHoistOut(
                            items: MapEntryCons(MapEntry(key: EName($name), value: $entry.value), $tail),
                            state: $key.state,
                            env: $kenv
                        )))
                    }
                }
            }
        }
    }
}

sub g5_question_replace_named_arg($args: ExprList, $name: Str, $value: Expr): ExprList {
    match $args {
        ExprNil { ExprNil }
        ExprCons($head, $tail) {
            match $head {
                ENamedArg($n, $old) {
                    if $n == $name {
                        ExprCons(ENamedArg($n, $value), $tail)
                    } else {
                        ExprCons($head, g5_question_replace_named_arg($tail, $name, $value))
                    }
                }
                _ { ExprCons($head, g5_question_replace_named_arg($tail, $name, $value)) }
            }
        }
    }
}

# Named class initializers are the §5.6 exception to source argument order: they
# evaluate in field-declaration order.  Walk the resolved field table in that
# order, hoist the first question-bearing field value, and leave the original
# named-argument layout intact for the ordinary constructor lowerer.
sub g5_question_hoist_ctor_fields($fields: CgClassFieldInfoList, $args: ExprList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[ArgHoistOut], Str] {
    match $fields {
        CgClassFieldNil { Ok(None) }
        CgClassFieldCons($field, $rest) {
            match g8_named_arg_value($args, $field.name) {
                None { g5_question_hoist_ctor_fields($rest, $args, $state, $env, $retkind, $extra_cleanup) }
                Some($arg) {
                    match g5_question_hoist_left_extra($arg, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok(Some($h)) {
                            Ok(Some(ArgHoistOut(
                                args: g5_question_replace_named_arg($args, $field.name, $h.expr),
                                state: $h.state,
                                env: $h.env
                            )))
                        }
                        Ok(None) { g5_question_hoist_ctor_fields($rest, $args, $state, $env, $retkind, $extra_cleanup) }
                    }
                }
            }
        }
    }
}

# C08a: a right-operand `?` cannot move ahead of an effectful left operand.
# Materialize a supported Int left operand first, bind that temp under an
# unspellable synthetic name, and only then emit the carrier guard.  The
# rebuilt binary is pure, while the state retains the required §5.6 order:
#
#     left_value() + right_value()?
#       => left-temp; right-carrier/guard; left-temp + right-payload
#
# Keep this helper deliberately narrow.  Other value kinds and placements
# still decline until they have an equally explicit ownership-preserving
# materialization path.
sub g5_question_hoist_ordered_int_right($op: Str, $left: Expr, $qe: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[QHoistOut], Str] {
    match g3_int_rvalue_state($left, $state, $env) {
        Err($unsupported_left) { Ok(None) }
        Ok($lv) {
            # Always materialize once more.  Some Int lowerers already return a
            # temp, while atomic forms return a C rvalue; the extra assignment
            # gives both shapes one stable name and never repeats evaluation.
            $lm = g3_int_materialize($lv.c, $lv.state)
            $lname = "?l" ~ c_int($lm.state.ntmp)
            $lenv = CgEnvCons(CgVar(
                name: $lname,
                cname: $lm.c,
                kind: CgInt,
                mutable: false,
                borrowed: false,
                listlen: 0
            ), $env)
            $qname = "?q" ~ c_int($lm.state.ntmp)
            match g5_question_bind_extra(false, $qname, None, $qe, $lm.state, $lenv, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($b) {
                    Ok(Some(QHoistOut(
                        expr: EBinary($op, EName($lname), EName($qname)),
                        state: $b.state,
                        env: $b.env
                    )))
                }
            }
        }
    }
}

sub g5_question_hoist_left_extra($e: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[QHoistOut], Str] {
    match $e {
        EQuestion($qe) {
            $name = "?q" ~ c_int($state.ntmp)
            match g5_question_bind_extra(false, $name, None, $qe, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($b) { Ok(Some(QHoistOut(expr: EName($name), state: $b.state, env: $b.env))) }
            }
        }
        EList($items) {
            match g5_question_hoist_args_extra($items, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(None) { Ok(None) }
                Ok(Some($h)) { Ok(Some(QHoistOut(expr: EList($h.args), state: $h.state, env: $h.env))) }
            }
        }
        EMap($items) {
            match g5_question_hoist_map_extra($items, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(None) { Ok(None) }
                Ok(Some($h)) { Ok(Some(QHoistOut(expr: EMap($h.items), state: $h.state, env: $h.env))) }
            }
        }
        ECall($callee, $args) {
            match $callee {
                ETypeName($ctor) {
                    match cg_env_lookup_class($env, $ctor) {
                        Some($info) {
                            match g5_question_hoist_ctor_fields($info.fields, $args, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(None) { Ok(None) }
                                Ok(Some($ha)) { Ok(Some(QHoistOut(expr: ECall($callee, $ha.args), state: $ha.state, env: $ha.env))) }
                            }
                        }
                        None {
                            match g5_question_hoist_args_extra($args, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(None) { Ok(None) }
                                Ok(Some($ha)) { Ok(Some(QHoistOut(expr: ECall($callee, $ha.args), state: $ha.state, env: $ha.env))) }
                            }
                        }
                    }
                }
                # Method receiver order is receiver, then explicit arguments.
                # Hoist a direct receiver `?` first and rebuild the field over
                # its synthetic payload name; the next fixpoint pass can then
                # process ordered argument questions.
                EField($recv, $method) {
                    match $recv {
                        EQuestion($qe) {
                            $name = "?q" ~ c_int($state.ntmp)
                            match g5_question_bind_extra(false, $name, None, $qe, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok($b) {
                                    Ok(Some(QHoistOut(
                                        expr: ECall(EField(EName($name), $method), $args),
                                        state: $b.state,
                                        env: $b.env
                                    )))
                                }
                            }
                        }
                        _ {
                            if g5_hoist_callee_pure($callee) {
                                match g5_question_hoist_args_extra($args, $state, $env, $retkind, $extra_cleanup) {
                                    Err($m) { Err($m) }
                                    Ok(None) { Ok(None) }
                                    Ok(Some($ha)) { Ok(Some(QHoistOut(expr: ECall($callee, $ha.args), state: $ha.state, env: $ha.env))) }
                                }
                            } else {
                                Ok(None)
                            }
                        }
                    }
                }
                _ {
                    if g5_hoist_callee_pure($callee) {
                        match g5_question_hoist_args_extra($args, $state, $env, $retkind, $extra_cleanup) {
                            Err($m) { Err($m) }
                            Ok(None) { Ok(None) }
                            Ok(Some($ha)) { Ok(Some(QHoistOut(expr: ECall($callee, $ha.args), state: $ha.state, env: $ha.env))) }
                        }
                    } else {
                        Ok(None)
                    }
                }
            }
        }
        EField($obj, $field) {
            match g5_question_hoist_left_extra($obj, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(None) { Ok(None) }
                Ok(Some($h)) { Ok(Some(QHoistOut(expr: EField($h.expr, $field), state: $h.state, env: $h.env))) }
            }
        }
        EIndex($obj, $idx) {
            match g5_question_hoist_left_extra($obj, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(Some($h)) { Ok(Some(QHoistOut(expr: EIndex($h.expr, $idx), state: $h.state, env: $h.env))) }
                Ok(None) {
                    if g5_question_left_pure($obj) {
                        match g5_question_hoist_left_extra($idx, $state, $env, $retkind, $extra_cleanup) {
                            Err($m) { Err($m) }
                            Ok(None) { Ok(None) }
                            Ok(Some($h)) { Ok(Some(QHoistOut(expr: EIndex($obj, $h.expr), state: $h.state, env: $h.env))) }
                        }
                    } else {
                        Ok(None)
                    }
                }
            }
        }
        EBinary($op, $left, $right) {
            match $left {
                EQuestion($qe) {
                    $name = "?q" ~ c_int($state.ntmp)
                    match g5_question_bind_extra(false, $name, None, $qe, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($b) { Ok(Some(QHoistOut(expr: EBinary($op, EName($name), $right), state: $b.state, env: $b.env))) }
                    }
                }
                _ {
                    match g5_question_hoist_left_extra($left, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok(None) {
                            match $right {
                                EQuestion($qe) {
                                    if g5_question_left_pure($left) {
                                        $name = "?q" ~ c_int($state.ntmp)
                                        match g5_question_bind_extra(false, $name, None, $qe, $state, $env, $retkind, $extra_cleanup) {
                                            Err($m) { Err($m) }
                                            Ok($b) { Ok(Some(QHoistOut(expr: EBinary($op, $left, EName($name)), state: $b.state, env: $b.env))) }
                                        }
                                    } else {
                                        g5_question_hoist_ordered_int_right($op, $left, $qe, $state, $env, $retkind, $extra_cleanup)
                                    }
                                }
                                _ { Ok(None) }
                            }
                        }
                        Ok(Some($h)) { Ok(Some(QHoistOut(expr: EBinary($op, $h.expr, $right), state: $h.state, env: $h.env))) }
                    }
                }
            }
        }
        _ { Ok(None) }
    }
}

# P3b-2b-2c-4: iterate the single-`?` hoist to a fixpoint so MULTIPLE `?` in one
# expression lower (`Some(add($o?, $p?))`, `Ok(parse_int($s)? - parse_int($t)?)`,
# `$x = $o? + $p?`). Each hoist replaces one `EQuestion` with a pure synthetic
# `?qN` name, so on the next pass the existing left-pure rules admit the NEXT
# `?` — the guards land in exactly native's left-to-right evaluation order, and
# the recursion terminates because every pass removes one `EQuestion` node.
# `ntmp` advances by 2 per bind (g5_question_bind_emit), so every pass gets a
# fresh, collision-free synthetic name. If a later pass cannot hoist a remaining
# `?` (non-pure prefix, unsupported payload), the rebuilt expression flows to the
# ordinary value path, which declines it — never a miscompile.
sub g5_question_hoist_all_extra($e: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[QHoistOut], Str] {
    match g5_question_hoist_left_extra($e, $state, $env, $retkind, $extra_cleanup) {
        Err($m) { Err($m) }
        Ok(None) { Ok(None) }
        Ok(Some($h)) {
            match g5_question_hoist_all_extra($h.expr, $h.state, $h.env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(None) { Ok(Some($h)) }
                Ok(Some($h2)) { Ok(Some($h2)) }
            }
        }
    }
}

sub g5_question_hoist_all($e: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[QHoistOut], Str] {
    g5_question_hoist_all_extra($e, $state, $env, $retkind, "")
}

# The completed interpolation prefix is one owned Str temp.  If a later marker
# propagates early, that temp must be released in addition to the synthetic and
# lexical bindings already covered by g5_question_bind_emit_extra.
sub g5_question_interp_cleanup($b: StrBuild): Str {
    if $b.present { "\tguji_release(" ~ $b.tmp ~ ");\n" } else { "" }
}

# Retkind-aware twin of g3_interp_parts.  It preserves the same escape, bare
# sigil, balanced-brace, parse, and display behavior, but each braced expression
# first gets an evaluation-order-safe `?` hoist.  State and environment flow
# marker by marker, so a failure in marker N releases the completed prefix and
# skips every later marker exactly as §5.6 requires.
sub g5_question_interp_parts(@chars: List[Str], $i: Int, $n: Int, $chunk: Str, $b: StrBuild, $env: CgEnv, $retkind: CgRet, $found: Bool): Result[QuestionInterpOut, Str] {
    if $i >= $n {
        Ok(QuestionInterpOut(build: g3_interp_finish_chunk($chunk, $b), env: $env, found: $found))
    } else {
        match get(@chars, $i) {
            None { Ok(QuestionInterpOut(build: g3_interp_finish_chunk($chunk, $b), env: $env, found: $found)) }
            Some($c) {
                if $c == "\\" && at(@chars, $i + 1) == '{' {
                    g5_question_interp_parts(@chars, $i + 2, $n, $chunk ~ '{', $b, $env, $retkind, $found)
                } else if $c == "\\" && at(@chars, $i + 1) == '}' {
                    g5_question_interp_parts(@chars, $i + 2, $n, $chunk ~ "\\" ~ '}', $b, $env, $retkind, $found)
                } else if $c == "\\" && (at(@chars, $i + 1) == '$' || at(@chars, $i + 1) == '@' || at(@chars, $i + 1) == '%') {
                    g5_question_interp_parts(@chars, $i + 2, $n, $chunk ~ at(@chars, $i + 1), $b, $env, $retkind, $found)
                } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start(at(@chars, $i + 1)) {
                    $run = take_ident(@chars, $i + 1, $c)
                    $b1 = g3_interp_finish_chunk($chunk, $b)
                    match g3_interp_bare_sigil_part($run.text, $b1, $env) {
                        Err($m) { Err($m) }
                        Ok($b2) { g5_question_interp_parts(@chars, $run.next, $n, "", $b2, $env, $retkind, $found) }
                    }
                } else if $c == '{' {
                    match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                        None { Err(g3_unsupported()) }
                        Some($scan) {
                            match g3_parse_interpolation_expr($scan.text) {
                                None { Err(g3_unsupported()) }
                                Some($expr) {
                                    $b1 = g3_interp_finish_chunk($chunk, $b)
                                    match g5_question_hoist_all_extra($expr, $b1.state, $env, $retkind, g5_question_interp_cleanup($b1)) {
                                        Err($m) { Err($m) }
                                        Ok(None) {
                                            match g3_display_lower($expr, $b1.state, $env) {
                                                Err($m) { Err($m) }
                                                Ok($part) {
                                                    g5_question_interp_parts(
                                                        @chars,
                                                        $scan.next,
                                                        $n,
                                                        "",
                                                        g3_str_build_append($b1, $part),
                                                        $env,
                                                        $retkind,
                                                        $found
                                                    )
                                                }
                                            }
                                        }
                                        Ok(Some($h)) {
                                            match g3_display_lower($h.expr, $h.state, $h.env) {
                                                Err($m) { Err($m) }
                                                Ok($part) {
                                                    g5_question_interp_parts(
                                                        @chars,
                                                        $scan.next,
                                                        $n,
                                                        "",
                                                        g3_str_build_append($b1, $part),
                                                        $h.env,
                                                        $retkind,
                                                        true
                                                    )
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else {
                    g5_question_interp_parts(@chars, $i + 1, $n, $chunk ~ $c, $b, $env, $retkind, $found)
                }
            }
        }
    }
}

sub g5_question_interp_lower($text: Str, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[QuestionInterpOut, Str] {
    if has_char($text, '{') {
        @chars = split($text, "")
        match g5_question_interp_parts(@chars, 0, @chars.count(), "", StrBuild(state: $state, tmp: "", present: false), $env, $retkind, false) {
            Err($m) { Err($m) }
            Ok($out) { if $out.found { Ok($out) } else { Err(g3_unsupported()) } }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Finish a final Some/Ok interpolation after its marker guards have been emitted.
# Bind the owned completed string under an unspellable name, then reuse the
# ordinary carrier constructor so its established payload ownership remains the
# single source of truth.
sub g5_final_question_interpolation($ctor: Str, $text: Str, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[MainOut, Str] {
    match g5_question_interp_lower($text, $state, $env, $retkind) {
        Err($m) { Err($m) }
        Ok($out) {
            # `found` can only become true after a braced expression has been
            # display-lowered and appended, so the returned build is present.
            $built = $out.build
            $name = "?s" ~ c_int($built.state.ntmp)
            $senv = CgEnvCons(CgVar(
                name: $name,
                cname: $built.tmp,
                kind: CgStr,
                mutable: false,
                borrowed: false,
                listlen: 0
            ), $out.env)
            match g5_ret_value_kind($retkind) {
                None { Err(g3_unsupported()) }
                Some($kind) {
                    match g4_lower_value($kind, ECall(ETypeName($ctor), ExprCons(EName($name), ExprNil)), $built.state, $senv) {
                        Err($m) { Err($m) }
                        Ok($v) {
                            Ok(mainout_with_cleanup(MainOut(
                                interns: $v.state.interns,
                                decls: $v.state.decls,
                                body: $v.state.body,
                                ret: $v.c,
                                nstr: $v.state.nstr
                            ), $senv))
                        }
                    }
                }
            }
        }
    }
}

sub g5_question_final_option($retopt: CgKind, $expr: Expr, $state: CgState, $env: CgEnv): Result[MainOut, Str] {
    match g5_question_option_carrier_of($expr, $env) {
        Err($m) { Err($m) }
        Ok($opkind) {
            if cgkind_eq($opkind, $retopt) {
                match g6_option_payload_kind($opkind) {
                    Err($m) { Err($m) }
                    Ok($payload) {
                        if g5_question_scalar_payload_supported($payload) {
                            match g6_option_value($opkind, $expr, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($ov) {
                                    $qtmp = g4_value_tmp($opkind, $ov.state.ntmp)
                                    Ok(mainout_with_cleanup(MainOut(
                                        interns: $ov.state.interns,
                                        decls: $ov.state.decls ~ g4_value_decl($opkind, $qtmp),
                                        body: $ov.state.body ~
                                            "\t" ~ $qtmp ~ " = " ~ $ov.c ~ ";\n" ~
                                            "\tif (" ~ $qtmp ~ ".tag == 0LL) \{\n" ~
                                            cg_env_release_strs($env) ~
                                            "\t\treturn (" ~ g6_option_ctype($retopt) ~ ")\{0LL, " ~ g6_option_zero($retopt) ~ "};\n" ~
                                            "\t}\n",
                                        ret: "(" ~ g6_option_ctype($retopt) ~ ")\{1LL, " ~ $qtmp ~ ".val}",
                                        nstr: $ov.state.nstr
                                    ), $env))
                                }
                            }
                        } else if g5_question_final_owned_payload($payload) {
                            # Str Some payload: the operand carrier owns its `.val`
                            # string, so on success retain it into a rebuilt Some
                            # carrier temp, then release the operand carrier's slot
                            # (native transfers ownership: `guji_retain(gt0.val);
                            # gt1 = {1, gt0.val}; if (gt0.tag != 0) release(gt0.val)`).
                            # The None arm releases the (empty) operand slot defensively
                            # then the enclosing Str locals, matching native's shape.
                            match g6_option_value($opkind, $expr, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($ov) {
                                    $qtmp = g4_value_tmp($opkind, $ov.state.ntmp)
                                    $stmp = g4_value_tmp($retopt, $ov.state.ntmp + 1)
                                    Ok(mainout_with_cleanup(MainOut(
                                        interns: $ov.state.interns,
                                        decls: $ov.state.decls ~ g4_value_decl($opkind, $qtmp) ~ g4_value_decl($retopt, $stmp),
                                        body: $ov.state.body ~
                                            "\t" ~ $qtmp ~ " = " ~ $ov.c ~ ";\n" ~
                                            "\tif (" ~ $qtmp ~ ".tag == 0LL) \{\n" ~
                                            g6_option_release($retopt, $qtmp) ~
                                            cg_env_release_strs($env) ~
                                            "\t\treturn (" ~ g6_option_ctype($retopt) ~ ")\{0LL, " ~ g6_option_zero($retopt) ~ "};\n" ~
                                            "\t}\n" ~
                                            "\tguji_retain(" ~ $qtmp ~ ".val);\n" ~
                                            "\t" ~ $stmp ~ " = (" ~ g6_option_ctype($retopt) ~ ")\{1LL, " ~ $qtmp ~ ".val};\n" ~
                                            g6_option_release($retopt, $qtmp),
                                        ret: $stmp,
                                        nstr: $ov.state.nstr
                                    ), $env))
                                }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_question_final_result($retres: CgKind, $expr: Expr, $state: CgState, $env: CgEnv): Result[MainOut, Str] {
    match g6_result_kind_from_value($expr, $env) {
        Err($m) { Err($m) }
        Ok($opkind) {
            $payload = g6_result_ok_kind($opkind)
            $operr = g6_result_err_kind($opkind)
            $retok = g6_result_ok_kind($retres)
            $reter = g6_result_err_kind($retres)
            if cgkind_eq($payload, $retok) && cgkind_eq($operr, $reter) && g5_question_scalar_payload_supported($payload) {
                match g6_result_value($opkind, $expr, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($rv) {
                        $qtmp = g4_value_tmp($opkind, $rv.state.ntmp)
                        $rtmp = g4_value_tmp($retres, $rv.state.ntmp + 1)
                        Ok(mainout_with_cleanup(MainOut(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls ~ g4_value_decl($opkind, $qtmp) ~ g4_value_decl($retres, $rtmp),
                            body: $rv.state.body ~
                                "\t" ~ $qtmp ~ " = " ~ $rv.c ~ ";\n" ~
                                "\tif (" ~ $qtmp ~ ".tag != 0LL) \{\n" ~
                                "\t\t" ~ $rtmp ~ " = (" ~ g6_result_ctype($retres) ~ ")\{1LL, " ~ g6_result_zero($retok) ~ ", " ~ $qtmp ~ ".err};\n" ~
                                g6_result_retain($retres, $rtmp) ~
                                g6_result_release($opkind, $qtmp) ~
                                cg_env_release_strs($env) ~
                                "\t\treturn " ~ $rtmp ~ ";\n" ~
                                "\t}\n" ~
                                g6_result_release($opkind, $qtmp),
                            ret: "(" ~ g6_result_ctype($retres) ~ ")\{0LL, " ~ $qtmp ~ ".ok, " ~ g6_result_zero($reter) ~ "}",
                            nstr: $rv.state.nstr
                        ), $env))
                    }
                }
            } else if cgkind_eq($payload, $retok) && cgkind_eq($operr, $reter) && g5_question_final_owned_payload($payload) {
                # Str Ok payload: the Err arm is identical to the scalar path (its
                # `.err` retain/release is kind-driven via g6_result_retain/release),
                # but the SUCCESS arm must retain the owned `.ok` string into a
                # rebuilt Ok carrier temp BEFORE releasing the operand's slot —
                # native's shape is `guji_retain(gt0.ok); <success> = {0, gt0.ok,
                # <err zero>}; if (gt0.tag == 0) release(gt0.ok)`. Returning the raw
                # `$qtmp.ok` (the scalar `ret:`) would use-after-release the string.
                match g6_result_value($opkind, $expr, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($rv) {
                        $qtmp = g4_value_tmp($opkind, $rv.state.ntmp)
                        $rtmp = g4_value_tmp($retres, $rv.state.ntmp + 1)
                        $stmp = g4_value_tmp($retres, $rv.state.ntmp + 2)
                        Ok(mainout_with_cleanup(MainOut(
                            interns: $rv.state.interns,
                            decls: $rv.state.decls ~ g4_value_decl($opkind, $qtmp) ~ g4_value_decl($retres, $rtmp) ~ g4_value_decl($retres, $stmp),
                            body: $rv.state.body ~
                                "\t" ~ $qtmp ~ " = " ~ $rv.c ~ ";\n" ~
                                "\tif (" ~ $qtmp ~ ".tag != 0LL) \{\n" ~
                                "\t\t" ~ $rtmp ~ " = (" ~ g6_result_ctype($retres) ~ ")\{1LL, " ~ g6_result_zero($retok) ~ ", " ~ $qtmp ~ ".err};\n" ~
                                g6_result_retain($retres, $rtmp) ~
                                g6_result_release($opkind, $qtmp) ~
                                cg_env_release_strs($env) ~
                                "\t\treturn " ~ $rtmp ~ ";\n" ~
                                "\t}\n" ~
                                "\tguji_retain(" ~ $qtmp ~ ".ok);\n" ~
                                "\t" ~ $stmp ~ " = (" ~ g6_result_ctype($retres) ~ ")\{0LL, " ~ $qtmp ~ ".ok, " ~ g6_result_zero($reter) ~ "};\n" ~
                                g6_result_release($opkind, $qtmp),
                            ret: $stmp,
                            nstr: $rv.state.nstr
                        ), $env))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_final_question_carrier($e: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[MainOut, Str] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                ETypeName($ctor) {
                    match $args {
                        ExprCons($arg, ExprNil) {
                            match $arg {
                                EQuestion($expr) {
                                    if $ctor == "Some" {
                                        match $retkind {
                                            ROpt($retopt) { g5_question_final_option($retopt, $expr, $state, $env) }
                                            _ { Err(g3_unsupported()) }
                                        }
                                    } else if $ctor == "Ok" {
                                        match $retkind {
                                            RRes($retres) { g5_question_final_result($retres, $expr, $state, $env) }
                                            _ { Err(g3_unsupported()) }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ {
                                    # P3b-2b-2b: non-direct question subexpressions in
                                    # the ctor argument. Hoist the left-spine `?` (its
                                    # carrier guard/early-return lands in the hoist
                                    # state), then lower the rebuilt final constructor
                                    # through the SAME general carrier value path a
                                    # question-free final `Some(...)`/`Ok(...)` takes.
                                    match $arg {
                                        EStr($text) {
                                            match g5_final_question_interpolation($ctor, $text, $state, $env, $retkind) {
                                                Ok($out) { Ok($out) }
                                                Err($not_interp) {
                                                    match g5_question_hoist_all($arg, $state, $env, $retkind) {
                                                        Err($m) { Err($m) }
                                                        Ok(None) { Err(g3_unsupported()) }
                                                        Ok(Some($h)) {
                                                            match g5_ret_value_kind($retkind) {
                                                                None { Err(g3_unsupported()) }
                                                                Some($k) {
                                                                    match g4_lower_value($k, ECall(ETypeName($ctor), ExprCons($h.expr, ExprNil)), $h.state, $h.env) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $h.env)) }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ {
                                            match g5_question_hoist_all($arg, $state, $env, $retkind) {
                                                Err($m) { Err($m) }
                                                Ok(None) { Err(g3_unsupported()) }
                                                Ok(Some($h)) {
                                                    match g5_ret_value_kind($retkind) {
                                                        None { Err(g3_unsupported()) }
                                                        Some($k) {
                                                            match g4_lower_value($k, ECall(ETypeName($ctor), ExprCons($h.expr, ExprNil)), $h.state, $h.env) {
                                                                Err($m) { Err($m) }
                                                                Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $h.env)) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# The lambda return kinds whose owned ABI is complete. List and Map use the same
# owned value structs as named-sub returns: literals/calls already produce owned
# storage and bound values are copied before frame cleanup.
sub g5_lambda_ret_supported($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgList($el) { true }
        CgMap($v) { true }
        _ { false }
    }
}

# If `$e` is a call to a user sub whose return is Unit, lower it to a C statement
# `gf_f(args);` (its side effects are observable; the Unit result is discarded).
# Returns Ok(None) when `$e` is not such a call (e.g. a builtin like `print`, or a
# value-returning call), Err when the call's arguments are out of subset.
sub g11_internal_select_wait_state($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $callee {
        EName($name) {
            if $name == "__guji_select_wait" {
                match $args {
                    ExprCons($seen, ExprNil) {
                        match g3_int_rvalue_state($seen, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($sv) {
                                Ok(CgState(
                                    interns: $sv.state.interns,
                                    decls: $sv.state.decls,
                                    body: $sv.state.body ~ "\tguji_select_wait((uint64_t)" ~ $sv.c ~ ");\n",
                                    nstr: $sv.state.nstr,
                                    ntmp: $sv.state.ntmp
                                ))
                            }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_unit_call_code($e: Expr, $state: CgState, $env: CgEnv): Result[Option[CgState], Str] {
    match $e {
        ECall($callee, $args) {
            match g11_internal_select_wait_state($callee, $args, $state, $env) {
                Ok($next) { Ok(Some($next)) }
                Err($not_internal_wait) {
            match g4_panic_state($callee, $args, $state, $env) {
                Ok($next) { Ok(Some($next)) }
                Err($pm) {
                    match g4_handle_write_state($callee, $args, $state, $env) {
                        Ok($next) { Ok(Some($next)) }
                        Err($hw) {
                            match g4_result_unit_unwrap_state($callee, $args, $state, $env) {
                                Ok($next) { Ok(Some($next)) }
                                Err($nu) {
                                    match g7_each_value($callee, $args, $state, $env) {
                                        Ok($next) { Ok(Some($next)) }
                                        Err($me) { g5_unit_call_target($callee, $args, $state, $env) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
                }
            }
        }
        _ { Ok(None) }
    }
}

# The pre-`each` user-sub / prelude Unit-call resolution path, split out of
# g5_unit_call_code so the §15 `each` lowering can take precedence.
sub g5_unit_call_target($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[Option[CgState], Str] {
    match g5_resolve_call_target($callee, $args, $env) {
        Err($m) { Ok(None) }
        Ok($target) {
            $sig = $target.sig
            match $sig.ret {
                RUnit {
                    match g5_lower_call_args_state($sig.params, $target.args, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($ao) {
                            Ok(Some(CgState(
                                interns: $ao.state.interns,
                                decls: $ao.state.decls,
                                body: $ao.state.body ~ "\t" ~ $sig.cname ~ "(" ~ $ao.args ~ ");\n" ~ $ao.releases,
                                nstr: $ao.state.nstr,
                                ntmp: $ao.state.ntmp
                            )))
                        }
                    }
                }
                _ { Ok(None) }
            }
        }
    }
}

# Discard a value-position carrier CALL used as a bare statement
# (`make_some("x" ~ "y")` with its Option/Result result unused). Native evaluates
# the call into a fresh temp, marks it unused with `(void)(tmp);`, then releases the
# temp's active owned slot (a Some(Str) payload / an Err(Str) slot) — otherwise the
# heap payload leaks. We mirror that shape: infer the carrier kind, lower the value
# into a `gd`-temp, emit the `(void)` cast, and release via the kind's own release
# helper. Scoped to ECall so a bare bound-name statement (which would double-release
# a borrowed local) is left out; scalar-returning discards remain a separate GAP.
sub g5_carrier_discard($e: Expr, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $e {
        ECall($callee, $args) {
            match g6_option_kind_from_value($e, $env) {
                Ok($okind) {
                    match g4_lower_value($okind, $e, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($ov) {
                            $cn = "gd" ~ c_int($ov.state.ntmp)
                            Ok(CgState(
                                interns: $ov.state.interns,
                                decls: $ov.state.decls ~ g4_value_decl($okind, $cn),
                                body: $ov.state.body ~ "\t" ~ $cn ~ " = " ~ $ov.c ~ ";\n" ~ "\t(void)(" ~ $cn ~ ");\n" ~ g6_option_release($okind, $cn),
                                nstr: $ov.state.nstr,
                                ntmp: $ov.state.ntmp + 1
                            ))
                        }
                    }
                }
                Err($not_opt) {
                    match g6_result_kind_from_value($e, $env) {
                        Ok($rkind) {
                            match g4_lower_value($rkind, $e, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($rv) {
                                    $cn = "gd" ~ c_int($rv.state.ntmp)
                                    Ok(CgState(
                                        interns: $rv.state.interns,
                                        decls: $rv.state.decls ~ g4_value_decl($rkind, $cn),
                                        body: $rv.state.body ~ "\t" ~ $cn ~ " = " ~ $rv.c ~ ";\n" ~ "\t(void)(" ~ $cn ~ ");\n" ~ g6_result_release($rkind, $cn),
                                        nstr: $rv.state.nstr,
                                        ntmp: $rv.state.ntmp + 1
                                    ))
                                }
                            }
                        }
                        Err($not_res) { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EBinary($op, $left, $right) {
            # Discard a bare `$s ~~ /re/` statement (fixture match_carrier_ownership).
            if $op == "~~" {
                match g6_option_kind_from_value($e, $env) {
                    Ok($okind) {
                        match g4_lower_value($okind, $e, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($ov) {
                                $cn = "gd" ~ c_int($ov.state.ntmp)
                                Ok(CgState(
                                    interns: $ov.state.interns,
                                    decls: $ov.state.decls ~ g4_value_decl($okind, $cn),
                                    body: $ov.state.body ~ "\t" ~ $cn ~ " = " ~ $ov.c ~ ";\n" ~ "\t(void)(" ~ $cn ~ ");\n" ~ g6_option_release($okind, $cn),
                                    nstr: $ov.state.nstr,
                                    ntmp: $ov.state.ntmp + 1
                                ))
                            }
                        }
                    }
                    Err($m) { Err($m) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower a Unit-yielding statement in codegen statement position. The returned
# environment includes fresh bindings only for the lexical statement block being
# lowered; callers that lower child blocks (while/if branches) restore their outer
# environment after emitting cleanup for those block-local bindings.
# `$scope_base` is cg_env_len at the current block's entry (0 for a function body):
# §4 bind lowering uses it to distinguish same-frame immutable rebind panics from
# child-scope immutable shadows.
sub g5_lower_unit_stmt_scoped($s: Stmt, $state: CgState, $env: CgEnv, $scope_base: Int): Result[BindOut, Str] {
    match g3_as_print($s) {
        Some($arg) {
            match g3_lower_print($arg, $state, $env) {
                Err($m) { Err($m) }
                Ok($next) { Ok(BindOut(state: $next, env: $env)) }
            }
        }
        None {
            match g3_as_note($s) {
                Some($arg) {
                    match g3_lower_note($arg, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($next) { Ok(BindOut(state: $next, env: $env)) }
                    }
                }
                None {
                    match $s {
                        SBind($m, $n, $ty, $v) { g4_lower_bind_scoped($m, $n, $ty, $v, $state, $env, $scope_base) }
                        SExpr($e) {
                            match $e {
                                # A standalone Unit literal is an intentional
                                # no-op (commonly the empty branch of a
                                # statement match), exactly as native emits it.
                                EUnit { Ok(BindOut(state: $state, env: $env)) }
                                EIf($cond, $then, $elifs, $els) { g5_lower_if_guard($cond, $then, $elifs, $els, $state, $env, RUnit) }
                                EMatch($subj, $arms) { g6_lower_stmt_match($subj, $arms, $state, $env, RUnit) }
                                _ {
                                    match g5_unit_call_code($e, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok(Some($next)) { Ok(BindOut(state: $next, env: $env)) }
                                        Ok(None) {
                                            match g5_carrier_discard($e, $state, $env) {
                                                Ok($next) { Ok(BindOut(state: $next, env: $env)) }
                                                Err($md) { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        SWhile($cond, $body) { g5_lower_while($cond, $body, $state, $env, RUnit) }
                        SFor($vars, $iter, $body) { g5_lower_for($vars, $iter, $body, $state, $env, RUnit) }
                        SHatch($body) { g5_emit_hatch($body, $state, $env) }
                        SSelect($arms, $els) { g11_emit_select($arms, $els, $state, $env, RUnit) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g5_lower_unit_stmt($s: Stmt, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    g5_lower_unit_stmt_scoped($s, $state, $env, 0)
}

sub g5_lower_unit_stmts($stmts: StmtList, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $stmts {
        StmtNil { Ok(BindOut(state: $state, env: $env)) }
        StmtCons($head, $tail) {
            match g5_lower_unit_stmt($head, $state, $env) {
                Err($m) { Err($m) }
                Ok($first) { g5_lower_unit_stmts($tail, $first.state, $first.env) }
            }
        }
    }
}

# P3b-2b-2c-4: retkind-aware body walker for `while` loops. It is
# g5_lower_unit_stmts plus leading dispatches for statement `?` binds and nested
# `while` statements: a `?` guard's early `return` exits the function, so it must
# use the enclosing return carrier even inside recursive loop bodies. Non-`?`,
# non-while statements still fall to the ordinary unit-statement lowerer.
# P3b-2b-2c-4i: `$extra_cleanup` threads a statement-match arm's owned-scrutinee
# release into the in-loop `?` guard's early-return path (emitted before the full
# env release + C return, mirroring the 4f arm-body ordering); ordinary loop
# contexts pass "" and keep the original C byte-for-byte.
sub g5_lower_loop_stmts_extra($stmts: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    match $stmts {
        StmtNil { Ok(BindOut(state: $state, env: $env)) }
        StmtCons($head, $tail) {
            match g5_stmt_question_bind_extra($head, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(Some($qn)) { g5_lower_loop_stmts_extra($tail, $qn.state, $qn.env, $retkind, $extra_cleanup) }
                Ok(None) {
                    match g5_stmt_while_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok(Some($w)) { g5_lower_loop_stmts_extra($tail, $w.state, $w.env, $retkind, $extra_cleanup) }
                        Ok(None) {
                            match g5_stmt_for_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(Some($f)) { g5_lower_loop_stmts_extra($tail, $f.state, $f.env, $retkind, $extra_cleanup) }
                                Ok(None) {
                                    match g5_stmt_if_guard_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                        Err($m) { Err($m) }
                                        Ok(Some($g)) { g5_lower_loop_stmts_extra($tail, $g.state, $g.env, $retkind, $extra_cleanup) }
                                        Ok(None) {
                                            match g5_stmt_match_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                Err($m) { Err($m) }
                                                Ok(Some($g)) { g5_lower_loop_stmts_extra($tail, $g.state, $g.env, $retkind, $extra_cleanup) }
                                                Ok(None) {
                                                    match g5_stmt_select_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                        Err($m) { Err($m) }
                                                        Ok(Some($g)) { g5_lower_loop_stmts_extra($tail, $g.state, $g.env, $retkind, $extra_cleanup) }
                                                        Ok(None) {
                                                            match g5_lower_unit_stmt($head, $state, $env) {
                                                                Err($m) { Err($m) }
                                                                Ok($first) { g5_lower_loop_stmts_extra($tail, $first.state, $first.env, $retkind, $extra_cleanup) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_lower_loop_stmts($stmts: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g5_lower_loop_stmts_extra($stmts, $state, $env, $retkind, "")
}

# Lower §6.3 `while`. Conditions may need preparatory statements (for example a
# Str comparison), so the emitted C uses a `while (1)` shell and re-runs the
# lowered condition at the top of each iteration before deciding whether to
# break. Body-local heap bindings are released at the end of each iteration; the
# outer environment is restored after the loop.
#
# P3b-2b-2c-4 (`?` in a loop body): the body is walked by the retkind-aware
# g5_lower_loop_stmts so a statement-level `?` (bind/reassign) inside the loop
# lowers to the same guard shape native emits — its early `return` exits the whole
# function (releasing the FULL env in scope), so no per-iteration release runs on
# that path. Nested while statements recurse through the same walker with the
# enclosing return carrier.
sub g5_lower_while_extra($cond: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    $cond_start = g4_bodyless_state($state)
    match g4_bool_lower($cond, $cond_start, $env) {
        Err($m) { Err($m) }
        Ok($cv) {
            $body_start = g4_bodyless_state($cv.state)
            match g5_lower_loop_stmts_extra($body, $body_start, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($bo) {
                    $locals = cg_env_len($bo.env) - cg_env_len($env)
                    $releases = cg_env_release_strs_n($bo.env, $locals)
                    Ok(BindOut(
                        state: CgState(
                            interns: $bo.state.interns,
                            decls: $bo.state.decls,
                            body: $state.body ~ "\twhile (1) \{\n" ~
                                $cv.state.body ~
                                "\t\tif (!(" ~ $cv.c ~ ")) \{ break; }\n" ~
                                $bo.state.body ~
                                $releases ~
                                "\t}\n",
                            nstr: $bo.state.nstr,
                            ntmp: $bo.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
    }
}

sub g5_lower_while($cond: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g5_lower_while_extra($cond, $body, $state, $env, $retkind, "")
}

# P3b-2b-2c-4: dispatch a top-level `while` statement with the enclosing return kind
# so a `?` in its body can lower (via g5_lower_loop_stmts). Only SWhile is claimed
# (Ok(Some)); every other statement returns Ok(None) to fall through to the ordinary
# g5_lower_unit_stmt path unchanged. P3b-2b-2c-4i: the `_extra` variant carries a
# statement-match arm's owned-scrutinee cleanup into the loop body's `?` guards.
sub g5_stmt_while_stmt_extra($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $s {
        SWhile($cond, $body) {
            match g5_lower_while_extra($cond, $body, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($w) { Ok(Some($w)) }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_stmt_while_stmt($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    g5_stmt_while_stmt_extra($s, $state, $env, $retkind, "")
}

sub g5_for_single_var($vars: StrList): Result[Str, Str] {
    match $vars {
        StrCons($v, StrNil) { Ok($v) }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_for_elem_supported($elem: CgKind): Bool {
    match $elem {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        CgStr { true }
        CgEnum($name) { true }
        CgClass($name) { true }
        _ { false }
    }
}

# Map and list iteration may both borrow a collection-valued row from the
# owning iterator's storage. The scalar predicate stays shared; each path
# admits CgList/CgMap through its own wrapper so a future shape-specific
# restriction can land without re-coupling the two loops.
sub g5_for_map_elem_supported($elem: CgKind): Bool {
    match $elem {
        CgList($inner) { true }
        CgMap($val) { true }
        _ { g5_for_elem_supported($elem) }
    }
}

sub g5_for_list_elem_supported($elem: CgKind): Bool {
    match $elem {
        CgList($inner) { true }
        CgMap($val) { true }
        _ { g5_for_elem_supported($elem) }
    }
}

# A borrowed list row uses the ordinary by-value guji_slice_t view (listlen 0).
# A borrowed map row must use the negative sentinel so g7_map_var_* addresses
# its guji_map_t fields instead of inventing named `<cname>_keys` locals.
# Shared by map-value and list-element binders — both shallow-assign the same
# by-value ABI from the owning iterator.
sub g5_for_map_value_listlen($elem: CgKind): Int {
    match $elem {
        CgMap($val) { 0 - 1 }
        _ { 0 }
    }
}

# P8d-2c-3a/3b/3c: channel-`for` drains bound channels of non-owning
# scalars/scalar-enums plus owned Str / List / Map messages, including one nesting level
# (List[List[flat]], Map values of List/Map[flat]) via the shared payload
# predicates. I10g2b adds the already-supported Option/Result List/Map element
# ABIs; counted user-enum payloads remain I10g3.
sub g5_for_chan_elem_supported($elem: CgKind): Bool {
    match $elem {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        # Native admits carrier iteration for Option[Str] (unlike
        # Option[Int], whose generated C lacks its wrapper declaration).
        CgOptStr { true }
        CgOptList($inner) { g11_chan_carrier_list_elem_supported($inner) }
        CgOptMap($val) { g11_chan_map_val_supported($val) }
        CgRes($ok, $err) { g11_chan_result_elem_supported(CgRes($ok, $err)) }
        CgList($inner) { g11_chan_list_elem_supported($inner) }
        CgMap($val) { g11_chan_map_val_supported($val) }
        CgEnum($name) { true }
        CgFn($p, $r) { true }
        _ { false }
    }
}

# A received Str/List/Map/heap-enum is the channel's DETACHED owned copy adopted
# by the loop binder, so the binder must be released before every rebind, after
# the loop falls through, and on any early return out of the body. Scalars and
# scalar-only enums stay no-ops (their release helpers are empty).
sub g5_chan_for_release($elem: CgKind, $binder: Str): Str {
    match $elem {
        CgStr { "\tguji_release(" ~ $binder ~ ");\n" }
        CgOptStr { g6_option_release(CgOptStr, $binder) }
        CgOptList($inner) { g6_option_release(CgOptList($inner), $binder) }
        CgOptMap($val) { g6_option_release(CgOptMap($val), $binder) }
        CgRes($ok, $err) { g6_result_release(CgRes($ok, $err), $binder) }
        CgList($inner) { g7_slice_release($binder) }
        CgMap($val) { g7_map_value_release($binder) }
        CgEnum($name) { "\tguji_release_" ~ $name ~ "_fields(&" ~ $binder ~ ");\n" }
        CgFn($p, $r) { "\tguji_release(" ~ $binder ~ ".env);\n" }
        _ { "" }
    }
}

# Reset an owned binder to the safe releasable empty sentinel BEFORE the loop
# entry. The binder's decl init covers the first entry, but the loop may be
# re-entered (nested inside another loop) after its post-loop release left the
# binder dangling; without the reset the first release-before-rebind is a
# use-after-free. (Native emits this reset only when a loop NAME is reused and
# misses the re-entry case — a recorded native bug; see NATIVE_BACKEND_GAPS.md.)
sub g5_chan_for_reset($elem: CgKind, $binder: Str): Str {
    match $elem {
        CgStr { "\t" ~ $binder ~ " = GUJI_EMPTY_STR;\n" }
        CgOptStr { "\t" ~ $binder ~ " = (guji_opt_str)\{0};\n" }
        CgOptList($inner) { "\t" ~ $binder ~ " = " ~ g4_value_zero(CgOptList($inner)) ~ ";\n" }
        CgOptMap($val) { "\t" ~ $binder ~ " = " ~ g4_value_zero(CgOptMap($val)) ~ ";\n" }
        CgRes($ok, $err) { "\t" ~ $binder ~ " = " ~ g4_value_zero(CgRes($ok, $err)) ~ ";\n" }
        CgList($inner) { "\t" ~ $binder ~ " = (guji_slice_t)\{0};\n" }
        CgMap($val) { "\t" ~ $binder ~ " = (guji_map_t)\{0};\n" }
        CgEnum($name) { "\t" ~ $binder ~ " = (" ~ $name ~ ")\{0};\n" }
        CgFn($p, $r) { "\t" ~ $binder ~ " = (guji_fn_t)\{0};\n" }
        _ { "" }
    }
}

# Emit `for $x in $ch` (§17.4) as native's recv-until-None loop. Each iteration
# receives into an Option[T], breaks when the channel is closed and drained
# (tag==0), binds the payload, and runs the ordinary loop-body lowering.
# The channel handle and the binder BINDING stay borrowed (body reads never
# retain), but a Str/List/Map/heap-enum binder ADOPTS the detached owned message
# each iteration: it is reset before entry (re-entry safety), released before
# every rebind, released again after fall-through, and its release is threaded
# ahead of the enclosing cleanup for early returns (an alias `return $x` retains
# BEFORE that cleanup, so returning the current message is sound). Body-local
# owned values are still released at the end of every iteration by
# g5_lower_loop_stmts_extra.
sub g5_emit_for_chan($vname: Str, $ch: CgVar, $elem: CgKind, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    $recv_start = CgState(interns: $state.interns, decls: $state.decls, body: "", nstr: $state.nstr, ntmp: $state.ntmp)
    match g11_chan_recv_value($ch, $elem, ExprNil, $recv_start) {
        Err($m) { Err($m) }
        Ok($rv) {
            $binder = g4_value_tmp($elem, $rv.state.ntmp)
            $release = g5_chan_for_release($elem, $binder)
            $loop_env = CgEnvCons(CgVar(name: $vname, cname: $binder, kind: $elem, mutable: false, borrowed: true, listlen: g5_for_map_value_listlen($elem)), $env)
            $body_start = CgState(
                interns: $rv.state.interns,
                decls: $rv.state.decls ~ g4_value_decl($elem, $binder),
                body: "",
                nstr: $rv.state.nstr,
                ntmp: $rv.state.ntmp + 1
            )
            match g5_lower_loop_stmts_extra($body, $body_start, $loop_env, $retkind, $release ~ $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($bo) {
                    $locals = cg_env_len($bo.env) - cg_env_len($loop_env)
                    $releases = cg_env_release_strs_n($bo.env, $locals)
                    Ok(BindOut(
                        state: CgState(
                            interns: $bo.state.interns,
                            decls: $bo.state.decls,
                            body: $state.body ~
                                g5_chan_for_reset($elem, $binder) ~
                                "\tfor (;;) \{\n" ~
                                $rv.state.body ~
                                "\tif (" ~ $rv.c ~ ".tag == 0) \{\n" ~
                                "\t\tbreak;\n" ~
                                "\t}\n" ~
                                $release ~
                                "\t" ~ $binder ~ " = " ~ $rv.c ~ ".val;\n" ~
                                $bo.state.body ~
                                $releases ~
                                "\t}\n" ~
                                $release,
                            nstr: $bo.state.nstr,
                            ntmp: $bo.state.ntmp
                        ),
                        env: $env
                    ))
                }
            }
        }
    }
}

# Ok(None) means the iterator is not a channel expression and ordinary
# range/map/list dispatch should continue unchanged. A recognized channel with a
# still-unsupported payload (carrier/enum) declines honestly instead of being
# misrouted as a list iterator.
#
# Bound names (`for $x in $ch`) drain through the existing handle (no extra
# retain/release). Fresh/non-name iterators (`for $x in make_jobs()`, mirroring
# native materializeForChanIter) lower an owned handle temp via
# g11_chan_owned_value (RChan calls / channel() transfer their +1), drain, then
# guji_chan_release the temp after the loop.
sub g5_lower_for_chan($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $iter {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Ok(None) }
                Some($ch) {
                    match $ch.kind {
                        CgChan($elem) {
                            if g5_for_chan_elem_supported($elem) {
                                match g5_for_single_var($vars) {
                                    Err($m) { Err($m) }
                                    Ok($vname) {
                                        match g5_emit_for_chan($vname, $ch, $elem, $body, $state, $env, $retkind, $extra_cleanup) {
                                            Err($m) { Err($m) }
                                            Ok($bo) { Ok(Some($bo)) }
                                        }
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Ok(None) }
                    }
                }
            }
        }
        _ {
            match g11_chan_kind_from_value($iter, $env) {
                Err($ignore) { Ok(None) }
                Ok($ck) {
                    match $ck {
                        CgChan($elem) {
                            if g5_for_chan_elem_supported($elem) {
                                match g5_for_single_var($vars) {
                                    Err($m) { Err($m) }
                                    Ok($vname) {
                                        match g11_chan_owned_value($elem, $iter, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($cv) {
                                                $ch = CgVar(name: "", cname: $cv.c, kind: CgChan($elem), mutable: false, borrowed: true, listlen: 0)
                                                # Fall-through releases after the loop; early return must
                                                # release the same owned temp via extra_cleanup (I8c2b
                                                # stdin.lines() early-return LSan).
                                                $chan_rel = "\tguji_chan_release(" ~ $cv.c ~ ");\n"
                                                match g5_emit_for_chan($vname, $ch, $elem, $body, $cv.state, $env, $retkind, $chan_rel ~ $extra_cleanup) {
                                                    Err($m) { Err($m) }
                                                    Ok($bo) {
                                                        Ok(Some(BindOut(
                                                            state: CgState(
                                                                interns: $bo.state.interns,
                                                                decls: $bo.state.decls,
                                                                body: $bo.state.body ~ $chan_rel,
                                                                nstr: $bo.state.nstr,
                                                                ntmp: $bo.state.ntmp
                                                            ),
                                                            env: $env
                                                        )))
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Ok(None) }
                    }
                }
            }
        }
    }
}

# §6.3 `for` dispatch, mirroring native emitFor's iterator switch: a SYNTACTIC
# range iterator (`from .. to` / `from ..< to`, ast.RangeExpr in the oracle,
# EBinary here) takes the dedicated Int range loop; everything else falls through
# to the list path. Native routes ONLY syntactic ranges — a range stored in a
# binding is a native codegen reject — so the same holds here (a non-range
# iterator that is not a lowerable list declines as before).
sub g5_lower_for($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g5_lower_for_extra($vars, $iter, $body, $state, $env, $retkind, "")
}

# Range `for` (§6.3 over §5.4 ranges), a port of native emitFor's *ast.RangeExpr
# branch: both bounds are captured ONCE into fresh Int temps (they may be
# arbitrary Int expressions, and lo is read twice — the empty-range guard and the
# loop init); a half-open `..<` decrements the captured hi unless hi == INT64_MIN
# (such a range is always empty and the decrement would overflow, so lo/hi are
# forced to 0/-1 instead); the loop guards the empty range with `if (lo <= hi)`
# and breaks AFTER yielding the final element so the counter is never advanced
# past hi — `guji_add(INT64_MAX, 1)` would otherwise panic (§5.4/§6.3 boundary
# termination, conformance bug #3). Ok(None) = not a syntactic range `for`.
sub g5_lower_for_range($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $iter {
        EBinary($op, $from, $to) {
            if $op == ".." || $op == "..<" {
                match g5_for_single_var($vars) {
                    Err($m) { Err($m) }
                    Ok($vname) {
                        match g4_lower_value(CgInt, $from, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($fo) {
                                match g4_lower_value(CgInt, $to, $fo.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($tv) { g5_emit_for_range($op, $vname, $body, $fo.c, $tv, $env, $retkind, $extra_cleanup) }
                                }
                            }
                        }
                    }
                }
            } else {
                Ok(None)
            }
        }
        _ { Ok(None) }
    }
}

# The half-open (`..<`) bound adjustment, emitted between the hi capture and the
# empty-range guard. `From ..< INT64_MIN` is always empty (every From >=
# INT64_MIN) and `hi - 1` would overflow, so that case forces an empty lo>hi pair
# exactly as native does.
sub g5_range_open_adjust($open: Bool, $lo: Str, $hi: Str): Str {
    if $open {
        "\tif (" ~ $hi ~ " == INT64_MIN) \{\n" ~
            "\t\t" ~ $lo ~ " = (int64_t)0;\n" ~
            "\t\t" ~ $hi ~ " = (int64_t)-1;\n" ~
            "\t} else \{\n" ~
            "\t\t" ~ $hi ~ " = " ~ $hi ~ " - 1;\n" ~
            "\t}\n"
    } else {
        ""
    }
}

# Emit the captured-bounds range loop. The loop variable is a borrowed Int
# binding (nothing owned: no iterator cleanup, so body early returns carry only
# the enclosing context's `$extra_cleanup`); body-local owned bindings are
# released at the end of each iteration, BEFORE the final-element break test, so
# the last iteration releases too.
sub g5_emit_for_range($op: Str, $vname: Str, $body: StmtList, $from_c: Str, $tv: CgValueOut, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    $lo = g4_value_tmp(CgInt, $tv.state.ntmp)
    $hi = g4_value_tmp(CgInt, $tv.state.ntmp + 1)
    $binder = g4_value_tmp(CgInt, $tv.state.ntmp + 2)
    $open = $op == "..<"
    $loop_env = CgEnvCons(CgVar(name: $vname, cname: $binder, kind: CgInt, mutable: false, borrowed: true, listlen: 0), $env)
    $body_start = CgState(
        interns: $tv.state.interns,
        decls: $tv.state.decls ~ g4_value_decl(CgInt, $lo) ~ g4_value_decl(CgInt, $hi) ~ g4_value_decl(CgInt, $binder),
        body: "",
        nstr: $tv.state.nstr,
        ntmp: $tv.state.ntmp + 3
    )
    match g5_lower_loop_stmts_extra($body, $body_start, $loop_env, $retkind, $extra_cleanup) {
        Err($m) { Err($m) }
        Ok($bo) {
            $locals = cg_env_len($bo.env) - cg_env_len($loop_env)
            $releases = cg_env_release_strs_n($bo.env, $locals)
            Ok(Some(BindOut(
                state: CgState(
                    interns: $bo.state.interns,
                    decls: $bo.state.decls,
                    body: $tv.state.body ~
                        "\t" ~ $lo ~ " = " ~ $from_c ~ ";\n" ~
                        "\t" ~ $hi ~ " = " ~ $tv.c ~ ";\n" ~
                        g5_range_open_adjust($open, $lo, $hi) ~
                        "\tif (" ~ $lo ~ " <= " ~ $hi ~ ") \{\n" ~
                        "\tfor (" ~ $binder ~ " = " ~ $lo ~ "; ; " ~ $binder ~ " = guji_add(" ~ $binder ~ ", 1)) \{\n" ~
                        $bo.state.body ~
                        $releases ~
                        "\t\tif (" ~ $binder ~ " == " ~ $hi ~ ") break;\n" ~
                        "\t}\n" ~
                        "\t}\n",
                    nstr: $bo.state.nstr,
                    ntmp: $bo.state.ntmp
                ),
                env: $env
            )))
        }
    }
}

# Emit §6.3 `for $key, $value in %map { ... }`. The map storage is viewed through
# g7_map_var_* so both two-array map locals and by-value guji_map_t fields/calls
# share one path. Iteration order is the native/interpreter sorted-key order via
# guji_map_order. The key and value loop bindings borrow from the map for one
# iteration; the heap order array, plus any owned map-value iterator, is threaded
# into the loop body's early-return cleanup and released after fall-through. The
# enclosing context's `$extra_cleanup` joins the early-return chain AFTER this
# loop's own releases but is NOT emitted on fall-through — the outer context
# releases its own storage when control returns to it.
sub g5_emit_for_map($kname: Str, $vname: Str, $mapvar: CgVar, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $iter_cleanup: Str, $extra_cleanup: Str): Result[BindOut, Str] {
    match $mapvar.kind {
        CgMap($val) {
            if g5_for_map_elem_supported($val) {
                match g7_list_c_type($val) {
                    Err($m) { Err($m) }
                    Ok($vctype) {
                        $order = "go" ~ c_int($state.ntmp)
                        $idx = "gi" ~ c_int($state.ntmp + 1)
                        $keybind = g4_value_tmp(CgStr, $state.ntmp + 2)
                        $valbind = g4_value_tmp($val, $state.ntmp + 3)
                        $loop_cleanup = "\tguji_release((const void*)" ~ $order ~ ");\n" ~ $iter_cleanup ~ $extra_cleanup
                        $loop_env = CgEnvCons(
                            CgVar(name: $vname, cname: $valbind, kind: $val, mutable: false, borrowed: true, listlen: g5_for_map_value_listlen($val)),
                            CgEnvCons(CgVar(name: $kname, cname: $keybind, kind: CgStr, mutable: false, borrowed: true, listlen: 0), $env)
                        )
                        $body_start = CgState(
                            interns: $state.interns,
                            decls: $state.decls ~
                                "\tint64_t* " ~ $order ~ " = NULL;\n" ~
                                "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                g4_value_decl(CgStr, $keybind) ~
                                g4_value_decl($val, $valbind),
                            body: "",
                            nstr: $state.nstr,
                            ntmp: $state.ntmp + 4
                        )
                        match g5_lower_loop_stmts_extra($body, $body_start, $loop_env, $retkind, $loop_cleanup) {
                            Err($m) { Err($m) }
                            Ok($bo) {
                                $locals = cg_env_len($bo.env) - cg_env_len($loop_env)
                                $releases = cg_env_release_strs_n($bo.env, $locals)
                                Ok(BindOut(
                                    state: CgState(
                                        interns: $bo.state.interns,
                                        decls: $bo.state.decls,
                                        body: $state.body ~
                                            "\t" ~ $order ~ " = (int64_t*)guji_arr_alloc(GUJI_KIND_ARR_SCALAR, sizeof(int64_t), " ~ g7_map_var_len($mapvar) ~ ");\n" ~
                                            "\tguji_map_order(" ~ g7_map_var_keys($mapvar) ~ ", " ~ g7_map_var_len($mapvar) ~ ", " ~ $order ~ ");\n" ~
                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ g7_map_var_len($mapvar) ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                            "\t\t" ~ $keybind ~ " = " ~ g7_map_var_keys($mapvar) ~ "[" ~ $order ~ "[" ~ $idx ~ "]];\n" ~
                                            "\t\t" ~ $valbind ~ " = " ~ g7_map_var_vals_typed($mapvar, $vctype) ~ "[" ~ $order ~ "[" ~ $idx ~ "]];\n" ~
                                            $bo.state.body ~
                                            $releases ~
                                            "\t}\n" ~
                                            "\tguji_release((const void*)" ~ $order ~ ");\n" ~
                                            $iter_cleanup,
                                        nstr: $bo.state.nstr,
                                        ntmp: $bo.state.ntmp
                                    ),
                                    env: $env
                                ))
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_lower_for_map_value($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $vars {
        StrCons($kname, StrCons($vname, StrNil)) {
            match g7_map_val_kind_from_value($iter, $env) {
                Err($m) { Ok(None) }
                Ok($val) {
                    match g7_lower_map_value($val, $iter, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($mv) {
                            match g5_emit_for_map(
                                $kname,
                                $vname,
                                CgVar(name: "", cname: $mv.c, kind: CgMap($val), mutable: false, borrowed: true, listlen: 0 - 1),
                                $body,
                                $mv.state,
                                $env,
                                $retkind,
                                g7_map_value_release($mv.c),
                                $extra_cleanup
                            ) {
                                Err($m) { Err($m) }
                                Ok($bo) { Ok(Some($bo)) }
                            }
                        }
                    }
                }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_lower_for_map($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $vars {
        StrCons($kname, StrCons($vname, StrNil)) {
            match g7_map_receiver_var($iter, $env) {
                Ok($mapvar) {
                    match g5_emit_for_map($kname, $vname, $mapvar, $body, $state, $env, $retkind, "", $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($bo) { Ok(Some($bo)) }
                    }
                }
                Err($not_recv) { g5_lower_for_map_value($vars, $iter, $body, $state, $env, $retkind, $extra_cleanup) }
            }
        }
        _ { Ok(None) }
    }
}

# Lower §6.3 `for $x in @list { ... }` for scalar/Str AND collection-element list
# iterators (`for @inner in @nested`, `for %row in @rows`). The iterator expression
# is materialized to an owned `guji_slice_t`; the loop variable borrows the current
# element from that owned slice for one iteration (List rows: by-value
# `guji_slice_t` with listlen 0; Map rows: by-value `guji_map_t` with listlen -1
# so body ops address `.keys`/`.vals`/`.len`). Body-local owned bindings are
# released at the end of each iteration. Any early `?`/guard return from inside
# the body releases the iterator slice first, then the enclosing context's
# `$extra_cleanup`; fall-through releases only the slice (the outer context owns
# its own cleanup). Do not retain/release the borrowed row — the iterator owns it.
sub g5_lower_for_list($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    match g5_for_single_var($vars) {
        Err($m) { Err($m) }
        Ok($vname) {
            match g7_list_kind_from_value($iter, $env) {
                Err($m) { Err($m) }
                Ok($elem) {
                    if g5_for_list_elem_supported($elem) {
                        match g7_list_c_type($elem) {
                            Err($m) { Err($m) }
                            Ok($ctype) {
                                match g7_lower_list_value($elem, $iter, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($src) {
                                        $idx = "gi" ~ c_int($src.state.ntmp)
                                        $binder = g4_value_tmp($elem, $src.state.ntmp + 1)
                                        $loop_env = CgEnvCons(CgVar(name: $vname, cname: $binder, kind: $elem, mutable: false, borrowed: true, listlen: g5_for_map_value_listlen($elem)), $env)
                                        $body_start = CgState(
                                            interns: $src.state.interns,
                                            decls: $src.state.decls ~ "\tint64_t " ~ $idx ~ " = 0;\n" ~ g4_value_decl($elem, $binder),
                                            body: "",
                                            nstr: $src.state.nstr,
                                            ntmp: $src.state.ntmp + 2
                                        )
                                        match g5_lower_loop_stmts_extra($body, $body_start, $loop_env, $retkind, g7_slice_release($src.c) ~ $extra_cleanup) {
                                            Err($m) { Err($m) }
                                            Ok($bo) {
                                                $locals = cg_env_len($bo.env) - cg_env_len($loop_env)
                                                $releases = cg_env_release_strs_n($bo.env, $locals)
                                                Ok(BindOut(
                                                    state: CgState(
                                                        interns: $bo.state.interns,
                                                        decls: $bo.state.decls,
                                                        body: $src.state.body ~
                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                            "\t\t" ~ $binder ~ " = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                            $bo.state.body ~
                                                            $releases ~
                                                            "\t}\n" ~
                                                            g7_slice_release($src.c),
                                                        nstr: $bo.state.nstr,
                                                        ntmp: $bo.state.ntmp
                                                    ),
                                                    env: $env
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

# P5b-2b-nested-for-cleanup: `$extra_cleanup` is the ENCLOSING context's owned
# cleanup (an outer loop's iterator slice/map temp + map order array, or a
# statement-match arm's owned scrutinee). It is threaded into each `for` shape's
# body walker so an early `return` inside the nested body releases inner-owned
# storage FIRST (this loop's own iterator/order), then the outer cleanup, then
# the full env — mirroring g5_lower_while_extra. Fall-through emits only the
# loop's OWN cleanup; the outer context releases its storage itself.
sub g5_lower_for_extra($vars: StrList, $iter: Expr, $body: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    match g5_lower_for_chan($vars, $iter, $body, $state, $env, $retkind, $extra_cleanup) {
        Err($m) { Err($m) }
        Ok(Some($r)) { Ok($r) }
        Ok(None) {
            match g5_lower_for_range($vars, $iter, $body, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok(Some($r)) { Ok($r) }
                Ok(None) {
                    match g5_lower_for_map($vars, $iter, $body, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok(Some($r)) { Ok($r) }
                        Ok(None) { g5_lower_for_list($vars, $iter, $body, $state, $env, $retkind, $extra_cleanup) }
                    }
                }
            }
        }
    }
}

sub g5_stmt_for_stmt_extra($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $s {
        SFor($vars, $iter, $body) {
            match g5_lower_for_extra($vars, $iter, $body, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($f) { Ok(Some($f)) }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_stmt_for_stmt($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    g5_stmt_for_stmt_extra($s, $state, $env, $retkind, "")
}

# ---- P8e: hatch task emission (§17.1) ----------------------------------------
# Int/Bool/Float copy by value; Chan handles retain into the task env; Str values
# deep-copy so the child task owns a detached value on its per-task heap. The
# malloc'd env transfers those owned fields into child locals, whose ordinary
# frame cleanup releases them before the wrapper frees the raw env shell.

# Native classFieldNativeType / hatchCopyEnum class walk: Int/Bool/Float/Str
# plus List over a flat scalar/Str leaf. Map/Option/nested class-or-enum class
# fields are not detached by hatchCopyEnum (native rejects Map class fields at
# definition); decline those shapes for hatch capture rather than shallow-copy.
sub g5_hatch_class_field_ok($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgList($el) { g5_hatch_flat_elem($el) }
        _ { false }
    }
}

sub g5_hatch_class_fields_ok($fs: CgClassFieldInfoList): Bool {
    match $fs {
        CgClassFieldNil { true }
        CgClassFieldCons($h, $t) {
            if g5_hatch_class_field_ok($h.kind) {
                g5_hatch_class_fields_ok($t)
            } else {
                false
            }
        }
    }
}

sub g5_hatch_class_payload_ok($env: CgEnv, $name: Str): Bool {
    match cg_env_lookup_class($env, $name) {
        Some($info) { g5_hatch_class_fields_ok($info.fields) }
        None { false }
    }
}

# Hatch enum field boundary = channel enum boundary PLUS by-value class
# payloads (native enumHatchCopyable). Channel send must keep rejecting
# CgClass via g11_chan_enum_field_supported — do not widen that path.
# Nested List/Map enum payloads share the channel predicate
# (g6e_enum_collection_elem_supported): guji_copy_arr already cascades.
sub g5_hatch_enum_field_supported($env: CgEnv, $k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        # Scalar Option carriers are fixed by-value structs with no counted
        # payload. A hatch task can therefore snapshot them with the enclosing
        # enum's ordinary struct copy.
        CgOptInt { true }
        CgOptBool { true }
        CgOptFloat { true }
        CgList($el) { g6e_enum_collection_elem_supported($el) }
        CgMap($v) { g6e_enum_collection_elem_supported($v) }
        CgBoxEnum($n) { true }
        CgClass($n) { g5_hatch_class_payload_ok($env, $n) }
        _ { false }
    }
}

sub g5_hatch_enum_fields_one_supported($env: CgEnv, $fs: CgKindList): Bool {
    match $fs {
        CgKindNil { true }
        CgKindCons($h, $t) {
            if g5_hatch_enum_field_supported($env, $h) {
                g5_hatch_enum_fields_one_supported($env, $t)
            } else {
                false
            }
        }
    }
}

sub g5_hatch_enum_fields_supported($env: CgEnv, $vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { true }
        CgVarCons($h, $t) {
            if g5_hatch_enum_fields_one_supported($env, $h.fields) {
                g5_hatch_enum_fields_supported($env, $t)
            } else {
                false
            }
        }
    }
}

sub g5_hatch_enum_capturable($env: CgEnv, $name: Str): Bool {
    match cg_env_lookup_enum($env, $name) {
        Some($info) { g5_hatch_enum_fields_supported($env, $info.variants) }
        None { false }
    }
}

# I10g2: Option/Result hatch captures. Scalar arms copy by value; counted
# Str/List/Map arms detach through g11_chan_send_fill (same as channel send)
# so the task owns an independent rc==1 payload. I10g4 admits Match/Bush
# Option carriers the same way (guji_match_copy / guji_bush_copy).
sub g5_hatch_option_capturable($k: CgKind): Bool {
    match $k {
        CgOptInt { true }
        CgOptBool { true }
        CgOptFloat { true }
        CgOptStr { true }
        CgOptMatch { true }
        CgOptBush { true }
        CgOptList($inner) { g5_hatch_list_elem_ok($inner) }
        CgOptMap($v) { g5_hatch_map_val_ok($v) }
        _ { false }
    }
}

sub g5_hatch_result_slot_text_ok($k: CgKind): Bool {
    g11_chan_result_slot_ok($k)
}

sub g5_hatch_result_capturable($k: CgKind): Bool {
    match $k {
        CgRes($ok, $err) {
            g5_hatch_result_slot_text_ok($ok) && g5_hatch_result_slot_text_ok($err)
        }
        _ { false }
    }
}

sub g5_hatch_carrier_owned($k: CgKind): Bool {
    match $k {
        CgOptStr { true }
        CgOptMatch { true }
        CgOptBush { true }
        CgOptList($inner) { true }
        CgOptMap($v) { true }
        CgRes($ok, $err) {
            match $ok {
                CgStr { true }
                CgMatch { true }
                CgBush { true }
                CgList($el) { true }
                CgMap($v) { true }
                _ {
                    match $err {
                        CgStr { true }
                        CgMatch { true }
                        CgBush { true }
                        CgList($el) { true }
                        CgMap($v) { true }
                        _ { false }
                    }
                }
            }
        }
        _ { false }
    }
}

sub g5_hatch_capturable($env: CgEnv, $k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgMatch { true }
        CgBush { true }
        CgChan($el) { true }
        CgList($el) { g5_hatch_list_elem_ok($el) }
        CgMap($v) { g5_hatch_map_val_ok($v) }
        # Direct class captures use the same native class-field boundary and
        # detach walker as by-value class payloads inside captured enums.
        CgClass($name) { g5_hatch_class_payload_ok($env, $name) }
        # Native enumHatchCopyable: scalar fields copy by value; active
        # Str/List/Map fields detach through the same machinery as channel
        # messages; recursive self-box graphs use the generated deep clone;
        # by-value class payloads embed in the enum struct and detach their
        # Str/List members inline (P8e-7).
        CgEnum($name) { g5_hatch_enum_capturable($env, $name) }
        CgOptInt { g5_hatch_option_capturable($k) }
        CgOptBool { g5_hatch_option_capturable($k) }
        CgOptFloat { g5_hatch_option_capturable($k) }
        CgOptStr { g5_hatch_option_capturable($k) }
        CgOptMatch { g5_hatch_option_capturable($k) }
        CgOptBush { g5_hatch_option_capturable($k) }
        CgOptList($inner) { g5_hatch_option_capturable($k) }
        CgOptMap($v) { g5_hatch_option_capturable($k) }
        CgRes($ok, $err) { g5_hatch_result_capturable($k) }
        _ { false }
    }
}

# Function values cross a hatch boundary as the ordinary `guji_fn_t` pair. The
# closure environment is immutable (§7.4), so retaining it into the task and
# adopting that owned reference in the child preserves the same lexical snapshot
# while the parent frame may exit. I10d1 first proved this machinery with the
# evaluator's private helper; I10g1 opens the same ownership path to every CgFn.
# Note: D's eval_hatch must still deep-snapshot guest Values before capture
# (I12a) — a shared guest Env races on non-atomic Str/class RC even when the
# host Func Env retain is correct for the compiled ABI.
sub g5_hatch_var_capturable($env: CgEnv, $v: CgVar): Bool {
    match $v.kind {
        CgFn($p, $r) { true }
        _ { g5_hatch_capturable($env, $v.kind) }
    }
}

sub g5_hatch_flat_elem($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        _ { false }
    }
}

# Native isHatchListCapture: a hatch-captured List deep-copies into the task
# heap for scalar/Str elements plus ONE nesting level — List[scalar/Str] and
# Map[Str, scalar/Str] rows detach through the KIND-tagged guji_copy_arr.
# Deeper nesting (e.g. List[List[List[Int]]]) is a native capture reject
# ("hatch capture ... codegen supports ..."); mirror that boundary.
sub g5_hatch_list_elem_ok($el: CgKind): Bool {
    match $el {
        CgList($inner) { g5_hatch_flat_elem($inner) }
        CgMap($v) { g5_hatch_flat_elem($v) }
        _ { g5_hatch_flat_elem($el) }
    }
}

# Native isHatchMapCapture: same one-nesting-level value boundary as List —
# scalar/Str values, or List/Map values whose inner element is scalar/Str.
# Map[Str, List[List[Int]]] etc. are native capture rejects; mirror that.
sub g5_hatch_map_val_ok($v: CgKind): Bool {
    g5_hatch_list_elem_ok($v)
}

# `$ch` / `@xs` / `%m` → `cap_ch` / `cap_xs` / `cap_m` (native captureFieldName).
sub g5_hatch_cap_field($name: Str): Str {
    @cs = split($name, "")
    if @cs.count() == 0 {
        "cap_"
    } else {
        $c0 = at(@cs, 0)
        if $c0 == "$" || $c0 == "@" || $c0 == "%" {
            "cap_" ~ drop(@cs, 1).join("")
        } else {
            "cap_" ~ $name
        }
    }
}

sub g5_collect_hatch_captures($root: CgEnv, $scan: CgEnv, $refs: StrList, $bound: StrList, $acc: CgEnv): CgEnv {
    match $scan {
        CgEnvNil { $acc }
        CgEnvCons($h, $t) {
            $take = g5_hatch_var_capturable($root, $h) && strlist_contains($refs, $h.name) && (!strlist_contains($bound, $h.name)) && capture_absent($acc, $h.name)
            if $take {
                g5_collect_hatch_captures($root, $t, $refs, $bound, cg_env_append_var($acc, $h))
            } else {
                g5_collect_hatch_captures($root, $t, $refs, $bound, $acc)
            }
        }
        CgEnvSub($s, $t) { g5_collect_hatch_captures($root, $t, $refs, $bound, $acc) }
        CgEnvEnum($e, $t) { g5_collect_hatch_captures($root, $t, $refs, $bound, $acc) }
        CgEnvClass($c, $t) { g5_collect_hatch_captures($root, $t, $refs, $bound, $acc) }
        CgEnvSubIdx($i, $t) { g5_collect_hatch_captures($root, $t, $refs, $bound, $acc) }
    }
}

# Native sorts hatch captures by source name before laying out the env struct.
sub g5_hatch_caps_insert($sorted: CgEnv, $v: CgVar): CgEnv {
    match $sorted {
        CgEnvNil { CgEnvCons($v, CgEnvNil) }
        CgEnvCons($h, $t) {
            if $v.name < $h.name {
                CgEnvCons($v, $sorted)
            } else {
                CgEnvCons($h, g5_hatch_caps_insert($t, $v))
            }
        }
        _ { CgEnvCons($v, CgEnvNil) }
    }
}

sub g5_hatch_caps_sort($caps: CgEnv): CgEnv {
    match $caps {
        CgEnvNil { CgEnvNil }
        CgEnvCons($h, $t) { g5_hatch_caps_insert(g5_hatch_caps_sort($t), $h) }
        _ { CgEnvNil }
    }
}

# Every free local the body references must be in the admitted capture set.
sub g5_hatch_free_ok($env: CgEnv, $refs: StrList, $bound: StrList): Bool {
    match $refs {
        StrNil { true }
        StrCons($n, $t) {
            if strlist_contains($bound, $n) {
                g5_hatch_free_ok($env, $t, $bound)
            } else {
                match cg_env_lookup($env, $n) {
                    None { g5_hatch_free_ok($env, $t, $bound) }
                    Some($v) {
                        if g5_hatch_var_capturable($env, $v) {
                            g5_hatch_free_ok($env, $t, $bound)
                        } else {
                            false
                        }
                    }
                }
            }
        }
    }
}

sub g5_hatch_env_fields($caps: CgEnv): Str {
    match $caps {
        CgEnvNil { "" }
        CgEnvCons($h, $t) {
            "\t" ~ g5_kind_ctype($h.kind) ~ " " ~ g5_hatch_cap_field($h.name) ~ ";\n" ~ g5_hatch_env_fields($t)
        }
        _ { "" }
    }
}

# Copy-on-capture for a List binding (native hatchCopyList): the env slice must
# share NO heap pointers with the parent (per-task heaps, non-atomic RC).
# Slice-form locals (listlen 0), non-empty Str-literal arrays, and every
# nested-element form are header-backed, so one KIND-tagged guji_copy_arr
# detaches the whole element graph at any admitted depth (native's heap path).
# Fixed scalar literals and the borrowed empty literal are headerless STACK
# storage guji_copy_arr cannot read: allocate fresh counted storage and copy
# element-wise (native's fixed path; Str slots get guji_str_copy). The loop
# index is block-scoped, so the stateless fill needs no function-scope temp.
sub g5_hatch_fill_list($el: CgKind, $var: CgVar, $etmp: Str, $field: Str): Str {
    $dst = $etmp ~ "->" ~ $field
    $len = g7_list_var_len($var)
    $raw = if $var.listlen == 0 { $var.cname ~ ".data" } else { $var.cname ~ "_data" }
    $stack = if $var.listlen == 0 {
        false
    } else {
        match $el {
            CgStr { $var.borrowed }
            CgList($inner) { false }
            CgMap($v) { false }
            _ { true }
        }
    }
    if $stack {
        $ct = match $el { CgFloat { "double" } CgStr { "const char*" } _ { "int64_t" } }
        $ak = match $el { CgStr { "GUJI_KIND_ARR_STR" } _ { "GUJI_KIND_ARR_SCALAR" } }
        $one = match $el {
            CgStr { "guji_str_copy(" ~ $raw ~ "[ghlc])" }
            _ { $raw ~ "[ghlc]" }
        }
        "\t\{ int64_t ghlc = 0;\n" ~
        "\t" ~ $dst ~ ".len = " ~ $len ~ ";\n" ~
        "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ct ~ "), " ~ $len ~ ");\n" ~
        "\tfor (ghlc = 0; ghlc < " ~ $len ~ "; ghlc = guji_add(ghlc, 1)) \{\n" ~
        "\t\t((" ~ $ct ~ "*)" ~ $dst ~ ".data)[ghlc] = " ~ $one ~ ";\n" ~
        "\t}\n" ~
        "\t}\n"
    } else {
        "\t" ~ $dst ~ ".len = " ~ $len ~ ";\n" ~
        "\t" ~ $dst ~ ".data = guji_copy_arr((const void*)" ~ $raw ~ ");\n"
    }
}

# Copy-on-capture for a Map binding (native hatchCopyMap): env stores a
# guji_map_t whose keys/vals share NO heap pointers with the parent. Selfhost
# map bindings ALWAYS allocate via guji_arr_alloc (named two-array form and
# struct-form views alike are header-backed), so both arrays detach through
# KIND-tagged guji_copy_arr — keys are ARR_STR (each slot guji_str_copy'd by
# the runtime), vals cascade through ARR_SCALAR/ARR_STR/ARR_SLICE/ARR_MAP.
# Native's headerless fixed-literal map path is unreachable here; do not emit
# an element-wise alloc+loop fill for maps.
sub g5_hatch_fill_map($val: CgKind, $var: CgVar, $etmp: Str, $field: Str): Str {
    $dst = $etmp ~ "->" ~ $field
    "\t" ~ $dst ~ ".len = " ~ g7_map_var_len($var) ~ ";\n" ~
    "\t" ~ $dst ~ ".keys = (const char**)guji_copy_arr((const void*)" ~ g7_map_var_keys($var) ~ ");\n" ~
    "\t" ~ $dst ~ ".vals = guji_copy_arr((const void*)" ~ g7_map_var_vals($var) ~ ");\n"
}

# Native hatchCopyEnum class walk: after the enum struct copy, replace each
# active by-value class payload's Str/List members with private copies. Class
# structs use indexed fN members (selfhost layout); scalar class fields need
# no rewrite.
sub g5_hatch_copy_class_fields($fs: CgClassFieldInfoList, $base: Str): Str {
    match $fs {
        CgClassFieldNil { "" }
        CgClassFieldCons($f, $t) {
            $member = $base ~ ".f" ~ c_int($f.index)
            $one = match $f.kind {
                CgStr { "\t\t" ~ $member ~ " = guji_str_copy(" ~ $member ~ ");\n" }
                CgList($el) {
                    "\t\t" ~ $member ~ ".data = guji_copy_arr((const void*)" ~ $member ~ ".data);\n"
                }
                _ { "" }
            }
            $one ~ g5_hatch_copy_class_fields($t, $base)
        }
    }
}

# Hatch enum detach: channel Str/List/Map field copies plus by-value class
# payload walks (P8e-7). Keep g11_chan_enum_copy_* free of CgClass so Chan
# send stays a native-matched reject for class-field enums.
sub g5_hatch_enum_copy_one_fields($env: CgEnv, $allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int, $msg: Str, $src: Str): Str {
    match $fields {
        CgKindNil { "" }
        CgKindCons($fk, $rest) {
            $one = match $fk {
                CgStr {
                    $dst = g6e_field_accessor($allvars, $msg, $idx, CgStr)
                    $from = g6e_field_accessor($allvars, $src, $idx, CgStr)
                    "\t\t" ~ $dst ~ " = guji_str_copy(" ~ $from ~ ");\n"
                }
                CgList($el) {
                    $dst = g6e_field_accessor($allvars, $msg, $idx, CgList($el))
                    $from = g6e_field_accessor($allvars, $src, $idx, CgList($el))
                    "\t\t" ~ $dst ~ ".data = guji_copy_arr((const void*)" ~ $from ~ ".data);\n"
                }
                CgMap($v) {
                    $dst = g6e_field_accessor($allvars, $msg, $idx, CgMap($v))
                    $from = g6e_field_accessor($allvars, $src, $idx, CgMap($v))
                    "\t\t" ~ $dst ~ ".keys = (const char**)guji_copy_arr((const void*)" ~ $from ~ ".keys);\n" ~
                    "\t\t" ~ $dst ~ ".vals = guji_copy_arr((const void*)" ~ $from ~ ".vals);\n"
                }
                CgClass($cn) {
                    match cg_env_lookup_class($env, $cn) {
                        Some($info) {
                            g5_hatch_copy_class_fields($info.fields, g6e_field_accessor($allvars, $msg, $idx, CgClass($cn)))
                        }
                        None { "" }
                    }
                }
                _ { "" }
            }
            $one ~ g5_hatch_enum_copy_one_fields($env, $allvars, $rest, $idx + 1, $msg, $src)
        }
    }
}

sub g5_hatch_enum_copy_cases($env: CgEnv, $allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int, $msg: Str, $src: Str): Str {
    match $todo {
        CgVarNil { "" }
        CgVarCons($v, $rest) {
            "\tcase " ~ c_int($tag) ~ "LL: \{\n" ~
            g5_hatch_enum_copy_one_fields($env, $allvars, $v.fields, 0, $msg, $src) ~
            "\t\tbreak;\n\t}\n" ~
            g5_hatch_enum_copy_cases($env, $allvars, $rest, $tag + 1, $msg, $src)
        }
    }
}

sub g5_hatch_enum_copy_fields($env: CgEnv, $info: CgEnumInfo, $msg: Str, $src: Str): Str {
    "\tswitch (" ~ $src ~ ".tag) \{\n" ~
    g5_hatch_enum_copy_cases($env, $info.variants, $info.variants, 0, $msg, $src) ~
    "\t}\n"
}

# True when a hatch-captured enum needs more than a plain struct assignment:
# recursive boxes, flat heap fields, or a by-value class with Str/List members.
sub g5_hatch_class_has_counted($fs: CgClassFieldInfoList): Bool {
    match $fs {
        CgClassFieldNil { false }
        CgClassFieldCons($f, $t) {
            match $f.kind {
                CgStr { true }
                CgList($el) { true }
                _ { g5_hatch_class_has_counted($t) }
            }
        }
    }
}

sub g5_hatch_enum_kinds_need_detach($env: CgEnv, $fs: CgKindList): Bool {
    match $fs {
        CgKindNil { false }
        CgKindCons($h, $t) {
            match $h {
                CgStr { true }
                CgList($el) { true }
                CgMap($v) { true }
                CgClass($cn) {
                    match cg_env_lookup_class($env, $cn) {
                        Some($info) {
                            if g5_hatch_class_has_counted($info.fields) {
                                true
                            } else {
                                g5_hatch_enum_kinds_need_detach($env, $t)
                            }
                        }
                        None { g5_hatch_enum_kinds_need_detach($env, $t) }
                    }
                }
                _ { g5_hatch_enum_kinds_need_detach($env, $t) }
            }
        }
    }
}

sub g5_hatch_enum_vars_need_detach($env: CgEnv, $vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { false }
        CgVarCons($h, $t) {
            if g5_hatch_enum_kinds_need_detach($env, $h.fields) {
                true
            } else {
                g5_hatch_enum_vars_need_detach($env, $t)
            }
        }
    }
}

# Copy-on-capture for a user enum. Flat scalar (+ scalar-only class) payloads
# are a plain struct copy. Flat counted payloads (Str/List/Map or class Str/
# List members) struct-copy then detach active heap slots. Recursive self-box
# graphs use the generated clone helper. The child adopts the rc==1 result and
# releases it through guji_release_<Enum>_fields at task exit.
sub g5_hatch_fill_enum($name: Str, $var: CgVar, $etmp: Str, $field: Str, $env: CgEnv): Str {
    $dst = $etmp ~ "->" ~ $field
    match cg_env_lookup_enum($env, $name) {
        Some($info) {
            if g6e_variants_have_box($info.variants) {
                "\t" ~ $dst ~ " = guji_clone_" ~ $name ~ "_value(&" ~ $var.cname ~ ");\n"
            } else if g5_hatch_enum_vars_need_detach($env, $info.variants) {
                "\t" ~ $dst ~ " = " ~ $var.cname ~ ";\n" ~ g5_hatch_enum_copy_fields($env, $info, $dst, $var.cname)
            } else {
                "\t" ~ $dst ~ " = " ~ $var.cname ~ ";\n"
            }
        }
        None { "" }
    }
}

# Copy-on-capture for a direct class value. The struct assignment copies scalar
# fields; Str and flat-List fields are then replaced with task-owned detached
# copies. This is the direct-class twin of g5_hatch_fill_enum's class-payload
# walk and keeps parent/task heaps disjoint.
sub g5_hatch_fill_class($name: Str, $var: CgVar, $etmp: Str, $field: Str, $env: CgEnv): Str {
    $dst = $etmp ~ "->" ~ $field
    match cg_env_lookup_class($env, $name) {
        Some($info) {
            "\t" ~ $dst ~ " = " ~ $var.cname ~ ";\n" ~
            g5_hatch_copy_class_fields($info.fields, $dst)
        }
        None { "" }
    }
}

# Parent spawn-site fills: Chan retain, Str deep-copy, List/Map copy-on-capture,
# class/enum copy-on-capture, Option/Result detach (I10g2), scalar by-value copy.
sub g5_hatch_env_fills($caps: CgEnv, $etmp: Str, $env: CgEnv): Str {
    match $caps {
        CgEnvNil { "" }
        CgEnvCons($h, $t) {
            $field = g5_hatch_cap_field($h.name)
            $dst = $etmp ~ "->" ~ $field
            $one = match $h.kind {
                CgChan($el) { "\t" ~ $dst ~ " = guji_chan_retain(" ~ $h.cname ~ ");\n" }
                CgStr { "\t" ~ $dst ~ " = guji_str_copy(" ~ $h.cname ~ ");\n" }
                CgMatch { "\t" ~ $dst ~ " = guji_match_copy(" ~ $h.cname ~ ");\n" }
                CgBush { "\t" ~ $dst ~ " = guji_bush_copy(" ~ $h.cname ~ ");\n" }
                CgList($el) { g5_hatch_fill_list($el, $h, $etmp, $field) }
                CgMap($v) { g5_hatch_fill_map($v, $h, $etmp, $field) }
                CgClass($name) { g5_hatch_fill_class($name, $h, $etmp, $field, $env) }
                CgEnum($name) { g5_hatch_fill_enum($name, $h, $etmp, $field, $env) }
                CgFn($p, $r) {
                    "\t" ~ $dst ~ " = " ~ $h.cname ~ ";\n" ~
                    "\tguji_retain(" ~ $dst ~ ".env);\n"
                }
                # Reuse channel copy-on-send: struct copy then detach active
                # counted arms so the hatch env owns an independent payload.
                CgOptInt { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptBool { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptFloat { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptStr { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptMatch { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptBush { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptList($inner) { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgOptMap($v) { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                CgRes($ok, $err) { g11_chan_send_fill($h.kind, $dst, $h.cname, $env) }
                _ { "\t" ~ $dst ~ " = " ~ $h.cname ~ ";\n" }
            }
            $one ~ g5_hatch_env_fills($t, $etmp, $env)
        }
        _ { "" }
    }
}

# Child adopts env fields into fresh gvN locals (ntmp-disjoint from parent).
# Chan/Str-family captures are owned by the task frame (scope-exit release).
class HatchAdopt {
    has $.decls: Str
    has $.body: Str
    has $.env: CgEnv
    has $.ntmp: Int
}

# C element type for a hatch-admitted map value (mirrors g7_list_c_type for
# the capturable boundary; kept Result-free so adopt stays a pure Str walk).
sub g5_hatch_map_vctype($v: CgKind): Str {
    match $v {
        CgFloat { "double" }
        CgStr { "const char*" }
        CgList($inner) { "guji_slice_t" }
        CgMap($inner) { "guji_map_t" }
        _ { "int64_t" }
    }
}

sub g5_hatch_adopt($caps: CgEnv, $base: CgEnv, $ntmp: Int, $decls: Str, $body: Str): HatchAdopt {
    match $caps {
        CgEnvNil { HatchAdopt(decls: $decls, body: $body, env: $base, ntmp: $ntmp) }
        CgEnvCons($h, $t) {
            $cn = "gv" ~ c_int($ntmp)
            $field = g5_hatch_cap_field($h.name)
            $owned = match $h.kind {
                CgChan($el) { true }
                CgStr { true }
                CgMatch { true }
                CgBush { true }
                CgList($el) { true }
                CgMap($v) { true }
                CgClass($name) { true }
                CgEnum($name) {
                    match cg_env_lookup_enum($base, $name) {
                        Some($info) { g6e_enum_has_heap($info) }
                        None { false }
                    }
                }
                CgFn($p, $r) { true }
                CgOptStr { true }
                CgOptMatch { true }
                CgOptBush { true }
                CgOptList($inner) { true }
                CgOptMap($v) { true }
                CgRes($ok, $err) { g5_hatch_carrier_owned($h.kind) }
                _ { false }
            }
            # List: adopt the env's detached guji_slice_t as slice-form
            # (listlen 0). Map: native unpacks env->cap into named
            # _keys/_vals/_len locals (NOT a guji_map_t assign) so the child's
            # existing two-array map ops + g7_map_release work unchanged;
            # listlen forced 0 (named form).
            match $h.kind {
                CgMap($v) {
                    $vctype = g5_hatch_map_vctype($v)
                    $d2 = $decls ~
                        "\tconst char** " ~ $cn ~ "_keys = NULL;\n" ~
                        "\t" ~ $vctype ~ "* " ~ $cn ~ "_vals = NULL;\n" ~
                        "\tint64_t " ~ $cn ~ "_len = 0;\n"
                    $b2 = $body ~
                        "\t" ~ $cn ~ "_keys = (const char**)env->" ~ $field ~ ".keys;\n" ~
                        "\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)env->" ~ $field ~ ".vals;\n" ~
                        "\t" ~ $cn ~ "_len = env->" ~ $field ~ ".len;\n"
                    $e2 = CgEnvCons(CgVar(name: $h.name, cname: $cn, kind: $h.kind, mutable: false, borrowed: false, listlen: 0), $base)
                    g5_hatch_adopt($t, $e2, $ntmp + 1, $d2, $b2)
                }
                _ {
                    $ll = match $h.kind { CgList($el) { 0 } _ { $h.listlen } }
                    $d2 = $decls ~ g4_value_decl($h.kind, $cn)
                    $b2 = $body ~ "\t" ~ $cn ~ " = env->" ~ $field ~ ";\n"
                    $e2 = CgEnvCons(CgVar(name: $h.name, cname: $cn, kind: $h.kind, mutable: false, borrowed: !$owned, listlen: $ll), $base)
                    g5_hatch_adopt($t, $e2, $ntmp + 1, $d2, $b2)
                }
            }
        }
        _ { HatchAdopt(decls: $decls, body: $body, env: $base, ntmp: $ntmp) }
    }
}

sub g5_emit_hatch($body: StmtList, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    $refs = fv_stmts($body, StrNil)
    $bnames = bn_stmts($body, StrNil)
    if !g5_hatch_free_ok($env, $refs, $bnames) {
        Err(g3_unsupported())
    } else {
        $caps = g5_hatch_caps_sort(g5_collect_hatch_captures($env, $env, $refs, $bnames, CgEnvNil))
        $hid = c_int($state.nstr)
        $prefix = "ghatch_" ~ $hid
        $env_ty = $prefix ~ "_env"
        $body_fn = $prefix ~ "_body"
        $wrap_fn = $prefix
        $stripped = cg_env_without_vars($env)
        $adopt = g5_hatch_adopt($caps, $stripped, 0, "", "")
        $lstate = CgState(interns: $state.interns, decls: $adopt.decls, body: $adopt.body, nstr: $state.nstr + 1, ntmp: $adopt.ntmp)
        # Unit-stmt walker (not g3_main): a hatch body may be a lone `$ch.send(...)`
        # whose Result must be discarded via g5_carrier_discard — g3_final_stmt
        # would decline that shape.
        match g5_lower_unit_stmts($body, $lstate, $adopt.env) {
            Err($m) { Err($m) }
            Ok($bo) {
                $out = MainOut(
                    interns: $bo.state.interns,
                    decls: $bo.state.decls,
                    # Release the FINAL body environment, not only the captures:
                    # task-local Str/container bindings also own their values.
                    body: $bo.state.body ~ cg_env_release_strs($bo.env),
                    ret: "0LL",
                    nstr: $bo.state.nstr
                )
                $struct = "typedef struct " ~ $env_ty ~ " \{\n" ~ g5_hatch_env_fields($caps) ~ "} " ~ $env_ty ~ ";\n\n"
                $fwd = "struct " ~ $env_ty ~ ";\nstatic void " ~ $wrap_fn ~ "(void*);\n"
                $body_def = "static int64_t " ~ $body_fn ~ "(void* arg) \{\n" ~
                    "\tstruct " ~ $env_ty ~ "* env = (struct " ~ $env_ty ~ "*)arg;\n" ~
                    $out.decls ~ $out.body ~
                    "\treturn " ~ $out.ret ~ ";\n}\n\n"
                $wrap_def = "static void " ~ $wrap_fn ~ "(void* arg) \{\n" ~
                    "\t(void)" ~ $body_fn ~ "(arg);\n" ~
                    "\tfree(arg);\n}\n\n"
                $etmp = "gt" ~ c_int($state.ntmp)
                $spawn_decl = "\tstruct " ~ $env_ty ~ "* " ~ $etmp ~ " = NULL;\n"
                $spawn_body = "\t" ~ $etmp ~ " = (struct " ~ $env_ty ~ "*)malloc(sizeof(struct " ~ $env_ty ~ "));\n" ~
                    g5_hatch_env_fills($caps, $etmp, $env) ~
                    "\tguji_task_spawn(&" ~ $wrap_fn ~ ", " ~ $etmp ~ ");\n"
                Ok(BindOut(
                    state: CgState(
                        interns: $out.interns ~ $fwd ~ $struct ~ $body_def ~ $wrap_def,
                        decls: $state.decls ~ $spawn_decl,
                        body: $state.body ~ $spawn_body,
                        nstr: $out.nstr,
                        ntmp: $state.ntmp + 1
                    ),
                    env: $env
                ))
            }
        }
    }
}

sub g5_stmt_hatch_stmt($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match $s {
        SHatch($body) {
            match g5_emit_hatch($body, $state, $env) {
                Err($m) { Err($m) }
                Ok($h) { Ok(Some($h)) }
            }
        }
        _ { Ok(None) }
    }
}

# Statement-position `select` keeps the sub's REAL return kind so an arm-body
# `return` lowers as an early return — releasing every owned local in scope,
# including a heap recv arm's adopted Option carrier. `$extra_cleanup` carries
# enclosing statement-match scrutinees into that early-return path; fall-through
# leaves them owned by the outer match.
sub g5_stmt_select_stmt_extra($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $s {
        SSelect($arms, $els) {
            match g11_emit_select_extra($arms, $els, $state, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($so) { Ok(Some($so)) }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_stmt_select_stmt($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    g5_stmt_select_stmt_extra($s, $state, $env, $retkind, "")
}

# Emit an early Unit `return` / `return ()` / `return <unit-expr>` with full
# owned-local cleanup. Unit ABI is always `return 0LL` after side effects; bare
# `return` and `return ()` are equivalent. A non-Unit operand is lowered as a
# Unit statement first (print/note/Unit call) so `return print("x")` keeps its
# observable effect before the frame exits.
sub g5_unit_return_extra($ov: Option[Expr], $state: CgState, $env: CgEnv, $extra_cleanup: Str): Result[CgState, Str] {
    match $ov {
        None {
            Ok(CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ $extra_cleanup ~ cg_env_release_strs($env) ~ "\treturn 0LL;\n",
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ))
        }
        Some($e) {
            match $e {
                EUnit {
                    Ok(CgState(
                        interns: $state.interns,
                        decls: $state.decls,
                        body: $state.body ~ $extra_cleanup ~ cg_env_release_strs($env) ~ "\treturn 0LL;\n",
                        nstr: $state.nstr,
                        ntmp: $state.ntmp
                    ))
                }
                _ {
                    match g5_lower_unit_stmt(SExpr($e), $state, $env) {
                        Err($m) { Err($m) }
                        Ok($bo) {
                            Ok(CgState(
                                interns: $bo.state.interns,
                                decls: $bo.state.decls,
                                body: $bo.state.body ~ $extra_cleanup ~ cg_env_release_strs($env) ~ "\treturn 0LL;\n",
                                nstr: $bo.state.nstr,
                                ntmp: $bo.state.ntmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

# Final-position Unit return: evaluate any Unit operand for side effects, then
# hand `0LL` to mainout_with_cleanup (which owns fall-through env release).
sub g5_unit_return_final($ov: Option[Expr], $state: CgState, $env: CgEnv): Result[MainOut, Str] {
    match $ov {
        None {
            Ok(mainout_with_cleanup(MainOut(interns: $state.interns, decls: $state.decls, body: $state.body, ret: "0LL", nstr: $state.nstr), $env))
        }
        Some($e) {
            match $e {
                EUnit {
                    Ok(mainout_with_cleanup(MainOut(interns: $state.interns, decls: $state.decls, body: $state.body, ret: "0LL", nstr: $state.nstr), $env))
                }
                _ {
                    match g5_lower_unit_stmt(SExpr($e), $state, $env) {
                        Err($m) { Err($m) }
                        Ok($bo) {
                            Ok(mainout_with_cleanup(MainOut(interns: $bo.state.interns, decls: $bo.state.decls, body: $bo.state.body, ret: "0LL", nstr: $bo.state.nstr), $env))
                        }
                    }
                }
            }
        }
    }
}

# Lower an early `return <expr>` reached inside a statement-position `if` guard
# (e.g. the driver's `if @argv.count() < 3 { note(...); return 2 }`). The body's
# value is computed under the sub's return kind, then EVERY owned local in scope
# is released (the C `return` exits the whole function, so the function-level
# cleanup that follows the fall-through path is NOT reached on this branch — no
# double-free), and a `return <c>;` is emitted inline. This mirrors the ordering
# of `mainout_with_cleanup` (value computed, then cleanup, then the C return);
# the driver's guards all return Int literals, so `$v.c` is a self-contained
# rvalue. Bare `return` / `return ()` are admitted for RUnit (I2b).
sub g5_guard_return_extra($ov: Option[Expr], $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $retkind {
        RUnit { g5_unit_return_extra($ov, $state, $env, $extra_cleanup) }
        _ {
            match $ov {
                None { Err(g3_unsupported()) }
                Some($e) {
                    match g5_ret_value_kind($retkind) {
                        None { Err(g3_unsupported()) }
                        Some($k) {
                            match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($v) {
                                    Ok(CgState(
                                        interns: $v.state.interns,
                                        decls: $v.state.decls,
                                        body: $v.state.body ~ $extra_cleanup ~ cg_env_release_strs($env) ~ "\treturn " ~ $v.c ~ ";\n",
                                        nstr: $v.state.nstr,
                                        ntmp: $v.state.ntmp
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# P3b-2b-2c-4e/4f: dispatch a `?` bind/reassign statement inside a guard/arm body.
# The statement-level machinery is reused with one extra cleanup hook: if the body
# belongs to a statement-match arm over an owned scrutinee temp, the `?` guard's
# early `return` must release that scrutinee before releasing the full env in
# scope. Ordinary guard bodies pass an empty cleanup string, so their C stays on
# the original path. Fall-through is unchanged: block-local payload/synthetic
# locals are released by `cg_env_release_strs_n`, and statement matches emit the
# scrutinee cleanup once after the arm chain.
sub g5_guard_question_bind($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    g5_stmt_question_bind_extra($s, $state, $env, $retkind, $extra_cleanup)
}

# Lower the body of a statement-position `if`/`elif`/`else` branch: a sequence of
# Unit statements (print/note/binding/Unit call/while) that MAY short-circuit with
# a `return` or a `?` early-return (guard-body question binds, P3b-2b-2c-4e). A
# `return` is terminal — its full-env cleanup + C return is emitted
# and any (dead) trailing statements are dropped. A branch that falls off the end
# instead releases only its OWN block-local Str bindings (those added past
# `$base`), exactly like a value-branch exit; outer bindings are left for the
# function-level cleanup. `$state` is expected to start body-less so `.body` holds
# only this branch's C.
sub g5_guard_body_extra($stmts: StmtList, $state: CgState, $env: CgEnv, $base: Int, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $stmts {
        StmtNil {
            $rel = cg_env_release_strs_n($env, cg_env_len($env) - $base)
            Ok(CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ $rel, nstr: $state.nstr, ntmp: $state.ntmp))
        }
        StmtCons($head, $tail) {
            match $head {
                SReturn($ov) { g5_guard_return_extra($ov, $state, $env, $retkind, $extra_cleanup) }
                _ {
                    match g5_guard_question_bind($head, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok(Some($qn)) { g5_guard_body_extra($tail, $qn.state, $qn.env, $base, $retkind, $extra_cleanup) }
                        Ok(None) {
                            match g5_stmt_if_guard_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(Some($next)) { g5_guard_body_extra($tail, $next.state, $next.env, $base, $retkind, $extra_cleanup) }
                                Ok(None) {
                                    match g5_stmt_while_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                        Err($m) { Err($m) }
                                        Ok(Some($next)) { g5_guard_body_extra($tail, $next.state, $next.env, $base, $retkind, $extra_cleanup) }
                                        Ok(None) {
                                            match g5_stmt_match_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                Err($m) { Err($m) }
                                                Ok(Some($next)) { g5_guard_body_extra($tail, $next.state, $next.env, $base, $retkind, $extra_cleanup) }
                                                Ok(None) {
                                                    match g5_stmt_select_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                        Err($m) { Err($m) }
                                                        Ok(Some($next)) { g5_guard_body_extra($tail, $next.state, $next.env, $base, $retkind, $extra_cleanup) }
                                                        Ok(None) {
                                                            match g5_lower_unit_stmt_scoped($head, $state, $env, $base) {
                                                                Err($m) { Err($m) }
                                                                Ok($next) { g5_guard_body_extra($tail, $next.state, $next.env, $base, $retkind, $extra_cleanup) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_guard_body($stmts: StmtList, $state: CgState, $env: CgEnv, $base: Int, $retkind: CgRet): Result[CgState, Str] {
    g5_guard_body_extra($stmts, $state, $env, $base, $retkind, "")
}

# Emit the `else`/`else if` chain after a statement-position `if`'s then-branch.
# Mirrors `g4_if_tail_c`, but each branch is a Unit/return guard body (not a
# value branch). No `elif`/`else` => empty tail (the `if` simply falls through
# when its condition is false). `$state` is expected to start body-less.
sub g5_guard_tail_extra($elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $base: Int, $retkind: CgRet, $extra_cleanup: Str): Result[IfTail, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Ok(IfTail(state: $state, code: "")) }
                Some($body) {
                    $br_start = g4_bodyless_state($state)
                    match g5_guard_body_extra($body, $br_start, $env, $base, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($eb) { Ok(IfTail(state: $eb, code: " else \{\n" ~ $eb.body ~ "\t}")) }
                    }
                }
            }
        }
        ElifCons($head, $rest) {
            $cond_start = g4_bodyless_state($state)
            match g4_bool_lower($head.cond, $cond_start, $env) {
                Err($m) { Err($m) }
                Ok($cond) {
                    $br_start = g4_bodyless_state($cond.state)
                    match g5_guard_body_extra($head.body, $br_start, $env, $base, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($eb) {
                            match g5_guard_tail_extra($rest, $els, g4_bodyless_state($eb), $env, $base, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok($tail) {
                                    Ok(IfTail(state: $tail.state, code: " else \{\n" ~ $cond.state.body ~ "\tif (" ~ $cond.c ~ ") \{\n" ~ $eb.body ~ "\t}" ~ $tail.code ~ "\n\t}"))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Lower a statement-position `if cond { ... return N }` (the §6.3 `if` used for
# side effects, not as a value). The condition lowers to a Bool; each branch body
# is a `g5_guard_body` that may short-circuit with `return`. The resulting
# environment is the OUTER env (branch-local bindings go out of scope). Returns a
# BindOut so it threads like any other Unit statement.
# P3b-2b-2c-4i: the `_extra` variant threads a statement-match arm's
# owned-scrutinee cleanup into every branch body, so a `?` or `return` inside a
# NESTED guard within such an arm still releases the scrutinee temp before its
# early C return (previously the nested-if dispatch dropped the cleanup — a leak).
sub g5_lower_if_guard_extra($cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    $base = cg_env_len($env)
    match g4_bool_lower($cond, $state, $env) {
        Err($m) { Err($m) }
        Ok($cc) {
            $then_start = g4_bodyless_state($cc.state)
            match g5_guard_body_extra($then, $then_start, $env, $base, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($tb) {
                    match g5_guard_tail_extra($elifs, $els, g4_bodyless_state($tb), $env, $base, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($gt) {
                            Ok(BindOut(
                                state: CgState(
                                    interns: $gt.state.interns,
                                    decls: $gt.state.decls,
                                    body: $cc.state.body ~ "\tif (" ~ $cc.c ~ ") \{\n" ~ $tb.body ~ "\t}" ~ $gt.code ~ "\n",
                                    nstr: $gt.state.nstr,
                                    ntmp: $gt.state.ntmp
                                ),
                                env: $env
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g5_lower_if_guard($cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g5_lower_if_guard_extra($cond, $then, $elifs, $els, $state, $env, $retkind, "")
}

# If `$s` is a statement-position `if` (an `EIf` expression statement), lower it
# as a guard via `g5_lower_if_guard` and return Ok(Some(..)); otherwise Ok(None)
# so the caller falls back to the retkind-agnostic Unit-statement lowerer. This is
# the only statement that needs the sub's return kind in non-final position (its
# body may early-`return`), so it is dispatched here rather than in
# `g5_lower_unit_stmt`.
sub g5_stmt_if_guard_extra($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $s {
        SExpr($e) {
            match $e {
                EIf($cond, $then, $elifs, $els) {
                    match g5_lower_if_guard_extra($cond, $then, $elifs, $els, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($b) { Ok(Some($b)) }
                    }
                }
                _ { Ok(None) }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_stmt_if_guard($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    g5_stmt_if_guard_extra($s, $state, $env, $retkind, "")
}

# If `$s` is a NON-final statement-position `match` (an `EMatch` expression
# statement, value discarded), lower it via g6_lower_stmt_match and return
# Ok(Some(..)); otherwise Ok(None). Like g5_stmt_if_guard, this needs the sub's
# return kind because an arm body may early-`return`.
sub g5_stmt_match_stmt_extra($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[Option[BindOut], Str] {
    match $s {
        SExpr($e) {
            match $e {
                EMatch($subj, $arms) {
                    match g6_lower_stmt_match_extra($subj, $arms, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($b) { Ok(Some($b)) }
                    }
                }
                _ { Ok(None) }
            }
        }
        _ { Ok(None) }
    }
}

sub g5_stmt_match_stmt($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    g5_stmt_match_stmt_extra($s, $state, $env, $retkind, "")
}

sub g3_final_if_stmt_out($cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[MainOut, Str] {
    if g5_if_bodies_unit_shaped($then, $elifs, $els, $env) {
        match g5_lower_if_guard($cond, $then, $elifs, $els, $state, $env, $retkind) {
            Err($m) { Err($m) }
            Ok($next) {
                Ok(mainout_with_cleanup(MainOut(interns: $next.state.interns, decls: $next.state.decls, body: $next.state.body, ret: "0LL", nstr: $next.state.nstr), $env))
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g5_match_bind_str($mutable: Bool, $name: Str, $subj: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    match cg_env_lookup($env, $name) {
        Some($v) { Err(g3_unsupported()) }
        None {
            # P9-10b-3a: an ALL-return (Never-valued) match has no value arm left
            # to validate the CgStr-first try, so it would spuriously pin the
            # dead binder at Str. Decline here so the fresh-bind kind cascade
            # (g5_stmt_match_bind_infer) lands on CgInt — native defaults the
            # dead result temp and binder to int64_t unconditionally.
            if g6_arms_all_return($arms) {
                Err(g3_unsupported())
            } else {
            match g6_lower_match_ret(CgStr, $subj, $arms, $state, $env, $retkind) {
                Err($m) { Err($m) }
                Ok($mv) {
                    $cn = "gv" ~ c_int($mv.state.ntmp)
                    $st2 = CgState(
                        interns: $mv.state.interns,
                        decls: $mv.state.decls ~ "\tconst char* " ~ $cn ~ " = GUJI_EMPTY_STR;\n",
                        body: $mv.state.body ~ "\t" ~ $cn ~ " = " ~ $mv.c ~ ";\n",
                        nstr: $mv.state.nstr,
                        ntmp: $mv.state.ntmp + 1
                    )
                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgStr, mutable: $mutable, borrowed: false, listlen: g6_str_bind_listlen(None, EMatch($subj, $arms), $env)), $env)))
                }
            }
            }
        }
    }
}

# P3b-2b-2c-4m: one scalar/Str kind attempt for a fresh match-value bind whose
# arms need the retkind-aware lowering (arm-final `?` hoists). A wrong kind
# self-rejects inside the arm lowering (state threads by value, so a discarded
# attempt has no side effects), exactly like g5_if_value_bind_try.
sub g5_match_value_bind_try($kind: CgKind, $mutable: Bool, $name: Str, $subj: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match g6_lower_match_ret($kind, $subj, $arms, $state, $env, $retkind) {
        Err($m) { Ok(None) }
        Ok($mv) {
            $cn = "gv" ~ c_int($mv.state.ntmp)
            $ll = match $kind {
                CgStr { g6_str_bind_listlen(None, EMatch($subj, $arms), $env) }
                _ { 0 }
            }
            Ok(Some(BindOut(
                state: CgState(
                    interns: $mv.state.interns,
                    decls: $mv.state.decls ~ g4_value_decl($kind, $cn),
                    body: $mv.state.body ~ "\t" ~ $cn ~ " = " ~ $mv.c ~ ";\n",
                    nstr: $mv.state.nstr,
                    ntmp: $mv.state.ntmp + 1
                ),
                env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: $ll), $env)
            )))
        }
    }
}

# Kind selection for a fresh scalar/Str match-value bind that the ordinary bind
# path declined (its arms carry `?`): a supported annotation pins the kind;
# otherwise infer by the g4_lower_fresh_bind cascade order Int -> Float -> Bool
# -> Str, taking the first kind whose retkind-aware match lowering succeeds
# (mirrors g5_stmt_if_value_bind_infer).
sub g5_stmt_match_bind_infer($mutable: Bool, $name: Str, $ty: Option[TypeRef], $subj: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match g5_param_kind($ty, $env) {
        Ok($kind) {
            if g5_if_bind_kind_supported($kind) {
                g5_match_value_bind_try($kind, $mutable, $name, $subj, $arms, $state, $env, $retkind)
            } else {
                Ok(None)
            }
        }
        Err($no_annot) {
            match g5_match_value_bind_try(CgInt, $mutable, $name, $subj, $arms, $state, $env, $retkind) {
                Err($m) { Err($m) }
                Ok(Some($b)) { Ok(Some($b)) }
                Ok(None) {
                    match g5_match_value_bind_try(CgFloat, $mutable, $name, $subj, $arms, $state, $env, $retkind) {
                        Err($m) { Err($m) }
                        Ok(Some($b)) { Ok(Some($b)) }
                        Ok(None) {
                            match g5_match_value_bind_try(CgBool, $mutable, $name, $subj, $arms, $state, $env, $retkind) {
                                Err($m) { Err($m) }
                                Ok(Some($b)) { Ok(Some($b)) }
                                Ok(None) {
                                    g5_match_value_bind_try(CgStr, $mutable, $name, $subj, $arms, $state, $env, $retkind)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_match_value_reassign($var: CgVar, $mutable: Bool, $value: Expr, $subj: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    if $mutable {
        Ok(None)
    } else if $var.mutable {
        match g4_lower_reassign($var, $value, $state, $env) {
            Ok($accepted) { Ok(None) }
            Err($needs_hoist) {
                if g5_if_bind_kind_supported($var.kind) {
                    match g6_lower_match_ret($var.kind, $subj, $arms, $state, $env, $retkind) {
                        Err($m) { Err($m) }
                        Ok($mv) { Ok(Some(g5_if_value_reassign_emit($var, $mv, $env))) }
                    }
                } else {
                    Ok(None)
                }
            }
        }
    } else {
        Ok(None)
    }
}

sub g5_stmt_match_bind($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[Option[BindOut], Str] {
    match $s {
        SBind($mutable, $name, $ty, $value) {
            match $value {
                EMatch($subj, $arms) {
                    match g5_match_bind_str($mutable, $name, $subj, $arms, $state, $env, $retkind) {
                        Ok($b) { Ok(Some($b)) }
                        Err($m) {
                            # P3b-2b-2c-4m: fresh scalar/Str match-value binds whose
                            # arms carry `?` hoists. Only take over when the ordinary
                            # bind path DECLINES — a `?`-free match bind keeps its
                            # byte-identical g4_lower_bind path (the P3b-2b-2c-4k
                            # gate pattern). Existing names are reassignments —
                            # they use the same retkind-aware match lowerer, then
                            # assign the shared match temp into the existing local.
                            match cg_env_lookup($env, $name) {
                                Some($var) { g5_match_value_reassign($var, $mutable, $value, $subj, $arms, $state, $env, $retkind) }
                                None {
                                    match g4_lower_bind($mutable, $name, $ty, $value, $state, $env) {
                                        Ok($accepted) { Ok(None) }
                                        Err($needs_hoist) {
                                            g5_stmt_match_bind_infer($mutable, $name, $ty, $subj, $arms, $state, $env, $retkind)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Ok(None) }
            }
        }
        _ { Ok(None) }
    }
}

# Lower the FINAL statement of a sub body, given the sub's return kind. A final
# `print(...)`, `note(...)`, or Unit-returning call => Unit body (returns 0LL).
# Otherwise it is a value expression statement (or `return <expr>`) lowered under
# the return kind (RInt for `main`). A final binding is out of subset: the
# interpreter and native oracle disagree on the value of a block that ends in a
# binding.
sub g3_final_stmt($s: Stmt, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[MainOut, Str] {
    match g3_as_print($s) {
        Some($arg) {
            match g3_lower_print($arg, $state, $env) {
                Err($m) { Err($m) }
                Ok($ns) { Ok(mainout_with_cleanup(MainOut(interns: $ns.interns, decls: $ns.decls, body: $ns.body, ret: "0LL", nstr: $ns.nstr), $env)) }
            }
        }
        None {
            match g3_as_note($s) {
                Some($arg) {
                    match g3_lower_note($arg, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($ns) { Ok(mainout_with_cleanup(MainOut(interns: $ns.interns, decls: $ns.decls, body: $ns.body, ret: "0LL", nstr: $ns.nstr), $env)) }
                    }
                }
                None {
                    match $s {
                        SExpr($e) {
                            match g5_unit_call_code($e, $state, $env) {
                                Err($m) { Err($m) }
                                Ok(Some($next)) {
                                    Ok(mainout_with_cleanup(MainOut(interns: $next.interns, decls: $next.decls, body: $next.body, ret: "0LL", nstr: $next.nstr), $env))
                                }
                                Ok(None) {
                                    match $retkind {
                                        RUnit {
                                            match $e {
                                                EMatch($subj, $arms) {
                                                    if g6_final_match_arms_unit_shaped($arms, $env) {
                                                        match g6_lower_stmt_match($subj, $arms, $state, $env, RUnit) {
                                                            Err($m) { Err($m) }
                                                            Ok($next) { Ok(mainout_with_cleanup(MainOut(interns: $next.state.interns, decls: $next.state.decls, body: $next.state.body, ret: "0LL", nstr: $next.state.nstr), $env)) }
                                                        }
                                                    } else {
                                                        Err(g3_unsupported())
                                                    }
                                                }
                                                EIf($cond, $then, $elifs, $els) {
                                                    g3_final_if_stmt_out($cond, $then, $elifs, $els, $state, $env, RUnit)
                                                }
                                                # P9-11b-2a: a trailing `()` literal
                                                # closes an annotated `: Unit` sub —
                                                # native lowers it to the Unit zero
                                                # (`gt = 0LL; return gt;`); returning
                                                # 0LL directly is the same behaviour.
                                                EUnit { Ok(mainout_with_cleanup(MainOut(interns: $state.interns, decls: $state.decls, body: $state.body, ret: "0LL", nstr: $state.nstr), $env)) }
                                                _ { Err(g3_unsupported()) }
                                            }
                                        }
                                        _ {
                                            match g5_ret_value_kind($retkind) {
                                                None { Err(g3_unsupported()) }
                                                Some($k) {
                                                    match $e {
                                                        EMatch($subj, $arms) {
                                                            if g6_final_match_arms_unit_shaped($arms, $env) {
                                                                match g6_lower_stmt_match($subj, $arms, $state, $env, $retkind) {
                                                                    Err($m) { Err($m) }
                                                                    Ok($next) { Ok(mainout_with_cleanup(MainOut(interns: $next.state.interns, decls: $next.state.decls, body: $next.state.body, ret: "0LL", nstr: $next.state.nstr), $env)) }
                                                                }
                                                            } else {
                                                                match g6_lower_match_ret($k, $subj, $arms, $state, $env, $retkind) {
                                                                    Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                    Err($mr) {
                                                                        match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                                            Err($m) { Err($m) }
                                                                            Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        EIf($cond, $then, $elifs, $els) {
                                                            if g5_if_bodies_unit_shaped($then, $elifs, $els, $env) {
                                                                g3_final_if_stmt_out($cond, $then, $elifs, $els, $state, $env, $retkind)
                                                            } else {
                                                                match g5_lower_if_value_ret($k, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                                                                    Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                    Err($im) {
                                                                        match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                                            Err($m) { Err($m) }
                                                                            Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        _ {
                                                            match g5_final_question_carrier($e, $state, $env, $retkind) {
                                                                Ok($qout) { Ok($qout) }
                                                                Err($qm) {
                                                                    match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($v) {
                                                                            Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env))
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        SReturn($ov) {
                            match $retkind {
                                RUnit { g5_unit_return_final($ov, $state, $env) }
                                _ {
                                    match $ov {
                                        Some($e) {
                                            match g5_ret_value_kind($retkind) {
                                                None { Err(g3_unsupported()) }
                                                Some($k) {
                                                    match $e {
                                                        EIf($cond, $then, $elifs, $els) {
                                                            match g5_lower_if_value_ret($k, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                                                                Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                Err($im) {
                                                                    match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        _ {
                                                            match g5_final_question_carrier($e, $state, $env, $retkind) {
                                                                Ok($qout) { Ok($qout) }
                                                                Err($qm) {
                                                                    match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        None { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                        # Final while/for are Unit-shaped (always return 0LL). Accept
                        # RUnit (user Unit subs) AND RInt: Unit-annotated `main` is
                        # forced to RInt for the C ABI (see g5_emit_sub_named), so a
                        # final while in `sub main(): Unit` previously declined even
                        # though the non-final while path already lowered under RInt.
                        SWhile($cond, $body) {
                            match $retkind {
                                RUnit {
                                    match g5_lower_while($cond, $body, $state, $env, $retkind) {
                                        Err($m) { Err($m) }
                                        Ok($w) { Ok(mainout_with_cleanup(MainOut(interns: $w.state.interns, decls: $w.state.decls, body: $w.state.body, ret: "0LL", nstr: $w.state.nstr), $env)) }
                                    }
                                }
                                RInt {
                                    match g5_lower_while($cond, $body, $state, $env, $retkind) {
                                        Err($m) { Err($m) }
                                        Ok($w) { Ok(mainout_with_cleanup(MainOut(interns: $w.state.interns, decls: $w.state.decls, body: $w.state.body, ret: "0LL", nstr: $w.state.nstr), $env)) }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        SFor($vars, $iter, $body) {
                            match $retkind {
                                RUnit {
                                    match g5_lower_for($vars, $iter, $body, $state, $env, $retkind) {
                                        Err($m) { Err($m) }
                                        Ok($f) { Ok(mainout_with_cleanup(MainOut(interns: $f.state.interns, decls: $f.state.decls, body: $f.state.body, ret: "0LL", nstr: $f.state.nstr), $env)) }
                                    }
                                }
                                RInt {
                                    match g5_lower_for($vars, $iter, $body, $state, $env, $retkind) {
                                        Err($m) { Err($m) }
                                        Ok($f) { Ok(mainout_with_cleanup(MainOut(interns: $f.state.interns, decls: $f.state.decls, body: $f.state.body, ret: "0LL", nstr: $f.state.nstr), $env)) }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        SHatch($body) {
                            match g5_emit_hatch($body, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($h) { Ok(mainout_with_cleanup(MainOut(interns: $h.state.interns, decls: $h.state.decls, body: $h.state.body, ret: "0LL", nstr: $h.state.nstr), $env)) }
                            }
                        }
                        SSelect($arms, $els) {
                            match g11_emit_select($arms, $els, $state, $env, $retkind) {
                                Err($m) { Err($m) }
                                Ok($so) { Ok(mainout_with_cleanup(MainOut(interns: $so.state.interns, decls: $so.state.decls, body: $so.state.body, ret: "0LL", nstr: $so.state.nstr), $env)) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# Lower a block body: each non-final statement must be a `print(...)`,
# `note(...)`, a scalar binding (which extends the environment for subsequent
# statements), or a Unit-returning call; the final statement is handled by
# g3_final_stmt. An empty body is a Unit block (returns 0LL) — the typechecker has
# already required the sub to be Unit for it.
sub g3_lower_body_stmts($stmts: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[MainOut, Str] {
    match $stmts {
        StmtNil { Ok(MainOut(interns: $state.interns, decls: $state.decls, body: $state.body, ret: "0LL", nstr: $state.nstr)) }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil {
                    match g3_final_stmt($head, $state, $env, $retkind) {
                        Err($m) { Err($m ~ "\nselfhost-codegen: while lowering final statement " ~ render_stmt($head)) }
                        Ok($out) { Ok($out) }
                    }
                }
                StmtCons($h2, $t2) {
                    match g5_stmt_question_bind($head, $state, $env, $retkind) {
                        Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                        Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                        Ok(None) {
                            match g5_stmt_if_value_bind($head, $state, $env, $retkind) {
                                Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                Ok(None) {
                            match g5_stmt_if_guard($head, $state, $env, $retkind) {
                                Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                Ok(None) {
                                    match g5_stmt_match_bind($head, $state, $env, $retkind) {
                                        Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                        Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                        Ok(None) {
                                            match g5_stmt_match_stmt($head, $state, $env, $retkind) {
                                                Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                                Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                                Ok(None) {
                                                    match g5_stmt_while_stmt($head, $state, $env, $retkind) {
                                                        Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                                        Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                                        Ok(None) {
                                                            match g5_stmt_for_stmt($head, $state, $env, $retkind) {
                                                                Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                                                Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                                                Ok(None) {
                                                                    match g5_stmt_hatch_stmt($head, $state, $env, $retkind) {
                                                                        Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                                                        Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                                                        Ok(None) {
                                                                            match g5_stmt_select_stmt($head, $state, $env, $retkind) {
                                                                                Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                                                                Ok(Some($next)) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                                                                Ok(None) {
                                                                                    match g5_lower_unit_stmt($head, $state, $env) {
                                                                                        Err($m) { Err($m ~ "\nselfhost-codegen: while lowering statement " ~ render_stmt($head)) }
                                                                                        Ok($next) { g3_lower_body_stmts($tail, $next.state, $next.env, $retkind) }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Lower a sub body (main or user) under its starting state/env and return kind. A
# block body is lowered statement-by-statement; an arrow (expression) body is a
# single `print(...)`/`note(...)`/Unit call (Unit body) or a single value
# expression lowered under the return kind. `main` passes RInt (its body yields
# the Int exit code or 0LL for a Unit body).
sub g3_main($sub: SubDecl, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[MainOut, Str] {
    match $sub.body {
        ExprBody($e) {
            # Expression bodies have the same frame ownership as block bodies.
            # Compute the return value first, then release callee-owned params.
            # In particular, g4_lower_ret_value materializes a bound Chan return
            # into an owned retained temp before this cleanup releases its
            # parameter handle, so `sub alias($ch): Chan = $ch` is use-safe.
            match g3_expr_print_arg($e) {
                Some($arg) {
                    match g3_lower_print($arg, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($ns) { Ok(mainout_with_cleanup(MainOut(interns: $ns.interns, decls: $ns.decls, body: $ns.body, ret: "0LL", nstr: $ns.nstr), $env)) }
                    }
                }
                None {
                    match g3_expr_note_arg($e) {
                        Some($arg) {
                            match g3_lower_note($arg, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($ns) { Ok(mainout_with_cleanup(MainOut(interns: $ns.interns, decls: $ns.decls, body: $ns.body, ret: "0LL", nstr: $ns.nstr), $env)) }
                            }
                        }
                        None {
                            match g5_unit_call_code($e, $state, $env) {
                                Err($m) { Err($m) }
                                Ok(Some($next)) {
                                    Ok(mainout_with_cleanup(MainOut(interns: $next.interns, decls: $next.decls, body: $next.body, ret: "0LL", nstr: $next.nstr), $env))
                                }
                                Ok(None) {
                                    match g5_ret_value_kind($retkind) {
                                        None { Err(g3_unsupported()) }
                                        Some($k) {
                                            match $e {
                                                EIf($cond, $then, $elifs, $els) {
                                                    match g5_lower_if_value_ret($k, $cond, $then, $elifs, $els, $state, $env, $retkind) {
                                                        Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                        Err($im) {
                                                            match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                                Err($m) { Err($m) }
                                                                Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                            }
                                                        }
                                                    }
                                                }
                                                _ {
                                                    match g4_lower_ret_value($retkind, $k, $e, $state, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($v) { Ok(mainout_with_cleanup(MainOut(interns: $v.state.interns, decls: $v.state.decls, body: $v.state.body, ret: $v.c, nstr: $v.state.nstr), $env)) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        BlockBody($stmts) {
            g3_lower_body_stmts($stmts, $state, $env, $retkind)
        }
    }
}

# ---- G5: signature derivation + per-sub emission --------------------------
# Map a parameter's annotated type to its codegen kind.
sub g5_param_kind($ty: Option[TypeRef], $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Int" {
                Ok(CgInt)
            } else if $tr.name == "Float" {
                Ok(CgFloat)
            } else if $tr.name == "Bool" {
                Ok(CgBool)
            } else if $tr.name == "Str" {
                Ok(CgStr)
            } else if $tr.name == "Match" {
                Ok(CgMatch)
            } else if $tr.name == "Bush" {
                Ok(CgBush)
            } else if $tr.name == "Regex" {
                # §13 first-class Regex: byte-identical to Str (the validated
                # pattern text, counted `const char*`) — native's rep. The
                # param is a borrowed Str like any other.
                Ok(CgStr)
            } else if $tr.name == "Chan" {
                # §17.2 channel parameters are callee-owned +1 handles: the
                # caller retains at the call site and the callee's scope-exit
                # cleanup releases (native's convention — see g5_param_borrowed).
                g11_chan_kind_from_type($ty, $env)
            } else if $tr.name == "List" {
                match g7_list_elem_kind_from_type($ty) {
                    Ok($el) { Ok(CgList($el)) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Map" {
                match g7_map_val_kind_from_type($ty) {
                    Ok($v) { Ok(CgMap($v)) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Option" {
                g6_option_kind_from_type_env($ty, $env)
            } else if $tr.name == "Result" {
                g6_result_kind_from_type($ty, $env)
            } else if $tr.name == "Func" {
                match $tr.args {
                    # P9-10b-3b-2b: a BARE `Func` annotation carries no signature.
                    # The C ABI is `guji_fn_t` regardless, so the param binds a
                    # canonical placeholder kind; the concrete shape is substituted
                    # per call site from the fn argument (native CallSig recovery).
                    TypeNil { Ok(CgFn(CgKindNil, RInt)) }
                    _ { g5_func_kind_from_type_args($tr.args, $env) }
                }
            } else {
                # A non-builtin Pascal type name is in subset only if it is a known
                # user enum whose field layout is supported. The parameter value is
                # a borrowed by-value alias: the callee can match/bind its fields,
                # but function cleanup must not release them.
                match g8_generic_enum_name_from_type($tr) {
                    Some($specn) {
                        match cg_env_lookup_enum($env, $specn) {
                            Some($info) {
                                if g6e_enum_fields_supported($info) { Ok(CgEnum($specn)) } else { Err(g3_unsupported()) }
                            }
                            None {
                                match cg_env_lookup_class($env, $tr.name) {
                                    Some($info) { Ok(CgClass($tr.name)) }
                                    None {
                                        match g8_generic_class_name_from_type($tr) {
                                            None { Err(g3_unsupported()) }
                                            Some($cspecn) {
                                                match cg_env_lookup_class($env, $cspecn) {
                                                    Some($info) { Ok(CgClass($cspecn)) }
                                                    None { Err(g3_unsupported()) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    None {
                        match cg_env_lookup_enum($env, $tr.name) {
                            None {
                                match cg_env_lookup_class($env, $tr.name) {
                                    Some($info) { Ok(CgClass($tr.name)) }
                                    None {
                                        match g8_generic_class_name_from_type($tr) {
                                            None { Err(g3_unsupported()) }
                                            Some($specn) {
                                                match cg_env_lookup_class($env, $specn) {
                                                    Some($info) { Ok(CgClass($specn)) }
                                                    None { Err(g3_unsupported()) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Some($info) {
                                if g6e_enum_fields_supported($info) { Ok(CgEnum($tr.name)) } else { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_func_ret_from_type_args($args: TypeList, $env: CgEnv): Result[CgRet, Str] {
    match $args {
        TypeNil { Err(g3_unsupported()) }
        TypeCons($head, $tail) {
            match $tail {
                TypeNil { g5_ret_kind(Some($head), $env) }
                TypeCons($h2, $t2) { g5_func_ret_from_type_args($tail, $env) }
            }
        }
    }
}

sub g5_func_param_kinds_from_type_args($args: TypeList, $env: CgEnv): Result[CgKindList, Str] {
    match $args {
        TypeNil { Err(g3_unsupported()) }
        TypeCons($head, $tail) {
            match $tail {
                TypeNil { Ok(CgKindNil) }
                TypeCons($h2, $t2) {
                    match g5_param_kind(Some($head), $env) {
                        Err($m) { Err($m) }
                        Ok($hk) {
                            match g5_func_param_kinds_from_type_args($tail, $env) {
                                Err($m) { Err($m) }
                                Ok($rest) { Ok(CgKindCons($hk, $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_func_kind_from_type_args($args: TypeList, $env: CgEnv): Result[CgKind, Str] {
    match g5_func_param_kinds_from_type_args($args, $env) {
        Err($m) { Err($m) }
        Ok($params) {
            match g5_func_ret_from_type_args($args, $env) {
                Err($m) { Err($m) }
                Ok($ret) { Ok(CgFn($params, $ret)) }
            }
        }
    }
}

sub g5_param_kinds($params: ParamList, $env: CgEnv): Result[CgKindList, Str] {
    match $params {
        ParamNil { Ok(CgKindNil) }
        ParamCons($head, $tail) {
            match g5_param_kind($head.ty, $env) {
                Err($m) { Err($m) }
                Ok($k) {
                    match g5_param_kinds($tail, $env) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok(CgKindCons($k, $rest)) }
                    }
                }
            }
        }
    }
}

# Build an environment containing only annotated parameters. This is enough to
# infer a callback parameter from a body call like `$f($x)`, where `$x` has an
# ordinary annotation but `$f` is intentionally unannotated per §7.4.
sub g5_known_param_env($params: ParamList, $idx: Int, $base: CgEnv): Result[CgEnv, Str] {
    match $params {
        ParamNil { Ok($base) }
        ParamCons($head, $tail) {
            match g5_known_param_env($tail, $idx + 1, $base) {
                Err($m) { Err($m) }
                Ok($rest) {
                    match $head.ty {
                        None { Ok($rest) }
                        Some($tr) {
                            match g5_param_kind($head.ty, $base) {
                                Err($m) { Err($m) }
                                Ok($k) { Ok(CgEnvCons(CgVar(name: $head.name, cname: "gp" ~ c_int($idx), kind: $k, mutable: false, borrowed: true, listlen: g5_param_listlen($head.ty, $k)), $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_kind_from_expr($e: Expr, $env: CgEnv): Option[CgKind] {
    match $e {
        EInt($t) { Some(CgInt) }
        EFloat($t) { Some(CgFloat) }
        EBool($t) { Some(CgBool) }
        EStr($t) { Some(CgStr) }
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) { Some($v.kind) }
                None { None }
            }
        }
        ECall($callee, $args) {
            if g11_is_progress_snapshot_call($callee, $args) {
                Some(CgInt)
            } else {
                match g5_resolve_call_target($callee, $args, $env) {
                    Err($m) { None }
                    Ok($target) { g5_ret_value_kind($target.sig.ret) }
                }
            }
        }
        _ { None }
    }
}

sub g5_arg_kinds_from_exprs($args: ExprList, $env: CgEnv): Option[CgKindList] {
    match $args {
        ExprNil { Some(CgKindNil) }
        ExprCons($head, $tail) {
            match g5_kind_from_expr($head, $env) {
                None { None }
                Some($k) {
                    match g5_arg_kinds_from_exprs($tail, $env) {
                        None { None }
                        Some($rest) { Some(CgKindCons($k, $rest)) }
                    }
                }
            }
        }
    }
}

sub g5_find_fn_call_args_exprs($name: Str, $xs: ExprList, $env: CgEnv): Option[CgKindList] {
    match $xs {
        ExprNil { None }
        ExprCons($head, $tail) {
            match g5_find_fn_call_args_expr($name, $head, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_exprs($name, $tail, $env) }
            }
        }
    }
}

sub g5_find_fn_call_args_expr($name: Str, $e: Expr, $env: CgEnv): Option[CgKindList] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                EName($n) {
                    if $n == $name {
                        # P9-9b-2: the first call we encounter may itself have a
                        # call through this still-untyped function parameter as
                        # an argument (`$f($f($x))`). The outer argument kind
                        # cannot be classified until `$f` has a signature, so on
                        # that miss keep walking its arguments. The inner
                        # `$f($x)` then supplies the concrete parameter kinds;
                        # ordinary `$f($x)` keeps the existing fast path.
                        match g5_arg_kinds_from_exprs($args, $env) {
                            Some($ks) { Some($ks) }
                            None { g5_find_fn_call_args_exprs($name, $args, $env) }
                        }
                    } else {
                        g5_find_fn_call_args_exprs($name, $args, $env)
                    }
                }
                _ {
                    match g5_find_fn_call_args_expr($name, $callee, $env) {
                        Some($ks) { Some($ks) }
                        None { g5_find_fn_call_args_exprs($name, $args, $env) }
                    }
                }
            }
        }
        EList($items) { g5_find_fn_call_args_exprs($name, $items, $env) }
        EUnary($op, $x) { g5_find_fn_call_args_expr($name, $x, $env) }
        EBinary($op, $l, $r) {
            match g5_find_fn_call_args_expr($name, $l, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_expr($name, $r, $env) }
            }
        }
        ENamedArg($n, $v) { g5_find_fn_call_args_expr($name, $v, $env) }
        EField($o, $n) { g5_find_fn_call_args_expr($name, $o, $env) }
        EIndex($o, $i) {
            match g5_find_fn_call_args_expr($name, $o, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_expr($name, $i, $env) }
            }
        }
        EIf($c, $then, $elifs, $els) {
            match g5_find_fn_call_args_expr($name, $c, $env) {
                Some($ks) { Some($ks) }
                None {
                    match g5_find_fn_call_args_stmts($name, $then, $env) {
                        Some($ks) { Some($ks) }
                        None {
                            match g5_find_fn_call_args_elifs($name, $elifs, $env) {
                                Some($ks) { Some($ks) }
                                None { g5_find_fn_call_args_opt_stmts($name, $els, $env) }
                            }
                        }
                    }
                }
            }
        }
        EMatch($subj, $arms) {
            match g5_find_fn_call_args_expr($name, $subj, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_arms($name, $arms, $env) }
            }
        }
        _ { None }
    }
}

sub g5_find_fn_call_args_stmt($name: Str, $s: Stmt, $env: CgEnv): Option[CgKindList] {
    match $s {
        SBind($m, $n, $ty, $v) { g5_find_fn_call_args_expr($name, $v, $env) }
        SReturn($v) {
            match $v {
                None { None }
                Some($x) { g5_find_fn_call_args_expr($name, $x, $env) }
            }
        }
        SExpr($x) { g5_find_fn_call_args_expr($name, $x, $env) }
        SWhile($c, $bd) {
            match g5_find_fn_call_args_expr($name, $c, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_stmts($name, $bd, $env) }
            }
        }
        SFor($vars, $iter, $bd) {
            match g5_find_fn_call_args_expr($name, $iter, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_stmts($name, $bd, $env) }
            }
        }
        SHatch($bd) { g5_find_fn_call_args_stmts($name, $bd, $env) }
        SSelect($arms, $els) { g5_find_fn_call_args_select($name, $arms, $els, $env) }
    }
}

sub g5_find_fn_call_args_select($name: Str, $arms: SelectArmList, $els: Option[StmtList], $env: CgEnv): Option[CgKindList] {
    match $arms {
        SelectArmNil { g5_find_fn_call_args_opt_stmts($name, $els, $env) }
        SelectArmCons($h, $t) {
            match g5_find_fn_call_args_expr($name, $h.op, $env) {
                Some($ks) { Some($ks) }
                None {
                    match g5_find_fn_call_args_stmts($name, $h.body, $env) {
                        Some($ks) { Some($ks) }
                        None { g5_find_fn_call_args_select($name, $t, $els, $env) }
                    }
                }
            }
        }
    }
}

sub g5_find_fn_call_args_stmts($name: Str, $xs: StmtList, $env: CgEnv): Option[CgKindList] {
    match $xs {
        StmtNil { None }
        StmtCons($head, $tail) {
            match g5_find_fn_call_args_stmt($name, $head, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_stmts($name, $tail, $env) }
            }
        }
    }
}

sub g5_find_fn_call_args_opt_stmts($name: Str, $xs: Option[StmtList], $env: CgEnv): Option[CgKindList] {
    match $xs {
        None { None }
        Some($ss) { g5_find_fn_call_args_stmts($name, $ss, $env) }
    }
}

sub g5_find_fn_call_args_elifs($name: Str, $xs: ElifList, $env: CgEnv): Option[CgKindList] {
    match $xs {
        ElifNil { None }
        ElifCons($head, $tail) {
            match g5_find_fn_call_args_expr($name, $head.cond, $env) {
                Some($ks) { Some($ks) }
                None {
                    match g5_find_fn_call_args_stmts($name, $head.body, $env) {
                        Some($ks) { Some($ks) }
                        None { g5_find_fn_call_args_elifs($name, $tail, $env) }
                    }
                }
            }
        }
    }
}

sub g5_find_fn_call_args_arms($name: Str, $xs: ArmList, $env: CgEnv): Option[CgKindList] {
    match $xs {
        ArmNil { None }
        ArmCons($head, $tail) {
            match g5_find_fn_call_args_stmts($name, $head.body, $env) {
                Some($ks) { Some($ks) }
                None { g5_find_fn_call_args_arms($name, $tail, $env) }
            }
        }
    }
}

sub g5_find_fn_call_args_body($name: Str, $body: Body, $env: CgEnv): Option[CgKindList] {
    match $body {
        ExprBody($e) { g5_find_fn_call_args_expr($name, $e, $env) }
        BlockBody($stmts) { g5_find_fn_call_args_stmts($name, $stmts, $env) }
    }
}

sub g5_infer_fn_param_kind($name: Str, $params: ParamList, $body: Body, $ret: CgRet, $env: CgEnv): Result[CgKind, Str] {
    match g5_known_param_env($params, 0, $env) {
        Err($m) { Err($m) }
        Ok($known) {
            match g5_find_fn_call_args_body($name, $body, $known) {
                Some($args) { Ok(CgFn($args, $ret)) }
                None { Err(g3_unsupported()) }
            }
        }
    }
}

sub g5_param_kind_infer($param: Param, $all: ParamList, $body: Body, $ret: CgRet, $env: CgEnv): Result[CgKind, Str] {
    match $param.ty {
        Some($tr) { g5_param_kind($param.ty, $env) }
        None { g5_infer_fn_param_kind($param.name, $all, $body, $ret, $env) }
    }
}

sub g5_param_kinds_infer_on($params: ParamList, $all: ParamList, $body: Body, $ret: CgRet, $env: CgEnv): Result[CgKindList, Str] {
    match $params {
        ParamNil { Ok(CgKindNil) }
        ParamCons($head, $tail) {
            match g5_param_kind_infer($head, $all, $body, $ret, $env) {
                Err($m) { Err($m) }
                Ok($k) {
                    match g5_param_kinds_infer_on($tail, $all, $body, $ret, $env) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok(CgKindCons($k, $rest)) }
                    }
                }
            }
        }
    }
}

sub g5_param_kinds_infer($params: ParamList, $body: Body, $ret: CgRet, $env: CgEnv): Result[CgKindList, Str] {
    g5_param_kinds_infer_on($params, $params, $body, $ret, $env)
}

# Map a sub's annotated return type to its return kind. Non-main subs must be
# annotated; unannotated return inference is deferred.
sub g5_ret_kind($ret: Option[TypeRef], $env: CgEnv): Result[CgRet, Str] {
    match $ret {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Int" {
                Ok(RInt)
            } else if $tr.name == "Float" {
                Ok(RFloat)
            } else if $tr.name == "Bool" {
                Ok(RBool)
            } else if $tr.name == "Str" {
                Ok(RStr)
            } else if $tr.name == "Regex" {
                # §13 Regex returns are owned pattern Strs (native's rep).
                Ok(RStr)
            } else if $tr.name == "Bush" {
                Ok(RBush)
            } else if $tr.name == "Chan" {
                match g11_chan_kind_from_type($ret, $env) {
                    Err($m) { Err($m) }
                    Ok($k) {
                        match $k {
                            CgChan($el) { Ok(RChan($el)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else if $tr.name == "Unit" {
                Ok(RUnit)
            } else if $tr.name == "List" {
                match g7_list_elem_kind_from_type($ret) {
                    Ok($el) { Ok(RList($el)) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Option" {
                match g6_option_kind_from_type_env($ret, $env) {
                    Ok($k) { Ok(ROpt($k)) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Result" {
                match g6_result_kind_from_type($ret, $env) {
                    Ok($k) { Ok(RRes($k)) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Map" {
                # G7-c-2b: a sub may RETURN a `Map[Str, V]` value (the heap
                # guji_map_t rep). Map PARAMETERS stay out of subset (g5_param_kind
                # rejects them) because the native oracle's map-argument codegen is
                # buggy — it releases the freshly-built backing arrays before the
                # call and segfaults — so a map-argument program can never agree.
                match g7_map_val_kind_from_type($ret) {
                    Ok($v) { Ok(RMap($v)) }
                    Err($m) { Err($m) }
                }
            } else {
                match g8_generic_enum_name_from_type($tr) {
                    Some($specn) {
                        match cg_env_lookup_enum($env, $specn) {
                            Some($info) { Ok(REnum($specn)) }
                            None {
                                match cg_env_lookup_class($env, $tr.name) {
                                    Some($info) { Ok(RClass($tr.name)) }
                                    None {
                                        match g8_generic_class_name_from_type($tr) {
                                            None { Err(g3_unsupported()) }
                                            Some($cspecn) {
                                                match cg_env_lookup_class($env, $cspecn) {
                                                    Some($info) { Ok(RClass($cspecn)) }
                                                    None { Err(g3_unsupported()) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    None {
                        match cg_env_lookup_enum($env, $tr.name) {
                            Some($info) { Ok(REnum($tr.name)) }
                            None {
                                match cg_env_lookup_class($env, $tr.name) {
                                    Some($info) { Ok(RClass($tr.name)) }
                                    None {
                                        match g8_generic_class_name_from_type($tr) {
                                            None { Err(g3_unsupported()) }
                                            Some($specn) {
                                                match cg_env_lookup_class($env, $specn) {
                                                    Some($info) { Ok(RClass($specn)) }
                                                    None { Err(g3_unsupported()) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# P9-9a: an UNANNOTATED sub whose trailing expression is a (non-topic) lambda
# returns that lambda's function value — infer `RFn(params, ret)` from the
# lambda's own annotations (native infers the same TFn return from the body).
sub g5_fn_ret_from_body($sub: SubDecl, $env: CgEnv): Result[CgRet, Str] {
    match g8_sub_trailing_expr($sub) {
        None { Err(g3_unsupported()) }
        Some($e) {
            match $e {
                ELambda($params, $ret, $body, $topic) {
                    if $topic {
                        Err(g3_unsupported())
                    } else {
                        match g5_param_kinds($params, $env) {
                            Err($m) { Err($m) }
                            Ok($pk) {
                                match g5_ret_kind($ret, $env) {
                                    Err($m) { Err($m) }
                                    Ok($rk) { Ok(RFn($pk, $rk)) }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Map a concrete value kind to the CgRet a sub returning that value would carry.
# Mirrors native T2b/T3: scalars, Unit, nominals, Option/Result/List/Map/Fn/Chan/
# Bush. Match/Handle/Closed/boxed carriers stay out (need an annotation or are
# beyond the unannotated SubSig matrix).
sub g5_kind_to_ret($k: CgKind): Result[CgRet, Str] {
    match $k {
        CgInt { Ok(RInt) }
        CgFloat { Ok(RFloat) }
        CgBool { Ok(RBool) }
        CgStr { Ok(RStr) }
        CgUnit { Ok(RUnit) }
        CgBush { Ok(RBush) }
        CgEnum($n) { Ok(REnum($n)) }
        CgClass($n) { Ok(RClass($n)) }
        CgOptInt { Ok(ROpt(CgOptInt)) }
        CgOptFloat { Ok(ROpt(CgOptFloat)) }
        CgOptBool { Ok(ROpt(CgOptBool)) }
        CgOptStr { Ok(ROpt(CgOptStr)) }
        CgOptClass($n) { Ok(ROpt(CgOptClass($n))) }
        CgOptEnum($n) { Ok(ROpt(CgOptEnum($n))) }
        CgOptList($el) { Ok(ROpt(CgOptList($el))) }
        CgOptMap($v) { Ok(ROpt(CgOptMap($v))) }
        CgOptMatch { Ok(ROpt(CgOptMatch)) }
        CgOptBush { Ok(ROpt(CgOptBush)) }
        CgOptCarrier($inner) { Ok(ROpt(CgOptCarrier($inner))) }
        CgRes($ok, $err) { Ok(RRes(CgRes($ok, $err))) }
        CgList($el) { Ok(RList($el)) }
        CgMap($v) { Ok(RMap($v)) }
        CgFn($p, $r) { Ok(RFn($p, $r)) }
        CgChan($el) { Ok(RChan($el)) }
        _ { Err(g3_unsupported()) }
    }
}

# Bind annotated parameters into `$env` so body return-kind inference can see
# `$n * 2` / `$x / 2.0` operand kinds. Unannotated params (including `$self`)
# are skipped — method builders pre-bind `$self` before calling inference.
sub g5_params_to_infer_env($params: ParamList, $env: CgEnv): CgEnv {
    match $params {
        ParamNil { $env }
        ParamCons($p, $t) {
            $rest = g5_params_to_infer_env($t, $env)
            match g5_param_kind($p.ty, $env) {
                Err($m) { $rest }
                Ok($k) {
                    CgEnvCons(CgVar(name: $p.name, cname: "gi", kind: $k, mutable: false, borrowed: true, listlen: 0 - 1), $rest)
                }
            }
        }
    }
}

# Infer a return kind from a trailing body expression (P9-10b-3b / native T2b+T3
# SubSig). print/note and `()` are Unit; a resolved user-sub call yields that
# callee's recorded ret (including RUnit); otherwise map a concrete value kind
# from g5g_arg_kind_from_expr (binop/unary/literal/Option/class/enum/…).
sub g5_infer_ret_from_expr($e: Expr, $env: CgEnv): Result[CgRet, Str] {
    match g3_expr_print_arg($e) {
        Some($a) { Ok(RUnit) }
        None {
            match g3_expr_note_arg($e) {
                Some($a) { Ok(RUnit) }
                None {
                    match $e {
                        EUnit { Ok(RUnit) }
                        ECall($callee, $args) {
                            # I4c: a bound function-value local (`$g(...)`) carries
                            # its CgFn ret directly; g5_resolve_call_target only
                            # sees named subs.
                            match $callee {
                                EName($fn) {
                                    match cg_env_lookup($env, $fn) {
                                        Some($v) {
                                            match $v.kind {
                                                CgFn($p, $r) { Ok($r) }
                                                _ {
                                                    match g5_resolve_call_target($callee, $args, $env) {
                                                        Ok($t) { Ok($t.sig.ret) }
                                                        Err($m) {
                                                            match g5g_arg_kind_from_expr($e, $env) {
                                                                Some($k) { g5_kind_to_ret($k) }
                                                                None { Err(g3_unsupported()) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        None {
                                            match g5_resolve_call_target($callee, $args, $env) {
                                                Ok($t) { Ok($t.sig.ret) }
                                                Err($m) {
                                                    match g5g_arg_kind_from_expr($e, $env) {
                                                        Some($k) { g5_kind_to_ret($k) }
                                                        None { Err(g3_unsupported()) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ {
                                    match g5_resolve_call_target($callee, $args, $env) {
                                        Ok($t) { Ok($t.sig.ret) }
                                        Err($m) {
                                            match g5g_arg_kind_from_expr($e, $env) {
                                                Some($k) { g5_kind_to_ret($k) }
                                                None { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ {
                            match g5g_arg_kind_from_expr($e, $env) {
                                Some($k) { g5_kind_to_ret($k) }
                                None { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# P9-10b-3b: unannotated sub/method return kind from the body (native
# TypeInfo.SubSig). Trailing-lambda (P9-9a) stays first; empty block bodies are
# Unit; every other trailing value uses g5_infer_ret_from_expr under an env that
# includes annotated parameters (and a pre-bound `$self` for methods).
sub g5_infer_ret_from_body($sub: SubDecl, $env: CgEnv): Result[CgRet, Str] {
    match g5_fn_ret_from_body($sub, $env) {
        Ok($rfn) { Ok($rfn) }
        Err($lm) {
            $ienv = g5_params_to_infer_env($sub.params, $env)
            match g8_sub_trailing_expr($sub) {
                Some($e) { g5_infer_ret_from_expr($e, $ienv) }
                None {
                    match $sub.body {
                        BlockBody(StmtNil) { Ok(RUnit) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# A non-main sub's return kind: the annotation when present, else body inference
# (P9-9a lambda + P9-10b-3b unannotated scalar/Unit/compound), else decline.
# P9-10b-3b-2b: a BARE `: Func` annotation defers to body inference — a trailing
# lambda yields its concrete RFn (native subReturnFuncSig), while a trailing
# bare-`Func` parameter yields the canonical placeholder shape the call sites
# substitute back to concrete (native RC1.5b-ii-c CallSig recovery).
sub g5_sub_ret_kind($sub: SubDecl, $env: CgEnv): Result[CgRet, Str] {
    match $sub.ret {
        Some($tr) {
            if $tr.name == "Func" {
                match $tr.args {
                    TypeNil { g5_infer_ret_from_body($sub, $env) }
                    _ { g5_ret_kind($sub.ret, $env) }
                }
            } else {
                g5_ret_kind($sub.ret, $env)
            }
        }
        None {
            match g5_infer_ret_from_body($sub, $env) {
                Ok($r) { Ok($r) }
                Err($m) { g5_ret_kind($sub.ret, $env) }
            }
        }
    }
}

# P9-10b-3b-2b: an annotation that is BARE `Func` (no type arguments).
sub g5_ty_is_bare_func($ty: Option[TypeRef]): Bool {
    match $ty {
        None { false }
        Some($tr) {
            if $tr.name == "Func" {
                match $tr.args { TypeNil { true } _ { false } }
            } else {
                false
            }
        }
    }
}

sub g5_params_have_bare_func($params: ParamList): Bool {
    match $params {
        ParamNil { false }
        ParamCons($h, $t) { g5_ty_is_bare_func($h.ty) || g5_params_have_bare_func($t) }
    }
}

# Whether a sub's BARE `: Func` return keeps a substitutable placeholder shape:
# true unless the trailing body expression is a lambda, whose own annotations
# already pin the concrete RFn (native subReturnFuncSig beats CallSig there).
sub g5_sub_ret_is_bare_func($sub: SubDecl): Bool {
    if g5_ty_is_bare_func($sub.ret) {
        match g8_sub_trailing_expr($sub) {
            Some($e) {
                match $e {
                    ELambda($p, $r, $b, $topic) { false }
                    _ { true }
                }
            }
            None { true }
        }
    } else {
        false
    }
}

# Build a sub's codegen signature. Local `main` is special: its C return is always
# int64_t and its body is lowered with RInt (Int exit code, or 0LL for a Unit
# body), so its signature return is recorded as RInt regardless of annotation.
sub g5_build_sig_as($sub: SubDecl, $env: CgEnv, $lookup_name: Str, $cname: Str, $main_special: Bool): Result[CgSig, Str] {
    if $main_special && $sub.name == "main" {
        match g5_param_kinds_infer($sub.params, $sub.body, RInt, $env) {
            Err($m) { Err($m) }
            Ok($pk) { Ok(CgSig(name: $lookup_name, cname: $cname, params: $pk, ret: RInt, retregex: false, barefn: g5_params_have_bare_func($sub.params), retbarefn: false)) }
        }
    } else {
        match g5_sub_ret_kind($sub, $env) {
            Err($m) { Err($m) }
            Ok($r) {
                match g5_param_kinds_infer($sub.params, $sub.body, $r, $env) {
                    Err($m) { Err($m) }
                    Ok($pk) { Ok(CgSig(name: $lookup_name, cname: $cname, params: $pk, ret: $r, retregex: g6_ty_is_regex($sub.ret) || g6_ty_is_result_regex($sub.ret), barefn: g5_params_have_bare_func($sub.params), retbarefn: g5_sub_ret_is_bare_func($sub))) }
                }
            }
        }
    }
}

sub g5_build_sig($sub: SubDecl, $env: CgEnv): Result[CgSig, Str] {
    $cname = if $sub.name == "main" { "gf_main" } else { "gf_" ~ $sub.name }
    g5_build_sig_as($sub, $env, $sub.name, $cname, true)
}

sub g5_class_cname($class_name: Str, $sub_name: Str): Str {
    "gf_" ~ $class_name ~ "_" ~ $sub_name
}

sub g5_enum_cname($enum_name: Str, $sub_name: Str): Str {
    "gf_" ~ $enum_name ~ "_" ~ $sub_name
}

sub g5_method_param_kinds($params: ParamList, $class_name: Str, $env: CgEnv): Result[CgKindList, Str] {
    match $params {
        ParamNil { Err(g3_unsupported()) }
        ParamCons($head, $tail) {
            if $head.name == '$self' {
                match g5_param_kinds($tail, $env) {
                    Err($m) { Err($m) }
                    Ok($rest) { Ok(CgKindCons(CgClass($class_name), $rest)) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_enum_method_param_kinds($params: ParamList, $enum_name: Str, $env: CgEnv): Result[CgKindList, Str] {
    match $params {
        ParamNil { Err(g3_unsupported()) }
        ParamCons($head, $tail) {
            if $head.name == '$self' {
                match g5_param_kinds($tail, $env) {
                    Err($m) { Err($m) }
                    Ok($rest) { Ok(CgKindCons(CgEnum($enum_name), $rest)) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_build_class_sig_as($class_name: Str, $sub: SubDecl, $env: CgEnv, $lookup: Str, $cname: Str): Result[CgSig, Str] {
    if is_method_sub($sub) {
        # P9-10b-3b: unannotated methods infer return kind from the body with
        # `$self` pre-bound as the owning class (g5_sub_ret_kind / SubSig).
        # §8.3 private-field shorthands are borrowed views into that receiver,
        # and must be visible during inference as well as body emission.
        $selfenv = CgEnvCons(CgVar(name: '$self', cname: "gi", kind: CgClass($class_name), mutable: false, borrowed: true, listlen: 0 - 1), $env)
        match g5_class_private_env($class_name, "gi", $selfenv) {
            Err($m) { Err($m) }
            Ok($menv) {
                match g5_sub_ret_kind($sub, $menv) {
                    Err($m) { Err($m) }
                    Ok($r) {
                        match g5_method_param_kinds($sub.params, $class_name, $env) {
                            Err($m) { Err($m) }
                            Ok($pk) { Ok(CgSig(name: $lookup, cname: $cname, params: $pk, ret: $r, retregex: g6_ty_is_regex($sub.ret) || g6_ty_is_result_regex($sub.ret), barefn: g5_params_have_bare_func($sub.params), retbarefn: g5_sub_ret_is_bare_func($sub))) }
                        }
                    }
                }
            }
        }
    } else {
        g5_build_sig_as($sub, $env, $lookup, $cname, false)
    }
}

sub g5_build_class_sig($class_name: Str, $sub: SubDecl, $env: CgEnv): Result[CgSig, Str] {
    g5_build_class_sig_as($class_name, $sub, $env, $class_name ~ "." ~ $sub.name, g5_class_cname($class_name, $sub.name))
}

# Imported class-body subs keep their bare logical lookup name while the module
# body is emitted (`Point.shift`), but their C symbol is alias-prefixed so it
# cannot collide with an entry-module method or a method from another import.
sub g5_build_import_class_sig($alias: Str, $class_name: Str, $sub: SubDecl, $env: CgEnv): Result[CgSig, Str] {
    g5_build_class_sig_as(
        $class_name,
        $sub,
        $env,
        $class_name ~ "." ~ $sub.name,
        g9_import_cname($alias, g9_type_display_name($class_name) ~ "_" ~ $sub.name)
    )
}

sub g5_build_enum_method_sig_as($enum_name: Str, $sub: SubDecl, $env: CgEnv, $lookup: Str, $cname: Str): Result[CgSig, Str] {
    # §9 methods take `$self` (a CgEnum receiver); §7.5 associated functions take
    # no receiver — their signature is the ordinary sub shape (mirrors the class
    # split in g5_build_class_sig).
    if is_method_sub($sub) {
        # P9-10b-3b: unannotated enum methods infer return kind with `$self`
        # pre-bound as the owning enum (native TypeInfo.SubSig).
        $menv = CgEnvCons(CgVar(name: '$self', cname: "gi", kind: CgEnum($enum_name), mutable: false, borrowed: true, listlen: 0 - 1), $env)
        match g5_sub_ret_kind($sub, $menv) {
            Err($m) { Err($m) }
            Ok($r) {
                match g5_enum_method_param_kinds($sub.params, $enum_name, $env) {
                    Err($m) { Err($m) }
                    Ok($pk) { Ok(CgSig(name: $lookup, cname: $cname, params: $pk, ret: $r, retregex: g6_ty_is_regex($sub.ret) || g6_ty_is_result_regex($sub.ret), barefn: g5_params_have_bare_func($sub.params), retbarefn: g5_sub_ret_is_bare_func($sub))) }
                }
            }
        }
    } else {
        g5_build_sig_as($sub, $env, $lookup, $cname, false)
    }
}

sub g5_build_enum_method_sig($enum_name: Str, $sub: SubDecl, $env: CgEnv): Result[CgSig, Str] {
    g5_build_enum_method_sig_as($enum_name, $sub, $env, $enum_name ~ "." ~ $sub.name, g5_enum_cname($enum_name, $sub.name))
}

# Imported enum-body subs mirror the imported class split: bare logical lookup
# (`Choice.pick`) for the module body and bound/assoc dispatch, alias-prefixed
# C symbol (`gf_imp_tokens_Choice_pick`) for collision-free linkage.
sub g5_build_import_enum_method_sig($alias: Str, $enum_name: Str, $sub: SubDecl, $env: CgEnv): Result[CgSig, Str] {
    g5_build_enum_method_sig_as(
        $enum_name,
        $sub,
        $env,
        $enum_name ~ "." ~ $sub.name,
        g9_import_cname($alias, g9_type_display_name($enum_name) ~ "_" ~ $sub.name)
    )
}

sub g5_collect_class_sigs($class_name: Str, $subs: SubDeclList, $base: CgEnv, $tail: CgEnv): Result[CgEnv, Str] {
    match $subs {
        SubDeclNil { Ok($tail) }
        SubDeclCons($head, $rest) {
            match g5_collect_class_sigs($class_name, $rest, $base, $tail) {
                Err($m) { Err($m) }
                Ok($more) {
                    # P5b-1: generic class-body subs are templates — no direct sig.
                    if g5g_is_generic($head) {
                        Ok($more)
                    } else {
                        match g5_build_class_sig($class_name, $head, $base) {
                            Err($m) { Err($m) }
                            Ok($sig) { Ok(CgEnvSub($sig, $more)) }
                        }
                    }
                }
            }
        }
    }
}

sub g5_collect_import_class_sigs($alias: Str, $class_name: Str, $subs: SubDeclList, $base: CgEnv, $tail: CgEnv): Result[CgEnv, Str] {
    match $subs {
        SubDeclNil { Ok($tail) }
        SubDeclCons($head, $rest) {
            match g5_collect_import_class_sigs($alias, $class_name, $rest, $base, $tail) {
                Err($m) { Err($m) }
                Ok($more) {
                    if g5g_is_generic($head) {
                        Ok($more)
                    } else {
                        match g5_build_import_class_sig($alias, $class_name, $head, $base) {
                            Err($m) { Err($m) }
                            Ok($sig) { Ok(CgEnvSub($sig, $more)) }
                        }
                    }
                }
            }
        }
    }
}

sub g5_collect_import_enum_method_sigs($alias: Str, $enum_name: Str, $subs: SubDeclList, $base: CgEnv, $tail: CgEnv): Result[CgEnv, Str] {
    match $subs {
        SubDeclNil { Ok($tail) }
        SubDeclCons($head, $rest) {
            match g5_collect_import_enum_method_sigs($alias, $enum_name, $rest, $base, $tail) {
                Err($m) { Err($m) }
                Ok($more) {
                    if g5g_is_generic($head) {
                        Ok($more)
                    } else {
                        match g5_build_import_enum_method_sig($alias, $enum_name, $head, $base) {
                            Err($m) { Err($m) }
                            Ok($sig) { Ok(CgEnvSub($sig, $more)) }
                        }
                    }
                }
            }
        }
    }
}

sub g5_collect_enum_method_sigs($enum_name: Str, $subs: SubDeclList, $base: CgEnv, $tail: CgEnv): Result[CgEnv, Str] {
    match $subs {
        SubDeclNil { Ok($tail) }
        SubDeclCons($head, $rest) {
            match g5_collect_enum_method_sigs($enum_name, $rest, $base, $tail) {
                Err($m) { Err($m) }
                Ok($more) {
                    # Collect BOTH §9 methods and §7.5 associated functions; only
                    # generic-template body subs are skipped (their specs, if any,
                    # are cloned elsewhere). g5_build_enum_method_sig branches on
                    # is_method_sub for the receiver.
                    if g5g_is_generic($head) {
                        Ok($more)
                    } else {
                        match g5_build_enum_method_sig($enum_name, $head, $base) {
                            Err($m) { Err($m) }
                            Ok($sig) { Ok(CgEnvSub($sig, $more)) }
                        }
                    }
                }
            }
        }
    }
}

sub g9_import_cname($alias: Str, $name: Str): Str {
    "gf_imp_" ~ $alias ~ "_" ~ $name
}

# C type/symbol identity for an imported class/enum. Distinct modules that
# declare the same PascalCase name must not share one `struct Point` (I8b3).
sub g9_import_type_name($alias: Str, $name: Str): Str {
    $alias ~ "_" ~ $name
}

# Recover the source PascalCase spelling from an import-mangled C type name
# (`left_Point` / `module_values_Point` → `Point`).
sub g9_import_type_display_name($cname: Str): Str {
    @parts: List[Str] = split($cname, "_")
    if @parts.count() <= 1 {
        $cname
    } else {
        $last = @parts[@parts.count() - 1]
        if $last == "" {
            $cname
        } else if is_upper(first_char($last)) {
            $last
        } else {
            $cname
        }
    }
}

# Display helpers receive the concrete C identity of generic specs as well as
# imported types.  Strip a generated generic suffix FIRST (`Box__Str` → `Box`,
# `left_Box__Str` → `left_Box`), then remove any import prefix.  Treating the
# final generic tag as an import-mangled Pascal name rendered `Box[Str]` values
# as `Str(...)` instead of the source identity `Box(...)` (P09c).
sub g9_type_display_name($cname: Str): Str {
    @spec: List[Str] = split($cname, "__")
    if @spec.count() >= 2 {
        g9_import_type_display_name(@spec[0])
    } else {
        g9_import_type_display_name($cname)
    }
}

sub g9_strlist_has($xs: StrList, $s: Str): Bool {
    strlist_contains($xs, $s)
}

sub g9_collect_nominal_names($decls: DeclList): StrList {
    match $decls {
        DeclNil { StrNil }
        DeclCons($head, $tail) {
            $rest = g9_collect_nominal_names($tail)
            match $head {
                DClass($c) { StrCons($c.name, $rest) }
                DEnum($e) { StrCons($e.name, $rest) }
                _ { $rest }
            }
        }
    }
}

sub g9_mangle_one_name($alias: Str, $name: Str, $names: StrList): Str {
    if g9_strlist_has($names, $name) {
        g9_import_type_name($alias, $name)
    } else {
        $name
    }
}

sub g9_mangle_typeref($alias: Str, $tr: TypeRef, $names: StrList): TypeRef {
    TypeRef(name: g9_mangle_one_name($alias, $tr.name, $names), args: g9_mangle_typelist($alias, $tr.args, $names))
}

sub g9_mangle_typelist($alias: Str, $ts: TypeList, $names: StrList): TypeList {
    match $ts {
        TypeNil { TypeNil }
        TypeCons($h, $t) { TypeCons(g9_mangle_typeref($alias, $h, $names), g9_mangle_typelist($alias, $t, $names)) }
    }
}

sub g9_mangle_opt_type($alias: Str, $ty: Option[TypeRef], $names: StrList): Option[TypeRef] {
    match $ty {
        None { None }
        Some($tr) { Some(g9_mangle_typeref($alias, $tr, $names)) }
    }
}

sub g9_mangle_params($alias: Str, $ps: ParamList, $names: StrList): ParamList {
    match $ps {
        ParamNil { ParamNil }
        ParamCons($h, $t) {
            ParamCons(
                Param(name: $h.name, ty: g9_mangle_opt_type($alias, $h.ty, $names)),
                g9_mangle_params($alias, $t, $names)
            )
        }
    }
}

sub g9_mangle_class_fields($alias: Str, $fs: ClassFieldList, $names: StrList): ClassFieldList {
    match $fs {
        ClassFieldNil { ClassFieldNil }
        ClassFieldCons($h, $t) {
            ClassFieldCons(
                ClassField(public: $h.public, sigil: $h.sigil, name: $h.name, ty: g9_mangle_opt_type($alias, $h.ty, $names)),
                g9_mangle_class_fields($alias, $t, $names)
            )
        }
    }
}

sub g9_mangle_variants($alias: Str, $vs: VariantList, $names: StrList): VariantList {
    match $vs {
        VariantNil { VariantNil }
        VariantCons($h, $t) {
            VariantCons(
                Variant(name: $h.name, fields: g9_mangle_params($alias, $h.fields, $names)),
                g9_mangle_variants($alias, $t, $names)
            )
        }
    }
}

sub g9_mangle_exprlist($alias: Str, $xs: ExprList, $names: StrList): ExprList {
    match $xs {
        ExprNil { ExprNil }
        ExprCons($h, $t) { ExprCons(g9_mangle_expr($alias, $h, $names), g9_mangle_exprlist($alias, $t, $names)) }
    }
}

sub g9_mangle_mapentries($alias: Str, $xs: MapEntryList, $names: StrList): MapEntryList {
    match $xs {
        MapEntryNil { MapEntryNil }
        MapEntryCons($h, $t) {
            MapEntryCons(
                MapEntry(key: g9_mangle_expr($alias, $h.key, $names), value: g9_mangle_expr($alias, $h.value, $names)),
                g9_mangle_mapentries($alias, $t, $names)
            )
        }
    }
}

sub g9_mangle_elifs($alias: Str, $xs: ElifList, $names: StrList): ElifList {
    match $xs {
        ElifNil { ElifNil }
        ElifCons($h, $t) {
            ElifCons(
                Elif(cond: g9_mangle_expr($alias, $h.cond, $names), body: g9_mangle_stmts($alias, $h.body, $names)),
                g9_mangle_elifs($alias, $t, $names)
            )
        }
    }
}

sub g9_mangle_opt_stmts($alias: Str, $xs: Option[StmtList], $names: StrList): Option[StmtList] {
    match $xs {
        None { None }
        Some($ss) { Some(g9_mangle_stmts($alias, $ss, $names)) }
    }
}

sub g9_mangle_opt_expr($alias: Str, $x: Option[Expr], $names: StrList): Option[Expr] {
    match $x {
        None { None }
        Some($e) { Some(g9_mangle_expr($alias, $e, $names)) }
    }
}

sub g9_mangle_pattern($alias: Str, $p: Pattern, $names: StrList): Pattern {
    match $p {
        PLit($e) { PLit(g9_mangle_expr($alias, $e, $names)) }
        PWild { PWild }
        PBind($n) { PBind($n) }
        # Variant tags stay source-spelled; only enum/class type names mangle.
        PVariant($n, $args) { PVariant($n, g9_mangle_patterns($alias, $args, $names)) }
    }
}

sub g9_mangle_patterns($alias: Str, $ps: PatternList, $names: StrList): PatternList {
    match $ps {
        PatNil { PatNil }
        PatCons($h, $t) { PatCons(g9_mangle_pattern($alias, $h, $names), g9_mangle_patterns($alias, $t, $names)) }
    }
}

sub g9_mangle_arms($alias: Str, $xs: ArmList, $names: StrList): ArmList {
    match $xs {
        ArmNil { ArmNil }
        ArmCons($h, $t) {
            ArmCons(
                Arm(
                    pat: g9_mangle_pattern($alias, $h.pat, $names),
                    guard: g9_mangle_opt_expr($alias, $h.guard, $names),
                    body: g9_mangle_stmts($alias, $h.body, $names)
                ),
                g9_mangle_arms($alias, $t, $names)
            )
        }
    }
}

sub g9_mangle_select_arms($alias: Str, $xs: SelectArmList, $names: StrList): SelectArmList {
    match $xs {
        SelectArmNil { SelectArmNil }
        SelectArmCons($h, $t) {
            SelectArmCons(
                SelectArm(
                    bind: $h.bind,
                    op: g9_mangle_expr($alias, $h.op, $names),
                    body: g9_mangle_stmts($alias, $h.body, $names)
                ),
                g9_mangle_select_arms($alias, $t, $names)
            )
        }
    }
}

# Rewrite ETypeName / TypeRef spellings of imported class/enum names to
# alias_Name so method bodies still construct and annotate after decl rename.
sub g9_mangle_expr($alias: Str, $e: Expr, $names: StrList): Expr {
    match $e {
        EInt($t) { EInt($t) }
        EFloat($t) { EFloat($t) }
        EStr($t) { EStr($t) }
        ERawStr($t) { ERawStr($t) }
        ERegex($p, $rl, $rc) { ERegex($p, $rl, $rc) }
        EBool($t) { EBool($t) }
        EName($n) { EName($n) }
        ETypeName($n) { ETypeName(g9_mangle_one_name($alias, $n, $names)) }
        EQualified($m, $n) { EQualified($m, $n) }
        EUnit { EUnit }
        EList($items) { EList(g9_mangle_exprlist($alias, $items, $names)) }
        EMap($items) { EMap(g9_mangle_mapentries($alias, $items, $names)) }
        EUnary($op, $x) { EUnary($op, g9_mangle_expr($alias, $x, $names)) }
        EBinary($op, $l, $r) { EBinary($op, g9_mangle_expr($alias, $l, $names), g9_mangle_expr($alias, $r, $names)) }
        ENamedArg($n, $v) { ENamedArg($n, g9_mangle_expr($alias, $v, $names)) }
        ECall($callee, $args) { ECall(g9_mangle_expr($alias, $callee, $names), g9_mangle_exprlist($alias, $args, $names)) }
        EField($obj, $name) { EField(g9_mangle_expr($alias, $obj, $names), $name) }
        EIndex($obj, $idx) { EIndex(g9_mangle_expr($alias, $obj, $names), g9_mangle_expr($alias, $idx, $names)) }
        ECapture($obj, $name) { ECapture(g9_mangle_expr($alias, $obj, $names), $name) }
        EIf($cond, $then, $elifs, $els) {
            EIf(
                g9_mangle_expr($alias, $cond, $names),
                g9_mangle_stmts($alias, $then, $names),
                g9_mangle_elifs($alias, $elifs, $names),
                g9_mangle_opt_stmts($alias, $els, $names)
            )
        }
        EMatch($subj, $arms) { EMatch(g9_mangle_expr($alias, $subj, $names), g9_mangle_arms($alias, $arms, $names)) }
        ELambda($params, $ret, $body, $topic) {
            ELambda(
                g9_mangle_params($alias, $params, $names),
                g9_mangle_opt_type($alias, $ret, $names),
                g9_mangle_stmts($alias, $body, $names),
                $topic
            )
        }
        EQuestion($x) { EQuestion(g9_mangle_expr($alias, $x, $names)) }
    }
}

sub g9_mangle_stmt($alias: Str, $s: Stmt, $names: StrList): Stmt {
    match $s {
        SBind($m, $n, $ty, $v) {
            SBind($m, $n, g9_mangle_opt_type($alias, $ty, $names), g9_mangle_expr($alias, $v, $names))
        }
        SReturn($v) { SReturn(g9_mangle_opt_expr($alias, $v, $names)) }
        SExpr($e) { SExpr(g9_mangle_expr($alias, $e, $names)) }
        SWhile($cond, $body) {
            SWhile(g9_mangle_expr($alias, $cond, $names), g9_mangle_stmts($alias, $body, $names))
        }
        SFor($vars, $iter, $body) {
            SFor($vars, g9_mangle_expr($alias, $iter, $names), g9_mangle_stmts($alias, $body, $names))
        }
        SHatch($body) { SHatch(g9_mangle_stmts($alias, $body, $names)) }
        SSelect($arms, $els) {
            SSelect(g9_mangle_select_arms($alias, $arms, $names), g9_mangle_opt_stmts($alias, $els, $names))
        }
    }
}

sub g9_mangle_stmts($alias: Str, $ss: StmtList, $names: StrList): StmtList {
    match $ss {
        StmtNil { StmtNil }
        StmtCons($h, $t) { StmtCons(g9_mangle_stmt($alias, $h, $names), g9_mangle_stmts($alias, $t, $names)) }
    }
}

sub g9_mangle_body($alias: Str, $b: Body, $names: StrList): Body {
    match $b {
        BlockBody($ss) { BlockBody(g9_mangle_stmts($alias, $ss, $names)) }
        ExprBody($e) { ExprBody(g9_mangle_expr($alias, $e, $names)) }
    }
}

sub g9_mangle_subs($alias: Str, $ss: SubDeclList, $names: StrList): SubDeclList {
    match $ss {
        SubDeclNil { SubDeclNil }
        SubDeclCons($h, $t) {
            SubDeclCons(
                SubDecl(
                    public: $h.public,
                    name: $h.name,
                    line: $h.line,
                    col: $h.col,
                    body_line: $h.body_line,
                    body_col: $h.body_col,
                    tparams: $h.tparams,
                    params: g9_mangle_params($alias, $h.params, $names),
                    ret: g9_mangle_opt_type($alias, $h.ret, $names),
                    body: g9_mangle_body($alias, $h.body, $names)
                ),
                g9_mangle_subs($alias, $t, $names)
            )
        }
    }
}

# Rename imported class/enum declarations, TypeRefs, and body ETypeNames to
# `alias_Name` so two modules with the same PascalCase type do not collide in
# one C translation unit while constructors still resolve after the rename.
sub g9_mangle_import_decls($alias: Str, $decls: DeclList): DeclList {
    $names = g9_collect_nominal_names($decls)
    g9_mangle_import_decls_on($alias, $decls, $names)
}

sub g9_mangle_import_decls_on($alias: Str, $decls: DeclList, $names: StrList): DeclList {
    match $decls {
        DeclNil { DeclNil }
        DeclCons($head, $tail) {
            $rest = g9_mangle_import_decls_on($alias, $tail, $names)
            match $head {
                DClass($c) {
                    DeclCons(DClass(ClassDecl(
                        public: $c.public,
                        name: g9_import_type_name($alias, $c.name),
                        tparams: $c.tparams,
                        fields: g9_mangle_class_fields($alias, $c.fields, $names),
                        subs: g9_mangle_subs($alias, $c.subs, $names)
                    )), $rest)
                }
                DEnum($e) {
                    DeclCons(DEnum(EnumDecl(
                        public: $e.public,
                        name: g9_import_type_name($alias, $e.name),
                        tparams: $e.tparams,
                        variants: g9_mangle_variants($alias, $e.variants, $names),
                        subs: g9_mangle_subs($alias, $e.subs, $names)
                    )), $rest)
                }
                DSub($s) {
                    DeclCons(DSub(SubDecl(
                        public: $s.public,
                        name: $s.name,
                        line: $s.line,
                        col: $s.col,
                        body_line: $s.body_line,
                        body_col: $s.body_col,
                        tparams: $s.tparams,
                        params: g9_mangle_params($alias, $s.params, $names),
                        ret: g9_mangle_opt_type($alias, $s.ret, $names),
                        body: g9_mangle_body($alias, $s.body, $names)
                    )), $rest)
                }
                _ { DeclCons($head, $rest) }
            }
        }
    }
}

# Qualified constructors need an alias-aware class identity without adding a
# new CgEnv variant (the arm-count ceiling is fixed). Store one non-callable
# signature marker per public imported class; its return carries the mangled
# C struct/class name used by imported typedef and ownership helpers.
sub g9_import_class_key($alias: Str, $name: Str): Str {
    $alias ~ "::" ~ $name ~ "#class"
}

sub g9_import_class_marker($alias: Str, $name: Str): CgSig {
    CgSig(name: g9_import_class_key($alias, $name), cname: "", params: CgKindNil, ret: RClass(g9_import_type_name($alias, $name)), retregex: false, barefn: false, retbarefn: false)
}

sub g9_qualified_class_name($alias: Str, $name: Str, $env: CgEnv): Option[Str] {
    match cg_env_lookup_sub($env, g9_import_class_key($alias, $name)) {
        None { None }
        Some($sig) {
            match $sig.ret {
                RClass($n) { Some($n) }
                _ { None }
            }
        }
    }
}

# Qualified associated calls (`tokens::Choice.pick(1)`) need the same alias-aware
# identity for public imported enums: a non-callable marker whose return carries
# the mangled enum C name shared with the imported typedef/metadata.
sub g9_import_enum_key($alias: Str, $name: Str): Str {
    $alias ~ "::" ~ $name ~ "#enum"
}

sub g9_import_enum_marker($alias: Str, $name: Str): CgSig {
    CgSig(name: g9_import_enum_key($alias, $name), cname: "", params: CgKindNil, ret: REnum(g9_import_type_name($alias, $name)), retregex: false, barefn: false, retbarefn: false)
}

sub g9_qualified_enum_name($alias: Str, $name: Str, $env: CgEnv): Option[Str] {
    match cg_env_lookup_sub($env, g9_import_enum_key($alias, $name)) {
        None { None }
        Some($sig) {
            match $sig.ret {
                REnum($n) { Some($n) }
                _ { None }
            }
        }
    }
}

# Collect every top-level sub's signature into a codegen environment of CgEnvSub
# entries. EVERY sub must have an in-subset signature (the whole program is
# emitted), so an unsupported parameter/return kind makes the program
# out-of-subset (invalid-corpus), not just the offending call.
sub g5_collect_sigs_on($decls: DeclList, $base: CgEnv): Result[CgEnv, Str] {
    match $decls {
        DeclNil { Ok($base) }
        DeclCons($head, $tail) {
            match $head {
                DSub($sub) {
                    # P5b-1: a generic TEMPLATE has no signature of its own; only
                    # its monomorphized specs (appended by g5g_expand_generics) do.
                    if g5g_is_generic($sub) {
                        g5_collect_sigs_on($tail, $base)
                    } else {
                        match g5_build_sig($sub, $base) {
                            Err($m) { Err($m) }
                            Ok($sig) {
                                match g5_collect_sigs_on($tail, $base) {
                                    Err($m) { Err($m) }
                                    Ok($rest) { Ok(CgEnvSub($sig, $rest)) }
                                }
                            }
                        }
                    }
                }
                DImport($i) { g5_collect_sigs_on($tail, $base) }
                DClass($c) {
                    # P5b-2d: a generic template class contributes no direct method
                    # sigs — only its monomorphized specs (appended concrete DClass
                    # decls with substituted subs) do. Mirrors the DEnum arm below.
                    if !strlist_empty($c.tparams) {
                        g5_collect_sigs_on($tail, $base)
                    } else {
                        match g5_collect_sigs_on($tail, $base) {
                            Err($m) { Err($m) }
                            Ok($rest) { g5_collect_class_sigs($c.name, $c.subs, $base, $rest) }
                        }
                    }
                }
                DEnum($e) {
                    if !strlist_empty($e.tparams) {
                        g5_collect_sigs_on($tail, $base)
                    } else {
                        match g5_collect_sigs_on($tail, $base) {
                            Err($m) { Err($m) }
                            Ok($rest) { g5_collect_enum_method_sigs($e.name, $e.subs, $base, $rest) }
                        }
                    }
                }
                DGrammar($g) { g5_collect_sigs_on($tail, $base) }
            }
        }
    }
}

sub g5_collect_sigs($decls: DeclList): Result[CgEnv, Str] {
    g5_collect_sigs_on($decls, CgEnvNil)
}

# P8d-2c-0: collect-then-index — the emission-facing entry points use this so
# every downstream lookup (emission, generic demand scans) dispatches through
# the CgEnvSubIdx head instead of scanning the flat sub chain.
sub g5_collect_sigs_indexed($decls: DeclList, $base: CgEnv): Result[CgEnv, Str] {
    match g5_collect_sigs_on($decls, $base) {
        Err($m) { Err($m) }
        Ok($env) { Ok(cg_env_index_subs($env)) }
    }
}

# ---- P5b-1: generic sub MONOMORPHIZATION (§3.3) ------------------------------
# The native generator compiles a generic sub template into one MONOMORPHIZED
# copy per concrete instantiation: an ordinary SubDecl named
# `name__<paramTag..>_<retTag>` (whose C name then falls out of the ordinary
# `gf_` ~ name rule as native's exact `gf_name__Tags` shape), with the
# template's type parameters substituted in the param/return annotations and
# the BODY SHARED with the template. A pre-pass (g5g_expand_generics) walks
# every non-generic sub body, infers each generic call's type-param bindings
# from its ARGUMENT KINDS (native infers from the checker's argument types),
# creates the spec decl + signature, and transitively scans the spec's own
# (substituted-param) body so generic bodies calling generic subs specialize
# too. Call sites then resolve through g5g_call_spec_sig: the spec is found by
# template-name prefix + exact parameter-kind match, which is unambiguous
# because for an argument-inferable template the bindings (hence the spec) are
# a function of the argument kinds alone. THIS SLICE covers top-level templates
# whose instantiations are fully SCALAR (Int/Bool/Float/Str; Unit allowed as
# return): a template whose type param appears only in the return or binds to a
# non-scalar stays out of subset (rc 4), matching SUBSET.md's honest-decline
# rule. P5b-2a extends the same scalar path to data-first method-style calls by
# prepending the receiver to the explicit argument list.

enum G5gBinds {
    G5gBindNil
    G5gBindCons($name: Str, $tag: Str, $tail: G5gBinds)
}

class G5gAcc {
    has $.all: DeclList
    has $.specs: DeclList
    has $.names: StrList
    has $.env: CgEnv
}

sub g5g_is_generic($s: SubDecl): Bool {
    match $s.tparams {
        StrNil { false }
        StrCons($h, $t) { true }
    }
}

sub g5g_has_templates($decls: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DSub($s) { if g5g_is_generic($s) { true } else { g5g_has_templates($t) } }
                DClass($c) { if g5g_subs_have_templates($c.subs) { true } else { g5g_has_templates($t) } }
                DEnum($e) { if g5g_subs_have_templates($e.subs) { true } else { g5g_has_templates($t) } }
                _ { g5g_has_templates($t) }
            }
        }
    }
}

sub g5g_subs_have_templates($subs: SubDeclList): Bool {
    match $subs {
        SubDeclNil { false }
        SubDeclCons($h, $t) { if g5g_is_generic($h) { true } else { g5g_subs_have_templates($t) } }
    }
}

sub g5g_find_template($decls: DeclList, $name: Str): Option[SubDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($h, $t) {
            match $h {
                DSub($s) {
                    if $s.name == $name && g5g_is_generic($s) { Some($s) } else { g5g_find_template($t, $name) }
                }
                _ { g5g_find_template($t, $name) }
            }
        }
    }
}

sub g5g_find_sub_template($subs: SubDeclList, $name: Str): Option[SubDecl] {
    match $subs {
        SubDeclNil { None }
        SubDeclCons($h, $t) {
            if $h.name == $name && g5g_is_generic($h) {
                Some($h)
            } else {
                g5g_find_sub_template($t, $name)
            }
        }
    }
}

sub g5g_find_class_method_template($decls: DeclList, $class_name: Str, $method: Str): Option[SubDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($h, $t) {
            match $h {
                DClass($c) {
                    if $c.name == $class_name && strlist_empty($c.tparams) {
                        g5g_find_sub_template($c.subs, $method)
                    } else {
                        g5g_find_class_method_template($t, $class_name, $method)
                    }
                }
                _ { g5g_find_class_method_template($t, $class_name, $method) }
            }
        }
    }
}

sub g5g_find_enum_method_template($decls: DeclList, $enum_name: Str, $method: Str): Option[SubDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($h, $t) {
            match $h {
                DEnum($e) {
                    if $e.name == $enum_name && strlist_empty($e.tparams) {
                        g5g_find_sub_template($e.subs, $method)
                    } else {
                        g5g_find_enum_method_template($t, $enum_name, $method)
                    }
                }
                _ { g5g_find_enum_method_template($t, $enum_name, $method) }
            }
        }
    }
}

sub g5g_kind_tag($k: CgKind): Option[Str] {
    match $k {
        CgInt { Some("Int") }
        CgBool { Some("Bool") }
        CgFloat { Some("Float") }
        CgStr { Some("Str") }
        # A concrete user class/enum argument binds a type parameter to its bare
        # tag (native BindTypeParams over class/enum type args; the spec name is
        # `gf_identity__Point_Point` / `gf_describe__Color_Str`, NO lowercasing).
        CgClass($n) { Some($n) }
        CgEnum($n) { Some($n) }
        _ { None }
    }
}

sub g5g_option_payload_tag($k: CgKind): Option[Str] {
    match $k {
        CgOptInt { Some("Int") }
        CgOptBool { Some("Bool") }
        CgOptFloat { Some("Float") }
        CgOptStr { Some("Str") }
        _ { None }
    }
}

sub g5g_option_kind_from_payload_tag($tag: Str): Option[CgKind] {
    if $tag == "Int" {
        Some(CgOptInt)
    } else if $tag == "Bool" {
        Some(CgOptBool)
    } else if $tag == "Float" {
        Some(CgOptFloat)
    } else if $tag == "Str" {
        Some(CgOptStr)
    } else {
        None
    }
}

sub g5_map_listlen($k: CgKind): Int {
    match $k {
        CgMap($v) { 0 - 1 }
        _ { 0 }
    }
}

# Parameter listlen must also carry the §13 Regex-as-Str sentinel: a
# `$p: Regex` param is CgStr in rep, but without listlen -3 the callee treats
# it as an ordinary Str — a `/<{ $p }>/` splice then ESCAPES the pattern
# (double-escape: `a\.b` -> literal `a\.b`, silently failing the match) and
# display drops the `/.../` wrap. Both were observed runtime BUGs vs interp
# AND native (2026-07-12).
sub g5_param_listlen($ty: Option[TypeRef], $k: CgKind): Int {
    if g6_ty_is_regex($ty) || g6_ty_is_option_regex($ty) { g6_regex_str_listlen() } else { g5_map_listlen($k) }
}

sub g5g_type_is_bare($tr: TypeRef): Bool {
    match $tr.args {
        TypeNil { true }
        TypeCons($h, $t) { false }
    }
}

sub g5g_binds_lookup($bs: G5gBinds, $n: Str): Option[Str] {
    match $bs {
        G5gBindNil { None }
        G5gBindCons($name, $tag, $t) { if $name == $n { Some($tag) } else { g5g_binds_lookup($t, $n) } }
    }
}

# The `List_int`-style monomorphized name part for one scalar tag: native
# lowercases the element name (`strings.ToLower`), so `List[Int]` -> `List_int`.
sub g5g_lower_scalar($n: Str): Str {
    if $n == "Int" { "int" } else if $n == "Bool" { "bool" } else if $n == "Float" { "float" } else if $n == "Str" { "str" } else { $n }
}

# The bare scalar element NAME of a `List[X]` annotation, when it has exactly one
# bare type argument (`List[T]` or `List[Int]`). A nested-collection element
# (`List[List[Int]]`) is not bare -> None (out of this slice's scope).
sub g5g_list_elem_name($tr: TypeRef): Option[Str] {
    match typelist_at($tr.args, 0) {
        None { None }
        Some($ea) {
            match typelist_at($tr.args, 1) {
                Some($extra) { None }
                None { if g5g_type_is_bare($ea) { Some($ea.name) } else { None } }
            }
        }
    }
}

sub g5g_typeref_from_kind($k: CgKind): Option[TypeRef] {
    match $k {
        CgInt { Some(TypeRef(name: "Int", args: TypeNil)) }
        CgBool { Some(TypeRef(name: "Bool", args: TypeNil)) }
        CgFloat { Some(TypeRef(name: "Float", args: TypeNil)) }
        CgStr { Some(TypeRef(name: "Str", args: TypeNil)) }
        CgClass($n) { Some(TypeRef(name: $n, args: TypeNil)) }
        CgEnum($n) { Some(TypeRef(name: $n, args: TypeNil)) }
        CgFn($params, $ret) { g5g_func_typeref($params, $ret) }
        _ { None }
    }
}

sub g5g_typeref_from_ret($r: CgRet): Option[TypeRef] {
    match $r {
        RInt { Some(TypeRef(name: "Int", args: TypeNil)) }
        RBool { Some(TypeRef(name: "Bool", args: TypeNil)) }
        RFloat { Some(TypeRef(name: "Float", args: TypeNil)) }
        RStr { Some(TypeRef(name: "Str", args: TypeNil)) }
        _ { None }
    }
}

sub g5g_func_type_args($params: CgKindList, $ret: CgRet): Option[TypeList] {
    match $params {
        CgKindNil {
            match g5g_typeref_from_ret($ret) {
                None { None }
                Some($rt) { Some(TypeCons($rt, TypeNil)) }
            }
        }
        CgKindCons($head, $tail) {
            match g5g_typeref_from_kind($head) {
                None { None }
                Some($ht) {
                    match g5g_func_type_args($tail, $ret) {
                        None { None }
                        Some($rest) { Some(TypeCons($ht, $rest)) }
                    }
                }
            }
        }
    }
}

sub g5g_func_typeref($params: CgKindList, $ret: CgRet): Option[TypeRef] {
    match g5g_func_type_args($params, $ret) {
        None { None }
        Some($args) { Some(TypeRef(name: "Func", args: $args)) }
    }
}

# Build a `List[<etag>]` type reference (a bare scalar element).
sub g5g_list_typeref($etag: Str): TypeRef {
    TypeRef(name: "List", args: TypeCons(TypeRef(name: $etag, args: TypeNil), TypeNil))
}

sub g5g_map_val_name($tr: TypeRef): Option[Str] {
    match typelist_at($tr.args, 0) {
        None { None }
        Some($ka) {
            match typelist_at($tr.args, 1) {
                None { None }
                Some($va) {
                    match typelist_at($tr.args, 2) {
                        Some($extra) { None }
                        None {
                            if g5g_type_is_bare($ka) && $ka.name == "Str" && g5g_type_is_bare($va) {
                                Some($va.name)
                            } else {
                                None
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5g_map_typeref($vtag: Str): TypeRef {
    TypeRef(name: "Map", args: TypeCons(TypeRef(name: "Str", args: TypeNil), TypeCons(TypeRef(name: $vtag, args: TypeNil), TypeNil)))
}

sub g5g_option_elem_name($tr: TypeRef): Option[Str] {
    match typelist_at($tr.args, 0) {
        None { None }
        Some($ea) {
            match typelist_at($tr.args, 1) {
                Some($extra) { None }
                None { if g5g_type_is_bare($ea) { Some($ea.name) } else { None } }
            }
        }
    }
}

sub g5g_option_typeref($etag: Str): TypeRef {
    TypeRef(name: "Option", args: TypeCons(TypeRef(name: $etag, args: TypeNil), TypeNil))
}

sub g5g_result_ok_name($tr: TypeRef): Option[Str] {
    match typelist_at($tr.args, 0) {
        None { None }
        Some($oa) {
            match typelist_at($tr.args, 1) {
                None { None }
                Some($ea) {
                    match typelist_at($tr.args, 2) {
                        Some($extra) { None }
                        None { if g5g_type_is_bare($oa) && g5g_type_is_bare($ea) { Some($oa.name) } else { None } }
                    }
                }
            }
        }
    }
}

sub g5g_result_err_name($tr: TypeRef): Option[Str] {
    match typelist_at($tr.args, 0) {
        None { None }
        Some($oa) {
            match typelist_at($tr.args, 1) {
                None { None }
                Some($ea) {
                    match typelist_at($tr.args, 2) {
                        Some($extra) { None }
                        None { if g5g_type_is_bare($oa) && g5g_type_is_bare($ea) { Some($ea.name) } else { None } }
                    }
                }
            }
        }
    }
}

sub g5g_result_typeref($oktag: Str, $errtag: Str): TypeRef {
    TypeRef(name: "Result", args: TypeCons(TypeRef(name: $oktag, args: TypeNil), TypeCons(TypeRef(name: $errtag, args: TypeNil), TypeNil)))
}

sub g5g_subst_type_args($args: TypeList, $tparams: StrList, $bs: G5gBinds): Option[TypeList] {
    match $args {
        TypeNil { Some(TypeNil) }
        TypeCons($head, $tail) {
            match g5g_subst_typeref($head, $tparams, $bs, false) {
                None { None }
                Some($sub_head) {
                    match g5g_subst_type_args($tail, $tparams, $bs) {
                        None { None }
                        Some($sub_tail) { Some(TypeCons($sub_head, $sub_tail)) }
                    }
                }
            }
        }
    }
}

# The `__`-suffix name part for one substituted (concrete) annotation: a scalar
# name stays as-is; `List[Int]` becomes `List_int`, and `Map[Str,Int]`
# becomes `Map_Str_int`; `Option[Int]` becomes `Option_int` (native
# monoSpecializeType tags lower-case parametric leaves). Slice invariant: the
# TypeRef is already fully substituted to a supported generic-sub shape.
sub g5g_type_tag($tr: TypeRef): Str {
    if $tr.name == "List" {
        match g5g_list_elem_name($tr) {
            Some($en) { "List_" ~ g5g_lower_scalar($en) }
            None { $tr.name }
        }
    } else if $tr.name == "Map" {
        match g5g_map_val_name($tr) {
            Some($vn) { "Map_Str_" ~ g5g_lower_scalar($vn) }
            None { $tr.name }
        }
    } else if $tr.name == "Option" {
        match g5g_option_elem_name($tr) {
            Some($en) { "Option_" ~ g5g_lower_scalar($en) }
            None { $tr.name }
        }
    } else if $tr.name == "Result" {
        match g5g_result_ok_name($tr) {
            None { $tr.name }
            Some($on) {
                match g5g_result_err_name($tr) {
                    None { $tr.name }
                    Some($en) { "Result_" ~ g5g_lower_scalar($on) ~ "_" ~ g5g_lower_scalar($en) }
                }
            }
        }
    } else if $tr.name == "Func" {
        "Func_" ~ g5g_type_tags($tr.args)
    } else {
        match $tr.args {
            TypeNil { $tr.name }
            TypeCons($h, $t) { $tr.name ~ "__" ~ g5g_type_tags($tr.args) }
        }
    }
}

sub g5g_strip_prefix($s: Str, $prefix: Str): Option[Str] {
    if starts_with($s, $prefix) {
        Some(drop(split($s, ""), split($prefix, "").count()).join(""))
    } else {
        None
    }
}

sub g5g_bind_user_generic_arg($arg: TypeRef, $tag: Str, $tparams: StrList, $acc: G5gBinds): Option[G5gBinds] {
    if g5g_type_is_bare($arg) {
        g5g_bind_or_match($arg.name, $tag, $tparams, $acc)
    } else {
        None
    }
}

sub g5g_bind_user_generic_args($args: TypeList, @tags: List[Str], $idx: Int, $tparams: StrList, $acc: G5gBinds): Option[G5gBinds] {
    match $args {
        TypeNil {
            if $idx == @tags.count() {
                Some($acc)
            } else {
                None
            }
        }
        TypeCons($head, $tail) {
            match get(@tags, $idx) {
                None { None }
                Some($tag) {
                    match g5g_bind_user_generic_arg($head, $tag, $tparams, $acc) {
                        None { None }
                        Some($acc2) { g5g_bind_user_generic_args($tail, @tags, $idx + 1, $tparams, $acc2) }
                    }
                }
            }
        }
    }
}

sub g5g_infer_user_generic_binds($tr: TypeRef, $k: CgKind, $tparams: StrList, $acc: G5gBinds): Option[G5gBinds] {
    match $tr.args {
        TypeNil { None }
        TypeCons($arg0, $argtail) {
            $prefix = $tr.name ~ "__"
            $name = match $k {
                CgClass($cn) { $cn }
                CgEnum($en) { $en }
                _ { "" }
            }
            match g5g_strip_prefix($name, $prefix) {
                None { None }
                Some($suffix) {
                    @tags = split($suffix, "_")
                    g5g_bind_user_generic_args($tr.args, @tags, 0, $tparams, $acc)
                }
            }
        }
    }
}

sub g5g_param_can_defer_user_generic($p: Param): Bool {
    match $p.ty {
        None { false }
        Some($tr) {
            match $tr.args {
                TypeNil { false }
                TypeCons($arg0, $argtail) {
                    !($tr.name == "List" || $tr.name == "Map" || $tr.name == "Option" || $tr.name == "Result" || $tr.name == "Func")
                }
            }
        }
    }
}

sub g5g_type_tags($args: TypeList): Str {
    match $args {
        TypeNil { "" }
        TypeCons($head, $tail) {
            $tag = g5g_type_tag($head)
            match $tail {
                TypeNil { $tag }
                TypeCons($h2, $t2) { $tag ~ "_" ~ g5g_type_tags($tail) }
            }
        }
    }
}

# Bind one type parameter (or verify one concrete scalar) at a bare annotation
# position against the concrete scalar tag its argument supplies: a type param
# binds consistently (a repeat must agree), a concrete scalar name must equal the
# tag. Returns the updated accumulator, or None on conflict/mismatch.
sub g5g_bind_or_match($name: Str, $tag: Str, $tparams: StrList, $acc: G5gBinds): Option[G5gBinds] {
    if strlist_contains($tparams, $name) {
        match g5g_binds_lookup($acc, $name) {
            Some($prev) { if $prev == $tag { Some($acc) } else { None } }
            None { Some(G5gBindCons($name, $tag, $acc)) }
        }
    } else if $name == $tag {
        Some($acc)
    } else {
        None
    }
}

# Infer type-parameter bindings from the template's param annotations matched
# against the call's argument kinds in lockstep. A bare type-param annotation
# binds its argument's scalar tag (consistently across repeats, mirroring
# native BindTypeParams); a bare concrete scalar annotation must equal the
# argument kind exactly; a `List[T]`/`List[Int]` annotation binds/verifies its
# element against a `CgList(scalar)` argument; a `Map[Str,T]`/`Map[Str,Int]`
# annotation binds/verifies its value kind against a `CgMap(scalar)` argument;
# an `Option[T]`/`Option[Int]` annotation binds/verifies the active carrier
# payload against a `CgOpt*` argument. Anything else (unannotated, deeper
# parametric, non-scalar) fails the inference and the call later declines.
sub g5g_infer_binds($params: ParamList, $ks: CgKindList, $tparams: StrList, $acc: G5gBinds): Option[G5gBinds] {
    match $params {
        ParamNil {
            match $ks {
                CgKindNil { Some($acc) }
                CgKindCons($k, $kt) { None }
            }
        }
        ParamCons($p, $pt) {
            match $ks {
                CgKindNil { None }
                CgKindCons($k, $kt) {
                    match $p.ty {
                        None { g5g_infer_binds($pt, $kt, $tparams, $acc) }
                        Some($tr) {
                            if g5g_type_is_bare($tr) {
                                match g5g_kind_tag($k) {
                                    None { None }
                                    Some($tag) {
                                        match g5g_bind_or_match($tr.name, $tag, $tparams, $acc) {
                                            None { None }
                                            Some($acc2) { g5g_infer_binds($pt, $kt, $tparams, $acc2) }
                                        }
                                    }
                                }
                            } else if $tr.name == "List" {
                                match $k {
                                    CgList($ek) {
                                        match g5g_kind_tag($ek) {
                                            None { None }
                                            Some($etag) {
                                                match g5g_list_elem_name($tr) {
                                                    None { None }
                                                    Some($en) {
                                                        match g5g_bind_or_match($en, $etag, $tparams, $acc) {
                                                            None { None }
                                                            Some($acc2) { g5g_infer_binds($pt, $kt, $tparams, $acc2) }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    _ { None }
                                }
                            } else if $tr.name == "Map" {
                                match $k {
                                    CgMap($vk) {
                                        match g5g_kind_tag($vk) {
                                            None { None }
                                            Some($vtag) {
                                                match g5g_map_val_name($tr) {
                                                    None { None }
                                                    Some($vn) {
                                                        match g5g_bind_or_match($vn, $vtag, $tparams, $acc) {
                                                            None { None }
                                                            Some($acc2) { g5g_infer_binds($pt, $kt, $tparams, $acc2) }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    _ { None }
                                }
                            } else if $tr.name == "Option" {
                                match g5g_option_payload_tag($k) {
                                    None { None }
                                    Some($otag) {
                                        match g5g_option_elem_name($tr) {
                                            None { None }
                                            Some($on) {
                                                match g5g_bind_or_match($on, $otag, $tparams, $acc) {
                                                    None { None }
                                                    Some($acc2) { g5g_infer_binds($pt, $kt, $tparams, $acc2) }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else if $tr.name == "Result" {
                                match $k {
                                    CgRes($ok, $err) {
                                        match g5g_kind_tag($ok) {
                                            None { None }
                                            Some($oktag) {
                                                match g5g_kind_tag($err) {
                                                    None { None }
                                                    Some($errtag) {
                                                        match g5g_result_ok_name($tr) {
                                                            None { None }
                                                            Some($on) {
                                                                match g5g_bind_or_match($on, $oktag, $tparams, $acc) {
                                                                    None { None }
                                                                    Some($acc2) {
                                                                        match g5g_result_err_name($tr) {
                                                                            None { None }
                                                                            Some($en) {
                                                                                match g5g_bind_or_match($en, $errtag, $tparams, $acc2) {
                                                                                    None { None }
                                                                                    Some($acc3) { g5g_infer_binds($pt, $kt, $tparams, $acc3) }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    _ { None }
                                }
                            } else {
                                match g5g_infer_user_generic_binds($tr, $k, $tparams, $acc) {
                                    None { None }
                                    Some($acc2) { g5g_infer_binds($pt, $kt, $tparams, $acc2) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5g_all_bound($tparams: StrList, $bs: G5gBinds): Bool {
    match $tparams {
        StrNil { true }
        StrCons($h, $t) {
            match g5g_binds_lookup($bs, $h) {
                Some($tag) { g5g_all_bound($t, $bs) }
                None { false }
            }
        }
    }
}

# Substitute bound type params recursively through one annotation. Bare concrete
# types are preserved; Unit is admitted only in the return position. Compound
# types rebuild all their arguments, so the same operation handles List[List[T]],
# Map[Str,List[T]], Option[T], Result[T,E], and user-generic shapes.
sub g5g_subst_typeref($tr: TypeRef, $tparams: StrList, $bs: G5gBinds, $allow_unit: Bool): Option[TypeRef] {
    if g5g_type_is_bare($tr) && strlist_contains($tparams, $tr.name) {
        match g5g_binds_lookup($bs, $tr.name) {
            None { None }
            Some($tag) { g8_type_from_binding_tag($tag) }
        }
    } else if g5g_type_is_bare($tr) {
        if $tr.name == "Unit" && !$allow_unit { None } else { Some($tr) }
    } else {
        match g5g_subst_type_args($tr.args, $tparams, $bs) {
            None { None }
            Some($sub_args) { Some(TypeRef(name: $tr.name, args: $sub_args)) }
        }
    }
}

# Substitute bound type params into the template's param annotations. Unannotated
# callback params are filled from their concrete CgFn argument kind and represented
# with an internal `Func[..., Ret]` TypeRef so ordinary signature collection emits
# the native `guji_fn_t` ABI and the native-style `Func_Int_Int` spec-name tag.
sub g5g_subst_params_with_kinds($params: ParamList, $ks: CgKindList, $tparams: StrList, $bs: G5gBinds): Option[ParamList] {
    match $params {
        ParamNil {
            match $ks {
                CgKindNil { Some(ParamNil) }
                CgKindCons($k, $kt) { None }
            }
        }
        ParamCons($p, $pt) {
            match $ks {
                CgKindNil { None }
                CgKindCons($k, $kt) {
                    match g5g_subst_params_with_kinds($pt, $kt, $tparams, $bs) {
                        None { None }
                        Some($rest) {
                            match $p.ty {
                                None {
                                    match g5g_typeref_from_kind($k) {
                                        None { None }
                                        Some($fntr) { Some(ParamCons(Param(name: $p.name, ty: Some($fntr)), $rest)) }
                                    }
                                }
                                Some($tr) {
                                    match g5g_subst_typeref($tr, $tparams, $bs, false) {
                                        None { None }
                                        Some($sub_tr) { Some(ParamCons(Param(name: $p.name, ty: Some($sub_tr)), $rest)) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5g_subst_params_from_args($params: ParamList, $args: ExprList, $tparams: StrList, $bs: G5gBinds, $env: CgEnv): Option[ParamList] {
    match g5g_arg_kinds_from_exprs($args, $env) {
        None { None }
        Some($ks) { g5g_subst_params_with_kinds($params, $ks, $tparams, $bs) }
    }
}

sub g5g_subst_params($params: ParamList, $tparams: StrList, $bs: G5gBinds): Option[ParamList] {
    match $params {
        ParamNil { Some(ParamNil) }
        ParamCons($p, $pt) {
            match g5g_subst_params($pt, $tparams, $bs) {
                None { None }
                Some($rest) {
                    match $p.ty {
                        None { None }
                        Some($tr) {
                            match g5g_subst_typeref($tr, $tparams, $bs, false) {
                                None { None }
                                Some($sub_tr) { Some(ParamCons(Param(name: $p.name, ty: Some($sub_tr)), $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Substitute the return annotation. Unit is allowed here (native's
# monoSpecializeType(retType, true)); a missing or non-scalar/non-List return fails.
sub g5g_subst_ret($ret: Option[TypeRef], $tparams: StrList, $bs: G5gBinds): Option[TypeRef] {
    match $ret {
        None { None }
        Some($tr) { g5g_subst_typeref($tr, $tparams, $bs, true) }
    }
}

# The `__`-suffix parts: substituted param annotation tags then the return tag,
# joined by "_" (native: parts = param tags + ret tag). A `List[Int]` annotation
# contributes `List_int`, `Map[Str,Int]` contributes `Map_Str_int`, and a scalar
# contributes its name.
sub g5g_parts($params: ParamList, $retname: Str): Str {
    match $params {
        ParamNil { $retname }
        ParamCons($p, $t) {
            match $p.ty {
                Some($tr) { g5g_type_tag($tr) ~ "_" ~ g5g_parts($t, $retname) }
                None { $retname }
            }
        }
    }
}

sub g5g_make_spec($tpl: SubDecl, $ks: CgKindList): Option[SubDecl] {
    match g5g_infer_binds($tpl.params, $ks, $tpl.tparams, G5gBindNil) {
        None { None }
        Some($bs) {
            if g5g_all_bound($tpl.tparams, $bs) {
                match g5g_subst_params_with_kinds($tpl.params, $ks, $tpl.tparams, $bs) {
                    None { None }
                    Some($sps) {
                        match g5g_subst_ret($tpl.ret, $tpl.tparams, $bs) {
                            None { None }
                            Some($rt) {
                                Some(SubDecl(
                                    public: false,
                                    name: $tpl.name ~ "__" ~ g5g_parts($sps, g5g_type_tag($rt)),
                                    line: $tpl.line,
                                    col: $tpl.col,
                                    body_line: $tpl.body_line,
                                    body_col: $tpl.body_col,
                                    tparams: StrNil,
                                    params: $sps,
                                    ret: Some($rt),
                                    body: $tpl.body
                                ))
                            }
                        }
                    }
                }
            } else {
                None
            }
        }
    }
}

sub g5g_prefix_spec_name($owner: Str, $spec: SubDecl): SubDecl {
    SubDecl(public: false, name: $owner ~ "_" ~ $spec.name, line: $spec.line, col: $spec.col, body_line: $spec.body_line, body_col: $spec.body_col, tparams: StrNil, params: $spec.params, ret: $spec.ret, body: $spec.body)
}

sub g5g_make_method_spec($owner: Str, $tpl: SubDecl, $ks: CgKindList): Option[SubDecl] {
    match g5g_make_spec($tpl, $ks) {
        None { None }
        Some($spec) { Some(g5g_prefix_spec_name($owner, $spec)) }
    }
}

sub g5g_none_for_option_param($p: Param, $arg: Expr): Bool {
    match $arg {
        ETypeName($n) {
            if $n == "None" {
                match $p.ty {
                    Some($tr) { $tr.name == "Option" }
                    None { false }
                }
            } else {
                false
            }
        }
        _ { false }
    }
}

sub g5g_infer_binds_from_args($params: ParamList, $args: ExprList, $tparams: StrList, $env: CgEnv, $acc: G5gBinds): Option[G5gBinds] {
    match $params {
        ParamNil {
            match $args {
                ExprNil { Some($acc) }
                ExprCons($a, $at) { None }
            }
        }
        ParamCons($p, $pt) {
            match $args {
                ExprNil { None }
                ExprCons($arg, $at) {
                    if g5g_none_for_option_param($p, $arg) {
                        g5g_infer_binds_from_args($pt, $at, $tparams, $env, $acc)
                    } else {
                        match g5g_arg_kind_from_expr($arg, $env) {
                            None {
                                if g5g_param_can_defer_user_generic($p) {
                                    g5g_infer_binds_from_args($pt, $at, $tparams, $env, $acc)
                                } else {
                                    None
                                }
                            }
                            Some($k) {
                                match g5g_infer_binds(ParamCons($p, ParamNil), CgKindCons($k, CgKindNil), $tparams, $acc) {
                                    None { None }
                                    Some($acc2) { g5g_infer_binds_from_args($pt, $at, $tparams, $env, $acc2) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5g_make_spec_for_args($tpl: SubDecl, $args: ExprList, $env: CgEnv): Option[SubDecl] {
    match g5g_infer_binds_from_args($tpl.params, $args, $tpl.tparams, $env, G5gBindNil) {
        None { None }
        Some($bs) {
            if g5g_all_bound($tpl.tparams, $bs) {
                $param_subs = match g5g_subst_params_from_args($tpl.params, $args, $tpl.tparams, $bs, $env) {
                    Some($sps0) { Some($sps0) }
                    None { g5g_subst_params($tpl.params, $tpl.tparams, $bs) }
                }
                match $param_subs {
                    None { None }
                    Some($sps) {
                        match g5g_subst_ret($tpl.ret, $tpl.tparams, $bs) {
                            None { None }
                            Some($rt) {
                                Some(SubDecl(
                                    public: false,
                                    name: $tpl.name ~ "__" ~ g5g_parts($sps, g5g_type_tag($rt)),
                                    line: $tpl.line,
                                    col: $tpl.col,
                                    body_line: $tpl.body_line,
                                    body_col: $tpl.body_col,
                                    tparams: StrNil,
                                    params: $sps,
                                    ret: Some($rt),
                                    body: $tpl.body
                                ))
                            }
                        }
                    }
                }
            } else {
                None
            }
        }
    }
}

# Find the already-created monomorphized spec of template $prefix (the template
# name plus "__") whose parameter kinds equal $ks. Uses structural cgkind
# equality so scalar-element List[T] specs match on their element kind too.
sub g5g_env_spec_sig($env: CgEnv, $prefix: Str, $ks: CgKindList): Option[CgSig] {
    match $env {
        CgEnvNil { None }
        CgEnvCons($h, $t) { g5g_env_spec_sig($t, $prefix, $ks) }
        CgEnvSub($s, $t) {
            if starts_with($s.name, $prefix) && cgkind_list_eq($s.params, $ks) {
                Some($s)
            } else {
                g5g_env_spec_sig($t, $prefix, $ks)
            }
        }
        CgEnvEnum($e, $t) { g5g_env_spec_sig($t, $prefix, $ks) }
        CgEnvClass($c, $t) { g5g_env_spec_sig($t, $prefix, $ks) }
        CgEnvSubIdx($i, $t) {
            match g5g_env_spec_sig($i.flat, $prefix, $ks) {
                Some($s) { Some($s) }
                None { g5g_env_spec_sig($t, $prefix, $ks) }
            }
        }
    }
}

sub g5g_kind_is_option($k: CgKind): Bool {
    match $k {
        CgOptInt { true }
        CgOptBool { true }
        CgOptFloat { true }
        CgOptStr { true }
        _ { false }
    }
}

sub g5g_arg_matches_kind($arg: Expr, $k: CgKind, $env: CgEnv): Bool {
    match $arg {
        ETypeName($n) {
            if $n == "None" {
                g5g_kind_is_option($k)
            } else {
                match g5g_arg_kind_from_expr($arg, $env) {
                    Some($ak) { cgkind_eq($ak, $k) }
                    None { false }
                }
            }
        }
        _ {
            match g5g_arg_kind_from_expr($arg, $env) {
                Some($ak) { cgkind_eq($ak, $k) }
                None { false }
            }
        }
    }
}

sub g5g_args_match_kinds($args: ExprList, $ks: CgKindList, $env: CgEnv): Bool {
    match $args {
        ExprNil {
            match $ks {
                CgKindNil { true }
                CgKindCons($k, $kt) { false }
            }
        }
        ExprCons($arg, $at) {
            match $ks {
                CgKindNil { false }
                CgKindCons($k, $kt) {
                    if g5g_arg_matches_kind($arg, $k, $env) {
                        g5g_args_match_kinds($at, $kt, $env)
                    } else {
                        false
                    }
                }
            }
        }
    }
}

sub g5g_env_spec_sig_for_args($env: CgEnv, $prefix: Str, $args: ExprList, $lookup: CgEnv): Option[CgSig] {
    match $env {
        CgEnvNil { None }
        CgEnvCons($h, $t) { g5g_env_spec_sig_for_args($t, $prefix, $args, $lookup) }
        CgEnvSub($s, $t) {
            if starts_with($s.name, $prefix) && g5g_args_match_kinds($args, $s.params, $lookup) {
                Some($s)
            } else {
                g5g_env_spec_sig_for_args($t, $prefix, $args, $lookup)
            }
        }
        CgEnvEnum($e, $t) { g5g_env_spec_sig_for_args($t, $prefix, $args, $lookup) }
        CgEnvClass($c, $t) { g5g_env_spec_sig_for_args($t, $prefix, $args, $lookup) }
        CgEnvSubIdx($i, $t) {
            match g5g_env_spec_sig_for_args($i.flat, $prefix, $args, $lookup) {
                Some($s) { Some($s) }
                None { g5g_env_spec_sig_for_args($t, $prefix, $args, $lookup) }
            }
        }
    }
}

# The scalar CgKind an arithmetic/comparison/logical BINOP produces from its
# operand kinds — a generics-local mirror of synth_binop (§5.1-5.2). Needed so a
# generic call whose argument is an arithmetic expression (`f($x, $n - 1)`, the
# canonical recursion step) resolves its monomorphized spec: without it
# g5_kind_from_expr returns None for EBinary/EUnary and the call declines rc 4
# even though native accepts. Comparison / equality / logical ops yield CgBool;
# `~` yields CgStr; arithmetic yields the (matching) operand kind — Int or Float,
# taken from whichever operand infers first; range/regex/`~~` decline (None).
sub g5g_binop_kind($op: Str, $l: Expr, $r: Expr, $env: CgEnv): Option[CgKind] {
    if $op == "==" || $op == "!=" || $op == "<" || $op == "<=" || $op == ">" || $op == ">=" || $op == "&&" || $op == "||" {
        Some(CgBool)
    } else if $op == "~" {
        Some(CgStr)
    } else if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" {
        match g5g_num_kind($l, $env) {
            Some($lk) { Some($lk) }
            None { g5g_num_kind($r, $env) }
        }
    } else {
        None
    }
}

# The numeric CgKind (CgInt/CgFloat) of an expression, or None if it is neither —
# the arithmetic-result and unary-minus helper for g5g_binop_kind/g5g_unary_kind.
sub g5g_num_kind($e: Expr, $env: CgEnv): Option[CgKind] {
    match g5g_arg_kind_from_expr($e, $env) {
        None { None }
        Some($k) {
            match $k {
                CgInt { Some(CgInt) }
                CgFloat { Some(CgFloat) }
                _ { None }
            }
        }
    }
}

# The CgKind a unary operation produces: `!` is CgBool, unary `-`/`+` is the
# operand's numeric kind. Mirrors eval_unary; other operators decline.
sub g5g_unary_kind($op: Str, $x: Expr, $env: CgEnv): Option[CgKind] {
    if $op == "!" {
        Some(CgBool)
    } else if $op == "-" || $op == "+" {
        g5g_num_kind($x, $env)
    } else {
        None
    }
}

# Infer ONE generic-call argument's kind for monomorphization. Arithmetic /
# comparison / logical EBinary and EUnary operands infer via g5g_binop_kind /
# g5g_unary_kind (so `f($x, $n - 1)` resolves). Otherwise: a scalar / bound name /
# resolved-call kind comes from g5_kind_from_expr; when that yields nothing, a
# class constructor or class-valued expression falls back to
# g8_class_kind_from_value and an enum variant / enum-valued expression to
# g6e_enum_kind_from_value. This is what lets a generic sub bind `T` from a
# CONCRETE user class or enum argument (native BindTypeParams over class/enum
# type args). Kept generics-local: g5_kind_from_expr / g5_arg_kinds_from_exprs
# stay scalar/call-only for the main codegen paths.
sub g5g_arg_kind_from_expr($e: Expr, $env: CgEnv): Option[CgKind] {
    match $e {
        EBinary($op, $l, $r) { g5g_binop_kind($op, $l, $r, $env) }
        EUnary($op, $x) { g5g_unary_kind($op, $x, $env) }
        _ {
            match g5_kind_from_expr($e, $env) {
                Some($k) { Some($k) }
                None {
                    match g5g_option_kind_from_expr($e, $env) {
                        Some($ok) { Some($ok) }
                        None {
                            match g8_class_kind_from_value($e, $env) {
                                Ok($ck) { Some($ck) }
                                Err($cm) {
                                    match g6e_enum_kind_from_value($e, $env) {
                                        Ok($ek) { Some($ek) }
                                        Err($em) { None }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5g_option_kind_from_expr($e: Expr, $env: CgEnv): Option[CgKind] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                ETypeName($n) {
                    if $n == "Some" {
                        match g6_option_one_arg($args) {
                            Err($m) { None }
                            Ok($arg) {
                                match g5g_arg_kind_from_expr($arg, $env) {
                                    None { None }
                                    Some($pk) {
                                        match g5g_kind_tag($pk) {
                                            None { None }
                                            Some($tag) { g5g_option_kind_from_payload_tag($tag) }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        None
                    }
                }
                _ { None }
            }
        }
        _ { None }
    }
}

# The generic-call argument kinds in declaration order, with class/enum
# inference. Any single argument whose kind can't be inferred fails the whole
# list (the call then declines / finds no spec), mirroring g5_arg_kinds_from_exprs.
sub g5g_arg_kinds_from_exprs($args: ExprList, $env: CgEnv): Option[CgKindList] {
    match $args {
        ExprNil { Some(CgKindNil) }
        ExprCons($head, $tail) {
            match g5g_arg_kind_from_expr($head, $env) {
                None { None }
                Some($k) {
                    match g5g_arg_kinds_from_exprs($tail, $env) {
                        None { None }
                        Some($rest) { Some(CgKindCons($k, $rest)) }
                    }
                }
            }
        }
    }
}

# Resolve a direct call to a generic template against its monomorphized specs
# by argument kinds. Used by g5_resolve_call_target as the fallback when the
# bare name has no concrete signature, so both the pre-pass's kind inference
# and body lowering route generic calls to the same spec.
sub g5g_call_spec_sig($f: Str, $args: ExprList, $env: CgEnv): Option[CgSig] {
    match g5g_arg_kinds_from_exprs($args, $env) {
        None { g5g_env_spec_sig_for_args($env, $f ~ "__", $args, $env) }
        Some($ks) { g5g_env_spec_sig($env, $f ~ "__", $ks) }
    }
}

sub g5g_method_call_spec_sig($owner: Str, $method: Str, $args: ExprList, $env: CgEnv): Option[CgSig] {
    g5g_call_spec_sig($owner ~ "_" ~ $method, $args, $env)
}

# ---- P5b-1 pre-pass: walk bodies, create specs ------------------------------
# The walker mirrors fv_* over the full Stmt/Expr tree. $locals is a CgEnv
# fragment of the enclosing sub's annotated params + sequentially inferred
# scalar bindings (cnames unused — only kinds matter here); the full lookup
# env at any inference point is cg_env_append($locals, $a.env), so specs
# created earlier in the walk are visible to later argument-kind queries
# (chained `id(id(4))` resolves inner-first via post-order).

sub g5g_param_locals($params: ParamList, $idx: Int, $lookup: CgEnv): CgEnv {
    match $params {
        ParamNil { CgEnvNil }
        ParamCons($h, $t) {
            $rest = g5g_param_locals($t, $idx + 1, $lookup)
            match g5_param_kind($h.ty, $lookup) {
                Err($m) { $rest }
                Ok($k) { CgEnvCons(CgVar(name: $h.name, cname: "gp" ~ c_int($idx), kind: $k, mutable: false, borrowed: true, listlen: g5_param_listlen($h.ty, $k)), $rest) }
            }
        }
    }
}

sub g5g_scan_exprs($xs: ExprList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $xs {
        ExprNil { $a }
        ExprCons($h, $t) { g5g_scan_exprs($t, $locals, g5g_scan_expr($h, $locals, $a)) }
    }
}

sub g5g_scan_opt_expr($x: Option[Expr], $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $x {
        None { $a }
        Some($e) { g5g_scan_expr($e, $locals, $a) }
    }
}

sub g5g_scan_map_entries($xs: MapEntryList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $xs {
        MapEntryNil { $a }
        MapEntryCons($h, $t) { g5g_scan_map_entries($t, $locals, g5g_scan_expr($h.value, $locals, g5g_scan_expr($h.key, $locals, $a))) }
    }
}

sub g5g_scan_opt_stmts($xs: Option[StmtList], $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $xs {
        None { $a }
        Some($ss) { g5g_scan_stmts($ss, $locals, $a) }
    }
}

sub g5g_scan_elifs($xs: ElifList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $xs {
        ElifNil { $a }
        ElifCons($h, $t) { g5g_scan_elifs($t, $locals, g5g_scan_stmts($h.body, $locals, g5g_scan_expr($h.cond, $locals, $a))) }
    }
}

sub g5g_scan_arms($xs: ArmList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $xs {
        ArmNil { $a }
        ArmCons($h, $t) { g5g_scan_arms($t, $locals, g5g_scan_stmts($h.body, $locals, g5g_scan_opt_expr($h.guard, $locals, $a))) }
    }
}

sub g5g_scan_expr($e: Expr, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $e {
        EStr($text) { g5g_scan_interp($text, $locals, $a) }
        EList($items) { g5g_scan_exprs($items, $locals, $a) }
        EMap($items) { g5g_scan_map_entries($items, $locals, $a) }
        EUnary($op, $x) { g5g_scan_expr($x, $locals, $a) }
        EBinary($op, $l, $r) { g5g_scan_expr($r, $locals, g5g_scan_expr($l, $locals, $a)) }
        ENamedArg($n, $v) { g5g_scan_expr($v, $locals, $a) }
        ECall($callee, $args) {
            $a2 = g5g_scan_exprs($args, $locals, g5g_scan_expr($callee, $locals, $a))
            g5g_scan_call($callee, $args, $locals, $a2)
        }
        EField($o, $n) { g5g_scan_expr($o, $locals, $a) }
        EIndex($o, $i) { g5g_scan_expr($i, $locals, g5g_scan_expr($o, $locals, $a)) }
        EIf($c, $then, $elifs, $els) {
            g5g_scan_opt_stmts($els, $locals, g5g_scan_elifs($elifs, $locals, g5g_scan_stmts($then, $locals, g5g_scan_expr($c, $locals, $a))))
        }
        EMatch($subj, $arms) { g5g_scan_arms($arms, $locals, g5g_scan_expr($subj, $locals, $a)) }
        ELambda($ps, $rt, $bd, $tp) { g5g_scan_stmts($bd, $locals, $a) }
        EQuestion($x) { g5g_scan_expr($x, $locals, $a) }
        _ { $a }
    }
}

# Interpolated string segments re-parse at LOWERING time (g3_interp_parts), so
# the pre-pass must scan them too or a generic call that appears ONLY inside a
# `"{ ... }"` segment would never specialize (native: scanGenericInterpolationSpecs).
# Mirrors g3_interp_parts' segmentation exactly: `\{`/`\}` skip two chars, an
# unescaped `{` scans to its close and parses the inner text as an expression.
sub g5g_scan_interp($text: Str, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    if has_char($text, '{') {
        @chars = split($text, "")
        g5g_scan_interp_parts(@chars, 0, @chars.count(), $locals, $a)
    } else {
        $a
    }
}

sub g5g_scan_interp_parts(@chars: List[Str], $i: Int, $n: Int, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    if $i >= $n {
        $a
    } else {
        match get(@chars, $i) {
            None { $a }
            Some($c) {
                if $c == "\\" && (at(@chars, $i + 1) == '{' || at(@chars, $i + 1) == '}') {
                    g5g_scan_interp_parts(@chars, $i + 2, $n, $locals, $a)
                } else if $c == '{' {
                    match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                        None { g5g_scan_interp_parts(@chars, $i + 1, $n, $locals, $a) }
                        Some($scan) {
                            $a1 = match g3_parse_interpolation_expr($scan.text) {
                                None { $a }
                                Some($expr) { g5g_scan_expr($expr, $locals, $a) }
                            }
                            g5g_scan_interp_parts(@chars, $scan.next, $n, $locals, $a1)
                        }
                    }
                } else {
                    g5g_scan_interp_parts(@chars, $i + 1, $n, $locals, $a)
                }
            }
        }
    }
}

sub g5g_scan_call($callee: Expr, $args: ExprList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $callee {
        EName($f) { g5g_scan_template_call($f, $args, $locals, $a) }
        EField($recv, $method) {
            $a1 = g5g_scan_method_template_call($recv, $method, $args, $locals, $a)
            g5g_scan_template_call($method, ExprCons($recv, $args), $locals, $a1)
        }
        _ { $a }
    }
}

sub g5g_scan_template_call($f: Str, $args: ExprList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    $full = cg_env_append($locals, $a.env)
    match cg_env_lookup_sub($full, $f) {
        Some($s) { $a }
        None {
            match g5g_find_template($a.all, $f) {
                None { $a }
                Some($tpl) {
                    match g5g_arg_kinds_from_exprs($args, $full) {
                        None { g5g_add_spec_for_args($tpl, $args, $full, $a) }
                        Some($ks) { g5g_add_spec($tpl, $ks, $a) }
                    }
                }
            }
        }
    }
}

sub g5g_scan_method_template_call($recv: Expr, $method: Str, $args: ExprList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    $full = cg_env_append($locals, $a.env)
    $all_args = ExprCons($recv, $args)
    match g5_bound_class_receiver($recv, $full) {
        Some($class_name) {
            match cg_env_lookup_sub($full, $class_name ~ "." ~ $method) {
                Some($sig) { $a }
                None {
                    match g5g_find_class_method_template($a.all, $class_name, $method) {
                        None { $a }
                        Some($tpl) {
                            match g5g_arg_kinds_from_exprs($all_args, $full) {
                                None { $a }
                                Some($ks) { g5g_add_method_spec($class_name, $tpl, $ks, $a) }
                            }
                        }
                    }
                }
            }
        }
        None {
            match g5_bound_enum_receiver($recv, $full) {
                Some($enum_name) {
                    match cg_env_lookup_sub($full, $enum_name ~ "." ~ $method) {
                        Some($sig) { $a }
                        None {
                            match g5g_find_enum_method_template($a.all, $enum_name, $method) {
                                None { $a }
                                Some($tpl) {
                                    match g5g_arg_kinds_from_exprs($all_args, $full) {
                                        None { $a }
                                        Some($ks) { g5g_add_method_spec($enum_name, $tpl, $ks, $a) }
                                    }
                                }
                            }
                        }
                    }
                }
                None { $a }
            }
        }
    }
}

# Create (or reuse) the spec for one template instantiation, then transitively
# scan its body with the substituted param kinds so generic bodies calling
# generic subs specialize too. Termination: a self-call at the same
# instantiation hits the names list and stops.
sub g5g_add_spec($tpl: SubDecl, $ks: CgKindList, $a: G5gAcc): G5gAcc {
    match g5g_make_spec($tpl, $ks) {
        None { $a }
        Some($spec) { g5g_add_spec_decl($spec, $a) }
    }
}

sub g5g_add_method_spec($owner: Str, $tpl: SubDecl, $ks: CgKindList, $a: G5gAcc): G5gAcc {
    match g5g_make_method_spec($owner, $tpl, $ks) {
        None { $a }
        Some($spec) { g5g_add_spec_decl($spec, $a) }
    }
}

sub g5g_add_spec_for_args($tpl: SubDecl, $args: ExprList, $env: CgEnv, $a: G5gAcc): G5gAcc {
    match g5g_make_spec_for_args($tpl, $args, $env) {
        None { $a }
        Some($spec) { g5g_add_spec_decl($spec, $a) }
    }
}

sub g5g_add_spec_decl($spec: SubDecl, $a: G5gAcc): G5gAcc {
    if strlist_contains($a.names, $spec.name) {
        $a
    } else {
        match g5_build_sig($spec, $a.env) {
            Err($m) {
                G5gAcc(all: $a.all, specs: DeclCons(DSub($spec), $a.specs), names: StrCons($spec.name, $a.names), env: $a.env)
            }
            Ok($sig) {
                $a2 = G5gAcc(all: $a.all, specs: DeclCons(DSub($spec), $a.specs), names: StrCons($spec.name, $a.names), env: CgEnvSub($sig, $a.env))
                g5g_scan_sub_body($spec, $a2)
            }
        }
    }
}

sub g5g_scan_sub_body($s: SubDecl, $a: G5gAcc): G5gAcc {
    $locals = g5g_param_locals($s.params, 0, $a.env)
    match $s.body {
        BlockBody($ss) { g5g_scan_stmts($ss, $locals, $a) }
        ExprBody($e) { g5g_scan_expr($e, $locals, $a) }
    }
}

# The scalar kind a pre-pass SBind contributes to the locals env: the annotated
# kind when the annotation resolves, else the value's inferable kind, else None
# (untracked — later generic calls using it simply fail inference and decline).
sub g5g_bind_kind($ty: Option[TypeRef], $v: Expr, $env: CgEnv): Option[CgKind] {
    match $ty {
        Some($tr) {
            match g5_param_kind($ty, $env) {
                Ok($kk) { Some($kk) }
                Err($m) { None }
            }
        }
        None {
            match $v {
                ELambda($params, $ret, $body, $topic) {
                    match g5_param_kinds($params, $env) {
                        Err($pm) { None }
                        Ok($pk) {
                            match g5_ret_kind($ret, $env) {
                                Err($rm) { None }
                                Ok($rk) { Some(CgFn($pk, $rk)) }
                            }
                        }
                    }
                }
                _ {
                    # A scalar/call/name value first; else an unannotated list value
                    # (`@nums = [1, 2, 3]`) whose element kind makes it a CgList — so a
                    # later generic call `f(@nums, ...)` can infer its List[T] binding.
                    match g5_kind_from_expr($v, $env) {
                        Some($k) { Some($k) }
                        None {
                            match g7_list_kind_from_value($v, $env) {
                                Ok($el) { Some(CgList($el)) }
                                Err($m) {
                                    match g7_map_val_kind_from_value($v, $env) {
                                        Ok($mv) { Some(CgMap($mv)) }
                                        Err($mm) {
                                            match g8_class_kind_from_value($v, $env) {
                                                Ok($ck) { Some($ck) }
                                                Err($cm) {
                                                    match g6e_enum_kind_from_value($v, $env) {
                                                        Ok($ek) { Some($ek) }
                                                        Err($em) { None }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5g_scan_stmts($xs: StmtList, $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $xs {
        StmtNil { $a }
        StmtCons($h, $t) {
            match $h {
                SBind($m, $n, $ty, $v) {
                    $a1 = g5g_scan_expr($v, $locals, $a)
                    # NOTE self-compile subset: the kind decision lives in a helper so
                    # the Option[CgKind] carrier is only ever in RETURN/scrutinee
                    # position — a carrier-valued `$k = match ...` BIND is out of the
                    # selfhost codegen subset.
                    match g5g_bind_kind($ty, $v, cg_env_append($locals, $a1.env)) {
                        Some($kk) {
                            g5g_scan_stmts($t, CgEnvCons(CgVar(name: $n, cname: "", kind: $kk, mutable: $m, borrowed: true, listlen: g5_map_listlen($kk)), $locals), $a1)
                        }
                        None { g5g_scan_stmts($t, $locals, $a1) }
                    }
                }
                SReturn($v) { g5g_scan_stmts($t, $locals, g5g_scan_opt_expr($v, $locals, $a)) }
                SExpr($x) { g5g_scan_stmts($t, $locals, g5g_scan_expr($x, $locals, $a)) }
                SWhile($c, $bd) { g5g_scan_stmts($t, $locals, g5g_scan_stmts($bd, $locals, g5g_scan_expr($c, $locals, $a))) }
                SFor($vars, $iter, $bd) { g5g_scan_stmts($t, $locals, g5g_scan_stmts($bd, $locals, g5g_scan_expr($iter, $locals, $a))) }
                SHatch($bd) { g5g_scan_stmts($t, $locals, g5g_scan_stmts($bd, $locals, $a)) }
                SSelect($arms, $els) { g5g_scan_stmts($t, $locals, g5g_scan_select($arms, $els, $locals, $a)) }
            }
        }
    }
}

sub g5g_scan_select($arms: SelectArmList, $els: Option[StmtList], $locals: CgEnv, $a: G5gAcc): G5gAcc {
    match $arms {
        SelectArmNil { g5g_scan_opt_stmts($els, $locals, $a) }
        SelectArmCons($h, $t) {
            $a1 = g5g_scan_expr($h.op, $locals, $a)
            g5g_scan_select($t, $els, $locals, g5g_scan_stmts($h.body, $locals, $a1))
        }
    }
}

sub g5g_scan_class_subs($subs: SubDeclList, $a: G5gAcc): G5gAcc {
    match $subs {
        SubDeclNil { $a }
        SubDeclCons($h, $t) {
            # NOTE self-compile subset: keep the if-value in ARGUMENT/TAIL position —
            # a class-valued `$x = if ...` BIND is out of the selfhost codegen subset.
            if g5g_is_generic($h) {
                g5g_scan_class_subs($t, $a)
            } else {
                g5g_scan_class_subs($t, g5g_scan_sub_body($h, $a))
            }
        }
    }
}

sub g5g_scan_decls($decls: DeclList, $a: G5gAcc): G5gAcc {
    match $decls {
        DeclNil { $a }
        DeclCons($h, $t) {
            $a1 = match $h {
                DSub($s) { if g5g_is_generic($s) { $a } else { g5g_scan_sub_body($s, $a) } }
                DClass($c) { g5g_scan_class_subs($c.subs, $a) }
                _ { $a }
            }
            g5g_scan_decls($t, $a1)
        }
    }
}

sub g5g_decl_append($xs: DeclList, $ys: DeclList): DeclList {
    match $xs {
        DeclNil { $ys }
        DeclCons($h, $t) { DeclCons($h, g5g_decl_append($t, $ys)) }
    }
}

# Expand generic templates into monomorphized spec decls appended to the
# program. FAST PATH: a program with no generic templates (including the
# compiler's own source) returns its decl list untouched. A sig-collection
# error here returns the decls unchanged — the pipeline's own
# g5_collect_sigs_on will reproduce the identical error.
sub g5g_expand_generics($decls: DeclList, $base: CgEnv): DeclList {
    if g5g_has_templates($decls) {
        match g5_collect_sigs_indexed($decls, $base) {
            Err($m) { $decls }
            Ok($sigs) {
                $a = g5g_scan_decls($decls, G5gAcc(all: $decls, specs: DeclNil, names: StrNil, env: $sigs))
                g5g_decl_append($decls, $a.specs)
            }
        }
    } else {
        $decls
    }
}

# ---- E5d-7c-2d: program-dependent Result[user] carrier typedefs --------------
# The scalar Result combos are emitted unconditionally (g6_result_typedefs). A
# Result carrier whose payload is a user CLASS or ENUM embeds that struct by value,
# so its typedef is program-dependent and must follow the user typedefs. Collect
# every UNIQUE Result[user] carrier kind used in this module's sub signatures or
# nested source annotations (including local channel element types) and emit one
# typedef per kind. The caller places the result AFTER $enum_defs/$class_defs so
# embedded user structs are already defined.
class RctAcc {
    has $.seen: StrList
    has $.acc: Str
}

sub g6_kind_needs_result_typedef($k: CgKind): Bool {
    match $k {
        CgEnum($n) { true }
        CgClass($n) { true }
        CgOptInt { true }
        CgOptFloat { true }
        CgOptBool { true }
        CgOptStr { true }
        CgOptClass($n) { true }
        CgOptEnum($n) { true }
        # Result[Match, E] is program-dependent (outside the unconditional
        # scalar matrix) and embeds a `guji_match_t*` slot.
        CgMatch { true }
        # Result[Bush, E] likewise embeds a counted `guji_bush_t*` slot.
        CgBush { true }
        # A `Result[List[T], E]` carrier is program-dependent (not in the scalar
        # matrix), so its `guji_res_list_*` typedef is collected + emitted here,
        # deduped by the element-agnostic name (P5b-2b-carrier-eq-collections).
        CgList($el) { true }
        # A `Result[Map[Str, V], E]` carrier is likewise program-dependent
        # (`guji_res_map_*`, value-agnostic name; P9-7b result_map_ownership).
        CgMap($v) { true }
        _ { false }
    }
}

# A Result carrier needs a program-dependent typedef iff either slot embeds a user
# enum/class payload or an Option carrier (the scalar Result matrix is the only
# unconditionally emitted Result set).
sub g6_result_is_user_carrier($k: CgKind): Bool {
    match $k {
        CgRes($ok, $err) { g6_kind_needs_result_typedef($ok) || g6_kind_needs_result_typedef($err) }
        _ { false }
    }
}

# If $k is a user-bearing Result carrier not yet seen, append its typedef.
# Skip names already emitted unconditionally in g6_result_typedefs (List/Map/
# Match/Bush + Str) so channel programs do not double-define the C structs.
sub g6_result_uncond_user_ctype($name: Str): Bool {
    $name == "guji_res_list_str" || $name == "guji_res_map_str" || $name == "guji_res_match_str" || $name == "guji_res_bush_str"
}

# Result[Option[class], Str] is emitted immediately after each class's Option
# carrier so a later class may embed it by value.  Do not emit the same typedef a
# second time when that carrier also appears in a sub signature.
sub g6_result_predeclared_class_carrier($k: CgKind): Bool {
    match $k {
        CgRes($ok, $err) {
            match $ok {
                CgOptClass($n) { cgkind_eq($err, CgStr) }
                _ { false }
            }
        }
        _ { false }
    }
}

sub g6_rct_add($k: CgKind, $a: RctAcc): RctAcc {
    if g6_result_predeclared_class_carrier($k) {
        $a
    } else if g6_result_is_user_carrier($k) {
        match $k {
            CgRes($ok, $err) {
                $name = g6_result_ctype($k)
                if strlist_contains($a.seen, $name) || g6_result_uncond_user_ctype($name) {
                    $a
                } else {
                    RctAcc(seen: StrCons($name, $a.seen), acc: $a.acc ~ g6_result_one_typedef($ok, $err) ~ g6_result_one_pair_extras($ok, $err))
                }
            }
            _ { $a }
        }
    } else {
        $a
    }
}

sub g6_rct_ret($r: CgRet, $a: RctAcc): RctAcc {
    match $r {
        RRes($k) { g6_rct_add($k, $a) }
        _ { $a }
    }
}

sub g6_rct_params($ks: CgKindList, $a: RctAcc): RctAcc {
    match $ks {
        CgKindNil { $a }
        CgKindCons($h, $t) { g6_rct_params($t, g6_rct_add($h, $a)) }
    }
}

# Collect every Result carrier nested in a source type. This supplements the
# resolved-signature walk below: a local-only `Chan[Result[Int, List[Str]]]`
# still needs its `guji_res_int_list`, recv wrapper, and channel drop helper
# even when no sub parameter or return happens to mention that Result type.
sub g6_rct_type($tr: TypeRef, $env: CgEnv, $a: RctAcc): RctAcc {
    if $tr.name == "Result" {
        match g6_result_kind_from_type(Some($tr), $env) {
            Ok($kind) { g6_rct_types($tr.args, $env, g6_rct_add($kind, $a)) }
            Err($m) { g6_rct_types($tr.args, $env, $a) }
        }
    } else {
        g6_rct_types($tr.args, $env, $a)
    }
}

sub g6_rct_types($types: TypeList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $types {
        TypeNil { $a }
        TypeCons($head, $tail) { g6_rct_types($tail, $env, g6_rct_type($head, $env, $a)) }
    }
}

sub g6_rct_opt_type($ty: Option[TypeRef], $env: CgEnv, $a: RctAcc): RctAcc {
    match $ty {
        None { $a }
        Some($tr) { g6_rct_type($tr, $env, $a) }
    }
}

sub g6_rct_param_types($params: ParamList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $params {
        ParamNil { $a }
        ParamCons($head, $tail) {
            g6_rct_param_types($tail, $env, g6_rct_opt_type($head.ty, $env, $a))
        }
    }
}

sub g6_rct_exprs($exprs: ExprList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $exprs {
        ExprNil { $a }
        ExprCons($head, $tail) { g6_rct_exprs($tail, $env, g6_rct_expr($head, $env, $a)) }
    }
}

sub g6_rct_map_entries($entries: MapEntryList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $entries {
        MapEntryNil { $a }
        MapEntryCons($head, $tail) {
            g6_rct_map_entries($tail, $env, g6_rct_expr($head.value, $env, g6_rct_expr($head.key, $env, $a)))
        }
    }
}

sub g6_rct_opt_expr($expr: Option[Expr], $env: CgEnv, $a: RctAcc): RctAcc {
    match $expr {
        None { $a }
        Some($value) { g6_rct_expr($value, $env, $a) }
    }
}

sub g6_rct_opt_stmts($stmts: Option[StmtList], $env: CgEnv, $a: RctAcc): RctAcc {
    match $stmts {
        None { $a }
        Some($body) { g6_rct_stmts($body, $env, $a) }
    }
}

sub g6_rct_elifs($elifs: ElifList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $elifs {
        ElifNil { $a }
        ElifCons($head, $tail) {
            g6_rct_elifs($tail, $env, g6_rct_stmts($head.body, $env, g6_rct_expr($head.cond, $env, $a)))
        }
    }
}

sub g6_rct_pattern($pat: Pattern, $env: CgEnv, $a: RctAcc): RctAcc {
    match $pat {
        PLit($expr) { g6_rct_expr($expr, $env, $a) }
        PVariant($name, $args) { g6_rct_patterns($args, $env, $a) }
        _ { $a }
    }
}

sub g6_rct_patterns($patterns: PatternList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $patterns {
        PatNil { $a }
        PatCons($head, $tail) { g6_rct_patterns($tail, $env, g6_rct_pattern($head, $env, $a)) }
    }
}

sub g6_rct_arms($arms: ArmList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $arms {
        ArmNil { $a }
        ArmCons($head, $tail) {
            $a1 = g6_rct_pattern($head.pat, $env, $a)
            $a2 = g6_rct_opt_expr($head.guard, $env, $a1)
            g6_rct_arms($tail, $env, g6_rct_stmts($head.body, $env, $a2))
        }
    }
}

sub g6_rct_expr($expr: Expr, $env: CgEnv, $a: RctAcc): RctAcc {
    match $expr {
        EList($items) { g6_rct_exprs($items, $env, $a) }
        EMap($items) { g6_rct_map_entries($items, $env, $a) }
        EUnary($op, $value) { g6_rct_expr($value, $env, $a) }
        EBinary($op, $left, $right) { g6_rct_expr($right, $env, g6_rct_expr($left, $env, $a)) }
        ENamedArg($name, $value) { g6_rct_expr($value, $env, $a) }
        ECall($callee, $args) { g6_rct_exprs($args, $env, g6_rct_expr($callee, $env, $a)) }
        EField($object, $name) { g6_rct_expr($object, $env, $a) }
        EIndex($object, $index) { g6_rct_expr($index, $env, g6_rct_expr($object, $env, $a)) }
        ECapture($object, $name) { g6_rct_expr($object, $env, $a) }
        EIf($cond, $then, $elifs, $els) {
            g6_rct_opt_stmts($els, $env, g6_rct_elifs($elifs, $env, g6_rct_stmts($then, $env, g6_rct_expr($cond, $env, $a))))
        }
        EMatch($subject, $arms) { g6_rct_arms($arms, $env, g6_rct_expr($subject, $env, $a)) }
        ELambda($params, $ret, $body, $topic) {
            g6_rct_stmts($body, $env, g6_rct_opt_type($ret, $env, g6_rct_param_types($params, $env, $a)))
        }
        EQuestion($value) { g6_rct_expr($value, $env, $a) }
        _ { $a }
    }
}

sub g6_rct_select($arms: SelectArmList, $els: Option[StmtList], $env: CgEnv, $a: RctAcc): RctAcc {
    match $arms {
        SelectArmNil { g6_rct_opt_stmts($els, $env, $a) }
        SelectArmCons($head, $tail) {
            $a1 = g6_rct_expr($head.op, $env, $a)
            g6_rct_select($tail, $els, $env, g6_rct_stmts($head.body, $env, $a1))
        }
    }
}

sub g6_rct_stmts($stmts: StmtList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $stmts {
        StmtNil { $a }
        StmtCons($head, $tail) {
            match $head {
                SBind($mutable, $name, $ty, $value) {
                    g6_rct_stmts($tail, $env, g6_rct_expr($value, $env, g6_rct_opt_type($ty, $env, $a)))
                }
                SReturn($value) { g6_rct_stmts($tail, $env, g6_rct_opt_expr($value, $env, $a)) }
                SExpr($expr) { g6_rct_stmts($tail, $env, g6_rct_expr($expr, $env, $a)) }
                SWhile($cond, $body) {
                    g6_rct_stmts($tail, $env, g6_rct_stmts($body, $env, g6_rct_expr($cond, $env, $a)))
                }
                SFor($vars, $iter, $body) {
                    g6_rct_stmts($tail, $env, g6_rct_stmts($body, $env, g6_rct_expr($iter, $env, $a)))
                }
                SHatch($body) { g6_rct_stmts($tail, $env, g6_rct_stmts($body, $env, $a)) }
                SSelect($arms, $els) {
                    g6_rct_stmts($tail, $env, g6_rct_select($arms, $els, $env, $a))
                }
            }
        }
    }
}

sub g6_rct_body($body: Body, $env: CgEnv, $a: RctAcc): RctAcc {
    match $body {
        BlockBody($stmts) { g6_rct_stmts($stmts, $env, $a) }
        ExprBody($expr) { g6_rct_expr($expr, $env, $a) }
    }
}

# Collect Result[user] carriers from one sub's resolved signature and source
# annotations. The program is already in-subset (g5_collect_sigs succeeded), so
# signature resolution failures are treated as "no carrier" defensively.
sub g6_rct_sub($sub: SubDecl, $env: CgEnv, $a: RctAcc): RctAcc {
    $a0 = g6_rct_opt_type($sub.ret, $env, g6_rct_param_types($sub.params, $env, $a))
    $a1 = match g5_ret_kind($sub.ret, $env) {
        Ok($r) { g6_rct_ret($r, $a0) }
        Err($m) { $a0 }
    }
    $a2 = match g5_param_kinds($sub.params, $env) {
        Ok($pk) { g6_rct_params($pk, $a1) }
        Err($m) { $a1 }
    }
    g6_rct_body($sub.body, $env, $a2)
}

sub g6_rct_subs($subs: SubDeclList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $subs {
        SubDeclNil { $a }
        SubDeclCons($head, $tail) { g6_rct_subs($tail, $env, g6_rct_sub($head, $env, $a)) }
    }
}

sub g6_rct_walk($decls: DeclList, $env: CgEnv, $a: RctAcc): RctAcc {
    match $decls {
        DeclNil { $a }
        DeclCons($head, $tail) {
            match $head {
                DSub($sub) { g6_rct_walk($tail, $env, g6_rct_sub($sub, $env, $a)) }
                DClass($c) { g6_rct_walk($tail, $env, g6_rct_subs($c.subs, $env, $a)) }
                DEnum($e) { g6_rct_walk($tail, $env, g6_rct_subs($e.subs, $env, $a)) }
                _ { g6_rct_walk($tail, $env, $a) }
            }
        }
    }
}

sub g6_result_user_typedefs($decls: DeclList, $env: CgEnv): Str {
    g6_rct_walk($decls, $env, RctAcc(seen: StrNil, acc: "")).acc
}

sub g5_collect_import_sigs_on($alias: Str, $decls: DeclList, $base: CgEnv): Result[CgEnv, Str] {
    match $decls {
        DeclNil { Ok($base) }
        DeclCons($head, $tail) {
            match $head {
                DSub($sub) {
                    # P5b-1: imported generic templates carry no direct signature
                    # (cross-module specialization is out of this slice; a
                    # qualified call to one declines at resolution).
                    if g5g_is_generic($sub) {
                        g5_collect_import_sigs_on($alias, $tail, $base)
                    } else {
                        match g5_build_sig_as($sub, $base, $sub.name, g9_import_cname($alias, $sub.name), false) {
                            Err($m) { Err($m) }
                            Ok($sig) {
                                match g5_collect_import_sigs_on($alias, $tail, $base) {
                                    Err($m) { Err($m) }
                                    Ok($rest) { Ok(CgEnvSub($sig, $rest)) }
                                }
                            }
                        }
                    }
                }
                DImport($i) { g5_collect_import_sigs_on($alias, $tail, $base) }
                DClass($c) {
                    if !strlist_empty($c.tparams) {
                        g5_collect_import_sigs_on($alias, $tail, $base)
                    } else {
                        match g5_collect_import_sigs_on($alias, $tail, $base) {
                            Err($m) { Err($m) }
                            Ok($rest) { g5_collect_import_class_sigs($alias, $c.name, $c.subs, $base, $rest) }
                        }
                    }
                }
                DEnum($e) {
                    # P9-5c: collect enum-body method/assoc sigs for the imported
                    # module's own emission (`Choice.pick` inside tokens.guji) and
                    # for bound/assoc dispatch — bare logical name, alias-prefixed C.
                    if !strlist_empty($e.tparams) {
                        g5_collect_import_sigs_on($alias, $tail, $base)
                    } else {
                        match g5_collect_import_sigs_on($alias, $tail, $base) {
                            Err($m) { Err($m) }
                            Ok($rest) { g5_collect_import_enum_method_sigs($alias, $e.name, $e.subs, $base, $rest) }
                        }
                    }
                }
                DGrammar($g) { g5_collect_import_sigs_on($alias, $tail, $base) }
            }
        }
    }
}

sub g5_collect_import_sigs($alias: Str, $decls: DeclList, $base: CgEnv): Result[CgEnv, Str] {
    match g5_collect_import_sigs_on($alias, $decls, $base) {
        Err($m) { Err($m) }
        Ok($env) { Ok(cg_env_index_subs($env)) }
    }
}

sub g5_collect_import_public_sigs_on($alias: Str, $decls: DeclList, $build_env: CgEnv, $tail: CgEnv): Result[CgEnv, Str] {
    match $decls {
        DeclNil { Ok($tail) }
        DeclCons($head, $rest) {
            match $head {
                DSub($sub) {
                    match g5_collect_import_public_sigs_on($alias, $rest, $build_env, $tail) {
                        Err($m) { Err($m) }
                        Ok($more) {
                            if $sub.public && (!g5g_is_generic($sub)) {
                                match g5_build_sig_as($sub, $build_env, import_qualified_name($alias, $sub.name), g9_import_cname($alias, $sub.name), false) {
                                    Err($m) { Err($m) }
                                    Ok($sig) { Ok(CgEnvSub($sig, $more)) }
                                }
                            } else {
                                Ok($more)
                            }
                        }
                    }
                }
                DImport($i) { g5_collect_import_public_sigs_on($alias, $rest, $build_env, $tail) }
                DClass($c) {
                    match g5_collect_import_public_sigs_on($alias, $rest, $build_env, $tail) {
                        Err($m) { Err($m) }
                        Ok($more) {
                            if $c.public && strlist_empty($c.tparams) {
                                match g5_collect_import_class_sigs($alias, $c.name, $c.subs, $build_env, $more) {
                                    Err($m) { Err($m) }
                                    Ok($methods) {
                                        # Marker key stays alias::SourceName even when
                                        # the C type was mangled to alias_SourceName.
                                        Ok(CgEnvSub(g9_import_class_marker($alias, g9_type_display_name($c.name)), $methods))
                                    }
                                }
                            } else {
                                Ok($more)
                            }
                        }
                    }
                }
                DEnum($e) {
                    # P9-5c twin of the DClass arm: export mangled `alias_Choice.pick`
                    # method sigs plus a non-callable `tokens::Choice#enum` marker so
                    # `tokens::Choice.pick(...)` can resolve without a new CgEnv variant.
                    match g5_collect_import_public_sigs_on($alias, $rest, $build_env, $tail) {
                        Err($m) { Err($m) }
                        Ok($more) {
                            if $e.public && strlist_empty($e.tparams) {
                                match g5_collect_import_enum_method_sigs($alias, $e.name, $e.subs, $build_env, $more) {
                                    Err($m) { Err($m) }
                                    Ok($methods) {
                                        Ok(CgEnvSub(g9_import_enum_marker($alias, g9_type_display_name($e.name)), $methods))
                                    }
                                }
                            } else {
                                Ok($more)
                            }
                        }
                    }
                }
                DGrammar($g) { g5_collect_import_public_sigs_on($alias, $rest, $build_env, $tail) }
            }
        }
    }
}

# ---- G6b-b-2b-ii-b-3-iii/v: collect user enums into codegen metadata --------

# I10c2a: enum metadata is collected before CgEnv exists, so a Chan field needs
# the declaration-aware List/Map/user-enum resolver. Keep the same element-shape
# predicates as ordinary channel construction; the stored field itself is only
# an owned guji_chan_t* handle, independent of the payload ABI.
sub g6e_chan_field_kind($elem: TypeRef, $all: DeclList): CgKind {
    if $elem.name == "Unit" {
        CgChan(CgUnit)
    } else {
        match g7_kind_from_type_decls($elem, $all) {
            Err($m) { CgOptStr }
            Ok($kind) {
                match $kind {
                    CgInt { CgChan(CgInt) }
                    CgBool { CgChan(CgBool) }
                    CgFloat { CgChan(CgFloat) }
                    CgStr { CgChan(CgStr) }
                    CgList($inner) {
                        if g11_chan_list_elem_supported($inner) { CgChan($kind) } else { CgOptStr }
                    }
                    CgMap($val) {
                        if g11_chan_map_val_supported($val) { CgChan($kind) } else { CgOptStr }
                    }
                    CgEnum($name) { CgChan($kind) }
                    _ { CgOptStr }
                }
            }
        }
    }
}

# Map a variant field's annotated type to the CgKind this slice supports.
# Unannotated/unknown fields become CgOptStr as an unsupported sentinel (real
# `Str` fields must be explicitly annotated as Str).
sub g6e_field_kind($ty: Option[TypeRef], $owner: Str, $all: DeclList): CgKind {
    match $ty {
        None { CgOptStr }
        Some($tr) {
            if $tr.name == "Int" { CgInt }
            else if $tr.name == "Float" { CgFloat }
            else if $tr.name == "Bool" { CgBool }
            else if $tr.name == "Str" { CgStr }
            else if $tr.name == "List" {
                # Enum metadata is collected before CgEnv exists. Resolve against
                # the complete declaration list so List[user-enum] (including
                # List[the declaring enum]) keeps its nominal element kind.
                match g7_kind_from_type_decls($tr, $all) { Ok($kind) { $kind } Err($m) { CgOptStr } }
            }
            else if $tr.name == "Map" {
                match g7_kind_from_type_decls($tr, $all) { Ok($kind) { $kind } Err($m) { CgOptStr } }
            }
            else if $tr.name == "Option" {
                # An `Option[T]` variant field wraps T in the per-type `guji_opt_<T>`
                # tagged carrier (tag 1 = Some, 0 = None), the payload embedded BY
                # VALUE: a user ENUM -> `CgOptEnum` (E5d-7c-2d-7), a user CLASS ->
                # `CgOptClass` (E5d-8k, the class analogue). Both recurse rc through
                # the wrapped type's `guji_<op>_<T>_fields` helper. Class vs enum is
                # decided against the FULL decl list (mirrors the `else` branch below
                # and `g8_class_field_kind`'s Option arm). Int/Bool/Float payloads
                # use their fixed scalar carriers. Str and
                # collection carriers remain declined until their enum-field RC
                # and mixed-position representations are explicit. EB-1c keeps
                # Option[<owner>] / cyclic Option[<user>] as the same logical
                # carrier kind and boxes the carrier at the storage sites.
                match typelist_at($tr.args, 0) {
                    None { CgOptStr }
                    Some($elem) {
                        if $elem.name == "Int" {
                            CgOptInt
                        } else if $elem.name == "Float" {
                            CgOptFloat
                        } else if $elem.name == "Bool" {
                            CgOptBool
                        } else if $elem.name == "Str" || $elem.name == "Option" || $elem.name == "Result" || $elem.name == "List" || $elem.name == "Map" {
                            CgOptStr
                        } else if decl_class_named($all, $elem.name) {
                            $base = CgOptClass($elem.name)
                            if g6e_option_carrier_needs_box($owner, $base, $all) { CgBoxOptClass($elem.name) } else { $base }
                        } else if decl_enum_named($all, $elem.name) {
                            $base = CgOptEnum($elem.name)
                            if g6e_option_carrier_needs_box($owner, $base, $all) { CgBoxOptEnum($elem.name) } else { $base }
                        } else {
                            CgOptStr
                        }
                    }
                }
            }
            else if $tr.name == "Result" { CgOptStr }
            else if $tr.name == "Handle" { CgHandle }
            else if $tr.name == "Chan" {
                # Decl-only enum metadata has no CgEnv. I10a1 admitted scalar
                # channels; I10c2a extends the same handle representation to the
                # native-supported List/Map/user-enum payload boundary.
                match typelist_at($tr.args, 0) {
                    Some($elem) { g6e_chan_field_kind($elem, $all) }
                    None { CgOptStr }
                }
            }
            else {
                # Any other concrete (non-builtin) type name is a user CLASS or a
                # user ENUM (the program type-checked, and the codegen subset has no
                # other nameable user types). A class is checked first against the
                # FULL decl list (no codegen env is available here, mirroring
                # `decl_class_named` in `g8_class_field_kind`): a class variant field
                # is embedded BY VALUE (slice 5 E5d-8h), the class analogue of the D3
                # nested enum — its own `guji_<op>_<Class>_fields` helper drives rc.
                # `Option`/`Result` payloads stay the unsupported sentinel above
                # (native rejects them as variant fields -> oracle-limit). A field
                # naming its declaring ENUM is recursive and must be boxed; every
                # other enum field stays the D3 by-value nested representation.
                if decl_class_named($all, $tr.name) {
                    if decl_before($all, $owner, $tr.name) && byvalue_type_reaches($tr.name, $owner, $all, StrNil) {
                        CgBoxClass($tr.name)
                    } else {
                        CgClass($tr.name)
                    }
                } else if $tr.name == $owner {
                    CgBoxEnum($tr.name)
                } else if decl_before($all, $owner, $tr.name) && byvalue_type_reaches($tr.name, $owner, $all, StrNil) {
                    CgBoxEnum($tr.name)
                } else {
                    CgEnum($tr.name)
                }
            }
        }
    }
}

sub g6e_field_kinds($params: ParamList, $owner: Str, $all: DeclList): CgKindList {
    match $params {
        ParamNil { CgKindNil }
        ParamCons($h, $t) { CgKindCons(g6e_field_kind($h.ty, $owner, $all), g6e_field_kinds($t, $owner, $all)) }
    }
}

sub g6e_variants_of($vs: VariantList, $owner: Str, $all: DeclList): CgVariantInfoList {
    match $vs {
        VariantNil { CgVarNil }
        VariantCons($v, $rest) { CgVarCons(CgVariant(name: $v.name, fields: g6e_field_kinds($v.fields, $owner, $all)), g6e_variants_of($rest, $owner, $all)) }
    }
}

# Build the CgEnvEnum chain (enum infos at the base of the codegen environment).
# `$all` is the FULL decl list (threaded unchanged through the recursion) so a
# class-named variant field resolves to `CgClass` via `g6e_field_kind`.
sub g6e_collect_enums($decls: DeclList, $all: DeclList): CgEnv {
    match $decls {
        DeclNil { CgEnvNil }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) { CgEnvEnum(CgEnumInfo(name: $e.name, variants: g6e_variants_of($e.variants, $e.name, $all)), g6e_collect_enums($tail, $all)) }
                DImport($i) { g6e_collect_enums($tail, $all) }
                DClass($c) { g6e_collect_enums($tail, $all) }
                _ { g6e_collect_enums($tail, $all) }
            }
        }
    }
}

# ============================================================================
# G6-gen-1: generic variant REGISTRY + uniform value representation.
# ============================================================================
# The PIVOT (re-seed 2026-06-25) replaces the bespoke per-(variant x payload)
# carrier blowup with ONE metadata-keyed registry. THIS slice (G6-gen-1) only
# BUILDS that registry and SELF-CHECKS it; no construction/match lowering is
# routed through it yet (that is G6-gen-2). The registry pre-registers the
# built-ins Option/Result and every user `DEnum`, recording each variant's tag
# (its 0-based declaration index) and its ordered field types.
#
# UNIFORM RECURSIVE VALUE REP (internal generated-C representation only -- NOT a
# guji-language change). A variant value lowers to the SAME native-shaped tagged
# struct the landed Option/Result carriers and user-enum structs already emit:
#     struct <Enum> { int64_t tag; <field 0>; <field 1>; ... };
# so the GUJI_HDR / ownership layout is reused unchanged (do NOT introduce a
# conflicting representation). A FIELD is itself a value of some type: a scalar
# (Int/Float/Bool, by value), an owned `Str` (`const char*`, retain/release via
# the existing primitives), or another carrier/enum -- recursive, keyed back
# into this same registry. `CgFieldTy` makes that recursion explicit: `FtConc`
# wraps a concrete `CgKind` (itself recursive through `CgRes`/`CgEnum`); `FtParam`
# is a generic type-parameter slot used only by the Option/Result built-ins
# (a user enum is monomorphic in this subset, so all its fields are `FtConc`).
enum CgFieldTy {
    FtConc($k: CgKind)
    FtParam($name: Str)
}

enum CgFieldTyList {
    FtNil
    FtCons($head: CgFieldTy, $tail: CgFieldTyList)
}

class CgVariantMeta {
    has $.name: Str
    has $.tag: Int
    has $.fields: CgFieldTyList
}

enum CgVariantMetaList {
    CgVMNil
    CgVMCons($head: CgVariantMeta, $tail: CgVariantMetaList)
}

class CgEnumMeta {
    has $.name: Str
    has $.tparams: StrList
    has $.variants: CgVariantMetaList
}

enum CgRegistry {
    CgRegNil
    CgRegCons($head: CgEnumMeta, $tail: CgRegistry)
}

sub cg_ftlist_len($fs: CgFieldTyList): Int {
    match $fs {
        FtNil { 0 }
        FtCons($h, $t) { 1 + cg_ftlist_len($t) }
    }
}

# Pre-registered built-in carriers. Tags MIRROR the landed carrier layout so the
# generic registry agrees with the bespoke path: Option None=0/Some=1
# (`g6_option_release` keys retain/release on `.tag != 0`), Result Ok=0/Err=1
# (Ok construction emits `0LL`, Err emits `1LL` in `g6_result` lowering).
sub cg_reg_option(): CgEnumMeta {
    CgEnumMeta(
        name: "Option",
        tparams: StrCons("T", StrNil),
        variants: CgVMCons(
            CgVariantMeta(name: "None", tag: 0, fields: FtNil),
            CgVMCons(
                CgVariantMeta(name: "Some", tag: 1, fields: FtCons(FtParam("T"), FtNil)),
                CgVMNil)))
}

sub cg_reg_result(): CgEnumMeta {
    CgEnumMeta(
        name: "Result",
        tparams: StrCons("T", StrCons("E", StrNil)),
        variants: CgVMCons(
            CgVariantMeta(name: "Ok", tag: 0, fields: FtCons(FtParam("T"), FtNil)),
            CgVMCons(
                CgVariantMeta(name: "Err", tag: 1, fields: FtCons(FtParam("E"), FtNil)),
                CgVMNil)))
}

# A user enum's fields are concrete (monomorphic): wrap each CgKind as FtConc.
sub cg_kinds_to_fts($ks: CgKindList): CgFieldTyList {
    match $ks {
        CgKindNil { FtNil }
        CgKindCons($h, $t) { FtCons(FtConc($h), cg_kinds_to_fts($t)) }
    }
}

# Build the variant metadata from the SAME CgVariantInfoList the landed carrier
# path consumes (`g6e_variants_of`), assigning sequential tags from declaration
# order -- so the registry can never disagree with the lowering on tag/arity.
sub cg_reg_variants_of($vs: CgVariantInfoList, $i: Int): CgVariantMetaList {
    match $vs {
        CgVarNil { CgVMNil }
        CgVarCons($v, $rest) {
            CgVMCons(CgVariantMeta(name: $v.name, tag: $i, fields: cg_kinds_to_fts($v.fields)),
                     cg_reg_variants_of($rest, $i + 1))
        }
    }
}

sub cg_reg_user_enums($decls: DeclList, $all: DeclList): CgRegistry {
    match $decls {
        DeclNil { CgRegNil }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    CgRegCons(
                        CgEnumMeta(name: $e.name, tparams: $e.tparams,
                                   variants: cg_reg_variants_of(g6e_variants_of($e.variants, $e.name, $all), 0)),
                        cg_reg_user_enums($tail, $all))
                }
                _ { cg_reg_user_enums($tail, $all) }
            }
        }
    }
}

# The full registry: Option + Result built-ins, then every user DEnum.
sub cg_reg_build($decls: DeclList): CgRegistry {
    CgRegCons(cg_reg_option(),
    CgRegCons(cg_reg_result(),
    cg_reg_user_enums($decls, $decls)))
}

# Metadata lookup by enum name (the registry is the generic keying surface).
sub cg_reg_lookup($reg: CgRegistry, $name: Str): Option[CgEnumMeta] {
    match $reg {
        CgRegNil { None }
        CgRegCons($h, $t) { if $h.name == $name { Some($h) } else { cg_reg_lookup($t, $name) } }
    }
}

sub cg_reg_lookup_variant($vs: CgVariantMetaList, $name: Str): Option[CgVariantMeta] {
    match $vs {
        CgVMNil { None }
        CgVMCons($v, $rest) { if $v.name == $name { Some($v) } else { cg_reg_lookup_variant($rest, $name) } }
    }
}

sub cg_vm_at($vs: CgVariantMetaList, $i: Int): Option[CgVariantMeta] {
    match $vs {
        CgVMNil { None }
        CgVMCons($v, $rest) { if $i == 0 { Some($v) } else { cg_vm_at($rest, $i - 1) } }
    }
}

class CgRegVariantUse {
    has $.info: CgEnumInfo
    has $.meta: CgVariantMeta
}

# Registry-shaped metadata for a user enum already present in the codegen env.
# This is the G6-gen-2a bridge: construction and PVariant dispatch now consume
# `CgVariantMeta` (tag + ordered field types) instead of open-coding tag/arity
# from the older per-enum table. The metadata is derived from the same registered
# variant list as G6-gen-1, so tags/layout cannot drift.
sub cg_reg_meta_from_info($info: CgEnumInfo): CgEnumMeta {
    CgEnumMeta(name: $info.name, tparams: StrNil, variants: cg_reg_variants_of($info.variants, 0))
}

sub cg_reg_user_variant($env: CgEnv, $ename: Str, $vname: Str): Result[CgRegVariantUse, Str] {
    match cg_env_lookup_enum($env, $ename) {
        None { Err(g3_unsupported()) }
        Some($info) {
            $meta = cg_reg_meta_from_info($info)
            match cg_reg_lookup_variant($meta.variants, $vname) {
                None { Err(g3_unsupported()) }
                Some($vm) { Ok(CgRegVariantUse(info: $info, meta: $vm)) }
            }
        }
    }
}

# G6-gen-2b: the SAME metadata bridge for the BUILT-IN carriers (Option/Result).
# Looks a variant up in the registry's pre-registered Option/Result variant list
# (`cg_reg_option().variants` / `cg_reg_result().variants`) and returns its
# `CgVariantMeta` (tag + ordered field types). Construction and PVariant dispatch
# read the tag/arity from this — no more open-coded 0LL/1LL — so the carriers share
# ONE source of truth with user enums. The carrier C structs + retain/release
# helpers stay capped (this only changes the tag-keying surface; the emitted C is
# unchanged because the registry tags mirror the landed carrier layout).
sub cg_reg_builtin_variant($builtins: CgVariantMetaList, $vname: Str): Result[CgVariantMeta, Str] {
    match cg_reg_lookup_variant($builtins, $vname) {
        None { Err(g3_unsupported()) }
        Some($vm) { Ok($vm) }
    }
}

sub cg_reg_ft_kind($ft: CgFieldTy): Result[CgKind, Str] {
    match $ft {
        FtConc($k) { Ok($k) }
        FtParam($name) { Err(g3_unsupported()) }
    }
}

sub cg_reg_lower_ctor_args($allvars: CgVariantInfoList, $idx: Int, $fields: CgFieldTyList, $args: ExprList, $state: CgState, $env: CgEnv, $owner: Str): Result[CgEnumCtorOut, Str] {
    match $fields {
        FtNil {
            match $args {
                ExprNil { Ok(CgEnumCtorOut(state: $state, fields: "")) }
                _ { Err(g3_unsupported()) }
            }
        }
        FtCons($ft, $frest) {
            match cg_reg_ft_kind($ft) {
                Err($m) { Err($m) }
                Ok($fk) {
                    if !g6e_field_supported($fk) {
                        Err(g3_unsupported())
                    } else {
                        match $args {
                            ExprNil { Err(g3_unsupported()) }
                            ExprCons($a, $arest) {
                                match g6e_lower_ctor_field_value($allvars, $idx, $fk, $a, $state, $env, $owner, DeclNil) {
                                    Err($m) { Err($m) }
                                    Ok($fv) {
                                        $fc = g6e_ctor_field_c($allvars, $idx, $fk, $fv.c)
                                        match cg_reg_lower_ctor_args($allvars, $idx + 1, $frest, $arest, $fv.state, $env, $owner) {
                                            Err($m) { Err($m) }
                                            Ok($rest) {
                                                Ok(CgEnumCtorOut(state: $rest.state, fields: ", " ~ $fc ~ $rest.fields))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Invariant 1: variant tags are 0,1,2,... in declaration order.
sub cg_reg_check_tags($vs: CgVariantMetaList, $i: Int): Result[Str, Str] {
    match $vs {
        CgVMNil { Ok("") }
        CgVMCons($v, $rest) {
            if $v.tag == $i {
                cg_reg_check_tags($rest, $i + 1)
            } else {
                Err("selfhost-codegen: variant registry tag out of order for " ~ $v.name)
            }
        }
    }
}

sub cg_reg_check_each($reg: CgRegistry): Result[Str, Str] {
    match $reg {
        CgRegNil { Ok("") }
        CgRegCons($e, $rest) {
            match cg_reg_check_tags($e.variants, 0) {
                Err($m) { Err($m) }
                Ok($x) { cg_reg_check_each($rest) }
            }
        }
    }
}

# Assert variant $i of $vs has the expected name + field arity.
sub cg_reg_check_variant($vs: CgVariantMetaList, $i: Int, $name: Str, $arity: Int): Result[Str, Str] {
    match cg_vm_at($vs, $i) {
        None { Err("selfhost-codegen: registry missing variant " ~ $name) }
        Some($v) {
            if $v.name == $name && cg_ftlist_len($v.fields) == $arity {
                Ok("")
            } else {
                Err("selfhost-codegen: registry variant mismatch for " ~ $name)
            }
        }
    }
}

# Invariant 2: the built-ins are present and shaped exactly like the landed
# carriers (independently encodes None=0/Some=1, Ok=0/Err=1 + payload arity).
sub cg_reg_check_builtins($reg: CgRegistry): Result[Str, Str] {
    match cg_reg_lookup($reg, "Option") {
        None { Err("selfhost-codegen: registry missing Option") }
        Some($opt) {
            match cg_reg_check_variant($opt.variants, 0, "None", 0) {
                Err($m) { Err($m) }
                Ok($a) {
                    match cg_reg_check_variant($opt.variants, 1, "Some", 1) {
                        Err($m) { Err($m) }
                        Ok($b) {
                            match cg_reg_lookup($reg, "Result") {
                                None { Err("selfhost-codegen: registry missing Result") }
                                Some($res) {
                                    match cg_reg_check_variant($res.variants, 0, "Ok", 1) {
                                        Err($m) { Err($m) }
                                        Ok($c) { cg_reg_check_variant($res.variants, 1, "Err", 1) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Variant names + field arity agree between the registry and a CgVariantInfoList.
sub cg_vm_names_match($a: CgVariantMetaList, $b: CgVariantInfoList): Bool {
    match $a {
        CgVMNil { match $b { CgVarNil { true } _ { false } } }
        CgVMCons($va, $ra) {
            match $b {
                CgVarNil { false }
                CgVarCons($vb, $rb) {
                    if $va.name == $vb.name && cg_ftlist_len($va.fields) == cgkindlist_len($vb.fields) {
                        cg_vm_names_match($ra, $rb)
                    } else { false }
                }
            }
        }
    }
}

# Invariant 3: every user enum in the registry matches the metadata the LANDED
# lowering consumes via `cg_env_lookup_enum` over `g6e_collect_enums`.
sub cg_reg_consistent_user($decls: DeclList, $reg: CgRegistry, $genv: CgEnv): Result[Str, Str] {
    match $decls {
        DeclNil { Ok("") }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    match cg_reg_lookup($reg, $e.name) {
                        None { Err("selfhost-codegen: registry missing user enum " ~ $e.name) }
                        Some($meta) {
                            match cg_env_lookup_enum($genv, $e.name) {
                                None { Err("selfhost-codegen: collect_enums missing " ~ $e.name) }
                                Some($info) {
                                    if cg_vm_names_match($meta.variants, $info.variants) {
                                        cg_reg_consistent_user($tail, $reg, $genv)
                                    } else {
                                        Err("selfhost-codegen: registry/carrier variant mismatch for " ~ $e.name)
                                    }
                                }
                            }
                        }
                    }
                }
                _ { cg_reg_consistent_user($tail, $reg, $genv) }
            }
        }
    }
}

# G6-gen-1 entry: build the generic variant registry and self-check it. Returns
# Ok("") for any consistent program (so it is GATE-NEUTRAL -- no observable
# change to emitted C) and Err only on an internal inconsistency. Wired into
# `compile_program_c` so every compiled program exercises the registry builder +
# the three self-check invariants above.
sub cg_registry_check($decls: DeclList): Result[Str, Str] {
    $reg = cg_reg_build($decls)
    match cg_reg_check_each($reg) {
        Err($m) { Err($m) }
        Ok($a) {
            match cg_reg_check_builtins($reg) {
                Err($m) { Err($m) }
                Ok($b) { cg_reg_consistent_user($decls, $reg, g6e_collect_enums($decls, $decls)) }
            }
        }
    }
}

# A CgKind is a plain by-value scalar (no heap/refcount payload).
sub g6e_kind_is_scalar($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        _ { false }
    }
}

sub g6e_fields_all_scalar($fs: CgKindList): Bool {
    match $fs {
        CgKindNil { true }
        CgKindCons($h, $t) { if g6e_kind_is_scalar($h) { g6e_fields_all_scalar($t) } else { false } }
    }
}

sub g6e_variants_all_scalar($vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { true }
        CgVarCons($h, $t) { if g6e_fields_all_scalar($h.fields) { g6e_variants_all_scalar($t) } else { false } }
    }
}

sub g6e_fields_all_supported($fs: CgKindList): Bool {
    match $fs {
        CgKindNil { true }
        CgKindCons($h, $t) { if g6e_field_supported($h) { g6e_fields_all_supported($t) } else { false } }
    }
}

sub g6e_variants_all_supported($vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { true }
        CgVarCons($h, $t) { if g6e_fields_all_supported($h.fields) { g6e_variants_all_supported($t) } else { false } }
    }
}

# A field kind whose storage owns a heap allocation requiring retain/release: an
# owned `Str` (`const char*`), a `List` (`.data` arr), or a `Map` (`.keys`+`.vals`
# arrays), a by-value nested enum/class (transitively through their fields), or a
# boxed enum pointer. A by-value Option carrier (Option[<class>]/Option[<enum>])
# also owns heap data TRANSITIVELY through its active Some payload, so an enum
# carrying such a field needs caller-side release of a constructed-argument temp.
# The tag-guarded `guji_release_<T>_fields` recursion makes that release a no-op
# for a None slot. By-value scalars (Int/Float/Bool) own nothing.
sub g6e_kind_is_heap($k: CgKind): Bool {
    match $k {
        CgStr { true }
        CgList($el) { true }
        CgMap($v) { true }
        CgEnum($n) { true }
        CgBoxEnum($n) { true }
        CgBoxClass($n) { true }
        CgBoxOptClass($n) { true }
        CgBoxOptEnum($n) { true }
        CgClass($n) { true }
        CgOptClass($n) { true }
        CgOptEnum($n) { true }
        CgHandle { true }
        CgChan($el) { true }
        _ { false }
    }
}

# A by-value (nested) enum field. Homogeneous positions keep it embedded by value;
# mixed positions heap-box it into the union `.p` member (E5d-8h-3c).
# Field kinds that still cannot be placed in a mixed union slot. User classes
# (E5d-8h-3a), Option[class]/Option[enum] carriers (E5d-8h-3b), and by-value nested
# enums (E5d-8h-3c) are all heap-boxed into `.p` when the slot is mixed.
sub g6e_kind_blocks_union($k: CgKind): Bool {
    match $k {
        CgOptInt { true }
        CgOptFloat { true }
        CgOptBool { true }
        _ { false }
    }
}

sub g6e_kind_is_boxed_enum($k: CgKind): Bool {
    match $k {
        CgBoxEnum($n) { true }
        _ { false }
    }
}

sub g6e_fields_has_heap($fs: CgKindList): Bool {
    match $fs {
        CgKindNil { false }
        CgKindCons($h, $t) { if g6e_kind_is_heap($h) { true } else { g6e_fields_has_heap($t) } }
    }
}

sub g6e_variants_have_heap($vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { false }
        CgVarCons($h, $t) { if g6e_fields_has_heap($h.fields) { true } else { g6e_variants_have_heap($t) } }
    }
}

# True iff every variant field of an enum is a by-value scalar (Int/Float/Bool) —
# i.e. the struct owns no `const char*`/heap payload. Such an enum is safe to pass
# by value across a sub boundary with no retain/release (the borrowed enum ABI of
# G6b-b-2b-ii-b-3-vii-b's first cut). Owned-field enum ABI is deferred.
# True iff every variant field has a codegen representation supported by the
# user-enum layout (Int/Float/Bool/Str). This admits owned-Str field enums as sub
# parameters too: parameters are borrowed by-value aliases, so the callee must not
# release their fields, but it can match and bind them.
sub g6e_enum_fields_supported($info: CgEnumInfo): Bool {
    g6e_variants_all_supported($info.variants)
}

# True iff any variant field of an enum owns a heap payload (Str/List/Map). Such an
# enum needs caller-side retain/release of constructed-argument temps and the
# generated `guji_{retain,release}_<Enum>_fields` helpers do real work for it.
sub g6e_enum_has_heap($info: CgEnumInfo): Bool {
    g6e_variants_have_heap($info.variants)
}

sub cgkind_at($ks: CgKindList, $idx: Int): Option[CgKind] {
    match $ks {
        CgKindNil { None }
        CgKindCons($h, $t) {
            if $idx == 0 { Some($h) } else { cgkind_at($t, $idx - 1) }
        }
    }
}

# A field-position layout across an enum's variants (positions are contiguous within a
# variant, so the FIRST absent position ends the struct):
#   PosAbsent      -- no variant has a field at this position.
#   PosScalar($k)  -- every present field at this position is the SAME supported scalar kind
#                     -> a plain scalar C field (`<ctype> fN`).
#   PosUnion       -- present fields are supported scalar/Str kinds but of >=2 DISTINCT kinds
#                     -> a native-shaped union slot (`union { ... } fN`, read .i/.f/.s).
enum CgPosClass {
    PosAbsent
    PosScalar($k: CgKind)
    PosUnion
}

class CgPosAcc {
    has $.seen: Option[CgKind]
    has $.mixed: Bool
}

# Fold the present field kinds at position $idx across all variants. Errs (out of subset) if
# any present field is an unsupported kind. Homogeneous Str positions are plain
# owned `const char*` slots; a Str mixed with another kind is a union slot whose
# active `.s` member is retained/released by the enum helper switch.
sub g6e_pos_acc($vs: CgVariantInfoList, $idx: Int, $acc: CgPosAcc): Result[CgPosAcc, Str] {
    match $vs {
        CgVarNil { Ok($acc) }
        CgVarCons($v, $rest) {
            match cgkind_at($v.fields, $idx) {
                None { g6e_pos_acc($rest, $idx, $acc) }
                Some($k) {
                    if !g6e_field_supported($k) {
                        Err(g3_unsupported())
                    } else {
                        match $acc.seen {
                            None { g6e_pos_acc($rest, $idx, CgPosAcc(seen: Some($k), mixed: $acc.mixed)) }
                            Some($old) {
                                if cgkind_eq($old, $k) {
                                    g6e_pos_acc($rest, $idx, $acc)
                                } else if g6e_kind_blocks_union($old) || g6e_kind_blocks_union($k) {
                                    # A by-value struct field (nested enum, Option[class],
                                    # or Option[enum] carrier) cannot share a union slot
                                    # with a non-identical kind (it is a struct, not a
                                    # scalar/pointer). Decline -- the native oracle
                                    # rejects the same shape, so this is an oracle-limit
                                    # both engines agree on, never a selfhost-only gap.
                                    Err(g3_unsupported())
                                } else {
                                    g6e_pos_acc($rest, $idx, CgPosAcc(seen: Some($k), mixed: true))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g6e_classify_position($vs: CgVariantInfoList, $idx: Int): Result[CgPosClass, Str] {
    match g6e_pos_acc($vs, $idx, CgPosAcc(seen: None, mixed: false)) {
        Err($m) { Err($m) }
        Ok($acc) {
            match $acc.seen {
                None { Ok(PosAbsent) }
                Some($k) {
                    if $acc.mixed { Ok(PosUnion) } else { Ok(PosScalar($k)) }
                }
            }
        }
    }
}

# True iff position $idx is a mixed-kind union slot (drives `.i`/`.f`/`.s` member access).
sub g6e_pos_is_union($vs: CgVariantInfoList, $idx: Int): Bool {
    match g6e_classify_position($vs, $idx) {
        Err($m) { false }
        Ok($cls) { match $cls { PosUnion { true } _ { false } } }
    }
}

sub g6e_field_carrier_boxed($allvars: CgVariantInfoList, $idx: Int, $fk: CgKind, $owner: Str, $all: DeclList): Bool {
    match $fk {
        CgOptClass($n) { g6e_pos_is_union($allvars, $idx) || g6e_option_carrier_needs_box($owner, $fk, $all) }
        CgOptEnum($n) { g6e_pos_is_union($allvars, $idx) || g6e_option_carrier_needs_box($owner, $fk, $all) }
        CgBoxOptClass($n) { true }
        CgBoxOptEnum($n) { true }
        _ { false }
    }
}

sub g6e_stored_field_ctype($allvars: CgVariantInfoList, $idx: Int, $fk: CgKind, $owner: Str, $all: DeclList): Str {
    if g6e_field_carrier_boxed($allvars, $idx, $fk, $owner, $all) {
        match g6_option_wrapped_name($fk) {
            Ok($n) { "struct guji_opt_" ~ $n ~ "*" }
            Err($m) { g6_option_ctype($fk) ~ "*" }
        }
    } else {
        g6e_field_ctype($fk)
    }
}

# The native union member declaration (the extra members mirror native's layout).
sub g6e_union_member_decl(): Str {
    'union { int64_t i; double f; const char* s; guji_slice_t l; guji_map_t m; void* p; }'
}

# Union member designator for a field of kind $fk. A by-value enum (E5d-8h-3c),
# class (E5d-8h-3a), and Option[class]/Option[enum] carrier (E5d-8h-3b) live in a
# mixed slot as counted heap boxes, so they read through the `.p` pointer member.
sub g6e_union_member($fk: CgKind): Str {
    match $fk {
        CgFloat { ".f" }
        CgStr { ".s" }
        CgList($el) { ".l" }
        CgMap($v) { ".m" }
        CgEnum($n) { ".p" }
        CgBoxEnum($n) { ".p" }
        CgBoxClass($n) { ".p" }
        CgClass($n) { ".p" }
        CgOptClass($n) { ".p" }
        CgOptEnum($n) { ".p" }
        CgBoxOptClass($n) { ".p" }
        CgBoxOptEnum($n) { ".p" }
        CgHandle { ".p" }
        CgChan($el) { ".p" }
        _ { ".i" }
    }
}

sub g6e_field_ctype($kind: CgKind): Str {
    match $kind {
        CgStr { "const char*" }
        CgFloat { "double" }
        CgList($el) { "guji_slice_t" }
        CgMap($v) { "guji_map_t" }
        CgBoxEnum($n) { $n ~ "*" }
        CgBoxClass($n) { "struct " ~ $n ~ "*" }
        CgBoxOptClass($n) { "struct guji_opt_" ~ $n ~ "*" }
        CgBoxOptEnum($n) { "struct guji_opt_" ~ $n ~ "*" }
        CgOptInt { g6_option_ctype(CgOptInt) }
        CgOptFloat { g6_option_ctype(CgOptFloat) }
        CgOptBool { g6_option_ctype(CgOptBool) }
        CgOptStr { g6_option_ctype(CgOptStr) }
        # An Option[<class>] field is stored as the per-class `guji_opt_<Class>`
        # carrier (E5d-7c-2d-5), emitted right after the wrapped class's typedef.
        CgOptClass($n) { g6_option_ctype(CgOptClass($n)) }
        # An Option[<enum>] field is stored as the per-enum `guji_opt_<Enum>` carrier
        # (E5d-7c-2d-7), emitted right after the wrapped enum's typedef.
        CgOptEnum($n) { g6_option_ctype(CgOptEnum($n)) }
        CgRes($ok, $err) { g6_result_ctype($kind) }
        CgHandle { "guji_reader_t*" }
        CgChan($el) { "guji_chan_t*" }
        # A nested enum field is stored BY VALUE: the C struct member is the child
        # enum's own struct (typedef'd under its bare name). Declaration order
        # guarantees the child's typedef precedes this struct (g6e_enum_typedefs
        # walks decls in source order, and the generator declares the inner enum
        # first), so the by-value member has a complete type.
        CgEnum($n) { $n }
        # A nested class field is stored BY VALUE: the member is the child class's
        # own struct (typedef'd under its bare name). The child class is declared
        # before this one in source order (g8_class_typedefs walks decls in order;
        # the generator declares the inner class first), so the member type is
        # complete. A SAME-class field would be incomplete and is declined upstream
        # in g8_class_field_kind (heap-boxing is E4b-2c-box).
        CgClass($n) { $n }
        _ { "int64_t" }
    }
}

sub g6e_enum_fields_c($vs: CgVariantInfoList, $idx: Int, $owner: Str, $all: DeclList): Result[Str, Str] {
    match g6e_classify_position($vs, $idx) {
        Err($m) { Err($m) }
        Ok($cls) {
            match $cls {
                PosAbsent { Ok("") }
                PosScalar($k) {
                    match g6e_enum_fields_c($vs, $idx + 1, $owner, $all) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok("\t" ~ g6e_stored_field_ctype($vs, $idx, $k, $owner, $all) ~ " f" ~ c_int($idx) ~ ";\n" ~ $rest) }
                    }
                }
                PosUnion {
                    match g6e_enum_fields_c($vs, $idx + 1, $owner, $all) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok("\t" ~ g6e_union_member_decl() ~ " f" ~ c_int($idx) ~ ";\n" ~ $rest) }
                    }
                }
            }
        }
    }
}

sub g6e_rc_field_c($allvars: CgVariantInfoList, $idx: Int, $fk: CgKind, $op: Str, $owner: Str, $all: DeclList): Str {
    match $fk {
        CgStr {
            $field = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".s" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "(" ~ $field ~ ");\n"
        }
        CgList($el) {
            # A `List` field is a by-value `guji_slice_t` handle; its heap is the
            # `.data` arr block (RFC-003 by-value handle), so retain/release keys on
            # `.data`. A union-slot list reads its `.l` member first.
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".l" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ".data);\n"
        }
        CgMap($v) {
            # A `Map` field is a by-value `guji_map_t` handle with TWO heap arrays
            # (`.keys` ARR_STR + `.vals`); both are retained/released. A union-slot
            # map reads its `.m` member first.
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".m" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ".keys);\n\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ".vals);\n"
        }
        CgEnum($n) {
            if g6e_pos_is_union($allvars, $idx) {
                # A nested enum in a mixed enum slot is stored as a counted heap box
                # in the union's `.p` member (E5d-8h-3c). Retain/release the box; the
                # generated enum drop helper recurses into its fields at rc==0.
                "\t\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($idx) ~ ".p);\n"
            } else {
                # A homogeneous nested enum field is embedded BY VALUE, so retain/
                # release recurses transitively into the child enum's own fields.
                "\t\tguji_" ~ $op ~ "_" ~ $n ~ "_fields(&p->f" ~ c_int($idx) ~ ");\n"
            }
        }
        CgClass($n) {
            if g6e_pos_is_union($allvars, $idx) {
                # A class in a mixed enum slot is stored as a counted heap box in the
                # union's `.p` member (E5d-8h-3 class slice). Retain/release the box;
                # its generated drop helper recurses into the class fields at rc==0.
                "\t\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($idx) ~ ".p);\n"
            } else {
                # A homogeneous class position stays the existing by-value member and
                # recurses retain/release into the class's own fields helper.
                "\t\tguji_" ~ $op ~ "_" ~ $n ~ "_fields(&p->f" ~ c_int($idx) ~ ");\n"
            }
        }
        CgBoxEnum($n) {
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
        }
        CgBoxClass($n) {
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
        }
        CgBoxOptClass($n) {
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
        }
        CgBoxOptEnum($n) {
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
        }
        CgOptClass($n) {
            if g6e_field_carrier_boxed($allvars, $idx, $fk, $owner, $all) {
                # An Option[<class>] carrier in a mixed enum slot, or an EB-1c
                # cyclic homogeneous slot, is stored as a counted heap box. Retain/
                # release the box; its generated `guji_drop_opt_<Class>` helper
                # tag-guards the recurse into the wrapped class's fields at rc==0.
                $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
                "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
            } else {
                # A NON-union (PosScalar) Option[<class>] field (E5d-8k) is by value;
                # retain/release its active Some payload by tag-guarded recursion into
                # the wrapped class's fields helper (a None slot, tag 0, is skipped).
                "\t\tif (p->f" ~ c_int($idx) ~ ".tag != 0LL) \{ guji_" ~ $op ~ "_" ~ $n ~ "_fields(&p->f" ~ c_int($idx) ~ ".val); }\n"
            }
        }
        CgOptEnum($n) {
            if g6e_field_carrier_boxed($allvars, $idx, $fk, $owner, $all) {
                # An Option[<enum>] carrier in a mixed enum slot, or an EB-1c cyclic
                # homogeneous slot, is stored as a counted heap box; retain/release
                # the box (drop helper handles the payload at rc==0).
                $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
                "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
            } else {
                # A NON-union (PosScalar) Option[<enum>] field retain/releases its
                # active Some payload by tag-guarded recursion into the wrapped enum's
                # fields helper (a None slot, tag 0, is skipped).
                "\t\tif (p->f" ~ c_int($idx) ~ ".tag != 0LL) \{ guji_" ~ $op ~ "_" ~ $n ~ "_fields(&p->f" ~ c_int($idx) ~ ".val); }\n"
            }
        }
        CgHandle {
            # Handles are ordinary counted runtime objects. Enum copies retain
            # the active handle and the final enum drop releases/closes it.
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_" ~ $op ~ "((const void*)" ~ $base ~ ");\n"
        }
        CgChan($el) {
            # Channels use the scheduler-owned atomic refcount rather than the
            # ordinary guji heap header. Value copies retain the handle; dropping
            # the active variant releases it and any queued Str messages.
            $base = if g6e_pos_is_union($allvars, $idx) { "p->f" ~ c_int($idx) ~ ".p" } else { "p->f" ~ c_int($idx) }
            "\t\tguji_chan_" ~ $op ~ "((guji_chan_t*)" ~ $base ~ ");\n"
        }
        _ { "" }
    }
}

sub g6e_rc_fields_c($allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int, $op: Str, $owner: Str, $all: DeclList): Str {
    match $fields {
        CgKindNil { "" }
        CgKindCons($fk, $rest) {
            g6e_rc_field_c($allvars, $idx, $fk, $op, $owner, $all) ~ g6e_rc_fields_c($allvars, $rest, $idx + 1, $op, $owner, $all)
        }
    }
}

sub g6e_rc_fields_except_c($allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int, $skip: Int, $op: Str, $owner: Str, $all: DeclList): Str {
    match $fields {
        CgKindNil { "" }
        CgKindCons($fk, $rest) {
            $one = if $idx == $skip { "" } else { g6e_rc_field_c($allvars, $idx, $fk, $op, $owner, $all) }
            $one ~ g6e_rc_fields_except_c($allvars, $rest, $idx + 1, $skip, $op, $owner, $all)
        }
    }
}

sub g6e_rc_cases_c($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int, $op: Str, $owner: Str, $all: DeclList): Str {
    match $todo {
        CgVarNil { "" }
        CgVarCons($v, $rest) {
            "\tcase " ~ c_int($tag) ~ "LL: \{\n" ~
            g6e_rc_fields_c($allvars, $v.fields, 0, $op, $owner, $all) ~
            "\t\tbreak;\n" ~
            "\t}\n" ~
            g6e_rc_cases_c($allvars, $rest, $tag + 1, $op, $owner, $all)
        }
    }
}

sub g6e_self_box_idx($fields: CgKindList, $owner: Str, $idx: Int): Int {
    match $fields {
        CgKindNil { -1 }
        CgKindCons($fk, $rest) {
            $here = match $fk {
                CgBoxEnum($n) { $n == $owner }
                _ { false }
            }
            if $here { $idx } else { g6e_self_box_idx($rest, $owner, $idx + 1) }
        }
    }
}

sub g6e_variants_have_self_box($todo: CgVariantInfoList, $owner: Str): Bool {
    match $todo {
        CgVarNil { false }
        CgVarCons($v, $rest) {
            if g6e_self_box_idx($v.fields, $owner, 0) >= 0 { true } else { g6e_variants_have_self_box($rest, $owner) }
        }
    }
}

sub g6e_self_box_access_c($allvars: CgVariantInfoList, $idx: Int): Str {
    if g6e_pos_is_union($allvars, $idx) {
        "p->f" ~ c_int($idx) ~ ".p"
    } else {
        "p->f" ~ c_int($idx)
    }
}

sub g6e_iter_drop_cases_c($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int, $owner: Str, $all: DeclList): Str {
    match $todo {
        CgVarNil { "" }
        CgVarCons($v, $rest) {
            $self_idx = g6e_self_box_idx($v.fields, $owner, 0)
            $case = if $self_idx >= 0 {
                $next = g6e_self_box_access_c($allvars, $self_idx)
                "\t\tcase " ~ c_int($tag) ~ "LL: \{\n" ~
                "\t\t\tconst " ~ $owner ~ "* p = cur;\n" ~
                "\t\t\t" ~ $owner ~ "* next = (" ~ $owner ~ "*)" ~ $next ~ ";\n" ~
                g6e_rc_fields_except_c($allvars, $v.fields, 0, $self_idx, "release", $owner, $all) ~
                "\t\t\tif (next && GUJI_HDR(next)->rc == 1) \{\n" ~
                "\t\t\t\tfree(GUJI_HDR(cur));\n" ~
                "\t\t\t\tcur = next;\n" ~
                "\t\t\t\tcontinue;\n" ~
                "\t\t\t}\n" ~
                "\t\t\tfree(GUJI_HDR(cur));\n" ~
                "\t\t\tguji_release((const void*)next);\n" ~
                "\t\t\treturn;\n" ~
                "\t\t}\n"
            } else {
                "\t\tcase " ~ c_int($tag) ~ "LL: \{\n" ~
                "\t\t\tconst " ~ $owner ~ "* p = cur;\n" ~
                g6e_rc_fields_c($allvars, $v.fields, 0, "release", $owner, $all) ~
                "\t\t\tfree(GUJI_HDR(cur));\n" ~
                "\t\t\treturn;\n" ~
                "\t\t}\n"
            }
            $case ~ g6e_iter_drop_cases_c($allvars, $rest, $tag + 1, $owner, $all)
        }
    }
}

sub g6e_variants_have_box($vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { false }
        CgVarCons($h, $t) { if g6e_fields_have_box($h.fields) { true } else { g6e_variants_have_box($t) } }
    }
}

sub g6e_fields_have_box($fs: CgKindList): Bool {
    match $fs {
        CgKindNil { false }
        CgKindCons($h, $t) { if g6e_kind_is_boxed_enum($h) { true } else { g6e_fields_have_box($t) } }
    }
}

# True iff some enum variant field boxes `<name>`: either a by-value `CgEnum(<name>)`
# at a MIXED union position (homogeneous nested enum fields stay embedded by value;
# mixed positions need a counted `<name>*` box in `.p`, E5d-8h-3c), or an ALREADY-boxed
# `CgBoxEnum(<name>)` edge — the EB-1a cross-cycle box g6e_field_kind produces when an
# EARLIER enum's field names `<name>` and `<name>` reaches back by value (the exact enum
# analogue of the CgBoxClass arm in g6e_fields_need_class_box). SC 2026-07-01: the
# CgBoxEnum arm was MISSING, so a cross-enum box edge (CgKind.CgFn boxing CgRet in the
# compiler's own source) emitted `guji_alloc(GUJI_KIND_<name>, ...)` with no matching
# `#define`/helpers/drop-table slot and cc rejected the C — self-compilation broke.
sub g6e_fields_need_enum_box($allvars: CgVariantInfoList, $fs: CgKindList, $idx: Int, $name: Str): Bool {
    match $fs {
        CgKindNil { false }
        CgKindCons($h, $t) {
            $here = match $h {
                CgEnum($n) { $n == $name && g6e_pos_is_union($allvars, $idx) }
                CgBoxEnum($n) { $n == $name }
                _ { false }
            }
            if $here { true } else { g6e_fields_need_enum_box($allvars, $t, $idx + 1, $name) }
        }
    }
}

sub g6e_variants_need_enum_box($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $name: Str): Bool {
    match $todo {
        CgVarNil { false }
        CgVarCons($v, $rest) {
            if g6e_fields_need_enum_box($allvars, $v.fields, 0, $name) {
                true
            } else {
                g6e_variants_need_enum_box($allvars, $rest, $name)
            }
        }
    }
}

sub g6e_decl_needs_mixed_enum_box($decls: DeclList, $name: Str, $all: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    $info = g6e_variants_of($e.variants, $e.name, $all)
                    if g6e_variants_need_enum_box($info, $info, $name) {
                        true
                    } else {
                        g6e_decl_needs_mixed_enum_box($tail, $name, $all)
                    }
                }
                _ { g6e_decl_needs_mixed_enum_box($tail, $name, $all) }
            }
        }
    }
}

# EB-1b: a class-field cross-cycle box (`struct <T>*` in a class struct, made by
# g8_class_field_kind) makes the WRAPPED type `<T>` need its runtime kind + drop
# helper, exactly like an enum-variant box does. These walk every user CLASS, recompute
# its field kinds (g8_class_fields_of — pure, terminating), and report whether any field
# boxes `<name>` as a CgBoxEnum (when $isenum) or CgBoxClass. Keyed on the wrapped type
# so the kind/define/drop-entry emit exactly once and IN LOCKSTEP: kind numbering
# (g_type_next_kind), the typedef box-define, and the drop table all route through the
# g6e_decl_needs_*_box predicates below, so OR-ing this in keeps all three aligned.
sub g8_classfield_boxes_kind($k: CgKind, $name: Str, $isenum: Bool): Bool {
    match $k {
        CgBoxEnum($n) { $isenum && $n == $name }
        CgBoxClass($n) { (!$isenum) && $n == $name }
        _ { false }
    }
}

sub g8_classfields_box($fs: CgClassFieldInfoList, $name: Str, $isenum: Bool): Bool {
    match $fs {
        CgClassFieldNil { false }
        CgClassFieldCons($h, $t) {
            if g8_classfield_boxes_kind($h.kind, $name, $isenum) { true } else { g8_classfields_box($t, $name, $isenum) }
        }
    }
}

sub g8_classfield_boxes_carrier($f: CgClassField, $name: Str): Bool {
    if $f.boxcarrier {
        match $f.kind {
            CgOptClass($n) { $n == $name }
            CgOptEnum($n) { $n == $name }
            _ { false }
        }
    } else {
        false
    }
}

sub g8_classfields_carrier_box($fs: CgClassFieldInfoList, $name: Str): Bool {
    match $fs {
        CgClassFieldNil { false }
        CgClassFieldCons($h, $t) {
            if g8_classfield_boxes_carrier($h, $name) { true } else { g8_classfields_carrier_box($t, $name) }
        }
    }
}

sub g8_decl_classfield_boxes($decls: DeclList, $all: DeclList, $name: Str, $isenum: Bool): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DClass($c) {
                    $here = match $c.tparams {
                        StrNil {
                            match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                                Ok($fields) { g8_classfields_box($fields, $name, $isenum) }
                                Err($m) { false }
                            }
                        }
                        _ { false }
                    }
                    if $here { true } else { g8_decl_classfield_boxes($tail, $all, $name, $isenum) }
                }
                _ { g8_decl_classfield_boxes($tail, $all, $name, $isenum) }
            }
        }
    }
}

sub g8_decl_classfield_carrier_boxes($decls: DeclList, $all: DeclList, $name: Str): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DClass($c) {
                    $here = match $c.tparams {
                        StrNil {
                            match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                                Ok($fields) { g8_classfields_carrier_box($fields, $name) }
                                Err($m) { false }
                            }
                        }
                        _ { false }
                    }
                    if $here { true } else { g8_decl_classfield_carrier_boxes($tail, $all, $name) }
                }
                _ { g8_decl_classfield_carrier_boxes($tail, $all, $name) }
            }
        }
    }
}


sub g6e_decl_needs_enum_box($name: Str, $info: CgVariantInfoList, $all: DeclList): Bool {
    if g6e_variants_have_box($info) { true }
    else if g6e_decl_needs_mixed_enum_box($all, $name, $all) { true }
    else { g8_decl_classfield_boxes($all, $all, $name, true) }
}

sub g6e_fields_need_class_box($allvars: CgVariantInfoList, $fs: CgKindList, $idx: Int, $name: Str): Bool {
    match $fs {
        CgKindNil { false }
        CgKindCons($h, $t) {
            $here = match $h {
                CgClass($n) { $n == $name && g6e_pos_is_union($allvars, $idx) }
                CgBoxClass($n) { $n == $name }
                _ { false }
            }
            if $here { true } else { g6e_fields_need_class_box($allvars, $t, $idx + 1, $name) }
        }
    }
}

sub g6e_variants_need_class_box($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $name: Str): Bool {
    match $todo {
        CgVarNil { false }
        CgVarCons($v, $rest) {
            if g6e_fields_need_class_box($allvars, $v.fields, 0, $name) {
                true
            } else {
                g6e_variants_need_class_box($allvars, $rest, $name)
            }
        }
    }
}

sub g6e_decl_needs_class_box($decls: DeclList, $name: Str, $all: DeclList): Bool {
    match $decls {
        # Reached once after the enum walk below exhausts $decls. EB-1b: also OR in
        # whether some CLASS field boxes `<name>` as a CgBoxClass (the class analogue
        # of the enum-variant class box this predicate already detects), so the wrapped
        # class emits its kind + drop helper in lockstep.
        DeclNil { g8_decl_classfield_boxes($all, $all, $name, false) }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    $info = g6e_variants_of($e.variants, $e.name, $all)
                    if g6e_variants_need_class_box($info, $info, $name) {
                        true
                    } else {
                        g6e_decl_needs_class_box($tail, $name, $all)
                    }
                }
                _ { g6e_decl_needs_class_box($tail, $name, $all) }
            }
        }
    }
}

# True iff some enum variant field at a MIXED union position is an
# `Option[<name>]` carrier (class or enum element). Such a carrier is heap-boxed
# into the union's `.p` member (E5d-8h-3b), which requires a generated
# `GUJI_KIND_opt_<name>` runtime kind + `guji_drop_opt_<name>` drop helper. The
# carrier C type `guji_opt_<name>` is identical whether <name> is a class or enum,
# so a single box layout serves both; we key the box on the WRAPPED type's decl
# (mirroring g6e_decl_needs_class_box) so it is emitted exactly once.
sub g6e_fields_need_carrier_box($allvars: CgVariantInfoList, $fs: CgKindList, $idx: Int, $owner: Str, $name: Str, $all: DeclList): Bool {
    match $fs {
        CgKindNil { false }
        CgKindCons($h, $t) {
            $here = match $h {
                CgOptClass($n) { $n == $name && (g6e_pos_is_union($allvars, $idx) || g6e_option_carrier_needs_box($owner, $h, $all)) }
                CgOptEnum($n) { $n == $name && (g6e_pos_is_union($allvars, $idx) || g6e_option_carrier_needs_box($owner, $h, $all)) }
                CgBoxOptClass($n) { $n == $name }
                CgBoxOptEnum($n) { $n == $name }
                _ { false }
            }
            if $here { true } else { g6e_fields_need_carrier_box($allvars, $t, $idx + 1, $owner, $name, $all) }
        }
    }
}

sub g6e_variants_need_carrier_box($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $owner: Str, $name: Str, $all: DeclList): Bool {
    match $todo {
        CgVarNil { false }
        CgVarCons($v, $rest) {
            if g6e_fields_need_carrier_box($allvars, $v.fields, 0, $owner, $name, $all) {
                true
            } else {
                g6e_variants_need_carrier_box($allvars, $rest, $owner, $name, $all)
            }
        }
    }
}

sub g6e_decl_needs_carrier_box($decls: DeclList, $name: Str, $all: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    $info = g6e_variants_of($e.variants, $e.name, $all)
                    if g6e_variants_need_carrier_box($info, $info, $e.name, $name, $all) {
                        true
                    } else {
                        g6e_decl_needs_carrier_box($tail, $name, $all)
                    }
                }
                DClass($c) {
                    if g8_decl_classfield_carrier_boxes(DeclCons($head, DeclNil), $all, $name) {
                        true
                    } else {
                        g6e_decl_needs_carrier_box($tail, $name, $all)
                    }
                }
                _ { g6e_decl_needs_carrier_box($tail, $name, $all) }
            }
        }
    }
}

sub g6e_enum_drop_body($ename: Str, $vs: CgVariantInfoList, $all: DeclList): Str {
    if g6e_variants_have_self_box($vs, $ename) {
        "static void guji_drop_" ~ $ename ~ "(void* p) \{\n" ~
        "\t" ~ $ename ~ "* cur = (" ~ $ename ~ "*)p;\n" ~
        "\twhile (cur) \{\n" ~
        "\t\tswitch (cur->tag) \{\n" ~
        g6e_iter_drop_cases_c($vs, $vs, 0, $ename, $all) ~
        "\t\tdefault: \{\n" ~
        "\t\t\tfree(GUJI_HDR(cur));\n" ~
        "\t\t\treturn;\n" ~
        "\t\t}\n" ~
        "\t\t}\n" ~
        "\t}\n" ~
        "}\n\n"
    } else {
        "static void guji_drop_" ~ $ename ~ "(void* p) \{\n" ~
        "\tguji_release_" ~ $ename ~ "_fields((" ~ $ename ~ "*)p);\n" ~
        "\tfree(GUJI_HDR(p));\n" ~
        "}\n\n"
    }
}

# Pointer lvalue for a CgBoxEnum field of local `out` (homogeneous `out.fN` or
# union `out.fN.p`). Used by the deep clone switch — do NOT use
# g6e_field_accessor here; that dereferences the box to a by-value Tree.
sub g6e_clone_box_ptr($allvars: CgVariantInfoList, $idx: Int): Str {
    if g6e_pos_is_union($allvars, $idx) {
        "out.f" ~ c_int($idx) ~ ".p"
    } else {
        "out.f" ~ c_int($idx)
    }
}

# After `out = *src`, replace every active counted/boxed field with a detached
# copy so the clone shares no sender-heap storage. Every enum box calls the
# wrapped enum's clone helper. Those pointer-returning helpers are declared for
# all boxed enum types before any struct definition, so a mutually-recursive
# Kind/Ret graph can cross a later typedef without sharing its non-atomic RC
# nodes. A homogeneous nested enum is cloned by value; a mixed-position nested
# enum is itself stored in a counted box and therefore uses the box helper.
# List/Map use KIND-tagged guji_copy_arr (flat and nested).
sub g6e_clone_detach_one_fields($allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int, $ename: Str): Str {
    match $fields {
        CgKindNil { "" }
        CgKindCons($fk, $rest) {
            $one = match $fk {
                CgStr {
                    $acc = g6e_field_accessor($allvars, "out", $idx, CgStr)
                    "\t\t" ~ $acc ~ " = guji_str_copy(" ~ $acc ~ ");\n"
                }
                CgList($el) {
                    $acc = g6e_field_accessor($allvars, "out", $idx, CgList($el))
                    "\t\t" ~ $acc ~ ".data = guji_copy_arr((const void*)" ~ $acc ~ ".data);\n"
                }
                CgMap($v) {
                    $acc = g6e_field_accessor($allvars, "out", $idx, CgMap($v))
                    "\t\t" ~ $acc ~ ".keys = (const char**)guji_copy_arr((const void*)" ~ $acc ~ ".keys);\n" ~
                    "\t\t" ~ $acc ~ ".vals = guji_copy_arr((const void*)" ~ $acc ~ ".vals);\n"
                }
                CgBoxEnum($n) {
                    $ptr = g6e_clone_box_ptr($allvars, $idx)
                    "\t\t" ~ $ptr ~ " = guji_clone_" ~ $n ~ "_box((const " ~ $n ~ "*)" ~ $ptr ~ ");\n"
                }
                CgEnum($n) {
                    if g6e_pos_is_union($allvars, $idx) {
                        $ptr = g6e_clone_box_ptr($allvars, $idx)
                        "\t\t" ~ $ptr ~ " = guji_clone_" ~ $n ~ "_box((const " ~ $n ~ "*)" ~ $ptr ~ ");\n"
                    } else {
                        $acc = g6e_field_accessor($allvars, "out", $idx, CgEnum($n))
                        "\t\t" ~ $acc ~ " = guji_clone_" ~ $n ~ "_value(&(" ~ $acc ~ "));\n"
                    }
                }
                _ { "" }
            }
            $one ~ g6e_clone_detach_one_fields($allvars, $rest, $idx + 1, $ename)
        }
    }
}

sub g6e_clone_detach_fields_nonempty($fields: CgKindList, $ename: Str): Bool {
    match $fields {
        CgKindNil { false }
        CgKindCons($fk, $rest) {
            $here = match $fk {
                CgStr { true }
                CgList($el) { true }
                CgMap($v) { true }
                CgBoxEnum($n) { true }
                CgEnum($n) { true }
                _ { false }
            }
            if $here { true } else { g6e_clone_detach_fields_nonempty($rest, $ename) }
        }
    }
}

sub g6e_clone_detach_cases($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int, $ename: Str): Str {
    match $todo {
        CgVarNil { "" }
        CgVarCons($v, $rest) {
            $case = if g6e_clone_detach_fields_nonempty($v.fields, $ename) {
                "\tcase " ~ c_int($tag) ~ "LL: \{\n" ~
                g6e_clone_detach_one_fields($allvars, $v.fields, 0, $ename) ~
                "\t\tbreak;\n\t}\n"
            } else {
                ""
            }
            $case ~ g6e_clone_detach_cases($allvars, $rest, $tag + 1, $ename)
        }
    }
}

sub g6e_enum_clone_value_helper($ename: Str, $vs: CgVariantInfoList): Str {
    "static " ~ $ename ~ " guji_clone_" ~ $ename ~ "_value(const " ~ $ename ~ "* src) \{\n" ~
    "\t" ~ $ename ~ " out = *src;\n" ~
    "\tswitch (out.tag) \{\n" ~
    g6e_clone_detach_cases($vs, $vs, 0, $ename) ~
    "\t}\n" ~
    "\treturn out;\n" ~
    "}\n\n"
}

sub g6e_enum_box_helpers($ename: Str, $vs: CgVariantInfoList, $all: DeclList): Str {
    "static void guji_drop_" ~ $ename ~ "(void* p);\n\n" ~
    "static " ~ $ename ~ "* guji_clone_" ~ $ename ~ "_box(const " ~ $ename ~ "* src) \{\n" ~
    "\tif (!src) \{ return NULL; }\n" ~
    "\t" ~ $ename ~ "* out = (" ~ $ename ~ "*)guji_alloc(GUJI_KIND_" ~ $ename ~ ", 0, sizeof(" ~ $ename ~ "));\n" ~
    "\t*out = guji_clone_" ~ $ename ~ "_value(src);\n" ~
    "\treturn out;\n" ~
    "}\n\n" ~
    g6e_enum_drop_body($ename, $vs, $all)
}

sub g6e_enum_rc_helpers($ename: Str, $vs: CgVariantInfoList, $all: DeclList): Str {
    $box_helpers = if g6e_decl_needs_enum_box($ename, $vs, $all) { g6e_enum_box_helpers($ename, $vs, $all) } else { "" }
    "static void guji_release_" ~ $ename ~ "_fields(const " ~ $ename ~ "* p);\n" ~
    "static void guji_retain_" ~ $ename ~ "_fields(const " ~ $ename ~ "* p);\n\n" ~
    "static void guji_release_" ~ $ename ~ "_fields(const " ~ $ename ~ "* p) \{\n" ~
    "\tswitch (p->tag) \{\n" ~
    g6e_rc_cases_c($vs, $vs, 0, "release", $ename, $all) ~
    "\t}\n" ~
    "}\n\n" ~
    "static void guji_retain_" ~ $ename ~ "_fields(const " ~ $ename ~ "* p) \{\n" ~
    "\tswitch (p->tag) \{\n" ~
    g6e_rc_cases_c($vs, $vs, 0, "retain", $ename, $all) ~
    "\t}\n" ~
    "}\n\n" ~
    g6e_enum_clone_value_helper($ename, $vs) ~
    $box_helpers
}

sub g6e_enum_box_define($ename: Str, $kind: Int, $info: CgVariantInfoList, $all: DeclList): Str {
    if g6e_decl_needs_enum_box($ename, $info, $all) { "#define GUJI_KIND_" ~ $ename ~ " " ~ c_int($kind) ~ "\n" } else { "" }
}

# Every concrete user enum/class can be stored by value in a List. Its array kind
# needs a program-specific drop callback because a row may transitively own Str,
# List, Map, Option, or nested-record fields. Scalar-only records use the same
# callback shape; their generated field-release helper is simply a no-op.
sub g_type_arr_define($name: Str, $kind: Int): Str {
    "#define GUJI_KIND_" ~ $name ~ "_ARR " ~ c_int($kind) ~ "\n"
}

sub g_type_arr_helper($name: Str): Str {
    "static void guji_drop_arr_" ~ $name ~ "(void* p) \{\n" ~
    "\t" ~ $name ~ "* a = (" ~ $name ~ "*)p;\n" ~
    "\tint64_t n = GUJI_HDR(p)->count;\n" ~
    "\tfor (int64_t i = 0; i < n; i++) \{ guji_release_" ~ $name ~ "_fields(&a[i]); }\n" ~
    "\tfree(GUJI_HDR(p));\n" ~
    "}\n\n"
}

# The per-enum `Option[<Enum>]` carrier typedef (E5d-7c-2d-7): a tagged struct
# embedding the enum BY VALUE, tag 1 = Some, 0 = None. Emitted right after the
# wrapped enum's own typedef + rc helpers so the by-value member type is complete and
# the name precedes any later enum/class that uses `Option[<Enum>]` as a field (the
# same source-order guarantee by-value nested enum fields already rely on). The enum
# is a fixed-size struct (recursion is via boxed pointers), so the by-value member is
# sound. Emitted for every enum (like g8_class_option_typedef for classes); an unused
# carrier is a harmless extra C typedef.
sub g6e_enum_option_typedef($name: Str): Str {
    "typedef struct guji_opt_" ~ $name ~ " \{\n\tint64_t tag;\n\t" ~ $name ~ " val;\n} guji_opt_" ~ $name ~ ";\n\n"
}

# Counted enum messages stored in a channel own their detached payload fields.
# The runtime calls this wrapper for an undelivered buffered message or a send
# rejected after close. Scalar-only enums keep the channel's NULL drop hook.
sub g6e_enum_chan_drop($name: Str, $info: CgEnumInfo): Str {
    if g6e_enum_has_heap($info) {
        "static void guji_chan_drop_" ~ $name ~ "(void* slot) \{\n" ~
        "\t" ~ $name ~ " v = *(" ~ $name ~ "*)slot;\n" ~
        "\tguji_release_" ~ $name ~ "_fields(&v);\n" ~
        "}\n\n"
    } else {
        ""
    }
}

sub g6e_enum_typedef_one($e: EnumDecl, $kind: Int, $all: DeclList): Result[Str, Str] {
    match $e.tparams {
        StrNil {
            $info = g6e_variants_of($e.variants, $e.name, $all)
            match g6e_enum_fields_c($info, 0, $e.name, $all) {
                Err($m) { Err($m) }
                Ok($fields) {
                    $needs_box = g6e_decl_needs_enum_box($e.name, $info, $all)
                    $box_kind = $kind + 1
                    $ckind = g_carrier_box_kind($box_kind, $needs_box)
                    Ok(g_type_arr_define($e.name, $kind) ~ g6e_enum_box_define($e.name, $box_kind, $info, $all) ~ "typedef struct " ~ $e.name ~ " " ~ $e.name ~ ";\nstruct " ~ $e.name ~ " \{\n\tint64_t tag;\n" ~ $fields ~ "};\n\n" ~ g6e_enum_rc_helpers($e.name, $info, $all) ~ g_type_arr_helper($e.name) ~ g6e_enum_chan_drop($e.name, CgEnumInfo(name: $e.name, variants: $info)) ~ g6e_enum_option_typedef($e.name) ~ g_carrier_box_define($e.name, $ckind, $all) ~ g_carrier_box_helpers($e.name, $all))
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6e_next_box_kind($name: Str, $info: CgVariantInfoList, $all: DeclList, $kind: Int): Int {
    if g6e_decl_needs_enum_box($name, $info, $all) { $kind + 1 } else { $kind }
}

# Advance the runtime kind counter past every box a decl emits in source order: an
# enum's value box (recursive self-box or mixed-slot nested-enum box) then its
# Option-carrier box; a class's class-box then its Option-carrier box. The carrier
# box is keyed on the wrapped type's decl, so each carrier layout consumes exactly
# one kind and the count here stays in lockstep with the typedef defines
# (g_carrier_box_kind) and drop-table entries (g6e_enum_drop_entries).
sub g_carrier_next_kind($name: Str, $all: DeclList, $kind: Int): Int {
    if g6e_decl_needs_carrier_box($all, $name, $all) { $kind + 1 } else { $kind }
}

sub g_type_next_kind($decl: Decl, $all: DeclList, $kind: Int): Int {
    match $decl {
        DEnum($e) {
            $info = g6e_variants_of($e.variants, $e.name, $all)
            $after_arr = $kind + 1
            g_carrier_next_kind($e.name, $all, g6e_next_box_kind($e.name, $info, $all, $after_arr))
        }
        DClass($c) {
            $after_arr = $kind + 1
            $after_class = if g6e_decl_needs_class_box($all, $c.name, $all) { $after_arr + 1 } else { $after_arr }
            g_carrier_next_kind($c.name, $all, $after_class)
        }
        _ { $kind }
    }
}

# Emit the program-specific user-type typedefs (enums AND classes) in a SINGLE
# SOURCE-ORDER walk. A by-value member needs its referenced type COMPLETE, so the
# emission order must place each embedded type before the type that embeds it. The
# subset already relies on "the source declares a by-value dependency first" for
# nested enum-in-enum and class-in-class; interleaving enums and classes in source
# order extends that same contract to enum-in-class (E4b-2a) AND class-in-enum
# (E5d-8h), where the old "all enums, then all classes" emission left a class member
# embedded in an enum struct INCOMPLETE. Counted kind numbers advance for recursive
# enum boxes and for classes that are heap-boxed into mixed enum union slots.
sub g_type_typedefs_from($decls: DeclList, $all: DeclList, $kind: Int): Result[Str, Str] {
    match $decls {
        DeclNil { Ok("") }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    match $e.tparams {
                        StrNil {
                            match g6e_enum_typedef_one($e, $kind, $all) {
                                Err($m) { Err($m) }
                                Ok($one) {
                                    match g_type_typedefs_from($tail, $all, g_type_next_kind($head, $all, $kind)) {
                                        Err($m) { Err($m) }
                                        Ok($rest) { Ok($one ~ $rest) }
                                    }
                                }
                            }
                        }
                        _ { g_type_typedefs_from($tail, $all, $kind) }
                    }
                }
                DClass($c) {
                    match $c.tparams {
                        StrNil {
                            match g8_class_typedef_one($c, $all, $kind) {
                                Err($m) { Err($m) }
                                Ok($one) {
                                    match g_type_typedefs_from($tail, $all, g_type_next_kind($head, $all, $kind)) {
                                        Err($m) { Err($m) }
                                        Ok($rest) { Ok($one ~ $rest) }
                                    }
                                }
                            }
                        }
                        _ { g_type_typedefs_from($tail, $all, $kind) }
                    }
                }
                _ {
                    match g_type_typedefs_from($tail, $all, $kind) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok($rest) }
                    }
                }
            }
        }
    }
}

# ---- EB-2: typedef TOPOLOGICAL ordering ------------------------------------
# A by-value member (a nested enum/class struct embedded directly, or an
# `Option[<user>]` carrier embedded by value) needs its referenced type's typedef
# + struct definition COMPLETE before the struct that embeds it. The subset
# historically relied on "the source declares a by-value dependency first", but the
# real compiler source violates it (e.g. an enum that embeds a class declared
# LATER). EB-1 already broke every by-value CYCLE by boxing one edge (a
# `struct <T>*` pointer, which C resolves from the struct TAG regardless of order),
# so the remaining by-value edges form a DAG. EB-2 emits the type typedefs (and, in
# lockstep, the drop-table entries) in a TOPOLOGICAL order of that DAG so every
# by-value member's type is complete first.
#
# CRITICAL -- kind/drop lockstep: GUJI_KIND_<T> ids are assigned POSITIONALLY by the
# typedef walk (g_type_typedefs_from threads `$kind`), and the runtime drop table is
# indexed by that same id. Both g_type_typedefs and the drop-table emitter
# (g6e_enum_drop_entries) are therefore fed the IDENTICAL reordered decl list
# (g_topo_decls), so a type's kind id still equals the position of its drop entry --
# only the (opaque) numbering changes, never the alignment.

# The by-value type-dependency a field of kind $k embeds, or "" for none. A boxed
# field ($boxed=true: a counted pointer box or a boxed Option carrier) is a pointer
# and embeds no type by value; scalars/List/Map store generic handles.
sub g_byval_dep_kind($k: CgKind, $boxed: Bool): Str {
    if $boxed {
        ""
    } else {
        match $k {
            CgEnum($n) { $n }
            CgClass($n) { $n }
            CgOptEnum($n) { $n }
            CgOptClass($n) { $n }
            _ { "" }
        }
    }
}

# Collect a class's by-value type dependencies (each field that embeds another user
# type by value). `boxcarrier` marks an Option carrier stored as a pointer (EB-1c),
# which is NOT a by-value dependency.
sub g_class_byval_deps($fs: CgClassFieldInfoList, $acc: StrList): StrList {
    match $fs {
        CgClassFieldNil { $acc }
        CgClassFieldCons($f, $rest) {
            $dep = g_byval_dep_kind($f.kind, $f.boxcarrier)
            $acc2 = if $dep == "" { $acc } else { StrCons($dep, $acc) }
            g_class_byval_deps($rest, $acc2)
        }
    }
}

# Collect an enum's by-value type dependencies across its flattened field positions.
# Only a homogeneous (PosScalar) position embeds by value; a mixed (PosUnion) slot
# stores everything as a generic union / counted box, and a carrier-boxed Option
# slot (g6e_field_carrier_boxed) is a pointer -- neither is a by-value dependency.
sub g_enum_byval_deps($name: Str, $info: CgVariantInfoList, $idx: Int, $all: DeclList, $acc: StrList, $fuel: Int): StrList {
    if $fuel <= 0 {
        $acc
    } else {
        match g6e_classify_position($info, $idx) {
            Err($m) { $acc }
            Ok($cls) {
                match $cls {
                    PosAbsent { $acc }
                    PosUnion { g_enum_byval_deps($name, $info, $idx + 1, $all, $acc, $fuel - 1) }
                    PosScalar($k) {
                        $dep = g_byval_dep_kind($k, g6e_field_carrier_boxed($info, $idx, $k, $name, $all))
                        $acc2 = if $dep == "" { $acc } else { StrCons($dep, $acc) }
                        g_enum_byval_deps($name, $info, $idx + 1, $all, $acc2, $fuel - 1)
                    }
                }
            }
        }
    }
}

# The by-value type dependencies of a single type decl (non-generic only; a generic
# template is never emitted as a concrete typedef, so it contributes no edges).
sub g_decl_byval_deps($d: Decl, $all: DeclList): StrList {
    match $d {
        DEnum($e) {
            match $e.tparams {
                StrNil { g_enum_byval_deps($e.name, g6e_variants_of($e.variants, $e.name, $all), 0, $all, StrNil, 100000) }
                _ { StrNil }
            }
        }
        DClass($c) {
            match $c.tparams {
                StrNil {
                    match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                        Ok($fs) { g_class_byval_deps($fs, StrNil) }
                        Err($m) { StrNil }
                    }
                }
                _ { StrNil }
            }
        }
        _ { StrNil }
    }
}

# Find a top-level user type (enum or class) decl by name.
sub g_find_type_decl($name: Str, $decls: DeclList): Option[Decl] {
    match $decls {
        DeclNil { None }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) { if $e.name == $name { Some($head) } else { g_find_type_decl($name, $tail) } }
                DClass($c) { if $c.name == $name { Some($head) } else { g_find_type_decl($name, $tail) } }
                _ { g_find_type_decl($name, $tail) }
            }
        }
    }
}

# Append a name to the END of a StrList. The DFS post-order accumulator doubles as
# the visited set, so the order it is built in IS the topological order.
sub g_strlist_snoc($xs: StrList, $name: Str): StrList {
    match $xs {
        StrNil { StrCons($name, StrNil) }
        StrCons($h, $t) { StrCons($h, g_strlist_snoc($t, $name)) }
    }
}

# DFS post-order visit: place all of $name's by-value dependencies first, then
# $name. `$placed` is both the visited set and the accumulating topological order. A
# name with no user-type decl (e.g. a built-in) contributes nothing. `$fuel` bounds
# recursion depth as a safety belt; the by-value graph is a DAG (EB-1 boxed every
# cycle), so the visited guard alone already terminates it.
sub g_topo_visit($name: Str, $placed: StrList, $all: DeclList, $fuel: Int): StrList {
    if $fuel <= 0 {
        $placed
    } else if strlist_contains($placed, $name) {
        $placed
    } else {
        match g_find_type_decl($name, $all) {
            None { $placed }
            Some($d) {
                $after_deps = g_topo_visit_deps(g_decl_byval_deps($d, $all), $placed, $all, $fuel - 1)
                g_strlist_snoc($after_deps, $name)
            }
        }
    }
}

sub g_topo_visit_deps($deps: StrList, $placed: StrList, $all: DeclList, $fuel: Int): StrList {
    match $deps {
        StrNil { $placed }
        StrCons($h, $t) {
            g_topo_visit_deps($t, g_topo_visit($h, $placed, $all, $fuel), $all, $fuel)
        }
    }
}

# Visit every type decl in source order, producing all user type names in
# topological (by-value dependency) order.
sub g_topo_names($decls: DeclList, $placed: StrList, $all: DeclList): StrList {
    match $decls {
        DeclNil { $placed }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    match $e.tparams {
                        StrNil { g_topo_names($tail, g_topo_visit($e.name, $placed, $all, 100000), $all) }
                        _ { g_topo_names($tail, $placed, $all) }
                    }
                }
                DClass($c) {
                    match $c.tparams {
                        StrNil { g_topo_names($tail, g_topo_visit($c.name, $placed, $all, 100000), $all) }
                        _ { g_topo_names($tail, $placed, $all) }
                    }
                }
                _ { g_topo_names($tail, $placed, $all) }
            }
        }
    }
}

# Rebuild a DeclList from an ordered name list (skipping any name without a type
# decl). Non-type decls (subs/imports) are dropped: the typedef and drop-table walks
# both ignore them, so the result is behaviorally identical to the original decl list
# for those two emitters, just reordered.
sub g_decls_by_names($names: StrList, $all: DeclList): DeclList {
    match $names {
        StrNil { DeclNil }
        StrCons($h, $t) {
            match g_find_type_decl($h, $all) {
                Some($d) { DeclCons($d, g_decls_by_names($t, $all)) }
                None { g_decls_by_names($t, $all) }
            }
        }
    }
}

# The type decls of $decls reordered so every by-value dependency precedes the type
# that embeds it (EB-2). Fed identically to g_type_typedefs and the drop table so
# kind ids and drop-table positions stay aligned.
sub g_topo_decls($decls: DeclList, $all: DeclList): DeclList {
    g_decls_by_names(g_topo_names($decls, StrNil, $all), $all)
}

# EB-2: forward-declare every user enum/class struct tag UP FRONT, so any POINTER
# cross-reference -- including EB-1's boxed cycle edges that spell the BARE typedef
# name (`Expr* fN`, `PatternList* fN` from g6e_field_ctype's CgBoxEnum arm) -- resolves
# no matter where the referenced type's full definition lands in the topological order.
# A `struct X*` member already resolves from the struct TAG alone (C implicitly
# declares the tag), but a bare `X* fN` member needs `typedef struct X X;` in scope
# first. Pointer-returning clone helpers for boxed enums are also declared here:
# their incomplete pointer types are legal and let an earlier enum's clone walk
# a cross-enum box whose full definition appears later. The per-block typedef in
# g6e_enum_typedef_one / g8_class_typedef_one repeats
# this line; a typedef redefined to the SAME type is legal C, so the duplicate is
# harmless. Order is irrelevant for forward decls, so this walks source order.
sub g_type_fwd_decls($decls: DeclList, $all: DeclList): Str {
    match $decls {
        DeclNil { "" }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    match $e.tparams {
                        StrNil {
                            $info = g6e_variants_of($e.variants, $e.name, $all)
                            $clone = if g6e_decl_needs_enum_box($e.name, $info, $all) { "static " ~ $e.name ~ "* guji_clone_" ~ $e.name ~ "_box(const " ~ $e.name ~ "* src);\n" } else { "" }
                            "typedef struct " ~ $e.name ~ " " ~ $e.name ~ ";\n" ~ $clone ~ "static int64_t guji_eq_" ~ $e.name ~ "(const " ~ $e.name ~ "* a, const " ~ $e.name ~ "* b);\nstatic int64_t guji_list_eq_" ~ $e.name ~ "(const " ~ $e.name ~ "* a, int64_t alen, const " ~ $e.name ~ "* b, int64_t blen);\nstatic int64_t guji_map_eq_" ~ $e.name ~ "(const char** akeys, const " ~ $e.name ~ "* avals, int64_t alen, const char** bkeys, const " ~ $e.name ~ "* bvals, int64_t blen);\nstatic const char* guji_enum_str_" ~ $e.name ~ "(const " ~ $e.name ~ "* p);\n" ~ g_type_fwd_decls($tail, $all)
                        }
                        _ { g_type_fwd_decls($tail, $all) }
                    }
                }
                DClass($c) {
                    match $c.tparams {
                        StrNil { "typedef struct " ~ $c.name ~ " " ~ $c.name ~ ";\nstatic int64_t guji_eq_" ~ $c.name ~ "(const " ~ $c.name ~ "* a, const " ~ $c.name ~ "* b);\nstatic int64_t guji_list_eq_" ~ $c.name ~ "(const " ~ $c.name ~ "* a, int64_t alen, const " ~ $c.name ~ "* b, int64_t blen);\nstatic int64_t guji_map_eq_" ~ $c.name ~ "(const char** akeys, const " ~ $c.name ~ "* avals, int64_t alen, const char** bkeys, const " ~ $c.name ~ "* bvals, int64_t blen);\nstatic const char* guji_class_str_" ~ $c.name ~ "(const " ~ $c.name ~ "* p);\n" ~ g_type_fwd_decls($tail, $all) }
                        _ { g_type_fwd_decls($tail, $all) }
                    }
                }
                _ { g_type_fwd_decls($tail, $all) }
            }
        }
    }
}

sub g_type_eq_helpers_from($decls: DeclList, $all: DeclList): Result[Str, Str] {
    match $decls {
        DeclNil { Ok("") }
        DeclCons($head, $tail) {
            $one: Result[Str, Str] = match $head {
                DEnum($e) {
                    match $e.tparams {
                        StrNil { g6e_enum_eq_helper($e.name, g6e_variants_of($e.variants, $e.name, $all)) }
                        _ { Ok("") }
                    }
                }
                DClass($c) {
                    match $c.tparams {
                        StrNil {
                            match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                                Err($m) { Err($m) }
                                Ok($fields) { g8_class_eq_helper($c.name, $fields) }
                            }
                        }
                        _ { Ok("") }
                    }
                }
                _ { Ok("") }
            }
            match $one {
                Err($m) { Err($m) }
                Ok($head_c) {
                    match g_type_eq_helpers_from($tail, $all) {
                        Err($m) { Err($m) }
                        Ok($tail_c) { Ok($head_c ~ $tail_c) }
                    }
                }
            }
        }
    }
}

sub g_type_display_helpers_from($decls: DeclList, $all: DeclList): Result[Str, Str] {
    match $decls {
        DeclNil { Ok("") }
        DeclCons($head, $tail) {
            $one: Result[Str, Str] = match $head {
                DEnum($e) {
                    match $e.tparams {
                        StrNil { Ok(g6e_enum_display_helper($e.name, g6e_variants_of($e.variants, $e.name, $all))) }
                        _ { Ok("") }
                    }
                }
                DClass($c) {
                    match $c.tparams {
                        StrNil {
                            match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                                Err($m) { Err($m) }
                                Ok($fields) { Ok(g8_class_display_helper($c.name, $fields)) }
                            }
                        }
                        _ { Ok("") }
                    }
                }
                _ { Ok("") }
            }
            match $one {
                Err($m) { Err($m) }
                Ok($head_c) {
                    match g_type_display_helpers_from($tail, $all) {
                        Err($m) { Err($m) }
                        Ok($tail_c) { Ok($head_c ~ $tail_c) }
                    }
                }
            }
        }
    }
}

sub g_type_typedefs($decls: DeclList, $all: DeclList): Result[Str, Str] {
    $ordered = g_topo_decls($decls, $all)
    match g_type_typedefs_from($ordered, $all, 11) {
        Err($m) { Err($m) }
        Ok($defs) {
            match g_type_eq_helpers_from($ordered, $all) {
                Err($m) { Err($m) }
                Ok($eqs) {
                    match g_type_display_helpers_from($ordered, $all) {
                        Err($m) { Err($m) }
                        Ok($displays) { Ok(g_type_fwd_decls($decls, $all) ~ $defs ~ $eqs ~ $displays) }
                    }
                }
            }
        }
    }
}

# Drop-table entries emitted in the SAME topological order g_type_typedefs uses, so
# each type's GUJI_KIND id (assigned positionally during typedef emission) equals the
# index of its drop function in the table.
sub g_type_drop_entries($decls: DeclList, $all: DeclList): Str {
    g6e_enum_drop_entries(g_topo_decls($decls, $all), $all)
}

# The Option-carrier box's drop-table entry for a wrapped type $name. Emitted right
# AFTER the decl's self/class box entry (if any), matching the kind order assigned by
# g_carrier_box_kind / g_type_next_kind (self/class box first, carrier box second).
sub g_carrier_drop_entry($name: Str, $all: DeclList): Str {
    if g6e_decl_needs_carrier_box($all, $name, $all) { "\tguji_drop_opt_" ~ $name ~ ", /* GUJI_KIND_opt_" ~ $name ~ " */\n" } else { "" }
}

sub g6e_enum_drop_entries($decls: DeclList, $all: DeclList): Str {
    match $decls {
        DeclNil { "" }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    match $e.tparams {
                        StrNil {
                            $info = g6e_variants_of($e.variants, $e.name, $all)
                            $enum_box = if g6e_decl_needs_enum_box($e.name, $info, $all) { "\tguji_drop_" ~ $e.name ~ ", /* GUJI_KIND_" ~ $e.name ~ " */\n" } else { "" }
                            "\tguji_drop_arr_" ~ $e.name ~ ", /* GUJI_KIND_" ~ $e.name ~ "_ARR */\n" ~ $enum_box ~ g_carrier_drop_entry($e.name, $all) ~ g6e_enum_drop_entries($tail, $all)
                        }
                        _ { g6e_enum_drop_entries($tail, $all) }
                    }
                }
                DClass($c) {
                    match $c.tparams {
                        StrNil {
                            $class_box = if g6e_decl_needs_class_box($all, $c.name, $all) { "\tguji_drop_" ~ $c.name ~ ", /* GUJI_KIND_" ~ $c.name ~ " */\n" } else { "" }
                            "\tguji_drop_arr_" ~ $c.name ~ ", /* GUJI_KIND_" ~ $c.name ~ "_ARR */\n" ~ $class_box ~ g_carrier_drop_entry($c.name, $all) ~ g6e_enum_drop_entries($tail, $all)
                        }
                        _ { g6e_enum_drop_entries($tail, $all) }
                    }
                }
                _ { g6e_enum_drop_entries($tail, $all) }
            }
        }
    }
}

# EB-1b: a class always boxes a CROSS-cycle edge to a LATER-declared type (the
# boxing rule requires the class to be declared first), so the wrapped type's typedef
# is NOT yet in scope when the class struct is emitted. A `struct <Enum>*` member uses
# the struct TAG (implicitly declared), so the forward pointer resolves regardless of
# order — unlike the bare typedef-name `<Enum>*` g6e_field_ctype emits for an enum's
# OWN self-box (where `typedef struct <Enum> <Enum>;` precedes the struct body in the
# same block). CgBoxClass already emits `struct <Class>*` via g6e_field_ctype.
sub g8_class_field_ctype($f: CgClassField): Str {
    if $f.boxcarrier {
        match g6_option_wrapped_name($f.kind) {
            Ok($n) { "struct guji_opt_" ~ $n ~ "*" }
            Err($m) { g6_option_ctype($f.kind) ~ "*" }
        }
    } else {
        match $f.kind {
        CgBoxEnum($n) { "struct " ~ $n ~ "*" }
        _ { g6e_field_ctype($f.kind) }
        }
    }
}

sub g8_class_fields_c($fs: CgClassFieldInfoList): Result[Str, Str] {
    match $fs {
        CgClassFieldNil { Ok("") }
        CgClassFieldCons($f, $rest) {
            if !g8_class_field_supported($f.kind) {
                Err(g3_unsupported())
            } else {
                match g8_class_fields_c($rest) {
                    Err($m) { Err($m) }
                    Ok($tail) { Ok("\t" ~ g8_class_field_ctype($f) ~ " f" ~ c_int($f.index) ~ ";\n" ~ $tail) }
                }
            }
        }
    }
}

sub g8_class_rc_fields_c($fs: CgClassFieldInfoList, $op: Str): Str {
    match $fs {
        CgClassFieldNil { "" }
        CgClassFieldCons($f, $rest) {
            $one = match $f.kind {
                CgStr { "\tguji_" ~ $op ~ "(p->f" ~ c_int($f.index) ~ ");\n" }
                CgList($el) { "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ".data);\n" }
                CgMap($v) {
                    "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ".keys);\n" ~
                    "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ".vals);\n"
                }
                CgOptStr { g6_option_retain_or_release(CgOptStr, "p->f" ~ c_int($f.index), $op) }
                # An Option[<class>] field retain/releases its active Some payload by
                # tag-guarded recursion into the wrapped class's fields helper
                # (E5d-7c-2d-5). A None slot (tag 0) is skipped.
                CgOptClass($n) {
                    if $f.boxcarrier {
                        "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ");\n"
                    } else {
                        g6_option_retain_or_release(CgOptClass($n), "p->f" ~ c_int($f.index), $op)
                    }
                }
                # An Option[<enum>] field retain/releases its active Some payload by
                # tag-guarded recursion into the wrapped enum's fields helper
                # (E5d-7c-2d-8). A None slot (tag 0) is skipped.
                CgOptEnum($n) {
                    if $f.boxcarrier {
                        "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ");\n"
                    } else {
                        g6_option_retain_or_release(CgOptEnum($n), "p->f" ~ c_int($f.index), $op)
                    }
                }
                CgRes($ok, $err) { g6_result_retain_or_release($f.kind, "p->f" ~ c_int($f.index), $op) }
                # A by-value nested enum field retain/releases TRANSITIVELY by
                # recursing into the child enum's generated `guji_<op>_<Enum>_fields`
                # helper (every enum emits one; a niladic child's is a no-op). Class
                # fields are never in a union slot, so the address is the bare member.
                CgEnum($n) { "\tguji_" ~ $op ~ "_" ~ $n ~ "_fields(&p->f" ~ c_int($f.index) ~ ");\n" }
                # A by-value nested class field retain/releases TRANSITIVELY by
                # recursing into the child class's `guji_<op>_<Class>_fields` helper
                # (every class emits one; a child with only scalar fields is a
                # no-op). The child's helper is declared earlier (source order), so
                # the call is in scope.
                CgClass($n) { "\tguji_" ~ $op ~ "_" ~ $n ~ "_fields(&p->f" ~ c_int($f.index) ~ ");\n" }
                # EB-1b: a cross-cycle-broken field is a counted heap box; retain/
                # release the pointer itself (class fields are never in a union slot,
                # so the address is the bare member). The wrapped type's generated
                # drop helper recurses into its fields at rc==0.
                CgBoxEnum($n) { "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ");\n" }
                CgBoxClass($n) { "\tguji_" ~ $op ~ "((const void*)p->f" ~ c_int($f.index) ~ ");\n" }
                _ { "" }
            }
            $one ~ g8_class_rc_fields_c($rest, $op)
        }
    }
}

# Runtime guji_list_str / guji_map_str walk ARR_SCALAR/STR/SLICE/MAP only.
# Scalar/Str leaves (and nested List/Map of those) are safe here; Class/Enum
# element collections need a dedicated helper loop (I5g2).
sub g_collection_display_leaf_supported($kind: CgKind): Bool {
    match $kind {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgEnum($name) { true }
        CgClass($name) { true }
        CgList($el) { g_collection_display_leaf_supported($el) }
        CgMap($v) { g_collection_display_leaf_supported($v) }
        _ { false }
    }
}

sub g_kind_contains_nominal($kind: CgKind): Bool {
    match $kind {
        CgEnum($name) { true }
        CgClass($name) { true }
        CgList($el) { g_kind_contains_nominal($el) }
        CgMap($v) { g_kind_contains_nominal($v) }
        _ { false }
    }
}

sub g_collection_contains_nominal($kind: CgKind): Bool {
    match $kind {
        CgList($el) { g_kind_contains_nominal($el) }
        CgMap($v) { g_kind_contains_nominal($v) }
        _ { false }
    }
}

sub g_nominal_display_kind_supported($kind: CgKind): Bool {
    match $kind {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgUnit { true }
        CgEnum($n) { true }
        CgBoxEnum($n) { true }
        CgClass($n) { true }
        CgBoxClass($n) { true }
        CgOptInt { true }
        CgOptFloat { true }
        CgOptBool { true }
        CgChan($el) { true }
        CgList($el) { g_collection_display_leaf_supported($el) }
        CgMap($v) { g_collection_display_leaf_supported($v) }
        _ { false }
    }
}

# Canonical nominal display recurses over user values and collection-bearing
# List/Map fields. Scalar leaves use the generic runtime formatter; nominal
# leaves recurse through the generated per-type display helpers.
sub g8_class_display_supported($fs: CgClassFieldInfoList): Bool {
    match $fs {
        CgClassFieldNil { true }
        CgClassFieldCons($f, $rest) {
            $one = g_nominal_display_kind_supported($f.kind)
            $one && g8_class_display_supported($rest)
        }
    }
}

sub g_nominal_display_collection_str($kind: CgKind, $acc: Str, $tmp: Int): Str {
    match $kind {
        CgList($el) {
            match g7_list_arr_kind($el) {
                Err($m) { "" }
                Ok($ak) {
                    match g7_map_leaf($el) {
                        Err($m) { "" }
                        Ok($leaf) {
                            $s = "gnd" ~ c_int($tmp)
                            "\tconst char* " ~ $s ~ " = guji_list_str((const void*)" ~ $acc ~ ".data, " ~ $acc ~ ".len, " ~ $ak ~ ", " ~ $leaf ~ ");\n" ~
                            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
                        }
                    }
                }
            }
        }
        CgMap($v) {
            match g7_map_val_arr_kind($v) {
                Err($m) { "" }
                Ok($ak) {
                    match g7_map_leaf($v) {
                        Err($m) { "" }
                        Ok($leaf) {
                            $s = "gnd" ~ c_int($tmp)
                            "\tconst char* " ~ $s ~ " = guji_map_str((const char**)" ~ $acc ~ ".keys, (const void*)" ~ $acc ~ ".vals, " ~ $acc ~ ".len, " ~ $ak ~ ", " ~ $leaf ~ ");\n" ~
                            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
                        }
                    }
                }
            }
        }
        _ { "" }
    }
}

sub g_nominal_display_append($kind: CgKind, $acc: Str, $tmp: Int): Str {
    match $kind {
        CgInt { "\tguji_disp_scalar(&b, (const void*)&" ~ $acc ~ ", 0, GUJI_LEAF_INT);\n" }
        CgBool { "\tguji_disp_scalar(&b, (const void*)&" ~ $acc ~ ", 0, GUJI_LEAF_BOOL);\n" }
        CgFloat { "\tguji_disp_scalar(&b, (const void*)&" ~ $acc ~ ", 0, GUJI_LEAF_FLOAT);\n" }
        CgUnit { "\tguji_disp_scalar(&b, (const void*)&" ~ $acc ~ ", 0, GUJI_LEAF_UNIT);\n" }
        CgStr { "\tguji_disp_putn(&b, " ~ $acc ~ ", (size_t)GUJI_HDR(" ~ $acc ~ ")->count);\n" }
        CgChan($el) { "\tguji_disp_puts(&b, \"<chan>\");\n" }
        CgEnum($n) {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_enum_str_" ~ $n ~ "(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgBoxEnum($n) {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_enum_str_" ~ $n ~ "(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgClass($n) {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_class_str_" ~ $n ~ "(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgBoxClass($n) {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_class_str_" ~ $n ~ "(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgOptInt {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_carrier_str_guji_opt_int(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgOptFloat {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_carrier_str_guji_opt_float(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgOptBool {
            $s = "gnd" ~ c_int($tmp)
            "\tconst char* " ~ $s ~ " = guji_carrier_str_guji_opt_bool(&(" ~ $acc ~ "));\n" ~
            "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count);\n\tguji_release(" ~ $s ~ ");\n"
        }
        CgList($el) { g_nominal_display_collection_str(CgList($el), $acc, $tmp) }
        CgMap($v) { g_nominal_display_collection_str(CgMap($v), $acc, $tmp) }
        _ { "" }
    }
}

sub g_nominal_collection_elem_acc($kind: CgKind, $data: Str, $idx: Str): Str {
    match g7_list_c_type($kind) {
        Err($m) { "" }
        Ok($ctype) { "((" ~ $ctype ~ "*)" ~ $data ~ ")[" ~ $idx ~ "]" }
    }
}

# Append a collection whose terminal leaf is a class/enum directly into the
# surrounding nominal display buffer.  Intermediate List/Map handles recurse;
# terminal values delegate to the I5g2 per-type display helpers.
sub g_nominal_collection_append($kind: CgKind, $acc: Str, $path: Str): Str {
    match $kind {
        CgClass($name) {
            $s = "gns_" ~ $path
            "\t\tconst char* " ~ $s ~ " = guji_class_str_" ~ $name ~ "(&(" ~ $acc ~ "));\n" ~
            "\t\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count); guji_release(" ~ $s ~ ");\n"
        }
        CgEnum($name) {
            $s = "gns_" ~ $path
            "\t\tconst char* " ~ $s ~ " = guji_enum_str_" ~ $name ~ "(&(" ~ $acc ~ "));\n" ~
            "\t\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count); guji_release(" ~ $s ~ ");\n"
        }
        CgList($el) {
            $i = "gni_" ~ $path
            $row = g_nominal_collection_elem_acc($el, $acc ~ ".data", $i)
            "\tguji_disp_puts(&b, \"[\");\n" ~
            "\tfor (int64_t " ~ $i ~ " = 0; " ~ $i ~ " < " ~ $acc ~ ".len; " ~ $i ~ "++) \{\n" ~
            "\t\tif (" ~ $i ~ ") \{ guji_disp_puts(&b, \", \"); }\n" ~
            g_nominal_collection_append($el, $row, $path ~ "l") ~
            "\t}\n\tguji_disp_puts(&b, \"]\");\n"
        }
        CgMap($v) {
            $i = "gmi_" ~ $path
            $j = "gmj_" ~ $path
            $k = "gmk_" ~ $path
            $ord = "gmo_" ~ $path
            $row = g_nominal_collection_elem_acc($v, $acc ~ ".vals", $k)
            "\tint64_t* " ~ $ord ~ " = NULL;\n" ~
            "\tif (" ~ $acc ~ ".len > 0) \{ " ~ $ord ~ " = (int64_t*)malloc((size_t)" ~ $acc ~ ".len * sizeof(int64_t)); if (!" ~ $ord ~ ") \{ guji_panic(\"out of memory\"); } }\n" ~
            "\tfor (int64_t " ~ $i ~ " = 0; " ~ $i ~ " < " ~ $acc ~ ".len; " ~ $i ~ "++) \{ int64_t " ~ $j ~ " = " ~ $i ~ "; " ~ $ord ~ "[" ~ $i ~ "] = " ~ $i ~ "; while (" ~ $j ~ " > 0 && guji_disp_key_less(" ~ $acc ~ ".keys[" ~ $ord ~ "[" ~ $j ~ "]], " ~ $acc ~ ".keys[" ~ $ord ~ "[" ~ $j ~ " - 1]])) \{ int64_t t = " ~ $ord ~ "[" ~ $j ~ "]; " ~ $ord ~ "[" ~ $j ~ "] = " ~ $ord ~ "[" ~ $j ~ " - 1]; " ~ $ord ~ "[" ~ $j ~ " - 1] = t; " ~ $j ~ "--; } }\n" ~
            "\tguji_disp_puts(&b, \"\{\");\n" ~
            "\tfor (int64_t " ~ $i ~ " = 0; " ~ $i ~ " < " ~ $acc ~ ".len; " ~ $i ~ "++) \{ int64_t " ~ $k ~ " = " ~ $ord ~ "[" ~ $i ~ "]; if (" ~ $i ~ ") \{ guji_disp_puts(&b, \", \"); } guji_disp_quote(&b, " ~ $acc ~ ".keys[" ~ $k ~ "]); guji_disp_puts(&b, \": \");\n" ~
            g_nominal_collection_append($v, $row, $path ~ "m") ~
            "\t}\n\tguji_disp_puts(&b, \"}\"); free(" ~ $ord ~ ");\n"
        }
        _ { "" }
    }
}

sub g8_class_field_collection_display_helper($owner: Str, $f: CgClassField): Str {
    if g_collection_contains_nominal($f.kind) {
        $name = "guji_field_str_" ~ $owner ~ "_" ~ c_int($f.index)
        match $f.kind {
            CgList($el) {
                "static const char* " ~ $name ~ "(const guji_slice_t* p) \{\n\tguji_disp_buf b = \{0, 0, 0};\n" ~
                g_nominal_collection_append($f.kind, "(*p)", $owner ~ "_" ~ c_int($f.index)) ~
                "\treturn guji_disp_finish(&b);\n}\n\n"
            }
            CgMap($v) {
                "static const char* " ~ $name ~ "(const guji_map_t* p) \{\n\tguji_disp_buf b = \{0, 0, 0};\n" ~
                g_nominal_collection_append($f.kind, "(*p)", $owner ~ "_" ~ c_int($f.index)) ~
                "\treturn guji_disp_finish(&b);\n}\n\n"
            }
            _ { "" }
        }
    } else {
        ""
    }
}

sub g8_class_field_collection_display_helpers($owner: Str, $fs: CgClassFieldInfoList): Str {
    match $fs {
        CgClassFieldNil { "" }
        CgClassFieldCons($f, $rest) { g8_class_field_collection_display_helper($owner, $f) ~ g8_class_field_collection_display_helpers($owner, $rest) }
    }
}

sub g8_class_display_one($owner: Str, $f: CgClassField): Str {
    $acc = g8_class_eq_accessor("p", $f)
    $value = if g_collection_contains_nominal($f.kind) {
        $s = "gnd" ~ c_int($f.index)
        "\tconst char* " ~ $s ~ " = guji_field_str_" ~ $owner ~ "_" ~ c_int($f.index) ~ "(&(" ~ $acc ~ "));\n" ~
        "\tguji_disp_putn(&b, " ~ $s ~ ", (size_t)GUJI_HDR(" ~ $s ~ ")->count); guji_release(" ~ $s ~ ");\n"
    } else {
        g_nominal_display_append($f.kind, $acc, $f.index)
    }
    "\tguji_disp_puts(&b, \"" ~ g2_c_escape($f.name) ~ ": \" );\n" ~ $value
}

sub g8_class_display_fields($owner: Str, $fs: CgClassFieldInfoList, $first: Bool): Str {
    match $fs {
        CgClassFieldNil { "" }
        CgClassFieldCons($f, $rest) {
            (if $first { "" } else { "\tguji_disp_puts(&b, \", \");\n" }) ~
            g8_class_display_one($owner, $f) ~ g8_class_display_fields($owner, $rest, false)
        }
    }
}

sub g8_class_display_insert($field: CgClassField, $fs: CgClassFieldInfoList): CgClassFieldInfoList {
    match $fs {
        CgClassFieldNil { CgClassFieldCons($field, CgClassFieldNil) }
        CgClassFieldCons($head, $tail) {
            if $field.name < $head.name {
                CgClassFieldCons($field, $fs)
            } else {
                CgClassFieldCons($head, g8_class_display_insert($field, $tail))
            }
        }
    }
}

sub g8_class_display_sorted($fs: CgClassFieldInfoList): CgClassFieldInfoList {
    match $fs {
        CgClassFieldNil { CgClassFieldNil }
        CgClassFieldCons($head, $tail) { g8_class_display_insert($head, g8_class_display_sorted($tail)) }
    }
}

# Specialized collection display for one nominal element/value type. The
# per-type scalar display helper remains the single definition of record text;
# these walkers add List brackets or sorted Map keys around it.
sub g_nominal_collection_display_helpers($name: Str, $helper: Str): Str {
    "static const char* guji_list_str_" ~ $name ~ "(const " ~ $name ~ "* data, int64_t len) \{\n" ~
    "\tguji_disp_buf b = \{0, 0, 0};\n\tguji_disp_puts(&b, \"[\");\n" ~
    "\tfor (int64_t i = 0; i < len; i++) \{\n" ~
    "\t\tif (i) \{ guji_disp_puts(&b, \", \"); }\n" ~
    "\t\tconst char* s = " ~ $helper ~ "(&data[i]);\n" ~
    "\t\tguji_disp_putn(&b, s, (size_t)GUJI_HDR(s)->count);\n\t\tguji_release(s);\n\t}\n" ~
    "\tguji_disp_puts(&b, \"]\");\n\treturn guji_disp_finish(&b);\n}\n\n" ~
    "static const char* guji_map_str_" ~ $name ~ "(const char** keys, const " ~ $name ~ "* vals, int64_t len) \{\n" ~
    "\tguji_disp_buf b = \{0, 0, 0};\n\tint64_t* ord = NULL;\n" ~
    "\tif (len > 0) \{ ord = (int64_t*)malloc((size_t)len * sizeof(int64_t)); if (!ord) \{ guji_panic(\"out of memory\"); } }\n" ~
    "\tfor (int64_t i = 0; i < len; i++) \{\n" ~
    "\t\tint64_t j = i; ord[i] = i;\n" ~
    "\t\twhile (j > 0 && guji_disp_key_less(keys[ord[j]], keys[ord[j - 1]])) \{ int64_t t = ord[j]; ord[j] = ord[j - 1]; ord[j - 1] = t; j--; }\n" ~
    "\t}\n\tguji_disp_puts(&b, \"\{\");\n" ~
    "\tfor (int64_t i = 0; i < len; i++) \{\n" ~
    "\t\tint64_t k = ord[i]; if (i) \{ guji_disp_puts(&b, \", \"); }\n" ~
    "\t\tguji_disp_quote(&b, keys[k]); guji_disp_puts(&b, \": \");\n" ~
    "\t\tconst char* s = " ~ $helper ~ "(&vals[k]);\n" ~
    "\t\tguji_disp_putn(&b, s, (size_t)GUJI_HDR(s)->count); guji_release(s);\n\t}\n" ~
    "\tguji_disp_puts(&b, \"}\"); free(ord);\n\treturn guji_disp_finish(&b);\n}\n\n"
}

sub g8_class_display_helper($name: Str, $fields: CgClassFieldInfoList): Str {
    if g8_class_display_supported($fields) {
        g8_class_field_collection_display_helpers($name, $fields) ~
        "static const char* guji_class_str_" ~ $name ~ "(const " ~ $name ~ "* p) \{\n" ~
        "\tguji_disp_buf b = \{0, 0, 0};\n" ~
        "\tguji_disp_puts(&b, \"" ~ g2_c_escape(g9_type_display_name($name)) ~ "(\");\n" ~
        g8_class_display_fields($name, g8_class_display_sorted($fields), true) ~
        "\tguji_disp_puts(&b, \")\");\n" ~
        "\treturn guji_disp_finish(&b);\n}\n\n" ~
        g_nominal_collection_display_helpers($name, "guji_class_str_" ~ $name)
    } else {
        ""
    }
}

sub g8_class_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g8_class_kind_from_value($e, $env) {
        Err($m) { Err($m) }
        Ok($kind) {
            match $kind {
                CgClass($name) {
                    match cg_env_lookup_class($env, $name) {
                        None { Err(g3_unsupported()) }
                        Some($info) {
                            if !g8_class_display_supported($info.fields) {
                                Err(g3_unsupported())
                            } else {
                                match g8_class_value($name, $e, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($cv) {
                                        $ct = g4_value_tmp(CgClass($name), $cv.state.ntmp)
                                        $st = "gt" ~ c_int($cv.state.ntmp + 1)
                                        Ok(StrLower(
                                            state: CgState(
                                                interns: $cv.state.interns,
                                                decls: $cv.state.decls ~ g4_value_decl(CgClass($name), $ct) ~ "\tconst char* " ~ $st ~ " = GUJI_EMPTY_STR;\n",
                                                body: $cv.state.body ~ "\t" ~ $ct ~ " = " ~ $cv.c ~ ";\n\t" ~ $st ~ " = guji_class_str_" ~ $name ~ "(&" ~ $ct ~ ");\n" ~ g8_class_release($name, $ct),
                                                nstr: $cv.state.nstr,
                                                ntmp: $cv.state.ntmp + 2
                                            ),
                                            tmp: $st
                                        ))
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g6e_enum_display_fields_supported($fields: CgKindList): Bool {
    match $fields {
        CgKindNil { true }
        CgKindCons($head, $tail) {
            g_nominal_display_kind_supported($head) && g6e_enum_display_fields_supported($tail)
        }
    }
}

sub g6e_enum_display_supported($variants: CgVariantInfoList): Bool {
    match $variants {
        CgVarNil { true }
        CgVarCons($head, $tail) {
            g6e_enum_display_fields_supported($head.fields) && g6e_enum_display_supported($tail)
        }
    }
}

sub g6e_enum_display_fields($allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int, $first: Bool, $path: Str): Str {
    match $fields {
        CgKindNil { "" }
        CgKindCons($fk, $rest) {
            $acc = g6e_field_accessor($allvars, "(*p)", $idx, $fk)
            $value = if g_collection_contains_nominal($fk) {
                g_nominal_collection_append($fk, $acc, $path ~ "_" ~ c_int($idx))
            } else {
                g_nominal_display_append($fk, $acc, $idx)
            }
            (if $first { "" } else { "\t\tguji_disp_puts(&b, \", \");\n" }) ~
            $value ~
            g6e_enum_display_fields($allvars, $rest, $idx + 1, false, $path)
        }
    }
}

sub g6e_enum_display_cases($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int): Str {
    match $todo {
        CgVarNil { "" }
        CgVarCons($v, $rest) {
            $open = match $v.fields { CgKindNil { "" } _ { "\t\tguji_disp_puts(&b, \"(\");\n" } }
            $close = match $v.fields { CgKindNil { "" } _ { "\t\tguji_disp_puts(&b, \")\");\n" } }
            "\tcase " ~ c_int($tag) ~ "LL: \{\n\t\tguji_disp_puts(&b, \"" ~ g2_c_escape($v.name) ~ "\");\n" ~
            $open ~ g6e_enum_display_fields($allvars, $v.fields, 0, true, "e" ~ c_int($tag)) ~ $close ~
            "\t\tbreak;\n\t}\n" ~ g6e_enum_display_cases($allvars, $rest, $tag + 1)
        }
    }
}

sub g6e_enum_display_helper($name: Str, $variants: CgVariantInfoList): Str {
    if g6e_enum_display_supported($variants) {
        "static const char* guji_enum_str_" ~ $name ~ "(const " ~ $name ~ "* p) \{\n" ~
        "\tguji_disp_buf b = \{0, 0, 0};\n\tswitch (p->tag) \{\n" ~
        g6e_enum_display_cases($variants, $variants, 0) ~
        "\tdefault: break;\n\t}\n\treturn guji_disp_finish(&b);\n}\n\n" ~
        g_nominal_collection_display_helpers($name, "guji_enum_str_" ~ $name)
    } else {
        ""
    }
}

sub g6e_enum_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g6e_enum_kind_from_value($e, $env) {
        Err($m) { Err($m) }
        Ok($kind) {
            match $kind {
                CgEnum($name) {
                    match cg_env_lookup_enum($env, $name) {
                        None { Err(g3_unsupported()) }
                        Some($info) {
                            if !g6e_enum_display_supported($info.variants) {
                                Err(g3_unsupported())
                            } else {
                                match g6e_enum_value($name, $e, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($ev) {
                                        $et = g4_value_tmp(CgEnum($name), $ev.state.ntmp)
                                        $st = "gt" ~ c_int($ev.state.ntmp + 1)
                                        Ok(StrLower(
                                            state: CgState(
                                                interns: $ev.state.interns,
                                                decls: $ev.state.decls ~ g4_value_decl(CgEnum($name), $et) ~ "\tconst char* " ~ $st ~ " = GUJI_EMPTY_STR;\n",
                                                body: $ev.state.body ~ "\t" ~ $et ~ " = " ~ $ev.c ~ ";\n\t" ~ $st ~ " = guji_enum_str_" ~ $name ~ "(&" ~ $et ~ ");\n" ~ g6e_enum_release($name, $et),
                                                nstr: $ev.state.nstr,
                                                ntmp: $ev.state.ntmp + 2
                                            ),
                                            tmp: $st
                                        ))
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Structural equality expression for one already-addressable nominal field or
# enum payload. Collections reuse the runtime's recursive KIND-tag path;
# nested classes/enums recurse through their generated helpers; user-type Option
# carriers compare the tag and only the active Some payload. The accessors passed
# here are borrowed lvalues, so equality never changes ownership.
sub g_nominal_eq_expr($kind: CgKind, $lc: Str, $rc: Str): Result[Str, Str] {
    match $kind {
        CgStr { Ok("guji_str_equal(" ~ $lc ~ ", " ~ $rc ~ ")") }
        CgList($el) { g4_carrier_eq_payload_expr(CgList($el), $lc, $rc) }
        CgMap($v) { g4_carrier_eq_payload_expr(CgMap($v), $lc, $rc) }
        CgEnum($n) { Ok("guji_eq_" ~ $n ~ "(&(" ~ $lc ~ "), &(" ~ $rc ~ "))") }
        CgBoxEnum($n) { Ok("guji_eq_" ~ $n ~ "(&(" ~ $lc ~ "), &(" ~ $rc ~ "))") }
        CgClass($n) { Ok("guji_eq_" ~ $n ~ "(&(" ~ $lc ~ "), &(" ~ $rc ~ "))") }
        CgBoxClass($n) { Ok("guji_eq_" ~ $n ~ "(&(" ~ $lc ~ "), &(" ~ $rc ~ "))") }
        CgOptClass($n) {
            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || guji_eq_" ~ $n ~ "(&(" ~ $lc ~ ".val), &(" ~ $rc ~ ".val))))")
        }
        CgBoxOptClass($n) {
            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || guji_eq_" ~ $n ~ "(&(" ~ $lc ~ ".val), &(" ~ $rc ~ ".val))))")
        }
        CgOptEnum($n) {
            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || guji_eq_" ~ $n ~ "(&(" ~ $lc ~ ".val), &(" ~ $rc ~ ".val))))")
        }
        CgBoxOptEnum($n) {
            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || guji_eq_" ~ $n ~ "(&(" ~ $lc ~ ".val), &(" ~ $rc ~ ".val))))")
        }
        CgOptInt { g4_carrier_eq_expr(CgOptInt, $lc, $rc) }
        CgOptFloat { g4_carrier_eq_expr(CgOptFloat, $lc, $rc) }
        CgOptBool { g4_carrier_eq_expr(CgOptBool, $lc, $rc) }
        CgOptStr { g4_carrier_eq_expr(CgOptStr, $lc, $rc) }
        CgOptList($el) { g4_carrier_eq_expr(CgOptList($el), $lc, $rc) }
        CgOptMap($v) { g4_carrier_eq_expr(CgOptMap($v), $lc, $rc) }
        CgRes($ok, $err) { g4_carrier_eq_expr($kind, $lc, $rc) }
        CgMatch { Ok("guji_match_equal(" ~ $lc ~ ", " ~ $rc ~ ")") }
        _ { Ok("((" ~ $lc ~ ") == (" ~ $rc ~ "))") }
    }
}

sub g8_class_eq_accessor($side: Str, $f: CgClassField): Str {
    $raw = $side ~ "->f" ~ c_int($f.index)
    if $f.boxcarrier {
        "(*(" ~ $raw ~ "))"
    } else {
        match $f.kind {
            CgBoxEnum($n) { "(*(" ~ $raw ~ "))" }
            CgBoxClass($n) { "(*(" ~ $raw ~ "))" }
            _ { $raw }
        }
    }
}

sub g_nominal_collection_eq_checks($kind: CgKind, $a: Str, $b: Str, $path: Str): Str {
    match $kind {
        CgClass($name) { "\t\tif (!guji_eq_" ~ $name ~ "(&(" ~ $a ~ "), &(" ~ $b ~ "))) \{ return 0LL; }\n" }
        CgEnum($name) { "\t\tif (!guji_eq_" ~ $name ~ "(&(" ~ $a ~ "), &(" ~ $b ~ "))) \{ return 0LL; }\n" }
        CgList($el) {
            $i = "gni_" ~ $path
            $av = g_nominal_collection_elem_acc($el, $a ~ ".data", $i)
            $bv = g_nominal_collection_elem_acc($el, $b ~ ".data", $i)
            "\tif (" ~ $a ~ ".len != " ~ $b ~ ".len) \{ return 0LL; }\n" ~
            "\tfor (int64_t " ~ $i ~ " = 0; " ~ $i ~ " < " ~ $a ~ ".len; " ~ $i ~ "++) \{\n" ~
            g_nominal_collection_eq_checks($el, $av, $bv, $path ~ "l") ~
            "\t}\n"
        }
        CgMap($v) {
            $i = "gmi_" ~ $path
            $j = "gmj_" ~ $path
            $found = "gmf_" ~ $path
            $av = g_nominal_collection_elem_acc($v, $a ~ ".vals", $i)
            $bv = g_nominal_collection_elem_acc($v, $b ~ ".vals", $j)
            "\tif (" ~ $a ~ ".len != " ~ $b ~ ".len) \{ return 0LL; }\n" ~
            "\tfor (int64_t " ~ $i ~ " = 0; " ~ $i ~ " < " ~ $a ~ ".len; " ~ $i ~ "++) \{\n" ~
            "\t\tint " ~ $found ~ " = 0;\n" ~
            "\t\tfor (int64_t " ~ $j ~ " = 0; " ~ $j ~ " < " ~ $b ~ ".len; " ~ $j ~ "++) \{\n" ~
            "\t\t\tif (guji_str_equal(" ~ $a ~ ".keys[" ~ $i ~ "], " ~ $b ~ ".keys[" ~ $j ~ "])) \{\n" ~
            g_nominal_collection_eq_checks($v, $av, $bv, $path ~ "m") ~
            "\t\t\t\t" ~ $found ~ " = 1; break;\n\t\t\t}\n\t\t}\n" ~
            "\t\tif (!" ~ $found ~ ") \{ return 0LL; }\n\t}\n"
        }
        _ { "\treturn 0LL;\n" }
    }
}

sub g8_class_field_collection_eq_helper($owner: Str, $f: CgClassField): Str {
    if g_collection_contains_nominal($f.kind) {
        $name = "guji_field_eq_" ~ $owner ~ "_" ~ c_int($f.index)
        match $f.kind {
            CgList($el) {
                "static int64_t " ~ $name ~ "(const guji_slice_t* a, const guji_slice_t* b) \{\n" ~
                g_nominal_collection_eq_checks($f.kind, "(*a)", "(*b)", $owner ~ "_" ~ c_int($f.index)) ~
                "\treturn 1LL;\n}\n\n"
            }
            CgMap($v) {
                "static int64_t " ~ $name ~ "(const guji_map_t* a, const guji_map_t* b) \{\n" ~
                g_nominal_collection_eq_checks($f.kind, "(*a)", "(*b)", $owner ~ "_" ~ c_int($f.index)) ~
                "\treturn 1LL;\n}\n\n"
            }
            _ { "" }
        }
    } else {
        ""
    }
}

sub g8_class_field_collection_eq_helpers($owner: Str, $fs: CgClassFieldInfoList): Str {
    match $fs {
        CgClassFieldNil { "" }
        CgClassFieldCons($f, $rest) { g8_class_field_collection_eq_helper($owner, $f) ~ g8_class_field_collection_eq_helpers($owner, $rest) }
    }
}

sub g8_class_eq_clauses($owner: Str, $fs: CgClassFieldInfoList): Result[Str, Str] {
    match $fs {
        CgClassFieldNil { Ok("") }
        CgClassFieldCons($f, $rest) {
            $lc = g8_class_eq_accessor("a", $f)
            $rc = g8_class_eq_accessor("b", $f)
            $one_result: Result[Str, Str] = if g_collection_contains_nominal($f.kind) {
                Ok("guji_field_eq_" ~ $owner ~ "_" ~ c_int($f.index) ~ "(&(" ~ $lc ~ "), &(" ~ $rc ~ "))")
            } else {
                g_nominal_eq_expr($f.kind, $lc, $rc)
            }
            match $one_result {
                Err($m) { Err($m) }
                Ok($one) {
                    match g8_class_eq_clauses($owner, $rest) {
                        Err($m) { Err($m) }
                        Ok($tail) { Ok(if $tail == "" { $one } else { $one ~ " && " ~ $tail }) }
                    }
                }
            }
        }
    }
}

# Specialized collection equality for one nominal element type. Runtime KIND
# tags own storage/drop, but structural comparison must call the generated
# per-type helper rather than treating a record slot as a scalar.
sub g_nominal_collection_eq_helpers($name: Str): Str {
    "static int64_t guji_list_eq_" ~ $name ~ "(const " ~ $name ~ "* a, int64_t alen, const " ~ $name ~ "* b, int64_t blen) \{\n" ~
    "\tif (alen != blen) \{ return 0LL; }\n" ~
    "\tfor (int64_t i = 0; i < alen; i++) \{ if (!guji_eq_" ~ $name ~ "(&a[i], &b[i])) \{ return 0LL; } }\n" ~
    "\treturn 1LL;\n}\n\n" ~
    "static int64_t guji_map_eq_" ~ $name ~ "(const char** akeys, const " ~ $name ~ "* avals, int64_t alen, const char** bkeys, const " ~ $name ~ "* bvals, int64_t blen) \{\n" ~
    "\tif (alen != blen) \{ return 0LL; }\n" ~
    "\tfor (int64_t i = 0; i < alen; i++) \{\n" ~
    "\t\tint found = 0;\n" ~
    "\t\tfor (int64_t j = 0; j < blen; j++) \{\n" ~
    "\t\t\tif (guji_str_equal(akeys[i], bkeys[j])) \{ if (!guji_eq_" ~ $name ~ "(&avals[i], &bvals[j])) \{ return 0LL; } found = 1; break; }\n" ~
    "\t\t}\n" ~
    "\t\tif (!found) \{ return 0LL; }\n" ~
    "\t}\n\treturn 1LL;\n}\n\n"
}

sub g8_class_eq_helper($name: Str, $fields: CgClassFieldInfoList): Result[Str, Str] {
    match g8_class_eq_clauses($name, $fields) {
        Err($m) { Err($m) }
        Ok($clauses) {
            $body = if $clauses == "" { "1LL" } else { "(" ~ $clauses ~ ") ? 1LL : 0LL" }
            Ok(g8_class_field_collection_eq_helpers($name, $fields) ~
                "static int64_t guji_eq_" ~ $name ~ "(const " ~ $name ~ "* a, const " ~ $name ~ "* b) \{\n\treturn " ~ $body ~ ";\n}\n\n" ~ g_nominal_collection_eq_helpers($name))
        }
    }
}

sub g6e_enum_eq_fields($allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int): Result[Str, Str] {
    match $fields {
        CgKindNil { Ok("") }
        CgKindCons($fk, $rest) {
            $la = g6e_field_accessor($allvars, "(*a)", $idx, $fk)
            $ra = g6e_field_accessor($allvars, "(*b)", $idx, $fk)
            match g_nominal_eq_expr($fk, $la, $ra) {
                Err($m) { Err($m) }
                Ok($one) {
                    match g6e_enum_eq_fields($allvars, $rest, $idx + 1) {
                        Err($m) { Err($m) }
                        Ok($tail) { Ok(if $tail == "" { $one } else { $one ~ " && " ~ $tail }) }
                    }
                }
            }
        }
    }
}

sub g6e_enum_eq_cases($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int): Result[Str, Str] {
    match $todo {
        CgVarNil { Ok("") }
        CgVarCons($v, $rest) {
            match g6e_enum_eq_fields($allvars, $v.fields, 0) {
                Err($m) { Err($m) }
                Ok($clauses) {
                    match g6e_enum_eq_cases($allvars, $rest, $tag + 1) {
                        Err($m) { Err($m) }
                        Ok($tail) {
                            $body = if $clauses == "" { "1LL" } else { "(" ~ $clauses ~ ") ? 1LL : 0LL" }
                            Ok("\tcase " ~ c_int($tag) ~ "LL: return " ~ $body ~ ";\n" ~ $tail)
                        }
                    }
                }
            }
        }
    }
}

sub g6e_enum_eq_helper($name: Str, $variants: CgVariantInfoList): Result[Str, Str] {
    match g6e_enum_eq_cases($variants, $variants, 0) {
        Err($m) { Err($m) }
        Ok($cases) {
            Ok("static int64_t guji_eq_" ~ $name ~ "(const " ~ $name ~ "* a, const " ~ $name ~ "* b) \{\n" ~
                "\tif (a->tag != b->tag) \{ return 0LL; }\n\tswitch (a->tag) \{\n" ~ $cases ~
                "\tdefault: return 0LL;\n\t}\n}\n\n" ~ g_nominal_collection_eq_helpers($name))
        }
    }
}

sub g8_class_rc_helpers($name: Str, $fields: CgClassFieldInfoList): Str {
    "static void guji_release_" ~ $name ~ "_fields(const " ~ $name ~ "* p);\n" ~
    "static void guji_retain_" ~ $name ~ "_fields(const " ~ $name ~ "* p);\n\n" ~
    "static void guji_release_" ~ $name ~ "_fields(const " ~ $name ~ "* p) \{\n" ~
    g8_class_rc_fields_c($fields, "release") ~
    "}\n\n" ~
    "static void guji_retain_" ~ $name ~ "_fields(const " ~ $name ~ "* p) \{\n" ~
    g8_class_rc_fields_c($fields, "retain") ~
    "}\n\n"
}

sub g8_class_box_define($name: Str, $kind: Int, $all: DeclList): Str {
    if g6e_decl_needs_class_box($all, $name, $all) { "#define GUJI_KIND_" ~ $name ~ " " ~ c_int($kind) ~ "\n" } else { "" }
}

sub g8_class_box_helpers($name: Str, $all: DeclList): Str {
    if g6e_decl_needs_class_box($all, $name, $all) {
        "static void guji_drop_" ~ $name ~ "(void* p) \{\n" ~
        "\tguji_release_" ~ $name ~ "_fields((" ~ $name ~ "*)p);\n" ~
        "\tfree(GUJI_HDR(p));\n" ~
        "}\n\n"
    } else {
        ""
    }
}

# The `#define GUJI_KIND_opt_<name>` for a heap-boxed Option-carrier layout
# (E5d-8h-3b). Emitted right after the wrapped type's own typedef (where the
# `guji_opt_<name>` carrier typedef + `guji_release_<name>_fields` helper are
# already in scope) iff some enum boxes `Option[<name>]` into a mixed union slot.
# $kind is the carrier box's runtime kind, accounting for any preceding self/class
# box of the SAME decl (g_carrier_box_kind).
sub g_carrier_box_define($name: Str, $kind: Int, $all: DeclList): Str {
    if g6e_decl_needs_carrier_box($all, $name, $all) { "#define GUJI_KIND_opt_" ~ $name ~ " " ~ c_int($kind) ~ "\n" } else { "" }
}

# The drop helper for a heap-boxed Option-carrier (E5d-8h-3b): at rc==0, release the
# active Some payload (tag-guarded recurse into the wrapped type's fields helper; a
# None slot is skipped) then free the box. The carrier layout `guji_opt_<name>` is
# identical for a class or enum wrapped type, and both emit `guji_release_<name>_fields`,
# so this one helper shape serves both.
sub g_carrier_box_helpers($name: Str, $all: DeclList): Str {
    if g6e_decl_needs_carrier_box($all, $name, $all) {
        "static void guji_drop_opt_" ~ $name ~ "(void* p) \{\n" ~
        "\tguji_opt_" ~ $name ~ "* c = (guji_opt_" ~ $name ~ "*)p;\n" ~
        "\tif (c->tag != 0LL) \{ guji_release_" ~ $name ~ "_fields(&c->val); }\n" ~
        "\tfree(GUJI_HDR(p));\n" ~
        "}\n\n"
    } else {
        ""
    }
}

# The carrier box's runtime kind = the decl's base kind plus 1 iff the same decl
# already consumes a self/class box kind before it (so the two boxes get distinct
# kinds in the source-order walk). Used by both the typedef define and the kind walk.
sub g_carrier_box_kind($base: Int, $has_prior_box: Bool): Int {
    if $has_prior_box { $base + 1 } else { $base }
}

# The per-class `Option[<Class>]` carrier typedef (E5d-7c-2d-5): a tagged struct
# embedding the class BY VALUE, tag 1 = Some, 0 = None. Emitted right after the
# wrapped class's own typedef so the by-value member type is complete and the name
# precedes any later class that uses `Option[<Class>]` as a field (the same source-
# order guarantee by-value nested class fields already rely on). It is emitted for
# every supported class; an unused carrier is a harmless extra C typedef (mirrors
# g6_result_typedefs emitting all scalar combinations unconditionally).
sub g8_class_option_typedef($name: Str): Str {
    "typedef struct guji_opt_" ~ $name ~ " \{\n\tint64_t tag;\n\t" ~ $name ~ " val;\n} guji_opt_" ~ $name ~ ";\n\n"
}

# A later class may store Result[Option[ThisClass], Str] by value.  Emit that
# program-dependent carrier as soon as ThisClass and guji_opt_ThisClass are both
# complete, before the later owner's struct definition is reached.
sub g8_class_nested_result_typedef($name: Str): Str {
    g6_result_one_typedef(CgOptClass($name), CgStr)
}

sub g8_class_typedef_one($c: ClassDecl, $all: DeclList, $kind: Int): Result[Str, Str] {
    match $c.tparams {
        StrNil {
            match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                Err($m) { Err($m) }
                Ok($fields) {
                    match g8_class_fields_c($fields) {
                        Err($m) { Err($m) }
                        Ok($body) {
                            $box_kind = $kind + 1
                            $ckind = g_carrier_box_kind($box_kind, g6e_decl_needs_class_box($all, $c.name, $all))
                            Ok(g_type_arr_define($c.name, $kind) ~ g8_class_box_define($c.name, $box_kind, $all) ~ "typedef struct " ~ $c.name ~ " " ~ $c.name ~ ";\nstruct " ~ $c.name ~ " \{\n" ~ $body ~ "};\n\n" ~ g8_class_rc_helpers($c.name, $fields) ~ g_type_arr_helper($c.name) ~ g8_class_box_helpers($c.name, $all) ~ g8_class_option_typedef($c.name) ~ g8_class_nested_result_typedef($c.name) ~ g_carrier_box_define($c.name, $ckind, $all) ~ g_carrier_box_helpers($c.name, $all))
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Class + enum typedefs are now emitted together in source order by
# g_type_typedefs (so a by-value class member inside an enum, or enum member inside
# a class, is COMPLETE before use). The per-class emitter g8_class_typedef_one is
# reused there; the old all-classes-after-all-enums walk is gone.

sub g5_ret_ctype($r: CgRet): Str {
    match $r {
        RFloat { "double" }
        RStr { "const char*" }
        REnum($n) { $n }
        RClass($n) { $n }
        ROpt($k) { g6_option_ctype($k) }
        RRes($k) { g6_result_ctype($k) }
        RList($el) { "guji_slice_t" }
        RMap($v) { "guji_map_t" }
        RBush { "guji_bush_t*" }
        RChan($el) { "guji_chan_t*" }
        RFn($p, $r) { "guji_fn_t" }
        _ { "int64_t" }
    }
}

sub g5_kind_ctype($k: CgKind): Str {
    match $k {
        CgFloat { "double" }
        CgStr { "const char*" }
        CgEnum($n) { $n }
        CgClass($n) { $n }
        CgOptInt { "guji_opt_int" }
        CgOptFloat { "guji_opt_float" }
        CgOptBool { "guji_opt_bool" }
        CgOptStr { "guji_opt_str" }
        CgOptMatch { "guji_opt_match" }
        CgOptBush { "guji_opt_bush" }
        CgMatch { "guji_match_t*" }
        CgBush { "guji_bush_t*" }
        CgHandle { "guji_reader_t*" }
        CgOptClass($n) { "guji_opt_" ~ $n }
        CgOptEnum($n) { "guji_opt_" ~ $n }
        # I6f2: CgOptList must not fall through to int64_t — return/locals already
        # use guji_opt_list via g6_option_ctype / g4_value_decl; param decls go
        # through this matcher via g5_param_decls_kinds.
        CgOptList($el) { "guji_opt_list" }
        CgOptMap($v) { "guji_opt_map" }
        CgRes($ok, $err) { g6_result_ctype($k) }
        CgList($el) { "guji_slice_t" }
        CgMap($v) { "guji_map_t" }
        CgFn($p, $r) { "guji_fn_t" }
        CgChan($el) { "guji_chan_t*" }
        _ { "int64_t" }
    }
}

# C type for a parameter from its annotated type (validated by g5_build_sig).
sub g5_typeref_ctype($ty: Option[TypeRef], $env: CgEnv): Str {
    match $ty {
        None { "int64_t" }
        Some($tr) {
            if $tr.name == "Float" {
                "double"
            } else if $tr.name == "Bool" {
                "int64_t"
            } else if $tr.name == "Str" {
                "const char*"
            } else if $tr.name == "Match" {
                "guji_match_t*"
            } else if $tr.name == "Bush" {
                "guji_bush_t*"
            } else if $tr.name == "List" {
                "guji_slice_t"
            } else if $tr.name == "Map" {
                "guji_map_t"
            } else if $tr.name == "Option" {
                match g6_option_kind_from_type_env($ty, $env) {
                    Ok($k) { g6_option_ctype($k) }
                    Err($m) { "int64_t" }
                }
            } else if $tr.name == "Result" {
                match g6_result_kind_from_type($ty, $env) {
                    Ok($k) { g6_result_ctype($k) }
                    Err($m) { "int64_t" }
                }
            } else if $tr.name == "Func" {
                "guji_fn_t"
            } else {
                # A scalar user-enum parameter is the tagged struct passed by value
                # (`<Enum> gpN`); g5_param_kind already validated it as in-subset.
                match cg_env_lookup_enum($env, $tr.name) {
                    Some($info) { $tr.name }
                    None {
                        match cg_env_lookup_class($env, $tr.name) {
                            Some($info) { $tr.name }
                            None { "int64_t" }
                        }
                    }
                }
            }
        }
    }
}

# Build the C parameter declaration list (`int64_t gp0, double gp1`). A
# 0-parameter sub uses `void` (matching `guji build`).
sub g5_param_decls($params: ParamList, $idx: Int, $env: CgEnv): Str {
    match $params {
        ParamNil { if $idx == 0 { "void" } else { "" } }
        ParamCons($head, $tail) {
            $decl = g5_typeref_ctype($head.ty, $env) ~ " gp" ~ c_int($idx)
            $rest = g5_param_decls($tail, $idx + 1, $env)
            if $rest == "" { $decl } else { $decl ~ ", " ~ $rest }
        }
    }
}

sub g5_param_decls_kinds($params: CgKindList, $idx: Int): Str {
    match $params {
        CgKindNil { if $idx == 0 { "void" } else { "" } }
        CgKindCons($head, $tail) {
            $decl = g5_kind_ctype($head) ~ " gp" ~ c_int($idx)
            $rest = g5_param_decls_kinds($tail, $idx + 1)
            if $rest == "" { $decl } else { $decl ~ ", " ~ $rest }
        }
    }
}

sub g5_lambda_param_decls($params: ParamList, $env: CgEnv): Str {
    match $params {
        ParamNil { "void* g_env" }
        _ { "void* g_env, " ~ g5_param_decls($params, 0, $env) }
    }
}

sub cg_env_without_vars($env: CgEnv): CgEnv {
    match $env {
        CgEnvNil { CgEnvNil }
        CgEnvCons($h, $t) { cg_env_without_vars($t) }
        CgEnvSub($s, $t) { CgEnvSub($s, cg_env_without_vars($t)) }
        CgEnvEnum($e, $t) { CgEnvEnum($e, cg_env_without_vars($t)) }
        CgEnvClass($c, $t) { CgEnvClass($c, cg_env_without_vars($t)) }
        CgEnvSubIdx($i, $t) { CgEnvSubIdx($i, cg_env_without_vars($t)) }
    }
}

# Parameters are borrowed by-value aliases for every kind EXCEPT channels: a
# `Chan[T]` parameter owns the +1 handle its caller retained at the call site,
# so the callee's scope-exit cleanup must release it (native's convention).
sub g5_param_borrowed($k: CgKind): Bool {
    match $k {
        CgChan($el) { false }
        _ { true }
    }
}

# Build the codegen environment for a sub body: each parameter becomes a CgVar
# bound to its positional C name `gpN` (immutable; Str params are borrowed), layered
# on top of the sub-signature environment so the body can reference parameters and
# call other subs (and itself).
sub g5_param_env($params: ParamList, $idx: Int, $base: CgEnv): Result[CgEnv, Str] {
    match $params {
        ParamNil { Ok($base) }
        ParamCons($head, $tail) {
            match g5_param_kind($head.ty, $base) {
                Err($m) { Err($m) }
                Ok($k) {
                    # Lifted lambda bodies have no callee-owned channel release
                    # site; channel params stay out of the lambda subset.
                    if !g5_param_borrowed($k) {
                        Err(g3_unsupported())
                    } else {
                        match g5_param_env($tail, $idx + 1, $base) {
                            Err($m) { Err($m) }
                            Ok($rest) { Ok(CgEnvCons(CgVar(name: $head.name, cname: "gp" ~ c_int($idx), kind: $k, mutable: false, borrowed: true, listlen: g5_param_listlen($head.ty, $k)), $rest)) }
                        }
                    }
                }
            }
        }
    }
}

sub g5_param_env_kinds($params: ParamList, $kinds: CgKindList, $idx: Int, $base: CgEnv): Result[CgEnv, Str] {
    match $params {
        ParamNil {
            match $kinds {
                CgKindNil { Ok($base) }
                _ { Err(g3_unsupported()) }
            }
        }
        ParamCons($head, $ptail) {
            match $kinds {
                CgKindNil { Err(g3_unsupported()) }
                CgKindCons($k, $ktail) {
                    match g5_param_env_kinds($ptail, $ktail, $idx + 1, $base) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok(CgEnvCons(CgVar(name: $head.name, cname: "gp" ~ c_int($idx), kind: $k, mutable: false, borrowed: g5_param_borrowed($k), listlen: g5_param_listlen($head.ty, $k)), $rest)) }
                    }
                }
            }
        }
    }
}

# §8.3 private field names are lexical aliases over the method receiver. The
# alias is borrowed: copying a Str/container/class field into a consuming value
# goes through the ordinary value lowerer and retains it, while scope cleanup
# must never release the receiver-owned field itself. Class metadata preserves
# visibility and the declared sigil so public fields do not accidentally acquire
# a `$!`/`@!`/`%!` spelling and compound fields keep their invariant shape sigil.
sub g5_private_field_env($fields: CgClassFieldInfoList, $receiver: Str, $base: CgEnv): CgEnv {
    match $fields {
        CgClassFieldNil { $base }
        CgClassFieldCons($field, $rest) {
            $tail = g5_private_field_env($rest, $receiver, $base)
            if $field.public {
                $tail
            } else {
                $acc = g8_field_acc_of($receiver, false, $field)
                $listlen = match $acc.kind {
                    CgList($el) { 0 - 1 }
                    CgMap($v) { 0 - 1 }
                    _ { 0 }
                }
                CgEnvCons(CgVar(name: $field.sigil ~ "!" ~ $field.name, cname: $acc.acc, kind: $acc.kind, mutable: false, borrowed: true, listlen: $listlen), $tail)
            }
        }
    }
}

sub g5_class_private_env($class_name: Str, $receiver: Str, $base: CgEnv): Result[CgEnv, Str] {
    match cg_env_lookup_class($base, $class_name) {
        None { Err(g3_unsupported()) }
        Some($info) { Ok(g5_private_field_env($info.fields, $receiver, $base)) }
    }
}

# Forward declaration + definition of one sub, plus the running intern state.
class SubEmit {
    has $.fwd: Str
    has $.def: Str
    has $.state: CgState
}

# The assembled program tail: all forward decls, all definitions, and the final
# accumulated intern statics.
class CgAsm {
    has $.fwds: Str
    has $.defs: Str
    has $.interns: Str
    has $.nstr: Int
}

# P7c-2b-1: one recursively emitted PEG fragment plus the next unique choice
# number. Matcher bodies use native's p/ok/capture accumulator exactly; the
# later Bush-value slice only has to call gp_<Grammar>_TOP.
class PegCOut {
    has $.code: Str
    has $.next: Int
}

class GrammarCOut {
    has $.fwds: Str
    has $.defs: Str
}

# Recognize a grammar associated parse call without adding grammar rows to the
# codegen environment. Typecheck has already proved the Pascal receiver is a
# grammar; excluding known class/enum names preserves their associated `parse`
# subs for the ordinary call resolver.
sub g10_grammar_parse_parts($callee: Expr, $args: ExprList, $env: CgEnv): Result[GrammarParseParts, Str] {
    match $callee {
        EField($obj, $method) {
            match $obj {
                ETypeName($grammar) {
                    if $method == "parse" {
                        match cg_env_lookup_class($env, $grammar) {
                            Some($c) { Err(g3_unsupported()) }
                            None {
                                match cg_env_lookup_enum($env, $grammar) {
                                    Some($e) { Err(g3_unsupported()) }
                                    None {
                                        match $args {
                                            ExprCons($input, ExprNil) { Ok(GrammarParseParts(grammar_name: $grammar, input: $input)) }
                                            _ { Err(g3_unsupported()) }
                                        }
                                    }
                                }
                            }
                        }
                    } else { Err(g3_unsupported()) }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

class GrammarParseParts {
    has $.grammar_name: Str
    has $.input: Expr
}

# `Grammar.parse(Str)` calls the already-emitted TOP matcher and accepts only a
# full-input match. Success transfers the matcher's +1 Bush into Option[Bush];
# failure (including a prefix-only match) releases any orphaned Bush.
sub g10_grammar_parse_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $kind {
        CgOptBush {
            match g10_grammar_parse_parts($callee, $args, $env) {
                Err($m) { Err($m) }
                Ok($p) {
                    match g3_str_lower($p.input, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($sv) {
                            $bush = "gbu" ~ c_int($sv.state.ntmp)
                            $end = "gi" ~ c_int($sv.state.ntmp + 1)
                            $opt = "go" ~ c_int($sv.state.ntmp + 2)
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $sv.state.interns,
                                    decls: $sv.state.decls ~
                                        "\tguji_bush_t* " ~ $bush ~ " = NULL;\n" ~
                                        "\tint64_t " ~ $end ~ " = -1;\n" ~
                                        "\tguji_opt_bush " ~ $opt ~ " = \{0};\n",
                                    body: $sv.state.body ~
                                        "\t" ~ $end ~ " = " ~ g10_peg_fn($p.grammar_name, "TOP") ~ "(" ~ $sv.tmp ~ ", 0, &" ~ $bush ~ ");\n" ~
                                        "\tif (" ~ $end ~ " >= 0 && " ~ $end ~ " == (int64_t)strlen(" ~ $sv.tmp ~ ")) \{ " ~ $opt ~ ".tag = 1; " ~ $opt ~ ".val = " ~ $bush ~ "; } else \{ guji_release((const void*)" ~ $bush ~ "); }\n" ~
                                        "\tguji_release(" ~ $sv.tmp ~ ");\n",
                                    nstr: $sv.state.nstr,
                                    ntmp: $sv.state.ntmp + 3
                                ),
                                c: $opt
                            ))
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g10_peg_fn($grammar: Str, $prod: Str): Str {
    "gp_" ~ $grammar ~ "_" ~ $prod
}

sub g10_peg_ref_count($e: PegExpr): Int {
    match $e {
        PegRef($n) { 1 }
        PegSeq($xs) { g10_peg_ref_count_list($xs) }
        PegChoice($xs) { g10_peg_ref_count_list($xs) }
        _ { 0 }
    }
}

sub g10_peg_ref_count_list($xs: PegExprList): Int {
    match $xs {
        PegNil { 0 }
        PegCons($h, $t) { g10_peg_ref_count($h) + g10_peg_ref_count_list($t) }
    }
}

sub g10_peg_emit_list($xs: PegExprList, $grammar: Str, $n: Int): PegCOut {
    match $xs {
        PegNil { PegCOut(code: "", next: $n) }
        PegCons($h, $t) {
            $a = g10_peg_emit($h, $grammar, $n)
            $b = g10_peg_emit_list($t, $grammar, $a.next)
            PegCOut(code: $a.code ~ $b.code, next: $b.next)
        }
    }
}

sub g10_peg_emit_alts($xs: PegExprList, $grammar: Str, $id: Int, $n: Int): PegCOut {
    match $xs {
        PegNil { PegCOut(code: "", next: $n) }
        PegCons($h, $t) {
            $a = g10_peg_emit($h, $grammar, $n)
            $b = g10_peg_emit_alts($t, $grammar, $id, $a.next)
            $is = c_int($id)
            PegCOut(
                code: "\t\tif (!done" ~ $is ~ ") \{\n" ~
                    "\t\t\tp = sp" ~ $is ~ ";\n" ~
                    "\t\t\tfor (gi = ncaps; gi > sn" ~ $is ~ "; gi--) \{ guji_release(caps[gi - 1]); }\n" ~
                    "\t\t\tncaps = sn" ~ $is ~ ";\n\t\t\tok = 1;\n" ~
                    $a.code ~
                    "\t\t\tif (ok) \{ done" ~ $is ~ " = 1; }\n\t\t}\n" ~ $b.code,
                next: $b.next
            )
        }
    }
}

sub g10_peg_emit($e: PegExpr, $grammar: Str, $n: Int): PegCOut {
    match $e {
        PegSeq($xs) { g10_peg_emit_list($xs, $grammar, $n) }
        PegChoice($xs) {
            $id = c_int($n)
            $alts = g10_peg_emit_alts($xs, $grammar, $n, $n + 1)
            PegCOut(
                code: "\tif (ok) \{\n\t\tint64_t sp" ~ $id ~ " = p;\n" ~
                    "\t\tint64_t sn" ~ $id ~ " = ncaps;\n\t\tint done" ~ $id ~ " = 0;\n" ~
                    $alts.code ~ "\t\tok = done" ~ $id ~ ";\n\t}\n",
                next: $alts.next
            )
        }
        PegRef($name) {
            PegCOut(code: "\tif (ok) \{\n\t\tchild = NULL;\n\t\tq = " ~ g10_peg_fn($grammar, $name) ~
                "(s, p, &child);\n\t\tif (q < 0) \{ ok = 0; } else \{\n" ~
                "\t\t\tcap_names[ncaps] = \"" ~ g2_c_escape($name) ~ "\";\n" ~
                "\t\t\tcaps[ncaps] = child;\n\t\t\tncaps++;\n\t\t\tp = q;\n\t\t}\n\t}\n", next: $n)
        }
        PegLit($text) {
            PegCOut(code: "\tif (ok) \{ q = guji_peg_lit(s, p, \"" ~ g2_c_escape($text) ~
                "\"); if (q < 0) \{ ok = 0; } else \{ p = q; } }\n", next: $n)
        }
        PegRegex($pattern) {
            PegCOut(code: "\tif (ok) \{ q = guji_peg_regex(\"" ~ g2_c_escape($pattern) ~
                "\", s, p); if (q < 0) \{ ok = 0; } else \{ p = q; } }\n", next: $n)
        }
        PegWhitespace { PegCOut(code: "\tif (ok) \{ p = guji_peg_ws(s, p); }\n", next: $n) }
    }
}

sub g10_peg_prod_def($grammar: Str, $p: Production): Result[Str, Str] {
    match peg_parse_body($p.body, $p.kind == "rule") {
        Err($e) { Err("grammar " ~ $grammar ~ " " ~ $p.kind ~ " " ~ $p.name ~ ": " ~ $e) }
        Ok($expr) {
            $slots0 = g10_peg_ref_count($expr)
            $slots = if $slots0 < 1 { 1 } else { $slots0 }
            $body = g10_peg_emit($expr, $grammar, 0).code
            Ok("static int64_t " ~ g10_peg_fn($grammar, $p.name) ~
                "(const char* s, int64_t pos0, guji_bush_t** out) \{\n" ~
                "\tconst char* cap_names[" ~ c_int($slots) ~ "] = \{0};\n" ~
                "\tguji_bush_t* caps[" ~ c_int($slots) ~ "] = \{0};\n" ~
                "\tint64_t ncaps = 0;\n\tint64_t p = pos0;\n\tint64_t q = 0;\n\tint64_t gi = 0;\n" ~
                "\tguji_bush_t* child = NULL;\n\tguji_bush_t* b = NULL;\n\tint ok = 1;\n" ~
                "\t(void)q; (void)child;\n" ~ $body ~
                "\tif (!ok) \{\n\t\tfor (gi = 0; gi < ncaps; gi++) \{ guji_release(caps[gi]); }\n\t\treturn -1;\n\t}\n" ~
                "\tb = guji_bush_new(\"" ~ g2_c_escape($p.name) ~ "\", guji_substr(s, pos0, p), ncaps);\n" ~
                "\tfor (gi = 0; gi < ncaps; gi++) \{\n\t\tb->cap_names[gi] = cap_names[gi];\n\t\tb->caps[gi] = caps[gi];\n\t}\n" ~
                "\t*out = b;\n\treturn p;\n}\n")
        }
    }
}

sub g10_peg_fwds($grammar: Str, $ps: ProductionList): Str {
    match $ps {
        ProductionNil { "" }
        ProductionCons($p, $t) {
            "static int64_t " ~ g10_peg_fn($grammar, $p.name) ~
            "(const char* s, int64_t pos0, guji_bush_t** out);\n" ~ g10_peg_fwds($grammar, $t)
        }
    }
}

sub g10_peg_defs($grammar: Str, $ps: ProductionList): Result[Str, Str] {
    match $ps {
        ProductionNil { Ok("") }
        ProductionCons($p, $t) {
            match g10_peg_prod_def($grammar, $p) {
                Err($e) { Err($e) }
                Ok($head) {
                    match g10_peg_defs($grammar, $t) {
                        Err($e) { Err($e) }
                        Ok($rest) { Ok($head ~ "\n" ~ $rest) }
                    }
                }
            }
        }
    }
}

sub g10_emit_grammar($g: GrammarDecl): Result[GrammarCOut, Str] {
    match g10_peg_defs($g.name, $g.productions) {
        Err($e) { Err($e) }
        Ok($defs) { Ok(GrammarCOut(fwds: g10_peg_fwds($g.name, $g.productions) ~ "\n", defs: $defs)) }
    }
}

# Emit one sub's forward declaration + definition, threading the running intern
# state. `$state_in` carries the accumulated interns and the GLOBAL `gs_N` counter
# but empty decls/body (those are function-local). The returned state continues
# the intern counter for the next sub.
sub g5_emit_sub_named_owner($sub: SubDecl, $sig_env: CgEnv, $state_in: CgState, $lookup_name: Str, $owner: Option[Str]): Result[SubEmit, Str] {
    match cg_env_lookup_sub($sig_env, $lookup_name) {
        None { Err(g3_unsupported()) }
        Some($sig) {
            match g5_param_env_kinds($sub.params, $sig.params, 0, $sig_env) {
                Err($m) { Err($m) }
                Ok($env0) {
                    $bodyenv: Result[CgEnv, Str] = match $owner {
                        None { Ok($env0) }
                        Some($class_name) { g5_class_private_env($class_name, "gp0", $env0) }
                    }
                    match $bodyenv {
                        Err($m) { Err($m) }
                        Ok($env1) {
                            $rk = if $sub.name == "main" { RInt } else { $sig.ret }
                            match g3_main($sub, $state_in, $env1, $rk) {
                                Err($m) { Err($m) }
                                Ok($out) {
                                    $head = "static " ~ g5_ret_ctype($rk) ~ " " ~ $sig.cname ~ "(" ~ g5_param_decls_kinds($sig.params, 0) ~ ")"
                                    $fwd = $head ~ ";\n"
                                    $def = $head ~ " \{\n" ~ $out.decls ~ $out.body ~ "\treturn " ~ $out.ret ~ ";\n}\n"
                                    $stout = CgState(interns: $out.interns, decls: "", body: "", nstr: $out.nstr, ntmp: 0)
                                    Ok(SubEmit(fwd: $fwd, def: $def, state: $stout))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_emit_sub_named($sub: SubDecl, $sig_env: CgEnv, $state_in: CgState, $lookup_name: Str): Result[SubEmit, Str] {
    g5_emit_sub_named_owner($sub, $sig_env, $state_in, $lookup_name, None)
}

sub g5_emit_sub($sub: SubDecl, $sig_env: CgEnv, $state_in: CgState): Result[SubEmit, Str] {
    g5_emit_sub_named($sub, $sig_env, $state_in, $sub.name)
}

sub g5_emit_class_sub_one($class_name: Str, $head: SubDecl, $tail: SubDeclList, $sig_env: CgEnv, $state: CgState, $owner: Option[Str]): Result[CgAsm, Str] {
    match g5_emit_sub_named_owner($head, $sig_env, $state, $class_name ~ "." ~ $head.name, $owner) {
        Err($m) { Err($m) }
        Ok($se) {
            match g5_emit_class_subs($class_name, $tail, $sig_env, $se.state) {
                Err($m) { Err($m) }
                Ok($rest) {
                    Ok(CgAsm(fwds: $se.fwd ~ $rest.fwds, defs: $se.def ~ $rest.defs, interns: $rest.interns, nstr: $rest.nstr))
                }
            }
        }
    }
}

sub g5_emit_class_subs($class_name: Str, $subs: SubDeclList, $sig_env: CgEnv, $state: CgState): Result[CgAsm, Str] {
    match $subs {
        SubDeclNil { Ok(CgAsm(fwds: "", defs: "", interns: $state.interns, nstr: $state.nstr)) }
        SubDeclCons($head, $tail) {
            if g5g_is_generic($head) {
                g5_emit_class_subs($class_name, $tail, $sig_env, $state)
            } else if is_method_sub($head) {
                g5_emit_class_sub_one($class_name, $head, $tail, $sig_env, $state, Some($class_name))
            } else {
                g5_emit_class_sub_one($class_name, $head, $tail, $sig_env, $state, None)
            }
        }
}
}

sub g5_emit_enum_method_subs($enum_name: Str, $subs: SubDeclList, $sig_env: CgEnv, $state: CgState): Result[CgAsm, Str] {
    match $subs {
        SubDeclNil { Ok(CgAsm(fwds: "", defs: "", interns: $state.interns, nstr: $state.nstr)) }
        SubDeclCons($head, $tail) {
            # Emit BOTH §9 methods and §7.5 associated functions (skip only generic
            # templates); g5_emit_sub_named lowers each body against its params.
            if g5g_is_generic($head) {
                g5_emit_enum_method_subs($enum_name, $tail, $sig_env, $state)
            } else {
                match g5_emit_sub_named($head, $sig_env, $state, $enum_name ~ "." ~ $head.name) {
                    Err($m) { Err($m) }
                    Ok($se) {
                        match g5_emit_enum_method_subs($enum_name, $tail, $sig_env, $se.state) {
                            Err($m) { Err($m) }
                            Ok($rest) {
                                Ok(CgAsm(fwds: $se.fwd ~ $rest.fwds, defs: $se.def ~ $rest.defs, interns: $rest.interns, nstr: $rest.nstr))
                            }
                        }
                    }
                }
            }
        }
    }
}

# Emit every top-level sub, accumulating forward decls + definitions and threading
# the global intern state across functions (so `gs_N` statics never collide).
sub g5_emit_all($decls: DeclList, $sig_env: CgEnv, $state: CgState): Result[CgAsm, Str] {
    match $decls {
        DeclNil { Ok(CgAsm(fwds: "", defs: "", interns: $state.interns, nstr: $state.nstr)) }
        DeclCons($head, $tail) {
            match $head {
                DSub($sub) {
                    # P5b-1: generic templates are not emitted; their monomorphized
                    # specs (ordinary appended DSub decls) are.
                    if g5g_is_generic($sub) {
                        g5_emit_all($tail, $sig_env, $state)
                    } else {
                        match g5_emit_sub($sub, $sig_env, $state) {
                            Err($m) { Err($m) }
                            Ok($se) {
                                match g5_emit_all($tail, $sig_env, $se.state) {
                                    Err($m) { Err($m) }
                                    Ok($rest) {
                                        Ok(CgAsm(fwds: $se.fwd ~ $rest.fwds, defs: $se.def ~ $rest.defs, interns: $rest.interns, nstr: $rest.nstr))
                                    }
                                }
                            }
                        }
                    }
                }
                DImport($i) { g5_emit_all($tail, $sig_env, $state) }
                DClass($c) {
                    # P5b-2d: generic template class subs are not emitted; the
                    # monomorphized specs' substituted subs are (DEnum twin below).
                    if !strlist_empty($c.tparams) {
                        g5_emit_all($tail, $sig_env, $state)
                    } else {
                        match g5_emit_class_subs($c.name, $c.subs, $sig_env, $state) {
                            Err($m) { Err($m) }
                            Ok($ca) {
                                match g5_emit_all($tail, $sig_env, CgState(interns: $ca.interns, decls: "", body: "", nstr: $ca.nstr, ntmp: 0)) {
                                    Err($m) { Err($m) }
                                    Ok($rest) {
                                        Ok(CgAsm(fwds: $ca.fwds ~ $rest.fwds, defs: $ca.defs ~ $rest.defs, interns: $rest.interns, nstr: $rest.nstr))
                                    }
                                }
                            }
                        }
                    }
                }
                DEnum($e) {
                    if !strlist_empty($e.tparams) {
                        g5_emit_all($tail, $sig_env, $state)
                    } else {
                        match g5_emit_enum_method_subs($e.name, $e.subs, $sig_env, $state) {
                            Err($m) { Err($m) }
                            Ok($ea) {
                                match g5_emit_all($tail, $sig_env, CgState(interns: $ea.interns, decls: "", body: "", nstr: $ea.nstr, ntmp: 0)) {
                                    Err($m) { Err($m) }
                                    Ok($rest) {
                                        Ok(CgAsm(fwds: $ea.fwds ~ $rest.fwds, defs: $ea.defs ~ $rest.defs, interns: $rest.interns, nstr: $rest.nstr))
                                    }
                                }
                            }
                        }
                    }
                }
                DGrammar($g) {
                    match g10_emit_grammar($g) {
                        Err($m) { Err($m) }
                        Ok($ga) {
                            match g5_emit_all($tail, $sig_env, $state) {
                                Err($m) { Err($m) }
                                Ok($rest) {
                                    Ok(CgAsm(fwds: $ga.fwds ~ $rest.fwds, defs: $ga.defs ~ $rest.defs, interns: $rest.interns, nstr: $rest.nstr))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

class CgImportOut {
    has $.env: CgEnv
    has $.typedefs: Str
    has $.drops: Str
    has $.fwds: Str
    has $.defs: Str
    has $.state: CgState
    # Canonical source paths whose C bodies have already been emitted. This is
    # threaded with the other immutable import output so sibling branches of a
    # diamond share one emission cache.
    has $.loaded: StrList
}

sub g9_import_base_env($decls: DeclList): CgEnv {
    g8_collect_classes($decls, $decls, g6e_collect_enums($decls, $decls))
}

sub g9_import_public_env($alias: Str, $decls: DeclList, $types_env: CgEnv, $tail: CgEnv): Result[CgEnv, Str] {
    g5_collect_import_public_sigs_on($alias, $decls, $types_env, cg_env_append($types_env, $tail))
}

sub g9g_skip_space(@chars: List[Str], $i: Int, $n: Int): Int {
    mut $j = $i
    mut $going = true
    while $going {
        if $j >= $n {
            $going = false
        } else {
            $c = at(@chars, $j)
            if $c == " " || $c == "\t" || $c == "\n" || $c == "\r" {
                $j = $j + 1
            } else {
                $going = false
            }
        }
    }
    $j
}

sub g9g_skip_ident(@chars: List[Str], $i: Int, $n: Int): Int {
    mut $j = $i
    mut $going = true
    while $going {
        if $j < $n && is_ident_cont(at(@chars, $j)) {
            $j = $j + 1
        } else {
            $going = false
        }
    }
    $j
}

sub g9g_source_has_generic_sub_at(@chars: List[Str], $i: Int, $n: Int): Bool {
    mut $j = $i
    mut $found = false
    mut $going = true
    while $going {
        if $j + 3 >= $n {
            $going = false
        } else if at(@chars, $j) == "s" && at(@chars, $j + 1) == "u" && at(@chars, $j + 2) == "b" {
            $ws = at(@chars, $j + 3)
            if $ws == " " || $ws == "\t" || $ws == "\n" || $ws == "\r" {
                $name_start = g9g_skip_space(@chars, $j + 3, $n)
                if $name_start < $n && is_ident_start(at(@chars, $name_start)) {
                    $after_name = g9g_skip_ident(@chars, $name_start + 1, $n)
                    $after_space = g9g_skip_space(@chars, $after_name, $n)
                    if $after_space < $n && at(@chars, $after_space) == "[" {
                        $found = true
                        $going = false
                    } else {
                        $j = $j + 1
                    }
                } else {
                    $j = $j + 1
                }
            } else {
                $j = $j + 1
            }
        } else {
            $j = $j + 1
        }
    }
    $found
}

# Cheap raw-source pre-scan for imported generic templates. The compiler's own
# `import lexer` path has no `sub name[` templates, so it stays on the old import
# emission path without touching the heavier demand scanner below.
sub g9g_source_has_generic_sub($src: Str): Bool {
    @chars = split($src, "")
    g9g_source_has_generic_sub_at(@chars, 0, @chars.count())
}

class G9gDemandAcc {
    has $.alias: Str
    has $.idecls: DeclList
    has $.specs: DeclList
    has $.names: StrList
    has $.env: CgEnv
}

sub g9g_add_qualified_spec($tpl: SubDecl, $ks: CgKindList, $a: G9gDemandAcc): G9gDemandAcc {
    match g5g_make_spec($tpl, $ks) {
        None { $a }
        Some($spec0) {
            $qname = import_qualified_name($a.alias, $spec0.name)
            if strlist_contains($a.names, $qname) {
                $a
            } else {
                $spec = SubDecl(public: true, name: $spec0.name, line: $spec0.line, col: $spec0.col, body_line: $spec0.body_line, body_col: $spec0.body_col, tparams: StrNil, params: $spec0.params, ret: $spec0.ret, body: $spec0.body)
                match g5_build_sig_as($spec, $a.env, $qname, g9_import_cname($a.alias, $spec.name), false) {
                    Err($m) {
                        G9gDemandAcc(alias: $a.alias, idecls: $a.idecls, specs: DeclCons(DSub($spec), $a.specs), names: StrCons($qname, $a.names), env: $a.env)
                    }
                    Ok($sig) {
                        G9gDemandAcc(alias: $a.alias, idecls: $a.idecls, specs: DeclCons(DSub($spec), $a.specs), names: StrCons($qname, $a.names), env: CgEnvSub($sig, $a.env))
                    }
                }
            }
        }
    }
}

sub g9g_scan_qualified_call($mod: Str, $member: Str, $args: ExprList, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    if $mod == $a.alias {
        $full = cg_env_append($locals, $a.env)
        match cg_env_lookup_sub($full, import_qualified_name($mod, $member)) {
            Some($s) { $a }
            None {
                match g5g_find_template($a.idecls, $member) {
                    None { $a }
                    Some($tpl) {
                        if $tpl.public {
                            match g5g_arg_kinds_from_exprs($args, $full) {
                                None { $a }
                                Some($ks) { g9g_add_qualified_spec($tpl, $ks, $a) }
                            }
                        } else {
                            $a
                        }
                    }
                }
            }
        }
    } else {
        $a
    }
}

sub g9g_scan_exprs($xs: ExprList, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $xs {
        ExprNil { $a }
        ExprCons($h, $t) { g9g_scan_exprs($t, $locals, g9g_scan_expr($h, $locals, $a)) }
    }
}

sub g9g_scan_opt_expr($x: Option[Expr], $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $x {
        None { $a }
        Some($e) { g9g_scan_expr($e, $locals, $a) }
    }
}

sub g9g_scan_map_entries($xs: MapEntryList, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $xs {
        MapEntryNil { $a }
        MapEntryCons($h, $t) { g9g_scan_map_entries($t, $locals, g9g_scan_expr($h.value, $locals, g9g_scan_expr($h.key, $locals, $a))) }
    }
}

sub g9g_scan_opt_stmts($xs: Option[StmtList], $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $xs {
        None { $a }
        Some($ss) { g9g_scan_stmts($ss, $locals, $a) }
    }
}

sub g9g_scan_elifs($xs: ElifList, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $xs {
        ElifNil { $a }
        ElifCons($h, $t) { g9g_scan_elifs($t, $locals, g9g_scan_stmts($h.body, $locals, g9g_scan_expr($h.cond, $locals, $a))) }
    }
}

sub g9g_scan_arms($xs: ArmList, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $xs {
        ArmNil { $a }
        ArmCons($h, $t) { g9g_scan_arms($t, $locals, g9g_scan_stmts($h.body, $locals, g9g_scan_opt_expr($h.guard, $locals, $a))) }
    }
}

sub g9g_scan_expr($e: Expr, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $e {
        EStr($text) { g9g_scan_interp($text, $locals, $a) }
        EList($items) { g9g_scan_exprs($items, $locals, $a) }
        EMap($items) { g9g_scan_map_entries($items, $locals, $a) }
        EUnary($op, $x) { g9g_scan_expr($x, $locals, $a) }
        EBinary($op, $l, $r) { g9g_scan_expr($r, $locals, g9g_scan_expr($l, $locals, $a)) }
        ENamedArg($n, $v) { g9g_scan_expr($v, $locals, $a) }
        ECall($callee, $args) {
            $a2 = g9g_scan_exprs($args, $locals, g9g_scan_expr($callee, $locals, $a))
            match $callee {
                EQualified($mod, $member) { g9g_scan_qualified_call($mod, $member, $args, $locals, $a2) }
                _ { $a2 }
            }
        }
        EField($o, $n) { g9g_scan_expr($o, $locals, $a) }
        EIndex($o, $i) { g9g_scan_expr($i, $locals, g9g_scan_expr($o, $locals, $a)) }
        EIf($c, $then, $elifs, $els) {
            g9g_scan_opt_stmts($els, $locals, g9g_scan_elifs($elifs, $locals, g9g_scan_stmts($then, $locals, g9g_scan_expr($c, $locals, $a))))
        }
        EMatch($subj, $arms) { g9g_scan_arms($arms, $locals, g9g_scan_expr($subj, $locals, $a)) }
        ELambda($ps, $rt, $bd, $tp) { g9g_scan_stmts($bd, $locals, $a) }
        EQuestion($x) { g9g_scan_expr($x, $locals, $a) }
        _ { $a }
    }
}

sub g9g_scan_interp($text: Str, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    if has_char($text, '{') {
        @chars = split($text, "")
        g9g_scan_interp_parts(@chars, 0, @chars.count(), $locals, $a)
    } else {
        $a
    }
}

sub g9g_scan_interp_parts(@chars: List[Str], $i: Int, $n: Int, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    if $i >= $n {
        $a
    } else {
        match get(@chars, $i) {
            None { $a }
            Some($c) {
                if $c == "\\" && (at(@chars, $i + 1) == '{' || at(@chars, $i + 1) == '}') {
                    g9g_scan_interp_parts(@chars, $i + 2, $n, $locals, $a)
                } else if $c == '{' {
                    match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                        None { g9g_scan_interp_parts(@chars, $i + 1, $n, $locals, $a) }
                        Some($scan) {
                            $a1 = match g3_parse_interpolation_expr($scan.text) {
                                None { $a }
                                Some($expr) { g9g_scan_expr($expr, $locals, $a) }
                            }
                            g9g_scan_interp_parts(@chars, $scan.next, $n, $locals, $a1)
                        }
                    }
                } else {
                    g9g_scan_interp_parts(@chars, $i + 1, $n, $locals, $a)
                }
            }
        }
    }
}

sub g9g_scan_sub_body($s: SubDecl, $a: G9gDemandAcc): G9gDemandAcc {
    $locals = g5g_param_locals($s.params, 0, $a.env)
    match $s.body {
        BlockBody($ss) { g9g_scan_stmts($ss, $locals, $a) }
        ExprBody($e) { g9g_scan_expr($e, $locals, $a) }
    }
}

sub g9g_scan_stmts($xs: StmtList, $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $xs {
        StmtNil { $a }
        StmtCons($h, $t) {
            match $h {
                SBind($m, $n, $ty, $v) {
                    $a1 = g9g_scan_expr($v, $locals, $a)
                    match g5g_bind_kind($ty, $v, cg_env_append($locals, $a1.env)) {
                        Some($kk) {
                            g9g_scan_stmts($t, CgEnvCons(CgVar(name: $n, cname: "", kind: $kk, mutable: $m, borrowed: true, listlen: g5_map_listlen($kk)), $locals), $a1)
                        }
                        None { g9g_scan_stmts($t, $locals, $a1) }
                    }
                }
                SReturn($v) { g9g_scan_stmts($t, $locals, g9g_scan_opt_expr($v, $locals, $a)) }
                SExpr($x) { g9g_scan_stmts($t, $locals, g9g_scan_expr($x, $locals, $a)) }
                SWhile($c, $bd) { g9g_scan_stmts($t, $locals, g9g_scan_stmts($bd, $locals, g9g_scan_expr($c, $locals, $a))) }
                SFor($vars, $iter, $bd) { g9g_scan_stmts($t, $locals, g9g_scan_stmts($bd, $locals, g9g_scan_expr($iter, $locals, $a))) }
                SHatch($bd) { g9g_scan_stmts($t, $locals, g9g_scan_stmts($bd, $locals, $a)) }
                SSelect($arms, $els) { g9g_scan_stmts($t, $locals, g9g_scan_select($arms, $els, $locals, $a)) }
            }
        }
    }
}

sub g9g_scan_select($arms: SelectArmList, $els: Option[StmtList], $locals: CgEnv, $a: G9gDemandAcc): G9gDemandAcc {
    match $arms {
        SelectArmNil { g9g_scan_opt_stmts($els, $locals, $a) }
        SelectArmCons($h, $t) {
            $a1 = g9g_scan_expr($h.op, $locals, $a)
            g9g_scan_select($t, $els, $locals, g9g_scan_stmts($h.body, $locals, $a1))
        }
    }
}

sub g9g_scan_subs($subs: SubDeclList, $a: G9gDemandAcc): G9gDemandAcc {
    match $subs {
        SubDeclNil { $a }
        SubDeclCons($h, $t) {
            if g5g_is_generic($h) {
                g9g_scan_subs($t, $a)
            } else {
                g9g_scan_subs($t, g9g_scan_sub_body($h, $a))
            }
        }
    }
}

sub g9g_scan_decls($decls: DeclList, $a: G9gDemandAcc): G9gDemandAcc {
    match $decls {
        DeclNil { $a }
        DeclCons($h, $t) {
            $a1 = match $h {
                DSub($s) { if g5g_is_generic($s) { $a } else { g9g_scan_sub_body($s, $a) } }
                DClass($c) { g9g_scan_subs($c.subs, $a) }
                DEnum($e) { g9g_scan_subs($e.subs, $a) }
                _ { $a }
            }
            g9g_scan_decls($t, $a1)
        }
    }
}

sub g9g_demand_scan_env($importer: DeclList, $tail_env: CgEnv): CgEnv {
    $base = cg_env_append(g9_import_base_env($importer), $tail_env)
    match g5_collect_sigs_indexed($importer, $base) {
        Err($m) { $base }
        Ok($sigs) { $sigs }
    }
}

sub g9g_demanded_specs($alias: Str, $importer: DeclList, $idecls: DeclList, $tail_env: CgEnv): DeclList {
    $a = g9g_scan_decls($importer, G9gDemandAcc(alias: $alias, idecls: $idecls, specs: DeclNil, names: StrNil, env: g9g_demand_scan_env($importer, $tail_env)))
    $a.specs
}

sub g9g_decls_have_sub($decls: DeclList, $name: Str): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DSub($s) { if $s.name == $name { true } else { g9g_decls_have_sub($t, $name) } }
                _ { g9g_decls_have_sub($t, $name) }
            }
        }
    }
}

sub g9g_append_new_subs($decls: DeclList, $specs: DeclList): DeclList {
    match $specs {
        DeclNil { $decls }
        DeclCons($h, $t) {
            match $h {
                DSub($s) {
                    if g9g_decls_have_sub($decls, $s.name) {
                        g9g_append_new_subs($decls, $t)
                    } else {
                        g9g_append_new_subs(g5g_decl_append($decls, DeclCons($h, DeclNil)), $t)
                    }
                }
                _ { g9g_append_new_subs($decls, $t) }
            }
        }
    }
}

sub g9g_sub_names($specs: DeclList, $acc: StrList): StrList {
    match $specs {
        DeclNil { $acc }
        DeclCons($h, $t) {
            match $h {
                DSub($s) { g9g_sub_names($t, StrCons($s.name, $acc)) }
                _ { g9g_sub_names($t, $acc) }
            }
        }
    }
}

sub g9g_expand_module_generics($decls: DeclList, $base: CgEnv, $seed: StrList): DeclList {
    match g5_collect_sigs_indexed($decls, $base) {
        Err($m) { $decls }
        Ok($sigs) {
            $a = g5g_scan_decls($decls, G5gAcc(all: $decls, specs: DeclNil, names: $seed, env: $sigs))
            g5g_decl_append($decls, $a.specs)
        }
    }
}

sub g9g_module_decls($alias: Str, $importer: DeclList, $idecls: DeclList, $tail_env: CgEnv): DeclList {
    if g5g_has_templates($idecls) {
        $demanded = g9g_demanded_specs($alias, $importer, $idecls, $tail_env)
        $with = g9g_append_new_subs($idecls, $demanded)
        g9g_expand_module_generics($with, g9_import_base_env($idecls), g9g_sub_names($demanded, StrNil))
    } else {
        $idecls
    }
}

# True iff $decls contains at least one `import`. Recursive (not a mut DeclList
# walk): reassigning a mut DeclList binding is out of the prior compiler's
# subset, so a self-compile stage would decline this helper. Frame is tiny
# (Bool only), so the ~2k-decl walk on lexer stays well under the 8MB stack —
# the danger was only running the FULL g9_emit_imports recursion (CgState/CgEnv
# frames) over lexer, which this predicate gates away.
sub g9_decls_have_import($decls: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DImport($i) { true }
                _ { g9_decls_have_import($t) }
            }
        }
    }
}

# Emit one imported module. Nested `import` decls inside that module are emitted
# first (P9-5a transitive chains: main→a→b), so the module body's qualified calls
# (`b::base()`) resolve against the nested public env. Nested public symbols are
# NOT re-exported into this module's public env for the parent — only this
# module's own `pub` subs are. Nested C (typedefs/fwds/defs) is concatenated
# ahead of this module's so callees exist before callers.
# Self-compile safety: `lexer.guji` has zero imports; the nested path is gated
# on g9_decls_have_import so the hot import of lexer never pays an extra
# recursive decl walk (that walk + this frame overflowed the 8MB stack).
sub g9_emit_one_import($source_path: Str, $imp: ImportDecl, $state: CgState, $tail_env: CgEnv, $importer: DeclList, $loaded: StrList, $stack: StrList): Result[CgImportOut, Str] {
    $path = import_source_path($source_path, $imp)
    $alias = strlist_last($imp.path)
    match read_file($path) {
        Err($e) { Err($e) }
        Ok($src) {
            match parse($src) {
                Err($m) { Err($m) }
                Ok($prog) {
                    match cg_registry_check($prog.decls) {
                        Err($m) { Err($m) }
                        Ok($rc) {
                            $mdecls0 = if g9g_source_has_generic_sub($src) {
                                g9g_module_decls($alias, $importer, $prog.decls, $tail_env)
                            } else {
                                $prog.decls
                            }
                            # I8b3: mangle class/enum names to alias_Name so two
                            # imports that declare the same PascalCase type do not
                            # redefine one C struct in the shared translation unit.
                            $mdecls = g9_mangle_import_decls($alias, $mdecls0)
                            if strlist_contains($loaded, $path) {
                                # A sibling branch already emitted this source path.
                                # Rebuild only the alias-qualified public environment
                                # needed by the current parent; emitting any C fragment
                                # again would duplicate gf_imp_* and nominal helpers.
                                $types_env = g9_import_base_env($mdecls)
                                match g9_import_public_env($alias, $mdecls, $types_env, $tail_env) {
                                    Err($m) { Err($m) }
                                    Ok($env_out) {
                                        Ok(CgImportOut(env: $env_out, typedefs: "", drops: "", fwds: "", defs: "", state: $state, loaded: $loaded))
                                    }
                                }
                            } else if g9_decls_have_import($mdecls) {
                                # Recurse with an empty parent-env tail: a nested module
                                # must not see the importer's other sibling imports, only
                                # its own transitive graph (mirrors native's per-module
                                # load). The nested module's decls are the "importer" for
                                # any deeper generic demand scan.
                                match g9_emit_imports($path, $mdecls, $state, CgEnvNil, $mdecls, $loaded, strlist_snoc($stack, $path)) {
                                    Err($m) { Err($m) }
                                    Ok($nested) {
                                        $types_env = g9_import_base_env($mdecls)
                                        match g5_collect_import_sigs($alias, $mdecls, $types_env) {
                                            Err($m) { Err($m) }
                                            Ok($local_sigs) {
                                                $sig_env = cg_env_append($local_sigs, $nested.env)
                                                match g5_emit_all($mdecls, $sig_env, $nested.state) {
                                                    Err($m) { Err($m) }
                                                    Ok($asm) {
                                                        match g_type_typedefs($mdecls, $mdecls) {
                                                            Err($m) { Err($m) }
                                                            Ok($type_defs) {
                                                                match g9_import_public_env($alias, $mdecls, $types_env, $tail_env) {
                                                                    Err($m) { Err($m) }
                                                                    Ok($env_out) {
                                                                        Ok(CgImportOut(
                                                                            env: $env_out,
                                                                            typedefs: $nested.typedefs ~ $type_defs ~ g6_result_user_typedefs($mdecls, $sig_env),
                                                                            drops: $nested.drops ~ g_type_drop_entries($mdecls, $mdecls),
                                                                            fwds: $nested.fwds ~ $asm.fwds,
                                                                            defs: $nested.defs ~ $asm.defs,
                                                                            state: CgState(interns: $asm.interns, decls: "", body: "", nstr: $asm.nstr, ntmp: 0),
                                                                            loaded: StrCons($path, $nested.loaded)
                                                                        ))
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                $types_env = g9_import_base_env($mdecls)
                                match g5_collect_import_sigs($alias, $mdecls, $types_env) {
                                    Err($m) { Err($m) }
                                    Ok($sig_env) {
                                        match g5_emit_all($mdecls, $sig_env, $state) {
                                            Err($m) { Err($m) }
                                            Ok($asm) {
                                                match g_type_typedefs($mdecls, $mdecls) {
                                                    Err($m) { Err($m) }
                                                    Ok($type_defs) {
                                                        match g9_import_public_env($alias, $mdecls, $types_env, $tail_env) {
                                                            Err($m) { Err($m) }
                                                            Ok($env_out) {
                                                                Ok(CgImportOut(
                                                                    env: $env_out,
                                                                    typedefs: $type_defs ~ g6_result_user_typedefs($mdecls, $sig_env),
                                                                    drops: g_type_drop_entries($mdecls, $mdecls),
                                                                    fwds: $asm.fwds,
                                                                    defs: $asm.defs,
                                                                    state: CgState(interns: $asm.interns, decls: "", body: "", nstr: $asm.nstr, ntmp: 0),
                                                                    loaded: StrCons($path, $loaded)
                                                                ))
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g9_emit_imports($source_path: Str, $decls: DeclList, $state: CgState, $tail_env: CgEnv, $importer: DeclList, $loaded: StrList, $stack: StrList): Result[CgImportOut, Str] {
    match $decls {
        DeclNil {
            Ok(CgImportOut(env: $tail_env, typedefs: "", drops: "", fwds: "", defs: "", state: $state, loaded: $loaded))
        }
        DeclCons($head, $tail) {
            match $head {
                DImport($imp) {
                    $path = import_source_path($source_path, $imp)
                    if strlist_contains($stack, $path) {
                        Err(import_cycle_message($stack, $path))
                    } else {
                        match g9_emit_one_import($source_path, $imp, $state, $tail_env, $importer, $loaded, $stack) {
                            Err($m) { Err($m) }
                            Ok($one) {
                                match g9_emit_imports($source_path, $tail, $one.state, $one.env, $importer, $one.loaded, $stack) {
                                    Err($m) { Err($m) }
                                    Ok($rest) {
                                        Ok(CgImportOut(
                                            env: $rest.env,
                                            typedefs: $one.typedefs ~ $rest.typedefs,
                                            drops: $one.drops ~ $rest.drops,
                                            fwds: $one.fwds ~ $rest.fwds,
                                            defs: $one.defs ~ $rest.defs,
                                            state: $rest.state,
                                            loaded: $rest.loaded
                                        ))
                                    }
                                }
                            }
                        }
                    }
                }
                _ { g9_emit_imports($source_path, $tail, $state, $tail_env, $importer, $loaded, $stack) }
            }
        }
    }
}

sub g9_interns_c($interns: Str): Str {
    if $interns == "" {
        ""
    } else {
        "/* Interned Str literals (RFC-003 §3.1): header-backed immortal statics. */\n" ~ $interns ~ "\n"
    }
}

sub g_exprlist_uses_run($xs: ExprList): Bool {
    match $xs {
        ExprNil { false }
        ExprCons($h, $t) { g_expr_uses_run($h) || g_exprlist_uses_run($t) }
    }
}

sub g_mapentries_uses_run($xs: MapEntryList): Bool {
    match $xs {
        MapEntryNil { false }
        MapEntryCons($h, $t) { g_expr_uses_run($h.key) || g_expr_uses_run($h.value) || g_mapentries_uses_run($t) }
    }
}

sub g_opt_expr_uses_run($x: Option[Expr]): Bool {
    match $x {
        Some($e) { g_expr_uses_run($e) }
        None { false }
    }
}

sub g_opt_stmts_uses_run($x: Option[StmtList]): Bool {
    match $x {
        Some($ss) { g_stmts_uses_run($ss) }
        None { false }
    }
}

sub g_elifs_uses_run($xs: ElifList): Bool {
    match $xs {
        ElifNil { false }
        ElifCons($h, $t) { g_expr_uses_run($h.cond) || g_stmts_uses_run($h.body) || g_elifs_uses_run($t) }
    }
}

sub g_pattern_uses_run($p: Pattern): Bool {
    match $p {
        PLit($e) { g_expr_uses_run($e) }
        PWild { false }
        PBind($n) { false }
        PVariant($n, $args) { g_patterns_uses_run($args) }
    }
}

sub g_patterns_uses_run($xs: PatternList): Bool {
    match $xs {
        PatNil { false }
        PatCons($h, $t) { g_pattern_uses_run($h) || g_patterns_uses_run($t) }
    }
}

sub g_arm_uses_run($arm: Arm): Bool {
    g_pattern_uses_run($arm.pat) || g_opt_expr_uses_run($arm.guard) || g_stmts_uses_run($arm.body)
}

sub g_arms_uses_run($xs: ArmList): Bool {
    match $xs {
        ArmNil { false }
        ArmCons($h, $t) { g_arm_uses_run($h) || g_arms_uses_run($t) }
    }
}

sub g_call_is_run($callee: Expr): Bool {
    match $callee {
        EName($name) { $name == "run" }
        EField($recv, $method) { $method == "run" }
        _ { false }
    }
}

sub g_expr_uses_run($e: Expr): Bool {
    match $e {
        EInt($t) { false }
        EFloat($t) { false }
        EStr($t) { false }
        ERawStr($t) { false }
        ERegex($p, $rl, $rc) { false }
        EBool($t) { false }
        EName($n) { false }
        ETypeName($n) { false }
        EQualified($m, $n) { false }
        EUnit { false }
        EList($items) { g_exprlist_uses_run($items) }
        EMap($items) { g_mapentries_uses_run($items) }
        EUnary($op, $x) { g_expr_uses_run($x) }
        EBinary($op, $l, $r) { g_expr_uses_run($l) || g_expr_uses_run($r) }
        ENamedArg($n, $v) { g_expr_uses_run($v) }
        ECall($callee, $args) { g_call_is_run($callee) || g_expr_uses_run($callee) || g_exprlist_uses_run($args) }
        EField($obj, $name) { g_expr_uses_run($obj) }
        EIndex($obj, $idx) { g_expr_uses_run($obj) || g_expr_uses_run($idx) }
        ECapture($obj, $name) { g_expr_uses_run($obj) }
        EIf($cond, $then, $elifs, $els) { g_expr_uses_run($cond) || g_stmts_uses_run($then) || g_elifs_uses_run($elifs) || g_opt_stmts_uses_run($els) }
        EMatch($subj, $arms) { g_expr_uses_run($subj) || g_arms_uses_run($arms) }
        ELambda($params, $ret, $body, $topic) { g_stmts_uses_run($body) }
        EQuestion($x) { g_expr_uses_run($x) }
    }
}

sub g_stmt_uses_run($s: Stmt): Bool {
    match $s {
        SBind($m, $n, $ty, $v) { g_expr_uses_run($v) }
        SReturn($v) { g_opt_expr_uses_run($v) }
        SExpr($e) { g_expr_uses_run($e) }
        SWhile($cond, $body) { g_expr_uses_run($cond) || g_stmts_uses_run($body) }
        SFor($vars, $iter, $body) { g_expr_uses_run($iter) || g_stmts_uses_run($body) }
        SHatch($body) { g_stmts_uses_run($body) }
        SSelect($arms, $els) { g_select_uses_run($arms) || g_opt_stmts_uses_run($els) }
    }
}

sub g_select_uses_run($arms: SelectArmList): Bool {
    match $arms {
        SelectArmNil { false }
        SelectArmCons($h, $t) { g_expr_uses_run($h.op) || g_stmts_uses_run($h.body) || g_select_uses_run($t) }
    }
}

sub g_stmts_uses_run($ss: StmtList): Bool {
    match $ss {
        StmtNil { false }
        StmtCons($h, $t) { g_stmt_uses_run($h) || g_stmts_uses_run($t) }
    }
}

sub g_body_uses_run($b: Body): Bool {
    match $b {
        BlockBody($ss) { g_stmts_uses_run($ss) }
        ExprBody($e) { g_expr_uses_run($e) }
    }
}

sub g_decls_use_run($decls: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DSub($sub) { g_body_uses_run($sub.body) || g_decls_use_run($tail) }
                _ { g_decls_use_run($tail) }
            }
        }
    }
}

# Public entry: SOURCE -> the program-specific C tail (Err on out-of-subset or
# ill-typed input). The driver concatenates the runtime prologue in front.
# typecheck_verdict gates first, so codegen only ever lowers well-typed input.
pub sub compile_program_c($src: Str): Result[Str, Str] {
    match typecheck_verdict($src) {
        TcRejectParse($m) { Err($m) }
        TcRejectType($m) { Err($m) }
        TcAccept {
            match parse($src) {
                Err($m) { Err($m) }
                Ok($prog) {
                    match cg_registry_check($prog.decls) {
                        Err($m) { Err($m) }
                        Ok($rc) {
                    match g1_find_main($prog.decls) {
                        None { Ok(g1_missing_main_program()) }
                        Some($sub) {
                            $decls1 = g8_expand_generic_classes($prog.decls)
                            $cgbase = g8_collect_classes($decls1, $decls1, g6e_collect_enums($decls1, $decls1))
                            $decls2 = g5g_expand_generics($decls1, $cgbase)
                            $decls3 = g8_expand_generic_classes($decls2)
                            $cgbase2 = g8_collect_classes($decls3, $decls3, g6e_collect_enums($decls3, $decls3))
                            match g5_collect_sigs_indexed($decls3, $cgbase2) {
                                Err($m) { Err($m) }
                                Ok($sig_env) {
                                    match g5_emit_all($decls3, $sig_env, g3_empty_state()) {
                                        Err($m) { Err($m) }
                                        Ok($asm) {
                                            match g_type_typedefs($decls3, $decls3) {
                                                Err($m) { Err($m) }
                                                Ok($type_defs) {
                                                            $proc_defs = if g_decls_use_run($prog.decls) { g_proc_typedefs() } else { "" }
                                                            # Lifted lambda/hatch helpers live with the intern block.
                                                            # Emit every carrier/user typedef and sub forward first:
                                                            # enum captures name their concrete struct and a hatch body
                                                            # may call an ordinary user sub. String statics still precede
                                                            # every sub definition that references them.
                                                            Ok(g6_option_typedefs() ~ g6_result_typedefs() ~ $proc_defs ~ $type_defs ~ g6_result_user_typedefs($decls3, $sig_env) ~ $asm.fwds ~ "\n" ~ g9_interns_c($asm.interns) ~ $asm.defs ~ g1_epilogue(g_type_drop_entries($decls3, $decls3)))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                        }
                    }
                }
            }
        }
    }
}

# Path-aware compiler entry used by the bootstrap driver. It emits leading sibling
# imports before the importing module and exposes their public subs as qualified
# call targets (`alias::name`) while their private helpers remain callable inside
# the imported C unit through alias-prefixed C names.
pub sub compile_program_c_at($path: Str, $src: Str): Result[Str, Str] {
    match typecheck_verdict_at($path, $src) {
        TcRejectParse($m) { Err($m) }
        TcRejectType($m) { Err($m) }
        TcAccept { compile_checked_program_c_at($path, $src) }
    }
}

# P8d-2c-0: the post-verdict codegen path. The compile driver's main already
# classified the program with typecheck_verdict_at (its exit-1 stage), so it
# calls this entry to avoid re-checking the whole source a second time (~1.6
# min of gen1 self-compile before the sem-table index, still whole-program
# work after it). Behavior on WELL-TYPED input is identical to
# compile_program_c_at, which remains the safe one-call entry.
pub sub compile_checked_program_c_at($path: Str, $src: Str): Result[Str, Str] {
    match parse($src) {
        Err($m) { Err($m) }
        Ok($prog) {
            match cg_registry_check($prog.decls) {
                Err($m) { Err($m) }
                Ok($rc) {
                    match g1_find_main($prog.decls) {
                        None { Ok(g1_missing_main_program()) }
                        Some($sub) {
                            match g9_emit_imports($path, $prog.decls, g3_empty_state(), CgEnvNil, $prog.decls, StrNil, StrNil) {
                                Err($m) { Err($m) }
                                Ok($imports) {
                                    $decls1 = g8_expand_generic_classes($prog.decls)
                                    $local_base = g8_collect_classes($decls1, $decls1, g6e_collect_enums($decls1, $decls1))
                                    $base = cg_env_append($local_base, $imports.env)
                                    $decls2 = g5g_expand_generics($decls1, $base)
                                    $decls3 = g8_expand_generic_classes($decls2)
                                    $local_base2 = g8_collect_classes($decls3, $decls3, g6e_collect_enums($decls3, $decls3))
                                    $base2 = cg_env_append($local_base2, $imports.env)
                                    match g5_collect_sigs_indexed($decls3, $base2) {
                                        Err($m) { Err($m) }
                                        Ok($sig_env) {
                                            match g5_emit_all($decls3, $sig_env, $imports.state) {
                                                Err($m) { Err($m) }
                                                Ok($asm) {
                                                    match g_type_typedefs($decls3, $decls3) {
                                                        Err($m) { Err($m) }
                                                        Ok($type_defs) {
                                                                    Ok(g6_option_typedefs() ~
                                                                        g6_result_typedefs() ~
                                                                        # Imports share this translation unit and may use
                                                                        # `run` even when the entry module does not (native
                                                                        # D is exactly that shape). Proc is a built-in, so
                                                                        # emitting its small carrier unconditionally here is
                                                                        # collision-free and keeps import emission stateless.
                                                                        g_proc_typedefs() ~
                                                                        $imports.typedefs ~
                                                                        $type_defs ~
                                                                        g6_result_user_typedefs($decls3, $sig_env) ~
                                                                        $imports.fwds ~
                                                                        $asm.fwds ~
                                                                        "\n" ~
                                                                        g9_interns_c($asm.interns) ~
                                                                        $imports.defs ~
                                                                        $asm.defs ~
                                                                        g1_epilogue($imports.drops ~ g_type_drop_entries($decls3, $decls3)))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# --- EB-5c diagnostic tracing -------------------------------------------------
# This traced entrypoint exists ONLY to LOCALIZE the gen2 self-compile hang (the native
# guji2c compiling its own source runs CPU-bound > 90m before any C is written,
# while the interpreter-run compiler finishes in ~14m). It is gate-NEUTRAL:
# the real driver (selfhost/compile_driver.guji) calls the untraced
# compile_program_c_at and NEVER reaches this code, so normal compiler output is
# byte-for-byte unchanged. Only selfhost/trace_driver.guji exercises it.
#
# A faithful copy of compile_program_c_at: identical calls in identical order, but
# each codegen sub-phase is preceded by a stderr phase marker. The nested shape is
# deliberate: it stays inside the same selfhost subset as compile_program_c_at.
# The last marker printed before the run stalls names the first hot /
# non-terminating phase. Behaviorally identical to compile_program_c_at.
pub sub compile_program_c_at_traced($path: Str, $src: Str): Result[Str, Str] {
    note("[trace] phase=typecheck_verdict_at start")
    match typecheck_verdict_at($path, $src) {
        TcRejectParse($m) { Err($m) }
        TcRejectType($m) { Err($m) }
        TcAccept {
            note("[trace] phase=parse start")
            match parse($src) {
                Err($m) { Err($m) }
                Ok($prog) {
                    note("[trace] phase=cg_registry_check start")
                    match cg_registry_check($prog.decls) {
                        Err($m) { Err($m) }
                        Ok($rc) {
                            note("[trace] phase=g1_find_main start")
                            match g1_find_main($prog.decls) {
                                None { Err("selfhost-codegen: program has no `main` sub") }
                                Some($sub) {
                                    note("[trace] phase=g9_emit_imports start")
                                    match g9_emit_imports($path, $prog.decls, g3_empty_state(), CgEnvNil, $prog.decls, StrNil, StrNil) {
                                        Err($m) { Err($m) }
                                        Ok($imports) {
                                            note("[trace] phase=collect_classes_enums start")
                                            $local_base = g8_collect_classes($prog.decls, $prog.decls, g6e_collect_enums($prog.decls, $prog.decls))
                                            $base = cg_env_append($local_base, $imports.env)
                                            $decls2 = g5g_expand_generics($prog.decls, $base)
                                            note("[trace] phase=g5_collect_sigs_on start")
                                            match g5_collect_sigs_indexed($decls2, $base) {
                                                Err($m) { Err($m) }
                                                Ok($sig_env) {
                                                    note("[trace] phase=g5_emit_all start")
                                                    match g5_emit_all($decls2, $sig_env, $imports.state) {
                                                        Err($m) { Err($m) }
                                                        Ok($asm) {
                                                            note("[trace] phase=g_type_typedefs start")
                                                            match g_type_typedefs($prog.decls, $prog.decls) {
                                                                Err($m) { Err($m) }
                                                                Ok($type_defs) {
                                                                    note("[trace] phase=concat start")
                                                                    Ok(g6_option_typedefs() ~
                                                                        g6_result_typedefs() ~
                                                                        (if g_decls_use_run($prog.decls) { g_proc_typedefs() } else { "" }) ~
                                                                        $imports.typedefs ~
                                                                        $type_defs ~
                                                                        g6_result_user_typedefs($prog.decls, $sig_env) ~
                                                                        $imports.fwds ~
                                                                        $asm.fwds ~
                                                                        "\n" ~
                                                                        g9_interns_c($asm.interns) ~
                                                                        $imports.defs ~
                                                                        $asm.defs ~
                                                                        g1_epilogue($imports.drops ~ g_type_drop_entries($prog.decls, $prog.decls)))
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# --- EB-5d diagnostic tracing -------------------------------------------------
# Deeper localization of the gen2 self-compile hang, one level below EB-5c.
# EB-5c localized the pre-emission stall to the driver pre-check
# `typecheck_verdict_at`; this slice breaks that pre-check into its sub-phases so a
# timed traced gen2 probe names the FIRST hot / non-terminating typecheck
# sub-phase.
#
# `typecheck_verdict_at` over the driver source (compile_driver.guji, tiny) is
# dominated by IMPORT RESOLUTION: `import lexer` makes build_import_symbols read +
# fully lex + fully parse + fully type-check the ~11k-line selfhost/lexer.guji. So
# the heavy work hides inside load_import_symbols, and these traced twins drill
# into THAT: read_file / lex / parse_decls / the four semantic-symbol builders /
# check_program_t2 over the imported module, plus the outer driver-source phases.
#
# Gate-NEUTRAL: the real driver (compile_driver.guji) calls the untraced
# typecheck_verdict_at and never reaches this code; only trace_driver.guji does.
# Behaviorally identical on the trace driver's direct `import lexer` graph (lexer
# has no imports); I8b4's nested graph validation stays in the untraced production
# loader. The only effects on that diagnostic path are stderr `[trace]` markers.
# The nested match shape is deliberate — it keeps the traced twins inside the
# same selfhost subset as their untraced originals (a flattened Result body with
# early returns and class/Result locals decline in that historical shape).

# Traced twin of load_import_symbols: marks each sub-phase of resolving ONE
# imported module (the heavy lexer.guji import). `parse` is split into lex +
# parse_decls and `build_sem_sub_table` is inlined into its four builders so the
# markers pinpoint exactly which walk over the 11k-line module stalls.
sub load_import_symbols_traced($source_path: Str, $imp: ImportDecl, $tail: SemSubTable): Result[SemSubTable, Str] {
    $path = import_source_path($source_path, $imp)
    $alias = strlist_last($imp.path)
    note("[trace] import=" ~ $path ~ " phase=read_file start")
    match read_file($path) {
        Err($e) { Err($e) }
        Ok($src) {
            note("[trace] import=" ~ $path ~ " phase=lex start")
            match lex($src) {
                Err($e) { Err($e) }
                Ok($toks) {
                    note("[trace] import=" ~ $path ~ " phase=parse_decls start")
                    match parse_decls(Parser(toks: $toks, layout: false), true) {
                        Err($e) { Err($e) }
                        Ok($rd) {
                            note("[trace] import=" ~ $path ~ " phase=build_sem_enum_names start")
                            $enum_names = build_sem_enum_names($rd.nodes)
                            note("[trace] import=" ~ $path ~ " phase=build_sem_class_names start")
                            $names = build_sem_class_names($rd.nodes, $enum_names)
                            note("[trace] import=" ~ $path ~ " phase=build_sem_enum_symbols start")
                            $enums = build_sem_enum_symbols($rd.nodes, $names)
                            note("[trace] import=" ~ $path ~ " phase=build_sem_class_symbols start")
                            $classes = build_sem_class_symbols($rd.nodes, $names, $enums)
                            note("[trace] import=" ~ $path ~ " phase=build_sem_sub_table_on start")
                            $subs = sem_table_index(build_sem_sub_table_on($rd.nodes, $classes))
                            note("[trace] import=" ~ $path ~ " phase=check_program_t2 start")
                            match check_program_t2($src, $rd.nodes, $subs) {
                                Err($e) { Err($e) }
                                Ok($msg) {
                                    note("[trace] import=" ~ $path ~ " phase=build_public_import_symbols_on start")
                                    Ok(build_public_import_symbols_on($alias, $rd.nodes, $subs, $tail))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Traced twin of build_import_symbols: identical recursion, but each DImport is
# resolved through load_import_symbols_traced.
sub build_import_symbols_traced($source_path: Str, $decls: DeclList): Result[SemSubTable, Str] {
    match $decls {
        DeclNil { Ok(SSTNil) }
        DeclCons($d, $rest) {
            match build_import_symbols_traced($source_path, $rest) {
                Err($e) { Err($e) }
                Ok($tail) {
                    match $d {
                        DImport($imp) { load_import_symbols_traced($source_path, $imp, $tail) }
                        _ { Ok($tail) }
                    }
                }
            }
        }
    }
}

# Traced twin of typecheck_verdict_at: the outer driver-source phases (its own
# lex + parse_decls are tiny) plus import resolution (heavy), semantic symbol
# construction, and the driver-source type walk. Same verdict as the untraced
# entry; only stderr markers are added.
pub sub typecheck_verdict_at_traced($path: Str, $src: Str): TcVerdict {
    note("[trace] driver-src phase=lex start")
    match lex($src) {
        Err($e) { TcRejectParse($e) }
        Ok($toks) {
            note("[trace] driver-src phase=parse_decls start")
            match parse_decls(Parser(toks: $toks, layout: false), true) {
                Err($e) { TcRejectParse($e) }
                Ok($rd) {
                    match check_top_level_name_clashes($rd.nodes) {
                        Err($e) { TcRejectType($e) }
                        Ok(()) {
                            note("[trace] driver-src phase=build_import_symbols start")
                            match build_import_symbols_traced($path, $rd.nodes) {
                                Err($e) { TcRejectParse($e) }
                                Ok($imports) {
                                    note("[trace] driver-src phase=build_sem_sub_table_with_imports start")
                                    $subs = sem_table_index(build_sem_sub_table_with_imports($rd.nodes, $imports))
                                    note("[trace] driver-src phase=check_program_t2 start")
                                    match check_program_t2($src, $rd.nodes, $subs) {
                                        Ok($msg) { TcAccept }
                                        Err($e) { TcRejectType($e) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
