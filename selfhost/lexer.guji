}

sub eval_select_send_str($arm: SelectArm, $ch: Chan[Str], $value: Str, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $sent = $ch.send($value) {
            return eval_select_run_arm($arm, eval_channel_closed_result($sent.is_ok()), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_recv_list_int($arm: SelectArm, $ch: Chan[WireIntList], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $got = $ch.recv() {
            return eval_select_run_arm($arm, eval_select_got_list_int($got), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_recv_map_str($arm: SelectArm, $ch: Chan[WireStrMap], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $got = $ch.recv() {
            return eval_select_run_arm($arm, eval_select_got_map_str($got), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_recv_enum($arm: SelectArm, $ch: Chan[WireEnum], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $got = $ch.recv() {
            return eval_select_run_arm($arm, eval_select_got_enum($got), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

# Convert guest Value → wire before the host probe. Keep the select itself in a
# flat Result-returning helper: nesting select under match else declines to a
# Unit `return 0LL` (same G4b-c shape I10e1 avoided).
sub eval_select_send_list_int_wired($arm: SelectArm, $ch: Chan[WireIntList], $w: WireIntList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $sent = $ch.send($w) {
            return eval_select_run_arm($arm, eval_channel_closed_result($sent.is_ok()), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_send_list_int($arm: SelectArm, $ch: Chan[WireIntList], $xs: ValueList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match wire_from_vlist_int($xs) {
        Err($e) { Err($e) }
        Ok($w) { eval_select_send_list_int_wired($arm, $ch, $w, $subs, $env) }
    }
}

sub eval_select_send_map_str_wired($arm: SelectArm, $ch: Chan[WireStrMap], $w: WireStrMap, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $sent = $ch.send($w) {
            return eval_select_run_arm($arm, eval_channel_closed_result($sent.is_ok()), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_send_map_str($arm: SelectArm, $ch: Chan[WireStrMap], $es: ValMapList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match wire_from_vmap_str($es) {
        Err($e) { Err($e) }
        Ok($w) { eval_select_send_map_str_wired($arm, $ch, $w, $subs, $env) }
    }
}

sub eval_select_send_enum_wired($arm: SelectArm, $ch: Chan[WireEnum], $w: WireEnum, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    select {
        $sent = $ch.send($w) {
            return eval_select_run_arm($arm, eval_channel_closed_result($sent.is_ok()), $subs, $env)
        }
        else { () }
    }
    Ok(eval_select_wait($env))
}

sub eval_select_send_enum($arm: SelectArm, $ch: Chan[WireEnum], $tag: Str, $fields: ValueList, $eid: Str, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match wire_from_vvariant($tag, $fields, $eid) {
        Err($e) { Err($e) }
        Ok($w) { eval_select_send_enum_wired($arm, $ch, $w, $subs, $env) }
    }
}

sub eval_select_send_fn($arm: SelectArm, $ch: Chan[WireEnum], $key: Str, $caps: Env, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match wire_from_vfunction($key, $caps) {
        Err($e) { Err($e) }
        Ok($w) { eval_select_send_enum_wired($arm, $ch, $w, $subs, $env) }
    }
}

sub eval_select_send_wire_coll($arm: SelectArm, $ch: Chan[WireEnum], $v: Value, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match wire_scalar_from_value($v) {
        Err($e) { Err($e) }
        Ok($w) { eval_select_send_enum_wired($arm, $ch, $w, $subs, $env) }
    }
}

sub eval_select_try_recv($arm: SelectArm, $channel: Value, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $channel {
        VChanInt($ch) { eval_select_recv_int($arm, $ch, $subs, $env) }
        VChanBool($ch) { eval_select_recv_bool($arm, $ch, $subs, $env) }
        VChanFloat($ch) { eval_select_recv_float($arm, $ch, $subs, $env) }
        VChanStr($ch) { eval_select_recv_str($arm, $ch, $subs, $env) }
        VChanListInt($ch) { eval_select_recv_list_int($arm, $ch, $subs, $env) }
        VChanMapStr($ch) { eval_select_recv_map_str($arm, $ch, $subs, $env) }
        VChanEnum($ch) { eval_select_recv_enum($arm, $ch, $subs, $env) }
        _ { Err(eval_err("select recv does not support this channel payload yet")) }
    }
}

sub eval_select_try_send($arm: SelectArm, $channel: Value, $value: Value, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $channel {
        VChanInt($ch) {
            match $value {
                VInt($v) { eval_select_send_int($arm, $ch, $v, $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        VChanBool($ch) {
            match $value {
                VBool($v) { eval_select_send_bool($arm, $ch, $v, $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        VChanFloat($ch) {
            match $value {
                VFloat($v) { eval_select_send_float($arm, $ch, $v, $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        VChanStr($ch) {
            match $value {
                VStr($v) { eval_select_send_str($arm, $ch, $v, $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        VChanListInt($ch) {
            match $value {
                VList($xs) { eval_select_send_list_int($arm, $ch, $xs, $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        VChanMapStr($ch) {
            match $value {
                VMap($es) { eval_select_send_map_str($arm, $ch, $es, $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        VChanEnum($ch) {
            match $value {
                VVariant($tag, $fields, $eid) { eval_select_send_enum($arm, $ch, $tag, $fields, $eid, $subs, $env) }
                VFunction($key, $caps) { eval_select_send_fn($arm, $ch, $key, $caps, $subs, $env) }
                VList($xs) { eval_select_send_wire_coll($arm, $ch, VList($xs), $subs, $env) }
                VMap($es) { eval_select_send_wire_coll($arm, $ch, VMap($es), $subs, $env) }
                _ { Err(eval_err("select send value does not match channel payload")) }
            }
        }
        _ { Err(eval_err("select send does not support this channel payload yet")) }
    }
}

sub eval_select_try_arm($arm: SelectArm, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $arm.op {
        ECall(EField($receiver, $method), $args) {
            match eval_expr_flow($receiver, $subs, $env) {
                Err($e) { Err($e) }
                Ok($rr) {
                    if $rr.returned {
                        Ok($rr)
                    } else if $method == "recv" {
                        eval_select_try_recv($arm, $rr.value, $subs, $rr.env)
                    } else {
                        match $args {
                            ExprCons($value_expr, ExprNil) {
                                match eval_expr_flow($value_expr, $subs, $rr.env) {
                                    Err($e) { Err($e) }
                                    Ok($vr) {
                                        if $vr.returned {
                                            Ok($vr)
                                        } else {
                                            eval_select_try_send($arm, $rr.value, $vr.value, $subs, $vr.env)
                                        }
                                    }
                                }
                            }
                            _ { Err(eval_err("select send arm expects one value argument")) }
                        }
                    }
                }
            }
        }
        _ { Err(eval_err("select arm must be a channel recv or send operation")) }
    }
}

sub eval_select_try_arms($arms: SelectArmList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $arms {
        SelectArmNil { Ok(eval_select_wait($env)) }
        SelectArmCons($arm, $rest) {
            match eval_select_try_arm($arm, $subs, $env) {
                Err($e) { Err($e) }
                Ok($r) {
                    if eval_select_is_wait($r) {
                        eval_select_try_arms($rest, $subs, $r.env)
                    } else {
                        Ok($r)
                    }
                }
            }
        }
    }
}

sub eval_select($arms: SelectArmList, $els: Option[StmtList], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $arms {
        SelectArmNil {
            match $els {
                None { Err(eval_err("select requires at least one arm")) }
                Some($body) {
                    match eval_child_block($body, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) { if $r.returned { Ok($r) } else { Ok(flow(VUnit, $r.env)) } }
                    }
                }
            }
        }
        _ {
            # Snapshot-before-poll: any channel/hatch event between the arm pass
            # and a later wait advances progress past $seen, so the wait returns
            # immediately instead of losing the wakeup (§17.5).
            $seen = __guji_progress_snapshot()
            match eval_select_try_arms($arms, $subs, $env) {
                Err($e) { Err($e) }
                Ok($r) {
                    if eval_select_is_wait($r) {
                        match $els {
                            Some($body) {
                                match eval_child_block($body, $subs, $r.env) {
                                    Err($e) { Err($e) }
                                    Ok($er) { if $er.returned { Ok($er) } else { Ok(flow(VUnit, $er.env)) } }
                                }
                            }
                            None {
                                __guji_select_wait($seen)
                                eval_select($arms, $els, $subs, $r.env)
                            }
                        }
                    } else {
                        Ok($r)
                    }
                }
            }
        }
    }
}

sub eval_stmt($s: Stmt, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $s {
        SBind($mutable, $name, $ty, $value) { eval_bind_stmt($mutable, $name, $ty, $value, $subs, $env) }
        SExpr($expr) { eval_expr_flow($expr, $subs, $env) }
        SWhile($cond, $body) { eval_while($cond, $body, $subs, $env) }
        SFor($vars, $iter, $body) { eval_for($vars, $iter, $body, $subs, $env) }
        SHatch($body) { eval_hatch($body, $subs, $env) }
        SSelect($arms, $els) { eval_select($arms, $els, $subs, $env) }
        SReturn($value) {
            match $value {
                None { Ok(return_flow(VUnit, $env)) }
                Some($expr) {
                    match eval_expr_flow($expr, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                Ok(return_flow($r.value, $r.env))
                            }
                        }
                    }
                }
            }
        }
    }
}

sub eval_stmt_ret($s: Stmt, $ret: Option[TypeRef], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $s {
        SExpr($expr) { eval_expr_chan_ctx($expr, $ret, $subs, $env) }
        SReturn($value) {
            match $value {
                None { Ok(return_flow(VUnit, $env)) }
                Some($expr) {
                    match eval_expr_chan_ctx($expr, $ret, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                Ok(return_flow($r.value, $r.env))
                            }
                        }
                    }
                }
            }
        }
        _ { eval_stmt($s, $subs, $env) }
    }
}

sub eval_stmt_list_ret($stmts: StmtList, $ret: Option[TypeRef], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $stmts {
        StmtNil { Ok(flow(VUnit, $env)) }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil { eval_stmt_ret($head, $ret, $subs, $env) }
                _ {
                    match eval_stmt($head, $subs, $env) {
                        Err($e) { Err($e) }
                        Ok($r) {
                            if $r.returned {
                                Ok($r)
                            } else {
                                eval_stmt_list_ret($tail, $ret, $subs, $r.env)
                            }
                        }
                    }
                }
            }
        }
    }
}

sub eval_stmt_list($stmts: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    eval_stmt_list_ret($stmts, None, $subs, $env)
}

sub eval_body_ret($body: Body, $ret: Option[TypeRef], $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $body {
        BlockBody($stmts) { eval_stmt_list_ret($stmts, $ret, $subs, $env) }
        ExprBody($expr) { eval_expr_chan_ctx($expr, $ret, $subs, $env) }
    }
}

sub eval_body($body: Body, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    eval_body_ret($body, None, $subs, $env)
}

sub first_sub($decls: DeclList): Result[SubDecl, Str] {
    match $decls {
        DeclNil { Err(eval_err("no sub declaration to evaluate")) }
        DeclCons($d, $rest) {
            match $d {
                DImport($i) { first_sub($rest) }
                DSub($s) { Ok($s) }
                DClass($c) { first_sub($rest) }
                DEnum($e) { first_sub($rest) }
                DGrammar($g) { first_sub($rest) }
            }
        }
    }
}

# Test-facing E2 entry: parse a source module, evaluate the first sub body in a
# fresh frame, and return only its final value. E4 owns the real main driver and
# canonical environment dump; this helper exists so E2 fixtures can exercise
# statements/block/if semantics without implementing calls or the final driver.
pub sub eval_first_sub_to_string($src: Str): Result[Str, Str] {
    match parse($src) {
        Err($e) { Err($e) }
        Ok($prog) {
            $subs = build_sub_table($prog.decls)
            match first_sub($prog.decls) {
                Err($e) { Err($e) }
                Ok($s) {
                    match eval_body($s.body, $subs, EnvFrame(BindNil, EnvNil)) {
                        Err($e) { Err($e) }
                        Ok($r) { Ok(display_value($r.value)) }
                    }
                }
            }
        }
    }
}

# ---------------------------------------------------------------------------
# E3: functions + calls + UFCS + match + collections.
#
# All of the below resolve through the sub-table threaded as `$subs`. Calls bind
# params in a FRESH frame (subs are not closures over the caller's locals — only
# params + other top-level subs are visible). UFCS is desugared to a name call in
# `eval_call`. `match` selects the first arm whose pattern matches and whose guard
# (if any) holds, binding captures in a child scope. Collections evaluate their
# elements left-to-right. Every helper threads the value+env+return-flow contract
# so an early `return` or outer-mutable update inside an argument/element/guard
# propagates exactly as the oracle's does.
# ---------------------------------------------------------------------------

# The result of evaluating an argument/element list: the collected values (in
# source order), the threaded environment, and an optional early-return EvalResult
# if some element executed a `return` before the list finished.
class ArgsEval {
    has $.values: ValueList
    has $.env: Env
    has $.early: Option[EvalResult]
}

sub eval_args($args: ExprList, $subs: SubTable, $env: Env): Result[ArgsEval, Str] {
    match $args {
        ExprNil { Ok(ArgsEval(values: ValNil, env: $env, early: None)) }
        ExprCons($a, $rest) {
            match eval_expr_flow($a, $subs, $env) {
                Err($e) { Err($e) }
                Ok($r) {
                    if $r.returned {
                        Ok(ArgsEval(values: ValNil, env: $r.env, early: Some($r)))
                    } else {
                        match eval_args($rest, $subs, $r.env) {
                            Err($e) { Err($e) }
                            Ok($tail) {
                                match $tail.early {
                                    Some($er) { Ok($tail) }
                                    None { Ok(ArgsEval(values: ValCons($r.value, $tail.values), env: $tail.env, early: None)) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Bind positional argument values to a sub's parameters in a fresh binding list
# (params are immutable). Arity mismatch is a runtime error here (the oracle
# rejects it at type-check; both reject, so accept/reject still agree).
sub bind_params($params: ParamList, $values: ValueList, $acc: Bindings): Result[Bindings, Str] {
    match $params {
        ParamNil {
            match $values {
                ValNil { Ok($acc) }
                _ { Err(eval_err("too many arguments in call")) }
            }
        }
        ParamCons($p, $prest) {
            match $values {
                ValNil { Err(eval_err("too few arguments in call")) }
                ValCons($v, $vrest) { bind_params($prest, $vrest, bind_append($acc, $p.name, false, $v)) }
            }
        }
    }
}

# Bootstrap-safe function values store a canonical AST key rather than copying
# recursive compiler AST nodes into Value. Resolve that key against the program's
# already-owned declarations when the function is applied. Identical lambda ASTs
# are interchangeable in I4a because they carry no environment.
sub find_lambda_exprs($xs: ExprList, $key: Str): Option[Expr] {
    match $xs {
        ExprNil { None }
        ExprCons($head, $tail) {
            match find_lambda_expr($head, $key) {
                Some($e) { Some($e) }
                None { find_lambda_exprs($tail, $key) }
            }
        }
    }
}

sub find_lambda_map_entries($xs: MapEntryList, $key: Str): Option[Expr] {
    match $xs {
        MapEntryNil { None }
        MapEntryCons($head, $tail) {
            match find_lambda_expr($head.key, $key) {
                Some($e) { Some($e) }
                None {
                    match find_lambda_expr($head.value, $key) {
                        Some($e) { Some($e) }
                        None { find_lambda_map_entries($tail, $key) }
                    }
                }
            }
        }
    }
}

sub find_lambda_stmts($stmts: StmtList, $key: Str): Option[Expr] {
    match $stmts {
        StmtNil { None }
        StmtCons($head, $tail) {
            match find_lambda_stmt($head, $key) {
                Some($e) { Some($e) }
                None { find_lambda_stmts($tail, $key) }
            }
        }
    }
}

sub find_lambda_stmt($stmt: Stmt, $key: Str): Option[Expr] {
    match $stmt {
        SBind($m, $n, $ty, $value) { find_lambda_expr($value, $key) }
        SReturn($value) {
            match $value {
                None { None }
                Some($e) { find_lambda_expr($e, $key) }
            }
        }
        SExpr($e) { find_lambda_expr($e, $key) }
        SWhile($cond, $body) {
            match find_lambda_expr($cond, $key) {
                Some($e) { Some($e) }
                None { find_lambda_stmts($body, $key) }
            }
        }
        SFor($vars, $iter, $body) {
            match find_lambda_expr($iter, $key) {
                Some($e) { Some($e) }
                None { find_lambda_stmts($body, $key) }
            }
        }
        SHatch($body) { find_lambda_stmts($body, $key) }
        SSelect($arms, $els) {
            match find_lambda_select_arms($arms, $key) {
                Some($e) { Some($e) }
                None {
                    match $els {
                        None { None }
                        Some($body) { find_lambda_stmts($body, $key) }
                    }
                }
            }
        }
    }
}

sub find_lambda_select_arms($arms: SelectArmList, $key: Str): Option[Expr] {
    match $arms {
        SelectArmNil { None }
        SelectArmCons($head, $tail) {
            match find_lambda_expr($head.op, $key) {
                Some($e) { Some($e) }
                None {
                    match find_lambda_stmts($head.body, $key) {
                        Some($e) { Some($e) }
                        None { find_lambda_select_arms($tail, $key) }
                    }
                }
            }
        }
    }
}

sub find_lambda_elifs($elifs: ElifList, $key: Str): Option[Expr] {
    match $elifs {
        ElifNil { None }
        ElifCons($head, $tail) {
            match find_lambda_expr($head.cond, $key) {
                Some($e) { Some($e) }
                None {
                    match find_lambda_stmts($head.body, $key) {
                        Some($e) { Some($e) }
                        None { find_lambda_elifs($tail, $key) }
                    }
                }
            }
        }
    }
}

sub find_lambda_arms($arms: ArmList, $key: Str): Option[Expr] {
    match $arms {
        ArmNil { None }
        ArmCons($head, $tail) {
            $in_guard = match $head.guard {
                None { None }
                Some($g) { find_lambda_expr($g, $key) }
            }
            match $in_guard {
                Some($e) { Some($e) }
                None {
                    match find_lambda_stmts($head.body, $key) {
                        Some($e) { Some($e) }
                        None { find_lambda_arms($tail, $key) }
                    }
                }
            }
        }
    }
}

sub find_lambda_expr($expr: Expr, $key: Str): Option[Expr] {
    match $expr {
        EList($xs) { find_lambda_exprs($xs, $key) }
        EMap($xs) { find_lambda_map_entries($xs, $key) }
        EUnary($op, $e) { find_lambda_expr($e, $key) }
        EBinary($op, $left, $right) {
            match find_lambda_expr($left, $key) {
                Some($e) { Some($e) }
                None { find_lambda_expr($right, $key) }
            }
        }
        ENamedArg($name, $value) { find_lambda_expr($value, $key) }
        ECall($callee, $args) {
            match find_lambda_expr($callee, $key) {
                Some($e) { Some($e) }
                None { find_lambda_exprs($args, $key) }
            }
        }
        EField($object, $name) { find_lambda_expr($object, $key) }
        EIndex($object, $index) {
            match find_lambda_expr($object, $key) {
                Some($e) { Some($e) }
                None { find_lambda_expr($index, $key) }
            }
        }
        ECapture($object, $name) { find_lambda_expr($object, $key) }
        EIf($cond, $then, $elifs, $els) {
            match find_lambda_expr($cond, $key) {
                Some($e) { Some($e) }
                None {
                    match find_lambda_stmts($then, $key) {
                        Some($e) { Some($e) }
                        None {
                            match find_lambda_elifs($elifs, $key) {
                                Some($e) { Some($e) }
                                None {
                                    match $els {
                                        None { None }
                                        Some($body) { find_lambda_stmts($body, $key) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        EMatch($subject, $arms) {
            match find_lambda_expr($subject, $key) {
                Some($e) { Some($e) }
                None { find_lambda_arms($arms, $key) }
            }
        }
        ELambda($params, $ret, $body, $topic) {
            if canon_expr($expr) == $key {
                Some($expr)
            } else {
                find_lambda_stmts($body, $key)
            }
        }
        EQuestion($e) { find_lambda_expr($e, $key) }
        _ { None }
    }
}

sub find_lambda_body($body: Body, $key: Str): Option[Expr] {
    match $body {
        BlockBody($stmts) { find_lambda_stmts($stmts, $key) }
        ExprBody($expr) { find_lambda_expr($expr, $key) }
    }
}

sub find_lambda_subs($subs: SubDeclList, $key: Str): Option[Expr] {
    match $subs {
        SubDeclNil { None }
        SubDeclCons($head, $tail) {
            match find_lambda_body($head.body, $key) {
                Some($e) { Some($e) }
                None { find_lambda_subs($tail, $key) }
            }
        }
    }
}

sub find_lambda_table($table: SubTable, $key: Str): Option[Expr] {
    match $table {
        SubTNil { None }
        SubTCons($name, $sub, $tail) {
            match find_lambda_body($sub.body, $key) {
                Some($e) { Some($e) }
                None { find_lambda_table($tail, $key) }
            }
        }
        SubTClass($name, $cls, $tail) {
            match find_lambda_subs($cls.subs, $key) {
                Some($e) { Some($e) }
                None { find_lambda_table($tail, $key) }
            }
        }
        SubTEnum($name, $en, $tail) {
            match find_lambda_subs($en.subs, $key) {
                Some($e) { Some($e) }
                None { find_lambda_table($tail, $key) }
            }
        }
        SubTGrammar($name, $g, $tail) { find_lambda_table($tail, $key) }
    }
}

# Key for a top-level `sub` materialized as a function value (I7g). Distinct
# from canon_expr(ELambda…); call_list_hof_fn resolves it via SubTable.
sub named_sub_fn_key($name: Str): Str {
    "NamedSub:" ~ $name
}

sub named_sub_fn_name($key: Str): Option[Str] {
    if starts_with($key, "NamedSub:") {
        Some(drop(split($key, ""), 9).join(""))
    } else {
        None
    }
}

# Apply a NamedSub:… function value through the ordinary user-sub body path
# (EnvNil parent — top-level subs do not capture). Kept beside call_list_hof_fn
# so that helper's None arm stays shallow for bootstrap codegen.
sub call_named_sub_fn($key: Str, $args: ValueList, $subs: SubTable): Result[Value, Str] {
    match named_sub_fn_name($key) {
        None { Err(eval_err("function body is unavailable")) }
        Some($name) {
            @parts: List[Str] = split($name, "::")
            $scoped = if @parts.count() == 2 { imported_eval_scope(@parts[0], $subs) } else { $subs }
            match subtable_lookup($scoped, $name) {
                None { Err(eval_err("function body is unavailable")) }
                Some($sub) {
                    match bind_params($sub.params, $args, BindNil) {
                        Err($e) { Err($e) }
                        Ok($frame) {
                            match eval_body($sub.body, $scoped, EnvFrame($frame, EnvNil)) {
                                Err($e) { Err($e) }
                                Ok($br) { Ok($br.value) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Apply an evaluated function value. I4a–I4c admit parameterized and topic-block
# lambdas; I7g also admits NamedSub keys for bare top-level subs. Evaluate
# arguments in the caller, then reuse call_list_hof_fn so lambda and named-sub
# application share one body-resolution path.
sub eval_call_value($callee: Value, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $callee {
        VFunction($key, $caps) {
            match eval_args($args, $subs, $env) {
                Err($e) { Err($e) }
                Ok($ar) {
                    match $ar.early {
                        Some($er) { Ok($er) }
                        None {
                            match call_list_hof_fn($callee, $ar.values, $subs) {
                                Err($e) { Err($e) }
                                Ok($v) { Ok(flow($v, $ar.env)) }
                            }
                        }
                    }
                }
            }
        }
        _ { Err(eval_err("expression is not callable")) }
    }
}

# §15.1 List HOF walker (I5e/I5e2). Beside eval_call_value; no fresh
# eval_args edge. Callback application is factored out so this recursive
# function stays shallow enough for bootstrap codegen. ValueList result is
# the transformed/filtered list, empty for each, zero/one values for find, or
# the reduce accumulator as a one-value state list, or alternating key/value
# pairs for sort_by. That pair state keeps callback evaluation single-shot and
# avoids a second recursive HOF walker on the bootstrap-critical evaluator edge.
sub call_list_hof_fn($fn: Value, $args: ValueList, $subs: SubTable): Result[Value, Str] {
    match $fn {
        VFunction($key, $caps) {
            match find_lambda_table($subs, $key) {
                None { call_named_sub_fn($key, $args, $subs) }
                Some($lambda) {
                    match $lambda {
                        ELambda($params, $ret, $body, $topic) {
                            match bind_params($params, $args, BindNil) {
                                Err($e) { Err($e) }
                                Ok($frame) {
                                    match eval_stmt_list($body, $subs, EnvFrame($frame, $caps)) {
                                        Err($e) { Err($e) }
                                        Ok($br) { Ok($br.value) }
                                    }
                                }
                            }
                        }
                        _ { Err(eval_err("function body is unavailable")) }
                    }
                }
            }
        }
        _ { Err(eval_err("expression is not callable")) }
    }
}

# Stable sort_by state is `[key, value, key, value, ...]`. Insert after existing
# equal keys so source order is preserved. Keys are the §15.1 ordered scalar set.
sub vlist_sort_by_insert($pairs: ValueList, $key: Value, $value: Value): Result[ValueList, Str] {
    match $pairs {
        ValNil { Ok(ValCons($key, ValCons($value, ValNil))) }
        ValCons($old_key, ValCons($old_value, $rest)) {
            match value_cmp($key, $old_key) {
                Err($e) { Err($e) }
                Ok($c) {
                    if $c < 0 {
                        Ok(ValCons($key, ValCons($value, $pairs)))
                    } else {
                        match vlist_sort_by_insert($rest, $key, $value) {
                            Err($e) { Err($e) }
                            Ok($tail) { Ok(ValCons($old_key, ValCons($old_value, $tail))) }
                        }
                    }
                }
            }
        }
        _ { Err(eval_err("sort_by internal key/value state is malformed")) }
    }
}

sub vlist_sort_by_values($pairs: ValueList): ValueList {
    match $pairs {
        ValNil { ValNil }
        ValCons($key, ValCons($value, $rest)) {
            ValCons($value, vlist_sort_by_values($rest))
        }
        _ { ValNil }
    }
}

sub vlist_hof($op: Str, $xs: ValueList, $fn: Value, $subs: SubTable, $state: ValueList): Result[ValueList, Str] {
    match $xs {
        ValNil { Ok($state) }
        ValCons($h, $t) {
            if $op == "reduce" {
                match $state {
                    ValCons($acc, ValNil) {
                        match call_list_hof_fn($fn, ValCons($acc, ValCons($h, ValNil)), $subs) {
                            Err($e) { Err($e) }
                            Ok($next) { vlist_hof($op, $t, $fn, $subs, ValCons($next, ValNil)) }
                        }
                    }
                    _ { Err(eval_err("reduce accumulator is unavailable")) }
                }
            } else {
                match call_list_hof_fn($fn, ValCons($h, ValNil), $subs) {
                    Err($e) { Err($e) }
                    Ok($v) {
                        if $op == "find" {
                            match $v {
                                VBool($yes) {
                                    if $yes { Ok(ValCons($h, ValNil)) } else { vlist_hof($op, $t, $fn, $subs, $state) }
                                }
                                _ { Err(eval_err("find predicate must return Bool")) }
                            }
                        } else if $op == "sort_by" {
                            match $v {
                                VInt($i) {
                                    match vlist_sort_by_insert($state, $v, $h) {
                                        Err($e) { Err($e) }
                                        Ok($next) { vlist_hof($op, $t, $fn, $subs, $next) }
                                    }
                                }
                                VFloat($f) {
                                    match vlist_sort_by_insert($state, $v, $h) {
                                        Err($e) { Err($e) }
                                        Ok($next) { vlist_hof($op, $t, $fn, $subs, $next) }
                                    }
                                }
                                VStr($s) {
                                    match vlist_sort_by_insert($state, $v, $h) {
                                        Err($e) { Err($e) }
                                        Ok($next) { vlist_hof($op, $t, $fn, $subs, $next) }
                                    }
                                }
                                _ { Err(eval_err("sort_by key must be Int, Float, or Str")) }
                            }
                        } else {
                            match vlist_hof($op, $t, $fn, $subs, $state) {
                                Err($e) { Err($e) }
                                Ok($rest) {
                                    if $op == "map" {
                                        Ok(ValCons($v, $rest))
                                    } else if $op == "each" {
                                        Ok(ValNil)
                                    } else {
                                        match $v {
                                            VBool($keep) {
                                                if $keep { Ok(ValCons($h, $rest)) } else { Ok($rest) }
                                            }
                                            _ { Err(eval_err("filter predicate must return Bool")) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# §15.1 folds/ordering helpers (I5f). Placed beside the HOF walker so the
# mutation apply arm stays a single flat call into apply_list_fold.
sub vlist_rev_go($xs: ValueList, $acc: ValueList): ValueList {
    match $xs {
        ValNil { $acc }
        ValCons($h, $t) { vlist_rev_go($t, ValCons($h, $acc)) }
    }
}

sub vlist_take($xs: ValueList, $n: Int): ValueList {
    if $n <= 0 {
        ValNil
    } else {
        match $xs {
            ValNil { ValNil }
            ValCons($h, $t) { ValCons($h, vlist_take($t, $n - 1)) }
        }
    }
}

sub vlist_drop($xs: ValueList, $n: Int): ValueList {
    if $n <= 0 {
        $xs
    } else {
        match $xs {
            ValNil { ValNil }
            ValCons($h, $t) { vlist_drop($t, $n - 1) }
        }
    }
}

# Stable ascending insert: place `$v` before the first strictly greater element.
sub vlist_insert_sorted($xs: ValueList, $v: Value): Result[ValueList, Str] {
    match $xs {
        ValNil { Ok(ValCons($v, ValNil)) }
        ValCons($h, $t) {
            match value_cmp($v, $h) {
                Err($e) { Err($e) }
                Ok($c) {
                    if $c < 0 {
                        Ok(ValCons($v, $xs))
                    } else {
                        match vlist_insert_sorted($t, $v) {
                            Err($e) { Err($e) }
                            Ok($rest) { Ok(ValCons($h, $rest)) }
                        }
                    }
                }
            }
        }
    }
}

sub vlist_sort_go($xs: ValueList, $acc: ValueList): Result[ValueList, Str] {
    match $xs {
        ValNil { Ok($acc) }
        ValCons($h, $t) {
            match vlist_insert_sorted($acc, $h) {
                Err($e) { Err($e) }
                Ok($next) { vlist_sort_go($t, $next) }
            }
        }
    }
}

sub vlist_sum_acc($xs: ValueList, $acc: Value): Result[Value, Str] {
    match $xs {
        ValNil { Ok($acc) }
        ValCons($h, $t) {
            match eval_arith("+", $acc, $h) {
                Err($e) { Err($e) }
                Ok($next) { vlist_sum_acc($t, $next) }
            }
        }
    }
}

sub vlist_sum($xs: ValueList): Result[Value, Str] {
    match $xs {
        ValNil { Ok(VInt(0)) }
        ValCons($h, $t) { vlist_sum_acc($t, $h) }
    }
}

sub vlist_better($op: Str, $cand: Value, $cur: Value): Result[Bool, Str] {
    match value_cmp($cand, $cur) {
        Err($e) { Err($e) }
        Ok($c) {
            if $op == "max" {
                Ok($c > 0)
            } else {
                Ok($c < 0)
            }
        }
    }
}

sub vlist_minmax_acc($op: Str, $xs: ValueList, $acc: Value): Result[Value, Str] {
    match $xs {
        ValNil { Ok($acc) }
        ValCons($h, $t) {
            match vlist_better($op, $h, $acc) {
                Err($e) { Err($e) }
                Ok($yes) {
                    if $yes {
                        vlist_minmax_acc($op, $t, $h)
                    } else {
                        vlist_minmax_acc($op, $t, $acc)
                    }
                }
            }
        }
    }
}

sub vlist_minmax($op: Str, $xs: ValueList): Result[Value, Str] {
    match $xs {
        ValNil { Err(eval_err($op ~ " of an empty list")) }
        ValCons($h, $t) { vlist_minmax_acc($op, $t, $h) }
    }
}

# Dispatch §15.1 sum/min/max/reverse/take/drop/sort over already-evaluated args.
sub apply_list_fold($n: Str, $vals: ValueList, $env: Env): Result[EvalResult, Str] {
    $argc = vlist_len($vals)
    if $n == "take" || $n == "drop" {
        match $vals {
            ValCons(VList($xs), ValCons(VInt($k), ValNil)) {
                if $n == "take" {
                    Ok(flow(VList(vlist_take($xs, $k)), $env))
                } else {
                    Ok(flow(VList(vlist_drop($xs, $k)), $env))
                }
            }
            _ { Err(eval_err($n ~ " expects a List and an Int (got " ~ "{ $argc }" ~ " args)")) }
        }
    } else {
        match $vals {
            ValCons(VList($xs), ValNil) {
                if $n == "reverse" {
                    Ok(flow(VList(vlist_rev_go($xs, ValNil)), $env))
                } else if $n == "sort" {
                    match vlist_sort_go($xs, ValNil) {
                        Err($e) { Err($e) }
                        Ok($out) { Ok(flow(VList($out), $env)) }
                    }
                } else if $n == "sum" {
                    match vlist_sum($xs) {
                        Err($e) { Err($e) }
                        Ok($v) { Ok(flow($v, $env)) }
                    }
                } else {
                    match vlist_minmax($n, $xs) {
                        Err($e) { Err($e) }
                        Ok($v) { Ok(flow($v, $env)) }
                    }
                }
            }
            _ { Err(eval_err($n ~ " expects 1 List argument(s), got " ~ "{ $argc }")) }
        }
    }
}

# Evaluate a user `sub` call: evaluate the arguments in the CALLER's env, bind the
# parameters in a fresh frame rooted at EnvNil (no caller-local capture), evaluate
# the body, and yield the body's value with the caller's (post-argument) env. An
# explicit `return` inside the body is consumed at the call boundary (returned is
# cleared); an early return that happened while evaluating an ARGUMENT propagates.
sub eval_call_user($sub: SubDecl, $args: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($args, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None {
                    match bind_params($sub.params, $ar.values, BindNil) {
                        Err($e) { Err($e) }
                        Ok($frame) {
                            match eval_body_ret($sub.body, $sub.ret, $subs, EnvFrame($frame, EnvNil)) {
                                Err($e) { Err($e) }
                                Ok($br) { Ok(flow($br.value, $ar.env)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# `[a, b, c]` -> VList. Elements evaluate left-to-right (eval_args), preserving
# source order (the oracle's ListVal renders in insertion order).
sub eval_list($items: ExprList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_args($items, $subs, $env) {
        Err($e) { Err($e) }
        Ok($ar) {
            match $ar.early {
                Some($er) { Ok($er) }
                None { Ok(flow(VList($ar.values), $ar.env)) }
            }
        }
    }
}

# Insert or update a map entry by key (last value wins, like the oracle's Go map).
# Display sorts keys, so the stored order is irrelevant for the differential.
sub vmap_put($entries: ValMapList, $key: Str, $value: Value): ValMapList {
    match $entries {
        ValMapNil { ValMapCons(ValMapEntry(key: $key, value: $value), ValMapNil) }
        ValMapCons($h, $t) {
            if $h.key == $key {
                ValMapCons(ValMapEntry(key: $key, value: $value), $t)
            } else {
                ValMapCons($h, vmap_put($t, $key, $value))
            }
        }
    }
}

# Persistent removal. A missing key is a no-op value-wise; rebuilding the spine
# is unobservable because maps have structural equality and no identity.
sub vmap_remove($entries: ValMapList, $key: Str): ValMapList {
    match $entries {
        ValMapNil { ValMapNil }
        ValMapCons($h, $t) {
            if $h.key == $key {
                $t
            } else {
                ValMapCons($h, vmap_remove($t, $key))
            }
        }
    }
}

sub vmap_lookup($es: ValMapList, $key: Str): Option[Value] {
    match $es {
        ValMapNil { None }
        ValMapCons($h, $t) {
            if $h.key == $key { Some($h.value) } else { vmap_lookup($t, $key) }
        }
    }
}

# `{"k": v, ...}` -> VMap. Keys must evaluate to Str (the oracle requires Str map
# keys); values are arbitrary. Entries evaluate key then value, left-to-right.
sub eval_map($items: MapEntryList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    eval_map_into($items, $subs, $env, ValMapNil)
}

sub eval_map_into($items: MapEntryList, $subs: SubTable, $env: Env, $acc: ValMapList): Result[EvalResult, Str] {
    match $items {
        MapEntryNil { Ok(flow(VMap($acc), $env)) }
        MapEntryCons($entry, $rest) {
            match eval_expr_flow($entry.key, $subs, $env) {
                Err($e) { Err($e) }
                Ok($kr) {
                    if $kr.returned {
                        Ok($kr)
                    } else {
                        match $kr.value {
                            VStr($k) {
                                match eval_expr_flow($entry.value, $subs, $kr.env) {
                                    Err($e) { Err($e) }
                                    Ok($vr) {
                                        if $vr.returned {
                                            Ok($vr)
                                        } else {
                                            eval_map_into($rest, $subs, $vr.env, vmap_put($acc, $k, $vr.value))
                                        }
                                    }
                                }
                            }
                            _ { Err(eval_err("map key must be Str")) }
                        }
                    }
                }
            }
        }
    }
}

# Subscript: `obj[idx]`. The parser normalizes both §2.4 postfix forms into EIndex:
# `@xs[i]` selects a List element and `%m{key}` selects a Map value. Evaluate the
# receiver before the index/key and preserve arbitrary nested Value payloads. Both
# out-of-bounds List access and an absent Map key are §11.2 panics.
sub eval_index($obj: Expr, $idx: Expr, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($obj, $subs, $env) {
        Err($e) { Err($e) }
        Ok($or) {
            if $or.returned {
                Ok($or)
            } else {
                match eval_expr_flow($idx, $subs, $or.env) {
                    Err($e) { Err($e) }
                    Ok($ir) {
                        if $ir.returned {
                            Ok($ir)
                        } else {
                            match $or.value {
                                VList($xs) {
                                    match $ir.value {
                                        VInt($i) {
                                            match vlist_index($xs, $i) {
                                                Some($v) { Ok(flow($v, $ir.env)) }
                                                None { Err(eval_err("list index out of bounds")) }
                                            }
                                        }
                                        _ { Err(eval_err("list index must be Int")) }
                                    }
                                }
                                VMap($entries) {
                                    match $ir.value {
                                        VStr($key) {
                                            match vmap_lookup($entries, $key) {
                                                Some($v) { Ok(flow($v, $ir.env)) }
                                                None { Err(eval_err("map key not found")) }
                                            }
                                        }
                                        _ { Err(eval_err("map key must be Str")) }
                                    }
                                }
                                VMatch($text, $names, $groups) {
                                    match $ir.value {
                                        VInt($i) {
                                            if $i == 0 {
                                                Ok(flow(VVariant("Some", ValCons(VStr($text), ValNil), ""), $ir.env))
                                            } else {
                                                match vlist_index($groups, $i - 1) {
                                                    Some($cap) { Ok(flow($cap, $ir.env)) }
                                                    None { Ok(flow(VVariant("None", ValNil, ""), $ir.env)) }
                                                }
                                            }
                                        }
                                        _ { Err(eval_err("Match index must be Int")) }
                                    }
                                }
                                _ { Err(eval_err("cannot index this value with []")) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Resolve a named capture against the source-order name/group snapshots. An
# absent name and an existing non-participating group both yield None (§13.3),
# while a participating empty group remains Some("").
sub vmatch_named($want: Str, $names: StrList, $groups: ValueList): Value {
    match $names {
        StrNil { VVariant("None", ValNil, "") }
        StrCons($name, $nrest) {
            match $groups {
                ValNil { VVariant("None", ValNil, "") }
                ValCons($cap, $grest) {
                    if $name == $want { $cap } else { vmatch_named($want, $nrest, $grest) }
                }
            }
        }
    }
}

# §14.2 `$b<name>`: first captured child Bush with that production name, else None.
# Mirrors runtime `guji_bush_cap` (source-order first match).
sub vbush_named($want: Str, $caps: ValueList): Value {
    match $caps {
        ValNil { VVariant("None", ValNil, "") }
        ValCons($h, $t) {
            match $h {
                VBush($n, $text, $cs) {
                    if $n == $want {
                        VVariant("Some", ValCons($h, ValNil), "")
                    } else {
                        vbush_named($want, $t)
                    }
                }
                _ { vbush_named($want, $t) }
            }
        }
    }
}

sub eval_capture($obj: Expr, $name: Str, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($obj, $subs, $env) {
        Err($e) { Err($e) }
        Ok($or) {
            if $or.returned {
                Ok($or)
            } else {
                match $or.value {
                    VMatch($text, $names, $groups) { Ok(flow(vmatch_named($name, $names, $groups), $or.env)) }
                    VBush($bname, $text, $caps) { Ok(flow(vbush_named($name, $caps), $or.env)) }
                    _ { Err(eval_err("named capture requires Match or Bush receiver")) }
                }
            }
        }
    }
}

# Nth element of a value cons-list (0-based); None if out of range or negative.
sub vlist_index($xs: ValueList, $i: Int): Option[Value] {
    if $i < 0 {
        None
    } else {
        match $xs {
            ValNil { None }
            ValCons($h, $t) {
                if $i == 0 { Some($h) } else { vlist_index($t, $i - 1) }
            }
        }
    }
}

# Standalone field access (`$x.name` with no call). §8.1/§8.2: a PUBLIC field
# of a class instance reads its value; a private or unknown field is an error
# (the oracle rejects those at type-check — both reject). Any other value still
# has no fields (the oracle also rejects; a function-valued `Cls.assoc` read is
# out of the evaluator's value domain and stays a reject boundary).
sub eval_field($obj: Expr, $name: Str, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($obj, $subs, $env) {
        Err($e) { Err($e) }
        Ok($or) {
            if $or.returned {
                Ok($or)
            } else {
                match $or.value {
                    VInstance($cn, $fs) {
                        if $cn == "Proc" {
                            if $name == "exit_code" || $name == "stdout" || $name == "stderr" {
                                match vmap_lookup($fs, $name) {
                                    Some($v) { Ok(flow($v, $or.env)) }
                                    None { Err(eval_err("Proc field " ~ $name ~ " is not initialized")) }
                                }
                            } else {
                                Err(eval_err("Proc has no public field " ~ $name))
                            }
                        } else {
                            match classtable_lookup($subs, $cn) {
                                Some($c) {
                                    if class_has_public_field($c.fields, $name) {
                                        match vmap_lookup($fs, $name) {
                                            Some($v) { Ok(flow($v, $or.env)) }
                                            None { Err(eval_err($cn ~ " field " ~ $name ~ " is not initialized")) }
                                        }
                                    } else {
                                        Err(eval_err($cn ~ " has no public field " ~ $name))
                                    }
                                }
                                None { Err(eval_err("class " ~ $cn ~ " is not in scope")) }
                            }
                        }
                    }
                    VMatch($text, $names, $groups) {
                        if $name == "text" {
                            Ok(flow(VStr($text), $or.env))
                        } else {
                            Err(eval_err("Match has no field " ~ $name))
                        }
                    }
                    VBush($bname, $text, $caps) {
                        if $name == "text" {
                            Ok(flow(VStr($text), $or.env))
                        } else {
                            Err(eval_err("Bush has no field " ~ $name))
                        }
                    }
                    _ { Err(eval_err("no field '" ~ $name ~ "' on this value")) }
                }
            }
        }
    }
}

sub class_has_public_field($fs: ClassFieldList, $name: Str): Bool {
    match $fs {
        ClassFieldNil { false }
        ClassFieldCons($f, $rest) {
            if $f.name == $name && $f.public { true } else { class_has_public_field($rest, $name) }
        }
    }
}

sub eval_match($subject: Expr, $arms: ArmList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match eval_expr_flow($subject, $subs, $env) {
        Err($e) { Err($e) }
        Ok($sr) {
            if $sr.returned {
                Ok($sr)
            } else {
                eval_arms($sr.value, $arms, $subs, $sr.env)
            }
        }
    }
}

# Try each arm in order: a pattern that matches yields its captures; a present
# guard must then evaluate to `true` (§10.2) or the arm is skipped. The arm body
# runs in a child scope holding the captures. No arm matching is a runtime error
# (the oracle requires exhaustive match at type-check; both reject).
sub eval_arms($v: Value, $arms: ArmList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $arms {
        ArmNil { Err(eval_err("no match arm matched the value")) }
        ArmCons($arm, $rest) {
            match match_pattern($arm.pat, $v, $subs, $env, BindNil) {
                Err($e) { Err($e) }
                Ok($opt) {
                    match $opt {
                        None { eval_arms($v, $rest, $subs, $env) }
                        Some($captures) {
                            $child = EnvFrame($captures, $env)
                            match $arm.guard {
                                None { run_scope($arm.body, $subs, $child) }
                                Some($g) {
                                    match eval_bool_cond($g, $subs, $child) {
                                        Err($e) { Err($e) }
                                        Ok($gr) {
                                            if $gr.returned {
                                                # a `return` inside the guard unwinds; strip the captures frame
                                                Ok(EvalResult(value: $gr.value, env: strip_to_parent($gr.env), returned: true))
                                            } else {
                                                match $gr.value {
                                                    VBool($b) {
                                                        if $b {
                                                            run_scope($arm.body, $subs, $child)
                                                        } else {
                                                            eval_arms($v, $rest, $subs, strip_to_parent($gr.env))
                                                        }
                                                    }
                                                    _ { Err(eval_err("match guard must be Bool")) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub strip_to_parent($env: Env): Env {
    match $env {
        EnvFrame($locals, $parent) { $parent }
        EnvNil { EnvNil }
    }
}

# Match a single pattern against a value, accumulating captured bindings.
# Returns Some(bindings) on a match, None on a mismatch. PLit compares by the same
# structural equality used by `==`; PWild always matches with no capture; PBind
# always matches and captures the value under its sigil name; PVariant matches a
# Variant by tag and arity, then recursively matches each field pattern (§10.1).
sub match_pattern($pat: Pattern, $v: Value, $subs: SubTable, $env: Env, $acc: Bindings): Result[Option[Bindings], Str] {
    match $pat {
        PWild { Ok(Some($acc)) }
        PBind($name) { Ok(Some(bind_append($acc, $name, false, $v))) }
        PLit($lit) {
            match eval_expr($lit, $subs, $env) {
                Err($e) { Err($e) }
                Ok($lv) {
                    if value_eq($lv, $v) { Ok(Some($acc)) } else { Ok(None) }
                }
            }
        }
        PVariant($name, $args) {
            match $v {
                VVariant($tag, $fields, $eid) {
                    if $tag == $name {
                        match_pattern_list($args, $fields, $subs, $env, $acc)
                    } else {
                        Ok(None)
                    }
                }
                _ { Ok(None) }
            }
        }
    }
}

# Match a list of field patterns against a Variant's field values. A length
# mismatch is a non-match (None); any sub-pattern mismatch short-circuits to None.
sub match_pattern_list($pats: PatternList, $vals: ValueList, $subs: SubTable, $env: Env, $acc: Bindings): Result[Option[Bindings], Str] {
    match $pats {
        PatNil {
            match $vals {
                ValNil { Ok(Some($acc)) }
                _ { Ok(None) }
            }
        }
        PatCons($p, $prest) {
            match $vals {
                ValNil { Ok(None) }
                ValCons($val, $vrest) {
                    match match_pattern($p, $val, $subs, $env, $acc) {
                        Err($e) { Err($e) }
                        Ok($opt) {
                            match $opt {
                                None { Ok(None) }
                                Some($acc2) { match_pattern_list($prest, $vrest, $subs, $env, $acc2) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# ---------------------------------------------------------------------------
# E4: public evaluator entry + canonical main-frame dump.
#
# The real evaluator driver imports this module and calls `eval_main`; it cannot
# build or match our AST/value enum constructors cross-module. Program output is
# still emitted incrementally by the `print`/`note` builtins while evaluation
# runs. On success the driver prints `eval_env_delimiter()` and this result's
# `dump`, then exits with main's Int value (or 0 for Unit), mirroring §18.
# ---------------------------------------------------------------------------

pub class MainEvalResult {
    has $.dump: Str
    has $.exit_code: Int
}

pub sub eval_env_delimiter(): Str {
    "--- guji selfhost env ---"
}

sub params_empty($params: ParamList): Bool {
    match $params {
        ParamNil { true }
        _ { false }
    }
}

sub value_type_name($v: Value): Str {
    match $v {
        VInt($n) { "Int" }
        VFloat($t) { "Float" }
        VStr($s) { "Str" }
        VBool($b) { "Bool" }
        VUnit { "Unit" }
        VList($xs) { "List" }
        VMap($xs) { "Map" }
        VRange($from, $to, $open) { "Range" }
        VVariant($tag, $fields, $eid) { $tag }
        VInstance($cn, $fields) { $cn }
        VFunction($key, $caps) { "Func" }
        VRegex($p, $private) { "Regex" }
        VMatch($t, $names, $groups) { "Match" }
        VBush($name, $text, $caps) { "Bush" }
        VHandle($stream) { "Handle" }
        VFileHandle($h) { "Handle" }
        VChanUnit($ch) { "Chan" }
        VChanInt($ch) { "Chan" }
        VChanBool($ch) { "Chan" }
        VChanFloat($ch) { "Chan" }
        VChanStr($ch) { "Chan" }
        VChanListInt($ch) { "Chan" }
        VChanMapStr($ch) { "Chan" }
        VChanEnum($ch) { "Chan" }
    }
}

sub main_exit_code($v: Value): Result[Int, Str] {
    match $v {
        VInt($n) { Ok($n) }
        VUnit { Ok(0) }
        _ { Err(eval_err("main returned " ~ value_type_name($v) ~ ", expected Unit or Int")) }
    }
}

sub dump_binding_line($name: Str, $value: Value): Str {
    $name ~ " = " ~ display_value($value)
}

sub dump_bindings($binds: Bindings): Str {
    match $binds {
        BindNil { "(empty)" }
        BindCons($name, $mutable, $value, BindNil) { dump_binding_line($name, $value) }
        BindCons($name, $mutable, $value, $rest) {
            dump_binding_line($name, $value) ~ "\n" ~ dump_bindings($rest)
        }
    }
}

sub dump_main_env($env: Env): Str {
    match $env {
        EnvFrame($binds, $parent) { dump_bindings($binds) }
        EnvNil { "(empty)" }
    }
}

sub eval_main_program($prog: Program, $subs: SubTable): Result[MainEvalResult, Str] {
    match subtable_lookup($subs, "main") {
                None { Err(eval_err("no main() function defined")) }
                Some($main_sub) {
                    if !params_empty($main_sub.params) {
                        Err(eval_err("main expects no arguments"))
                    } else {
                        match eval_body($main_sub.body, $subs, EnvFrame(BindNil, EnvNil)) {
                            Err($e) {
                                match parse_exit_signal($e) {
                                    Some($code) {
                                        Ok(MainEvalResult(dump: dump_main_env(EnvFrame(BindNil, EnvNil)), exit_code: $code))
                                    }
                                    None { Err($e) }
                                }
                            }
                            Ok($r) {
                                match main_exit_code($r.value) {
                                    Err($e) { Err($e) }
                                    Ok($code) {
                                        Ok(MainEvalResult(dump: dump_main_env($r.env), exit_code: $code))
                                    }
                                }
                            }
                        }
                    }
                }
            }
}

pub sub eval_main($src: Str): Result[MainEvalResult, Str] {
    match parse($src) {
        Err($e) { Err($e) }
        Ok($prog) { eval_main_program($prog, build_sub_table($prog.decls)) }
    }
}

# Path-aware evaluator entry for the canonical interpreter. Import paths are
# resolved relative to each module source; public declarations are available
# through the final path-segment alias (§16.1). Transitive imports are loaded
# so an imported body can call its own imports; cycles fail at load time.
pub sub eval_main_at($path: Str, $src: Str): Result[MainEvalResult, Str] {
    match parse($src) {
        Err($e) { Err($e) }
        Ok($prog) {
            match build_eval_imports($path, $prog.decls, StrNil) {
                Err($e) { Err($e) }
                Ok($imports) {
                    eval_main_program($prog, subtable_append(build_sub_table($prog.decls), $imports))
                }
            }
        }
    }
}

# ===========================================================================
# SELFHOST SLICE 3 — THE TYPE CHECKER (T1: type model + env + core expressions)
#
# The fourth front-end stage: lexer -> parser -> evaluator -> TYPE CHECKER. It
# takes the slice-1 parser's AST and decides whether a program is well-typed,
# synthesizing each expression's type bottom-up (pragmatic synthesis + checking,
# NOT full Hindley-Milner). The public conformance fixtures and language
# specification define its required accept/reject decisions.
#
# T1 lands: the semantic `SemType` model, a type environment (name->SemType scope
# chain), a sub-signature table (name->TFn), and synthesis of the atoms, `EUnary`,
# and `EBinary` with the §5.1-5.2 operand rules. Later slices (T2/T3) refine the
# deferred Expr kinds (calls/if/match/collections), which T1 leaves permissive.
#
# CRITICAL fidelity note — `TUnknown` is PERMISSIVE and ASYMMETRIC, exactly like
# the oracle's `Unknown.Equal(other) == true` (a one-directional rule). `sem_eq`
# below is DIRECTIONAL: `sem_eq($a,$b)` means "$a.Equal($b)" in Go terms, so
# `sem_eq(TUnknown, X)` is always true but `sem_eq(TInt, TUnknown)` is false.
# This reproduces the verified oracle behavior where `$x + 1` (Unknown on the
# left) type-checks but `1 + $x` (Unknown on the right) is rejected.
# ---------------------------------------------------------------------------

# A guji-native cons-list of SemType for `TFn` parameters (there is no array
# literal type to lean on; mirror the existing TypeList/ParamList encoding).
pub enum SemTypeList {
    SemTNil
    SemTCons($head: SemType, $tail: SemTypeList)
}

pub class SemVariant {
    has $.name: Str
    has $.fields: SemTypeList
}

pub enum SemVariantList {
    SemVariantNil
    SemVariantCons($head: SemVariant, $tail: SemVariantList)
}

# A class field's semantic shape (E3): bare name, resolved field type, and the
# `$.`/`$!` visibility. Mirrors the oracle's typecheck.FieldInfo (§8). Field types
# are recorded SHALLOWLY for class/enum-typed fields (resolved against the names
# table, like SemVariant fields), so mutually-recursive class graphs terminate;
# `sem_deepen_class` re-resolves one level on demand at access time.
pub class SemField {
    has $.name: Str
    has $.ty: SemType
    has $.public: Bool
}

pub enum SemFieldList {
    SemFieldNil
    SemFieldCons($head: SemField, $tail: SemFieldList)
}

pub class SemMethod {
    has $.name: Str
    has $.sig: SemType
    has $.assoc: Bool
}

pub enum SemMethodList {
    SemMethodNil
    SemMethodCons($head: SemMethod, $tail: SemMethodList)
}

# The semantic type lattice. `TUnknown` is the permissive top used for
# unannotated params/returns and error recovery; `TNever` is the bottom that
# unifies with any type (exit/panic/return). Both are mandatory: without them
# the checker would over-reject valid oracle programs.
# `TParam` is a generic type parameter such as T in `sub id[T]` (§3.3),
# mirroring the Go oracle's typecheck.TypeParam. It is only constructed while
# resolving a GENERIC sub's declared signature (sem_sub_sig_tps), so
# non-generic programs never see it.
pub enum SemType {
    TInt
    TFloat
    TStr
    TBool
    TUnit
    TList($elem: SemType)
    TMap($key: SemType, $val: SemType)
    TRange
    TOption($elem: SemType)
    TRes($ok: SemType, $err: SemType)
    TChan($elem: SemType)
    TClosed
    TEnum($name: Str, $variants: SemVariantList)
    TClass($name: Str, $fields: SemFieldList, $methods: SemMethodList)
    TGrammar($name: Str, $productions: StrList)
    TBush
    TFn($params: SemTypeList, $ret: SemType)
    TUnknown
    TNever
    TParam($name: Str)
}

sub is_unknown($t: SemType): Bool {
    match $t { TUnknown { true } _ { false } }
}

sub is_never($t: SemType): Bool {
    match $t { TNever { true } _ { false } }
}

sub is_tparam($t: SemType): Bool {
    match $t { TParam($n) { true } _ { false } }
}

# Mirrors the Go oracle's openType: error-recovery Unknowns and
# not-yet-instantiated type parameters are both permissive in v0.
sub sem_open($t: SemType): Bool {
    is_unknown($t) || is_tparam($t)
}

# Directional structural equality: `sem_eq($a,$b)` == Go's `$a.Equal($b)`. A
# `TUnknown` RECEIVER ($a) equals anything; a `TUnknown` ARGUMENT ($b) equals
# only a `TUnknown` receiver. This asymmetry is load-bearing (see header note).
sub sem_eq($a: SemType, $b: SemType): Bool {
    match $a {
        TUnknown { true }
        TInt { match $b { TInt { true } _ { false } } }
        TFloat { match $b { TFloat { true } _ { false } } }
        TStr { match $b { TStr { true } _ { false } } }
        TBool { match $b { TBool { true } _ { false } } }
        TUnit { match $b { TUnit { true } _ { false } } }
        TNever { match $b { TNever { true } _ { false } } }
        TList($ae) { match $b { TList($be) { sem_eq($ae, $be) } _ { false } } }
        TMap($ak, $av) { match $b { TMap($bk, $bv) { sem_eq($ak, $bk) && sem_eq($av, $bv) } _ { false } } }
        TRange { match $b { TRange { true } _ { false } } }
        TOption($ae) { match $b { TOption($be) { sem_eq($ae, $be) } _ { false } } }
        TRes($ao, $ae) { match $b { TRes($bo, $be) { sem_eq($ao, $bo) && sem_eq($ae, $be) } _ { false } } }
        TChan($ae) { match $b { TChan($be) { sem_eq($ae, $be) } _ { false } } }
        TClosed { match $b { TClosed { true } _ { false } } }
        TEnum($an, $av) { match $b { TEnum($bn, $bv) { $an == $bn } _ { false } } }
        TClass($an, $af, $am) { match $b { TClass($bn, $bf, $bm) { $an == $bn } _ { false } } }
        TGrammar($an, $ap) { match $b { TGrammar($bn, $bp) { $an == $bn } _ { false } } }
        TBush { match $b { TBush { true } _ { false } } }
        TFn($ap, $ar) { match $b { TFn($bp, $br) { sem_list_eq($ap, $bp) && sem_eq($ar, $br) } _ { false } } }
        TParam($an) { match $b { TParam($bn) { $an == $bn } _ { false } } }
    }
}

sub sem_assignable_list($actual: SemTypeList, $expected: SemTypeList): Bool {
    match $actual {
        SemTNil { match $expected { SemTNil { true } _ { false } } }
        SemTCons($ah, $at) {
            match $expected {
                SemTNil { false }
                SemTCons($eh, $et) { sem_assignable($ah, $eh) && sem_assignable_list($at, $et) }
            }
        }
    }
}

# Assignment/context compatibility: a value of `actual` can satisfy `expected`.
# Unlike `sem_eq`, this is deliberately permissive in either direction for
# Unknown, matching the Go oracle's assignable(actual, expected).
sub sem_assignable($actual: SemType, $expected: SemType): Bool {
    if sem_open($actual) || sem_open($expected) || is_never($actual) {
        true
    } else {
        match $actual {
            TInt { match $expected { TInt { true } _ { false } } }
            TFloat { match $expected { TFloat { true } _ { false } } }
            TStr { match $expected { TStr { true } _ { false } } }
            TBool { match $expected { TBool { true } _ { false } } }
            TUnit { match $expected { TUnit { true } _ { false } } }
            TNever { true }
            TUnknown { true }
            TList($ae) { match $expected { TList($ee) { sem_assignable($ae, $ee) } _ { false } } }
            TMap($ak, $av) {
                match $expected {
                    TMap($ek, $ev) { sem_assignable($ak, $ek) && sem_assignable($av, $ev) }
                    _ { false }
                }
            }
            TRange { match $expected { TRange { true } _ { false } } }
            TOption($ae) { match $expected { TOption($ee) { sem_assignable($ae, $ee) } _ { false } } }
            TRes($ao, $ae) {
                match $expected {
                    TRes($eo, $ee) { sem_assignable($ao, $eo) && sem_assignable($ae, $ee) }
                    _ { false }
                }
            }
            TChan($ae) { match $expected { TChan($ee) { sem_assignable($ae, $ee) } _ { false } } }
            TClosed { match $expected { TClosed { true } _ { false } } }
            TEnum($an, $av) { match $expected { TEnum($en, $ev) { $an == $en } _ { false } } }
            TClass($an, $af, $am) { match $expected { TClass($en, $ef, $em) { $an == $en } _ { false } } }
            TGrammar($an, $ap) { match $expected { TGrammar($en, $ep) { $an == $en } _ { false } } }
            TBush { match $expected { TBush { true } _ { false } } }
            TFn($ap, $ar) {
                match $expected {
                    TFn($ep, $er) { sem_assignable_list($ap, $ep) && sem_assignable($ar, $er) }
                    _ { false }
                }
            }
            # Unreachable: the sem_open short-circuit above accepts every TParam.
            TParam($an) { true }
        }
    }
}

sub sem_list_eq($a: SemTypeList, $b: SemTypeList): Bool {
    match $a {
        SemTNil { match $b { SemTNil { true } _ { false } } }
        SemTCons($ah, $at) {
            match $b {
                SemTNil { false }
                SemTCons($bh, $bt) { sem_eq($ah, $bh) && sem_list_eq($at, $bt) }
            }
        }
    }
}

# Annotated-binding compatibility (§3.3 rejection parity): the oracle's
# BindingStmt uses initTy.Equal(annTy), where a not-yet-instantiated TypeParam
# equals only the same-named TypeParam — even NESTED inside a carrier, so
# `$o: Option[Int] = none_of()` over `sub none_of[T](): Option[T]` is
# `binding $o has type Option[T], expected Option[Int]`. Unlike sem_eq (the
# faithful one-sided Equal), TUnknown on EITHER side at ANY depth stays
# permissive here: selfhost degrades oracle-modeled types (Result[..],
# Chan[..], generic class instantiations, ...) to TUnknown, and the oracle's
# concrete Equal at those spots can legitimately succeed — rejecting on a
# degraded expected/actual would false-reject programs the oracle accepts.
sub sem_bind_eq($actual: SemType, $expected: SemType): Bool {
    if is_unknown($actual) || is_unknown($expected) {
        true
    } else {
        match $actual {
            TInt { match $expected { TInt { true } _ { false } } }
            TFloat { match $expected { TFloat { true } _ { false } } }
            TStr { match $expected { TStr { true } _ { false } } }
            TBool { match $expected { TBool { true } _ { false } } }
            TUnit { match $expected { TUnit { true } _ { false } } }
            TNever { match $expected { TNever { true } _ { false } } }
            TUnknown { true }
            TList($ae) { match $expected { TList($ee) { sem_bind_eq($ae, $ee) } _ { false } } }
            TMap($ak, $av) {
                match $expected {
                    TMap($ek, $ev) { sem_bind_eq($ak, $ek) && sem_bind_eq($av, $ev) }
                    _ { false }
                }
            }
            TRange { match $expected { TRange { true } _ { false } } }
            TOption($ae) { match $expected { TOption($ee) { sem_bind_eq($ae, $ee) } _ { false } } }
            TRes($ao, $ae) {
                match $expected {
                    TRes($eo, $ee) { sem_bind_eq($ao, $eo) && sem_bind_eq($ae, $ee) }
                    _ { false }
                }
            }
            TChan($ae) { match $expected { TChan($ee) { sem_bind_eq($ae, $ee) } _ { false } } }
            TClosed { match $expected { TClosed { true } _ { false } } }
            TEnum($an, $av) { match $expected { TEnum($en, $ev) { $an == $en } _ { false } } }
            TClass($an, $af, $am) { match $expected { TClass($en, $ef, $em) { $an == $en } _ { false } } }
            TGrammar($an, $ap) { match $expected { TGrammar($en, $ep) { $an == $en } _ { false } } }
            TBush { match $expected { TBush { true } _ { false } } }
            TFn($ap, $ar) {
                match $expected {
                    TFn($ep, $er) { sem_bind_eq_list($ap, $ep) && sem_bind_eq($ar, $er) }
                    _ { false }
                }
            }
            TParam($an) { match $expected { TParam($en) { $an == $en } _ { false } } }
        }
    }
}

sub sem_bind_eq_list($a: SemTypeList, $b: SemTypeList): Bool {
    match $a {
        SemTNil { match $b { SemTNil { true } _ { false } } }
        SemTCons($ah, $at) {
            match $b {
                SemTNil { false }
                SemTCons($bh, $bt) { sem_bind_eq($ah, $bh) && sem_bind_eq_list($at, $bt) }
            }
        }
    }
}

# Human-readable rendering, matching the oracle's `Type.String()` for the names
# that appear in T1 diagnostics (`Int`/`Float`/`Str`/`Bool`/`Unit`/`Never`/`<?>`).
sub sem_to_str($t: SemType): Str {
    match $t {
        TInt { "Int" }
        TFloat { "Float" }
        TStr { "Str" }
        TBool { "Bool" }
        TUnit { "Unit" }
        TNever { "Never" }
        TUnknown { "<?>" }
        TList($e) { "List[" ~ sem_to_str($e) ~ "]" }
        TMap($k, $v) { "Map[" ~ sem_to_str($k) ~ ", " ~ sem_to_str($v) ~ "]" }
        TRange { "Range" }
        TOption($e) { "Option[" ~ sem_to_str($e) ~ "]" }
        TRes($ok, $err) { "Result[" ~ sem_to_str($ok) ~ ", " ~ sem_to_str($err) ~ "]" }
        TChan($e) { "Chan[" ~ sem_to_str($e) ~ "]" }
        TClosed { "Closed" }
        TEnum($n, $vs) { $n }
        TClass($n, $fs, $ms) { $n }
        TGrammar($n, $ps) { $n }
        TBush { "Bush" }
        TFn($p, $r) { "sub(" ~ sem_list_to_str($p) ~ "): " ~ sem_to_str($r) }
        TParam($n) { $n }
    }
}

sub sem_list_to_str($ts: SemTypeList): Str {
    match $ts {
        SemTNil { "" }
        SemTCons($h, SemTNil) { sem_to_str($h) }
        SemTCons($h, $rest) { sem_to_str($h) ~ ", " ~ sem_list_to_str($rest) }
    }
}

sub tc_err($msg: Str): Str {
    "type error: " ~ $msg
}

# ---- annotation -> semantic type (mirrors `typeFromAST`) -------------------
# Unrecognised base names (user classes/enums, Result, ...) become TUnknown so
# T1 stays permissive over types it does not yet model.

sub typelist_at($ts: TypeList, $i: Int): Option[TypeRef] {
    match $ts {
        TypeNil { None }
        TypeCons($h, $rest) { if $i == 0 { Some($h) } else { typelist_at($rest, $i - 1) } }
    }
}

sub sem_arg($ts: TypeList, $i: Int): SemType {
    match typelist_at($ts, $i) {
        None { TUnknown }
        Some($tr) { sem_from_typeref($tr) }
    }
}

sub sem_arg_with($ts: TypeList, $i: Int, $tops: SemSubTable): SemType {
    match typelist_at($ts, $i) {
        None { TUnknown }
        Some($tr) { sem_from_typeref_with($tr, $tops) }
    }
}

sub sem_from_typeref($t: TypeRef): SemType {
    $n = $t.name
    if $n == "Int" {
        TInt
    } else if $n == "Float" {
        TFloat
    } else if $n == "Str" {
        TStr
    } else if $n == "Bool" {
        TBool
    } else if $n == "Unit" {
        TUnit
    } else if $n == "Never" {
        TNever
    } else if $n == "List" {
        TList(sem_arg($t.args, 0))
    } else if $n == "Map" {
        TMap(sem_arg($t.args, 0), sem_arg($t.args, 1))
    } else if $n == "Option" {
        TOption(sem_arg($t.args, 0))
    } else if $n == "Result" {
        TRes(sem_arg($t.args, 0), sem_arg($t.args, 1))
    } else if $n == "Chan" {
        TChan(sem_arg($t.args, 0))
    } else if $n == "Closed" {
        TClosed
    } else if $n == "Bush" {
        TBush
    } else {
        TUnknown
    }
}

sub sem_from_typeref_with($t: TypeRef, $tops: SemSubTable): SemType {
    if $t.name == "Option" {
        # Deepen the Option payload through the symbol table so an `Option[<user
        # enum/class>]` annotation resolves its inner to the SAME nominal SemType the
        # value side synthesizes (`Some(Variant(..))` -> Option[Enum]). Without this
        # the inner went through sem_arg (no table) to TUnknown, so a construction
        # `OWrap(Some(..))` arg-errored TOption(TEnum) vs TOption(<?>) — the selfhost
        # modeling gap E5d-7c-2d-7 surfaced. List/Map inner deepening stays out of
        # scope (their value side is unmodeled prelude TUnknown, which sem_eq's
        # TUnknown-receiver rule already accepts either direction).
        TOption(sem_arg_with($t.args, 0, $tops))
    } else if $t.name == "Result" {
        TRes(sem_arg_with($t.args, 0, $tops), sem_arg_with($t.args, 1, $tops))
    } else if $t.name == "Chan" {
        TChan(sem_arg_with($t.args, 0, $tops))
    } else {
    $base = sem_from_typeref($t)
    if !is_unknown($base) {
        $base
    } else {
        match sem_sub_lookup($tops, $t.name) {
            Some($ty) {
                match $ty {
                    TEnum($n, $vs) {
                        match $t.args {
                            TypeNil { $ty }
                            _ { TUnknown }
                        }
                    }
                    TClass($n, $fs, $ms) {
                        match $t.args {
                            TypeNil { $ty }
                            _ { TUnknown }
                        }
                    }
                    TGrammar($n, $ps) {
                        match $t.args {
                            TypeNil { $ty }
                            _ { TUnknown }
                        }
                    }
                    TBush { TBush }
                    _ { TUnknown }
                }
            }
            None { TUnknown }
        }
    }
    }
}

sub sem_from_opt_type($t: Option[TypeRef]): SemType {
    match $t {
        None { TUnknown }
        Some($tr) { sem_from_typeref($tr) }
    }
}

sub sem_from_opt_type_with($t: Option[TypeRef], $tops: SemSubTable): SemType {
    match $t {
        None { TUnknown }
        Some($tr) { sem_from_typeref_with($tr, $tops) }
    }
}

# ---- generic sub signatures (§3.3, P5b-2b(e)) -------------------------------
# Resolve a GENERIC sub's declared signature with its type-param names mapped to
# TParam (mirroring the Go oracle, where typeFromAST turns every unresolved
# Pascal name into a TypeParam and Checker.resolve leaves undeclared ones
# alone). Only build_sem_sub_table_on's generic-sub arm reaches these, so
# non-generic subs resolve byte-identically to before. Nested positions
# (List[T]/Map[Str,T]/Option[T]) recurse so the type param survives inside
# collection/carrier annotations; non-param names fall back to the ordinary
# table-aware resolution.

sub sem_arg_tps($ts: TypeList, $i: Int, $tops: SemSubTable, $tps: StrList): SemType {
    match typelist_at($ts, $i) {
        None { TUnknown }
        Some($tr) { sem_from_typeref_tps($tr, $tops, $tps) }
    }
}

sub sem_from_typeref_tps($t: TypeRef, $tops: SemSubTable, $tps: StrList): SemType {
    if strlist_contains($tps, $t.name) {
        match $t.args {
            TypeNil { TParam($t.name) }
            _ { TUnknown }
        }
    } else if $t.name == "List" {
        TList(sem_arg_tps($t.args, 0, $tops, $tps))
    } else if $t.name == "Map" {
        TMap(sem_arg_tps($t.args, 0, $tops, $tps), sem_arg_tps($t.args, 1, $tops, $tps))
    } else if $t.name == "Option" {
        TOption(sem_arg_tps($t.args, 0, $tops, $tps))
    } else if $t.name == "Result" {
        TRes(sem_arg_tps($t.args, 0, $tops, $tps), sem_arg_tps($t.args, 1, $tops, $tps))
    } else if $t.name == "Chan" {
        TChan(sem_arg_tps($t.args, 0, $tops, $tps))
    } else {
        sem_from_typeref_with($t, $tops)
    }
}

sub sem_from_opt_type_tps($t: Option[TypeRef], $tops: SemSubTable, $tps: StrList): SemType {
    match $t {
        None { TUnknown }
        Some($tr) { sem_from_typeref_tps($tr, $tops, $tps) }
    }
}

sub params_to_semlist_tps($ps: ParamList, $tops: SemSubTable, $tps: StrList): SemTypeList {
    match $ps {
        ParamNil { SemTNil }
        ParamCons($h, $rest) { SemTCons(sem_from_opt_type_tps($h.ty, $tops, $tps), params_to_semlist_tps($rest, $tops, $tps)) }
    }
}

# A generic sub's TFn signature carries TParam types; a non-generic sub keeps
# the exact pre-TParam resolution path.
sub sem_sub_sig_tps($s: SubDecl, $tops: SemSubTable): SemType {
    if strlist_empty($s.tparams) {
        TFn(params_to_semlist_with($s.params, $tops), sem_from_opt_type_with($s.ret, $tops))
    } else {
        TFn(params_to_semlist_tps($s.params, $tops, $s.tparams), sem_from_opt_type_tps($s.ret, $tops, $s.tparams))
    }
}

# ---- type environment (name -> SemType scope chain) ------------------------
# Each binding records whether it was introduced with `mut` (§4), and each frame
# records whether it is a CLOSURE BOUNDARY (a lambda/topic-block body). Together
# these enforce the §7.4 capture rule (P1b): a closure may not capture a `mut`
# binding — reading or assigning to it is a compile-time error. This mirrors the
# Go oracle's `typecheck.TypeEnv` (`binding.mut`, `TypeEnv.boundary`, `Resolve`).

pub enum TScope {
    TSNil
    TSCons($name: Str, $ty: SemType, $mutable: Bool, $tail: TScope)
}

pub enum TEnv {
    TENil
    TEFrame($binds: TScope, $boundary: Bool, $parent: TEnv)
}

# The outcome of a capture-aware lookup: the binding's type, whether it is `mut`,
# and whether the lookup crossed a closure boundary (i.e. is a capture). Mirrors
# the Go `TypeEnv.Resolve` return `(ty, mut, captured, ok)`.
pub class TResolve {
    has $.ty: SemType
    has $.mutable: Bool
    has $.captured: Bool
}

sub scope_lookup($s: TScope, $name: Str): Option[SemType] {
    match $s {
        TSNil { None }
        TSCons($n, $ty, $m, $rest) {
            if $n == $name { Some($ty) } else { scope_lookup($rest, $name) }
        }
    }
}

# Within a single frame: find the binding and report its `mut` flag (captured is
# filled in by the frame walk in `tenv_resolve_from`, so it is a placeholder here).
sub scope_resolve($s: TScope, $name: Str): Option[TResolve] {
    match $s {
        TSNil { None }
        TSCons($n, $ty, $m, $rest) {
            if $n == $name { Some(TResolve(ty: $ty, mutable: $m, captured: false)) } else { scope_resolve($rest, $name) }
        }
    }
}

sub tenv_lookup($env: TEnv, $name: Str): Option[SemType] {
    match $env {
        TENil { None }
        TEFrame($binds, $boundary, $parent) {
            match scope_lookup($binds, $name) {
                Some($ty) { Some($ty) }
                None { tenv_lookup($parent, $name) }
            }
        }
    }
}

# Capture-aware lookup: walk the frame chain, tracking whether a closure boundary
# has been crossed. A binding found in the boundary frame ITSELF (a lambda's own
# params/locals) is not a capture; only bindings in a frame BEYOND a boundary are.
# Faithful port of the Go `TypeEnv.Resolve` loop.
sub tenv_resolve($env: TEnv, $name: Str): Option[TResolve] {
    tenv_resolve_from($env, $name, false)
}

# Resolve only in the current lexical frame. Assignment needs this distinction:
# an immutable name in the current block is a reassignment error, while the same
# name in an enclosing block may be shadowed (§4).
sub tenv_current_resolve($env: TEnv, $name: Str): Option[TResolve] {
    match $env {
        TENil { None }
        TEFrame($binds, $boundary, $parent) { scope_resolve($binds, $name) }
    }
}

sub tenv_resolve_from($env: TEnv, $name: Str, $crossed: Bool): Option[TResolve] {
    match $env {
        TENil { None }
        TEFrame($binds, $boundary, $parent) {
            match scope_resolve($binds, $name) {
                Some($r) { Some(TResolve(ty: $r.ty, mutable: $r.mutable, captured: $crossed)) }
                None {
                    $next = if $boundary { true } else { $crossed }
                    tenv_resolve_from($parent, $name, $next)
                }
            }
        }
    }
}

# Bind (or shadow) an IMMUTABLE name in the CURRENT frame.
sub tenv_define($env: TEnv, $name: Str, $ty: SemType): TEnv {
    match $env {
        TENil { TEFrame(TSCons($name, $ty, false, TSNil), false, TENil) }
        TEFrame($binds, $boundary, $parent) { TEFrame(TSCons($name, $ty, false, $binds), $boundary, $parent) }
    }
}

# Bind (or shadow) a `mut` name in the CURRENT frame (§4). Mirrors `SetMut`.
sub tenv_define_mut($env: TEnv, $name: Str, $ty: SemType): TEnv {
    match $env {
        TENil { TEFrame(TSCons($name, $ty, true, TSNil), false, TENil) }
        TEFrame($binds, $boundary, $parent) { TEFrame(TSCons($name, $ty, true, $binds), $boundary, $parent) }
    }
}

# An ordinary nested scope (NOT a closure boundary): if/while/match arm blocks.
sub tenv_child($env: TEnv): TEnv { TEFrame(TSNil, false, $env) }

# A closure-boundary scope: the body of a lambda / topic block (§7.4). References
# that resolve outside this frame are captures. Mirrors `NewFuncChild`.
sub tenv_func_child($env: TEnv): TEnv { TEFrame(TSNil, true, $env) }

# ---- sub-signature table (name -> TFn) -------------------------------------

pub enum SemSubTable {
    SSTNil
    SSTCons($name: Str, $sig: SemType, $tail: SemSubTable)
    SSTIdx($idx: SemSubIdx, $tail: SemSubTable)
}

# P8d-2c-0: indexed symbol lookup — the type-check twin of CgSubIdx (see the
# CgEnv block for the profile that motivated both). The whole SemSubTable is
# name-keyed, so indexing covers subs, classes, enums, variants, grammars, and
# qualified import symbols alike; `flat` keeps original order for the one
# value-shaped scan (sem_any_grammar_has_prod) and preserves first-match-wins
# shadowing for duplicate names via set-if-absent dispatch.
enum SemSigTree {
    SemSigLeaf($subs: SemSubTable)
    SemSigNode($left: SemSigTree, $right: SemSigTree, $lcount: Int)
}

class SemSubIdx {
    has $.dispatch: Map[Str, Int]
    has $.flat: SemSubTable
    has $.tree: SemSigTree
}

class SemTblChunk {
    has $.chunk: SemSubTable
    has $.rest: SemSubTable
}

sub sem_sidx_count($t: SemSubTable): Int {
    match $t {
        SSTNil { 0 }
        SSTCons($n, $sig, $rest) { 1 + sem_sidx_count($rest) }
        SSTIdx($i, $rest) { 0 }
    }
}

# The suffix at the first SSTIdx node (or SSTNil): an already-indexed tail is
# kept as the wrap's fallthrough so composed wraps never lose entries.
sub sem_sidx_tail($t: SemSubTable): SemSubTable {
    match $t {
        SSTNil { SSTNil }
        SSTCons($n, $sig, $rest) { sem_sidx_tail($rest) }
        SSTIdx($i, $rest) { $t }
    }
}

sub sem_sidx_take($t: SemSubTable, $n: Int): SemTblChunk {
    if $n <= 0 {
        SemTblChunk(chunk: SSTNil, rest: $t)
    } else {
        match $t {
            SSTCons($name, $sig, $rest) {
                $c = sem_sidx_take($rest, $n - 1)
                SemTblChunk(chunk: SSTCons($name, $sig, $c.chunk), rest: $c.rest)
            }
            _ { SemTblChunk(chunk: SSTNil, rest: SSTNil) }
        }
    }
}

sub sem_sidx_tree($t: SemSubTable, $nbuckets: Int): SemSigTree {
    if $nbuckets <= 1 {
        SemSigLeaf($t)
    } else {
        $lb = $nbuckets / 2
        $c = sem_sidx_take($t, $lb * 32)
        SemSigNode(sem_sidx_tree($c.chunk, $lb), sem_sidx_tree($c.rest, $nbuckets - $lb), $lb)
    }
}

sub sem_sidx_dispatch($t: SemSubTable, %m: Map[Str, Int], $i: Int): Map[Str, Int] {
    match $t {
        SSTCons($name, $sig, $rest) { sem_sidx_dispatch($rest, sidx_dispatch_step($name, %m, $i / 32), $i + 1) }
        _ { %m }
    }
}

sub sem_sidx_pick($t: SemSigTree, $i: Int): SemSubTable {
    match $t {
        SemSigLeaf($subs) { $subs }
        SemSigNode($l, $r, $lc) {
            if $i < $lc { sem_sidx_pick($l, $i) } else { sem_sidx_pick($r, $i - $lc) }
        }
    }
}

# Index a freshly built symbol table; the table is only ever CONSULTED after
# build (checking never extends it), so one wrap at each build site suffices.
# Small tables (standalone corpus programs) stay flat.
sub sem_table_index($t: SemSubTable): SemSubTable {
    $n = sem_sidx_count($t)
    if $n < 64 {
        $t
    } else {
        %d0 = {}
        SSTIdx(SemSubIdx(
            dispatch: sem_sidx_dispatch($t, %d0, 0),
            flat: $t,
            tree: sem_sidx_tree($t, ($n + 31) / 32)
        ), sem_sidx_tail($t))
    }
}

sub params_to_semlist($ps: ParamList): SemTypeList {
    match $ps {
        ParamNil { SemTNil }
        ParamCons($h, $rest) { SemTCons(sem_from_opt_type($h.ty), params_to_semlist($rest)) }
    }
}

sub params_to_semlist_with($ps: ParamList, $tops: SemSubTable): SemTypeList {
    match $ps {
        ParamNil { SemTNil }
        ParamCons($h, $rest) { SemTCons(sem_from_opt_type_with($h.ty, $tops), params_to_semlist_with($rest, $tops)) }
    }
}

sub strlist_empty($xs: StrList): Bool {
    match $xs {
        StrNil { true }
        StrCons($h, $rest) { false }
    }
}

sub strlist_contains($xs: StrList, $s: Str): Bool {
    match $xs {
        StrNil { false }
        StrCons($h, $rest) { if $h == $s { true } else { strlist_contains($rest, $s) } }
    }
}

sub strlist_last($xs: StrList): Str {
    match $xs {
        StrNil { "" }
        StrCons($h, StrNil) { $h }
        StrCons($h, $rest) { strlist_last($rest) }
    }
}

sub strlist_join_path($xs: StrList): Str {
    match $xs {
        StrNil { "" }
        StrCons($h, StrNil) { $h }
        StrCons($h, $rest) { $h ~ "/" ~ strlist_join_path($rest) }
    }
}

sub strlist_join_underscore($xs: StrList): Str {
    match $xs {
        StrNil { "" }
        StrCons($h, StrNil) { $h }
        StrCons($h, $rest) { $h ~ "_" ~ strlist_join_underscore($rest) }
    }
}

sub source_dir($path: Str): Str {
    @parts = split($path, "/")
    if @parts.count() <= 1 {
        ""
    } else {
        take(@parts, @parts.count() - 1).join("/") ~ "/"
    }
}

sub import_source_path($source_path: Str, $imp: ImportDecl): Str {
    source_dir($source_path) ~ strlist_join_path($imp.path) ~ ".guji"
}

sub build_sem_enum_names($decls: DeclList): SemSubTable {
    match $decls {
        DeclNil { SSTNil }
        DeclCons($d, $rest) {
            match $d {
                DEnum($e) {
                    if strlist_empty($e.tparams) {
                        SSTCons($e.name, TEnum($e.name, SemVariantNil), build_sem_enum_names($rest))
                    } else {
                        build_sem_enum_names($rest)
                    }
                }
                DClass($c) { build_sem_enum_names($rest) }
                DSub($s) { build_sem_enum_names($rest) }
                DImport($i) { build_sem_enum_names($rest) }
                DGrammar($g) { build_sem_enum_names($rest) }
            }
        }
    }
}

sub production_names($ps: ProductionList): StrList {
    match $ps {
        ProductionNil { StrNil }
        ProductionCons($p, $rest) { StrCons($p.name, production_names($rest)) }
    }
}

# §14 grammar type objects carry their production names for Bush capture checks.
sub build_sem_grammar_symbols($decls: DeclList, $tail: SemSubTable): SemSubTable {
    match $decls {
        DeclNil { $tail }
        DeclCons($d, $rest) {
            match $d {
                DGrammar($g) { SSTCons($g.name, TGrammar($g.name, production_names($g.productions)), build_sem_grammar_symbols($rest, $tail)) }
                _ { build_sem_grammar_symbols($rest, $tail) }
            }
        }
    }
}

sub sem_variants_from_ast($vs: VariantList, $names: SemSubTable): SemVariantList {
    match $vs {
        VariantNil { SemVariantNil }
        VariantCons($v, $rest) {
            SemVariantCons(SemVariant(name: $v.name, fields: params_to_semlist_with($v.fields, $names)), sem_variants_from_ast($rest, $names))
        }
    }
}

sub add_sem_variant_symbols($enum_ty: SemType, $vs: SemVariantList, $tail: SemSubTable): SemSubTable {
    match $vs {
        SemVariantNil { $tail }
        SemVariantCons($v, $rest) {
            $sym = match $v.fields {
                SemTNil { $enum_ty }
                _ { TFn($v.fields, $enum_ty) }
            }
            SSTCons($v.name, $sym, add_sem_variant_symbols($enum_ty, $rest, $tail))
        }
    }
}

sub build_sem_enum_symbols($decls: DeclList, $names: SemSubTable): SemSubTable {
    match $decls {
        DeclNil { SSTNil }
        DeclCons($d, $rest) {
            match $d {
                DEnum($e) {
                    if strlist_empty($e.tparams) {
                        $vars = sem_variants_from_ast($e.variants, $names)
                        $enum_ty = TEnum($e.name, $vars)
                        # §9 enum-body methods/associated functions: register each
                        # sub's (self-stripped) signature under a qualified key so
                        # `$e.method(args)` / `EnumName.assoc(args)` can arg-check
                        # against it (the enum twin of TClass's baked-in methods).
                        $methods = sem_methods_from_ast($e.subs, $names)
                        SSTCons($e.name, $enum_ty, add_sem_variant_symbols($enum_ty, $vars, add_sem_enum_method_symbols($e.name, $methods, build_sem_enum_symbols($rest, $names))))
                    } else {
                        build_sem_enum_symbols($rest, $names)
                    }
                }
                DClass($c) { build_sem_enum_symbols($rest, $names) }
                DSub($s) { build_sem_enum_symbols($rest, $names) }
                DImport($i) { build_sem_enum_symbols($rest, $names) }
                DGrammar($g) { build_sem_enum_symbols($rest, $names) }
            }
        }
    }
}

# §9 enum method/associated-function signatures are stored in the symbol table
# under a qualified key (enums, unlike classes, carry no method list on their
# SemType). The key uses `#` — impossible in a user identifier or an import
# qualifier (`::`) — and encodes the method/assoc split so a method and an
# associated function of the same name never collide.
sub enum_method_key($ename: Str, $mname: Str, $assoc: Bool): Str {
    if $assoc {
        $ename ~ "#assoc#" ~ $mname
    } else {
        $ename ~ "#method#" ~ $mname
    }
}

sub add_sem_enum_method_symbols($ename: Str, $ms: SemMethodList, $tail: SemSubTable): SemSubTable {
    match $ms {
        SemMethodNil { $tail }
        SemMethodCons($m, $rest) {
            SSTCons(enum_method_key($ename, $m.name, $m.assoc), $m.sig, add_sem_enum_method_symbols($ename, $rest, $tail))
        }
    }
}

sub sem_enum_method_lookup($subs: SemSubTable, $ename: Str, $mname: Str, $assoc: Bool): Option[SemType] {
    sem_sub_lookup($subs, enum_method_key($ename, $mname, $assoc))
}

sub build_sem_sub_table_on($decls: DeclList, $tops: SemSubTable): SemSubTable {
    match $decls {
        DeclNil { $tops }
        DeclCons($d, $rest) {
            match $d {
                DSub($s) {
                    SSTCons($s.name, sem_sub_sig_tps($s, $tops), build_sem_sub_table_on($rest, $tops))
                }
                DClass($c) { build_sem_sub_table_on($rest, $tops) }
                DEnum($e) { build_sem_sub_table_on($rest, $tops) }
                DImport($i) { build_sem_sub_table_on($rest, $tops) }
                DGrammar($g) { build_sem_sub_table_on($rest, $tops) }
            }
        }
    }
}

sub sem_table_append($left: SemSubTable, $right: SemSubTable): SemSubTable {
    match $left {
        SSTNil { $right }
        SSTCons($name, $sig, $tail) { SSTCons($name, $sig, sem_table_append($tail, $right)) }
        SSTIdx($i, $tail) { SSTIdx($i, sem_table_append($tail, $right)) }
    }
}

sub import_marker_name($alias: Str): Str {
    $alias ~ "::__import__"
}

sub import_qualified_name($alias: Str, $member: Str): Str {
    $alias ~ "::" ~ $member
}

sub import_alias_bound($subs: SemSubTable, $alias: Str): Bool {
    match sem_sub_lookup($subs, import_marker_name($alias)) {
        Some($sig) { true }
        None { false }
    }
}

sub import_symbol_type($subs: SemSubTable, $name: Str): SemType {
    match sem_sub_lookup($subs, $name) {
        Some($sig) { $sig }
        None { TUnknown }
    }
}

sub build_public_import_symbols_on($alias: Str, $decls: DeclList, $all: SemSubTable, $tail: SemSubTable): SemSubTable {
    match $decls {
        DeclNil { SSTCons(import_marker_name($alias), TUnknown, $tail) }
        DeclCons($d, $rest) {
            match $d {
                DSub($s) {
                    if $s.public {
                        SSTCons(import_qualified_name($alias, $s.name), import_symbol_type($all, $s.name), build_public_import_symbols_on($alias, $rest, $all, $tail))
                    } else {
                        build_public_import_symbols_on($alias, $rest, $all, $tail)
                    }
                }
                DClass($c) {
                    if $c.public {
                        SSTCons(import_qualified_name($alias, $c.name), import_symbol_type($all, $c.name), build_public_import_symbols_on($alias, $rest, $all, $tail))
                    } else {
                        build_public_import_symbols_on($alias, $rest, $all, $tail)
                    }
                }
                DEnum($e) {
                    if $e.public {
                        SSTCons(import_qualified_name($alias, $e.name), import_symbol_type($all, $e.name), build_public_import_symbols_on($alias, $rest, $all, $tail))
                    } else {
                        build_public_import_symbols_on($alias, $rest, $all, $tail)
                    }
                }
                DImport($i) { build_public_import_symbols_on($alias, $rest, $all, $tail) }
                DGrammar($g) { build_public_import_symbols_on($alias, $rest, $all, $tail) }
            }
        }
    }
}

sub load_import_symbols_at($source_path: Str, $imp: ImportDecl, $tail: SemSubTable, $stack: StrList): Result[SemSubTable, Str] {
    $path = import_source_path($source_path, $imp)
    $alias = strlist_last($imp.path)
    if strlist_contains($stack, $path) {
        Err(import_cycle_message($stack, $path))
    } else {
        match read_file($path) {
            Err($e) { Err($e) }
            Ok($src) {
                match parse($src) {
                    Err($e) { Err($e) }
                    Ok($prog) {
                        # Validate the imported module's own graph while its AST is
                        # already resident. This makes cycle/missing-file rejection
                        # a shared load-time front-end result for both canonical
                        # drivers instead of letting C recurse into codegen.
                        $stack2 = strlist_snoc($stack, $path)
                        match build_import_symbols_at($path, $prog.decls, $stack2) {
                            Err($e) { Err($e) }
                            Ok($nested) {
                                $subs = sem_table_index(build_sem_sub_table($prog.decls))
                                match check_program_t2($src, $prog.decls, $subs) {
                                    Err($e) { Err($e) }
                                    Ok($msg) { Ok(build_public_import_symbols_on($alias, $prog.decls, $subs, $tail)) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub build_import_symbols_at($source_path: Str, $decls: DeclList, $stack: StrList): Result[SemSubTable, Str] {
    match $decls {
        DeclNil { Ok(SSTNil) }
        DeclCons($d, $rest) {
            match build_import_symbols_at($source_path, $rest, $stack) {
                Err($e) { Err($e) }
                Ok($tail) {
                    match $d {
                        DImport($imp) { load_import_symbols_at($source_path, $imp, $tail, $stack) }
                        _ { Ok($tail) }
                    }
                }
            }
        }
    }
}

sub build_import_symbols($source_path: Str, $decls: DeclList): Result[SemSubTable, Str] {
    build_import_symbols_at($source_path, $decls, StrNil)
}

# E3: a class name binds to its type-object `TClass(name, SemFieldNil, SemMethodNil)` in the
# SHALLOW names table (used only to resolve field/variant annotations during
# symbol building — keeps mutually-recursive class/enum graphs from looping). All
# classes are registered, generic ones included (their type-param-typed fields
# resolve to TUnknown, i.e. permissive, mirroring the oracle which never rejects a
# class declaration).
sub build_sem_class_names($decls: DeclList, $tail: SemSubTable): SemSubTable {
    match $decls {
        DeclNil { $tail }
        DeclCons($d, $rest) {
            match $d {
                DClass($c) { SSTCons($c.name, TClass($c.name, SemFieldNil, SemMethodNil), build_sem_class_names($rest, $tail)) }
                _ { build_sem_class_names($rest, $tail) }
            }
        }
    }
}

# E3: resolve each `has $.field: Type` into a SemField. Field types are resolved
# against the shallow names table so a class/enum-typed field carries its nominal
# type (shallow); `sem_deepen_class` re-resolves it one level when accessed.
sub sem_fields_from_ast($fs: ClassFieldList, $names: SemSubTable): SemFieldList {
    match $fs {
        ClassFieldNil { SemFieldNil }
        ClassFieldCons($f, $rest) {
            SemFieldCons(SemField(name: $f.name, ty: sem_from_opt_type_with($f.ty, $names), public: $f.public), sem_fields_from_ast($rest, $names))
        }
    }
}

# §8.3 methods are class-body `sub`s whose first parameter is `$self`; the
# visible call signature drops that receiver. Other class-body `sub`s are
# associated functions (§7.5) and keep their full signature.
sub is_method_sub($s: SubDecl): Bool {
    match $s.params {
        ParamCons($p, $rest) { $p.name == '$self' }
        _ { false }
    }
}

sub params_tail($ps: ParamList): ParamList {
    match $ps {
        ParamNil { ParamNil }
        ParamCons($h, $rest) { $rest }
    }
}

sub class_sub_sig($s: SubDecl, $names: SemSubTable): SemType {
    if is_method_sub($s) {
        TFn(params_to_semlist_with(params_tail($s.params), $names), sem_from_opt_type_with($s.ret, $names))
    } else {
        TFn(params_to_semlist_with($s.params, $names), sem_from_opt_type_with($s.ret, $names))
    }
}

sub sem_methods_from_ast($ss: SubDeclList, $names: SemSubTable): SemMethodList {
    match $ss {
        SubDeclNil { SemMethodNil }
        SubDeclCons($s, $rest) {
            SemMethodCons(SemMethod(name: $s.name, sig: class_sub_sig($s, $names), assoc: !is_method_sub($s)), sem_methods_from_ast($rest, $names))
        }
    }
}

# E3: class type-objects (name -> TClass(name, full fields, methods)), chained onto $tail
# (the enum-symbol table) so the final lookup order is subs -> classes -> enums.
sub build_sem_class_symbols($decls: DeclList, $names: SemSubTable, $tail: SemSubTable): SemSubTable {
    match $decls {
        DeclNil { $tail }
        DeclCons($d, $rest) {
            match $d {
                DClass($c) {
                    SSTCons($c.name, TClass($c.name, sem_fields_from_ast($c.fields, $names), sem_methods_from_ast($c.subs, $names)), build_sem_class_symbols($rest, $names, $tail))
                }
                _ { build_sem_class_symbols($rest, $names, $tail) }
            }
        }
    }
}

# E3: re-resolve a SHALLOW class type (TClass(name, SemFieldNil, SemMethodNil)) to its full
# field list from the deep symbol table — the class analogue of sem_deepen_enum,
# applied once per field access so a chain `$a.b.c` (where `b` is class-typed) can
# see `b`'s fields. A non-shallow (already-full) class is returned unchanged.
sub sem_deepen_class($ty: SemType, $subs: SemSubTable): SemType {
    match $ty {
        TClass($name, $fields, $methods) {
            match $fields {
                SemFieldNil {
                    match sem_sub_lookup($subs, $name) {
                        Some($full) { match $full { TClass($fn, $ff, $fm) { $full } _ { $ty } } }
                        None { $ty }
                    }
                }
                _ { $ty }
            }
        }
        _ { $ty }
    }
}

sub sem_method_lookup_kind($ms: SemMethodList, $name: Str, $assoc: Bool): Option[SemType] {
    match $ms {
        SemMethodNil { None }
        SemMethodCons($m, $rest) {
            if $m.name == $name && $m.assoc == $assoc { Some($m.sig) } else { sem_method_lookup_kind($rest, $name, $assoc) }
        }
    }
}

sub sem_field_lookup($fs: SemFieldList, $name: Str): Option[SemField] {
    match $fs {
        SemFieldNil { None }
        SemFieldCons($f, $rest) {
            if $f.name == $name { Some($f) } else { sem_field_lookup($rest, $name) }
        }
    }
}

sub build_sem_sub_table($decls: DeclList): SemSubTable {
    $grammars = build_sem_grammar_symbols($decls, build_sem_enum_names($decls))
    $names = build_sem_class_names($decls, $grammars)
    $enums = build_sem_enum_symbols($decls, $names)
    $classes = build_sem_class_symbols($decls, $names, build_sem_grammar_symbols($decls, $enums))
    build_sem_sub_table_on($decls, $classes)
}

sub build_sem_sub_table_with_imports($decls: DeclList, $imports: SemSubTable): SemSubTable {
    sem_table_append(build_sem_sub_table($decls), $imports)
}

sub sem_sub_lookup($t: SemSubTable, $name: Str): Option[SemType] {
    match $t {
        SSTNil { None }
        SSTCons($n, $sig, $rest) {
            if $n == $name { Some($sig) } else { sem_sub_lookup($rest, $name) }
        }
        SSTIdx($i, $rest) {
            %d = $i.dispatch
            if has_key(%d, $name) {
                $b = %d{$name}
                match sem_sub_lookup(sem_sidx_pick($i.tree, $b), $name) {
                    Some($sig) { Some($sig) }
                    None { sem_sub_lookup($rest, $name) }
                }
            } else {
                sem_sub_lookup($rest, $name)
            }
        }
    }
}

# Seed a frame with this sub's params (annotated -> their type, bare -> TUnknown).
sub params_to_tenv($ps: ParamList, $env: TEnv, $tops: SemSubTable): TEnv {
    match $ps {
        ParamNil { $env }
        ParamCons($h, $rest) { params_to_tenv($rest, tenv_define($env, $h.name, sem_from_opt_type_with($h.ty, $tops)), $tops) }
    }
}

# Type-param-aware twin of params_to_tenv for GENERIC sub bodies (§3.3,
# P5b-2b(e)): the oracle checks a template body with its params typed as
# TypeParam (so `[$x, $head]` in a `twice[T]` body sees T == T, not <?> vs T).
sub params_to_tenv_tps($ps: ParamList, $env: TEnv, $tops: SemSubTable, $tps: StrList): TEnv {
    match $ps {
        ParamNil { $env }
        ParamCons($h, $rest) { params_to_tenv_tps($rest, tenv_define($env, $h.name, sem_from_opt_type_tps($h.ty, $tops, $tps)), $tops, $tps) }
    }
}

# ---- expression synthesis (T1: atoms + EUnary + EBinary) -------------------
# Returns Ok(type) when the subtree is well-typed, or Err(message) at the first
# violation. Accept/reject (any Err -> reject) is what the differential checks;
# short-circuiting on the first error matches the oracle's >=1-error verdict.

pub sub synth_expr($e: Expr, $env: TEnv, $subs: SemSubTable): Result[SemType, Str] {
    synth_expr_ctx($e, $env, $subs, TUnknown)
}

# EStr stores its decoded text rather than interpolation AST children. Re-scan
# §12 markers here so embedded expressions receive the same static checks as an
# ordinary expression. This also makes malformed/unterminated interpolation a
# shared front-end rejection in both canonical drivers instead of a later
# evaluator error or codegen-subset decline.
sub synth_interp_parts(@chars: List[Str], $i: Int, $n: Int, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    if $i >= $n {
        Ok(())
    } else {
        $c = at(@chars, $i)
        $next = at(@chars, $i + 1)
        if $c == "\\" && ($next == '{' || $next == '}' || $next == '$' || $next == '@' || $next == '%') {
            synth_interp_parts(@chars, $i + 2, $n, $env, $subs, $ret_ty)
        } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start($next) {
            $run = take_ident(@chars, $i + 1, $c)
            match synth_expr_ctx(EName($run.text), $env, $subs, $ret_ty) {
                Err($e) { Err($e ~ " in interpolation") }
                Ok($t) { synth_interp_parts(@chars, $run.next, $n, $env, $subs, $ret_ty) }
            }
        } else if $c == '{' {
            match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                None { Err(tc_err("unterminated \{ interpolation in string")) }
                Some($scan) {
                    match parse_interpolation_expr($scan.text) {
                        Err($e) { Err(tc_err("in interpolation " ~ q($scan.text) ~ ": " ~ $e)) }
                        Ok($expr) {
                            match synth_expr_ctx($expr, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok($t) { synth_interp_parts(@chars, $scan.next, $n, $env, $subs, $ret_ty) }
                            }
                        }
                    }
                }
            }
        } else {
            synth_interp_parts(@chars, $i + 1, $n, $env, $subs, $ret_ty)
        }
    }
}

sub synth_interpolated_str($text: Str, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    if has_char($text, '{') || has_char($text, '$') || has_char($text, '@') || has_char($text, '%') {
        @chars = split($text, "")
        match synth_interp_parts(@chars, 0, @chars.count(), $env, $subs, $ret_ty) {
            Err($e) { Err($e) }
            Ok(()) { Ok(TStr) }
        }
    } else {
        Ok(TStr)
    }
}

sub synth_expr_ctx($e: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $e {
        EInt($t) { Ok(TInt) }
        EFloat($t) { Ok(TFloat) }
        EStr($t) { synth_interpolated_str($t, $env, $subs, $ret_ty) }
        ERawStr($t) { Ok(TStr) }
        ERegex($p, $l, $c) { Ok(TUnknown) }
        EQualified($m, $n) {
            match sem_sub_lookup($subs, import_qualified_name($m, $n)) {
                Some($sig) { Ok($sig) }
                None {
                    if import_alias_bound($subs, $m) {
                        Err(tc_err("module " ~ $m ~ " has no member " ~ $n))
                    } else {
                        Ok(TUnknown)
                    }
                }
            }
        }
        EBool($t) { Ok(TBool) }
        EUnit { Ok(TUnit) }
        EName($n) {
            match tenv_resolve($env, $n) {
                Some($r) {
                    # §7.4 (P1b): reading a `mut` binding from inside a closure —
                    # i.e. across a boundary frame — is a compile-time error.
                    if $r.mutable && $r.captured {
                        Err(tc_err("cannot capture mut binding " ~ $n ~ " in a closure; bind it immutably first (§7.4)"))
                    } else {
                        Ok($r.ty)
                    }
                }
                None {
                    # A bare sub name used as a value resolves to its TFn signature
                    # (the oracle binds sub names in the env), so `map(@xs, dbl)` and
                    # passing subs as callbacks type-check rather than reporting an
                    # undefined binding. The three standard handles are likewise
                    # preinstalled values in the oracle's top-level environment
                    # (§15.4), but Handle is not yet a distinct SemType here: keep
                    # their type permissive while still resolving the bindings. A
                    # user sub with the same name wins, matching oracle shadowing.
                    match sem_sub_lookup($subs, $n) {
                        Some($sig) { Ok($sig) }
                        None {
                            if $n == "stdin" || $n == "stdout" || $n == "stderr" {
                                Ok(TUnknown)
                            } else {
                                Err(tc_err("undefined binding " ~ $n))
                            }
                        }
                    }
                }
            }
        }
        EUnary($op, $x) { synth_unary($op, $x, $env, $subs, $ret_ty) }
        EBinary($op, $l, $r) { synth_binary($op, $l, $r, $env, $subs, $ret_ty) }
        ENamedArg($n, $v) { synth_expr_ctx($v, $env, $subs, $ret_ty) }
        # T3a: calls / variant construction / collections / field / index.
        ETypeName($n) { synth_typename($n, $subs) }
        EList($items) { synth_list($items, $env, $subs, $ret_ty) }
        EMap($items) { synth_map($items, $env, $subs, $ret_ty) }
        ECall($callee, $args) { synth_call($callee, $args, $env, $subs, $ret_ty) }
        EField($o, $n) { synth_field($o, $n, $env, $subs, $ret_ty) }
        EIndex($o, $i) { synth_index_expr($o, $i, $env, $subs, $ret_ty) }
        # Literal Match provenance is carried by an internal semantic sentinel;
        # dynamic Match values stay permissive. Bush captures remain checked
        # against known grammar productions.
        ECapture($o, $n) { synth_capture($o, $n, $env, $subs, $ret_ty) }
        EIf($c, $then, $elifs, $els) { synth_if($c, $then, $elifs, $els, $env, $subs, $ret_ty) }
        EMatch($s, $arms) { synth_match($s, $arms, $env, $subs, $ret_ty) }
        ELambda($params, $ret, $body, $topic) { synth_lambda($params, $ret, $body, $topic, $env, $subs) }
        EQuestion($x) { synth_question($x, $env, $subs, $ret_ty) }
    }
}

sub sem_any_grammar_has_prod($subs: SemSubTable, $name: Str): Bool {
    match $subs {
        SSTNil { false }
        SSTCons($n, $ty, $rest) {
            match $ty {
                TGrammar($gn, $ps) { strlist_contains($ps, $name) || sem_any_grammar_has_prod($rest, $name) }
                _ { sem_any_grammar_has_prod($rest, $name) }
            }
        }
        SSTIdx($i, $rest) {
            # Value-shaped scan: walk the extracted entries in original order,
            # then whatever follows the index node.
            sem_any_grammar_has_prod($i.flat, $name) || sem_any_grammar_has_prod($rest, $name)
        }
    }
}

sub synth_capture($o: Expr, $name: Str, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($o, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($ot) {
            match $ot {
                TGrammar($kind, $names) {
                    if $kind == "__guji_literal_match" {
                        if strlist_contains($names, $name) {
                            Ok(TOption(TStr))
                        } else {
                            Err(tc_err("Match has no named capture " ~ $name ~ " in literal regex (§13.4)"))
                        }
                    } else {
                        Ok(TUnknown)
                    }
                }
                TBush {
                    if sem_any_grammar_has_prod($subs, $name) {
                        Ok(TOption(TBush))
                    } else {
                        Err(tc_err("Bush has no production " ~ $name))
                    }
                }
                _ { Ok(TUnknown) }
            }
        }
    }
}

# §7.4 (P1b): synthesize the `TFn` type of a lambda (parameterized or topic block).
# The body is checked in a CLOSURE-BOUNDARY frame (`tenv_func_child`) seeded with
# the lambda's parameters, so any read/assign of an enclosing `mut` binding inside
# the body is rejected by the §7.4 capture rule (see EName / SBind). The parser
# already encodes a topic block `{ ... }` as a one-parameter lambda over `$_`, so
# no special case is needed here. Mirrors the Go `inferLambdaExpr`:
#   - param types come from annotations (bare -> TUnknown),
#   - the return type is the annotation when present, else the body's type,
#   - an explicit annotation must match the body type (`ret.Equal(annotated)`).
sub synth_lambda($params: ParamList, $ret: Option[TypeRef], $body: StmtList, $topic: Bool, $env: TEnv, $subs: SemSubTable): Result[SemType, Str] {
    $local = params_to_tenv($params, tenv_func_child($env), $subs)
    $ann_ret = sem_from_opt_type_with($ret, $subs)
    match check_block_expected_t2($body, $local, $subs, $ann_ret, TUnit) {
        Err($e) { Err($e) }
        Ok($r) {
            $param_tys = params_to_semlist_with($params, $subs)
            match $ret {
                None { Ok(TFn($param_tys, $r.ty)) }
                Some($tr) {
                    if !sem_eq($r.ty, $ann_ret) && !is_never($r.ty) {
                        Err(tc_err("lambda body returns " ~ sem_to_str($r.ty) ~ ", expected " ~ sem_to_str($ann_ret)))
                    } else {
                        Ok(TFn($param_tys, $ann_ret))
                    }
                }
            }
        }
    }
}

# §11.1 (P3b-1): the postfix `?` operator. Faithful port of the oracle's
# `inferQuestionExpr`, within the limits of the selfhost SemType lattice:
#   - `Option[T]` IS modeled (`TOption`), so the Option rule is enforced exactly:
#     `?` on an Option is only valid when the enclosing sub returns Option
#     (permissive when the return is unannotated / `TUnknown`, mirroring the
#     oracle's `openType(ret)` guard); the expression yields the element type.
#   - `Result[T, E]` is modeled precisely enough for generic rejection parity:
#     it unwraps only inside a Result-returning sub whose error type matches.
#   - `TNever` propagates (`?` on a diverging operand is `Never`).
#   - any other concrete operand kind is rejected exactly like the oracle.
# `$ret_ty` is the enclosing sub's declared return type (threaded from
# `check_program_t2` / `synth_lambda`).
sub synth_question($x: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($x, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($inner) {
            if is_never($inner) {
                Ok(TNever)
            } else if is_unknown($inner) {
                # Unknown/unconstrained operand — also covers the unmodeled Result
                # carrier — so stay permissive (the oracle's `openType(inner)` arm).
                Ok(TUnknown)
            } else {
                match $inner {
                    TOption($elem) {
                        if is_unknown($ret_ty) {
                            Ok($elem)
                        } else {
                            match $ret_ty {
                                TOption($r) { Ok($elem) }
                                _ { Err(tc_err("? on Option requires the enclosing sub to return Option, but it returns " ~ sem_to_str($ret_ty))) }
                            }
                        }
                    }
                    TRes($ok, $err) {
                        if is_unknown($ret_ty) {
                            Ok($ok)
                        } else {
                            match $ret_ty {
                                TRes($rok, $rerr) {
                                    if sem_assignable($err, $rerr) && sem_assignable($rerr, $err) {
                                        Ok($ok)
                                    } else {
                                        Err(tc_err("? on Result requires the enclosing sub to return Result with error " ~ sem_to_str($err) ~ ", but it returns " ~ sem_to_str($ret_ty)))
                                    }
                                }
                                _ { Err(tc_err("? on Result requires the enclosing sub to return Result, but it returns " ~ sem_to_str($ret_ty))) }
                            }
                        }
                    }
                    _ { Err(tc_err("? requires an Option or Result operand, got " ~ sem_to_str($inner))) }
                }
            }
        }
    }
}

sub synth_unary($op: Str, $x: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($x, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($t) {
            if $op == "!" {
                if !sem_eq($t, TBool) && !is_never($t) {
                    Err(tc_err("operator ! requires Bool, got " ~ sem_to_str($t)))
                } else {
                    Ok(TBool)
                }
            } else if $op == "-" {
                if sem_eq($t, TInt) || sem_eq($t, TFloat) || is_never($t) {
                    Ok($t)
                } else {
                    Err(tc_err("operator - requires Int or Float, got " ~ sem_to_str($t)))
                }
            } else {
                Err(tc_err("unknown unary operator " ~ $op))
            }
        }
    }
}

sub synth_binary($op: Str, $l: Expr, $r: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($l, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($lt) {
            match synth_expr_ctx($r, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($rt) {
                    if $op == "~~" {
                        match $r {
                            ERegex($pattern, $line, $col) {
                                if g6_regex_pattern_has_splice($pattern) {
                                    Ok(TUnknown)
                                } else {
                                    Ok(TOption(TGrammar("__guji_literal_match", g6_regex_cap_names_host($pattern))))
                                }
                            }
                            _ { Ok(TUnknown) }
                        }
                    } else {
                        synth_binop($op, $lt, $rt)
                    }
                }
            }
        }
    }
}

# Operand-typing rules, §5.1-5.2 — a faithful port of the oracle's
# `inferBinaryExpr` switch (so accept/reject matches exactly).
sub synth_binop($op: Str, $lt: SemType, $rt: SemType): Result[SemType, Str] {
    if $op == ".." || $op == "..<" {
        if !sem_eq($lt, TInt) && !is_never($lt) && !is_unknown($lt) {
            Err(tc_err("range bound must be Int, got " ~ sem_to_str($lt)))
        } else if !sem_eq($rt, TInt) && !is_never($rt) && !is_unknown($rt) {
            Err(tc_err("range bound must be Int, got " ~ sem_to_str($rt)))
        } else {
            Ok(TRange)
        }
    } else if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" {
        # TUnknown operand is PERMISSIVE here, like TNever (same stance as the PLit
        # pattern check and synth_index/E5d-5). The Go oracle types most things
        # precisely, so its arithmetic `Int - <?>` reject only fires on a genuinely
        # unannotated operand. The selfhost, however, also produces TUnknown for
        # operands of UNMODELED types — most importantly Result payloads bound by an
        # `Ok($r)`/`Err($e)` arm (Result is deliberately not in the SemType lattice,
        # so `check_unknown_variant_fields` binds the payload to TUnknown). The real
        # source's `0 - $n` (`$n` bound via `Ok($r)` -> `$r.value` -> `VInt($n)`) is
        # `Int - <?>` to the selfhost but `Int - Int` to the oracle, which accepts.
        # The selfhost cannot distinguish the two TUnknown origins, so it stays
        # permissive (accepting both) rather than false-reject the well-typed source.
        if !sem_eq($lt, $rt) && !is_never($lt) && !is_never($rt) && !is_unknown($lt) && !is_unknown($rt) {
            Err(tc_err("operator " ~ $op ~ " requires matching operand types, got " ~ sem_to_str($lt) ~ " and " ~ sem_to_str($rt)))
        } else if sem_eq($lt, TInt) || sem_eq($lt, TFloat) || is_never($lt) || is_unknown($lt) {
            Ok($lt)
        } else {
            Err(tc_err("operator " ~ $op ~ " requires Int or Float, got " ~ sem_to_str($lt)))
        }
    } else if $op == "~" {
        if (!sem_eq($lt, TStr) || !sem_eq($rt, TStr)) && !is_never($lt) && !is_never($rt) {
            Err(tc_err("operator ~ requires Str operands, got " ~ sem_to_str($lt) ~ " and " ~ sem_to_str($rt)))
        } else {
            Ok(TStr)
        }
    } else if $op == "==" || $op == "!=" {
        if !sem_eq($lt, $rt) && !is_never($lt) && !is_never($rt) {
            Err(tc_err("operator " ~ $op ~ " requires matching operand types, got " ~ sem_to_str($lt) ~ " and " ~ sem_to_str($rt)))
        } else {
            Ok(TBool)
        }
    } else if $op == "<" || $op == "<=" || $op == ">" || $op == ">=" {
        if !sem_eq($lt, $rt) && !is_never($lt) && !is_never($rt) {
            Err(tc_err("operator " ~ $op ~ " requires matching operand types, got " ~ sem_to_str($lt) ~ " and " ~ sem_to_str($rt)))
        } else if sem_eq($lt, TInt) || sem_eq($lt, TFloat) || sem_eq($lt, TStr) || is_never($lt) {
            Ok(TBool)
        } else {
            Err(tc_err("operator " ~ $op ~ " requires Int, Float, or Str, got " ~ sem_to_str($lt)))
        }
    } else if $op == "&&" || $op == "||" {
        if !sem_eq($lt, TBool) && !is_never($lt) {
            Err(tc_err("operator " ~ $op ~ " requires Bool, got " ~ sem_to_str($lt)))
        } else if !sem_eq($rt, TBool) && !is_never($rt) {
            Err(tc_err("operator " ~ $op ~ " requires Bool, got " ~ sem_to_str($rt)))
        } else {
            Ok(TBool)
        }
    } else {
        # `~~` (Option[Match]) produces a type outside the T1 model. Stay
        # permissive until Match provenance is represented in SemType.
        Ok(TUnknown)
    }
}

# ---- T3a: calls, variant construction, collections, field, index ----------
# A faithful port of the oracle's call/collection/index inference. The semantic
# model has no ClassType/EnumType/Result, so anything that resolves through those
# (user methods, record fields, Ok/Err carriers) stays permissive TUnknown rather
# than over-rejecting; the differential corpus excludes such cases (documented in
# the slice notes). The genuinely-precise checks added here are: user-sub call
# argument typing (`argument N has type X, expected Y` / arity), list/map element
# typing, and List/Map indexing.

sub exprlist_len($xs: ExprList): Int {
    match $xs {
        ExprNil { 0 }
        ExprCons($h, $rest) { 1 + exprlist_len($rest) }
    }
}

sub semlist_len($ts: SemTypeList): Int {
    match $ts {
        SemTNil { 0 }
        SemTCons($h, $rest) { 1 + semlist_len($rest) }
    }
}

# Synthesize each argument left-to-right purely to surface nested type errors
# (the call itself stays permissive). Returns Ok(()) when every arg type-checks.
sub synth_args($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $args {
        ExprNil { Ok(()) }
        ExprCons($a, $rest) {
            match synth_expr_ctx($a, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($t) { synth_args($rest, $env, $subs, $ret_ty) }
            }
        }
    }
}

# Bare type name as a value. `None` is an Option (Option[<?>]); uncalled
# `Ok`/`Err` constructors and user enum/class names stay permissive TUnknown.
sub synth_typename($n: Str, $subs: SemSubTable): Result[SemType, Str] {
    if $n == "None" {
        Ok(TOption(TUnknown))
    } else if $n == "Closed" {
        Ok(TClosed)
    } else {
        match sem_sub_lookup($subs, $n) {
            Some($ty) { Ok($ty) }
            None { Ok(TUnknown) }
        }
    }
}

# §17.2: `channel()` has no element type of its own. A surrounding concrete
# Chan[T] type supplies T; an unannotated or non-channel context is a static
# error. Capacity is optional and must be Int. This is the selfhost twin of the
# Go checker's inferExprWithExpected / inferChannelCall path.
sub synth_channel_call($args: ExprList, $expected: SemType, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    $n = exprlist_len($args)
    if $n > 1 {
        Err(tc_err("channel() takes at most one argument (the buffer capacity), got { $n }"))
    } else {
        match check_channel_capacity($args, $env, $subs, $ret_ty) {
            Err($e) { Err($e) }
            Ok(()) {
                match $expected {
                    TChan($elem) { Ok($expected) }
                    _ { Err(tc_err("cannot infer channel element type; annotate with Chan[T] (§17.2)")) }
                }
            }
        }
    }
}

sub check_channel_capacity($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $args {
        ExprNil { Ok(()) }
        ExprCons($cap, $rest) {
            match synth_expr_ctx($cap, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($ct) {
                    if sem_eq($ct, TInt) || sem_open($ct) || is_never($ct) {
                        Ok(())
                    } else {
                        Err(tc_err("channel capacity must be Int, got " ~ sem_to_str($ct)))
                    }
                }
            }
        }
    }
}

# channel() is the only non-lambda v0 expression whose type cannot be
# synthesized without its consumer. All other expressions use the ordinary
# bottom-up path.
sub synth_expr_expected($e: Expr, $expected: SemType, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $e {
        ECall(EName($name), $args) {
            if $name == "channel" && !args_have_named($args) {
                synth_channel_call($args, $expected, $env, $subs, $ret_ty)
            } else {
                synth_expr_ctx($e, $env, $subs, $ret_ty)
            }
        }
        _ { synth_expr_ctx($e, $env, $subs, $ret_ty) }
    }
}

# List literal: empty -> List[<?>]; otherwise the first element fixes the element
# type and every later element must directionally equal it (`ty.Equal(first)`),
# mirroring the oracle's `inferListLiteral`. A `Never` element is skipped.
sub synth_list($items: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $items {
        ExprNil { Ok(TList(TUnknown)) }
        ExprCons($first, $rest) {
            match synth_expr_ctx($first, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($ft) {
                    match check_list_rest($rest, $ft, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) { Ok(TList($ft)) }
                    }
                }
            }
        }
    }
}

sub check_list_rest($items: ExprList, $first: SemType, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $items {
        ExprNil { Ok(()) }
        ExprCons($e, $rest) {
            match synth_expr_ctx($e, $env, $subs, $ret_ty) {
                Err($err) { Err($err) }
                Ok($et) {
                    if !sem_eq($et, $first) && !is_never($et) {
                        Err(tc_err("list element " ~ sem_to_str($et) ~ " does not match first element type " ~ sem_to_str($first)))
                    } else {
                        check_list_rest($rest, $first, $env, $subs, $ret_ty)
                    }
                }
            }
        }
    }
}

# Map literal: empty -> Map[<?>, <?>]; otherwise every key must be Str (v0 maps
# are Str-keyed; Unknown/Never keys are exempt) and the first value fixes the
# value type. Result is always Map[Str, firstVal], mirroring `inferMapLiteral`.
sub synth_map($items: MapEntryList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $items {
        MapEntryNil { Ok(TMap(TUnknown, TUnknown)) }
        MapEntryCons($first, $rest) {
            match check_map_key($first.key, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok(()) {
                    match synth_expr_ctx($first.value, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok($fv) {
                            match check_map_rest($rest, $fv, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok(()) { Ok(TMap(TStr, $fv)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub check_map_key($key: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match synth_expr_ctx($key, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($kt) {
            if !is_unknown($kt) && !is_never($kt) && !sem_eq($kt, TStr) {
                Err(tc_err("map key must be Str (v0 maps are Str-keyed), got " ~ sem_to_str($kt)))
            } else {
                Ok(())
            }
        }
    }
}

sub check_map_rest($items: MapEntryList, $fv: SemType, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $items {
        MapEntryNil { Ok(()) }
        MapEntryCons($e, $rest) {
            match check_map_key($e.key, $env, $subs, $ret_ty) {
                Err($err) { Err($err) }
                Ok(()) {
                    match synth_expr_ctx($e.value, $env, $subs, $ret_ty) {
                        Err($err) { Err($err) }
                        Ok($vt) {
                            if !sem_eq($vt, $fv) && !is_never($vt) {
                                Err(tc_err("map value " ~ sem_to_str($vt) ~ " does not match first value type " ~ sem_to_str($fv)))
                            } else {
                                check_map_rest($rest, $fv, $env, $subs, $ret_ty)
                            }
                        }
                    }
                }
            }
        }
    }
}

# Bare field access `$o.name` (NOT a call). Mirrors the oracle's inferFieldExpr
# (§8): a Never object short-circuits to Never; a CLASS object resolves the named
# field — a PUBLIC field yields its declared type, reading a PRIVATE ($!) field
# that EXISTS is a type error ("X has no public field Y"), and a field NAME that
# does not exist on the class is left permissive (Unknown) so a data-first uniform
# call is never misreported (the oracle reports the missing field at RUNTIME, not
# type-check time). Every non-class object stays Unknown (permissive). Nested
# errors in the object still propagate.
sub synth_field($o: Expr, $n: Str, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $o {
        ETypeName($tn) {
            match sem_sub_lookup($subs, $tn) {
                Some($tty) {
                    match $tty {
                        TClass($cname, $fields, $methods) {
                            match sem_method_lookup_kind($methods, $n, true) {
                                Some($sig) { Ok($sig) }
                                None { Ok(TUnknown) }
                            }
                        }
                        TGrammar($gname, $productions) {
                            if $n == "parse" {
                                Ok(TFn(SemTCons(TStr, SemTNil), TOption(TBush)))
                            } else {
                                Err(tc_err("grammar " ~ $gname ~ " has no associated function " ~ $n))
                            }
                        }
                        _ { synth_field_value($o, $n, $env, $subs, $ret_ty) }
                    }
                }
                None { synth_field_value($o, $n, $env, $subs, $ret_ty) }
            }
        }
        _ { synth_field_value($o, $n, $env, $subs, $ret_ty) }
    }
}

sub synth_field_value($o: Expr, $n: Str, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($o, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($ot0) {
            if is_never($ot0) {
                Ok(TNever)
            } else {
                match sem_deepen_class($ot0, $subs) {
                    TClass($cname, $fields, $methods) {
                        match sem_field_lookup($fields, $n) {
                            Some($f) {
                                if $f.public {
                                    Ok($f.ty)
                                } else {
                                    Err(tc_err($cname ~ " has no public field " ~ $n))
                                }
                            }
                            None { Ok(TUnknown) }
                        }
                    }
                    TBush {
                        if $n == "text" {
                            Ok(TStr)
                        } else {
                            Err(tc_err("Bush has no field " ~ $n))
                        }
                    }
                    _ { Ok(TUnknown) }
                }
            }
        }
    }
}

# Indexing `$o[$i]`: List -> elem (index must be Int), Map -> val (index must be
# the key type, i.e. Str), Unknown/Never object -> Unknown (no error), anything
# else concrete -> "cannot index type X". Unknown stays permissive because this
# checker does not model most prelude UFCS return types (e.g. List.sort()).
sub synth_index_expr($o: Expr, $i: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($o, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($ot) {
            match synth_expr_ctx($i, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($it) {
                    match $ot {
                        TGrammar($kind, $names) {
                            if $kind == "__guji_literal_match" {
                                if !sem_eq($it, TInt) && !is_never($it) {
                                    Err(tc_err("Match index must be Int, got " ~ sem_to_str($it)))
                                } else {
                                    match $i {
                                        EInt($text) {
                                            match parse_int_lit($text) {
                                                Err($e) { Err($e) }
                                                Ok($index) {
                                                    $groups = g6_strlist_len($names)
                                                    if $index < 0 || $index > $groups {
                                                        Err(tc_err("Match capture index { $index } is out of range for literal regex with { $groups } group(s) (§13.4)"))
                                                    } else {
                                                        Ok(TOption(TStr))
                                                    }
                                                }
                                            }
                                        }
                                        _ { Ok(TOption(TStr)) }
                                    }
                                }
                            } else {
                                synth_index($ot, $it)
                            }
                        }
                        _ { synth_index($ot, $it) }
                    }
                }
            }
        }
    }
}

sub synth_index($ot: SemType, $it: SemType): Result[SemType, Str] {
    match $ot {
        TList($e) {
            if !sem_eq($it, TInt) && !is_never($it) {
                Err(tc_err("list index must be Int, got " ~ sem_to_str($it)))
            } else {
                Ok($e)
            }
        }
        TMap($k, $v) {
            if !sem_eq($it, $k) && !is_never($it) {
                Err(tc_err("map key must be " ~ sem_to_str($k) ~ ", got " ~ sem_to_str($it)))
            } else {
                Ok($v)
            }
        }
        TUnknown { Ok(TUnknown) }
        TNever { Ok(TUnknown) }
        _ { Err(tc_err("cannot index type " ~ sem_to_str($ot))) }
    }
}

# Call dispatch. NAMED arguments mean class construction (§8.2) — the oracle keys
# on `len(e.Named) > 0` and routes to inferConstruction BEFORE any callee analysis,
# so we mirror that first. Otherwise three precise cases plus a permissive fallback:
#   - EName: user sub (sub-signature table) -> argument/arity checking; otherwise
#     (prelude builtins, locals we do not model) permissive after arg synthesis.
#   - ETypeName "Some": Option construction -> Option[argType]; other constructors
#     (Ok/Err/user) stay permissive after arg synthesis.
#   - EField callee: UFCS/method call -> synth receiver + args, permissive.
sub synth_call($callee: Expr, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    if args_have_named($args) {
        synth_construction($callee, $args, $env, $subs, $ret_ty)
    } else {
        synth_call_plain($callee, $args, $env, $subs, $ret_ty)
    }
}

# An ExprList carries named args as ENamedArg entries (E2) interleaved with plain
# positional exprs; these two predicates classify what is present.
sub args_have_named($args: ExprList): Bool {
    match $args {
        ExprNil { false }
        ExprCons($a, $rest) {
            match $a { ENamedArg($n, $v) { true } _ { args_have_named($rest) } }
        }
    }
}

sub args_have_positional($args: ExprList): Bool {
    match $args {
        ExprNil { false }
        ExprCons($a, $rest) {
            match $a { ENamedArg($n, $v) { args_have_positional($rest) } _ { true } }
        }
    }
}

# Class construction with named arguments (§8.2). The callee must name a class:
# a PascalExpr (ETypeName) is looked up directly in the type table, and a non-class
# there is "X is not a class"; any other callee that infers to a non-class type is
# "named arguments are only valid in class construction" — both verbatim oracle
# diagnostics.
sub synth_construction($callee: Expr, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $callee {
        ETypeName($n) {
            match sem_sub_lookup($subs, $n) {
                Some($ty) {
                    match $ty {
                        TClass($cn, $fs, $ms) { check_construction($ty, $args, $env, $subs, $ret_ty) }
                        _ { Err(tc_err($n ~ " is not a class")) }
                    }
                }
                None { Err(tc_err($n ~ " is not a class")) }
            }
        }
        _ {
            match synth_expr_ctx($callee, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($ct) {
                    match $ct {
                        TClass($cn, $fs, $ms) { check_construction($ct, $args, $env, $subs, $ret_ty) }
                        _ { Err(tc_err("named arguments are only valid in class construction")) }
                    }
                }
            }
        }
    }
}

# Validate a class-construction argument list against the class's declared fields
# (mirrors the oracle's checkConstructionFields): mixed positional args are an
# error; every declared field must be supplied exactly once with an assignable
# value; and a named arg that matches no field is an error. The result type is the
# class itself. Reject on the FIRST violation — accept/reject parity is all the
# differential needs, and the oracle's verdict is reject on >= 1 error.
sub check_construction($ct: SemType, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $ct {
        TClass($name, $fields, $methods) {
            if args_have_positional($args) {
                Err(tc_err("class construction uses named arguments only"))
            } else {
                match check_ctor_fields($fields, $args, $name, $env, $subs, $ret_ty) {
                    Err($e) { Err($e) }
                    Ok(()) {
                        match check_ctor_extra($args, $fields, $name) {
                            Err($e) { Err($e) }
                            Ok(()) { Ok($ct) }
                        }
                    }
                }
            }
        }
        _ { Ok(TUnknown) }
    }
}

sub find_named_arg($args: ExprList, $name: Str): Option[Expr] {
    match $args {
        ExprNil { None }
        ExprCons($a, $rest) {
            match $a {
                ENamedArg($n, $v) { if $n == $name { Some($v) } else { find_named_arg($rest, $name) } }
                _ { find_named_arg($rest, $name) }
            }
        }
    }
}

sub check_ctor_fields($fields: SemFieldList, $args: ExprList, $cname: Str, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $fields {
        SemFieldNil { Ok(()) }
        SemFieldCons($f, $rest) {
            match find_named_arg($args, $f.name) {
                None { Err(tc_err("missing field " ~ $f.name ~ " for " ~ $cname ~ " construction")) }
                Some($val) {
                    match synth_expr_expected($val, $f.ty, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok($vt) {
                            if sem_assignable($vt, $f.ty) {
                                check_ctor_fields($rest, $args, $cname, $env, $subs, $ret_ty)
                            } else {
                                Err(tc_err("field " ~ $f.name ~ " has type " ~ sem_to_str($vt) ~ ", expected " ~ sem_to_str($f.ty)))
                            }
                        }
                    }
                }
            }
        }
    }
}

sub check_ctor_extra($args: ExprList, $fields: SemFieldList, $cname: Str): Result[Unit, Str] {
    match $args {
        ExprNil { Ok(()) }
        ExprCons($a, $rest) {
            match $a {
                ENamedArg($n, $v) {
                    match sem_field_lookup($fields, $n) {
                        Some($f) { check_ctor_extra($rest, $fields, $cname) }
                        None { Err(tc_err($cname ~ " has no field " ~ $n)) }
                    }
                }
                _ { check_ctor_extra($rest, $fields, $cname) }
            }
        }
    }
}

sub synth_assoc_call($type_name: Str, $fn_name: Str, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Option[SemType], Str] {
    match sem_sub_lookup($subs, $type_name) {
        Some($tty) {
            match $tty {
                TClass($cname, $fields, $methods) {
                    match sem_method_lookup_kind($methods, $fn_name, true) {
                        Some($sig) {
                            match $sig {
                                TFn($params, $ret) {
                                    match check_call_args($args, $params, $ret, $env, $subs, $ret_ty) {
                                        Err($e) { Err($e) }
                                        Ok($ty) { Ok(Some($ty)) }
                                    }
                                }
                                _ { Ok(Some(TUnknown)) }
                            }
                        }
                        None { Err(tc_err($cname ~ " has no associated function " ~ $fn_name)) }
                    }
                }
                # §7.5 enum ASSOCIATED-function call `EnumName.assoc(args)`. Only
                # when `$type_name` is the enum's own name is this an assoc call;
                # a VARIANT name here (`Red.method()`, same TEnum type but keyed by
                # variant) is a nullary-variant instance receiver, so defer to the
                # data-first fallback (Ok(None)). Unlike the class arm we do NOT
                # reject an unknown assoc — enum method dispatch also admits
                # instance methods via the fallback, so stay permissive when the
                # associated function is not found.
                TEnum($ename, $variants) {
                    if $type_name == $ename {
                        match sem_enum_method_lookup($subs, $ename, $fn_name, true) {
                            Some($sig) {
                                match $sig {
                                    TFn($params, $ret) {
                                        match check_call_args($args, $params, $ret, $env, $subs, $ret_ty) {
                                            Err($e) { Err($e) }
                                            Ok($ty) { Ok(Some($ty)) }
                                        }
                                    }
                                    _ { Ok(Some(TUnknown)) }
                                }
                            }
                            None { Ok(None) }
                        }
                    } else {
                        Ok(None)
                    }
                }
                TGrammar($gname, $productions) {
                    if $fn_name == "parse" {
                        match check_call_args($args, SemTCons(TStr, SemTNil), TOption(TBush), $env, $subs, $ret_ty) {
                            Err($e) { Err($e) }
                            Ok($ty) { Ok(Some($ty)) }
                        }
                    } else {
                        Err(tc_err("grammar " ~ $gname ~ " has no associated function " ~ $fn_name))
                    }
                }
                _ { Ok(None) }
            }
        }
        None { Ok(None) }
    }
}

# Named-callee resolution after channel builder / channel free-ops. Lexical
# bindings resolve first (matching eval_call), then user subs, then builtins.
sub synth_call_named_or_prelude($n: Str, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match tenv_resolve($env, $n) {
        Some($r) {
            if $r.mutable && $r.captured {
                Err(tc_err("cannot capture mut binding " ~ $n ~ " in a closure; bind it immutably first (§7.4)"))
            } else {
                match $r.ty {
                    TFn($params, $ret) { check_call_args($args, $params, $ret, $env, $subs, $ret_ty) }
                    _ {
                        match synth_args($args, $env, $subs, $ret_ty) {
                            Err($e) { Err($e) }
                            Ok(()) { Ok(TUnknown) }
                        }
                    }
                }
            }
        }
        None {
            match sem_sub_lookup($subs, $n) {
                Some($sig) {
                    match $sig {
                        TFn($params, $ret) { check_call_args($args, $params, $ret, $env, $subs, $ret_ty) }
                        _ {
                            match synth_args($args, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok(()) { Ok(TUnknown) }
                            }
                        }
                    }
                }
                None {
                    # Prelude builtins are mostly unmodeled, so stay permissive
                    # and only surface errors nested inside their arguments.
                    if $n == "panic" {
                        synth_panic_call($args, $env, $subs, $ret_ty)
                    } else if $n == "exit" {
                        synth_exit_call($args, $env, $subs, $ret_ty)
                    } else {
                        match synth_args($args, $env, $subs, $ret_ty) {
                            Err($e) { Err($e) }
                            Ok(()) { Ok(TUnknown) }
                        }
                    }
                }
            }
        }
    }
}

sub synth_call_plain($callee: Expr, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $callee {
        EName($n) {
            # Private compiler/runtime bridge for I10f. These names are used only
            # by the Guji-written evaluator: snapshot before its runtime-sized
            # guest-select poll, then park after a full miss without losing a
            # scheduler event. Keep their signatures precise so the eventual D
            # call sites cannot accidentally widen the internal ABI.
            if $n == "__guji_progress_snapshot" {
                check_call_args($args, SemTNil, TInt, $env, $subs, $ret_ty)
            } else if $n == "__guji_select_wait" {
                check_call_args($args, SemTCons(TInt, SemTNil), TUnit, $env, $subs, $ret_ty)
            } else if $n == "channel" {
                synth_channel_call($args, TUnknown, $env, $subs, $ret_ty)
            } else if $n == "send" || $n == "recv" || $n == "close" {
                # §17.3 / §7.2: try the channel free-function form first when the
                # leading argument is Chan[T] (mirrors Go inferPreludeCall before
                # ordinary callee resolution). Non-channel receivers fall through.
                match synth_chan_free_op($n, $args, $env, $subs, $ret_ty) {
                    Err($e) { Err($e) }
                    Ok(Some($ty)) { Ok($ty) }
                    Ok(None) { synth_call_named_or_prelude($n, $args, $env, $subs, $ret_ty) }
                }
            } else {
                synth_call_named_or_prelude($n, $args, $env, $subs, $ret_ty)
            }
        }
        ETypeName($n) {
            if $n == "Some" {
                synth_some_call($args, $env, $subs, $ret_ty)
            } else if $n == "Ok" {
                synth_ok_call($args, $env, $subs, $ret_ty)
            } else if $n == "Err" {
                synth_err_call($args, $env, $subs, $ret_ty)
            } else {
                match sem_sub_lookup($subs, $n) {
                    Some($sig) {
                        match $sig {
                            TFn($params, $ret) { check_call_args($args, $params, $ret, $env, $subs, $ret_ty) }
                            _ {
                                match synth_args($args, $env, $subs, $ret_ty) {
                                    Err($e) { Err($e) }
                                    Ok(()) { Ok(TUnknown) }
                                }
                            }
                        }
                    }
                    None {
                        match synth_args($args, $env, $subs, $ret_ty) {
                            Err($e) { Err($e) }
                            Ok(()) { Ok(TUnknown) }
                        }
                    }
                }
            }
        }
        EQualified($m, $n) {
            match sem_sub_lookup($subs, import_qualified_name($m, $n)) {
                Some($sig) {
                    match $sig {
                        TFn($params, $ret) { check_call_args($args, $params, $ret, $env, $subs, $ret_ty) }
                        _ {
                            match synth_args($args, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok(()) { Ok(TUnknown) }
                            }
                        }
                    }
                }
                None {
                    if import_alias_bound($subs, $m) {
                        Err(tc_err("module " ~ $m ~ " has no member " ~ $n))
                    } else {
                        match synth_args($args, $env, $subs, $ret_ty) {
                            Err($e) { Err($e) }
                            Ok(()) { Ok(TUnknown) }
                        }
                    }
                }
            }
        }
        EField($obj, $name) {
            # §8.3/§7.5: class instance methods and associated functions resolve
            # before the generic data-first UFCS fallback. A method signature has
            # `$self` stripped at registration time, so only explicit call args are
            # checked here. If a class instance has no such method, keep the existing
            # permissive UFCS behavior; if a Pascal class type lacks an associated
            # function, mirror native and reject.
            match $obj {
                ETypeName($tn) {
                    match synth_assoc_call($tn, $name, $args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(Some($ty)) { Ok($ty) }
                        Ok(None) { synth_field_call_fallback($obj, $name, $args, $env, $subs, $ret_ty) }
                    }
                }
                _ { synth_field_call_fallback($obj, $name, $args, $env, $subs, $ret_ty) }
            }
        }
        _ {
            match synth_expr_ctx($callee, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($ct) {
                    match synth_args($args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) { Ok(TUnknown) }
                    }
                }
            }
        }
    }
}

sub synth_field_call_fallback($obj: Expr, $name: Str, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
            # Prelude method exceptions matching the oracle (check.go):
            #   - `list.count()` → Int (operand-position uses need a concrete type)
            #   - Chan send/recv/close (§17.3) → Result[Unit,Closed] / Option[T]
            # Unrecognized names on a channel stay permissive (fall through), so a
            # UFCS call like `consume($ch)` still resolves as an ordinary free sub.
    match synth_expr_ctx($obj, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($ot0) {
            $ot = sem_deepen_class($ot0, $subs)
            match $ot {
                TClass($cname, $fields, $methods) {
                    match sem_method_lookup_kind($methods, $name, false) {
                        Some($sig) {
                            match $sig {
                                TFn($params, $ret) { check_call_args($args, $params, $ret, $env, $subs, $ret_ty) }
                                _ { Ok(TUnknown) }
                            }
                        }
                        None {
                            match synth_args($args, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok(()) { Ok(TUnknown) }
                            }
                        }
                    }
                }
                # §9 enum INSTANCE method call `$e.method(args)` (the enum twin of
                # the TClass arm above). Signatures come from the qualified-key
                # table, so a shallow TEnum receiver is fine — only the name is
                # used. An unregistered method (generic enum, or a prelude UFCS on
                # an enum value) stays permissive, exactly as before.
                TEnum($ename, $variants) {
                    match sem_enum_method_lookup($subs, $ename, $name, false) {
                        Some($sig) {
                            match $sig {
                                TFn($params, $ret) { check_call_args($args, $params, $ret, $env, $subs, $ret_ty) }
                                _ { Ok(TUnknown) }
                            }
                        }
                        None {
                            match synth_args($args, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok(()) { Ok(TUnknown) }
                            }
                        }
                    }
                }
                TChan($elem) { synth_chan_method_call($name, $elem, $args, $env, $subs, $ret_ty) }
                # §15.3 Str-receiver prelude methods (the oracle's inferPreludeCall
                # `case *Prim` Str branch). Only the unary Str->Str trio is modeled:
                # it returns Str (arity 0 explicit args, oracle-verbatim diagnostic),
                # which keeps e.g. a map literal's first value CONCRETE where the
                # permissive TUnknown fallback made a later Str value a false
                # mismatch (P9-2). Nested arg errors surface before the arity error
                # (the oracle's speculative probe infers every arg up front). All
                # other Str-receiver names stay permissive until their typing is
                # ported.
                TStr {
                    match synth_args($args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) {
                            if $name == "trim" || $name == "upper" || $name == "lower" {
                                match $args {
                                    ExprNil { Ok(TStr) }
                                    _ { Err(tc_err("expected 0 arguments, got " ~ "{ exprlist_len($args) }")) }
                                }
                            } else {
                                Ok(TUnknown)
                            }
                        }
                    }
                }
                _ {
                    match synth_args($args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) {
                            if $name == "count" {
                                match $ot {
                                    TList($elem) { Ok(TInt) }
                                    _ { Ok(TUnknown) }
                                }
                            } else {
                                Ok(TUnknown)
                            }
                        }
                    }
                }
            }
        }
    }
}

# §17.3 data-first channel methods on a `Chan[T]` receiver. Arity counts EXPLICIT
# args only (the receiver is already typed); payload of `send` must match T.
# Unrecognized names return TUnknown after synthesizing args — same fall-through
# as the Go oracle's ChanType prelude switch.
sub synth_chan_method_call($name: Str, $elem: SemType, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    if $name == "send" {
        check_call_args($args, SemTCons($elem, SemTNil), TRes(TUnit, TClosed), $env, $subs, $ret_ty)
    } else if $name == "recv" {
        check_call_args($args, SemTNil, TOption($elem), $env, $subs, $ret_ty)
    } else if $name == "close" {
        check_call_args($args, SemTNil, TRes(TUnit, TClosed), $env, $subs, $ret_ty)
    } else {
        match synth_args($args, $env, $subs, $ret_ty) {
            Err($e) { Err($e) }
            Ok(()) { Ok(TUnknown) }
        }
    }
}

# Free-function twin of synth_chan_method_call (§7.2 data-first): `send($ch, $v)` /
# `recv($ch)` / `close($ch)`. Returns Some(ty) only when the first argument is a
# concrete Chan[T]; otherwise None so ordinary sub/prelude resolution continues.
sub synth_chan_free_op($name: Str, $args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Option[SemType], Str] {
    match $args {
        ExprNil { Ok(None) }
        ExprCons($recv_e, $rest) {
            match synth_expr_ctx($recv_e, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($rt) {
                    match $rt {
                        TChan($elem) {
                            match synth_chan_method_call($name, $elem, $rest, $env, $subs, $ret_ty) {
                                Err($e) { Err($e) }
                                Ok($ty) { Ok(Some($ty)) }
                            }
                        }
                        _ { Ok(None) }
                    }
                }
            }
        }
    }
}

# `Some(x)` : Option[typeof x]. The oracle's `Some` is `sub[T](T): Option[T]`, so
# the payload type flows into the result and the (open) param never arg-errors.
sub synth_some_call($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $args {
        ExprNil { Err(tc_err("expected 1 arguments, got 0")) }
        ExprCons($a, $rest) {
            match $rest {
                ExprNil {
                    match synth_expr_ctx($a, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok($at) { Ok(TOption($at)) }
                    }
                }
                _ {
                    # Surface nested errors first, then report the arity mismatch.
                    match synth_args($args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) { Err(tc_err("expected 1 arguments, got " ~ "{ exprlist_len($args) }")) }
                    }
                }
            }
        }
    }
}

sub synth_ok_call($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $args {
        ExprNil { Err(tc_err("expected 1 arguments, got 0")) }
        ExprCons($a, $rest) {
            match $rest {
                ExprNil {
                    match synth_expr_ctx($a, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok($at) {
                            match $ret_ty {
                                TRes($rok, $rerr) { Ok(TRes($at, $rerr)) }
                                _ { Ok(TRes($at, TParam("E"))) }
                            }
                        }
                    }
                }
                _ {
                    match synth_args($args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) { Err(tc_err("expected 1 arguments, got " ~ "{ exprlist_len($args) }")) }
                    }
                }
            }
        }
    }
}

sub synth_err_call($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $args {
        ExprNil { Err(tc_err("expected 1 arguments, got 0")) }
        ExprCons($a, $rest) {
            match $rest {
                ExprNil {
                    match synth_expr_ctx($a, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok($at) {
                            match $ret_ty {
                                TRes($rok, $rerr) { Ok(TRes($rok, $at)) }
                                _ { Ok(TRes(TParam("T"), $at)) }
                            }
                        }
                    }
                }
                _ {
                    match synth_args($args, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) { Err(tc_err("expected 1 arguments, got " ~ "{ exprlist_len($args) }")) }
                    }
                }
            }
        }
    }
}

# User-sub call: arity then per-argument compatibility. The argument rule mirrors
# the oracle's `checkCallArgs` guard exactly — error only when the arg type does
# not directionally equal the param type AND is not assignable-modulo-unknown AND
# neither side is top-level Unknown AND the arg is not Never. An unannotated
# (TUnknown) param therefore never arg-checks, so `id("s")` over `sub id($x)` is
# accepted. A generic collection param seeds as e.g. `List[<?>]` (a type-param
# element -> TUnknown), which the top-level Unknown short-circuit misses; the
# `sem_assignable` escape hatch accepts `List[Int]` against it (native instead
# INSTANTIATES the sub, binding the element — the same acceptance) while still
# rejecting a concrete element mismatch like `List[Int]` vs `List[Str]`. This
# only affects generic subs: a non-generic param never carries a nested unknown.
# Result is the sub's return type.
# Per-call-site type-param bindings (§3.3, P5b-2b(e)): the guji mirror of the
# Go oracle's `bindings map[string]Type` in checkCallArgs. Lookup finds the
# NEWEST cons first, so prepending a rebinding shadows the old one exactly like
# the oracle's map overwrite.
pub enum TPBinds {
    TPBNil
    TPBCons($name: Str, $ty: SemType, $tail: TPBinds)
}

sub tpb_lookup($b: TPBinds, $n: Str): Option[SemType] {
    match $b {
        TPBNil { None }
        TPBCons($name, $ty, $tail) { if $name == $n { Some($ty) } else { tpb_lookup($tail, $n) } }
    }
}

# Faithful port of the oracle's bindTypeParams: unify a declared signature type
# (which may contain TParam) with a concrete argument type, recording each type
# parameter's assignment. Open (Unknown/TParam) actuals never bind. TEnum and
# TClass are nominal, so they carry no recursion (same as the oracle, which has
# no case for them).
sub sem_bind_tparams($pattern: SemType, $actual: SemType, $binds: TPBinds): TPBinds {
    match $pattern {
        TParam($n) {
            if sem_open($actual) { $binds } else { TPBCons($n, $actual, $binds) }
        }
        TList($pe) {
            match $actual {
                TList($ae) { sem_bind_tparams($pe, $ae, $binds) }
                _ { $binds }
            }
        }
        TMap($pk, $pv) {
            match $actual {
                TMap($ak, $av) { sem_bind_tparams($pv, $av, sem_bind_tparams($pk, $ak, $binds)) }
                _ { $binds }
            }
        }
        TOption($pe) {
            match $actual {
                TOption($ae) { sem_bind_tparams($pe, $ae, $binds) }
                _ { $binds }
            }
        }
        TRes($po, $pe) {
            match $actual {
                TRes($ao, $ae) { sem_bind_tparams($pe, $ae, sem_bind_tparams($po, $ao, $binds)) }
                _ { $binds }
            }
        }
        TChan($pe) {
            match $actual {
                TChan($ae) { sem_bind_tparams($pe, $ae, $binds) }
                _ { $binds }
            }
        }
        TFn($pp, $pr) {
            match $actual {
                TFn($ap, $ar) { sem_bind_tparams($pr, $ar, sem_bind_tparams_list($pp, $ap, $binds)) }
                _ { $binds }
            }
        }
        _ { $binds }
    }
}

sub sem_bind_tparams_list($patterns: SemTypeList, $actuals: SemTypeList, $binds: TPBinds): TPBinds {
    match $patterns {
        SemTNil { $binds }
        SemTCons($ph, $pt) {
            match $actuals {
                SemTNil { $binds }
                SemTCons($ah, $at) { sem_bind_tparams_list($pt, $at, sem_bind_tparams($ph, $ah, $binds)) }
            }
        }
    }
}

# Faithful port of the oracle's substituteTypeParams: replace every bound type
# parameter with its binding; unbound ones stay TParam (that is what makes the
# `binding $x has type T, expected Str` rejection possible).
sub sem_subst_tparams($ty: SemType, $binds: TPBinds): SemType {
    match $ty {
        TParam($n) {
            match tpb_lookup($binds, $n) {
                Some($bound) { $bound }
                None { $ty }
            }
        }
        TList($e) { TList(sem_subst_tparams($e, $binds)) }
        TMap($k, $v) { TMap(sem_subst_tparams($k, $binds), sem_subst_tparams($v, $binds)) }
        TOption($e) { TOption(sem_subst_tparams($e, $binds)) }
        TRes($ok, $err) { TRes(sem_subst_tparams($ok, $binds), sem_subst_tparams($err, $binds)) }
        TChan($e) { TChan(sem_subst_tparams($e, $binds)) }
        TFn($ps, $r) { TFn(sem_subst_tparams_list($ps, $binds), sem_subst_tparams($r, $binds)) }
        _ { $ty }
    }
}

sub sem_subst_tparams_list($ts: SemTypeList, $binds: TPBinds): SemTypeList {
    match $ts {
        SemTNil { SemTNil }
        SemTCons($h, $t) { SemTCons(sem_subst_tparams($h, $binds), sem_subst_tparams_list($t, $binds)) }
    }
}

sub sem_call_assignable($actual: SemType, $expected: SemType): Bool {
    match $actual {
        TRes($ao, $ae) {
            match $expected {
                # Call arguments do not receive the callee parameter as constructor
                # context in the oracle: `Ok(5)` remains Result[Int, E] and cannot
                # satisfy Result[Int, Str]. Other expression contexts still use
                # sem_assignable so an if branch `Err("x")` can unify with a
                # sibling Result[Box, Str] branch.
                TRes($eo, $ee) { sem_bind_eq($ao, $eo) && sem_bind_eq($ae, $ee) }
                _ { sem_assignable($actual, $expected) }
            }
        }
        _ { sem_assignable($actual, $expected) }
    }
}

sub check_call_args($args: ExprList, $params: SemTypeList, $ret: SemType, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    $na = exprlist_len($args)
    $np = semlist_len($params)
    if $na != $np {
        Err(tc_err("expected { $np } arguments, got { $na }"))
    } else {
        match check_args_vs_params($args, $params, 1, $env, $subs, $ret_ty, TPBNil) {
            Err($e) { Err($e) }
            Ok($binds) { Ok(sem_subst_tparams($ret, $binds)) }
        }
    }
}

sub check_args_vs_params($args: ExprList, $params: SemTypeList, $i: Int, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType, $binds: TPBinds): Result[TPBinds, Str] {
    match $args {
        ExprNil { Ok($binds) }
        ExprCons($a, $arest) {
            match $params {
                SemTNil { Ok($binds) }
                SemTCons($p0, $prest) {
                    # Already-bound generic params refine the expected argument
                    # type before contextual synthesis (e.g. Chan[T]).
                    $p1 = sem_subst_tparams($p0, $binds)
                    match synth_expr_expected($a, $p1, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok($at) {
                            # Mirror the oracle's checkCallArgs instantiation
                            # order: substitute already-bound params, bind this
                            # argument's type params, substitute again, THEN
                            # check compatibility. Non-generic params carry no
                            # TParam, so both substitutions are identity there.
                            $binds2 = sem_bind_tparams($p1, $at, $binds)
                            $p = sem_subst_tparams($p1, $binds2)
                            if !sem_eq($at, $p) && !sem_call_assignable($at, $p) && !is_unknown($at) && !is_unknown($p) && !is_never($at) {
                                Err(tc_err("argument { $i } has type " ~ sem_to_str($at) ~ ", expected " ~ sem_to_str($p)))
                            } else {
                                check_args_vs_params($arest, $prest, $i + 1, $env, $subs, $ret_ty, $binds2)
                            }
                        }
                    }
                }
            }
        }
    }
}

sub synth_panic_call($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    check_call_args($args, SemTCons(TStr, SemTNil), TNever, $env, $subs, $ret_ty)
}

# §15.4 exit($code: Int): Never — same bottom type as panic so value-position
# exit unifies with every branch result without constraining it.
sub synth_exit_call($args: ExprList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    check_call_args($args, SemTCons(TInt, SemTNil), TNever, $env, $subs, $ret_ty)
}

# ---- T2 statements, bindings, blocks, return, and if -----------------------

pub class TCheckResult {
    has $.ty: SemType
    has $.env: TEnv
}

sub tcheck_result($ty: SemType, $env: TEnv): TCheckResult {
    TCheckResult(ty: $ty, env: $env)
}

sub check_bind_type($name: Str, $actual: SemType, $expected: SemType): Result[Unit, Str] {
    # Mirrors the oracle's BindingStmt check: initTy.Equal(annTy) with only
    # Unknown/Never ACTUALS exempted — a TypeParam equals only the same-named
    # TypeParam, at ANY depth, so `$x: Str = conv(1)` over
    # `sub conv[T]($v: Int): T` is `binding $x has type T, expected Str` and
    # `$o: Option[Int] = none_of()` over `sub none_of[T](): Option[T]` is
    # `binding $o has type Option[T], expected Option[Int]`. TUnknown stays
    # permissive on either side (see sem_bind_eq) — selfhost resolves
    # annotations the oracle models (Result[..], Chan[..], ...) to TUnknown,
    # and rejecting those would false-reject valid programs the oracle accepts.
    if is_never($actual) || sem_bind_eq($actual, $expected) {
        Ok(())
    } else {
        Err(tc_err("binding " ~ $name ~ " has type " ~ sem_to_str($actual) ~ ", expected " ~ sem_to_str($expected)))
    }
}

sub check_return_type($actual: SemType, $expected: SemType): Result[Unit, Str] {
    if is_unknown($expected) || sem_assignable($actual, $expected) {
        Ok(())
    } else {
        Err(tc_err("return yields " ~ sem_to_str($actual) ~ ", expected " ~ sem_to_str($expected)))
    }
}

sub check_body_return_type($name: Str, $actual: SemType, $expected: SemType): Result[Unit, Str] {
    if sem_assignable($actual, $expected) {
        Ok(())
    } else {
        Err(tc_err("sub " ~ $name ~ " body returns " ~ sem_to_str($actual) ~ ", expected " ~ sem_to_str($expected)))
    }
}

# Bind `$name` after a `$name = value` / `mut $name = value` statement, applying
# the §4 mut semantics and the §7.4 capture rule (P1b):
#   - `mut $x = ...`      -> a `mut` binding in the current frame;
#   - `$x = ...` where $x resolves to a visible `mut` binding -> stays `mut` (a
#     non-`mut` assignment writes the nearest mut, §4); if that write crosses a
#     closure boundary it is the illegal "assign to captured mut" error (§7.4);
#   - `$x = ...` where an immutable `$x` already exists in THIS frame is a
#     compile-time reassignment error; an enclosing immutable may be shadowed.
sub bind_result($mut: Bool, $name: Str, $final_ty: SemType, $env: TEnv): Result[TCheckResult, Str] {
    if $mut {
        Ok(tcheck_result(TUnit, tenv_define_mut($env, $name, $final_ty)))
    } else {
        match tenv_current_resolve($env, $name) {
            Some($r) {
                if $r.mutable {
                    Ok(tcheck_result(TUnit, tenv_define_mut($env, $name, $final_ty)))
                } else {
                    Err(tc_err("cannot reassign immutable binding " ~ $name))
                }
            }
            None {
                match tenv_resolve($env, $name) {
                    Some($r) {
                        if $r.mutable {
                            if $r.captured {
                                Err(tc_err("cannot assign to captured mut binding " ~ $name ~ " inside a closure; bind it immutably first (§7.4)"))
                            } else {
                                Ok(tcheck_result(TUnit, tenv_define_mut($env, $name, $final_ty)))
                            }
                        } else {
                            Ok(tcheck_result(TUnit, tenv_define($env, $name, $final_ty)))
                        }
                    }
                    None { Ok(tcheck_result(TUnit, tenv_define($env, $name, $final_ty))) }
                }
            }
        }
    }
}

# §2.4 gives List and Map bindings invariant shape sigils. Unknown and generic
# types remain permissive until instantiation supplies a concrete shape.
sub check_binding_sigil($name: Str, $ty: SemType): Result[Unit, Str] {
    $sigil = first_char($name)
    match $ty {
        TUnknown { Ok(()) }
        TNever { Ok(()) }
        TParam($n) { Ok(()) }
        TList($elem) {
            if $sigil == "@" {
                Ok(())
            } else {
                Err(tc_err("binding " ~ $name ~ " has " ~ sem_to_str($ty) ~ " type, which requires @ sigil"))
            }
        }
        TMap($key, $value) {
            if $sigil == "%" {
                Ok(())
            } else {
                Err(tc_err("binding " ~ $name ~ " has " ~ sem_to_str($ty) ~ " type, which requires % sigil"))
            }
        }
        TFn($params, $ret) {
            # The parser represents a named local sub as an immutable function
            # binding whose internal name is intentionally bare.
            if $sigil == "$" || is_ident_start($sigil) {
                Ok(())
            } else {
                Err(tc_err("binding " ~ $name ~ " has " ~ sem_to_str($ty) ~ " type, which requires $ sigil"))
            }
        }
        _ {
            if $sigil == "$" {
                Ok(())
            } else {
                Err(tc_err("binding " ~ $name ~ " has " ~ sem_to_str($ty) ~ " type, which requires $ sigil"))
            }
        }
    }
}

sub check_stmt_t2($s: Stmt, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[TCheckResult, Str] {
    match $s {
        SExpr($e) {
            match synth_expr_ctx($e, $env, $subs, $ret_ty) {
                Err($err) { Err($err) }
                Ok($ty) { Ok(tcheck_result($ty, $env)) }
            }
        }
        SBind($mut, $name, $ty, $value) {
            $bound = sem_from_opt_type_with($ty, $subs)
            match synth_expr_expected($value, $bound, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($actual) {
                    $final_ty = if is_unknown($bound) { $actual } else { $bound }
                    match check_binding_sigil($name, $final_ty) {
                        Err($err) { Err($err) }
                        Ok(()) {
                            match check_bind_type($name, $actual, $final_ty) {
                                Err($err) { Err($err) }
                                Ok(()) { bind_result($mut, $name, $final_ty, $env) }
                            }
                        }
                    }
                }
            }
        }
        SReturn($opt) {
            match $opt {
                None {
                    match check_return_type(TUnit, $ret_ty) {
                        Err($err) { Err($err) }
                        Ok(()) { Ok(tcheck_result(TNever, $env)) }
                    }
                }
                Some($e) {
                    match synth_expr_expected($e, $ret_ty, $env, $subs, $ret_ty) {
                        Err($e2) { Err($e2) }
                        Ok($t) {
                            match check_return_type($t, $ret_ty) {
                                Err($err) { Err($err) }
                                Ok(()) { Ok(tcheck_result(TNever, $env)) }
                            }
                        }
                    }
                }
            }
        }
        SWhile($cond, $body) {
            # §6.3: the condition must be Bool (or Never); the body is checked in a
            # fresh child scope and the loop itself yields Unit. Faithful port of the
            # oracle's `*ast.WhileStmt` case (check.go) so accept/reject matches.
            match synth_expr_ctx($cond, $env, $subs, $ret_ty) {
                Err($err) { Err($err) }
                Ok($cond_ty) {
                    if !sem_eq($cond_ty, TBool) && !is_never($cond_ty) {
                        Err(tc_err("while condition must be Bool, got " ~ sem_to_str($cond_ty)))
                    } else {
                        match check_block_t2($body, tenv_child($env), $subs, $ret_ty, TUnit) {
                            Err($err) { Err($err) }
                            Ok($r) { Ok(tcheck_result(TUnit, $env)) }
                        }
                    }
                }
            }
        }
        SFor($vars, $iter, $body) {
            # §6.3 / §17.4: infer the iterand, bind the loop variable(s) in a fresh
            # child scope (lists → one var of the element type; maps → key then value;
            # channels → one var of the element type), and check the body; the loop
            # yields Unit. A concrete TRange binds one Int variable; other concrete
            # non-iterable shapes reject. Never/Unknown remain accepted without a
            # concrete element type to avoid cascading an earlier inference error.
            match synth_expr_ctx($iter, $env, $subs, $ret_ty) {
                Err($err) { Err($err) }
                Ok($iter_ty) {
                    match for_bind_vars($vars, $iter_ty, tenv_child($env)) {
                        Err($err) { Err($err) }
                        Ok($body_env) {
                            match check_block_t2($body, $body_env, $subs, $ret_ty, TUnit) {
                                Err($err) { Err($err) }
                                Ok($r) { Ok(tcheck_result(TUnit, $env)) }
                            }
                        }
                    }
                }
            }
        }
        SHatch($body) {
            # §17.1: a task body is a function/closure boundary. Reuse the
            # established lambda capture checker so immutable captures pass and
            # reads/writes of captured `mut` bindings reject with oracle wording.
            match check_block_t2($body, tenv_func_child($env), $subs, $ret_ty, TUnit) {
                Err($err) { Err($err) }
                Ok($r) { Ok(tcheck_result(TUnit, $env)) }
            }
        }
        SSelect($arms, $els) {
            match $arms {
                SelectArmNil {
                    match $els {
                        None { Err(tc_err("select requires at least one arm")) }
                        Some($body) {
                            match check_block_t2($body, tenv_child($env), $subs, $ret_ty, TUnit) {
                                Err($e) { Err($e) }
                                Ok($r) { Ok(tcheck_result(TUnit, $env)) }
                            }
                        }
                    }
                }
                _ {
                    match check_select_arms($arms, $env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) {
                            match $els {
                                None { Ok(tcheck_result(TUnit, $env)) }
                                Some($body) {
                                    match check_block_t2($body, tenv_child($env), $subs, $ret_ty, TUnit) {
                                        Err($e) { Err($e) }
                                        Ok($r) { Ok(tcheck_result(TUnit, $env)) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub exprlist_has_named($args: ExprList): Bool {
    match $args {
        ExprNil { false }
        ExprCons(ENamedArg($n, $v), $rest) { true }
        ExprCons($a, $rest) { exprlist_has_named($rest) }
    }
}

# A select operation is intentionally narrower than an ordinary §17.3 call:
# only method-style recv/send participate, and the operation result is the arm
# binding type. This mirrors checkSelectArmOp in the Go oracle.
sub check_select_op($op: Expr, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $op {
        ECall(EField($recv, $name), $args) {
            if exprlist_has_named($args) {
                Err(tc_err("select arm channel operation cannot use named arguments"))
            } else {
                match synth_expr_ctx($recv, $env, $subs, $ret_ty) {
                    Err($e) { Err($e) }
                    Ok($rt) {
                        match $rt {
                            TChan($elem) {
                                if $name == "recv" {
                                    if exprlist_len($args) == 0 {
                                        Ok(TOption($elem))
                                    } else {
                                        Err(tc_err("select recv arm expects 0 arguments, got { exprlist_len($args) }"))
                                    }
                                } else if $name == "send" {
                                    if exprlist_len($args) != 1 {
                                        Err(tc_err("select send arm expects 1 argument, got { exprlist_len($args) }"))
                                    } else {
                                        match $args {
                                            ExprCons($arg, ExprNil) {
                                                match synth_expr_expected($arg, $elem, $env, $subs, $ret_ty) {
                                                    Err($e) { Err($e) }
                                                    Ok($at) {
                                                        if sem_assignable($at, $elem) || is_never($at) {
                                                            Ok(TRes(TUnit, TClosed))
                                                        } else {
                                                            Err(tc_err("send argument has type " ~ sem_to_str($at) ~ ", expected " ~ sem_to_str($elem)))
                                                        }
                                                    }
                                                }
                                            }
                                            _ { Err(tc_err("select send arm expects 1 argument, got { exprlist_len($args) }")) }
                                        }
                                    }
                                } else {
                                    Err(tc_err("select arm must be a channel recv or send operation, got " ~ $name))
                                }
                            }
                            TUnknown { Ok(TUnknown) }
                            TNever { Ok(TUnknown) }
                            _ { Err(tc_err("select arm receiver must be Chan, got " ~ sem_to_str($rt))) }
                        }
                    }
                }
            }
        }
        _ { Err(tc_err("select arm must be a channel recv or send operation")) }
    }
}

sub check_select_arms($arms: SelectArmList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $arms {
        SelectArmNil { Ok(()) }
        SelectArmCons($arm, $rest) {
            match check_select_op($arm.op, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($op_ty) {
                    $body_env = select_body_env($arm.bind, $op_ty, $env)
                    match check_block_t2($arm.body, $body_env, $subs, $ret_ty, TUnit) {
                        Err($e) { Err($e) }
                        Ok($r) { check_select_arms($rest, $env, $subs, $ret_ty) }
                    }
                }
            }
        }
    }
}

sub select_body_env($bind: Option[Str], $op_ty: SemType, $env: TEnv): TEnv {
    match $bind {
        None { tenv_child($env) }
        Some($name) { tenv_define(tenv_child($env), $name, $op_ty) }
    }
}

# Bind the `for` loop variable(s) into the body scope by the iterand's type. Lists
# bind one variable to the element type; maps bind two (key, value); ranges bind
# one Int; channels bind one variable to the element type (§17.4); Never/Unknown
# iterands accept without
# binding a concrete type; any other concrete type cannot be iterated. Error
# wording mirrors the Go checker's `*ast.ForStmt` diagnostics.
sub for_bind_vars($vars: StrList, $iter_ty: SemType, $body_env: TEnv): Result[TEnv, Str] {
    match $iter_ty {
        TList($elem) {
            match $vars {
                StrCons($v, StrNil) { Ok(tenv_define($body_env, $v, $elem)) }
                _ { Err(tc_err("for over list requires one variable")) }
            }
        }
        TMap($k, $vt) {
            match $vars {
                StrCons($kv, StrCons($vv, StrNil)) { Ok(tenv_define(tenv_define($body_env, $kv, $k), $vv, $vt)) }
                _ { Err(tc_err("for over map requires two variables")) }
            }
        }
        TRange {
            match $vars {
                StrCons($v, StrNil) { Ok(tenv_define($body_env, $v, TInt)) }
                _ { Err(tc_err("for over range requires one variable")) }
            }
        }
        TChan($elem) {
            match $vars {
                StrCons($v, StrNil) { Ok(tenv_define($body_env, $v, $elem)) }
                _ { Err(tc_err("for over channel requires one variable")) }
            }
        }
        TNever { Ok(for_bind_vars_unknown($vars, $body_env)) }
        TUnknown { Ok(for_bind_vars_unknown($vars, $body_env)) }
        _ { Err(tc_err("cannot iterate over type " ~ sem_to_str($iter_ty))) }
    }
}

# When the iterand type is Never/Unknown, bind each loop variable to Unknown so the
# body does not spuriously reject on an unresolved element type.
sub for_bind_vars_unknown($vars: StrList, $body_env: TEnv): TEnv {
    match $vars {
        StrNil { $body_env }
        StrCons($v, $rest) { for_bind_vars_unknown($rest, tenv_define($body_env, $v, TUnknown)) }
    }
}

sub check_block_t2($ss: StmtList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType, $last: SemType): Result[TCheckResult, Str] {
    match $ss {
        StmtNil { Ok(tcheck_result($last, $env)) }
        StmtCons($s, $rest) {
            match check_stmt_t2($s, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($r) { check_block_t2($rest, $r.env, $subs, $ret_ty, $r.ty) }
            }
        }
    }
}

# Function/lambda body twin of the Go checker's checkBlockWithExpected: only a
# final expression receives the declared return type as context. Earlier
# statements check normally, and explicit return has its own expected path.
sub check_block_expected_t2($ss: StmtList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType, $last: SemType): Result[TCheckResult, Str] {
    match $ss {
        StmtNil { Ok(tcheck_result($last, $env)) }
        StmtCons($s, StmtNil) {
            match $s {
                SExpr($e) {
                    match synth_expr_expected($e, $ret_ty, $env, $subs, $ret_ty) {
                        Err($err) { Err($err) }
                        Ok($ty) { Ok(tcheck_result($ty, $env)) }
                    }
                }
                _ { check_stmt_t2($s, $env, $subs, $ret_ty) }
            }
        }
        StmtCons($s, $rest) {
            match check_stmt_t2($s, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($r) { check_block_expected_t2($rest, $r.env, $subs, $ret_ty, $r.ty) }
            }
        }
    }
}

sub check_body_t2($b: Body, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[TCheckResult, Str] {
    match $b {
        ExprBody($e) {
            match synth_expr_expected($e, $ret_ty, $env, $subs, $ret_ty) {
                Err($err) { Err($err) }
                Ok($ty) { Ok(tcheck_result($ty, $env)) }
            }
        }
        BlockBody($stmts) { check_block_expected_t2($stmts, $env, $subs, $ret_ty, TUnit) }
    }
}

sub if_result_type($then_ty: SemType, $else_ty: SemType): Result[SemType, Str] {
    if !sem_assignable($then_ty, $else_ty) && !sem_assignable($else_ty, $then_ty) && !is_never($then_ty) && !is_never($else_ty) {
        Err(tc_err("if branches have incompatible types: " ~ sem_to_str($then_ty) ~ " and " ~ sem_to_str($else_ty)))
    } else if is_never($then_ty) || sem_open($then_ty) {
        Ok($else_ty)
    } else {
        Ok($then_ty)
    }
}

sub synth_if_tail($elifs: ElifList, $els: Option[StmtList], $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Ok(TUnit) }
                Some($body) {
                    match check_block_t2($body, tenv_child($env), $subs, $ret_ty, TUnit) {
                        Err($err) { Err($err) }
                        Ok($r) { Ok($r.ty) }
                    }
                }
            }
        }
        ElifCons($head, $rest) {
            synth_if($head.cond, $head.body, $rest, $els, tenv_child($env), $subs, $ret_ty)
        }
    }
}

sub synth_if($cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($cond, $env, $subs, $ret_ty) {
        Err($err) { Err($err) }
        Ok($cond_ty) {
            if !sem_eq($cond_ty, TBool) {
                Err(tc_err("if condition must be Bool, got " ~ sem_to_str($cond_ty)))
            } else {
                match check_block_t2($then, tenv_child($env), $subs, $ret_ty, TUnit) {
                    Err($err) { Err($err) }
                    Ok($then_r) {
                        match synth_if_tail($elifs, $els, $env, $subs, $ret_ty) {
                            Err($err) { Err($err) }
                            Ok($else_ty) { if_result_type($then_r.ty, $else_ty) }
                        }
                    }
                }
            }
        }
    }
}

# ---- T3b: match expressions, patterns, and exhaustiveness -----------------

pub class MatchTypeState {
    has $.found: Bool
    has $.ty: SemType
}

sub match_type_state($found: Bool, $ty: SemType): MatchTypeState {
    MatchTypeState(found: $found, ty: $ty)
}

sub pattern_list_len($ps: PatternList): Int {
    match $ps {
        PatNil { 0 }
        PatCons($h, $rest) { 1 + pattern_list_len($rest) }
    }
}

sub pattern_literal_type($e: Expr): SemType {
    match $e {
        EInt($t) { TInt }
        EFloat($t) { TFloat }
        EStr($t) { TStr }
        ERawStr($t) { TStr }
        EBool($t) { TBool }
        EUnit { TUnit }
        _ { TUnknown }
    }
}

# A Str pattern is a static literal, not an expression evaluated when an arm is
# tested. The lexer retains escaped marker prefixes, so skip those while looking
# for either form of §12 interpolation.
sub pattern_string_has_interpolation_at(@chars: List[Str], $i: Int, $n: Int): Bool {
    if $i >= $n {
        false
    } else {
        $c = at(@chars, $i)
        $next = at(@chars, $i + 1)
        if $c == "\\" && ($next == '{' || $next == '}' || $next == '$' || $next == '@' || $next == '%') {
            pattern_string_has_interpolation_at(@chars, $i + 2, $n)
        } else if $c == '{' {
            true
        } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start($next) {
            true
        } else {
            pattern_string_has_interpolation_at(@chars, $i + 1, $n)
        }
    }
}

sub pattern_string_has_interpolation($text: Str): Bool {
    @chars: List[Str] = split($text, "")
    pattern_string_has_interpolation_at(@chars, 0, @chars.count())
}

# Produce the runtime value of a static double-quoted pattern. The lexer keeps
# escaped interpolation starters marked with a backslash; ordinary string
# evaluation removes that marker, so native pattern lowering must do the same.
sub pattern_static_string_text_at(@chars: List[Str], $i: Int, $n: Int, $acc: Str): Str {
    if $i >= $n {
        $acc
    } else {
        $c = at(@chars, $i)
        $next = at(@chars, $i + 1)
        if $c == "\\" && ($next == '{' || $next == '$' || $next == '@' || $next == '%') {
            pattern_static_string_text_at(@chars, $i + 2, $n, $acc ~ $next)
        } else {
            pattern_static_string_text_at(@chars, $i + 1, $n, $acc ~ $c)
        }
    }
}

sub pattern_static_string_text($text: Str): Str {
    @chars: List[Str] = split($text, "")
    pattern_static_string_text_at(@chars, 0, @chars.count(), "")
}

sub check_pattern_type($pat: Pattern, $subject: SemType, $env: TEnv, $subs: SemSubTable): Result[TEnv, Str] {
    match $pat {
        PWild { Ok($env) }
        PBind($name) { Ok(tenv_define($env, $name, $subject)) }
        PLit($lit) {
            $lit_ty = pattern_literal_type($lit)
            $dynamic_str = match $lit {
                EStr($text) { pattern_string_has_interpolation($text) }
                _ { false }
            }
            if $dynamic_str {
                Err(tc_err("interpolated Str is not permitted in a pattern; pattern literals are static (§10.1)"))
            } else if !sem_eq($lit_ty, $subject) && !is_unknown($lit_ty) && !is_unknown($subject) && !is_never($subject) {
                Err(tc_err("pattern has type " ~ sem_to_str($lit_ty) ~ ", expected " ~ sem_to_str($subject)))
            } else {
                Ok($env)
            }
        }
        PVariant($name, $args) { check_variant_pattern($name, $args, $subject, $env, $subs) }
    }
}

sub check_variant_pattern($name: Str, $args: PatternList, $subject: SemType, $env: TEnv, $subs: SemSubTable): Result[TEnv, Str] {
    $subject1 = sem_deepen_enum($subject, $subs)
    match $subject1 {
        TEnum($enum_name, $variants) {
            match sem_variant_lookup($variants, $name) {
                None { Err(tc_err($enum_name ~ " has no variant " ~ $name)) }
                Some($variant) {
                    $n = pattern_list_len($args)
                    $want = semlist_len($variant.fields)
                    if $n != $want {
                        Err(tc_err("variant " ~ $name ~ " expects { $want } field(s), got { $n }"))
                    } else {
                        check_variant_field_patterns($args, $variant.fields, $env, $subs)
                    }
                }
            }
        }
        TOption($elem) {
            if $name == "Some" {
                $n = pattern_list_len($args)
                if $n != 1 {
                    Err(tc_err("variant Some expects 1 field, got { $n }"))
                } else {
                    match $args {
                        PatCons($p, PatNil) { check_pattern_type($p, $elem, $env, $subs) }
                        _ { Err(tc_err("variant Some expects 1 field, got { $n }")) }
                    }
                }
            } else if $name == "None" {
                $n = pattern_list_len($args)
                if $n != 0 {
                    Err(tc_err("variant None expects 0 fields, got { $n }"))
                } else {
                    Ok($env)
                }
            } else {
                Err(tc_err("Option has no variant " ~ $name))
            }
        }
        TRes($ok, $err) {
            if $name == "Ok" {
                $n = pattern_list_len($args)
                if $n != 1 {
                    Err(tc_err("variant Ok expects 1 field, got { $n }"))
                } else {
                    match $args {
                        PatCons($p, PatNil) { check_pattern_type($p, $ok, $env, $subs) }
                        _ { Err(tc_err("variant Ok expects 1 field, got { $n }")) }
                    }
                }
            } else if $name == "Err" {
                $n = pattern_list_len($args)
                if $n != 1 {
                    Err(tc_err("variant Err expects 1 field, got { $n }"))
                } else {
                    match $args {
                        PatCons($p, PatNil) { check_pattern_type($p, $err, $env, $subs) }
                        _ { Err(tc_err("variant Err expects 1 field, got { $n }")) }
                    }
                }
            } else {
                Err(tc_err("Result has no variant " ~ $name))
            }
        }
        TClosed {
            if $name != "Closed" {
                Err(tc_err("Closed has no variant " ~ $name))
            } else {
                $n = pattern_list_len($args)
                if $n == 0 {
                    Ok($env)
                } else {
                    Err(tc_err("Closed expects 0 fields, got { $n }"))
                }
            }
        }
        TNever { Ok($env) }
        TUnknown { check_unknown_variant_fields($args, $env, $subs) }
        _ { Err(tc_err("cannot match variant pattern against type " ~ sem_to_str($subject1))) }
    }
}

sub sem_variant_lookup($vs: SemVariantList, $name: Str): Option[SemVariant] {
    match $vs {
        SemVariantNil { None }
        SemVariantCons($v, $rest) {
            if $v.name == $name { Some($v) } else { sem_variant_lookup($rest, $name) }
        }
    }
}

sub check_variant_field_patterns($args: PatternList, $fields: SemTypeList, $env: TEnv, $subs: SemSubTable): Result[TEnv, Str] {
    match $args {
        PatNil { Ok($env) }
        PatCons($p, $prest) {
            match $fields {
                SemTNil { Ok($env) }
                SemTCons($ft, $frest) {
                    match check_pattern_type($p, $ft, $env, $subs) {
                        Err($e) { Err($e) }
                        Ok($env2) { check_variant_field_patterns($prest, $frest, $env2, $subs) }
                    }
                }
            }
        }
    }
}

# An unmodeled scrutinee type (Result, generic enum, class, ...) is TUnknown — the typechecker
# does not have the type-variable machinery to track its variants, so it stays
# PERMISSIVE here (the same stance sem_eq/synth_call take for TUnknown): accept any
# variant constructor and bind each field pattern to TUnknown so the arm body
# type-checks permissively. Nested pattern errors are still surfaced.
sub check_unknown_variant_fields($args: PatternList, $env: TEnv, $subs: SemSubTable): Result[TEnv, Str] {
    match $args {
        PatNil { Ok($env) }
        PatCons($p, $rest) {
            match check_pattern_type($p, TUnknown, $env, $subs) {
                Err($e) { Err($e) }
                Ok($env2) { check_unknown_variant_fields($rest, $env2, $subs) }
            }
        }
    }
}

sub check_match_guard($guard: Option[Expr], $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[Unit, Str] {
    match $guard {
        None { Ok(()) }
        Some($g) {
            match synth_expr_ctx($g, $env, $subs, $ret_ty) {
                Err($e) { Err($e) }
                Ok($gt) {
                    if !sem_eq($gt, TBool) && !is_unknown($gt) {
                        Err(tc_err("guard must be Bool, got " ~ sem_to_str($gt)))
                    } else {
                        Ok(())
                    }
                }
            }
        }
    }
}

sub merge_match_arm_type($state: MatchTypeState, $arm_ty: SemType): Result[MatchTypeState, Str] {
    if is_never($arm_ty) {
        Ok($state)
    } else if !$state.found {
        Ok(match_type_state(true, $arm_ty))
    } else if !sem_assignable($arm_ty, $state.ty) {
        Err(tc_err("match arm returns " ~ sem_to_str($arm_ty) ~ ", expected " ~ sem_to_str($state.ty)))
    } else if sem_open($state.ty) && !sem_open($arm_ty) {
        Ok(match_type_state(true, $arm_ty))
    } else {
        Ok($state)
    }
}

sub check_match_arms($arms: ArmList, $subject_ty: SemType, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType, $state: MatchTypeState): Result[MatchTypeState, Str] {
    match $arms {
        ArmNil { Ok($state) }
        ArmCons($arm, $rest) {
            $arm_env = tenv_child($env)
            match check_pattern_type($arm.pat, $subject_ty, $arm_env, $subs) {
                Err($e) { Err($e) }
                Ok($pat_env) {
                    match check_match_guard($arm.guard, $pat_env, $subs, $ret_ty) {
                        Err($e) { Err($e) }
                        Ok(()) {
                            match check_block_t2($arm.body, $pat_env, $subs, $ret_ty, TUnit) {
                                Err($e) { Err($e) }
                                Ok($body_r) {
                                    match merge_match_arm_type($state, $body_r.ty) {
                                        Err($e) { Err($e) }
                                        Ok($next_state) { check_match_arms($rest, $subject_ty, $env, $subs, $ret_ty, $next_state) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub pattern_is_catchall($pat: Pattern): Bool {
    match $pat {
        PWild { true }
        PBind($name) { true }
        _ { false }
    }
}

sub arms_have_catchall($arms: ArmList): Bool {
    match $arms {
        ArmNil { false }
        ArmCons($arm, $rest) { pattern_is_catchall($arm.pat) || arms_have_catchall($rest) }
    }
}

sub arms_cover_variant($arms: ArmList, $name: Str): Bool {
    match $arms {
        ArmNil { false }
        ArmCons($arm, $rest) {
            match $arm.pat {
                PVariant($n, $args) { if $n == $name { true } else { arms_cover_variant($rest, $name) } }
                _ { arms_cover_variant($rest, $name) }
            }
        }
    }
}

sub missing_enum_variants($variants: SemVariantList, $arms: ArmList): Str {
    match $variants {
        SemVariantNil { "" }
        SemVariantCons($v, $rest) {
            $tail = missing_enum_variants($rest, $arms)
            if arms_cover_variant($arms, $v.name) {
                $tail
            } else if $tail == "" {
                $v.name
            } else {
                $v.name ~ ", " ~ $tail
            }
        }
    }
}

sub match_exhaustive($subject_ty: SemType, $arms: ArmList): Result[Unit, Str] {
    if arms_have_catchall($arms) {
        Ok(())
    } else {
        match $subject_ty {
            TEnum($name, $variants) {
                $missing = missing_enum_variants($variants, $arms)
                if $missing == "" {
                    Ok(())
                } else {
                    Err(tc_err("non-exhaustive match: missing " ~ $missing))
                }
            }
            TOption($elem) {
                $some = arms_cover_variant($arms, "Some")
                $none = arms_cover_variant($arms, "None")
                if !$some && !$none {
                    Err(tc_err("non-exhaustive match: missing Some, None"))
                } else if !$some {
                    Err(tc_err("non-exhaustive match: missing Some"))
                } else if !$none {
                    Err(tc_err("non-exhaustive match: missing None"))
                } else {
                    Ok(())
                }
            }
            TRes($ok, $err) {
                $ok_arm = arms_cover_variant($arms, "Ok")
                $err_arm = arms_cover_variant($arms, "Err")
                if !$ok_arm && !$err_arm {
                    Err(tc_err("non-exhaustive match: missing Ok, Err"))
                } else if !$ok_arm {
                    Err(tc_err("non-exhaustive match: missing Ok"))
                } else if !$err_arm {
                    Err(tc_err("non-exhaustive match: missing Err"))
                } else {
                    Ok(())
                }
            }
            TNever { Ok(()) }
            TUnknown { Ok(()) }
            _ { Err(tc_err("non-exhaustive match: add a wildcard _ arm")) }
        }
    }
}

# A nested enum field's type is recorded SHALLOWLY (TEnum(name, SemVariantNil)) by
# build_sem_enum_symbols, which resolves field annotations against the enum NAMES
# table to break the recursion when an enum's own field references another (or the
# same) enum. When such a value is matched, re-resolve its full variant list from the
# deep symbol table so the variant patterns and exhaustiveness check see the real
# variants. One level is deepened per match, which is exactly what a (recursive)
# enum's nested matches need.
sub sem_deepen_enum($ty: SemType, $subs: SemSubTable): SemType {
    match $ty {
        TEnum($name, $variants) {
            match $variants {
                SemVariantNil {
                    match sem_sub_lookup($subs, $name) {
                        Some($full) { match $full { TEnum($fn, $fv) { $full } _ { $ty } } }
                        None { $ty }
                    }
                }
                _ { $ty }
            }
        }
        _ { $ty }
    }
}

sub synth_match($subject: Expr, $arms: ArmList, $env: TEnv, $subs: SemSubTable, $ret_ty: SemType): Result[SemType, Str] {
    match synth_expr_ctx($subject, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($subject_ty0) {
            $subject_ty = sem_deepen_enum($subject_ty0, $subs)
            match check_match_arms($arms, $subject_ty, $env, $subs, $ret_ty, match_type_state(false, TUnknown)) {
                Err($e) { Err($e) }
                Ok($state) {
                    match match_exhaustive($subject_ty, $arms) {
                        Err($e) { Err($e) }
                        Ok(()) {
                            if $state.found {
                                Ok($state.ty)
                            } else {
                                Ok(TNever)
                            }
                        }
                    }
                }
            }
        }
    }
}

sub method_private_env($fields: ClassFieldList, $env: TEnv, $subs: SemSubTable): TEnv {
    match $fields {
        ClassFieldNil { $env }
        ClassFieldCons($f, $rest) {
            $tail = method_private_env($rest, $env, $subs)
            if $f.public {
                $tail
            } else {
                tenv_define($tail, $f.sigil ~ "!" ~ $f.name, sem_from_opt_type_with($f.ty, $subs))
            }
        }
    }
}

sub class_sub_env($c: ClassDecl, $s: SubDecl, $class_ty: SemType, $subs: SemSubTable): TEnv {
    $base = params_to_tenv($s.params, tenv_child(TENil), $subs)
    if is_method_sub($s) {
        method_private_env($c.fields, tenv_define($base, '$self', $class_ty), $subs)
    } else {
        $base
    }
}

# A generic sub's declared return resolves with its type params (TParam), so
# the body's return positions check against the same TParam types its params
# bind to; non-generic subs keep the exact pre-TParam resolution.
sub sub_ret_sem($s: SubDecl, $subs: SemSubTable): SemType {
    if strlist_empty($s.tparams) {
        sem_from_opt_type_with($s.ret, $subs)
    } else {
        sem_from_opt_type_tps($s.ret, $subs, $s.tparams)
    }
}

sub check_sub_body_t2($s: SubDecl, $env: TEnv, $subs: SemSubTable): Result[Unit, Str] {
    $ret_ty = sub_ret_sem($s, $subs)
    match check_body_t2($s.body, $env, $subs, $ret_ty) {
        Err($e) { Err($e) }
        Ok($r) {
            match $s.ret {
                None { Ok(()) }
                Some($tr) {
                    match check_body_return_type($s.name, $r.ty, $ret_ty) {
                        Err($err) { Err($err) }
                        Ok(()) { Ok(()) }
                    }
                }
            }
        }
    }
}

sub tc_undefined_name($err: Str): Option[Str] {
    $prefix = "type error: undefined binding "
    if starts_with($err, $prefix) {
        Some(drop(split($err, ""), split($prefix, "").count()).join(""))
    } else {
        None
    }
}

sub token_is_after($tok: Token, $line: Int, $col: Int): Bool {
    $tok.line > $line || ($tok.line == $line && $tok.col > $col)
}

sub token_matches_undefined_name($tok: Token, $name: Str): Bool {
    if $tok.lexeme != $name {
        false
    } else if starts_with($name, '$') || starts_with($name, '@') || starts_with($name, '%') {
        is_kind($tok, KSigil)
    } else {
        is_kind($tok, KIdent)
    }
}

sub find_named_token_after($toks: TokenList, $name: Str, $line: Int, $col: Int): Option[Token] {
    mut $cur = $toks
    mut $going = true
    mut $found_line = 0
    mut $found_col = 0
    while $going {
        match $cur {
            TEnd { $going = false }
            TMore($tok, $rest) {
                if token_is_after($tok, $line, $col) && token_matches_undefined_name($tok, $name) {
                    $found_line = $tok.line
                    $found_col = $tok.col
                    $going = false
                } else {
                    $cur = $rest
                }
            }
        }
    }
    if $found_line == 0 {
        None
    } else {
        $kind = if starts_with($name, '$') || starts_with($name, '@') || starts_with($name, '%') {
            KSigil
        } else {
            KIdent
        }
        Some(Token(kind: $kind, lexeme: $name, line: $found_line, col: $found_col))
    }
}

sub token_begins_binding($rest: TokenList): Bool {
    match $rest {
        TEnd { false }
        TMore($next, $tail) {
            is_op($next, "=") || is_op($next, ":") || is_kw($next, "in")
        }
    }
}

enum DiagnosticBindingDepths {
    DiagnosticDepthNil
    DiagnosticDepthCons($depth: Int, $rest: DiagnosticBindingDepths)
}

sub diagnostic_depths_bound($depths: DiagnosticBindingDepths): Bool {
    match $depths {
        DiagnosticDepthNil { false }
        DiagnosticDepthCons($depth, $rest) { true }
    }
}

sub diagnostic_depths_leave($depths: DiagnosticBindingDepths, $leaving: Int): DiagnosticBindingDepths {
    match $depths {
        DiagnosticDepthNil { DiagnosticDepthNil }
        DiagnosticDepthCons($depth, $rest) {
            if $depth >= $leaving {
                diagnostic_depths_leave($rest, $leaving)
            } else {
                $depths
            }
        }
    }
}

sub params_have_name($params: ParamList, $name: Str): Bool {
    match $params {
        ParamNil { false }
        ParamCons($param, $rest) {
            $param.name == $name || params_have_name($rest, $name)
        }
    }
}

sub diagnostic_match_arm_body_open($match_depth: Int, $depth: Int, $pattern: Bool, $wait_body: Bool): Bool {
    if $match_depth <= 0 {
        false
    } else if $depth != $match_depth {
        false
    } else if $pattern {
        true
    } else {
        $wait_body
    }
}

sub diagnostic_begins_match($tok: Token, $match_depth: Int, $wait_open: Bool): Bool {
    if !is_kw($tok, "match") {
        false
    } else if $match_depth != 0 {
        false
    } else {
        !$wait_open
    }
}

sub diagnostic_begins_for_iterator($tok: Token, $for_vars: Bool): Bool {
    if !$for_vars {
        false
    } else {
        is_kw($tok, "in")
    }
}

sub diagnostic_begins_match_guard($tok: Token, $match_depth: Int, $depth: Int, $pattern: Bool): Bool {
    if $match_depth <= 0 {
        false
    } else if $depth != $match_depth {
        false
    } else if !$pattern {
        false
    } else {
        is_kw($tok, "if")
    }
}

sub diagnostic_is_match_target($match_depth: Int, $depth: Int, $pattern: Bool, $wait_body: Bool): Bool {
    if $match_depth <= 0 {
        false
    } else if $depth != $match_depth {
        false
    } else if !$pattern {
        false
    } else {
        !$wait_body
    }
}

# A block can contain the same spelling in several lexical scopes. Expr nodes do
# not yet carry source positions, so mirror the relevant lexical rule while
# scanning this sub's balanced braces: parameters begin in the outer scope, a
# statement binding becomes visible only after its initializer, and bindings are
# removed with their child scope. The first unbound use is therefore the same
# occurrence that made the type checker stop, including across sibling blocks.
sub find_named_token_in_block($toks: TokenList, $name: Str, $line: Int, $col: Int, $initially_bound: Bool): Option[Token] {
    mut $cur = $toks
    mut $going = true
    mut $started = false
    mut $depth = 0
    mut $pending_depth = 0
    mut $paren_depth = 0
    mut $bracket_depth = 0
    mut $line_continues = false
    mut $bindings = if $initially_bound {
        DiagnosticDepthCons(1, DiagnosticDepthNil)
    } else {
        DiagnosticDepthNil
    }
    mut $for_vars = false
    mut $for_wait_body = false
    mut $for_target = false
    mut $for_iter_saw_token = false
    mut $match_wait_open = false
    mut $match_subject_saw_token = false
    mut $match_depth = 0
    mut $match_pattern = false
    mut $match_wait_body = false
    mut $match_target = false
    mut $lambda_params = false
    mut $lambda_wait_body = false
    mut $lambda_target = false
    mut $found_line = 0
    mut $found_col = 0
    while $going {
        match $cur {
            TEnd { $going = false }
            TMore($tok, $rest) {
                if !$started {
                    if $tok.line == $line {
                        if $tok.col == $col {
                            if is_punct($tok, '{') {
                                $started = true
                                $depth = 1
                            }
                        }
                    }
                    $cur = $rest
                } else if is_kind($tok, KNewline) {
                    if $pending_depth > 0 {
                        if $depth == $pending_depth {
                            if $paren_depth == 0 {
                                if $bracket_depth == 0 {
                                    if !$line_continues {
                                        $bindings = DiagnosticDepthCons($pending_depth, $bindings)
                                        $pending_depth = 0
                                    }
                                }
                            }
                        }
                    }
                    $cur = $rest
                } else if is_punct($tok, ";") {
                    if $pending_depth > 0 {
                        if $depth == $pending_depth {
                            if $paren_depth == 0 {
                                if $bracket_depth == 0 {
                                    if !$line_continues {
                                        $bindings = DiagnosticDepthCons($pending_depth, $bindings)
                                        $pending_depth = 0
                                    }
                                }
                            }
                        }
                    }
                    $cur = $rest
                } else if is_punct($tok, "(") {
                    $paren_depth = $paren_depth + 1
                    $line_continues = false
                    $cur = $rest
                } else if is_punct($tok, ")") {
                    $paren_depth = $paren_depth - 1
                    if $lambda_params {
                        if $paren_depth >= 0 {
                            $lambda_params = false
                            $lambda_wait_body = true
                        }
                    }
                    $line_continues = false
                    $cur = $rest
                } else if is_punct($tok, "[") {
                    $bracket_depth = $bracket_depth + 1
                    $line_continues = false
                    $cur = $rest
                } else if is_punct($tok, "]") {
                    $bracket_depth = $bracket_depth - 1
                    $line_continues = false
                    $cur = $rest
                } else if is_punct($tok, '{') {
                    if $lambda_wait_body {
                        $depth = $depth + 1
                        if $lambda_target {
                            $bindings = DiagnosticDepthCons($depth, $bindings)
                        }
                        $lambda_wait_body = false
                        $lambda_target = false
                    } else if $match_wait_open {
                        if !$match_subject_saw_token {
                            # A leading map literal is the match subject, not the
                            # arm container. The following brace opens the arms.
                            $depth = $depth + 1
                            $match_subject_saw_token = true
                        } else {
                            $depth = $depth + 1
                            $match_depth = $depth
                            $match_wait_open = false
                            $match_pattern = true
                        }
                    } else if diagnostic_match_arm_body_open(
                        $match_depth,
                        $depth,
                        $match_pattern,
                        $match_wait_body
                    ) {
                        $depth = $depth + 1
                        if $match_target {
                            $bindings = DiagnosticDepthCons($depth, $bindings)
                        }
                        $match_pattern = false
                        $match_wait_body = false
                    } else if $for_wait_body {
                        if !$for_iter_saw_token {
                            # As above, a leading map literal is the iterator.
                            $depth = $depth + 1
                            $for_iter_saw_token = true
                        } else {
                            $depth = $depth + 1
                            if $for_target {
                                $bindings = DiagnosticDepthCons($depth, $bindings)
                            }
                            $for_wait_body = false
                            $for_target = false
                            $for_iter_saw_token = false
                        }
                    } else {
                        $depth = $depth + 1
                    }
                    $line_continues = false
                    $cur = $rest
                } else if is_punct($tok, '}') {
                    $leaving = $depth
                    $bindings = diagnostic_depths_leave($bindings, $depth)
                    if $pending_depth >= $depth {
                        $pending_depth = 0
                    }
                    $depth = $depth - 1
                    if $depth == 0 {
                        $going = false
                    } else {
                        if $match_depth > 0 {
                            if $leaving == $match_depth + 1 {
                                $match_pattern = true
                                $match_wait_body = false
                                $match_target = false
                            } else if $leaving == $match_depth {
                                $match_depth = 0
                                $match_pattern = false
                                $match_wait_body = false
                                $match_target = false
                            }
                        }
                        $cur = $rest
                    }
                    $line_continues = false
                } else {
                    if is_kw($tok, "sub") {
                        $lambda_params = true
                        $lambda_wait_body = false
                        $lambda_target = false
                    } else if is_kw($tok, "for") {
                        $for_vars = true
                        $for_wait_body = false
                        $for_target = false
                        $for_iter_saw_token = false
                    } else if diagnostic_begins_for_iterator($tok, $for_vars) {
                        $for_vars = false
                        $for_wait_body = true
                        $for_iter_saw_token = false
                    } else if diagnostic_begins_match(
                        $tok,
                        $match_depth,
                        $match_wait_open
                    ) {
                        $match_wait_open = true
                        $match_subject_saw_token = false
                    } else if diagnostic_begins_match_guard(
                        $tok,
                        $match_depth,
                        $depth,
                        $match_pattern
                    ) {
                        $match_wait_body = true
                        if $match_target {
                            $bindings = DiagnosticDepthCons($match_depth + 1, $bindings)
                        }
                    } else if token_matches_undefined_name($tok, $name) {
                        if $lambda_params {
                            $lambda_target = true
                        } else if $for_vars {
                            $for_target = true
                        } else if diagnostic_is_match_target(
                            $match_depth,
                            $depth,
                            $match_pattern,
                            $match_wait_body
                        ) {
                            $match_target = true
                        } else if token_begins_binding($rest) {
                            $pending_depth = $depth
                        } else if !diagnostic_depths_bound($bindings) {
                            $found_line = $tok.line
                            $found_col = $tok.col
                            $going = false
                        }
                    }
                    if $for_wait_body {
                        if !is_kw($tok, "in") {
                            $for_iter_saw_token = true
                        }
                    }
                    if $match_wait_open {
                        if !is_kw($tok, "match") {
                            $match_subject_saw_token = true
                        }
                    }
                    if is_kind($tok, KOp) {
                        $line_continues = $tok.lexeme != "?"
                    } else {
                        $line_continues = false
                    }
                    $cur = $rest
                }
            }
        }
    }
    if $found_line == 0 {
        None
    } else {
        $kind = if starts_with($name, '$') || starts_with($name, '@') || starts_with($name, '%') {
            KSigil
        } else {
            KIdent
        }
        Some(Token(kind: $kind, lexeme: $name, line: $found_line, col: $found_col))
    }
}

# The AST stores declaration/body positions rather than widening every Expr arm
# with source metadata. For the checker's first undefined-name failure, find the
# corresponding name token in that same body and render the canonical located
# diagnostic used by both drivers.
sub locate_sub_type_error($src: Str, $sub: SubDecl, $err: Str): Str {
    match tc_undefined_name($err) {
        None { $err }
        Some($name) {
            match lex($src) {
                Err($e) { $err }
                Ok($toks) {
                    $located = match $sub.body {
                        BlockBody($stmts) {
                            find_named_token_in_block(
                                $toks,
                                $name,
                                $sub.body_line,
                                $sub.body_col,
                                params_have_name($sub.params, $name)
                            )
                        }
                        ExprBody($expr) {
                            find_named_token_after($toks, $name, $sub.body_line, $sub.body_col)
                        }
                    }
                    match $located {
                        None { $err }
                        Some($tok) { "{ $tok.line }:{ $tok.col }: undefined binding " ~ $name }
                    }
                }
            }
        }
    }
}

sub check_class_subs_t2($src: Str, $c: ClassDecl, $ss: SubDeclList, $class_ty: SemType, $subs: SemSubTable): Result[Unit, Str] {
    match $ss {
        SubDeclNil { Ok(()) }
        SubDeclCons($s, $rest) {
            match check_sub_body_t2($s, class_sub_env($c, $s, $class_ty, $subs), $subs) {
                Err($e) { Err(locate_sub_type_error($src, $s, $e)) }
                Ok(()) { check_class_subs_t2($src, $c, $rest, $class_ty, $subs) }
            }
        }
    }
}

sub check_class_decl_t2($src: Str, $c: ClassDecl, $subs: SemSubTable): Result[Unit, Str] {
    match sem_sub_lookup($subs, $c.name) {
        Some($class_ty) { check_class_subs_t2($src, $c, $c.subs, $class_ty, $subs) }
        None { Ok(()) }
    }
}

# Enum method/associated bodies (the DEnum twin of class_sub_env): an instance
# method (`$self` first) sees `$self` as the enum type; enums have no direct
# fields, so — unlike classes — there is no private-field env. Associated
# functions (no `$self`) get only their parameter env. Mirrors the Go oracle
# checkDecl's *ast.EnumDecl arm (extra = {"$self": et} when isMethodSub).
sub enum_sub_env($e: EnumDecl, $s: SubDecl, $enum_ty: SemType, $subs: SemSubTable): TEnv {
    $base = params_to_tenv($s.params, tenv_child(TENil), $subs)
    if is_method_sub($s) {
        tenv_define($base, '$self', $enum_ty)
    } else {
        $base
    }
}

sub check_enum_subs_t2($src: Str, $e: EnumDecl, $ss: SubDeclList, $enum_ty: SemType, $subs: SemSubTable): Result[Unit, Str] {
    match $ss {
        SubDeclNil { Ok(()) }
        SubDeclCons($s, $rest) {
            match check_sub_body_t2($s, enum_sub_env($e, $s, $enum_ty, $subs), $subs) {
                Err($err) { Err(locate_sub_type_error($src, $s, $err)) }
                Ok(()) { check_enum_subs_t2($src, $e, $rest, $enum_ty, $subs) }
            }
        }
    }
}

# Only NON-generic enums register a concrete TEnum symbol under their name (via
# build_sem_enum_symbols); generic enum method bodies carry unresolvable T
# annotations, so — exactly like check_class_decl_t2 for generic classes — a
# None lookup skips them (a documented looseness, SUBSET.md).
sub check_enum_decl_t2($src: Str, $e: EnumDecl, $subs: SemSubTable): Result[Unit, Str] {
    match sem_sub_lookup($subs, $e.name) {
        Some($enum_ty) { check_enum_subs_t2($src, $e, $e.subs, $enum_ty, $subs) }
        None { Ok(()) }
    }
}

sub import_alias_is($path: StrList, $name: Str): Bool {
    match $path {
        StrNil { false }
        StrCons($head, StrNil) { $head == $name }
        StrCons($head, $rest) { import_alias_is($rest, $name) }
    }
}

sub decls_have_import_alias($decls: DeclList, $name: Str): Bool {
    mut $cur = $decls
    mut $going = true
    mut $found = false
    while $going {
        match $cur {
            DeclNil { $going = false }
            DeclCons($decl, $rest) {
                match $decl {
                    DImport($imp) {
                        if import_alias_is($imp.path, $name) {
                            $found = true
                            $going = false
                        } else {
                            $cur = $rest
                        }
                    }
                    _ { $cur = $rest }
                }
            }
        }
    }
    $found
}

# §16.2: user-introduced top-level value names are unique. Prelude names are
# intentionally absent from this table, so a user sub may still shadow one.
sub check_top_level_name_clashes($decls: DeclList): Result[Unit, Str] {
    mut %seen: Map[Str, Str] = {}
    mut %seen_imports: Map[Str, Str] = {}
    mut $cur = $decls
    mut $going = true
    mut $failed = false
    mut $err = ""
    while $going {
        match $cur {
            DeclNil { $going = false }
            DeclCons($decl, $rest) {
                match $decl {
                    DSub($sub) {
                        match get(%seen, $sub.name) {
                            Some($first) {
                                $err = "{ $sub.line }:{ $sub.col }: duplicate top-level sub { $sub.name }, already defined at { $first }; guji has no overloading, so each top-level name may be defined once (§16.2)"
                                $failed = true
                                $going = false
                            }
                            None {
                                if decls_have_import_alias($decls, $sub.name) {
                                    $err = "{ $sub.line }:{ $sub.col }: top-level sub { $sub.name } clashes with the import binding { $sub.name }; guji has no overloading, so each top-level name may be defined once (§16.2)"
                                    $failed = true
                                    $going = false
                                } else {
                                    %seen = %seen.set($sub.name, "{ $sub.line }:{ $sub.col }")
                                    $cur = $rest
                                }
                            }
                        }
                    }
                    DImport($imp) {
                        $alias = strlist_last($imp.path)
                        match get(%seen_imports, $alias) {
                            Some($first) {
                                $err = "{ $imp.alias_line }:{ $imp.alias_col }: duplicate import binding { $alias }, already defined at { $first }; each import binds its final path segment once (§16.2)"
                                $failed = true
                                $going = false
                            }
                            None {
                                %seen_imports = %seen_imports.set(
                                    $alias,
                                    "{ $imp.alias_line }:{ $imp.alias_col }"
                                )
                                $cur = $rest
                            }
                        }
                    }
                    _ { $cur = $rest }
                }
            }
        }
    }
    if $failed { Err($err) } else { Ok(()) }
}

sub check_program_bodies_t2($src: Str, $decls: DeclList, $subs: SemSubTable): Result[Str, Str] {
    mut $cur = $decls
    mut $going = true
    mut $failed = false
    mut $err = ""
    while $going {
        match $cur {
            DeclNil { $going = false }
            DeclCons($d, $rest) {
                match $d {
                    DSub($s) {
                        $env = if strlist_empty($s.tparams) {
                            params_to_tenv($s.params, tenv_child(TENil), $subs)
                        } else {
                            params_to_tenv_tps($s.params, tenv_child(TENil), $subs, $s.tparams)
                        }
                        match check_sub_body_t2($s, $env, $subs) {
                            Err($e) {
                                $err = locate_sub_type_error($src, $s, $e)
                                $failed = true
                                $going = false
                            }
                            Ok(()) { $cur = $rest }
                        }
                    }
                    DClass($c) {
                        match check_class_decl_t2($src, $c, $subs) {
                            Err($e) {
                                $err = $e
                                $failed = true
                                $going = false
                            }
                            Ok(()) { $cur = $rest }
                        }
                    }
                    DEnum($e) {
                        match check_enum_decl_t2($src, $e, $subs) {
                            Err($e) {
                                $err = $e
                                $failed = true
                                $going = false
                            }
                            Ok(()) { $cur = $rest }
                        }
                    }
                    DImport($i) { $cur = $rest }
                    # P7b boundary: grammar decls parse, but typecheck/eval/codegen of
                    # GrammarType / Bush / packrat emission land in later P7 slices.
                    DGrammar($g) { $cur = $rest }
                }
            }
        }
    }
    if $failed { Err($err) } else { Ok("well-typed") }
}

# §18 fixes the entry result contract independently of whether the backend can
# lower the body. Reject an explicitly invalid annotation in the shared front
# end so the compiler and interpreter cannot disagree as exit-4 vs runtime
# panic. An unannotated main remains inferable and is checked through its body.
sub check_entry_return_type($decls: DeclList, $subs: SemSubTable): Result[Unit, Str] {
    match $decls {
        DeclNil { Ok(()) }
        DeclCons($decl, $rest) {
            match $decl {
                DSub($sub) {
                    if $sub.name == "main" {
                        match $sub.ret {
                            None { Ok(()) }
                            Some($tr) {
                                $ret = sub_ret_sem($sub, $subs)
                                match $ret {
                                    TInt { Ok(()) }
                                    TUnit { Ok(()) }
                                    _ { Err(tc_err("main must return Unit or Int, got " ~ sem_to_str($ret) ~ " (§18)")) }
                                }
                            }
                        }
                    } else {
                        check_entry_return_type($rest, $subs)
                    }
                }
                _ { check_entry_return_type($rest, $subs) }
            }
        }
    }
}

sub check_program_t2($src: Str, $decls: DeclList, $subs: SemSubTable): Result[Str, Str] {
    match check_top_level_name_clashes($decls) {
        Err($err) { Err($err) }
        Ok(()) {
            match check_entry_return_type($decls, $subs) {
                Err($err) { Err($err) }
                Ok(()) { check_program_bodies_t2($src, $decls, $subs) }
            }
        }
    }
}

# Public T1 entry: parse, build the sub-signature table, and type-check every
# sub. Returns "well-typed" on success, else the first parse or type-error
# message. Kept for the T1-T3b fixtures that assert on the raw verdict string.
pub sub typecheck_to_string($src: Str): Str {
    match parse($src) {
        Err($e) { $e }
        Ok($prog) {
            $subs = sem_table_index(build_sem_sub_table($prog.decls))
            match check_program_t2($src, $prog.decls, $subs) {
                Ok($msg) { $msg }
                Err($e) { $e }
            }
        }
    }
}

# ---- T4 driver verdict ----------------------------------------------------
# A CLASSIFIED type-check verdict for the slice-3 driver and differential
# harness. The three arms are the exact stages the front end distinguishes:
#   TcAccept            -- the program is well-typed (parse + type-check pass).
#   TcRejectType($msg)  -- a TYPE error (later stage): parse succeeded but the
#                          type checker rejected the program.
#   TcRejectParse($msg) -- a LEX or PARSE error (earlier stage): the program
#                          never reaches the type checker.
# The T5 differential excludes TcRejectParse (parse is a separate stage from the
# type-check decision) and asserts selfhost/oracle agreement on the accept-vs-
# type-reject split.
pub enum TcVerdict {
    TcAccept
    TcRejectType($msg: Str)
    TcRejectParse($msg: Str)
}

# Canonical accept token printed by the driver on a well-typed program. Defined
# once here so the driver and every fixture share one spelling.
pub sub typecheck_accept_token(): Str {
    "well-typed"
}

# Public T4 entry: lex -> parse -> type-check, returning the classified verdict.
# `parse` already chains the lexer, so its Err covers both lex and parse errors;
# a non-empty type-check Err is a type rejection.
pub sub typecheck_verdict($src: Str): TcVerdict {
    match parse($src) {
        Err($e) { TcRejectParse($e) }
        Ok($prog) {
            $subs = sem_table_index(build_sem_sub_table($prog.decls))
            match check_program_t2($src, $prog.decls, $subs) {
                Ok($msg) { TcAccept }
                Err($e) { TcRejectType($e) }
            }
        }
    }
}

# Path-aware T4 entry: resolves leading `import name` declarations as sibling
# `<name>.guji` files relative to the source path and exposes only pub top-level
# declarations as `name::member` symbols. The original source-only entry remains
# deliberately permissive for standalone stdin fixtures.
pub sub typecheck_verdict_at($path: Str, $src: Str): TcVerdict {
    match parse($src) {
        Err($e) { TcRejectParse($e) }
        Ok($prog) {
            match check_top_level_name_clashes($prog.decls) {
                Err($e) { TcRejectType($e) }
                Ok(()) {
                    match build_import_symbols($path, $prog.decls) {
                        Err($e) { TcRejectParse($e) }
                        Ok($imports) {
                            $subs = sem_table_index(build_sem_sub_table_with_imports($prog.decls, $imports))
                            match check_program_t2($src, $prog.decls, $subs) {
                                Ok($msg) { TcAccept }
                                Err($e) { TcRejectType($e) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# ---- Canonical native REPL -------------------------------------------------

sub repl_stmt_list_append($left: StmtList, $right: StmtList): StmtList {
    match $left {
        StmtNil { $right }
        StmtCons($head, $tail) { StmtCons($head, repl_stmt_list_append($tail, $right)) }
    }
}

sub repl_sub_table($stmts: StmtList): SubTable {
    # Keeping accepted statements in a synthetic body lets the ordinary lambda
    # resolver find function values created on earlier REPL lines.
    SubTCons(
        "__guji_repl__",
        SubDecl(
            public: false,
            name: "__guji_repl__",
            line: 0,
            col: 0,
            body_line: 0,
            body_col: 0,
            tparams: StrNil,
            params: ParamNil,
            ret: None,
            body: BlockBody($stmts)
        ),
        SubTNil
    )
}

sub eval_repl_stmt($stmt: Stmt, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $stmt {
        # File blocks treat a binding as Unit, while the REPL echoes its assigned
        # value. Preserve the shared evaluation/update rules and change only the
        # observable result.
        SBind($mutable, $name, $ty, $value_expr) {
            match eval_expr_chan_ctx($value_expr, $ty, $subs, $env) {
                Err($e) { Err($e) }
                Ok($r) {
                    if $r.returned {
                        Ok($r)
                    } else if $mutable {
                        Ok(flow($r.value, env_define_mut($r.env, $name, $r.value)))
                    } else {
                        match env_set($r.env, $name, $r.value) {
                            Err($e) { Err($e) }
                            Ok($next) { Ok(flow($r.value, $next)) }
                        }
                    }
                }
            }
        }
        _ { eval_stmt($stmt, $subs, $env) }
    }
}

sub eval_repl_stmts($stmts: StmtList, $subs: SubTable, $env: Env): Result[EvalResult, Str] {
    match $stmts {
        StmtNil { Ok(flow(VUnit, $env)) }
        StmtCons($head, $tail) {
            match eval_repl_stmt($head, $subs, $env) {
                Err($e) { Err($e) }
                Ok($r) {
                    if $r.returned {
                        Ok($r)
                    } else {
                        match $tail {
                            StmtNil { Ok($r) }
                            _ { eval_repl_stmts($tail, $subs, $r.env) }
                        }
                    }
                }
            }
        }
    }
}

sub type_error_without_prefix($err: Str): Str {
    $prefix = "type error: "
    if starts_with($err, $prefix) {
        drop(split($err, ""), split($prefix, "").count()).join("")
    } else {
        $err
    }
}

sub repl_capture_name($err: Str): Option[Str] {
    $prefix = "type error: cannot capture mut binding "
    if starts_with($err, $prefix) {
        $tail = drop(split($err, ""), split($prefix, "").count()).join("")
        @words = split($tail, " ")
        if @words.count() > 0 { Some(@words[0]) } else { None }
    } else {
        None
    }
}

sub locate_repl_type_error($src: Str, $err: Str): Str {
    $plain = type_error_without_prefix($err)
    match repl_capture_name($err) {
        None { $plain }
        Some($name) {
            match lex($src) {
                Err($e) { $plain }
                Ok($toks) {
                    match find_named_token_after($toks, $name, 0, 0) {
                        None { $plain }
                        Some($tok) { "{ $tok.line }:{ $tok.col }: " ~ $plain }
                    }
                }
            }
        }
    }
}

pub sub repl(): Int {
    print("guji REPL (v0) — type :quit to exit")
    mut $runtime_env = EnvFrame(BindNil, EnvNil)
    mut $type_env = TEFrame(TSNil, false, TENil)
    mut $accepted = StmtNil

    stdout.write("> ")
    for $line in stdin.lines() {
        if $line == ":quit" {
            return 0
        }
        if trim($line) == "" {
            stdout.write("> ")
        } else {
            match parse_repl_statements($line) {
                Err($e) { print($e) }
                Ok($stmts) {
                    match check_block_t2($stmts, $type_env, SSTNil, TUnknown, TUnit) {
                        Err($e) { print(locate_repl_type_error($line, $e)) }
                        Ok($checked) {
                            $candidate = repl_stmt_list_append($accepted, $stmts)
                            match eval_repl_stmts($stmts, repl_sub_table($candidate), $runtime_env) {
                                Err($e) { print($e) }
                                Ok($evaluated) {
                                    $runtime_env = $evaluated.env
                                    $type_env = $checked.env
                                    $accepted = $candidate
                                    match $evaluated.value {
                                        VUnit { () }
                                        _ { print(display_value($evaluated.value)) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            stdout.write("> ")
        }
    }
    0
}

# =====================================================================
# Slice 4 G1/G2/G3 — minimal native codegen.
# =====================================================================
# Emits the PROGRAM-SPECIFIC C tail (`gf_main` + the fixed drop table + `main`)
# for the early compiler slices. G1 covered `sub main(): Int { <int literal> }`;
# G2 added leading `print(<Str literal>)` statements before the final Int. G3
# generalises both ends: the gf_main return value may be any Int EXPRESSION (Int
# literals, unary `-`, and the `+ - * / % **` operators of §5.1, lowered to the
# reused runtime's guji_add/sub/mul/div/mod/pow/neg helpers — so overflow,
# div-by-zero, and mod-by-zero panic identically to both oracles), and each
# `print` argument may be any Str EXPRESSION (a Str literal or `~` concatenation,
# §5.2, lowered via guji_str_cat with the same release discipline guji build
# emits). Bool/Float and the comparison/logical operators are deferred: they
# cannot be observed at the program boundary until `if`/bindings exist.
#
# The self-hosted compiler produces a single `.c` by concatenating the canonical
# program-independent runtime (`selfhost/rt/runtime_prologue.c`) with the tail
# this function emits. The runtime started as a captured compatibility artifact;
# it is now maintained as part of the authoritative Guji toolchain.
#
# Type access reuses the typechecker: `compile_program_c` runs the program
# through `typecheck_verdict` first, so codegen only ever lowers already
# well-typed input (no typed AST exists; the verdict IS the type gate for these
# first slices).

# The fixed drop table + `main` epilogue. Identical for every scalar-only program
# (no user-defined classes/enums => no program drop fns), so it mirrors what
# codegen.go emits for a program with an empty user-drop set. The entry ORDER is
# load-bearing -- it indexes the runtime's GUJI_KIND_* enum -- and matches the
# captured prologue's forward declaration.
# Literal `{` must be escaped `\{` in double-quoted strings (it otherwise opens a
# §12 interpolation); `}` is literal on its own.
sub g1_epilogue($extra_drops: Str): Str {
    "static const guji_drop_fn guji_drop_table[] = \{\n" ~
    "\tguji_drop_str,\n" ~
    "\tguji_drop_arr_scalar,\n" ~
    "\tguji_drop_arr_str,\n" ~
    "\tguji_drop_arr_slice,\n" ~
    "\tguji_drop_arr_map,\n" ~
    "\tguji_drop_arr_fn,\n" ~
    "\tguji_drop_arr_ptr,\n" ~
    "\tguji_drop_env,\n" ~
    "\tguji_drop_match,\n" ~
    "\tguji_drop_bush,\n" ~
    "\tguji_drop_reader,\n" ~
    $extra_drops ~
    "};\n\n\n" ~
    "int main(int argc, char** argv) \{\n" ~
    # Native text operations must not silently fall back to the ASCII-only C
    # locale when a process starts with an empty environment.  Prefer glibc's
    # built-in UTF-8 locale spellings, then honor an explicitly configured host
    # locale only as a compatibility fallback.
    "\tif (setlocale(LC_ALL, \"C.UTF-8\") == NULL && setlocale(LC_ALL, \"C.utf8\") == NULL) \{\n" ~
    "\t\tsetlocale(LC_ALL, \"\");\n" ~
    "\t}\n" ~
    "\tguji_set_args(argc, argv);\n" ~
    "\treturn guji_conc_main_exit((int)gf_main());\n" ~
    "}\n"
}

# §18 requires `main`; D reports the missing entry at execution time. Emit the
# same tiny failing entry point instead of declining codegen, so the canonical
# C/D differential can pin stdout/stderr/exit (including the sanitized C path).
sub g1_missing_main_program(): Str {
    "static int64_t gf_main(void) \{\n" ~
    "\tguji_panic(\"no main() function defined\");\n" ~
    "\treturn 0LL;\n" ~
    "}\n\n" ~
    g1_epilogue("")
}

# The fixed early-codegen-subset diagnostic, defined once.
sub g3_unsupported(): Str {
    "selfhost-codegen: G4b-c supports the G3/G3b/G4a subset plus scalar/Str bindings and reassignment, empty Unit blocks, block-valued if/elif/else branches, and expression-position if values for scalar/Str results; collection bindings and re-mut shadowing are still out of subset"
}

# Codegen accumulator: interned Str statics (`gs_N`), pre-declared `gt` temps,
# the emitted body, and the two INDEPENDENT counters (string statics vs temps —
# every expression node gets a `gt`, but only Str literals get a `gs`).
class CgState {
    has $.interns: Str
    has $.decls: Str
    has $.body: Str
    has $.nstr: Int
    has $.ntmp: Int
}

# Result of lowering a Str expression: the updated state plus the name of the
# `gt` temp that now holds the value (owning a fresh string, or aliasing an
# immortal Str literal static — in which case its release is a no-op).
class StrLower {
    has $.state: CgState
    has $.tmp: Str
}

# Result of lowering a Bool expression: the updated state plus a C `int64_t`
# rvalue/temp whose nonzero value is true. Most Bool expressions are pure
# rvalues; Str comparisons may emit string temps and a `gb_N` bool temp.
class BoolLower {
    has $.state: CgState
    has $.c: Str
}

class CgValueOut {
    has $.state: CgState
    has $.c: Str
}

# Accumulator for lowering a list-literal `.contains` predicate: the threaded
# state after all elements have lowered, the OR-chain C expression (each term is
# counted-Str equality), and the deferred element-temp releases.
class ContainsAcc {
    has $.state: CgState
    has $.expr: Str
    has $.rel: Str
}

class CgArgsOut {
    has $.state: CgState
    has $.args: Str
    has $.releases: Str
}

# Tail emitted after a branch in an `if`: later `else if` conditions may need
# preparatory statements, so threading CgState through tail emission matters.
class IfTail {
    has $.state: CgState
    has $.code: Str
}

# The lowered body of a `sub` (main or user): accumulated statics/decls/body plus
# the C rvalue the function returns (`0LL` for a Unit body, the value rvalue for a
# value body). `nstr` is the running GLOBAL intern counter — `gs_N` statics live at
# file scope, so the counter must thread ACROSS functions (only `decls`/`body` and
# the `ntmp` temp counter are function-local).
class MainOut {
    has $.interns: Str
    has $.decls: Str
    has $.body: Str
    has $.ret: Str
    has $.nstr: Int
}

sub c_int($n: Int): Str {
    "{ $n }"
}

sub g3_empty_state(): CgState {
    CgState(interns: "", decls: "", body: "", nstr: 0, ntmp: 0)
}

# ---- G4: codegen environment (binding name -> C local + value kind) -------
# Scalar bindings (Int/Float/Bool) and Str bindings lower to C locals (`gvN`,
# sharing the CgState.ntmp counter so names never collide with `gt`/`gb`/`gi` temps). The
# environment maps each guji binding name (sigil-prefixed, e.g. "$x") to its C
# local name, its value kind (so later `EName` references resolve in the right
# kind-lowerer), and whether it was declared `mut` (so a reassignment can reuse
# the same local). Collection bindings are still out of this slice's subset (the
# value never lowers as a supported kind, so the binding is rejected as out-of-
# subset -> invalid-corpus).
enum CgKind {
    CgInt
    CgFloat
    CgBool
    CgStr
    # A §13 Match value (`guji_match_t*`). Owned when fresh from `~~` / Match-
    # returning calls; borrowed when bound from `Some($m)` over Option[Match].
    CgMatch
    # A §14 Bush parse-tree node (`guji_bush_t*`). Direct grammar parsing binds
    # these borrowed from an Option[Bush] match arm; fresh capture carriers own
    # the retained child pointer.
    CgBush
    # A §15.4 text Handle (`guji_reader_t*`). Handles are counted runtime
    # objects: fresh open/create/std-handle values own one reference, while
    # Result match-arm payload binders borrow the carrier's active Ok slot.
    CgHandle
    # The `Unit` type as a value slot (slice 5 E5d-7c-2d-11). The compiler's own
    # source returns `Result[Unit, Str]` from its type-checker helpers
    # (`synth_args`, `check_list_rest`, …), so a Result carrier may carry `Unit` in
    # its Ok slot. Unit has a single value `()` and owns nothing, so it lowers to a
    # plain `int64_t 0LL` slot — the same storage as `CgInt` (and so its Result
    # carrier reuses the `guji_res_int_*` typedef via the `g6_result_kindword`
    # wildcard). NATIVE accepts `Result[Unit,…]` construction and a `Ok($u)` name
    # bind, but REJECTS the `Ok(())` unit PATTERN the real source uses, so the
    # unit-pattern path is interp-oracle / beyond-native.
    CgUnit
    CgOptInt
    CgOptFloat
    CgOptBool
    CgOptStr
    # An `Option[<user class>]` field/value (slice 5 E5d-7c-2d-5). Stored as a
    # per-class tagged carrier `guji_opt_<Class> { int64_t tag; <Class> val; }`
    # (tag 1 = Some, 0 = None), the by-value class analogue of the scalar
    # `CgOpt*` kinds. NATIVE rejects `Option[class]` class fields, so this is
    # interp-oracle / beyond-native work, composed from the by-value class
    # carrier machinery (the `Result[class]` carrier in E5d-7c-2d).
    CgOptClass($name: Str)
    # An `Option[<user enum>]` field/value (slice 5 E5d-7c-2d-7). Stored as a
    # per-enum tagged carrier `guji_opt_<Enum> { int64_t tag; <Enum> val; }`
    # (tag 1 = Some, 0 = None), the by-value enum analogue of `CgOptClass`. The
    # `<Enum>` is a fixed-size struct (recursion is via pointers), so embedding it
    # by value is sound. NATIVE rejects `Option[enum]` as a variant field, so this
    # is interp-oracle / beyond-native work, composed from the by-value enum
    # carrier machinery (4d nested enums + the `Result[enum]` carrier E5d-7c-2d-2).
    CgOptEnum($name: Str)
    # An `Option[List[T]]` value. The carrier stores an owned `guji_slice_t`
    # payload; P2b-3c-5 first uses it for `.find` over `List[List[Int]]`.
    CgOptList($elem: CgKind)
    # An `Option[Map[Str, T]]` value. The carrier stores an owned `guji_map_t`
    # payload, mirroring native's guji_opt_map shape for map-carrier equality.
    CgOptMap($val: CgKind)
    # An `Option[Match]` carrier from `~~` / Match-returning calls (P6). Payload
    # is an owned `guji_match_t*` (RC1.4b); tag 1 = Some, 0 = None.
    CgOptMatch
    # An `Option[Bush]` carrier. Its active payload owns one counted Bush pointer,
    # exactly like CgOptMatch owns its Match pointer.
    CgOptBush
    # An outer receive-presence wrapper for a channel whose ELEMENT is itself
    # an Option carrier. `Chan[Option[Int]].recv()` is
    # `Option[Option[Int]]`: the outer tag distinguishes closed/drained from a
    # delivered `Some(None)`, while `inner` names the by-value element carrier.
    # P8d-2c-3c admits scalar and counted Option elements incrementally; keeping
    # the wrapper structural avoids a per-payload kind grind.
    CgOptCarrier($inner: CgKind)
    CgRes($ok: CgKind, $err: CgKind)
    CgEnum($name: Str)
    CgBoxEnum($name: Str)
    CgBoxClass($name: Str)
    CgBoxOptClass($name: Str)
    CgBoxOptEnum($name: Str)
    CgClass($name: Str)
    CgList($elem: CgKind)
    CgMap($val: CgKind)
    # First-class function values use native-shaped `guji_fn_t` pairs. Bound
    # lambdas may carry a captured `genv_*` env; function-valued parameters borrow
    # the pair and call through the same ABI.
    CgFn($params: CgKindList, $ret: CgRet)
    # §17.2 channel handle (`guji_chan_t*`). Element kind is tracked statically
    # so send/recv can size the slot and build Option[T] / Result[Unit,Closed].
    CgChan($elem: CgKind)
    # §17.3 `Closed` — the unit-like channel-error type. Lives only as the Err
    # slot of `Result[Unit, Closed]` (`guji_res_unit_closed`); storage is int64_t.
    CgClosed
}

# ---- G6b-b-2b-ii-b-3-iii: user-enum codegen metadata ------------------------
# A user enum lowers to a native-shaped tagged struct `struct <Name> { int64_t
# tag; <fields...> };`. Field positions are flattened across variants (`f0`,
# `f1`, ...), and this scalar-field cut supports homogeneous Int/Float/Bool
# positions only. The tag of a variant is its 0-based declaration index, exactly
# like `guji build`.
class CgVariant {
    has $.name: Str
    has $.fields: CgKindList
}

enum CgVariantInfoList {
    CgVarNil
    CgVarCons($head: CgVariant, $tail: CgVariantInfoList)
}

class CgEnumInfo {
    has $.name: Str
    has $.variants: CgVariantInfoList
}

class CgClassField {
    has $.name: Str
    has $.kind: CgKind
    has $.index: Int
    has $.boxcarrier: Bool
    has $.public: Bool
    has $.sigil: Str
}

# Result of resolving a (possibly chained) field-access expression to a C member
# accessor plus the accessed field's CgKind. Built by g8_resolve_field_acc so a
# nested-class access like `$obj.f0.n` lowers to `obj.f0.f0` with the leaf kind.
class CgFieldAcc {
    has $.acc: Str
    has $.kind: CgKind
    # EB-1b: true when the accessor reads THROUGH a heap box (`(*(...))`), i.e. some
    # field on the chain is a cross-cycle box. Such an accessor is only valid BEFORE
    # the owning local's scope cleanup releases (and frees) the box, so a read in tail
    # position must MATERIALIZE into a temp before cleanup rather than inline the
    # accessor. A by-value-only chain is cleanup-stable (viabox=false).
    has $.viabox: Bool
}

enum CgClassFieldInfoList {
    CgClassFieldNil
    CgClassFieldCons($head: CgClassField, $tail: CgClassFieldInfoList)
}

class CgClassInfo {
    has $.name: Str
    has $.fields: CgClassFieldInfoList
}

class CgVar {
    has $.name: Str
    has $.cname: Str
    has $.kind: CgKind
    has $.mutable: Bool
    has $.borrowed: Bool
    # For a `CgList` binding, the fixed length of its `<cname>_data[N]` stack
    # array (= the literal's element count at bind time); 0 for every non-list
    # binding. Whole-list reassignment (`@xs = [...]`) is in subset only when the
    # new literal has EXACTLY this many elements, so the fixed array never
    # overflows (native's copy-loop relies on stack-overflow UB for a longer
    # list — out of subset here).
    has $.listlen: Int
}

# ---- G5: user sub signatures (DSub) -----------------------------------------
# A sub's return kind. RUnit subs lower to a C function returning int64_t 0LL
# (matching `guji build`); RInt/RBool also return int64_t, RFloat returns double.
# RStr returns an owned const char* reference.
enum CgRet {
    RInt
    RFloat
    RBool
    RStr
    RUnit
    REnum($name: Str)
    RClass($name: Str)
    ROpt($k: CgKind)
    RRes($k: CgKind)
    RList($elem: CgKind)
    RMap($val: CgKind)
    # Bare §14 Bush return (`sub(...): Bush`). Owned `guji_bush_t*` (+1 to caller);
    # borrowed-param returns retain before handing the pointer out.
    RBush
    # §17.2 channel return (`sub(...): Chan[T]`). Owned `guji_chan_t*` (+1 to
    # caller). Bound-name tails must retain into a temp AS A STATEMENT before
    # scope-exit cleanup (see g11_chan_owned_value); fresh builders/call results
    # transfer their existing +1.
    RChan($elem: CgKind)
    # §7.4 function-valued return (P9-9a). Inferred from an unannotated sub
    # whose trailing expression is a lambda (`g5_fn_ret_from_body`); also
    # reachable via P9-10b-3b body inference when a trailing call returns RFn.
    # An annotated `: Func[...]` return still declines in g5_ret_kind, matching
    # the lambda parameter/return scalar subset. The returned `guji_fn_t` pair
    # transfers its env ownership to the caller.
    RFn($params: CgKindList, $ret: CgRet)
}

# Structural equality over codegen kinds. Used by cg_ret_eq to compare two
# Option return kinds (a call's expected vs the sub's actual return).
sub cgkind_eq($a: CgKind, $b: CgKind): Bool {
    match $a {
        CgInt { match $b { CgInt { true } _ { false } } }
        CgFloat { match $b { CgFloat { true } _ { false } } }
        CgBool { match $b { CgBool { true } _ { false } } }
        CgStr { match $b { CgStr { true } _ { false } } }
        CgMatch { match $b { CgMatch { true } _ { false } } }
        CgBush { match $b { CgBush { true } _ { false } } }
        CgHandle { match $b { CgHandle { true } _ { false } } }
        CgUnit { match $b { CgUnit { true } _ { false } } }
        CgOptInt { match $b { CgOptInt { true } _ { false } } }
        CgOptFloat { match $b { CgOptFloat { true } _ { false } } }
        CgOptBool { match $b { CgOptBool { true } _ { false } } }
        CgOptStr { match $b { CgOptStr { true } _ { false } } }
        CgOptClass($na) { match $b { CgOptClass($nb) { $na == $nb } _ { false } } }
        CgOptEnum($na) { match $b { CgOptEnum($nb) { $na == $nb } _ { false } } }
        CgOptList($ea) { match $b { CgOptList($eb) { cgkind_eq($ea, $eb) } _ { false } } }
        CgOptMap($va) { match $b { CgOptMap($vb) { cgkind_eq($va, $vb) } _ { false } } }
        CgOptMatch { match $b { CgOptMatch { true } _ { false } } }
        CgOptBush { match $b { CgOptBush { true } _ { false } } }
        CgOptCarrier($ia) { match $b { CgOptCarrier($ib) { cgkind_eq($ia, $ib) } _ { false } } }
        CgRes($oka, $ea) { match $b { CgRes($okb, $eb) { cgkind_eq($oka, $okb) && cgkind_eq($ea, $eb) } _ { false } } }
        CgEnum($na) { match $b { CgEnum($nb) { $na == $nb } _ { false } } }
        CgBoxEnum($na) { match $b { CgBoxEnum($nb) { $na == $nb } _ { false } } }
        CgBoxClass($na) { match $b { CgBoxClass($nb) { $na == $nb } _ { false } } }
        CgBoxOptClass($na) { match $b { CgBoxOptClass($nb) { $na == $nb } _ { false } } }
        CgBoxOptEnum($na) { match $b { CgBoxOptEnum($nb) { $na == $nb } _ { false } } }
        CgClass($na) { match $b { CgClass($nb) { $na == $nb } _ { false } } }
        CgList($ea) { match $b { CgList($eb) { cgkind_eq($ea, $eb) } _ { false } } }
        CgMap($va) { match $b { CgMap($vb) { cgkind_eq($va, $vb) } _ { false } } }
        CgFn($pa, $ra) { match $b { CgFn($pb, $rb) { cgkind_list_eq($pa, $pb) && cg_ret_eq($ra, $rb) } _ { false } } }
        CgChan($ea) { match $b { CgChan($eb) { cgkind_eq($ea, $eb) } _ { false } } }
        CgClosed { match $b { CgClosed { true } _ { false } } }
    }
}

# A cons-list of parameter kinds, in declaration order. Used to lower each call
# argument under its parameter's kind (Int -> int64_t rvalue, Float -> double).
enum CgKindList {
    CgKindNil
    CgKindCons($head: CgKind, $tail: CgKindList)
}

sub cgkind_list_eq($a: CgKindList, $b: CgKindList): Bool {
    match $a {
        CgKindNil { match $b { CgKindNil { true } _ { false } } }
        CgKindCons($ah, $at) {
            match $b {
                CgKindCons($bh, $bt) { cgkind_eq($ah, $bh) && cgkind_list_eq($at, $bt) }
                _ { false }
            }
        }
    }
}

# A user sub signature: its bare name, the emitted C name (`gf_<name>`), the
# ordered parameter kinds, and the return kind. Stored in the codegen
# environment (CgEnvSub) so an `ECall(EName(f), args)` can resolve `f`'s return
# kind (to pick the Int/Float/Bool lowerer) and parameter kinds (to lower each
# argument) without re-synthesising types.
class CgSig {
    has $.name: Str
    has $.cname: Str
    has $.params: CgKindList
    has $.ret: CgRet
    # §13: a `(): Regex` sub returns a Regex-as-Str (RStr in rep); the flag keeps
    # the Regex marking across calls so `$p = pick()` binds listlen -3 (display
    # wraps `/.../`, splices insert the pattern raw instead of double-escaping).
    has $.retregex: Bool
    # P9-10b-3b-2b: at least one parameter was annotated BARE `Func` — its stored
    # kind is the canonical placeholder, substituted to the call's concrete fn
    # argument kind at each call site (native CallSig instantiation).
    has $.barefn: Bool
    # The return annotation was BARE `Func` and the trailing body expression is
    # NOT a lambda (whose concrete shape would already be pinned): the stored
    # RFn placeholder is likewise substituted from the call's fn argument kind.
    has $.retbarefn: Bool
}

class CgCallTarget {
    has $.sig: CgSig
    has $.args: ExprList
}

enum CgEnv {
    CgEnvNil
    CgEnvCons($head: CgVar, $tail: CgEnv)
    CgEnvSub($sig: CgSig, $tail: CgEnv)
    CgEnvEnum($info: CgEnumInfo, $tail: CgEnv)
    CgEnvClass($info: CgClassInfo, $tail: CgEnv)
    CgEnvSubIdx($idx: CgSubIdx, $tail: CgEnv)
}

# P8d-2c-0: indexed sub-signature lookup. Profiling gen1 self-compile
# (2026-07-14) showed the interpreted compiler spending over half its wall time
# scanning the ~1700-cell CgEnvSub suffix: cg_env_lookup_sub walked ~850 cells
# per hit, and every enum/class/len/binding walker paid for the interleaved sub
# cells too. cg_env_index_subs rebuilds a COLLECTED sig env as one CgEnvSubIdx
# head followed by the non-sub cells: `dispatch` maps each sub name to its
# bucket (first occurrence wins, preserving most-recent-first shadowing),
# `tree` reaches the fixed-size bucket chains in O(log n), and `flat` keeps the
# extracted sub cells in original order for the prefix/suffix SCAN walkers
# (generic spec resolution) that are not name-keyed. Purely a compile-time data
# structure: emitted C is byte-identical.
enum CgSigTree {
    CgSigLeaf($subs: CgEnv)
    CgSigNode($left: CgSigTree, $right: CgSigTree, $lcount: Int)
}

class CgSubIdx {
    has $.dispatch: Map[Str, Int]
    has $.flat: CgEnv
    has $.tree: CgSigTree
}

class CgEnvSplit {
    has $.subs: CgEnv
    has $.rest: CgEnv
}

class CgSubChunk {
    has $.chunk: CgEnv
    has $.rest: CgEnv
}

# Partition an env into its CgEnvSub cells and everything else, both in
# original order (sub lookup order and enum/class lookup order are preserved).
sub cg_sidx_split($env: CgEnv): CgEnvSplit {
    match $env {
        CgEnvNil { CgEnvSplit(subs: CgEnvNil, rest: CgEnvNil) }
        CgEnvCons($h, $t) {
            $s = cg_sidx_split($t)
            CgEnvSplit(subs: $s.subs, rest: CgEnvCons($h, $s.rest))
        }
        CgEnvSub($sig, $t) {
            $s = cg_sidx_split($t)
            CgEnvSplit(subs: CgEnvSub($sig, $s.subs), rest: $s.rest)
        }
        CgEnvEnum($e, $t) {
            $s = cg_sidx_split($t)
            CgEnvSplit(subs: $s.subs, rest: CgEnvEnum($e, $s.rest))
        }
        CgEnvClass($c, $t) {
            $s = cg_sidx_split($t)
            CgEnvSplit(subs: $s.subs, rest: CgEnvClass($c, $s.rest))
        }
        CgEnvSubIdx($i, $t) {
            # Already-indexed tails keep their node; re-indexing pulls only the
            # bare cells above it (lookup stays correct via the fallback arms).
            $s = cg_sidx_split($t)
            CgEnvSplit(subs: $s.subs, rest: CgEnvSubIdx($i, $s.rest))
        }
    }
}

sub cg_sidx_sub_count($subs: CgEnv): Int {
    match $subs {
        CgEnvSub($s, $t) { 1 + cg_sidx_sub_count($t) }
        _ { 0 }
    }
}

# First $n sub cells of a sub-only chain (order kept) plus the remainder.
sub cg_sidx_take($subs: CgEnv, $n: Int): CgSubChunk {
    if $n <= 0 {
        CgSubChunk(chunk: CgEnvNil, rest: $subs)
    } else {
        match $subs {
            CgEnvSub($sig, $t) {
                $c = cg_sidx_take($t, $n - 1)
                CgSubChunk(chunk: CgEnvSub($sig, $c.chunk), rest: $c.rest)
            }
            _ { CgSubChunk(chunk: CgEnvNil, rest: CgEnvNil) }
        }
    }
}

# Balanced pair tree over ceil(count/32) fixed-size bucket chains; bucket i
# (left-to-right leaf order) holds sub cells 32i..32i+31 in original order.
sub cg_sidx_tree($subs: CgEnv, $nbuckets: Int): CgSigTree {
    if $nbuckets <= 1 {
        CgSigLeaf($subs)
    } else {
        $lb = $nbuckets / 2
        $c = cg_sidx_take($subs, $lb * 32)
        CgSigNode(cg_sidx_tree($c.chunk, $lb), cg_sidx_tree($c.rest, $nbuckets - $lb), $lb)
    }
}

# name -> bucket index; set-if-absent while walking head-first preserves the
# chain's first-match-wins shadowing for duplicate names. The conditional lives
# in its own sub because a Map-valued `if` is only lowerable in tail position.
sub sidx_dispatch_step($name: Str, %m: Map[Str, Int], $b: Int): Map[Str, Int] {
    if has_key(%m, $name) {
        %m
    } else {
        %m.set($name, $b)
    }
}

sub cg_sidx_dispatch($subs: CgEnv, %m: Map[Str, Int], $i: Int): Map[Str, Int] {
    match $subs {
        CgEnvSub($sig, $t) { cg_sidx_dispatch($t, sidx_dispatch_step($sig.name, %m, $i / 32), $i + 1) }
        _ { %m }
    }
}

sub cg_sidx_pick($t: CgSigTree, $i: Int): CgEnv {
    match $t {
        CgSigLeaf($subs) { $subs }
        CgSigNode($l, $r, $lc) {
            if $i < $lc { cg_sidx_pick($l, $i) } else { cg_sidx_pick($r, $i - $lc) }
        }
    }
}

# Index a freshly collected sig env. Small envs (corpus programs) stay flat:
# the index only pays for itself once the sub chain is long.
sub cg_env_index_subs($env: CgEnv): CgEnv {
    $s = cg_sidx_split($env)
    $n = cg_sidx_sub_count($s.subs)
    if $n < 64 {
        $env
    } else {
        %d0 = {}
        $idx = CgSubIdx(
            dispatch: cg_sidx_dispatch($s.subs, %d0, 0),
            flat: $s.subs,
            tree: cg_sidx_tree($s.subs, ($n + 31) / 32)
        )
        CgEnvSubIdx($idx, $s.rest)
    }
}

# Result of lowering a binding statement: the updated state plus the environment
# extended (fresh binding) or unchanged (reassignment of an existing local).
class BindOut {
    has $.state: CgState
    has $.env: CgEnv
}

# P5b-2b / P9-5d: the resolved receiver of a map `set`/`remove` copy loop. A
# DIRECT map binding/field resolves to a borrowed CgVar with the incoming
# `state` unchanged and an empty `release`. A CHAINED receiver
# (`%m.set(...).remove(...)` — the receiver is itself a set/remove call) OR a
# FRESH map literal (`{ "a": 1 }.set("c", 3)`) is materialized into an OWNED
# guji_map_t temp; `state` carries that materialization and `release` frees the
# temp's two arrays AFTER the copy loop has retained the slots it keeps (native
# materializes the receiver value, copies with retains, then releases it).
class SetRemoveRecv {
    has $.var: CgVar
    has $.state: CgState
    has $.release: Str
}

# P3b-2b-2b: a hoisted left-spine `?` inside a final carrier-constructor
# argument. `expr` is the argument with the question subexpression replaced by
# a synthetic scalar local (bound in `env`; its carrier guard/early-return is
# already emitted into `state`).
class QHoistOut {
    has $.expr: Expr
    has $.state: CgState
    has $.env: CgEnv
}

# P3b-2b-2c-2: the rebuilt ARGUMENT LIST after a `?` was hoisted out of one call
# argument (`f(x?)` → synthetic bind + `f(<name>)`), threaded with the hoist
# state/env. Mirrors QHoistOut but carries an ExprList instead of a single Expr.
class ArgHoistOut {
    has $.args: ExprList
    has $.state: CgState
    has $.env: CgEnv
}

# C08d: the rebuilt MAP ENTRY LIST after one evaluation-order step.  Unlike a
# plain argument list, a map must preserve key-then-value order for every entry,
# so the walker may first replace an effectful key with an owned synthetic Str
# binding before it reaches the entry's question-bearing value.
class MapHoistOut {
    has $.items: MapEntryList
    has $.state: CgState
    has $.env: CgEnv
}

# Most-recent-binding-wins lookup of a binding name in the codegen environment.
sub cg_env_lookup($env: CgEnv, $name: Str): Option[CgVar] {
    match $env {
        CgEnvNil { None }
        CgEnvCons($h, $t) {
            if $h.name == $name { Some($h) } else { cg_env_lookup($t, $name) }
        }
        CgEnvSub($s, $t) { cg_env_lookup($t, $name) }
        CgEnvEnum($e, $t) { cg_env_lookup($t, $name) }
        CgEnvClass($c, $t) { cg_env_lookup($t, $name) }
        CgEnvSubIdx($i, $t) { cg_env_lookup($t, $name) }
    }
}

# Lookup restricted to the CURRENT frame: the innermost `$n_local` value bindings
# (CgEnvCons cells). Used by §4 bind lowering so a child-scope `$x = …` can
# shadow an outer immutable while same-frame reassignment of that name panics.
# Non-value cells (subs/enums/classes) are skipped without consuming `$n_local`.
sub cg_env_lookup_in_frame($env: CgEnv, $name: Str, $n_local: Int): Option[CgVar] {
    if $n_local <= 0 {
        None
    } else {
        match $env {
            CgEnvNil { None }
            CgEnvCons($h, $t) {
                if $h.name == $name {
                    Some($h)
                } else {
                    cg_env_lookup_in_frame($t, $name, $n_local - 1)
                }
            }
            CgEnvSub($s, $t) { cg_env_lookup_in_frame($t, $name, $n_local) }
            CgEnvEnum($e, $t) { cg_env_lookup_in_frame($t, $name, $n_local) }
            CgEnvClass($c, $t) { cg_env_lookup_in_frame($t, $name, $n_local) }
            CgEnvSubIdx($i, $t) { cg_env_lookup_in_frame($t, $name, $n_local) }
        }
    }
}

# Resolve an enum type name to its codegen info (variant table). Enum infos are
# collected at the BASE of the codegen environment, so every body lowering can
# reach them.
sub cg_env_lookup_enum($env: CgEnv, $name: Str): Option[CgEnumInfo] {
    match $env {
        CgEnvNil { None }
        CgEnvCons($h, $t) { cg_env_lookup_enum($t, $name) }
        CgEnvSub($s, $t) { cg_env_lookup_enum($t, $name) }
        CgEnvEnum($e, $t) { if $e.name == $name { Some($e) } else { cg_env_lookup_enum($t, $name) } }
        CgEnvClass($c, $t) { cg_env_lookup_enum($t, $name) }
        CgEnvSubIdx($i, $t) { cg_env_lookup_enum($t, $name) }
    }
}

sub cg_env_lookup_class($env: CgEnv, $name: Str): Option[CgClassInfo] {
    match $env {
        CgEnvNil { if $name == "Proc" { Some(g_proc_class_info()) } else { None } }
        CgEnvCons($h, $t) { cg_env_lookup_class($t, $name) }
        CgEnvSub($s, $t) { cg_env_lookup_class($t, $name) }
        CgEnvEnum($e, $t) { cg_env_lookup_class($t, $name) }
        CgEnvClass($c, $t) { if $c.name == $name { Some($c) } else { cg_env_lookup_class($t, $name) } }
        CgEnvSubIdx($i, $t) { cg_env_lookup_class($t, $name) }
    }
}

sub g_proc_class_info(): CgClassInfo {
    CgClassInfo(
        name: "Proc",
        fields: CgClassFieldCons(
            CgClassField(name: "exit_code", kind: CgInt, index: 0, boxcarrier: false, public: true, sigil: "$"),
            CgClassFieldCons(
                CgClassField(name: "stdout", kind: CgStr, index: 1, boxcarrier: false, public: true, sigil: "$"),
                CgClassFieldCons(CgClassField(name: "stderr", kind: CgStr, index: 2, boxcarrier: false, public: true, sigil: "$"), CgClassFieldNil)
            )
        )
    )
}

sub g_proc_typedefs(): Str {
    "typedef struct Proc Proc;\n" ~
    "struct Proc \{\n" ~
    "\tint64_t f0;\n" ~
    "\tconst char* f1;\n" ~
    "\tconst char* f2;\n" ~
    "};\n\n" ~
    "static void guji_release_Proc_fields(Proc* p) \{\n" ~
    "\tguji_release(p->f1);\n" ~
    "\tp->f1 = NULL;\n" ~
    "\tguji_release(p->f2);\n" ~
    "\tp->f2 = NULL;\n" ~
    "}\n\n" ~
    "static void guji_retain_Proc_fields(Proc* p) \{\n" ~
    "\tguji_retain(p->f1);\n" ~
    "\tguji_retain(p->f2);\n" ~
    "}\n\n" ~
    "typedef struct \{\n" ~
    "\tint64_t tag;\n" ~
    "\tProc ok;\n" ~
    "\tconst char* err;\n" ~
    "} guji_res_Proc_str;\n\n"
}

# The 0-based declaration index (= native tag) of a variant within an enum.
sub cg_enum_variant_tag($vs: CgVariantInfoList, $name: Str, $i: Int): Option[Int] {
    match $vs {
        CgVarNil { None }
        CgVarCons($v, $rest) { if $v.name == $name { Some($i) } else { cg_enum_variant_tag($rest, $name, $i + 1) } }
    }
}

# The variant record for a name (for field-arity checks).
sub cg_enum_variant_lookup($vs: CgVariantInfoList, $name: Str): Option[CgVariant] {
    match $vs {
        CgVarNil { None }
        CgVarCons($v, $rest) { if $v.name == $name { Some($v) } else { cg_enum_variant_lookup($rest, $name) } }
    }
}

# Resolve a bare sub name to its signature (sub names carry no sigil, so they
# never collide with binding names, which always do). Used by ECall lowering.
sub cg_env_lookup_sub($env: CgEnv, $name: Str): Option[CgSig] {
    match $env {
        CgEnvNil { None }
        CgEnvCons($h, $t) { cg_env_lookup_sub($t, $name) }
        CgEnvSub($s, $t) {
            if $s.name == $name { Some($s) } else { cg_env_lookup_sub($t, $name) }
        }
        CgEnvEnum($e, $t) { cg_env_lookup_sub($t, $name) }
        CgEnvClass($c, $t) { cg_env_lookup_sub($t, $name) }
        CgEnvSubIdx($i, $t) {
            %d = $i.dispatch
            if has_key(%d, $name) {
                $b = %d{$name}
                match cg_env_lookup_sub(cg_sidx_pick($i.tree, $b), $name) {
                    Some($s) { Some($s) }
                    None { cg_env_lookup_sub($t, $name) }
                }
            } else {
                cg_env_lookup_sub($t, $name)
            }
        }
    }
}

sub cg_env_append($left: CgEnv, $right: CgEnv): CgEnv {
    match $left {
        CgEnvNil { $right }
        CgEnvCons($h, $t) { CgEnvCons($h, cg_env_append($t, $right)) }
        CgEnvSub($s, $t) { CgEnvSub($s, cg_env_append($t, $right)) }
        CgEnvEnum($e, $t) { CgEnvEnum($e, cg_env_append($t, $right)) }
        CgEnvClass($c, $t) { CgEnvClass($c, cg_env_append($t, $right)) }
        CgEnvSubIdx($i, $t) { CgEnvSubIdx($i, cg_env_append($t, $right)) }
    }
}

sub cg_env_release_strs($env: CgEnv): Str {
    match $env {
        CgEnvNil { "" }
        CgEnvCons($h, $t) {
            $rest = cg_env_release_strs($t)
            match $h.kind {
                CgStr { if $h.borrowed { $rest } else { "\tguji_release(" ~ $h.cname ~ ");\n" ~ $rest } }
                CgOptStr { if $h.borrowed { $rest } else { g6_option_release(CgOptStr, $h.cname) ~ $rest } }
                CgOptCarrier($inner) { if $h.borrowed { $rest } else { g6_option_release(CgOptCarrier($inner), $h.cname) ~ $rest } }
                CgOptList($el) { if $h.borrowed { $rest } else { g6_option_release(CgOptList($el), $h.cname) ~ $rest } }
                CgOptMap($v) { if $h.borrowed { $rest } else { g6_option_release(CgOptMap($v), $h.cname) ~ $rest } }
                # An Option[class] local owns the active class payload exactly as
                # the enum/list/map carrier twins do. Omitting this arm leaked the
                # retained fields of a Some class at function exit (I6f).
                CgOptClass($n) { if $h.borrowed { $rest } else { g6_option_release(CgOptClass($n), $h.cname) ~ $rest } }
                # A held Option[E] carrier (e.g. `$held = $ch.recv()`) ADOPTS the
                # channel's detached message, and bound `$held.unwrap()` retains
                # its result exactly because this scope-exit release balances the
                # carrier's own +1 (P8d-2c-3c-13; before this arm every held
                # heap-payload enum carrier leaked — 3c-12's corpus only held a
                # scalar message). g4_lower_reassign already released on rebind.
                CgOptEnum($n) { if $h.borrowed { $rest } else { g6_option_release(CgOptEnum($n), $h.cname) ~ $rest } }
                CgOptMatch { if $h.borrowed { $rest } else { g6_option_release(CgOptMatch, $h.cname) ~ $rest } }
                CgMatch { if $h.borrowed { $rest } else { "\tguji_release((const void*)" ~ $h.cname ~ ");\n" ~ $rest } }
                CgOptBush { if $h.borrowed { $rest } else { g6_option_release(CgOptBush, $h.cname) ~ $rest } }
                CgBush { if $h.borrowed { $rest } else { "\tguji_release((const void*)" ~ $h.cname ~ ");\n" ~ $rest } }
                CgHandle { if $h.borrowed { $rest } else { "\tguji_release((const void*)" ~ $h.cname ~ ");\n" ~ $rest } }
                CgRes($ok, $err) { if $h.borrowed { $rest } else { g6_result_release($h.kind, $h.cname) ~ $rest } }
                CgEnum($n) { if $h.borrowed { $rest } else { g6e_enum_release($n, $h.cname) ~ $rest } }
                CgClass($n) { if $h.borrowed { $rest } else { g8_class_release($n, $h.cname) ~ $rest } }
                CgList($el) { if $h.borrowed { $rest } else { (if $h.listlen == 0 { g7_slice_release($h.cname) } else { g7_list_release($el, $h.cname) }) ~ $rest } }
                CgMap($v) { if $h.borrowed { $rest } else { g7_map_release($h.cname) ~ $rest } }
                CgFn($p, $r) { if $h.borrowed { $rest } else { "\tguji_release(" ~ $h.cname ~ ".env);\n" ~ $rest } }
                CgChan($el) { if $h.borrowed { $rest } else { "\tguji_chan_release(" ~ $h.cname ~ ");\n" ~ $rest } }
                _ { $rest }
            }
        }
        CgEnvSub($s, $t) { cg_env_release_strs($t) }
        CgEnvSubIdx($i, $t) { cg_env_release_strs($t) }
        CgEnvEnum($e, $t) { cg_env_release_strs($t) }
        CgEnvClass($c, $t) { cg_env_release_strs($t) }
    }
}

# Number of bindings currently in scope. Used to compute how many bindings a
# branch added on top of the outer environment, so branch-local Str locals can be
# released at branch exit without touching outer bindings.
sub cg_env_len($env: CgEnv): Int {
    match $env {
        CgEnvNil { 0 }
        CgEnvCons($h, $t) { 1 + cg_env_len($t) }
        CgEnvSub($s, $t) { cg_env_len($t) }
        CgEnvSubIdx($i, $t) { cg_env_len($t) }
        CgEnvEnum($e, $t) { cg_env_len($t) }
        CgEnvClass($c, $t) { cg_env_len($t) }
    }
}

# Release the Str locals among the FIRST `$n` (innermost) bindings of `$env`. A
# branch passes its end environment plus the count of bindings it introduced, so
# only the branch's own Str bindings are released — outer bindings are left for the
# function-level cleanup, and an untaken branch never assigns (so never releases)
# its locals (they stay GUJI_EMPTY_STR, a no-op release).
sub cg_env_release_strs_n($env: CgEnv, $n: Int): Str {
    if $n <= 0 {
        ""
    } else {
        match $env {
            CgEnvNil { "" }
            CgEnvCons($h, $t) {
                $rest = cg_env_release_strs_n($t, $n - 1)
                match $h.kind {
                    CgStr { if $h.borrowed { $rest } else { "\tguji_release(" ~ $h.cname ~ ");\n" ~ $rest } }
                    CgOptStr { if $h.borrowed { $rest } else { g6_option_release(CgOptStr, $h.cname) ~ $rest } }
                    CgOptCarrier($inner) { if $h.borrowed { $rest } else { g6_option_release(CgOptCarrier($inner), $h.cname) ~ $rest } }
                    CgOptList($el) { if $h.borrowed { $rest } else { g6_option_release(CgOptList($el), $h.cname) ~ $rest } }
                    CgOptMap($v) { if $h.borrowed { $rest } else { g6_option_release(CgOptMap($v), $h.cname) ~ $rest } }
                    # Branch-local Option[class] values own their Some payload too.
                    CgOptClass($n) { if $h.borrowed { $rest } else { g6_option_release(CgOptClass($n), $h.cname) ~ $rest } }
                    # Held Option[E] carriers own their adopted payload; release
                    # branch-scoped ones too (see cg_env_release_strs).
                    CgOptEnum($n) { if $h.borrowed { $rest } else { g6_option_release(CgOptEnum($n), $h.cname) ~ $rest } }
                    CgOptMatch { if $h.borrowed { $rest } else { g6_option_release(CgOptMatch, $h.cname) ~ $rest } }
                    CgMatch { if $h.borrowed { $rest } else { "\tguji_release((const void*)" ~ $h.cname ~ ");\n" ~ $rest } }
                    CgOptBush { if $h.borrowed { $rest } else { g6_option_release(CgOptBush, $h.cname) ~ $rest } }
                    CgBush { if $h.borrowed { $rest } else { "\tguji_release((const void*)" ~ $h.cname ~ ");\n" ~ $rest } }
                    CgHandle { if $h.borrowed { $rest } else { "\tguji_release((const void*)" ~ $h.cname ~ ");\n" ~ $rest } }
                    CgRes($ok, $err) { if $h.borrowed { $rest } else { g6_result_release($h.kind, $h.cname) ~ $rest } }
                    CgEnum($n) { if $h.borrowed { $rest } else { g6e_enum_release($n, $h.cname) ~ $rest } }
                    CgClass($n) { if $h.borrowed { $rest } else { g8_class_release($n, $h.cname) ~ $rest } }
                    CgList($el) { if $h.borrowed { $rest } else { (if $h.listlen == 0 { g7_slice_release($h.cname) } else { g7_list_release($el, $h.cname) }) ~ $rest } }
                    CgMap($v) { if $h.borrowed { $rest } else { g7_map_release($h.cname) ~ $rest } }
                    CgFn($p, $r) { if $h.borrowed { $rest } else { "\tguji_release(" ~ $h.cname ~ ".env);\n" ~ $rest } }
                    CgChan($el) { if $h.borrowed { $rest } else { "\tguji_chan_release(" ~ $h.cname ~ ");\n" ~ $rest } }
                    _ { $rest }
                }
            }
            CgEnvSub($s, $t) { cg_env_release_strs_n($t, $n) }
            CgEnvSubIdx($i, $t) { cg_env_release_strs_n($t, $n) }
            CgEnvEnum($e, $t) { cg_env_release_strs_n($t, $n) }
            CgEnvClass($c, $t) { cg_env_release_strs_n($t, $n) }
        }
    }
}

sub mainout_with_cleanup($out: MainOut, $env: CgEnv): MainOut {
    MainOut(
        interns: $out.interns,
        decls: $out.decls,
        body: $out.body ~ cg_env_release_strs($env),
        ret: $out.ret,
        nstr: $out.nstr
    )
}

# Locate the top-level `main` sub in a decl list.
sub g1_find_main($decls: DeclList): Option[SubDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($head, $tail) {
            match $head {
                DImport($i) { g1_find_main($tail) }
                DSub($sub) {
                    if $sub.name == "main" { Some($sub) } else { g1_find_main($tail) }
                }
                DClass($c) { g1_find_main($tail) }
                DEnum($e) { g1_find_main($tail) }
                DGrammar($g) { g1_find_main($tail) }
            }
        }
    }
}

# Map an Int binary operator lexeme to its runtime helper (§5.1). `None` => the
# operator is not Int arithmetic (comparison/logical/concat etc.), which is out
# of the Int-rvalue subset.
sub g3_int_binop_fn($op: Str): Option[Str] {
    if $op == "+" {
        Some("guji_add")
    } else if $op == "-" {
        Some("guji_sub")
    } else if $op == "*" {
        Some("guji_mul")
    } else if $op == "/" {
        Some("guji_div")
    } else if $op == "%" {
        Some("guji_mod")
    } else if $op == "**" {
        Some("guji_pow")
    } else {
        None
    }
}

# ---- G5: call-argument lowering -------------------------------------------
# A bound function value is already a stable C pair. Other function-valued
# arguments need the stateful ownership paths below.
sub g5_lower_bound_fn_arg($want: CgKind, $a: Expr, $env: CgEnv): Result[Str, Str] {
    match $a {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) { if cgkind_eq($v.kind, $want) { Ok($v.cname) } else { Err(g3_unsupported()) } }
                None { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# A direct panic/exit argument is Never and therefore fits every parameter kind.
# Native emits the diverging call, substitutes the kind's zero sentinel in the
# unreachable call expression, and keeps lowering the call for valid C.
sub g5_lower_one_arg_state($pk: CgKind, $a: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $a {
        ECall($c, $args) {
            match g4_panic_value($pk, $c, $args, $state, $env) {
                Ok($nv) { Ok(CgArgsOut(state: $nv.state, args: $nv.c, releases: "")) }
                Err($not_never) { g5_lower_one_arg_state_nonnever($pk, $a, $state, $env) }
            }
        }
        _ { g5_lower_one_arg_state_nonnever($pk, $a, $state, $env) }
    }
}

sub g5_lower_one_arg_state_nonnever($pk: CgKind, $a: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $pk {
        CgInt {
            match g3_int_rvalue_state($a, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(CgArgsOut(state: $v.state, args: $v.c, releases: "")) }
            }
        }
        CgFloat {
            match g3b_float_rvalue_state($a, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(CgArgsOut(state: $v.state, args: $v.c, releases: "")) }
            }
        }
        CgBool {
            match g4_bool_lower($a, $state, $env) {
                Err($m) { Err($m) }
                Ok($b) { Ok(CgArgsOut(state: $b.state, args: $b.c, releases: "")) }
            }
        }
        CgStr {
            match g3_str_lower($a, $state, $env) {
                Err($m) { Err($m) }
                Ok($sl) { Ok(CgArgsOut(state: $sl.state, args: $sl.tmp, releases: "\tguji_release(" ~ $sl.tmp ~ ");\n")) }
            }
        }
        # A Match callback parameter borrows the per-iteration match object. Its
        # owner is the regex replacement loop, which releases it only after the
        # callback has returned its independently owned Str result.
        CgMatch {
            match g6_match_value($a, $state, $env) {
                Err($m) { Err($m) }
                Ok($mv) { Ok(CgArgsOut(state: $mv.state, args: $mv.c, releases: "")) }
            }
        }
        # Bush parameters borrow the caller's pointer (no retain); the callee must
        # retain only when returning/escaping the borrowed Bush.
        CgBush {
            match g10_bush_value($a, $state, $env) {
                Err($m) { Err($m) }
                Ok($bv) { Ok(CgArgsOut(state: $bv.state, args: $bv.c, releases: "")) }
            }
        }
        CgOptInt { g5_lower_one_opt_arg(CgOptInt, $a, $state, $env) }
        CgOptFloat { g5_lower_one_opt_arg(CgOptFloat, $a, $state, $env) }
        CgOptBool { g5_lower_one_opt_arg(CgOptBool, $a, $state, $env) }
        CgOptStr { g5_lower_one_opt_arg(CgOptStr, $a, $state, $env) }
        CgOptClass($n) { g5_lower_one_opt_arg(CgOptClass($n), $a, $state, $env) }
        CgOptEnum($n) { g5_lower_one_opt_arg(CgOptEnum($n), $a, $state, $env) }
        CgOptList($el) { g5_lower_one_opt_arg(CgOptList($el), $a, $state, $env) }
        CgOptMap($v) { g5_lower_one_opt_arg(CgOptMap($v), $a, $state, $env) }
        CgOptMatch { g5_lower_one_opt_arg(CgOptMatch, $a, $state, $env) }
        CgOptBush { g5_lower_one_opt_arg(CgOptBush, $a, $state, $env) }
        CgRes($ok, $err) { g5_lower_one_result_arg($pk, $a, $state, $env) }
        CgEnum($n) { g5_lower_one_enum_arg($n, $a, $state, $env) }
        CgClass($n) { g8_lower_one_class_arg($n, $a, $state, $env) }
        CgList($el) { g7_lower_one_list_arg($el, $a, $state, $env) }
        CgMap($v) { g7_lower_one_map_arg($v, $a, $state, $env) }
        # §17.2 channel arguments hand the callee a +1 handle: a bound source
        # retains at the call site (native `gf(guji_chan_retain(gv), ...)`) and
        # a fresh builder transfers its own +1. The callee's scope-exit release
        # consumes it, so there is no caller-side post-call release.
        CgChan($cel) {
            match g11_chan_value(CgChan($cel), $a, $state, $env) {
                Err($m) { Err($m) }
                Ok($cv) { Ok(CgArgsOut(state: $cv.state, args: $cv.c, releases: "")) }
            }
        }
        CgFn($p, $r) {
            match g5_lower_bound_fn_arg($pk, $a, $env) {
                Err($m) {
                    match $a {
                        ELambda($params, $ret, $body, $topic) {
                            match g5_resolve_lambda_ann($params, $ret, $body, $env) {
                                Ok($ann) {
                                    if cgkind_list_eq($p, $ann.pk) && cg_ret_eq($r, $ann.rk) {
                                        match g5_emit_lambda_value_ann($ann, $body, $state, $env) {
                                            Err($lm) { Err($lm) }
                                            Ok($fv) {
                                                Ok(CgArgsOut(
                                                    state: $fv.state,
                                                    args: $fv.c,
                                                    releases: "\tguji_release(" ~ $fv.c ~ ".env);\n"
                                                ))
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                Err($am) {
                                    # I4c: expected Func shape supplies kinds for a bare topic block.
                                    match g5_lambda_ann_from_fn_kind($params, $p, $r) {
                                        Err($fm) { Err($m) }
                                        Ok($ann) {
                                            match g5_emit_lambda_value_ann($ann, $body, $state, $env) {
                                                Err($lm) { Err($lm) }
                                                Ok($fv) {
                                                    Ok(CgArgsOut(
                                                        state: $fv.state,
                                                        args: $fv.c,
                                                        releases: "\tguji_release(" ~ $fv.c ~ ".env);\n"
                                                    ))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        # I4d2: a freshly returned closure used directly as a
                        # Func argument (`apply(make_adder(5), 6)`). Lower the
                        # RFn call into an owned guji_fn_t temp; the callee
                        # borrows, so release the env after the call returns.
                        ECall($cc, $ca) {
                            match g4_lower_value(CgFn($p, $r), $a, $state, $env) {
                                Err($lm) { Err($lm) }
                                Ok($fv) {
                                    Ok(CgArgsOut(
                                        state: $fv.state,
                                        args: $fv.c,
                                        releases: "\tguji_release(" ~ $fv.c ~ ".env);\n"
                                    ))
                                }
                            }
                        }
                        _ {
                            # A function-valued if/match argument is normalized
                            # to an owned pair by its branch lowerer. The callee
                            # borrows it for the duration of the call.
                            match g5_fn_arg_kind($a, $env) {
                                Err($fm) { Err($m) }
                                Ok($actual) {
                                    if cgkind_eq($actual, CgFn($p, $r)) && g5_fn_init_fresh($a) {
                                        match g4_lower_value(CgFn($p, $r), $a, $state, $env) {
                                            Err($lm) { Err($lm) }
                                            Ok($fv) {
                                                Ok(CgArgsOut(
                                                    state: $fv.state,
                                                    args: $fv.c,
                                                    releases: "\tguji_release(" ~ $fv.c ~ ".env);\n"
                                                ))
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                    }
                }
                Ok($c) { Ok(CgArgsOut(state: $state, args: $c, releases: "")) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower one user-enum argument under the borrowed by-value ABI. A bound enum local
# lowers to its C name directly (NO retain, unlike the copy-into-a-binding path);
# the binding owner still releases it. A freshly constructed enum with a possible
# Str payload is materialised into a caller-owned temp and released after the call,
# exactly like Option[Str]/Result[..., Str] arguments.
sub g5_lower_one_enum_arg($n: Str, $a: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $a {
        EName($vn) {
            match cg_env_lookup($env, $vn) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgEnum($en2) {
                            if $en2 == $n { Ok(CgArgsOut(state: $state, args: $var.cname, releases: "")) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ {
            match g6e_enum_value($n, $a, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) {
                    match cg_env_lookup_enum($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($info) {
                            if g6e_enum_has_heap($info) {
                                $tmp = g4_value_tmp(CgEnum($n), $v.state.ntmp)
                                Ok(CgArgsOut(
                                    state: CgState(
                                        interns: $v.state.interns,
                                        decls: $v.state.decls ~ g4_value_decl(CgEnum($n), $tmp),
                                        body: $v.state.body ~ "\t" ~ $tmp ~ " = " ~ $v.c ~ ";\n",
                                        nstr: $v.state.nstr,
                                        ntmp: $v.state.ntmp + 1
                                    ),
                                    args: $tmp,
                                    releases: g6e_enum_release($n, $tmp)
                                ))
                            } else {
                                Ok(CgArgsOut(state: $v.state, args: $v.c, releases: ""))
                            }
                        }
                    }
                }
            }
        }
    }
}

# True for the Option carriers whose Some payload owns heap data: Option[Str]
# (an owned `const char*`) and the per-type user carriers Option[<class>] /
# Option[<enum>] (slice 5 E5d-7c-2d-9). A heap-carrying argument is materialised
# into a caller-owned temp and released after the call (the callee borrows it);
# scalar carriers (Int/Float/Bool) have no payload and pass by value directly.
sub g6_option_arg_needs_temp($pk: CgKind): Bool {
    match $pk {
        CgOptStr { true }
        CgOptClass($n) { true }
        CgOptEnum($n) { true }
        CgOptList($el) { true }
        CgOptMap($v) { true }
        CgOptMatch { true }
        CgOptBush { true }
        _ { false }
    }
}

# Lower one Option argument to a by-value carrier rvalue. Scalar carriers have no
# heap payload, so they pass directly. Heap-carrying carriers (Option[Str] and the
# user Option[<class>]/Option[<enum>] carriers) are materialised into a temp and
# released after the call, matching the native borrowed-parameter ABI: the value
# from g6_option_value already owns its payload (a fresh Some/None literal, or a
# field read that retains the copied carrier), so the caller drops it once the
# borrowing callee returns. The tag-guarded g6_option_release is a no-op when the
# active payload has no owned fields.
sub g5_lower_one_opt_arg($pk: CgKind, $a: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match g6_option_value($pk, $a, $state, $env) {
        Err($m) { Err($m) }
        Ok($ov) {
            if g6_option_arg_needs_temp($pk) {
                $tmp = g4_value_tmp($pk, $ov.state.ntmp)
                Ok(CgArgsOut(
                    state: CgState(
                        interns: $ov.state.interns,
                        decls: $ov.state.decls ~ g4_value_decl($pk, $tmp),
                        body: $ov.state.body ~ "\t" ~ $tmp ~ " = " ~ $ov.c ~ ";\n",
                        nstr: $ov.state.nstr,
                        ntmp: $ov.state.ntmp + 1
                    ),
                    args: $tmp,
                    releases: g6_option_release($pk, $tmp)
                ))
            } else {
                Ok(CgArgsOut(state: $ov.state, args: $ov.c, releases: ""))
            }
        }
    }
}

# Lower one Result argument. Scalar-only carriers are plain by-value. If either
# active slot may be Str, materialise into a temp and release it after the call;
# parameters borrow the carrier payloads just like Str and Option[Str] params.
sub g5_lower_one_result_arg($pk: CgKind, $a: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match g6_result_value($pk, $a, $state, $env) {
        Err($m) { Err($m) }
        Ok($rv) {
            if g6_result_has_str($pk) {
                $tmp = g4_value_tmp($pk, $rv.state.ntmp)
                Ok(CgArgsOut(
                    state: CgState(
                        interns: $rv.state.interns,
                        decls: $rv.state.decls ~ g4_value_decl($pk, $tmp),
                        body: $rv.state.body ~ "\t" ~ $tmp ~ " = " ~ $rv.c ~ ";\n",
                        nstr: $rv.state.nstr,
                        ntmp: $rv.state.ntmp + 1
                    ),
                    args: $tmp,
                    releases: g6_result_release($pk, $tmp)
                ))
            } else {
                Ok(CgArgsOut(state: $rv.state, args: $rv.c, releases: ""))
            }
        }
    }
}

# ---- G8a/G8b: class records (scalar/Str/List/Map/Option fields) -----------
# A class lowers to a by-value C struct whose fields are stored in declaration
# order as f0/f1/... . Scalar/Str fields came first; E4b adds scalar List
# fields as owned `guji_slice_t` handles, Map fields as owned `guji_map_t`
# handles, plus Option scalar/Str carriers. Wider Result fields stay E5+.
class CgClassCtorOut {
    has $.state: CgState
    has $.fields: Str
}

sub g8_class_field_supported($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        CgStr { true }
        # Nested List/Map fields compose through KIND-tagged ARR_SLICE/ARR_MAP
        # rows the same way enum collection payloads already do (I5g3).
        CgList($el) { g6e_enum_collection_elem_supported($el) }
        CgMap($v) { g6e_enum_collection_elem_supported($v) }
        CgOptInt { true }
        CgOptFloat { true }
        CgOptBool { true }
        CgOptStr { true }
        # An Option[<user class>] field (slice 5 E5d-7c-2d-5) wraps the by-value
        # class carrier; like a nested class field, admitting it commits to the
        # `guji_opt_<Class>` member, and the wrapped class's own typedef validates
        # its layout. A field naming Option of the SAME class is self-recursive and
        # is declined upstream in g8_class_field_kind (heap-boxing is later work).
        CgOptClass($n) { true }
        # An Option[<user enum>] field (slice 5 E5d-7c-2d-8) wraps the by-value
        # enum carrier; the wrapped enum's typedef emits the `guji_opt_<Enum>`
        # member type, and the class helper owns the active Some payload.
        CgOptEnum($n) { true }
        # I6f3: Result[Option[class], Str] is a by-value nested carrier.  The
        # wrapped class option and Result typedefs are emitted beside the wrapped
        # class, and the Holder field owns whichever Result arm is active.
        CgRes($ok, $err) {
            match $ok {
                CgOptClass($n) { cgkind_eq($err, CgStr) }
                _ { false }
            }
        }
        # A nested user-enum field is embedded BY VALUE (slice 5 E4b-2a); its own
        # layout is validated when ITS typedef is emitted, so admitting it here only
        # commits to a by-value struct member (mirrors g6e_field_supported).
        CgEnum($n) { true }
        # A nested user-CLASS field is embedded BY VALUE (slice 5 E4b-2c); like the
        # enum case, admitting it here only commits to a by-value struct member, and
        # the child class's own typedef validates its layout.
        CgClass($n) { true }
        # EB-1b: a cross-cycle-broken class field is a counted heap box (`struct
        # <T>*`), so admitting it commits to a pointer member; the wrapped type's own
        # typedef + drop helper validate/own the pointed-to layout (mirrors
        # g6e_field_supported's enum-variant box arms).
        CgBoxEnum($n) { true }
        CgBoxClass($n) { true }
        _ { false }
    }
}

# True when `$name` is the name of a user ENUM declared anywhere in `$decls`. A
# class field's type annotation may name a user enum (embedded BY VALUE, slice 5
# E4b-2a) rather than a nested CLASS (E4b-2c), and `g8_class_field_kind` has no
# codegen environment, so it classifies a non-builtin field-type name against the
# full decl list. `Option`/`Result`/`Map` are NOT user enums by name, so they fall
# through to the unsupported sentinel (the later E4b-2 slices).
sub decl_enum_named($decls: DeclList, $name: Str): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DEnum($e) { if $e.name == $name { true } else { decl_enum_named($t, $name) } }
                _ { decl_enum_named($t, $name) }
            }
        }
    }
}

# True when `$name` is the name of a user CLASS declared anywhere in `$decls`. A
# class field's type annotation may name ANOTHER user class (embedded BY VALUE,
# slice 5 E4b-2c) — the nested-class analogue of `decl_enum_named`. As with enum
# classification, the field kind is decided against the FULL decl list (no codegen
# environment is available here).
sub decl_class_named($decls: DeclList, $name: Str): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DClass($c) { if $c.name == $name { true } else { decl_class_named($t, $name) } }
                _ { decl_class_named($t, $name) }
            }
        }
    }
}

sub decl_user_type_named($decls: DeclList, $name: Str): Bool {
    decl_enum_named($decls, $name) || decl_class_named($decls, $name)
}

sub decl_type_name($decl: Decl): Option[Str] {
    match $decl {
        DEnum($e) { Some($e.name) }
        DClass($c) { Some($c.name) }
        _ { None }
    }
}

# True iff `$a` appears before `$b` in source order. EB-1 uses this only to make
# cross-cycle boxing deterministic: the earlier owner boxes its edge, the later
# owner keeps its by-value edge once the cycle has been broken.
sub decl_before($decls: DeclList, $a: Str, $b: Str): Bool {
    if $a == $b {
        false
    } else {
        match $decls {
            DeclNil { false }
            DeclCons($h, $t) {
                match decl_type_name($h) {
                    Some($n) {
                        if $n == $a { true }
                        else if $n == $b { false }
                        else { decl_before($t, $a, $b) }
                    }
                    None { decl_before($t, $a, $b) }
                }
            }
        }
    }
}

sub typeref_byvalue_user_name($tr: TypeRef, $decls: DeclList): Option[Str] {
    if $tr.name == "Option" {
        match typelist_at($tr.args, 0) {
            None { None }
            Some($elem) {
                if decl_user_type_named($decls, $elem.name) { Some($elem.name) } else { None }
            }
        }
    } else if decl_user_type_named($decls, $tr.name) {
        Some($tr.name)
    } else {
        None
    }
}

sub byvalue_typeref_reaches($ty: Option[TypeRef], $target: Str, $all: DeclList, $seen: StrList): Bool {
    match $ty {
        None { false }
        Some($tr) {
            match typeref_byvalue_user_name($tr, $all) {
                None { false }
                Some($n) { byvalue_type_reaches($n, $target, $all, $seen) }
            }
        }
    }
}

sub byvalue_params_reach($ps: ParamList, $target: Str, $all: DeclList, $seen: StrList): Bool {
    match $ps {
        ParamNil { false }
        ParamCons($h, $t) {
            if byvalue_typeref_reaches($h.ty, $target, $all, $seen) {
                true
            } else {
                byvalue_params_reach($t, $target, $all, $seen)
            }
        }
    }
}

sub byvalue_variants_reach($vs: VariantList, $target: Str, $all: DeclList, $seen: StrList): Bool {
    match $vs {
        VariantNil { false }
        VariantCons($h, $t) {
            if byvalue_params_reach($h.fields, $target, $all, $seen) {
                true
            } else {
                byvalue_variants_reach($t, $target, $all, $seen)
            }
        }
    }
}

sub byvalue_class_fields_reach($fs: ClassFieldList, $target: Str, $all: DeclList, $seen: StrList): Bool {
    match $fs {
        ClassFieldNil { false }
        ClassFieldCons($h, $t) {
            if byvalue_typeref_reaches($h.ty, $target, $all, $seen) {
                true
            } else {
                byvalue_class_fields_reach($t, $target, $all, $seen)
            }
        }
    }
}

sub byvalue_decl_reaches($decls: DeclList, $from: Str, $target: Str, $all: DeclList, $seen: StrList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DEnum($e) {
                    if $e.name == $from {
                        byvalue_variants_reach($e.variants, $target, $all, $seen)
                    } else {
                        byvalue_decl_reaches($t, $from, $target, $all, $seen)
                    }
                }
                DClass($c) {
                    if $c.name == $from {
                        byvalue_class_fields_reach($c.fields, $target, $all, $seen)
                    } else {
                        byvalue_decl_reaches($t, $from, $target, $all, $seen)
                    }
                }
                _ { byvalue_decl_reaches($t, $from, $target, $all, $seen) }
            }
        }
    }
}

sub byvalue_type_reaches($from: Str, $target: Str, $all: DeclList, $seen: StrList): Bool {
    if $from == $target {
        true
    } else if strlist_contains($seen, $from) {
        false
    } else {
        byvalue_decl_reaches($all, $from, $target, $all, StrCons($from, $seen))
    }
}

sub g6e_option_carrier_needs_box($owner: Str, $fk: CgKind, $all: DeclList): Bool {
    match $fk {
        CgOptClass($n) {
            if $n == $owner {
                true
            } else {
                decl_before($all, $owner, $n) && byvalue_type_reaches($n, $owner, $all, StrNil)
            }
        }
        CgOptEnum($n) {
            if $n == $owner {
                true
            } else {
                decl_before($all, $owner, $n) && byvalue_type_reaches($n, $owner, $all, StrNil)
            }
        }
        _ { false }
    }
}

# I6f3's class-field boundary is deliberately narrower than general Result type
# resolution: it admits the nested carrier whose Ok arm is Option[user class] and
# whose Err arm is Str.  Signature resolution already supports this shape through
# g6_result_kind_from_type; this decl-only twin is needed while class metadata is
# being collected, before a complete CgEnv exists.
sub g8_nested_result_field_kind($tr: TypeRef, $decls: DeclList): Result[CgKind, Str] {
    match typelist_at($tr.args, 0) {
        None { Err(g3_unsupported()) }
        Some($okt) {
            match typelist_at($tr.args, 1) {
                None { Err(g3_unsupported()) }
                Some($errt) {
                    if $okt.name == "Option" && $errt.name == "Str" {
                        match typelist_at($okt.args, 0) {
                            Some($elem) {
                                if decl_class_named($decls, $elem.name) {
                                    Ok(CgRes(CgOptClass($elem.name), CgStr))
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                            None { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

sub g8_class_field_kind($ty: Option[TypeRef], $decls: DeclList, $self: Str): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Int" {
                Ok(CgInt)
            } else if $tr.name == "Float" {
                Ok(CgFloat)
            } else if $tr.name == "Bool" {
                Ok(CgBool)
            } else if $tr.name == "Str" {
                Ok(CgStr)
            } else if $tr.name == "List" {
                match g7_kind_from_type_decls($tr, $decls) {
                    Ok($kind) { Ok($kind) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Map" {
                match g7_kind_from_type_decls($tr, $decls) {
                    Ok($kind) { Ok($kind) }
                    Err($m) { Err($m) }
                }
            } else if $tr.name == "Option" {
                # An `Option[<user class>]` field (slice 5 E5d-7c-2d-5) wraps the
                # by-value class carrier in a `guji_opt_<Class>` tagged struct. An
                # `Option[<user enum>]` field (slice 5 E5d-7c-2d-8) uses the same
                # per-enum `guji_opt_<Enum>` carrier already emitted for enum variant
                # fields. EB-1c keeps SAME-class/cross-cycle Option fields as the
                # same logical carrier kind; CgClassField.boxcarrier decides whether
                # this field stores the carrier by value or as a counted pointer box.
                # Other element types fall back to the scalar/Str Option resolver.
                match typelist_at($tr.args, 0) {
                    None { g6_option_kind_from_type($ty) }
                    Some($elem) {
                        if decl_class_named($decls, $elem.name) {
                            Ok(CgOptClass($elem.name))
                        } else if decl_enum_named($decls, $elem.name) {
                            Ok(CgOptEnum($elem.name))
                        } else {
                            g6_option_kind_from_type($ty)
                        }
                    }
                }
            } else if $tr.name == "Result" {
                g8_nested_result_field_kind($tr, $decls)
            } else if decl_enum_named($decls, $tr.name) {
                # A class field naming a user enum is embedded BY VALUE (slice 5
                # E4b-2a), reusing 4d's nested-enum carrier representation (the C
                # struct member is the child enum's own struct, retained/released by
                # recursing into its `guji_<op>_<Enum>_fields` helper). NATIVE rejects
                # enum class fields, so this is interp-oracle (COVERED-BEYOND) work.
                # EB-1b: a class field whose enum REACHES BACK to the declaring class
                # (and the class is declared FIRST) closes a cross-type by-value cycle
                # — an infinite-size C struct that no ordering can fix. Box that edge
                # (`struct <Enum>*` in `.fN`, the class analogue of EB-1a's enum->class
                # box) so the later enum embeds the now-complete class by value.
                if decl_before($decls, $self, $tr.name) && byvalue_type_reaches($tr.name, $self, $decls, StrNil) {
                    Ok(CgBoxEnum($tr.name))
                } else {
                    Ok(CgEnum($tr.name))
                }
            } else if decl_class_named($decls, $tr.name) {
                # A class field naming ANOTHER user class is embedded BY VALUE
                # (slice 5 E4b-2c), the class analogue of the by-value nested enum:
                # the C struct member is the child class's own struct, retained/
                # released by recursing into its `guji_<op>_<Class>_fields` helper. A
                # field naming the SAME class is SELF-RECURSIVE — an infinite inline
                # struct — so it must be heap-boxed (E4b-2c-box); decline it here
                # rather than emit an incomplete-type C struct. NATIVE rejects nested-
                # class fields, so this is interp-oracle (COVERED-BEYOND) work.
                # EB-1b: a class field whose other class REACHES BACK to the declaring
                # class (declared FIRST) closes a cross-type by-value cycle; box that
                # edge (`struct <Class>*`, like EB-1a) so exactly one edge per cycle is
                # a pointer. The reach predicate unwraps `Option[user]` carriers, so a
                # back-edge through `Option[<self>]` is detected and broken here.
                if $tr.name == $self {
                    Err(g3_unsupported())
                } else if decl_before($decls, $self, $tr.name) && byvalue_type_reaches($tr.name, $self, $decls, StrNil) {
                    Ok(CgBoxClass($tr.name))
                } else {
                    Ok(CgClass($tr.name))
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g8_class_fields_of($fs: ClassFieldList, $idx: Int, $decls: DeclList, $self: Str): Result[CgClassFieldInfoList, Str] {
    match $fs {
        ClassFieldNil { Ok(CgClassFieldNil) }
        ClassFieldCons($h, $t) {
            match g8_class_field_kind($h.ty, $decls, $self) {
                Err($m) { Err($m) }
                Ok($k) {
                    match g8_class_fields_of($t, $idx + 1, $decls, $self) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok(CgClassFieldCons(CgClassField(name: $h.name, kind: $k, index: $idx, boxcarrier: g6e_option_carrier_needs_box($self, $k, $decls), public: $h.public, sigil: $h.sigil), $rest)) }
                    }
                }
            }
        }
    }
}

# `$all` is the FULL decl list (for enum-name field classification); `$decls` is the
# walking suffix. They differ because an enum declared BEFORE a class would already be
# consumed from the suffix, so field classification must key off the whole program.
sub g8_collect_classes($decls: DeclList, $all: DeclList, $tail: CgEnv): CgEnv {
    match $decls {
        DeclNil { $tail }
        DeclCons($head, $rest) {
            match $head {
                DClass($c) {
                    match $c.tparams {
                        StrNil {
                            match g8_class_fields_of($c.fields, 0, $all, $c.name) {
                                Ok($fields) { CgEnvClass(CgClassInfo(name: $c.name, fields: $fields), g8_collect_classes($rest, $all, $tail)) }
                                Err($m) { g8_collect_classes($rest, $all, $tail) }
                            }
                        }
                        _ { g8_collect_classes($rest, $all, $tail) }
                    }
                }
                _ { g8_collect_classes($rest, $all, $tail) }
            }
        }
    }
}

sub g8_class_type_arg_tag($tr: TypeRef): Option[Str] {
    if g5g_type_is_bare($tr) && ($tr.name == "Int" || $tr.name == "Bool" || $tr.name == "Float" || $tr.name == "Str") {
        Some($tr.name)
    } else {
        None
    }
}

# Concrete-aware type-arg tag: like g8_class_type_arg_tag but also accepts a bare
# CONCRETE user enum/class name (`Color` -> tag "Color"), so a generic enum/class
# can be monomorphized AT a user type (`Box[Color]` -> Box__Color). Validated
# against the full decl list so a stray type-param name never leaks into a tag.
sub g8_class_type_arg_tag_c($tr: TypeRef, $all: DeclList): Option[Str] {
    match g8_class_type_arg_tag($tr) {
        Some($t) { Some($t) }
        None {
            if g5g_type_is_bare($tr) && decl_user_type_named($all, $tr.name) {
                Some($tr.name)
            } else {
                None
            }
        }
    }
}

# Spec-name tag for one substituted class field annotation. Class specs are
# keyed by flattened field types: List[Int] -> List_Int,
# Map[Str,List[Int]] -> Map_Str_List_Int, Option[Int] -> Option_Int.
# This is naming-only; type-argument binding is handled separately by the
# structural descriptor codec below.
sub g8_class_field_name_args($args: TypeList, $all: DeclList): Option[StrList] {
    match $args {
        TypeNil { Some(StrNil) }
        TypeCons($h, $t) {
            match g8_class_field_name_args($t, $all) {
                None { None }
                Some($rest) {
                    match g8_class_field_name_tag($h, $all) {
                        None { None }
                        Some($tag) { Some(StrCons($tag, $rest)) }
                    }
                }
            }
        }
    }
}

sub g8_class_field_name_tag($tr: TypeRef, $all: DeclList): Option[Str] {
    match g8_class_type_arg_tag_c($tr, $all) {
        Some($t) { Some($t) }
        None {
            match $tr.args {
                TypeNil { None }
                TypeCons($h, $t) {
                    match g8_class_field_name_args($tr.args, $all) {
                        None { None }
                        Some($parts) { Some($tr.name ~ "_" ~ strlist_join_underscore($parts)) }
                    }
                }
            }
        }
    }
}

# Naming twin of g8_class_field_tags_c using the field-name tag above; used
# ONLY to build a monomorphized class spec's `Name__Tags` key.
sub g8_class_field_tags_n($fs: ClassFieldList, $all: DeclList): Option[StrList] {
    match $fs {
        ClassFieldNil { Some(StrNil) }
        ClassFieldCons($h, $t) {
            match g8_class_field_tags_n($t, $all) {
                None { None }
                Some($rest) {
                    match $h.ty {
                        None { None }
                        Some($tr) {
                            match g8_class_field_name_tag($tr, $all) {
                                None { None }
                                Some($tag) { Some(StrCons($tag, $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_bind_class_type_args($tparams: StrList, $args: TypeList, $acc: G5gBinds, $all: DeclList): Option[G5gBinds] {
    match $tparams {
        StrNil {
            match $args {
                TypeNil { Some($acc) }
                TypeCons($h, $t) { None }
            }
        }
        StrCons($tp, $tprest) {
            match $args {
                TypeNil { None }
                TypeCons($arg, $argrest) {
                    match g8_type_binding_tag_c($arg, $all) {
                        None { None }
                        Some($tag) { g8_bind_class_type_args($tprest, $argrest, G5gBindCons($tp, $tag, $acc), $all) }
                    }
                }
            }
        }
    }
}

sub g8_subst_class_fields($fs: ClassFieldList, $tparams: StrList, $bs: G5gBinds): Option[ClassFieldList] {
    match $fs {
        ClassFieldNil { Some(ClassFieldNil) }
        ClassFieldCons($h, $t) {
            match g8_subst_class_fields($t, $tparams, $bs) {
                None { None }
                Some($rest) {
                    match $h.ty {
                        None { None }
                        Some($tr) {
                            match g5g_subst_typeref($tr, $tparams, $bs, false) {
                                None { None }
                                Some($subtr) {
                                    Some(ClassFieldCons(ClassField(public: $h.public, sigil: $h.sigil, name: $h.name, ty: Some($subtr)), $rest))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_class_field_tags($fs: ClassFieldList): Option[StrList] {
    match $fs {
        ClassFieldNil { Some(StrNil) }
        ClassFieldCons($h, $t) {
            match g8_class_field_tags($t) {
                None { None }
                Some($rest) {
                    match $h.ty {
                        None { None }
                        Some($tr) {
                            match g8_class_type_arg_tag($tr) {
                                None { None }
                                Some($tag) { Some(StrCons($tag, $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Concrete-aware twin used when building a monomorphized spec's NAME tags: accepts
# bare user enum/class type args (Box[Color] -> Box__Color) via g8_class_type_arg_tag_c.
sub g8_class_field_tags_c($fs: ClassFieldList, $all: DeclList): Option[StrList] {
    match $fs {
        ClassFieldNil { Some(StrNil) }
        ClassFieldCons($h, $t) {
            match g8_class_field_tags_c($t, $all) {
                None { None }
                Some($rest) {
                    match $h.ty {
                        None { None }
                        Some($tr) {
                            match g8_class_type_arg_tag_c($tr, $all) {
                                None { None }
                                Some($tag) { Some(StrCons($tag, $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# P5b-2d: clone a generic template's body subs into a monomorphized spec
# (native's cloneSubForClassSpec / its enum analogue). The `$self` receiver is
# unannotated (its CgClass/CgEnum kind comes from the owning spec's name in
# g5_build_class_sig / g5_build_enum_method_sig); every other param must carry
# an annotation the substitution understands. A body sub the substitution cannot
# express (unannotated non-self params) is DROPPED from the spec — a later call
# to it fails sig resolution and declines rc 4 honestly. Bare owning-template
# returns (`sub swapped($self): Pair`, `sub make($v: T): Box`) are kept for the
# post-expansion bare-return pass to rewrite or drop. Generic METHOD templates
# (their own `[U]`) are kept as templates (downstream sig collection/emission
# skip them via g5g_is_generic; per-call-site method monomorphization
# instantiates them), but the OWNER's type params ARE substituted into them first
# — see g8_clone_owner_generic_method below.
sub g8_subst_spec_params($params: ParamList, $tparams: StrList, $bs: G5gBinds): Option[ParamList] {
    match $params {
        ParamNil { Some(ParamNil) }
        ParamCons($p, $pt) {
            match g8_subst_spec_params($pt, $tparams, $bs) {
                None { None }
                Some($rest) {
                    match $p.ty {
                        None {
                            if $p.name == '$self' { Some(ParamCons($p, $rest)) } else { None }
                        }
                        Some($tr) {
                            match g5g_subst_typeref($tr, $tparams, $bs, false) {
                                None { None }
                                Some($st) { Some(ParamCons(Param(name: $p.name, ty: Some($st)), $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# P5b-2b(owner-methods): substitute the OWNER's type params into ONE annotation
# of a generic METHOD (its own tparams `[U]`) that is being cloned into a
# monomorphized owner spec. An owner tparam (in $owner_tps) resolves to its bound
# concrete tag; every other bare name — the method's own tparams like `U`, or a
# concrete type — passes through unchanged; compound types (`List[T]`) recurse so
# an owner param nested inside is still resolved. Unlike g5g_subst_typeref this is
# TOTAL (never None): the method's own tparams MUST survive for later per-call
# monomorphization. Mirrors native's cloneSubForClassSpec substituting the class's
# type params into a still-generic method while leaving the method's own free.
sub g8_subst_owner_typeref($tr: TypeRef, $owner_tps: StrList, $bs: G5gBinds): TypeRef {
    if g5g_type_is_bare($tr) && strlist_contains($owner_tps, $tr.name) {
        match g5g_binds_lookup($bs, $tr.name) {
            Some($tag) {
                match g8_type_from_binding_tag($tag) {
                    Some($bound) { $bound }
                    None { $tr }
                }
            }
            None { $tr }
        }
    } else {
        TypeRef(name: $tr.name, args: g8_subst_owner_typeargs($tr.args, $owner_tps, $bs))
    }
}

sub g8_subst_owner_typeargs($args: TypeList, $owner_tps: StrList, $bs: G5gBinds): TypeList {
    match $args {
        TypeNil { TypeNil }
        TypeCons($h, $t) { TypeCons(g8_subst_owner_typeref($h, $owner_tps, $bs), g8_subst_owner_typeargs($t, $owner_tps, $bs)) }
    }
}

sub g8_subst_owner_params($params: ParamList, $owner_tps: StrList, $bs: G5gBinds): ParamList {
    match $params {
        ParamNil { ParamNil }
        ParamCons($p, $pt) {
            $rest = g8_subst_owner_params($pt, $owner_tps, $bs)
            match $p.ty {
                None { ParamCons($p, $rest) }
                Some($tr) { ParamCons(Param(name: $p.name, ty: Some(g8_subst_owner_typeref($tr, $owner_tps, $bs))), $rest) }
            }
        }
    }
}

sub g8_subst_owner_ret($ret: Option[TypeRef], $owner_tps: StrList, $bs: G5gBinds): Option[TypeRef] {
    match $ret {
        None { None }
        Some($tr) { Some(g8_subst_owner_typeref($tr, $owner_tps, $bs)) }
    }
}

# Clone a still-generic method into an owner spec: substitute the owner's type
# params (T->Int) into its params/return, but KEEP the method's own tparams so it
# stays a template the per-call-site monomorphizer specializes on `U`. This
# reduces "generic method on a GENERIC owner" to the already-working "generic
# method on a NON-generic owner": after this, the cloned method's only free type
# params are its own, exactly like a method on a plain class.
sub g8_clone_owner_generic_method($sub: SubDecl, $owner_tps: StrList, $bs: G5gBinds): SubDecl {
    SubDecl(
        public: $sub.public,
        name: $sub.name,
        line: $sub.line,
        col: $sub.col,
        body_line: $sub.body_line,
        body_col: $sub.body_col,
        tparams: $sub.tparams,
        params: g8_subst_owner_params($sub.params, $owner_tps, $bs),
        ret: g8_subst_owner_ret($sub.ret, $owner_tps, $bs),
        body: $sub.body
    )
}

sub g8_keep_bare_template_return($all: DeclList, $tr: TypeRef): Bool {
    match $tr.args {
        TypeCons($a0, $at) { false }
        TypeNil {
            match g8_find_generic_enum_template($all, $tr.name) {
                Some($e) { true }
                None {
                    match g8_find_generic_class_template($all, $tr.name) {
                        Some($c) { true }
                        None { false }
                    }
                }
            }
        }
    }
}

sub g8_clone_spec_sub($sub: SubDecl, $tparams: StrList, $bs: G5gBinds, $all: DeclList): Option[SubDecl] {
    if g5g_is_generic($sub) {
        Some(g8_clone_owner_generic_method($sub, $tparams, $bs))
    } else {
        match g8_subst_spec_params($sub.params, $tparams, $bs) {
            None { None }
            Some($ps) {
                match $sub.ret {
                    None { Some(SubDecl(public: $sub.public, name: $sub.name, line: $sub.line, col: $sub.col, body_line: $sub.body_line, body_col: $sub.body_col, tparams: StrNil, params: $ps, ret: None, body: $sub.body)) }
                    Some($tr) {
                        match g5g_subst_typeref($tr, $tparams, $bs, true) {
                            None {
                                # A BARE owning-template return has no type args to
                                # substitute; keep it verbatim only for known generic
                                # class/enum templates. The post-expansion pass rewrites
                                # it to a concrete spec or drops the sub.
                                if g8_keep_bare_template_return($all, $tr) {
                                    Some(SubDecl(public: $sub.public, name: $sub.name, line: $sub.line, col: $sub.col, body_line: $sub.body_line, body_col: $sub.body_col, tparams: StrNil, params: $ps, ret: Some($tr), body: $sub.body))
                                } else {
                                    None
                                }
                            }
                            Some($rt) { Some(SubDecl(public: $sub.public, name: $sub.name, line: $sub.line, col: $sub.col, body_line: $sub.body_line, body_col: $sub.body_col, tparams: StrNil, params: $ps, ret: Some($rt), body: $sub.body)) }
                        }
                    }
                }
            }
        }
    }
}

sub g8_clone_spec_subs($subs: SubDeclList, $tparams: StrList, $bs: G5gBinds, $all: DeclList): SubDeclList {
    match $subs {
        SubDeclNil { SubDeclNil }
        SubDeclCons($h, $t) {
            $rest = g8_clone_spec_subs($t, $tparams, $bs, $all)
            match g8_clone_spec_sub($h, $tparams, $bs, $all) {
                None { $rest }
                Some($cs) { SubDeclCons($cs, $rest) }
            }
        }
    }
}

sub g8_clone_generic_class_spec($tmpl: ClassDecl, $args: TypeList, $all: DeclList): Option[ClassDecl] {
    match g8_bind_class_type_args($tmpl.tparams, $args, G5gBindNil, $all) {
        None { None }
        Some($bs) {
            match g8_subst_class_fields($tmpl.fields, $tmpl.tparams, $bs) {
                None { None }
                Some($fields) {
                    # P5b-2f: name via the FIELD-tag renderer (List[Int] -> List_Int),
                    # matching native's field-flattened class spec keys.
                    match g8_class_field_tags_n($fields, $all) {
                        None { None }
                        Some($parts) {
                            Some(ClassDecl(public: $tmpl.public, name: $tmpl.name ~ "__" ~ strlist_join_underscore($parts), tparams: StrNil, fields: $fields, subs: g8_clone_spec_subs($tmpl.subs, $tmpl.tparams, $bs, $all)))
                        }
                    }
                }
            }
        }
    }
}

# Substitute a generic enum variant's payload fields into a monomorphized spec.
# A field annotated with a type param binds through g5g_subst_typeref; a field
# annotated with a bare CONCRETE user enum/class (`$color: Color`) is a FIXED
# payload that native preserves unchanged across monomorphization, so it passes
# through instead of declining.
sub g8_subst_variant_fields($fields: ParamList, $tparams: StrList, $bs: G5gBinds, $all: DeclList): Option[ParamList] {
    match $fields {
        ParamNil { Some(ParamNil) }
        ParamCons($p, $pt) {
            match g8_subst_variant_fields($pt, $tparams, $bs, $all) {
                None { None }
                Some($rest) {
                    match $p.ty {
                        None { None }
                        Some($tr) {
                            match g5g_subst_typeref($tr, $tparams, $bs, false) {
                                Some($st) { Some(ParamCons(Param(name: $p.name, ty: Some($st)), $rest)) }
                                None {
                                    if g5g_type_is_bare($tr) && decl_user_type_named($all, $tr.name) {
                                        Some(ParamCons(Param(name: $p.name, ty: Some($tr)), $rest))
                                    } else {
                                        None
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_subst_enum_variants($vs: VariantList, $tparams: StrList, $bs: G5gBinds, $all: DeclList): Option[VariantList] {
    match $vs {
        VariantNil { Some(VariantNil) }
        VariantCons($h, $t) {
            match g8_subst_enum_variants($t, $tparams, $bs, $all) {
                None { None }
                Some($rest) {
                    match g8_subst_variant_fields($h.fields, $tparams, $bs, $all) {
                        None { None }
                        Some($fields) { Some(VariantCons(Variant(name: $h.name, fields: $fields), $rest)) }
                    }
                }
            }
        }
    }
}

# P5b-2h: rewrite a SELF-referential recursive payload annotation inside a
# monomorphized enum spec. The template `Stack[T] { Push($top: T, $rest: Stack[T]) }`
# substitutes to `Stack[Int]`, but the spec's field must name the CONCRETE spec
# itself (`Stack__Int`) so the existing concrete self-referential enum machinery
# (EB payload boxing: `Stack__Int* f1`, GUJI_KIND_Stack__Int, clone/drop helpers,
# and the topo/drop-table walks) applies unchanged — mirroring native, which
# flattens the recursive payload to the spec name and boxes it. A reference to
# the same template at DIFFERENT type args (no native fixture shape) declines
# the whole spec via None, and a bare template name (no args) is unresolvable
# here, so both stay honest rc-4 declines.
sub g8_self_field_rewrite($tr: TypeRef, $tmplname: Str, $specname: Str, $all: DeclList): Option[TypeRef] {
    if $tr.name == $tmplname {
        match $tr.args {
            TypeNil { None }
            TypeCons($a0, $at) {
                match g8_class_field_tags_c(g8_type_args_as_fields($tr.args), $all) {
                    None { None }
                    Some($parts) {
                        if $tmplname ~ "__" ~ strlist_join_underscore($parts) == $specname {
                            Some(TypeRef(name: $specname, args: TypeNil))
                        } else {
                            None
                        }
                    }
                }
            }
        }
    } else {
        Some($tr)
    }
}

sub g8_rewrite_self_fields($fields: ParamList, $tmplname: Str, $specname: Str, $all: DeclList): Option[ParamList] {
    match $fields {
        ParamNil { Some(ParamNil) }
        ParamCons($p, $pt) {
            match g8_rewrite_self_fields($pt, $tmplname, $specname, $all) {
                None { None }
                Some($rest) {
                    match $p.ty {
                        None { None }
                        Some($tr) {
                            match g8_self_field_rewrite($tr, $tmplname, $specname, $all) {
                                None { None }
                                Some($rt) { Some(ParamCons(Param(name: $p.name, ty: Some($rt)), $rest)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_rewrite_self_variants($vs: VariantList, $tmplname: Str, $specname: Str, $all: DeclList): Option[VariantList] {
    match $vs {
        VariantNil { Some(VariantNil) }
        VariantCons($h, $t) {
            match g8_rewrite_self_variants($t, $tmplname, $specname, $all) {
                None { None }
                Some($rest) {
                    match g8_rewrite_self_fields($h.fields, $tmplname, $specname, $all) {
                        None { None }
                        Some($fields) { Some(VariantCons(Variant(name: $h.name, fields: $fields), $rest)) }
                    }
                }
            }
        }
    }
}

sub g8_clone_generic_enum_spec($tmpl: EnumDecl, $args: TypeList, $all: DeclList): Option[EnumDecl] {
    match g8_bind_class_type_args($tmpl.tparams, $args, G5gBindNil, $all) {
        None { None }
        Some($bs) {
            match g8_subst_enum_variants($tmpl.variants, $tmpl.tparams, $bs, $all) {
                None { None }
                Some($variants) {
                    match g8_class_field_tags_c(g8_type_args_as_fields($args), $all) {
                        None { None }
                        Some($parts) {
                            # P5b-2d: spec methods/assoc fns are cloned with the same
                            # tparam substitution (cloneSubForClassSpec's enum analogue).
                            # P5b-2h: self-referential recursive payloads are renamed to
                            # the spec itself so concrete boxing applies.
                            $specname = $tmpl.name ~ "__" ~ strlist_join_underscore($parts)
                            match g8_rewrite_self_variants($variants, $tmpl.name, $specname, $all) {
                                None { None }
                                Some($vs2) {
                                    Some(EnumDecl(public: $tmpl.public, name: $specname, tparams: StrNil, variants: $vs2, subs: g8_clone_spec_subs($tmpl.subs, $tmpl.tparams, $bs, $all)))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_find_generic_class_template($decls: DeclList, $name: Str): Option[ClassDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($head, $tail) {
            match $head {
                DClass($c) {
                    if $c.name == $name && !strlist_empty($c.tparams) {
                        Some($c)
                    } else {
                        g8_find_generic_class_template($tail, $name)
                    }
                }
                _ { g8_find_generic_class_template($tail, $name) }
            }
        }
    }
}

sub g8_find_generic_enum_template($decls: DeclList, $name: Str): Option[EnumDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    if $e.name == $name && !strlist_empty($e.tparams) {
                        Some($e)
                    } else {
                        g8_find_generic_enum_template($tail, $name)
                    }
                }
                _ { g8_find_generic_enum_template($tail, $name) }
            }
        }
    }
}

sub g8_add_class_spec($spec: ClassDecl, $acc: DeclList): DeclList {
    if decl_class_named($acc, $spec.name) {
        $acc
    } else {
        DeclCons(DClass($spec), $acc)
    }
}

sub g8_add_enum_spec($spec: EnumDecl, $acc: DeclList): DeclList {
    if decl_enum_named($acc, $spec.name) {
        $acc
    } else {
        DeclCons(DEnum($spec), $acc)
    }
}

sub g8_collect_class_spec_from_type($ty: Option[TypeRef], $all: DeclList, $acc: DeclList): DeclList {
    match $ty {
        None { $acc }
        Some($tr) {
            match $tr.args {
                TypeNil { $acc }
                TypeCons($arg0, $argtail) {
                    match g8_find_generic_class_template($all, $tr.name) {
                        None { $acc }
                        Some($tmpl) {
                            match g8_clone_generic_class_spec($tmpl, $tr.args, $all) {
                                None { $acc }
                                Some($spec) {
                                    if decl_class_named($all, $spec.name) {
                                        $acc
                                    } else {
                                        g8_add_class_spec($spec, $acc)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_collect_enum_spec_from_type($ty: Option[TypeRef], $all: DeclList, $acc: DeclList): DeclList {
    match $ty {
        None { $acc }
        Some($tr) {
            match $tr.args {
                TypeNil { $acc }
                TypeCons($arg0, $argtail) {
                    match g8_find_generic_enum_template($all, $tr.name) {
                        None { $acc }
                        Some($tmpl) {
                            match g8_clone_generic_enum_spec($tmpl, $tr.args, $all) {
                                None { $acc }
                                Some($spec) {
                                    if decl_enum_named($all, $spec.name) {
                                        $acc
                                    } else {
                                        g8_add_enum_spec($spec, $acc)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_collect_class_specs_params($params: ParamList, $all: DeclList, $acc: DeclList): DeclList {
    match $params {
        ParamNil { $acc }
        ParamCons($h, $t) { g8_collect_class_specs_params($t, $all, g8_collect_class_spec_from_type($h.ty, $all, $acc)) }
    }
}

sub g8_collect_enum_specs_params($params: ParamList, $all: DeclList, $acc: DeclList): DeclList {
    match $params {
        ParamNil { $acc }
        ParamCons($h, $t) { g8_collect_enum_specs_params($t, $all, g8_collect_enum_spec_from_type($h.ty, $all, $acc)) }
    }
}

sub g8_collect_class_specs_subs($subs: SubDeclList, $all: DeclList, $acc: DeclList): DeclList {
    match $subs {
        SubDeclNil { $acc }
        SubDeclCons($h, $t) {
            $a1 = g8_collect_class_specs_params($h.params, $all, g8_collect_class_spec_from_type($h.ret, $all, $acc))
            g8_collect_class_specs_subs($t, $all, $a1)
        }
    }
}

sub g8_collect_enum_specs_subs($subs: SubDeclList, $all: DeclList, $acc: DeclList): DeclList {
    match $subs {
        SubDeclNil { $acc }
        SubDeclCons($h, $t) {
            $a1 = g8_collect_enum_specs_params($h.params, $all, g8_collect_enum_spec_from_type($h.ret, $all, $acc))
            g8_collect_enum_specs_subs($t, $all, $a1)
        }
    }
}

sub g8_collect_generic_class_specs($decls: DeclList, $all: DeclList, $acc: DeclList): DeclList {
    match $decls {
        DeclNil { $acc }
        DeclCons($head, $tail) {
            $a1 = match $head {
                DSub($s) { g8_collect_class_specs_params($s.params, $all, g8_collect_class_spec_from_type($s.ret, $all, $acc)) }
                DClass($c) { g8_collect_class_specs_subs($c.subs, $all, $acc) }
                _ { $acc }
            }
            g8_collect_generic_class_specs($tail, $all, $a1)
        }
    }
}

sub g8_collect_generic_enum_specs($decls: DeclList, $all: DeclList, $acc: DeclList): DeclList {
    match $decls {
        DeclNil { $acc }
        DeclCons($head, $tail) {
            $a1 = match $head {
                DSub($s) { g8_collect_enum_specs_sub($s, $all, $acc) }
                DClass($c) { g8_collect_enum_specs_subs($c.subs, $all, $acc) }
                _ { $acc }
            }
            g8_collect_generic_enum_specs($tail, $all, $a1)
        }
    }
}

# P5b-2b(c-enum-value): a sub contributes concrete enum specs from its SIGNATURE
# (params + return, the original collection) and from its BODY — an annotated
# bind (`$b: Box[Int] = ..`) names the instantiation directly, and an
# unannotated bind whose value is a generic-enum variant constructor with
# scalar-LITERAL args (`$bi = Wrap(42)`) infers it by binding the template's
# type params from the literal kinds. This mirrors native, which derives the
# instantiation from checker types; the literal-args boundary is honest —
# non-literal constructor args create no spec and the bind declines as before.
sub g8_collect_enum_specs_sub($s: SubDecl, $all: DeclList, $acc: DeclList): DeclList {
    $a0 = g8_collect_enum_specs_params($s.params, $all, g8_collect_enum_spec_from_type($s.ret, $all, $acc))
    $lls0 = g8_list_locals_params($s.params, $all, G5gBindNil)
    match $s.body {
        BlockBody($stmts) { g8_collect_enum_specs_stmts($stmts, $all, $lls0, $a0) }
        ExprBody($e) { g8_collect_enum_specs_expr($e, $all, $lls0, g8_collect_enum_spec_from_value($e, $all, $lls0, $a0)) }
    }
}

sub g8_collect_enum_specs_stmts($stmts: StmtList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $stmts {
        StmtNil { $acc }
        StmtCons($h, $t) {
            $a1 = g8_collect_enum_specs_stmt($h, $all, $lls, $acc)
            $next = g8_list_locals_stmt($h, $all, $lls)
            g8_collect_enum_specs_stmts($t, $all, $next, $a1)
        }
    }
}

sub g8_collect_enum_specs_stmt($s: Stmt, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $s {
        SBind($m, $n, $ty, $v) {
            g8_collect_enum_specs_expr($v, $all, $lls,
                g8_collect_enum_spec_from_value($v, $all, $lls,
                    g8_collect_enum_spec_from_type($ty, $all, $acc)))
        }
        SReturn($ov) {
            match $ov {
                None { $acc }
                Some($e) { g8_collect_enum_specs_expr($e, $all, $lls, g8_collect_enum_spec_from_value($e, $all, $lls, $acc)) }
            }
        }
        SExpr($e) { g8_collect_enum_specs_expr($e, $all, $lls, $acc) }
        SWhile($c, $b) { g8_collect_enum_specs_stmts($b, $all, $lls, $acc) }
        SFor($vars, $it, $b) { g8_collect_enum_specs_stmts($b, $all, g8_for_locals($vars, $it, $all, $lls), $acc) }
        SHatch($b) { g8_collect_enum_specs_stmts($b, $all, $lls, $acc) }
        SSelect($arms, $els) { g8_collect_enum_specs_select($arms, $els, $all, $lls, $acc) }
    }
}

sub g8_collect_enum_specs_select($arms: SelectArmList, $els: Option[StmtList], $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $arms {
        SelectArmNil {
            match $els { None { $acc } Some($b) { g8_collect_enum_specs_stmts($b, $all, $lls, $acc) } }
        }
        SelectArmCons($h, $t) {
            $a1 = g8_collect_enum_specs_expr($h.op, $all, $lls, $acc)
            $body_lls = g8_select_arm_locals($h, $all, $lls)
            g8_collect_enum_specs_select($t, $els, $all, $lls, g8_collect_enum_specs_stmts($h.body, $all, $body_lls, $a1))
        }
    }
}

# Recurse into the statement blocks an expression carries (if branches, match
# arms), so binds nested one control-flow level down still create their specs.
# Lambda bodies stay out (lambda+generic interplay is a later slice).
# P5b-2e: also walk CALL trees (native collectGenericEnumSpecs scans every call
# site) so VALUE-position instantiations create their specs too — a variant
# constructor in argument/receiver position (`print(Wrap(1).describe())`) and a
# generic-enum ASSOCIATED-function call (`Box.make(7)`, binding the template's
# type params from the assoc fn's param annotations against literal/concrete
# args). Interpolation parts stay out (no fixture shape needs them yet).
sub g8_collect_enum_specs_expr($e: Expr, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $e {
        EIf($c, $then, $elifs, $els) {
            $a1 = g8_collect_enum_specs_stmts($then, $all, $lls, $acc)
            $a2 = g8_collect_enum_specs_elifs($elifs, $all, $lls, $a1)
            match $els {
                None { $a2 }
                Some($b) { g8_collect_enum_specs_stmts($b, $all, $lls, $a2) }
            }
        }
        EMatch($subj, $arms) { g8_collect_enum_specs_arms($subj, $arms, $all, $lls, g8_collect_enum_specs_expr($subj, $all, $lls, $acc)) }
        ECall($callee, $args) {
            $a1 = g8_collect_enum_spec_from_value($e, $all, $lls, $acc)
            $a2 = g8_collect_enum_spec_from_assoc($callee, $args, $all, $lls, $a1)
            $a3 = g8_collect_enum_specs_expr($callee, $all, $lls, $a2)
            g8_collect_enum_specs_exprs($args, $all, $lls, $a3)
        }
        EField($obj, $n) { g8_collect_enum_specs_expr($obj, $all, $lls, $acc) }
        EBinary($op, $l, $r) { g8_collect_enum_specs_expr($r, $all, $lls, g8_collect_enum_specs_expr($l, $all, $lls, $acc)) }
        EUnary($op, $x) { g8_collect_enum_specs_expr($x, $all, $lls, $acc) }
        ENamedArg($n, $v) { g8_collect_enum_specs_expr($v, $all, $lls, $acc) }
        _ { $acc }
    }
}

sub g8_collect_enum_specs_exprs($xs: ExprList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $xs {
        ExprNil { $acc }
        ExprCons($h, $t) { g8_collect_enum_specs_exprs($t, $all, $lls, g8_collect_enum_specs_expr($h, $all, $lls, $acc)) }
    }
}

# The template's associated function named $m (a body sub WITHOUT a $self first
# param and without its own type params), or None.
sub g8_enum_assoc_sub_of($subs: SubDeclList, $m: Str): Option[SubDecl] {
    match $subs {
        SubDeclNil { None }
        SubDeclCons($h, $t) {
            if $h.name == $m && !is_method_sub($h) && strlist_empty($h.tparams) {
                Some($h)
            } else {
                g8_enum_assoc_sub_of($t, $m)
            }
        }
    }
}

# P5b-2e: discover a generic-enum spec from an ASSOCIATED-function call
# `Box.make(7)` / `Pair2.of(1, "a")` (native collectGenericEnumSpecs' assoc
# branch): the template's type params bind from the assoc fn's param
# annotations matched positionally against the call args, exactly the shape
# g8_bind_tparam_tags already implements for variant fields.
sub g8_collect_enum_spec_from_assoc($callee: Expr, $args: ExprList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $callee {
        EField($obj, $m) {
            match $obj {
                ETypeName($tn) {
                    match g8_find_generic_enum_template($all, $tn) {
                        None { $acc }
                        Some($tmpl) {
                            match g8_enum_assoc_sub_of($tmpl.subs, $m) {
                                None { $acc }
                                Some($fn) {
                                    match g8_bind_tparam_tags($tmpl.tparams, $fn.params, $args, $lls, $all) {
                                        None { $acc }
                                        Some($targs) {
                                            match g8_clone_generic_enum_spec($tmpl, $targs, $all) {
                                                None { $acc }
                                                Some($spec) {
                                                    if decl_enum_named($all, $spec.name) {
                                                        $acc
                                                    } else {
                                                        g8_add_enum_spec($spec, $acc)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { $acc }
            }
        }
        _ { $acc }
    }
}

sub g8_collect_enum_specs_elifs($elifs: ElifList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $elifs {
        ElifNil { $acc }
        ElifCons($h, $t) { g8_collect_enum_specs_elifs($t, $all, $lls, g8_collect_enum_specs_stmts($h.body, $all, $lls, $acc)) }
    }
}

sub g8_collect_enum_specs_arms($subj: Expr, $arms: ArmList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $arms {
        ArmNil { $acc }
        ArmCons($h, $t) {
            $body_lls = g8_match_arm_locals($h.pat, $subj, $all, $lls)
            g8_collect_enum_specs_arms($subj, $t, $all, $lls, g8_collect_enum_specs_stmts($h.body, $all, $body_lls, $acc))
        }
    }
}

# The scalar tag a literal constructor argument binds a type param to. Only the
# four leaf scalars participate; anything else yields no binding and the
# instantiation is skipped (no spec, downstream decline — never a guess).
sub g8_lit_type_tag($e: Expr): Option[Str] {
    match $e {
        EInt($t) { Some("Int") }
        EFloat($t) { Some("Float") }
        EBool($t) { Some("Bool") }
        EStr($t) { Some("Str") }
        _ { None }
    }
}

# P5b-2h: a scalar OPERATOR expression over literal(-tree) operands binds a type
# param too (`Push("x" ~ "1", ..)` -> Str) — the §5.1-5.2 result-kind table of
# g5g_binop_kind/g5g_unary_kind, restricted to the env-free pre-pass domain:
# operands recurse through the same literal/operator walk, so literal trees
# resolve while names/calls stay None (the pre-pass has no CgEnv to consult).
sub g8_num_lit_tag($e: Expr): Option[Str] {
    match g8_op_type_tag($e) {
        None { None }
        Some($t) { if $t == "Int" || $t == "Float" { Some($t) } else { None } }
    }
}

sub g8_op_type_tag($e: Expr): Option[Str] {
    match g8_lit_type_tag($e) {
        Some($t) { Some($t) }
        None {
            match $e {
                EBinary($op, $l, $r) {
                    if $op == "==" || $op == "!=" || $op == "<" || $op == "<=" || $op == ">" || $op == ">=" || $op == "&&" || $op == "||" {
                        Some("Bool")
                    } else if $op == "~" {
                        Some("Str")
                    } else if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" {
                        match g8_num_lit_tag($l) {
                            Some($t) { Some($t) }
                            None { g8_num_lit_tag($r) }
                        }
                    } else {
                        None
                    }
                }
                EUnary($op, $x) {
                    if $op == "!" {
                        Some("Bool")
                    } else if $op == "-" || $op == "+" {
                        g8_num_lit_tag($x)
                    } else {
                        None
                    }
                }
                _ { None }
            }
        }
    }
}

# The name of the NON-generic user enum that declares variant `$vname`, if any.
# Used to bind a generic type param to an ENUM-valued constructor argument
# (`Wrap(Red(9))` -> T == Color, `Wrap(Green)` -> T == Color). Generic enum
# owners are skipped: their bare name carries no type args, so it cannot serve as
# a concrete tag (that would need the argument's own nested monomorphization — a
# separate slice).
sub g8_enum_owner_of_variant($decls: DeclList, $vname: Str): Option[Str] {
    match $decls {
        DeclNil { None }
        DeclCons($h, $t) {
            match $h {
                DEnum($e) {
                    if strlist_empty($e.tparams) {
                        match g8_variant_fields_of($e.variants, $vname) {
                            Some($fs) { Some($e.name) }
                            None { g8_enum_owner_of_variant($t, $vname) }
                        }
                    } else {
                        g8_enum_owner_of_variant($t, $vname)
                    }
                }
                _ { g8_enum_owner_of_variant($t, $vname) }
            }
        }
    }
}

# True when `$name` names a NON-generic user class. A generic-class constructor
# argument is not resolved to a bare tag here (it would need its own type args).
sub g8_nongeneric_class_named($decls: DeclList, $name: Str): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($h, $t) {
            match $h {
                DClass($c) { if $c.name == $name && strlist_empty($c.tparams) { true } else { g8_nongeneric_class_named($t, $name) } }
                _ { g8_nongeneric_class_named($t, $name) }
            }
        }
    }
}

# The concrete type tag a constructor argument binds a type param to. Extends
# g8_lit_type_tag past the four scalars to CONCRETE user types: a non-generic
# enum variant constructor (`Red(9)` -> Color, `Green` -> Color) or a
# non-generic class constructor (`Point(...)` -> Point). Generic enum/class
# constructor args yield None (they need their own nested monomorphization), so
# the instantiation declines honestly rather than guessing a bare owner tag.
sub g8_value_type_tag($e: Expr, $all: DeclList): Option[Str] {
    match g8_op_type_tag($e) {
        Some($t) { Some($t) }
        None {
            match $e {
                ECall($callee, $cargs) {
                    match $callee {
                        ETypeName($n) {
                            if g8_nongeneric_class_named($all, $n) {
                                Some($n)
                            } else {
                                g8_enum_owner_of_variant($all, $n)
                            }
                        }
                        _ { None }
                    }
                }
                ETypeName($n) { g8_enum_owner_of_variant($all, $n) }
                _ { None }
            }
        }
    }
}

sub g8_variant_fields_of($vs: VariantList, $name: Str): Option[ParamList] {
    match $vs {
        VariantNil { None }
        VariantCons($h, $t) { if $h.name == $name { Some($h.fields) } else { g8_variant_fields_of($t, $name) } }
    }
}

sub g8_find_generic_enum_template_by_variant($decls: DeclList, $vname: Str): Option[EnumDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    if !strlist_empty($e.tparams) {
                        match g8_variant_fields_of($e.variants, $vname) {
                            Some($fs) { Some($e) }
                            None { g8_find_generic_enum_template_by_variant($tail, $vname) }
                        }
                    } else {
                        g8_find_generic_enum_template_by_variant($tail, $vname)
                    }
                }
                _ { g8_find_generic_enum_template_by_variant($tail, $vname) }
            }
        }
    }
}

# ---- P5b-2f: generic structural fields/payloads ---------------------------
# A structural local carries both its concrete LEAF tag and its exact wrapper
# shape: L=List, M=Map value, O=Option payload. C=Chan element is tracked only
# so for/select binders can derive their child type; generic field patterns
# deliberately accept only L/M/O. Keeping the shape prevents a named
# List[List[Int]] from being mistaken for List[Int].
sub g8_local_bare_key($name: Str): Str {
    $name ~ "|bare"
}

sub g8_local_shape_key($name: Str): Str {
    $name ~ "|shape"
}

sub g8_local_mask_tag(): Str {
    "|g8-local-mask|"
}

# Local lookup is first-match like g5g_binds_lookup, except a nearest lexical
# mask stops the search instead of falling through to an outer binding.
sub g8_local_lookup($bs: G5gBinds, $n: Str): Option[Str] {
    match $bs {
        G5gBindNil { None }
        G5gBindCons($name, $tag, $tail) {
            if $name == $n {
                if $tag == g8_local_mask_tag() { None } else { Some($tag) }
            } else {
                g8_local_lookup($tail, $n)
            }
        }
    }
}

sub g8_mask_local($name: Str, $acc: G5gBinds): G5gBinds {
    G5gBindCons(
        $name,
        g8_local_mask_tag(),
        G5gBindCons(
            g8_local_shape_key($name),
            g8_local_mask_tag(),
            G5gBindCons(g8_local_bare_key($name), g8_local_mask_tag(), $acc)
        )
    )
}

sub g8_add_bare_local($name: Str, $tag: Str, $acc: G5gBinds): G5gBinds {
    G5gBindCons(g8_local_bare_key($name), $tag, $acc)
}

sub g8_add_structural_local($name: Str, $shape: Str, $leaf: Str, $acc: G5gBinds): G5gBinds {
    G5gBindCons($name, $leaf, G5gBindCons(g8_local_shape_key($name), $shape, $acc))
}

sub g8_bind_descriptor_local($name: Str, $shape: Str, $leaf: Str, $acc: G5gBinds): G5gBinds {
    $masked = g8_mask_local($name, $acc)
    if $shape == "" {
        g8_add_bare_local($name, $leaf, $masked)
    } else {
        g8_add_structural_local($name, $shape, $leaf, $masked)
    }
}

sub g8_shape_prepend($prefix: Str, $inner: Option[Str]): Option[Str] {
    match $inner {
        None { None }
        Some($shape) { Some($prefix ~ $shape) }
    }
}

sub g8_shape_drop_prefix($shape: Str, $prefix: Str): Option[Str] {
    if starts_with($shape, $prefix) {
        Some(drop(split($shape, ""), split($prefix, "").count()).join(""))
    } else {
        None
    }
}

sub g8_type_binding_prefix(): Str {
    "|g8-type|"
}

sub g8_type_binding_shape_supported($shape: Str): Bool {
    if $shape == "" {
        true
    } else {
        @chars = split($shape, "")
        match get(@chars, 0) {
            None { false }
            Some($head) {
                if $head == "L" || $head == "M" || $head == "O" {
                    g8_type_binding_shape_supported(drop(@chars, 1).join(""))
                } else {
                    false
                }
            }
        }
    }
}

# G5gBinds predates structural owner type arguments and stores Str values. Keep
# its scalar/user tags byte-identical, while encoding a List/Map/Option graph in
# a namespace that cannot collide with a source identifier.
sub g8_descriptor_binding_tag($shape: Str, $leaf: Str): Option[Str] {
    if $leaf == "" || !g8_type_binding_shape_supported($shape) {
        None
    } else if $shape == "" {
        Some($leaf)
    } else {
        Some(g8_type_binding_prefix() ~ $shape ~ "|" ~ $leaf)
    }
}

sub g8_descriptor_typeref($shape: Str, $leaf: Str): Option[TypeRef] {
    if $shape == "" {
        if $leaf == "" { None } else { Some(TypeRef(name: $leaf, args: TypeNil)) }
    } else {
        @chars = split($shape, "")
        match get(@chars, 0) {
            None { None }
            Some($head) {
                match g8_descriptor_typeref(drop(@chars, 1).join(""), $leaf) {
                    None { None }
                    Some($inner) {
                        if $head == "L" {
                            Some(TypeRef(name: "List", args: TypeCons($inner, TypeNil)))
                        } else if $head == "M" {
                            Some(TypeRef(name: "Map", args: TypeCons(TypeRef(name: "Str", args: TypeNil), TypeCons($inner, TypeNil))))
                        } else if $head == "O" {
                            Some(TypeRef(name: "Option", args: TypeCons($inner, TypeNil)))
                        } else {
                            None
                        }
                    }
                }
            }
        }
    }
}

sub g8_type_from_binding_tag($tag: Str): Option[TypeRef] {
    $prefix = g8_type_binding_prefix()
    if starts_with($tag, $prefix) {
        $body = drop(split($tag, ""), split($prefix, "").count()).join("")
        @parts = split($body, "|")
        if @parts.count() == 2 {
            match get(@parts, 0) {
                None { None }
                Some($shape) {
                    match get(@parts, 1) {
                        None { None }
                        Some($leaf) { g8_descriptor_typeref($shape, $leaf) }
                    }
                }
            }
        } else {
            None
        }
    } else {
        Some(TypeRef(name: $tag, args: TypeNil))
    }
}

sub g8_type_binding_tag_c($tr: TypeRef, $all: DeclList): Option[Str] {
    match g8_class_type_arg_tag_c($tr, $all) {
        Some($tag) { Some($tag) }
        None {
            match g8_tracked_ann_shape($tr, $all) {
                None { None }
                Some($shape) {
                    match g8_tracked_ann_leaf($tr, $all) {
                        None { None }
                        Some($leaf) { g8_descriptor_binding_tag($shape, $leaf) }
                    }
                }
            }
        }
    }
}

sub g8_tracked_ann_shape($tr: TypeRef, $all: DeclList): Option[Str] {
    if $tr.name == "List" {
        match typelist_at($tr.args, 0) {
            None { None }
            Some($inner) { g8_shape_prepend("L", g8_tracked_ann_shape($inner, $all)) }
        }
    } else if $tr.name == "Map" {
        match typelist_at($tr.args, 1) {
            None { None }
            Some($inner) { g8_shape_prepend("M", g8_tracked_ann_shape($inner, $all)) }
        }
    } else if $tr.name == "Option" {
        match typelist_at($tr.args, 0) {
            None { None }
            Some($inner) { g8_shape_prepend("O", g8_tracked_ann_shape($inner, $all)) }
        }
    } else if $tr.name == "Chan" {
        match typelist_at($tr.args, 0) {
            None { None }
            Some($inner) { g8_shape_prepend("C", g8_tracked_ann_shape($inner, $all)) }
        }
    } else {
        match g8_class_type_arg_tag_c($tr, $all) {
            None { None }
            Some($tag) { Some("") }
        }
    }
}

sub g8_tracked_ann_leaf($tr: TypeRef, $all: DeclList): Option[Str] {
    if $tr.name == "List" || $tr.name == "Option" || $tr.name == "Chan" {
        match typelist_at($tr.args, 0) {
            None { None }
            Some($inner) { g8_tracked_ann_leaf($inner, $all) }
        }
    } else if $tr.name == "Map" {
        match typelist_at($tr.args, 1) {
            None { None }
            Some($inner) { g8_tracked_ann_leaf($inner, $all) }
        }
    } else {
        g8_class_type_arg_tag_c($tr, $all)
    }
}

sub g8_track_declared_local($name: Str, $ty: Option[TypeRef], $all: DeclList, $acc: G5gBinds): G5gBinds {
    $masked = g8_mask_local($name, $acc)
    match $ty {
        None { $masked }
        Some($tr) {
            match g8_tracked_ann_shape($tr, $all) {
                None { $masked }
                Some($shape) {
                    match g8_tracked_ann_leaf($tr, $all) {
                        None { $masked }
                        Some($leaf) {
                            if $shape == "" {
                                g8_add_bare_local($name, $leaf, $masked)
                            } else {
                                g8_add_structural_local($name, $shape, $leaf, $masked)
                            }
                        }
                    }
                }
            }
        }
    }
}

class G8TypeDescriptor {
    has $.shape: Str
    has $.leaf: Str
}

sub g8_expr_descriptor($e: Expr, $lls: G5gBinds, $all: DeclList): Option[G8TypeDescriptor] {
    match g8_structural_shape_of_expr($e, $lls, $all) {
        None { None }
        Some($shape) {
            match g8_nested_leaf_tag_of_expr($e, $lls, $all) {
                None { None }
                Some($leaf) { Some(G8TypeDescriptor(shape: $shape, leaf: $leaf)) }
            }
        }
    }
}

sub g8_block_descriptor($body: StmtList, $lls: G5gBinds, $all: DeclList): Option[G8TypeDescriptor] {
    match g8_stmts_trailing_expr($body) {
        None { None }
        Some($e) { g8_expr_descriptor($e, $lls, $all) }
    }
}

sub g8_if_tail_descriptor($elifs: ElifList, $els: Option[StmtList], $lls: G5gBinds, $all: DeclList): Option[G8TypeDescriptor] {
    match $elifs {
        ElifNil {
            match $els {
                None { None }
                Some($body) { g8_block_descriptor($body, $lls, $all) }
            }
        }
        ElifCons($head, $tail) {
            match g8_block_descriptor($head.body, $lls, $all) {
                Some($desc) { Some($desc) }
                None { g8_if_tail_descriptor($tail, $els, $lls, $all) }
            }
        }
    }
}

sub g8_if_descriptor($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $lls: G5gBinds, $all: DeclList): Option[G8TypeDescriptor] {
    match g8_block_descriptor($then, $lls, $all) {
        Some($desc) { Some($desc) }
        None { g8_if_tail_descriptor($elifs, $els, $lls, $all) }
    }
}

# Resolve the concrete leaf and exact shape contributed by a literal/copy.
# Empty collections and None remain uninferable and therefore stay masked.
sub g8_nested_leaf_tag_of_expr($e: Expr, $lls: G5gBinds, $all: DeclList): Option[Str] {
    match $e {
        EName($n) {
            match g8_local_lookup($lls, g8_local_bare_key($n)) {
                Some($tag) { Some($tag) }
                None { g8_local_lookup($lls, $n) }
            }
        }
        EList($items) {
            match $items {
                ExprNil { None }
                ExprCons($h, $t) { g8_nested_leaf_tag_of_expr($h, $lls, $all) }
            }
        }
        EMap($items) {
            match $items {
                MapEntryNil { None }
                MapEntryCons($h, $t) { g8_nested_leaf_tag_of_expr($h.value, $lls, $all) }
            }
        }
        ECall($callee, $args) {
            match $callee {
                ETypeName($n) {
                    if $n == "Some" {
                        match $args {
                            ExprCons($h, ExprNil) { g8_nested_leaf_tag_of_expr($h, $lls, $all) }
                            _ { None }
                        }
                    } else {
                        g8_value_type_tag($e, $all)
                    }
                }
                _ { g8_value_type_tag($e, $all) }
            }
        }
        EIf($cond, $then, $elifs, $els) {
            match g8_if_descriptor($then, $elifs, $els, $lls, $all) {
                None { None }
                Some($desc) { Some($desc.leaf) }
            }
        }
        _ { g8_value_type_tag($e, $all) }
    }
}

sub g8_structural_shape_of_expr($e: Expr, $lls: G5gBinds, $all: DeclList): Option[Str] {
    match $e {
        EName($n) {
            match g8_local_lookup($lls, g8_local_bare_key($n)) {
                Some($tag) { Some("") }
                None { g8_local_lookup($lls, g8_local_shape_key($n)) }
            }
        }
        EList($items) {
            match $items {
                ExprNil { None }
                ExprCons($h, $t) { g8_shape_prepend("L", g8_structural_shape_of_expr($h, $lls, $all)) }
            }
        }
        EMap($items) {
            match $items {
                MapEntryNil { None }
                MapEntryCons($h, $t) { g8_shape_prepend("M", g8_structural_shape_of_expr($h.value, $lls, $all)) }
            }
        }
        ECall($callee, $args) {
            match $callee {
                ETypeName($n) {
                    if $n == "Some" {
                        match $args {
                            ExprCons($h, ExprNil) { g8_shape_prepend("O", g8_structural_shape_of_expr($h, $lls, $all)) }
                            _ { None }
                        }
                    } else {
                        match g8_value_type_tag($e, $all) {
                            None { None }
                            Some($tag) { Some("") }
                        }
                    }
                }
                _ { None }
            }
        }
        EIf($cond, $then, $elifs, $els) {
            match g8_if_descriptor($then, $elifs, $els, $lls, $all) {
                None { None }
                Some($desc) { Some($desc.shape) }
            }
        }
        _ {
            match g8_value_type_tag($e, $all) {
                None { None }
                Some($tag) { Some("") }
            }
        }
    }
}

sub g8_track_copied_local($name: Str, $source: Str, $lookup: G5gBinds, $out: G5gBinds): G5gBinds {
    match g8_local_lookup($lookup, g8_local_bare_key($source)) {
        Some($tag) { g8_add_bare_local($name, $tag, $out) }
        None {
            match g8_local_lookup($lookup, g8_local_shape_key($source)) {
                None { $out }
                Some($shape) {
                    match g8_local_lookup($lookup, $source) {
                        None { $out }
                        Some($leaf) { g8_add_structural_local($name, $shape, $leaf, $out) }
                    }
                }
            }
        }
    }
}

sub g8_track_structural_expr($name: Str, $value: Expr, $all: DeclList, $lookup: G5gBinds, $out: G5gBinds): G5gBinds {
    match g8_structural_shape_of_expr($value, $lookup, $all) {
        None { $out }
        Some($shape) {
            match g8_nested_leaf_tag_of_expr($value, $lookup, $all) {
                None { $out }
                Some($leaf) {
                    if $shape == "" {
                        g8_add_bare_local($name, $leaf, $out)
                    } else {
                        g8_add_structural_local($name, $shape, $leaf, $out)
                    }
                }
            }
        }
    }
}

sub g8_track_unannotated_local($name: Str, $value: Expr, $all: DeclList, $lookup: G5gBinds, $out: G5gBinds): G5gBinds {
    match $value {
        EName($source) { g8_track_copied_local($name, $source, $lookup, $out) }
        EList($items) { g8_track_structural_expr($name, $value, $all, $lookup, $out) }
        EMap($items) { g8_track_structural_expr($name, $value, $all, $lookup, $out) }
        EIf($cond, $then, $elifs, $els) { g8_track_structural_expr($name, $value, $all, $lookup, $out) }
        ECall($callee, $args) {
            match $callee {
                ETypeName($cn) {
                    if $cn == "Some" {
                        g8_track_structural_expr($name, $value, $all, $lookup, $out)
                    } else {
                        match g8_value_type_tag($value, $all) {
                            Some($tag) { g8_add_bare_local($name, $tag, $out) }
                            None { $out }
                        }
                    }
                }
                _ { $out }
            }
        }
        _ {
            match g8_value_type_tag($value, $all) {
                Some($tag) { g8_add_bare_local($name, $tag, $out) }
                None { $out }
            }
        }
    }
}

# Track one lexical block's structural locals in statement order, recording
# `name -> leaf tag` so later generic constructor arguments can bind a nested
# field's type parameter. Child blocks receive this table as their outer scope,
# but their additions are not returned to a parent or sibling block.
sub g8_list_locals_stmt($s: Stmt, $all: DeclList, $acc: G5gBinds): G5gBinds {
    match $s {
        SBind($m, $n, $ty, $v) {
            match $ty {
                Some($tr) { g8_track_declared_local($n, $ty, $all, $acc) }
                None {
                    $masked = g8_mask_local($n, $acc)
                    g8_track_unannotated_local($n, $v, $all, $acc, $masked)
                }
            }
        }
        _ { $acc }
    }
}

sub g8_list_locals_params($params: ParamList, $all: DeclList, $acc: G5gBinds): G5gBinds {
    match $params {
        ParamNil { $acc }
        ParamCons($h, $t) {
            g8_list_locals_params($t, $all, g8_track_declared_local($h.name, $h.ty, $all, $acc))
        }
    }
}

sub g8_mask_local_names($names: StrList, $acc: G5gBinds): G5gBinds {
    match $names {
        StrNil { $acc }
        StrCons($h, $t) { g8_mask_local_names($t, g8_mask_local($h, $acc)) }
    }
}

sub g8_for_locals($vars: StrList, $iter: Expr, $all: DeclList, $lls: G5gBinds): G5gBinds {
    $masked = g8_mask_local_names($vars, $lls)
    match $iter {
        EBinary($op, $l, $r) {
            if $op == ".." || $op == "..<" {
                match $vars {
                    StrCons($v, StrNil) { g8_add_bare_local($v, "Int", $masked) }
                    _ { $masked }
                }
            } else {
                $masked
            }
        }
        _ {
            match g8_structural_shape_of_expr($iter, $lls, $all) {
                None { $masked }
                Some($shape) {
                    match g8_nested_leaf_tag_of_expr($iter, $lls, $all) {
                        None { $masked }
                        Some($leaf) {
                            match g8_shape_drop_prefix($shape, "L") {
                                Some($inner) {
                                    match $vars {
                                        StrCons($v, StrNil) {
                                            if $inner == "" {
                                                g8_add_bare_local($v, $leaf, $masked)
                                            } else {
                                                g8_add_structural_local($v, $inner, $leaf, $masked)
                                            }
                                        }
                                        _ { $masked }
                                    }
                                }
                                None {
                                    match g8_shape_drop_prefix($shape, "M") {
                                        Some($inner) {
                                            match $vars {
                                                StrCons($k, StrCons($v, StrNil)) {
                                                    $with_key = g8_add_bare_local($k, "Str", $masked)
                                                    if $inner == "" {
                                                        g8_add_bare_local($v, $leaf, $with_key)
                                                    } else {
                                                        g8_add_structural_local($v, $inner, $leaf, $with_key)
                                                    }
                                                }
                                                _ { $masked }
                                            }
                                        }
                                        None {
                                            match g8_shape_drop_prefix($shape, "C") {
                                                Some($inner) {
                                                    match $vars {
                                                        StrCons($v, StrNil) {
                                                            if $inner == "" {
                                                                g8_add_bare_local($v, $leaf, $masked)
                                                            } else {
                                                                g8_add_structural_local($v, $inner, $leaf, $masked)
                                                            }
                                                        }
                                                        _ { $masked }
                                                    }
                                                }
                                                None { $masked }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_select_arm_locals($arm: SelectArm, $all: DeclList, $lls: G5gBinds): G5gBinds {
    match $arm.bind {
        None { $lls }
        Some($name) {
            $masked = g8_mask_local($name, $lls)
            match $arm.op {
                ECall($callee, $args) {
                    match $callee {
                        EField($obj, $method) {
                            if $method == "recv" {
                                match g8_structural_shape_of_expr($obj, $lls, $all) {
                                    None { $masked }
                                    Some($shape) {
                                        match g8_shape_drop_prefix($shape, "C") {
                                            None { $masked }
                                            Some($inner) {
                                                match g8_nested_leaf_tag_of_expr($obj, $lls, $all) {
                                                    None { $masked }
                                                    Some($leaf) { g8_add_structural_local($name, "O" ~ $inner, $leaf, $masked) }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                $masked
                            }
                        }
                        _ { $masked }
                    }
                }
                _ { $masked }
            }
        }
    }
}

sub g8_find_concrete_enum($decls: DeclList, $name: Str): Option[EnumDecl] {
    match $decls {
        DeclNil { None }
        DeclCons($h, $t) {
            match $h {
                DEnum($e) {
                    if $e.name == $name && strlist_empty($e.tparams) {
                        Some($e)
                    } else {
                        g8_find_concrete_enum($t, $name)
                    }
                }
                _ { g8_find_concrete_enum($t, $name) }
            }
        }
    }
}

sub g8_mask_pattern_binds($p: Pattern, $acc: G5gBinds): G5gBinds {
    match $p {
        PBind($name) { g8_mask_local($name, $acc) }
        PVariant($name, $args) { g8_mask_pattern_list_binds($args, $acc) }
        _ { $acc }
    }
}

sub g8_mask_pattern_list_binds($ps: PatternList, $acc: G5gBinds): G5gBinds {
    match $ps {
        PatNil { $acc }
        PatCons($h, $t) { g8_mask_pattern_list_binds($t, g8_mask_pattern_binds($h, $acc)) }
    }
}

sub g8_bind_pattern_descriptor($p: Pattern, $shape: Str, $leaf: Str, $all: DeclList, $acc: G5gBinds): G5gBinds {
    match $p {
        PBind($name) { g8_bind_descriptor_local($name, $shape, $leaf, $acc) }
        PVariant($name, $args) {
            if $name == "Some" {
                match g8_shape_drop_prefix($shape, "O") {
                    None { g8_mask_pattern_list_binds($args, $acc) }
                    Some($inner) {
                        match $args {
                            PatCons($h, PatNil) { g8_bind_pattern_descriptor($h, $inner, $leaf, $all, $acc) }
                            _ { g8_mask_pattern_list_binds($args, $acc) }
                        }
                    }
                }
            } else if $shape == "" {
                match g8_find_concrete_enum($all, $leaf) {
                    None { g8_mask_pattern_list_binds($args, $acc) }
                    Some($e) {
                        match g8_variant_fields_of($e.variants, $name) {
                            None { g8_mask_pattern_list_binds($args, $acc) }
                            Some($fields) { g8_bind_patterns_from_params($args, $fields, $all, $acc) }
                        }
                    }
                }
            } else {
                g8_mask_pattern_list_binds($args, $acc)
            }
        }
        _ { $acc }
    }
}

sub g8_bind_pattern_from_param($p: Pattern, $param: Param, $all: DeclList, $acc: G5gBinds): G5gBinds {
    match $param.ty {
        None { g8_mask_pattern_binds($p, $acc) }
        Some($tr) {
            match g8_tracked_ann_shape($tr, $all) {
                None { g8_mask_pattern_binds($p, $acc) }
                Some($shape) {
                    match g8_tracked_ann_leaf($tr, $all) {
                        None { g8_mask_pattern_binds($p, $acc) }
                        Some($leaf) { g8_bind_pattern_descriptor($p, $shape, $leaf, $all, $acc) }
                    }
                }
            }
        }
    }
}

sub g8_bind_patterns_from_params($ps: PatternList, $params: ParamList, $all: DeclList, $acc: G5gBinds): G5gBinds {
    match $ps {
        PatNil { $acc }
        PatCons($p, $pt) {
            match $params {
                ParamNil { g8_mask_pattern_list_binds($ps, $acc) }
                ParamCons($param, $paramt) {
                    g8_bind_patterns_from_params($pt, $paramt, $all, g8_bind_pattern_from_param($p, $param, $all, $acc))
                }
            }
        }
    }
}

sub g8_match_arm_locals($pat: Pattern, $subj: Expr, $all: DeclList, $lls: G5gBinds): G5gBinds {
    match g8_structural_shape_of_expr($subj, $lls, $all) {
        None { g8_mask_pattern_binds($pat, $lls) }
        Some($shape) {
            match g8_nested_leaf_tag_of_expr($subj, $lls, $all) {
                None { g8_mask_pattern_binds($pat, $lls) }
                Some($leaf) { g8_bind_pattern_descriptor($pat, $shape, $leaf, $all, $lls) }
            }
        }
    }
}

sub g8_pattern_shape_to_tparam($tp: Str, $tr: TypeRef): Option[Str] {
    match $tr.args {
        TypeNil { if $tr.name == $tp { Some("") } else { None } }
        TypeCons($h0, $t0) {
            if $tr.name == "List" {
                g8_shape_prepend("L", g8_pattern_shape_to_tparam($tp, $h0))
            } else if $tr.name == "Map" {
                match typelist_at($tr.args, 1) {
                    None { None }
                    Some($vtr) { g8_shape_prepend("M", g8_pattern_shape_to_tparam($tp, $vtr)) }
                }
            } else if $tr.name == "Option" {
                g8_shape_prepend("O", g8_pattern_shape_to_tparam($tp, $h0))
            } else {
                None
            }
        }
    }
}

# Structurally unify one field annotation with its constructor value. The
# wrappers before `$tp` must match exactly; any remaining actual wrappers belong
# to the type argument itself. Thus List[T] against List[List[Int]] binds
# T=List[Int], while List[List[T]] against the same value still binds T=Int.
sub g8_tparam_tag_from_pattern($tp: Str, $tr: TypeRef, $a: Expr, $lls: G5gBinds, $all: DeclList): Option[Str] {
    match g8_pattern_shape_to_tparam($tp, $tr) {
        None { None }
        Some($expected) {
            match g8_expr_descriptor($a, $lls, $all) {
                None { None }
                Some($actual) {
                    match g8_shape_drop_prefix($actual.shape, $expected) {
                        None { None }
                        Some($bound_shape) {
                            g8_descriptor_binding_tag($bound_shape, $actual.leaf)
                        }
                    }
                }
            }
        }
    }
}

sub g8_tparam_tag_from_fields($tp: Str, $fields: ParamList, $args: ExprList, $lls: G5gBinds, $all: DeclList): Option[Str] {
    match $fields {
        ParamNil { None }
        ParamCons($f, $frest) {
            match $args {
                ExprNil { None }
                ExprCons($a, $arest) {
                    $here = match $f.ty {
                        None { None }
                        Some($tr) { g8_tparam_tag_from_pattern($tp, $tr, $a, $lls, $all) }
                    }
                    match $here {
                        Some($tag) { Some($tag) }
                        None { g8_tparam_tag_from_fields($tp, $frest, $arest, $lls, $all) }
                    }
                }
            }
        }
    }
}

sub g8_bind_tparam_tags($tps: StrList, $fields: ParamList, $args: ExprList, $lls: G5gBinds, $all: DeclList): Option[TypeList] {
    match $tps {
        StrNil { Some(TypeNil) }
        StrCons($tp, $rest) {
            match g8_tparam_tag_from_fields($tp, $fields, $args, $lls, $all) {
                None { None }
                Some($tag) {
                    match g8_type_from_binding_tag($tag) {
                        None { None }
                        Some($bound) {
                            match g8_bind_tparam_tags($rest, $fields, $args, $lls, $all) {
                                None { None }
                                Some($tail) { Some(TypeCons($bound, $tail)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_collect_enum_spec_from_value($value: Expr, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $value {
        ECall($callee, $args) {
            match $callee {
                ETypeName($vn) {
                    match g8_find_generic_enum_template_by_variant($all, $vn) {
                        None { $acc }
                        Some($tmpl) {
                            match g8_variant_fields_of($tmpl.variants, $vn) {
                                None { $acc }
                                Some($vfields) {
                                    match g8_bind_tparam_tags($tmpl.tparams, $vfields, $args, $lls, $all) {
                                        None { $acc }
                                        Some($targs) {
                                            match g8_clone_generic_enum_spec($tmpl, $targs, $all) {
                                                None { $acc }
                                                Some($spec) {
                                                    # Dedup vs $all too (like from_type):
                                                    # pass 2 re-sees pass 1's appended spec.
                                                    if decl_enum_named($all, $spec.name) {
                                                        $acc
                                                    } else {
                                                        g8_add_enum_spec($spec, $acc)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { $acc }
            }
        }
        _ { $acc }
    }
}

sub g8_has_generic_enum_template($decls: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) { if strlist_empty($e.tparams) { g8_has_generic_enum_template($tail) } else { true } }
                _ { g8_has_generic_enum_template($tail) }
            }
        }
    }
}

# P5b-2b(c-class-value): the CLASS twin of g8_collect_enum_spec_from_value. A sub
# BODY contributes a concrete generic-class spec when an unannotated bind (or a
# return / final value) constructs a generic class. Type parameters are bound by
# recursively matching each field annotation against its named argument, so
# Map[Str,T], Option[T], and nested List/Map shapes share one inference path.
# Signature-position class specs are still collected by
# g8_collect_generic_class_specs; this body walk runs only when a generic class
# template exists (gated in g8_expand_generic_classes), so the compiler's own
# generic-free source never walks its bodies here.
sub g8_class_tparam_tag_from_fields($tp: Str, $fields: ClassFieldList, $args: ExprList, $lls: G5gBinds, $all: DeclList): Option[Str] {
    match $fields {
        ClassFieldNil { None }
        ClassFieldCons($f, $frest) {
            $here = match $f.ty {
                None { None }
                Some($tr) {
                    match g8_named_arg_value($args, $f.name) {
                        None { None }
                        Some($a) { g8_tparam_tag_from_pattern($tp, $tr, $a, $lls, $all) }
                    }
                }
            }
            match $here {
                Some($tag) { Some($tag) }
                None { g8_class_tparam_tag_from_fields($tp, $frest, $args, $lls, $all) }
            }
        }
    }
}

sub g8_bind_class_tparam_tags($tps: StrList, $fields: ClassFieldList, $args: ExprList, $lls: G5gBinds, $all: DeclList): Option[TypeList] {
    match $tps {
        StrNil { Some(TypeNil) }
        StrCons($tp, $rest) {
            match g8_class_tparam_tag_from_fields($tp, $fields, $args, $lls, $all) {
                None { None }
                Some($tag) {
                    match g8_type_from_binding_tag($tag) {
                        None { None }
                        Some($bound) {
                            match g8_bind_class_tparam_tags($rest, $fields, $args, $lls, $all) {
                                None { None }
                                Some($tail) { Some(TypeCons($bound, $tail)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_collect_class_spec_from_value($value: Expr, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $value {
        ECall($callee, $args) {
            match $callee {
                ETypeName($cn) {
                    match g8_find_generic_class_template($all, $cn) {
                        None { $acc }
                        Some($tmpl) {
                            match g8_bind_class_tparam_tags($tmpl.tparams, $tmpl.fields, $args, $lls, $all) {
                                None { $acc }
                                Some($targs) {
                                    match g8_clone_generic_class_spec($tmpl, $targs, $all) {
                                        None { $acc }
                                        Some($spec) {
                                            # Dedup vs $all too (like from_type): the
                                            # pipeline expands twice, and a spec appended
                                            # by pass 1 is already a decl in pass 2.
                                            if decl_class_named($all, $spec.name) {
                                                $acc
                                            } else {
                                                g8_add_class_spec($spec, $acc)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { $acc }
            }
        }
        _ { $acc }
    }
}

sub g8_has_generic_class_template($decls: DeclList): Bool {
    match $decls {
        DeclNil { false }
        DeclCons($head, $tail) {
            match $head {
                DClass($c) { if strlist_empty($c.tparams) { g8_has_generic_class_template($tail) } else { true } }
                _ { g8_has_generic_class_template($tail) }
            }
        }
    }
}

sub g8_collect_class_bodies($decls: DeclList, $all: DeclList, $acc: DeclList): DeclList {
    match $decls {
        DeclNil { $acc }
        DeclCons($head, $tail) {
            $a1 = match $head {
                DSub($s) {
                    $lls0 = g8_list_locals_params($s.params, $all, G5gBindNil)
                    match $s.body {
                        BlockBody($stmts) { g8_collect_class_specs_stmts($stmts, $all, $lls0, $acc) }
                        ExprBody($e) { g8_collect_class_specs_expr($e, $all, $lls0, g8_collect_class_spec_from_value($e, $all, $lls0, $acc)) }
                    }
                }
                _ { $acc }
            }
            g8_collect_class_bodies($tail, $all, $a1)
        }
    }
}

sub g8_collect_class_specs_stmts($stmts: StmtList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $stmts {
        StmtNil { $acc }
        StmtCons($h, $t) {
            $a1 = g8_collect_class_specs_stmt($h, $all, $lls, $acc)
            $next = g8_list_locals_stmt($h, $all, $lls)
            g8_collect_class_specs_stmts($t, $all, $next, $a1)
        }
    }
}

sub g8_collect_class_specs_stmt($s: Stmt, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $s {
        SBind($m, $n, $ty, $v) {
            g8_collect_class_specs_expr($v, $all, $lls,
                g8_collect_class_spec_from_value($v, $all, $lls,
                    g8_collect_class_spec_from_type($ty, $all, $acc)))
        }
        SReturn($ov) {
            match $ov {
                None { $acc }
                Some($e) { g8_collect_class_specs_expr($e, $all, $lls, g8_collect_class_spec_from_value($e, $all, $lls, $acc)) }
            }
        }
        SExpr($e) { g8_collect_class_specs_expr($e, $all, $lls, $acc) }
        SWhile($c, $b) { g8_collect_class_specs_stmts($b, $all, $lls, $acc) }
        SFor($vars, $it, $b) { g8_collect_class_specs_stmts($b, $all, g8_for_locals($vars, $it, $all, $lls), $acc) }
        SHatch($b) { g8_collect_class_specs_stmts($b, $all, $lls, $acc) }
        SSelect($arms, $els) { g8_collect_class_specs_select($arms, $els, $all, $lls, $acc) }
    }
}

sub g8_collect_class_specs_select($arms: SelectArmList, $els: Option[StmtList], $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $arms {
        SelectArmNil { match $els { None { $acc } Some($b) { g8_collect_class_specs_stmts($b, $all, $lls, $acc) } } }
        SelectArmCons($h, $t) {
            $a1 = g8_collect_class_specs_expr($h.op, $all, $lls, $acc)
            $body_lls = g8_select_arm_locals($h, $all, $lls)
            g8_collect_class_specs_select($t, $els, $all, $lls, g8_collect_class_specs_stmts($h.body, $all, $body_lls, $a1))
        }
    }
}

sub g8_collect_class_specs_expr($e: Expr, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $e {
        EIf($c, $then, $elifs, $els) {
            $a1 = g8_collect_class_specs_stmts($then, $all, $lls, $acc)
            $a2 = g8_collect_class_specs_elifs($elifs, $all, $lls, $a1)
            match $els {
                None { $a2 }
                Some($b) { g8_collect_class_specs_stmts($b, $all, $lls, $a2) }
            }
        }
        EMatch($subj, $arms) { g8_collect_class_specs_arms($subj, $arms, $all, $lls, $acc) }
        _ { $acc }
    }
}

sub g8_collect_class_specs_elifs($elifs: ElifList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $elifs {
        ElifNil { $acc }
        ElifCons($h, $t) { g8_collect_class_specs_elifs($t, $all, $lls, g8_collect_class_specs_stmts($h.body, $all, $lls, $acc)) }
    }
}

sub g8_collect_class_specs_arms($subj: Expr, $arms: ArmList, $all: DeclList, $lls: G5gBinds, $acc: DeclList): DeclList {
    match $arms {
        ArmNil { $acc }
        ArmCons($h, $t) {
            $body_lls = g8_match_arm_locals($h.pat, $subj, $all, $lls)
            g8_collect_class_specs_arms($subj, $t, $all, $lls, g8_collect_class_specs_stmts($h.body, $all, $body_lls, $acc))
        }
    }
}

# ---- P5b-2e: bare-template enum returns (native resolveBareTemplateEnumMethodReturns) ----
# A monomorphized spec sub whose declared return is the BARE owning generic-enum
# template name (`sub make($v: T): Box` cloned into Box__Int) kept that
# annotation through cloning (no type args to substitute), yet its body yields a
# CONCRETE spec. After expansion appends the specs, rewrite each such return to
# the spec inferred from the sub's trailing variant-constructor expression; a
# sub whose return still names a generic template afterwards is DROPPED, so
# calls to it decline rc 4 honestly (the exact bar the old drop-at-clone set).

# The trailing expression of a sub body (native subTrailingCall's input): the
# ExprBody itself, or the final SExpr / value-carrying SReturn of a BlockBody.
sub g8_stmts_trailing_expr($stmts: StmtList): Option[Expr] {
    match $stmts {
        StmtNil { None }
        StmtCons($h, $t) {
            match $t {
                StmtCons($h2, $t2) { g8_stmts_trailing_expr($t) }
                StmtNil {
                    match $h {
                        SExpr($e) { Some($e) }
                        SReturn($ov) { $ov }
                        _ { None }
                    }
                }
            }
        }
    }
}

sub g8_sub_trailing_expr($sub: SubDecl): Option[Expr] {
    match $sub.body {
        ExprBody($e) { Some($e) }
        BlockBody($stmts) { g8_stmts_trailing_expr($stmts) }
    }
}

sub g8_param_bare_ty($params: ParamList, $n: Str): Option[Str] {
    match $params {
        ParamNil { None }
        ParamCons($p, $t) {
            if $p.name == $n {
                match $p.ty {
                    None { None }
                    Some($tr) {
                        match $tr.args {
                            TypeNil { Some($tr.name) }
                            TypeCons($a0, $at) { None }
                        }
                    }
                }
            } else {
                g8_param_bare_ty($t, $n)
            }
        }
    }
}

sub g8_param_ty($params: ParamList, $n: Str): Option[TypeRef] {
    match $params {
        ParamNil { None }
        ParamCons($p, $t) {
            if $p.name == $n {
                $p.ty
            } else {
                g8_param_ty($t, $n)
            }
        }
    }
}

sub g8_class_field_ty($fields: ClassFieldList, $name: Str): Option[TypeRef] {
    match $fields {
        ClassFieldNil { None }
        ClassFieldCons($f, $rest) {
            if $f.name == $name {
                $f.ty
            } else {
                g8_class_field_ty($rest, $name)
            }
        }
    }
}

# The spec-name tag a trailing-constructor argument contributes: a scalar
# literal maps to its kind, a plain name reads the (already-substituted, so
# concrete) parameter annotation of the enclosing spec sub (native
# enumSpecBodyArgType), and anything else falls back to the concrete
# user-type probe used by ordinary value discovery.
sub g8_spec_body_arg_tag($arg: Expr, $sub: SubDecl, $all: DeclList): Option[Str] {
    match g8_lit_type_tag($arg) {
        Some($t) { Some($t) }
        None {
            match $arg {
                EName($n) { g8_param_bare_ty($sub.params, $n) }
                _ { g8_value_type_tag($arg, $all) }
            }
        }
    }
}

sub g8_class_spec_body_arg_type($arg: Expr, $spec: ClassDecl, $sub: SubDecl): Option[TypeRef] {
    match g8_lit_type_tag($arg) {
        Some($t) { Some(TypeRef(name: $t, args: TypeNil)) }
        None {
            match $arg {
                EName($n) {
                    if $n == '$self' {
                        None
                    } else {
                        g8_param_ty($sub.params, $n)
                    }
                }
                EField($obj, $field) {
                    match $obj {
                        EName($recv) {
                            if $recv == '$self' {
                                g8_class_field_ty($spec.fields, $field)
                            } else {
                                None
                            }
                        }
                        _ { None }
                    }
                }
                _ { None }
            }
        }
    }
}

sub g8_class_body_targ_from_types($tp: Str, $field_ty: TypeRef, $arg_ty: TypeRef): Option[TypeRef] {
    match $field_ty.args {
        TypeNil {
            if $field_ty.name == $tp { Some($arg_ty) } else { None }
        }
        TypeCons($h0, $t0) {
            match $t0 {
                TypeCons($h1, $t1) { None }
                TypeNil {
                    if $field_ty.name == "List" && g5g_type_is_bare($h0) && $h0.name == $tp && $arg_ty.name == "List" {
                        match $arg_ty.args {
                            TypeCons($a0, $at0) {
                                match $at0 {
                                    TypeNil { Some($a0) }
                                    TypeCons($a1, $at1) { None }
                                }
                            }
                            TypeNil { None }
                        }
                    } else {
                        None
                    }
                }
            }
        }
    }
}

sub g8_class_body_targ_for_tp($tp: Str, $fields: ClassFieldList, $args: ExprList, $sub: SubDecl, $spec: ClassDecl): Option[TypeRef] {
    match $fields {
        ClassFieldNil { None }
        ClassFieldCons($f, $rest) {
            match $f.ty {
                None { g8_class_body_targ_for_tp($tp, $rest, $args, $sub, $spec) }
                Some($fty) {
                    match g8_named_arg_value($args, $f.name) {
                        None { g8_class_body_targ_for_tp($tp, $rest, $args, $sub, $spec) }
                        Some($arg) {
                            match g8_class_spec_body_arg_type($arg, $spec, $sub) {
                                None { g8_class_body_targ_for_tp($tp, $rest, $args, $sub, $spec) }
                                Some($aty) {
                                    match g8_class_body_targ_from_types($tp, $fty, $aty) {
                                        Some($out) { Some($out) }
                                        None { g8_class_body_targ_for_tp($tp, $rest, $args, $sub, $spec) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_bind_class_body_targs($tps: StrList, $fields: ClassFieldList, $args: ExprList, $sub: SubDecl, $spec: ClassDecl): Option[TypeList] {
    match $tps {
        StrNil { Some(TypeNil) }
        StrCons($tp, $rest) {
            match g8_class_body_targ_for_tp($tp, $fields, $args, $sub, $spec) {
                None { None }
                Some($tr) {
                    match g8_bind_class_body_targs($rest, $fields, $args, $sub, $spec) {
                        None { None }
                        Some($tail) { Some(TypeCons($tr, $tail)) }
                    }
                }
            }
        }
    }
}

sub g8_infer_class_ret_spec_decl($sub: SubDecl, $owner: ClassDecl, $all: DeclList): Option[ClassDecl] {
    match g8_sub_trailing_expr($sub) {
        None { None }
        Some($e) {
            match $e {
                ECall($callee, $args) {
                    match $callee {
                        ETypeName($cn) {
                            match g8_find_generic_class_template($all, $cn) {
                                None { None }
                                Some($tmpl) {
                                    match g8_bind_class_body_targs($tmpl.tparams, $tmpl.fields, $args, $sub, $owner) {
                                        None { None }
                                        Some($targs) { g8_clone_generic_class_spec($tmpl, $targs, $all) }
                                    }
                                }
                            }
                        }
                        _ { None }
                    }
                }
                _ { None }
            }
        }
    }
}

sub g8_spec_body_tag_for_tp($tp: Str, $fields: ParamList, $args: ExprList, $sub: SubDecl, $all: DeclList): Option[Str] {
    match $fields {
        ParamNil { None }
        ParamCons($f, $frest) {
            match $args {
                ExprNil { None }
                ExprCons($a, $arest) {
                    match $f.ty {
                        None { g8_spec_body_tag_for_tp($tp, $frest, $arest, $sub, $all) }
                        Some($tr) {
                            match $tr.args {
                                TypeCons($h0, $t0) { g8_spec_body_tag_for_tp($tp, $frest, $arest, $sub, $all) }
                                TypeNil {
                                    if $tr.name == $tp {
                                        match g8_spec_body_arg_tag($a, $sub, $all) {
                                            Some($tag) { Some($tag) }
                                            None { g8_spec_body_tag_for_tp($tp, $frest, $arest, $sub, $all) }
                                        }
                                    } else {
                                        g8_spec_body_tag_for_tp($tp, $frest, $arest, $sub, $all)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_bind_spec_body_tags($tps: StrList, $fields: ParamList, $args: ExprList, $sub: SubDecl, $all: DeclList): Option[StrList] {
    match $tps {
        StrNil { Some(StrNil) }
        StrCons($tp, $rest) {
            match g8_spec_body_tag_for_tp($tp, $fields, $args, $sub, $all) {
                None { None }
                Some($tag) {
                    match g8_bind_spec_body_tags($rest, $fields, $args, $sub, $all) {
                        None { None }
                        Some($tail) { Some(StrCons($tag, $tail)) }
                    }
                }
            }
        }
    }
}

# Iterate ALL generic enum templates owning variant $vn (native iterates its
# candidate list); the first whose type params fully bind from the constructor
# args AND whose concrete spec already exists wins. Rewrites never CREATE a
# spec (native's enum pass has the same bound).
sub g8_infer_variant_ret_spec($decls: DeclList, $vn: Str, $args: ExprList, $sub: SubDecl, $all: DeclList): Option[Str] {
    match $decls {
        DeclNil { None }
        DeclCons($head, $tail) {
            match $head {
                DEnum($tmpl) {
                    if strlist_empty($tmpl.tparams) {
                        g8_infer_variant_ret_spec($tail, $vn, $args, $sub, $all)
                    } else {
                        match g8_variant_fields_of($tmpl.variants, $vn) {
                            None { g8_infer_variant_ret_spec($tail, $vn, $args, $sub, $all) }
                            Some($vfields) {
                                match g8_bind_spec_body_tags($tmpl.tparams, $vfields, $args, $sub, $all) {
                                    None { g8_infer_variant_ret_spec($tail, $vn, $args, $sub, $all) }
                                    Some($parts) {
                                        $sn = $tmpl.name ~ "__" ~ strlist_join_underscore($parts)
                                        if decl_enum_named($all, $sn) {
                                            Some($sn)
                                        } else {
                                            g8_infer_variant_ret_spec($tail, $vn, $args, $sub, $all)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { g8_infer_variant_ret_spec($tail, $vn, $args, $sub, $all) }
            }
        }
    }
}

sub g8_infer_bare_ret_spec($sub: SubDecl, $all: DeclList): Option[Str] {
    match g8_sub_trailing_expr($sub) {
        None { None }
        Some($e) {
            match $e {
                ECall($callee, $args) {
                    match $callee {
                        ETypeName($vn) { g8_infer_variant_ret_spec($all, $vn, $args, $sub, $all) }
                        _ { None }
                    }
                }
                _ { None }
            }
        }
    }
}

sub g8_collect_bare_class_return_specs_subs($subs: SubDeclList, $owner: ClassDecl, $all: DeclList, $acc: DeclList): DeclList {
    match $subs {
        SubDeclNil { $acc }
        SubDeclCons($h, $t) {
            $a1 = if !strlist_empty($h.tparams) {
                $acc
            } else {
                match $h.ret {
                    None { $acc }
                    Some($tr) {
                        match $tr.args {
                            TypeCons($a0, $at) { $acc }
                            TypeNil {
                                match g8_find_generic_class_template($all, $tr.name) {
                                    None { $acc }
                                    Some($tmpl) {
                                        match g8_infer_class_ret_spec_decl($h, $owner, $all) {
                                            None { $acc }
                                            Some($spec) {
                                                if decl_class_named($all, $spec.name) || decl_class_named($acc, $spec.name) {
                                                    $acc
                                                } else {
                                                    g8_add_class_spec($spec, $acc)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            g8_collect_bare_class_return_specs_subs($t, $owner, $all, $a1)
        }
    }
}

sub g8_collect_bare_class_return_specs($decls: DeclList, $all: DeclList, $acc: DeclList): DeclList {
    match $decls {
        DeclNil { $acc }
        DeclCons($head, $tail) {
            $a1 = match $head {
                DClass($c) {
                    if strlist_empty($c.tparams) {
                        g8_collect_bare_class_return_specs_subs($c.subs, $c, $all, $acc)
                    } else {
                        $acc
                    }
                }
                _ { $acc }
            }
            g8_collect_bare_class_return_specs($tail, $all, $a1)
        }
    }
}

sub g8_materialize_bare_class_returns($decls: DeclList): DeclList {
    $new = g8_collect_bare_class_return_specs($decls, $decls, DeclNil)
    match $new {
        DeclNil { $decls }
        DeclCons($h, $t) { g8_materialize_bare_class_returns(g5g_decl_append($decls, $new)) }
    }
}

# Rewrite one spec sub's bare-template return, keep it unchanged when the
# return is anything else, or report None to DROP it (still a bare template
# name but the body's spec can't be inferred / doesn't exist).
sub g8_fix_bare_ret_sub($sub: SubDecl, $owner: ClassDecl, $all: DeclList): Option[SubDecl] {
    match $sub.ret {
        None { Some($sub) }
        Some($tr) {
            match $tr.args {
                TypeCons($a0, $at) { Some($sub) }
                TypeNil {
                    match g8_find_generic_enum_template($all, $tr.name) {
                        None {
                            match g8_find_generic_class_template($all, $tr.name) {
                                None { Some($sub) }
                                Some($ctmpl) {
                                    match g8_infer_class_ret_spec_decl($sub, $owner, $all) {
                                        None { None }
                                        Some($spec) {
                                            if decl_class_named($all, $spec.name) {
                                                Some(SubDecl(public: $sub.public, name: $sub.name, line: $sub.line, col: $sub.col, body_line: $sub.body_line, body_col: $sub.body_col, tparams: $sub.tparams, params: $sub.params, ret: Some(TypeRef(name: $spec.name, args: TypeNil)), body: $sub.body))
                                            } else {
                                                None
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Some($tmpl) {
                            match g8_infer_bare_ret_spec($sub, $all) {
                                None { None }
                                Some($sn) { Some(SubDecl(public: $sub.public, name: $sub.name, line: $sub.line, col: $sub.col, body_line: $sub.body_line, body_col: $sub.body_col, tparams: $sub.tparams, params: $sub.params, ret: Some(TypeRef(name: $sn, args: TypeNil)), body: $sub.body)) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_fix_bare_ret_subs($subs: SubDeclList, $owner: ClassDecl, $all: DeclList): SubDeclList {
    match $subs {
        SubDeclNil { SubDeclNil }
        SubDeclCons($h, $t) {
            $rest = g8_fix_bare_ret_subs($t, $owner, $all)
            if !strlist_empty($h.tparams) {
                # Generic METHOD templates stay verbatim (skipped downstream).
                SubDeclCons($h, $rest)
            } else {
                match g8_fix_bare_ret_sub($h, $owner, $all) {
                    None { $rest }
                    Some($fs) { SubDeclCons($fs, $rest) }
                }
            }
        }
    }
}

sub g8_resolve_bare_enum_returns($decls: DeclList, $all: DeclList): DeclList {
    match $decls {
        DeclNil { DeclNil }
        DeclCons($head, $tail) {
            match $head {
                DEnum($e) {
                    if strlist_empty($e.tparams) {
                        DeclCons(DEnum(EnumDecl(public: $e.public, name: $e.name, tparams: $e.tparams, variants: $e.variants, subs: g8_fix_bare_ret_subs($e.subs, ClassDecl(public: false, name: "", tparams: StrNil, fields: ClassFieldNil, subs: SubDeclNil), $all))), g8_resolve_bare_enum_returns($tail, $all))
                    } else {
                        DeclCons($head, g8_resolve_bare_enum_returns($tail, $all))
                    }
                }
                DClass($c) {
                    if strlist_empty($c.tparams) {
                        DeclCons(DClass(ClassDecl(public: $c.public, name: $c.name, tparams: $c.tparams, fields: $c.fields, subs: g8_fix_bare_ret_subs($c.subs, $c, $all))), g8_resolve_bare_enum_returns($tail, $all))
                    } else {
                        DeclCons($head, g8_resolve_bare_enum_returns($tail, $all))
                    }
                }
                _ { DeclCons($head, g8_resolve_bare_enum_returns($tail, $all)) }
            }
        }
    }
}

sub g8_expand_generic_classes($decls: DeclList): DeclList {
    $class_specs0 = g8_collect_generic_class_specs($decls, $decls, DeclNil)
    $class_specs = if g8_has_generic_class_template($decls) {
        g8_collect_class_bodies($decls, $decls, $class_specs0)
    } else {
        $class_specs0
    }
    $enum_specs = if g8_has_generic_enum_template($decls) {
        g8_collect_generic_enum_specs($decls, $decls, DeclNil)
    } else {
        DeclNil
    }
    $out0 = g5g_decl_append($decls, g5g_decl_append($class_specs, $enum_specs))
    # P5b-2b(class-template-return): class methods can return a spec that has
    # no construction site yet (`Pair__Int_Str.swapped()` -> `Pair__Str_Int`).
    # Materialize those specs to a fixpoint before rewriting bare returns.
    $out = if g8_has_generic_class_template($decls) {
        g8_materialize_bare_class_returns($out0)
    } else {
        $out0
    }
    # P5b-2e / class-template-return: bare-template returns rewrite/drop, gated
    # so the compiler's own generic-free source never pays for the walk.
    if g8_has_generic_enum_template($decls) || g8_has_generic_class_template($decls) {
        g8_resolve_bare_enum_returns($out, $out)
    } else {
        $out
    }
}

sub g8_generic_class_name_from_type($tr: TypeRef): Option[Str] {
    match $tr.args {
        TypeNil { None }
        TypeCons($arg0, $argtail) {
            match g8_class_field_tags(ClassFieldCons(ClassField(public: true, sigil: "$", name: "_", ty: Some($arg0)), g8_type_args_as_fields($argtail))) {
                None { None }
                Some($parts) { Some($tr.name ~ "__" ~ strlist_join_underscore($parts)) }
            }
        }
    }
}

sub g8_generic_enum_name_from_type($tr: TypeRef): Option[Str] {
    match $tr.args {
        TypeNil { None }
        TypeCons($arg0, $argtail) {
            match g8_class_field_tags(ClassFieldCons(ClassField(public: true, sigil: "$", name: "_", ty: Some($arg0)), g8_type_args_as_fields($argtail))) {
                None { None }
                Some($parts) { Some($tr.name ~ "__" ~ strlist_join_underscore($parts)) }
            }
        }
    }
}

sub g8_type_args_as_fields($args: TypeList): ClassFieldList {
    match $args {
        TypeNil { ClassFieldNil }
        TypeCons($h, $t) { ClassFieldCons(ClassField(public: true, sigil: "$", name: "_", ty: Some($h)), g8_type_args_as_fields($t)) }
    }
}

sub g8_class_field_lookup($fs: CgClassFieldInfoList, $name: Str): Option[CgClassField] {
    match $fs {
        CgClassFieldNil { None }
        CgClassFieldCons($h, $t) { if $h.name == $name { Some($h) } else { g8_class_field_lookup($t, $name) } }
    }
}

sub g8_class_kind_from_type($ty: Option[TypeRef], $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            match cg_env_lookup_class($env, $tr.name) {
                Some($info) { Ok(CgClass($tr.name)) }
                None {
                    match g8_generic_class_name_from_type($tr) {
                        None { Err(g3_unsupported()) }
                        Some($specn) {
                            match cg_env_lookup_class($env, $specn) {
                                Some($info) { Ok(CgClass($specn)) }
                                None { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_class_kind_from_block($stmts: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match g6e_block_final_expr($stmts) {
        None { Err(g3_unsupported()) }
        Some($e) { g8_class_kind_from_value($e, $env) }
    }
}

sub g8_class_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g8_class_kind_from_block($arm.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g8_class_kind_from_arms($rest, $env) }
            }
        }
    }
}

# P5b-2b(c-class-value): resolve an unannotated generic-class constructor
# (`Box(value: 42)`) to the concrete monomorphized spec that g8_expand_generic_classes
# registered (`Box__Int`). The template name is not a registered class, so walk the
# env for a concrete class named `<base>__…` whose field KINDS match the constructor's
# scalar named args (mirrors g6e_enum_name_from_variant_args' arg-kind disambiguation:
# `Box__Int` and `Box__Str` both start with `Box__`, so field kinds decide which).
sub g8_class_fields_match_args($fields: CgClassFieldInfoList, $args: ExprList, $env: CgEnv): Bool {
    match $fields {
        CgClassFieldNil { true }
        CgClassFieldCons($f, $frest) {
            match g8_named_arg_value($args, $f.name) {
                None { false }
                Some($a) {
                    g8_structural_value_kind_matches($f.kind, $a, $env) &&
                        g8_class_fields_match_args($frest, $args, $env)
                }
            }
        }
    }
}

# Structural constructor-argument matching for generic class specs. The ordinary
# expression classifier handles scalar/call/name values; collection literals and
# direct Some/None constructors are resolved against the candidate field kind.
sub g8_structural_value_kind_matches($fk: CgKind, $a: Expr, $env: CgEnv): Bool {
    match g5_kind_from_expr($a, $env) {
        Some($ak) { cgkind_eq($fk, $ak) }
        None {
            match $fk {
                CgList($ek) {
                    match g7_list_kind_from_value($a, $env) {
                        Ok($actual) { cgkind_eq($ek, $actual) }
                        Err($m) { false }
                    }
                }
                CgMap($vk) {
                    match g7_map_val_kind_from_value($a, $env) {
                        Ok($actual) { cgkind_eq($vk, $actual) }
                        Err($m) { false }
                    }
                }
                _ {
                    if g6_is_option_kind($fk) {
                        match $a {
                            ETypeName($n) { $n == "None" }
                            ECall($callee, $args) {
                                match $callee {
                                    ETypeName($n) {
                                        if $n == "Some" {
                                            match g6_option_payload_kind($fk) {
                                                Err($m) { false }
                                                Ok($payload) {
                                                    match $args {
                                                        ExprCons($h, ExprNil) { g8_structural_value_kind_matches($payload, $h, $env) }
                                                        _ { false }
                                                    }
                                                }
                                            }
                                        } else {
                                            false
                                        }
                                    }
                                    _ { false }
                                }
                            }
                            _ {
                                match g6_option_kind_from_value($a, $env) {
                                    Ok($actual) { cgkind_eq($fk, $actual) }
                                    Err($m) { false }
                                }
                            }
                        }
                    } else {
                        false
                    }
                }
            }
        }
    }
}

# Kept as a compatibility entry point for enum-constructor selection, which
# historically shared the class generic literal matcher under this name.
sub g8_list_lit_kind_matches($fk: CgKind, $a: Expr, $env: CgEnv): Bool {
    g8_structural_value_kind_matches($fk, $a, $env)
}

sub g8_generic_class_name_from_value($env: CgEnv, $full: CgEnv, $base: Str, $args: ExprList): Result[Str, Str] {
    match $env {
        CgEnvNil { Err(g3_unsupported()) }
        CgEnvCons($h, $t) { g8_generic_class_name_from_value($t, $full, $base, $args) }
        CgEnvSub($s, $t) { g8_generic_class_name_from_value($t, $full, $base, $args) }
        CgEnvEnum($e, $t) { g8_generic_class_name_from_value($t, $full, $base, $args) }
        CgEnvClass($c, $t) {
            if starts_with($c.name, $base ~ "__") && g8_class_fields_match_args($c.fields, $args, $full) {
                Ok($c.name)
            } else {
                g8_generic_class_name_from_value($t, $full, $base, $args)
            }
        }
        CgEnvSubIdx($i, $t) { g8_generic_class_name_from_value($t, $full, $base, $args) }
    }
}

sub g8_class_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $value {
        ECall($callee, $args) {
            match $callee {
                ETypeName($n) {
                    match cg_env_lookup_class($env, $n) {
                        Some($info) { Ok(CgClass($n)) }
                        None {
                            match g8_generic_class_name_from_value($env, $env, $n, $args) {
                                Ok($specn) { Ok(CgClass($specn)) }
                                Err($m) { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                EQualified($module, $member) {
                    match g9_qualified_class_name($module, $member, $env) {
                        Some($n) { Ok(CgClass($n)) }
                        None { Err(g3_unsupported()) }
                    }
                }
                _ {
                    match g5_resolve_call_target($callee, $args, $env) {
                        Err($m) { Err($m) }
                        Ok($target) {
                            match $target.sig.ret {
                                RClass($n) { Ok(CgClass($n)) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($var) { match $var.kind { CgClass($cn) { Ok(CgClass($cn)) } _ { Err(g3_unsupported()) } } }
                None { Err(g3_unsupported()) }
            }
        }
        EMatch($subj, $arms) { g8_class_kind_from_arms($arms, $env) }
        # An unannotated binding from a CLASS-typed field read (`$i = $obj.field`
        # where `field` is a nested by-value class, slice 5 E5d-8j) infers its kind
        # from the resolved field access, mirroring the EName case above. The actual
        # value lowering happens in g8_class_value's EField arm.
        EField($fobj, $fname) {
            match g8_resolve_field_acc($fobj, $fname, $env) {
                Err($m) { Err($m) }
                Ok($fa) {
                    match $fa.kind {
                        CgClass($cn) { Ok(CgClass($cn)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EIndex($obj, $idx) {
            match g7_list_kind_from_value($obj, $env) {
                Ok(CgClass($cn)) { Ok(CgClass($cn)) }
                _ {
                    match g7_map_val_kind_from_value($obj, $env) {
                        Ok(CgClass($cn)) { Ok(CgClass($cn)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g8_named_arg_value($args: ExprList, $name: Str): Option[Expr] {
    match $args {
        ExprNil { None }
        ExprCons($h, $t) {
            match $h {
                ENamedArg($n, $v) { if $n == $name { Some($v) } else { g8_named_arg_value($t, $name) } }
                _ { g8_named_arg_value($t, $name) }
            }
        }
    }
}

sub g8_lower_ctor_fields($fs: CgClassFieldInfoList, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgClassCtorOut, Str] {
    match $fs {
        CgClassFieldNil { Ok(CgClassCtorOut(state: $state, fields: "")) }
        CgClassFieldCons($f, $rest) {
            if !g8_class_field_supported($f.kind) {
                Err(g3_unsupported())
            } else {
                match g8_named_arg_value($args, $f.name) {
                    None { Err(g3_unsupported()) }
                    Some($arg) {
                        # EB-1b/1c: CgBoxEnum/CgBoxClass fields and cyclic
                        # Option-carrier fields allocate counted heap boxes around
                        # the lowered value; other fields stay by value.
                        $field_state = if $f.boxcarrier {
                            g6e_lower_boxed_carrier_arg($f.kind, $arg, $state, $env)
                        } else {
                            g6e_lower_field_value($f.kind, $arg, $state, $env)
                        }
                        match $field_state {
                            Err($m) { Err($m) }
                            Ok($fv) {
                                match g8_lower_ctor_fields($rest, $args, $fv.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($tail) {
                                        $sep = if $tail.fields == "" { "" } else { ", " }
                                        Ok(CgClassCtorOut(state: $tail.state, fields: $fv.c ~ $sep ~ $tail.fields))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g8_class_retain($name: Str, $c: Str): Str {
    "\tguji_retain_" ~ $name ~ "_fields(&" ~ $c ~ ");\n"
}

sub g8_class_release($name: Str, $c: Str): Str {
    "\tguji_release_" ~ $name ~ "_fields(&" ~ $c ~ ");\n"
}

sub g8_class_value($name: Str, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_class($env, $name) {
        None { Err(g3_unsupported()) }
        Some($info) {
            match $value {
                ECall($callee, $args) {
                    match $callee {
                        ETypeName($n) {
                            if $n == $name || starts_with($name, $n ~ "__") {
                                match g8_lower_ctor_fields($info.fields, $args, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($ctor) { Ok(CgValueOut(state: $ctor.state, c: "(" ~ $name ~ ")\{" ~ $ctor.fields ~ "}")) }
                                }
                            } else {
                                g5_call_value(RClass($name), $callee, $args, $state, $env)
                            }
                        }
                        EQualified($module, $member) {
                            match g9_qualified_class_name($module, $member, $env) {
                                Some($actual) {
                                    if $actual == $name {
                                        match g8_lower_ctor_fields($info.fields, $args, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($ctor) { Ok(CgValueOut(state: $ctor.state, c: "(" ~ $name ~ ")\{" ~ $ctor.fields ~ "}")) }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                None { g5_call_value(RClass($name), $callee, $args, $state, $env) }
                            }
                        }
                        _ { g5_call_value(RClass($name), $callee, $args, $state, $env) }
                    }
                }
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($var) {
                            match $var.kind {
                                CgClass($actual) {
                                    if $actual == $name {
                                        Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g8_class_retain($name, $var.cname), nstr: $state.nstr, ntmp: $state.ntmp), c: $var.cname))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                # Reading a CLASS-typed field of a class as a class VALUE (slice 5
                # E5d-8j): `$obj.field` where `field` is a by-value nested class.
                # `g8_resolve_field_acc` builds the lvalue accessor (`cname.fN`,
                # possibly chained through further by-value class members); the read
                # then RETAINS the accessed struct's owned fields in place so the
                # consuming copy (binding/ctor field/call arg) owns its own
                # references — the by-value struct copy aliases the same Str/heap
                # pointers, exactly as the EName case retains a class variable. The
                # field kind must be the SAME class the position wants. NATIVE rejects
                # nested-class fields, so this is interp-oracle (COVERED-BEYOND) work.
                EField($fobj, $fname) {
                    match g8_resolve_field_acc($fobj, $fname, $env) {
                        Err($m) { Err($m) }
                        Ok($fa) {
                            match $fa.kind {
                                CgClass($actual) {
                                    if $actual == $name {
                                        Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g8_class_retain($name, $fa.acc), nstr: $state.nstr, ntmp: $state.ntmp), c: $fa.acc))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                EIndex($obj, $idx) { g7_lower_index(CgClass($name), $obj, $idx, $state, $env) }
                EIf($cond, $then, $elifs, $els) { g4_lower_if_value(CgClass($name), $cond, $then, $elifs, $els, $state, $env) }
                EMatch($subj, $arms) { g6_lower_match(CgClass($name), $subj, $arms, $state, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g8_lower_one_class_arg($name: Str, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $arg {
        EName($vn) {
            match cg_env_lookup($env, $vn) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgClass($actual) {
                            if $actual == $name { Ok(CgArgsOut(state: $state, args: $var.cname, releases: "")) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ {
            match g8_class_value($name, $arg, $state, $env) {
                Err($m) { Err($m) }
                Ok($cv) {
                    $tmp = g4_value_tmp(CgClass($name), $cv.state.ntmp)
                    Ok(CgArgsOut(
                        state: CgState(
                            interns: $cv.state.interns,
                            decls: $cv.state.decls ~ g4_value_decl(CgClass($name), $tmp),
                            body: $cv.state.body ~ "\t" ~ $tmp ~ " = " ~ $cv.c ~ ";\n",
                            nstr: $cv.state.nstr,
                            ntmp: $cv.state.ntmp + 1
                        ),
                        args: $tmp,
                        releases: g8_class_release($name, $tmp)
                    ))
                }
            }
        }
    }
}

# Build the (accessor, kind) for one resolved class field off a base accessor.
# EB-1b: a cross-cycle-broken field is a counted heap POINTER, so reading it
# dereferences the box (`(*(base.fN))`) and reports the UNWRAPPED kind. Every
# downstream consumer (g8_lower_field_value's CgEnum/CgClass arms, the by-value
# nested-class chain) then treats it as an ordinary by-value member — the read copies
# the wrapped struct and retains its owned fields, so the box still owns its own copy
# (balanced at the box's rc==0 drop). A plain field is the bare member, unchanged.
sub g8_field_acc_of($baseacc: Str, $basebox: Bool, $f: CgClassField): CgFieldAcc {
    if $f.boxcarrier {
        CgFieldAcc(acc: "(*(" ~ $baseacc ~ ".f" ~ c_int($f.index) ~ "))", kind: $f.kind, viabox: true)
    } else {
        match $f.kind {
            CgBoxEnum($n) { CgFieldAcc(acc: "(*(" ~ $baseacc ~ ".f" ~ c_int($f.index) ~ "))", kind: CgEnum($n), viabox: true) }
            CgBoxClass($n) { CgFieldAcc(acc: "(*(" ~ $baseacc ~ ".f" ~ c_int($f.index) ~ "))", kind: CgClass($n), viabox: true) }
            # A plain field stays a cleanup-stable member, but a box ANYWHERE earlier on
            # the chain ($basebox) taints the whole accessor (it still derefs the box), so
            # the via-box flag propagates outward.
            _ { CgFieldAcc(acc: $baseacc ~ ".f" ~ c_int($f.index), kind: $f.kind, viabox: $basebox) }
        }
    }
}

# Resolve a field-access expression to a C member accessor + the field's CgKind.
# The base may be a plain class variable (`$obj.field` -> `cname.fN`) OR another
# field access into a BY-VALUE nested class (`$obj.f0.n` -> `cname.f0.fM`): the
# nested case recurses, requiring each intermediate field to be a `CgClass` so the
# chain stays within owned by-value members (slice 5 E4b-2c). No C is emitted —
# only the accessor string is built — so this is pure and side-effect free.
sub g8_resolve_field_acc($obj: Expr, $field: Str, $env: CgEnv): Result[CgFieldAcc, Str] {
    match $obj {
        EName($name) {
            match cg_env_lookup($env, $name) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgClass($cn) {
                            match cg_env_lookup_class($env, $cn) {
                                None { Err(g3_unsupported()) }
                                Some($info) {
                                    match g8_class_field_lookup($info.fields, $field) {
                                        None { Err(g3_unsupported()) }
                                        Some($f) { Ok(g8_field_acc_of($var.cname, false, $f)) }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EField($inner, $iname) {
            match g8_resolve_field_acc($inner, $iname, $env) {
                Err($m) { Err($m) }
                Ok($base) {
                    match $base.kind {
                        CgClass($cn) {
                            match cg_env_lookup_class($env, $cn) {
                                None { Err(g3_unsupported()) }
                                Some($info) {
                                    match g8_class_field_lookup($info.fields, $field) {
                                        None { Err(g3_unsupported()) }
                                        Some($f) { Ok(g8_field_acc_of($base.acc, $base.viabox, $f)) }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Field access whose OBJECT is not a stable lvalue — e.g. a CALL result like
# `cg_reg_result().variants` (slice 5 E5d-8v). `g8_resolve_field_acc` only builds
# pure C accessors over bound variables / by-value nested members, so it cannot reach
# a call result. Here the class value is MATERIALISED into an owned temp, the field is
# copied out into an INDEPENDENT value (retaining owned payloads), and the temp's own
# fields are released afterward so the transient ownership is dropped exactly once. The
# produced value therefore stays valid after the temp dies. Native rejects most such
# class fields (enum/class), so those cases are interp-oracle; the scalar/Str cases
# also clear the three-way bar.
sub g8_lower_field_via_temp($want: CgKind, $obj: Expr, $field: Str, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g8_class_kind_from_value($obj, $env) {
        Err($m) { Err($m) }
        Ok($okind) {
            match $okind {
                CgClass($cn) {
                    match cg_env_lookup_class($env, $cn) {
                        None { Err(g3_unsupported()) }
                        Some($info) {
                            match g8_class_field_lookup($info.fields, $field) {
                                None { Err(g3_unsupported()) }
                                Some($f) {
                                    if cgkind_eq($want, $f.kind) {
                                        match g8_class_value($cn, $obj, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($cv) {
                                                $otmp = g4_value_tmp(CgClass($cn), $cv.state.ntmp)
                                                $s1 = CgState(
                                                    interns: $cv.state.interns,
                                                    decls: $cv.state.decls ~ g4_value_decl(CgClass($cn), $otmp),
                                                    body: $cv.state.body ~ "\t" ~ $otmp ~ " = " ~ $cv.c ~ ";\n",
                                                    nstr: $cv.state.nstr,
                                                    ntmp: $cv.state.ntmp + 1
                                                )
                                                g8_field_copy_release($want, $otmp ~ ".f" ~ c_int($f.index), $cn, $otmp, $s1)
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Copy the field at C accessor `$acc` (a member of the just-materialised owned class
# temp `$otmp`, of class `$owner`) into a fresh INDEPENDENT value temp, then release
# `$otmp`'s owned fields. Owned payloads (Str/enum/class) are retained on the copy
# BEFORE `$otmp` is released so the net ownership lands on the copy; scalar copies are
# by value. The release is emitted AFTER the copy so the produced temp survives it.
sub g8_field_copy_release($want: CgKind, $acc: Str, $owner: Str, $otmp: Str, $state: CgState): Result[CgValueOut, Str] {
    match $want {
        CgInt {
            $t = g4_value_tmp(CgInt, $state.ntmp)
            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl(CgInt, $t), body: $state.body ~ "\t" ~ $t ~ " = " ~ $acc ~ ";\n" ~ g8_class_release($owner, $otmp), nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $t))
        }
        CgBool {
            $t = g4_value_tmp(CgBool, $state.ntmp)
            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl(CgBool, $t), body: $state.body ~ "\t" ~ $t ~ " = " ~ $acc ~ ";\n" ~ g8_class_release($owner, $otmp), nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $t))
        }
        CgFloat {
            $t = g4_value_tmp(CgFloat, $state.ntmp)
            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl(CgFloat, $t), body: $state.body ~ "\t" ~ $t ~ " = " ~ $acc ~ ";\n" ~ g8_class_release($owner, $otmp), nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $t))
        }
        CgStr {
            $t = g4_value_tmp(CgStr, $state.ntmp)
            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl(CgStr, $t), body: $state.body ~ "\t" ~ $t ~ " = guji_retain(" ~ $acc ~ ");\n" ~ g8_class_release($owner, $otmp), nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $t))
        }
        CgEnum($n) {
            $t = g4_value_tmp(CgEnum($n), $state.ntmp)
            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl(CgEnum($n), $t), body: $state.body ~ "\t" ~ $t ~ " = " ~ $acc ~ ";\n" ~ g6e_enum_retain($n, $t) ~ g8_class_release($owner, $otmp), nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $t))
        }
        CgClass($n) {
            $t = g4_value_tmp(CgClass($n), $state.ntmp)
            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl(CgClass($n), $t), body: $state.body ~ "\t" ~ $t ~ " = " ~ $acc ~ ";\n" ~ g8_class_retain($n, $t) ~ g8_class_release($owner, $otmp), nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $t))
        }
        # List/Map fields of a transient class temp (e.g. `@rows[0].tags.sum()`):
        # deep-copy / retain-copy the collection into an owned value, THEN release
        # the class temp so the field's counted backing is not stolen.
        CgList($el) {
            match g7_list_c_type($el) {
                Err($m) { Err($m) }
                Ok($ctype) {
                    $t = g4_value_tmp(CgList($el), $state.ntmp)
                    $st0 = CgState(
                        interns: $state.interns,
                        decls: $state.decls ~ g4_value_decl(CgList($el), $t),
                        body: $state.body,
                        nstr: $state.nstr,
                        ntmp: $state.ntmp + 1
                    )
                    match g7_copy_list_loop($t, $el, $ctype, "((" ~ $ctype ~ "*)" ~ $acc ~ ".data)", $acc ~ ".len", $st0) {
                        Err($m) { Err($m) }
                        Ok($st1) {
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $st1.interns,
                                    decls: $st1.decls,
                                    body: $st1.body ~ g8_class_release($owner, $otmp),
                                    nstr: $st1.nstr,
                                    ntmp: $st1.ntmp
                                ),
                                c: $t
                            ))
                        }
                    }
                }
            }
        }
        CgMap($v) {
            match g7_lower_map_value_from_var($v, CgVar(name: "", cname: $acc, kind: CgMap($v), mutable: false, borrowed: true, listlen: 0 - 1), $state) {
                Err($m) { Err($m) }
                Ok($mv) {
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $mv.state.interns,
                            decls: $mv.state.decls,
                            body: $mv.state.body ~ g8_class_release($owner, $otmp),
                            nstr: $mv.state.nstr,
                            ntmp: $mv.state.ntmp
                        ),
                        c: $mv.c
                    ))
                }
            }
        }
        CgRes($ok, $err) {
            # A transient class owns the field carrier.  Retain the active nested
            # payload into the independent result temp before releasing the class.
            $t = g4_value_tmp($want, $state.ntmp)
            Ok(CgValueOut(
                state: CgState(
                    interns: $state.interns,
                    decls: $state.decls ~ g4_value_decl($want, $t),
                    body: $state.body ~ "\t" ~ $t ~ " = " ~ $acc ~ ";\n" ~ g6_result_retain($want, $t) ~ g8_class_release($owner, $otmp),
                    nstr: $state.nstr,
                    ntmp: $state.ntmp + 1
                ),
                c: $t
            ))
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g8_lower_field_value($want: CgKind, $obj: Expr, $field: Str, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    # A Never receiver has no field value. Native emits only the diverging
    # receiver and lets its zero sentinel satisfy the unreachable C context.
    match $obj {
        ECall($c, $args) {
            match g4_panic_value($want, $c, $args, $state, $env) {
                Ok($nv) { Ok($nv) }
                Err($not_never) { g8_lower_field_value_nonnever($want, $obj, $field, $state, $env) }
            }
        }
        _ { g8_lower_field_value_nonnever($want, $obj, $field, $state, $env) }
    }
}

sub g8_lower_field_value_nonnever($want: CgKind, $obj: Expr, $field: Str, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g8_resolve_field_acc($obj, $field, $env) {
        Err($m) { g8_lower_field_via_temp($want, $obj, $field, $state, $env) }
        Ok($fa) {
            if cgkind_eq($want, $fa.kind) {
                $acc = $fa.acc
                match $want {
                                                    CgStr {
                                                        $tmp = g4_value_tmp(CgStr, $state.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl(CgStr, $tmp),
                                                                body: $state.body ~ "\t" ~ $tmp ~ " = guji_retain(" ~ $acc ~ ");\n",
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    CgList($el) {
                                                        match g7_list_c_type($el) {
                                                            Err($m) { Err($m) }
                                                            Ok($ctype) {
                                                                $tmp = g4_value_tmp(CgList($el), $state.ntmp)
                                                                $st0 = CgState(
                                                                    interns: $state.interns,
                                                                    decls: $state.decls ~ g4_value_decl(CgList($el), $tmp),
                                                                    body: $state.body,
                                                                    nstr: $state.nstr,
                                                                    ntmp: $state.ntmp + 1
                                                                )
                                                                match g7_copy_list_loop($tmp, $el, $ctype, "((" ~ $ctype ~ "*)" ~ $acc ~ ".data)", $acc ~ ".len", $st0) {
                                                                    Err($m) { Err($m) }
                                                                    Ok($st1) { Ok(CgValueOut(state: $st1, c: $tmp)) }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    CgMap($v) {
                                                        g7_lower_map_value_from_var($v, CgVar(name: "", cname: $acc, kind: CgMap($v), mutable: false, borrowed: true, listlen: 0 - 1), $state)
                                                    }
                                                    CgOptStr {
                                                        $tmp = g4_value_tmp(CgOptStr, $state.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl(CgOptStr, $tmp),
                                                                body: $state.body ~ g6_option_retain(CgOptStr, $acc) ~ "\t" ~ $tmp ~ " = " ~ $acc ~ ";\n",
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    CgOptClass($n) {
                                                        # Reading an Option[<class>] field copies the carrier
                                                        # struct by value and retains the active Some payload's
                                                        # owned fields, so the produced value owns its own copy
                                                        # (E5d-7c-2d-5) — mirrors the CgOptStr read above.
                                                        $tmp = g4_value_tmp(CgOptClass($n), $state.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl(CgOptClass($n), $tmp),
                                                                body: $state.body ~ g6_option_retain(CgOptClass($n), $acc) ~ "\t" ~ $tmp ~ " = " ~ $acc ~ ";\n",
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    CgOptEnum($n) {
                                                        # Reading an Option[<enum>] field copies the carrier
                                                        # struct by value and retains the active Some payload's
                                                        # owned fields, so the produced value owns its own copy
                                                        # (E5d-7c-2d-8) — mirrors the CgOptClass read above.
                                                        $tmp = g4_value_tmp(CgOptEnum($n), $state.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl(CgOptEnum($n), $tmp),
                                                                body: $state.body ~ g6_option_retain(CgOptEnum($n), $acc) ~ "\t" ~ $tmp ~ " = " ~ $acc ~ ";\n",
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    CgRes($ok, $err) {
                                                        # Class fields are borrowed lvalues.  A projected Result
                                                        # value gets its own active-arm ownership before it crosses
                                                        # a bind/call/match boundary.
                                                        $tmp = g4_value_tmp($want, $state.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl($want, $tmp),
                                                                body: $state.body ~ "\t" ~ $tmp ~ " = " ~ $acc ~ ";\n" ~ g6_result_retain($want, $tmp),
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    CgEnum($n) {
                                                        # Reading an ENUM-typed class field as a VALUE (slice 5
                                                        # E5d-8h-2) copies the by-value enum carrier. Retain the
                                                        # embedded enum's owned fields before the consuming copy
                                                        # is assigned into a binding, call arg, or enclosing enum
                                                        # constructor, mirroring the EName enum-value path. EB-1b:
                                                        # if the accessor reads THROUGH a box, the enum must be
                                                        # COPIED into a temp (then its fields retained) before
                                                        # scope cleanup frees the box — an in-place retain on the
                                                        # boxed accessor would be a use-after-free in tail position.
                                                        if $fa.viabox {
                                                            $tmp = g4_value_tmp(CgEnum($n), $state.ntmp)
                                                            Ok(CgValueOut(
                                                                state: CgState(
                                                                    interns: $state.interns,
                                                                    decls: $state.decls ~ g4_value_decl(CgEnum($n), $tmp),
                                                                    body: $state.body ~ "\t" ~ $tmp ~ " = " ~ $acc ~ ";\n" ~ g6e_enum_retain($n, $tmp),
                                                                    nstr: $state.nstr,
                                                                    ntmp: $state.ntmp + 1
                                                                ),
                                                                c: $tmp
                                                            ))
                                                        } else {
                                                            Ok(CgValueOut(
                                                                state: CgState(
                                                                    interns: $state.interns,
                                                                    decls: $state.decls,
                                                                    body: $state.body ~ g6e_enum_retain($n, $acc),
                                                                    nstr: $state.nstr,
                                                                    ntmp: $state.ntmp
                                                                ),
                                                                c: $acc
                                                            ))
                                                        }
                                                    }
                    _ {
                        # EB-1b: a SCALAR (Int/Bool/Float) read reaching this arm THROUGH
                        # a box must be copied out into a temp before scope cleanup frees
                        # the box; a non-via-box scalar accessor is cleanup-stable and is
                        # inlined unchanged (preserving existing generated C).
                        if $fa.viabox {
                            $tmp = g4_value_tmp($want, $state.ntmp)
                            Ok(CgValueOut(state: CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl($want, $tmp), body: $state.body ~ "\t" ~ $tmp ~ " = " ~ $acc ~ ";\n", nstr: $state.nstr, ntmp: $state.ntmp + 1), c: $tmp))
                        } else {
                            Ok(CgValueOut(state: $state, c: $acc))
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_lower_call_args_state($params: CgKindList, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $params {
        CgKindNil {
            match $args {
                ExprNil { Ok(CgArgsOut(state: $state, args: "", releases: "")) }
                _ { Err(g3_unsupported()) }
            }
        }
        CgKindCons($pk, $prest) {
            match $args {
                ExprNil { Err(g3_unsupported()) }
                ExprCons($a, $arest) {
                    match g5_lower_one_arg_state($pk, $a, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($first) {
                            match g5_lower_call_args_state($prest, $arest, $first.state, $env) {
                                Err($m) { Err($m) }
                                Ok($rest) {
                                    $joined = if $rest.args == "" { $first.args } else { $first.args ~ ", " ~ $rest.args }
                                    Ok(CgArgsOut(state: $rest.state, args: $joined, releases: $rest.releases ~ $first.releases))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_ret_matches_kind($want: CgKind, $ret: CgRet): Bool {
    match g5_ret_value_kind($ret) {
        Some($k) { cgkind_eq($want, $k) }
        None { false }
    }
}

sub g5_fn_cparams_tail($params: CgKindList): Str {
    match $params {
        CgKindNil { "" }
        CgKindCons($h, $t) {
            $rest = g5_fn_cparams_tail($t)
            if $rest == "" { g5_kind_ctype($h) } else { g5_kind_ctype($h) ~ ", " ~ $rest }
        }
    }
}

sub g5_fn_cparams($params: CgKindList): Str {
    $tail = g5_fn_cparams_tail($params)
    if $tail == "" { "void*" } else { "void*, " ~ $tail }
}

sub g5_fn_call_c($fn: Str, $ret: CgRet, $params: CgKindList, $args: Str): Str {
    $prefix = $fn ~ ".env"
    $call_args = if $args == "" { $prefix } else { $prefix ~ ", " ~ $args }
    "((" ~ g5_ret_ctype($ret) ~ " (*) (" ~ g5_fn_cparams($params) ~ "))" ~ $fn ~ ".fn)(" ~ $call_args ~ ")"
}

sub g5_fn_call_lower($want: CgKind, $fn: Str, $params: CgKindList, $ret: CgRet, $args: ExprList, $state: CgState, $env: CgEnv, $fnrelease: Str): Result[CgValueOut, Str] {
    if g5_ret_matches_kind($want, $ret) {
        match g5_lower_call_args_state($params, $args, $state, $env) {
            Err($m) { Err($m) }
            Ok($ao) {
                $tmp = g4_value_tmp($want, $ao.state.ntmp)
                Ok(CgValueOut(
                    state: CgState(
                        interns: $ao.state.interns,
                        decls: $ao.state.decls ~ g4_value_decl($want, $tmp),
                        body: $ao.state.body ~ "\t" ~ $tmp ~ " = " ~ g5_fn_call_c($fn, $ret, $params, $ao.args) ~ ";\n" ~ $ao.releases ~ $fnrelease,
                        nstr: $ao.state.nstr,
                        ntmp: $ao.state.ntmp + 1
                    ),
                    c: $tmp
                ))
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g5_fn_call_value($want: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $callee {
        EName($name) {
            match cg_env_lookup($env, $name) {
                Some($var) {
                    match $var.kind {
                        CgFn($params, $ret) {
                            g5_fn_call_lower($want, $var.cname, $params, $ret, $args, $state, $env, "")
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                None { Err(g3_unsupported()) }
            }
        }
        _ {
            match g5_fn_arg_kind($callee, $env) {
                Err($m) { Err($m) }
                Ok($kind) {
                    match $kind {
                        CgFn($params, $ret) {
                            if g5_ret_matches_kind($want, $ret) {
                                match g4_lower_value($kind, $callee, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($fv) {
                                        # Stabilize the pair before lowering arguments: a
                                        # function expression can itself contain calls, and
                                        # `.fn`/`.env` must observe the same single result.
                                        $ftmp = g4_value_tmp($kind, $fv.state.ntmp)
                                        $fstate = CgState(
                                            interns: $fv.state.interns,
                                            decls: $fv.state.decls ~ g4_value_decl($kind, $ftmp),
                                            body: $fv.state.body ~ "\t" ~ $ftmp ~ " = " ~ $fv.c ~ ";\n",
                                            nstr: $fv.state.nstr,
                                            ntmp: $fv.state.ntmp + 1
                                        )
                                        g5_fn_call_lower(
                                            $want, $ftmp, $params, $ret, $args,
                                            $fstate, $env,
                                            "\tguji_release(" ~ $ftmp ~ ".env);\n"
                                        )
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# ---- P9-10b-3b-2b: bare-`Func` call-site shape substitution ------------------
# Native recovers the concrete fn shape of a bare-`Func` param/return from the
# checker's per-call-site CallSig (the bare annotation behaves like a type
# parameter bound from the fn argument). The selfhost checker keeps it
# permissive (TUnknown), so codegen substitutes here: a sig flagged `barefn`
# has its placeholder fn params (and, flagged `retbarefn`, its placeholder RFn
# return) rewritten to the concrete CgFn kind of the call's fn argument.

# Infer the exact function kind of a branch tail. Function-valued control flow
# must agree in every value branch: relying on the first classifiable branch can
# silently select the wrong C ABI when later branches carry a different Func
# signature.
sub g5_fn_kind_from_block($body: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match $body {
        StmtNil { Err(g3_unsupported()) }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil {
                    match $head {
                        SExpr($e) { g5_fn_arg_kind($e, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                StmtCons($h2, $t2) {
                    # Track branch-local function aliases/factory results so a
                    # tail `$local` has the exact signature. Other leading
                    # statements do not affect a directly annotated lambda/call
                    # tail's function shape.
                    match $head {
                        SBind($m, $name, $ty, $value) {
                            match g5_fn_arg_kind($value, $env) {
                                Ok($kind) {
                                    g5_fn_kind_from_block(
                                        $tail,
                                        CgEnvCons(CgVar(name: $name, cname: "ginfer_" ~ $name, kind: $kind, mutable: $m, borrowed: true, listlen: 0), $env)
                                    )
                                }
                                Err($not_fn) { g5_fn_kind_from_block($tail, $env) }
                            }
                        }
                        _ { g5_fn_kind_from_block($tail, $env) }
                    }
                }
            }
        }
    }
}

sub g5_fn_kind_from_if_tail($elifs: ElifList, $els: Option[StmtList], $env: CgEnv, $want: CgKind): Result[CgKind, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) {
                    match g5_fn_kind_from_block($body, $env) {
                        Ok($k) { if cgkind_eq($want, $k) { Ok($want) } else { Err(g3_unsupported()) } }
                        Err($m) { Err($m) }
                    }
                }
            }
        }
        ElifCons($head, $tail) {
            match g5_fn_kind_from_block($head.body, $env) {
                Err($m) { Err($m) }
                Ok($k) {
                    if cgkind_eq($want, $k) {
                        g5_fn_kind_from_if_tail($tail, $els, $env, $want)
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

sub g5_fn_kind_from_arms_tail($arms: ArmList, $env: CgEnv, $want: CgKind): Result[CgKind, Str] {
    match $arms {
        ArmNil { Ok($want) }
        ArmCons($arm, $rest) {
            match g5_fn_kind_from_block($arm.body, $env) {
                Err($m) { Err($m) }
                Ok($k) {
                    if cgkind_eq($want, $k) {
                        g5_fn_kind_from_arms_tail($rest, $env, $want)
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

sub g5_fn_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g5_fn_kind_from_block($arm.body, $env) {
                Err($m) { Err($m) }
                Ok($k) { g5_fn_kind_from_arms_tail($rest, $env, $k) }
            }
        }
    }
}

# The concrete fn kind of one value, or Err when it is not fn-shaped.
sub g5_fn_arg_kind($a: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $a {
        ELambda($params, $ret, $body, $topic) {
            match g5_resolve_lambda_ann($params, $ret, $body, $env) {
                Err($m) { Err($m) }
                Ok($ann) { Ok(CgFn($ann.pk, $ann.rk)) }
            }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgFn($p, $r) { Ok(CgFn($p, $r)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                None { Err(g3_unsupported()) }
            }
        }
        ECall($c, $args) {
            match g5_resolve_call_target($c, $args, $env) {
                Err($m) {
                    # A first-class function may itself return a function.
                    match g5_fn_arg_kind($c, $env) {
                        Err($fm) { Err($m) }
                        Ok($fk) {
                            match $fk {
                                CgFn($p, $r) {
                                    match $r {
                                        RFn($rp, $rr) { Ok(CgFn($rp, $rr)) }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                Ok($t) {
                    match $t.sig.ret {
                        RFn($p, $r) { Ok(CgFn($p, $r)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EIf($cond, $then, $elifs, $els) {
            match g5_fn_kind_from_block($then, $env) {
                Err($m) { Err($m) }
                Ok($k) { g5_fn_kind_from_if_tail($elifs, $els, $env, $k) }
            }
        }
        EMatch($subj, $arms) { g5_fn_kind_from_arms($arms, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# The SHARED concrete fn kind among a call's fn-shaped arguments. Native's
# checker binds every bare `Func` annotation to the one type parameter named
# "Func", so two differently-shaped fn arguments are a checker reject; this
# mirrors that as an honest decline rather than picking one silently.
sub g5_shared_fn_arg_kind($args: ExprList, $env: CgEnv, $found: Option[CgKind]): Result[Option[CgKind], Str] {
    match $args {
        ExprNil { Ok($found) }
        ExprCons($h, $t) {
            match g5_fn_arg_kind($h, $env) {
                Err($notfn) { g5_shared_fn_arg_kind($t, $env, $found) }
                Ok($k) {
                    match $found {
                        None { g5_shared_fn_arg_kind($t, $env, Some($k)) }
                        Some($f) {
                            if cgkind_eq($f, $k) { g5_shared_fn_arg_kind($t, $env, $found) } else { Err(g3_unsupported()) }
                        }
                    }
                }
            }
        }
    }
}

# Replace placeholder (canonical bare-`Func`) parameter kinds with the call's
# concrete fn kind; every other parameter kind is left alone.
sub g5_subst_fn_params($params: CgKindList, $k: CgKind): CgKindList {
    match $params {
        CgKindNil { CgKindNil }
        CgKindCons($h, $t) {
            if cgkind_eq($h, CgFn(CgKindNil, RInt)) { CgKindCons($k, g5_subst_fn_params($t, $k)) } else { CgKindCons($h, g5_subst_fn_params($t, $k)) }
        }
    }
}

sub g5_subst_bare_fn_sig($sig: CgSig, $args: ExprList, $env: CgEnv): Result[CgSig, Str] {
    if !$sig.barefn {
        Ok($sig)
    } else {
        match g5_shared_fn_arg_kind($args, $env, None) {
            Err($m) { Err($m) }
            # No fn-shaped argument: leave the placeholders. Lowering a non-fn
            # argument under the placeholder kind declines, matching native's
            # unbound-type-parameter reject.
            Ok(None) { Ok($sig) }
            Ok(Some($k)) {
                match $k {
                    CgFn($kp, $kr) {
                        $ret2 = if $sig.retbarefn { RFn($kp, $kr) } else { $sig.ret }
                        Ok(CgSig(name: $sig.name, cname: $sig.cname, params: g5_subst_fn_params($sig.params, $k), ret: $ret2, retregex: $sig.retregex, barefn: false, retbarefn: false))
                    }
                    _ { Err(g3_unsupported()) }
                }
            }
        }
    }
}

sub g5_resolve_call_target($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgCallTarget, Str] {
    match g5_resolve_call_target_raw($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($t) {
            match g5_subst_bare_fn_sig($t.sig, $t.args, $env) {
                Err($m) { Err($m) }
                Ok($s2) { Ok(CgCallTarget(sig: $s2, args: $t.args)) }
            }
        }
    }
}

# Resolve a user-sub call target. A field callee is UFCS: `$recv.f(args)` is the
# same call shape as `f($recv, args)`, so the receiver is lowered first by
# prepending it to the argument list before the existing ABI path runs.
sub g5_resolve_call_target_raw($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgCallTarget, Str] {
    match $callee {
        EName($f) {
            match cg_env_lookup_sub($env, $f) {
                None {
                    # P5b-1: a bare name with no concrete signature may be a generic
                    # template — route the call to its monomorphized spec by the
                    # call's argument kinds (the spec was created by the
                    # g5g_expand_generics pre-pass; a missing spec means the
                    # instantiation is out of subset and the call declines).
                    match g5g_call_spec_sig($f, $args, $env) {
                        Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: $args)) }
                        None { Err(g3_unsupported()) }
                    }
                }
                Some($sig) { Ok(CgCallTarget(sig: $sig, args: $args)) }
            }
        }
        EField($recv, $method) {
            match g5_bound_class_receiver($recv, $env) {
                Some($class_name) {
                    match cg_env_lookup_sub($env, $class_name ~ "." ~ $method) {
                        Some($msig) {
                            if g5_sig_starts_class($msig.params, $class_name) {
                                Ok(CgCallTarget(sig: $msig, args: ExprCons($recv, $args)))
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        None {
                            match cg_env_lookup_sub($env, $method) {
                                None {
                                    match g5g_method_call_spec_sig($class_name, $method, ExprCons($recv, $args), $env) {
                                        Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: ExprCons($recv, $args))) }
                                        None {
                                            match g5g_call_spec_sig($method, ExprCons($recv, $args), $env) {
                                                Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: ExprCons($recv, $args))) }
                                                None { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                                Some($sig) { Ok(CgCallTarget(sig: $sig, args: ExprCons($recv, $args))) }
                            }
                        }
                    }
                }
                None {
                    match g5_bound_enum_receiver($recv, $env) {
                        Some($enum_name) {
                            match cg_env_lookup_sub($env, $enum_name ~ "." ~ $method) {
                                Some($msig) {
                                    if g5_sig_starts_enum($msig.params, $enum_name) {
                                        Ok(CgCallTarget(sig: $msig, args: ExprCons($recv, $args)))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                None {
                                    match cg_env_lookup_sub($env, $method) {
                                        None {
                                            match g5g_method_call_spec_sig($enum_name, $method, ExprCons($recv, $args), $env) {
                                                Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: ExprCons($recv, $args))) }
                                                None {
                                                    match g5g_call_spec_sig($method, ExprCons($recv, $args), $env) {
                                                        Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: ExprCons($recv, $args))) }
                                                        None { Err(g3_unsupported()) }
                                                    }
                                                }
                                            }
                                        }
                                        Some($sig) { Ok(CgCallTarget(sig: $sig, args: ExprCons($recv, $args))) }
                                    }
                                }
                            }
                        }
                        None {
                            # §7.5 associated call `TypeName.assoc(args)` (type-name
                            # receiver, no value) resolves here after both value-
                            # receiver paths declined. Class and enum associated
                            # functions insert no implicit receiver argument.
                            match g5_class_assoc_call_target($recv, $method, $args, $env) {
                                Some($t) { Ok($t) }
                                None {
                                    match g5_enum_assoc_call_target($recv, $method, $args, $env) {
                                        Some($t) { Ok($t) }
                                        None {
                                            match cg_env_lookup_sub($env, $method) {
                                                None {
                                                    match g5g_call_spec_sig($method, ExprCons($recv, $args), $env) {
                                                        Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: ExprCons($recv, $args))) }
                                                        None { Err(g3_unsupported()) }
                                                    }
                                                }
                                                Some($sig) { Ok(CgCallTarget(sig: $sig, args: ExprCons($recv, $args))) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        EQualified($module, $member) {
            match cg_env_lookup_sub($env, import_qualified_name($module, $member)) {
                None {
                    match g5g_call_spec_sig(import_qualified_name($module, $member), $args, $env) {
                        Some($gsig) { Ok(CgCallTarget(sig: $gsig, args: $args)) }
                        None { Err(g3_unsupported()) }
                    }
                }
                Some($sig) { Ok(CgCallTarget(sig: $sig, args: $args)) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_sig_starts_class($params: CgKindList, $class_name: Str): Bool {
    match $params {
        CgKindCons($head, $tail) {
            match $head {
                CgClass($n) { $n == $class_name }
                _ { false }
            }
        }
        _ { false }
    }
}

sub g5_sig_starts_enum($params: CgKindList, $enum_name: Str): Bool {
    match $params {
        CgKindCons($head, $tail) {
            match $head {
                CgEnum($n) { $n == $enum_name }
                _ { false }
            }
        }
        _ { false }
    }
}

# P4c-2: a method receiver may be ANY class-valued expression, not just a bound
# local — a constructor temporary (`Counter(n: 7).value()`) or a method-call chain
# (`$c.bumped().value()`). `g8_class_kind_from_value` already infers the CgClass of
# a bound EName, a constructor `ECall(ETypeName)`, a class-returning call, a nested
# class field read, or a class-valued match; delegate to it so every native-accepted
# class receiver resolves. Non-class receivers infer Err → None, so they still fall
# through to the data-first UFCS rule exactly as the old EName-only form did. Kind
# inference is pure (no CgState), so the receiver is still lowered exactly ONCE by
# the downstream arg path (`g8_lower_one_class_arg`).
sub g5_bound_class_receiver($recv: Expr, $env: CgEnv): Option[Str] {
    match g8_class_kind_from_value($recv, $env) {
        Ok($k) {
            match $k {
                CgClass($cn) { Some($cn) }
                _ { None }
            }
        }
        Err($m) { None }
    }
}

sub g5_bound_enum_receiver($recv: Expr, $env: CgEnv): Option[Str] {
    match g6e_enum_kind_from_value($recv, $env) {
        Ok($k) {
            match $k {
                CgEnum($en) { Some($en) }
                _ { None }
            }
        }
        Err($m) { None }
    }
}

# §7.5: a non-generic class associated-function call `ClassName.assoc(args)`.
# The type name is a namespace, not a value receiver, so the call uses exactly
# the declared arguments. Qualified imported classes resolve through the same
# public class marker used by constructor and field lowering.
sub g5_class_assoc_call_target($recv: Expr, $method: Str, $args: ExprList, $env: CgEnv): Option[CgCallTarget] {
    match $recv {
        ETypeName($tn) {
            match cg_env_lookup_class($env, $tn) {
                Some($info) {
                    match cg_env_lookup_sub($env, $tn ~ "." ~ $method) {
                        Some($sig) { Some(CgCallTarget(sig: $sig, args: $args)) }
                        None { None }
                    }
                }
                None { None }
            }
        }
        EQualified($module, $member) {
            match g9_qualified_class_name($module, $member, $env) {
                Some($tn) {
                    match cg_env_lookup_sub($env, $tn ~ "." ~ $method) {
                        Some($sig) { Some(CgCallTarget(sig: $sig, args: $args)) }
                        None { None }
                    }
                }
                None { None }
            }
        }
        _ { None }
    }
}

# §7.5: an associated-function call `EnumName.assoc(args)`. The callee is
# `EField(ETypeName($tn), $method)` where `$tn` is a registered ENUM NAME (NOT a
# variant — a nullary-variant receiver like `Red.label()` is a §9 METHOD, resolved
# earlier by g5_bound_enum_receiver). It resolves to the enum's associated function
# `gf_<Enum>_<method>` with NO receiver argument (native codegen.enumAssocCall).
# Fires only after both value-receiver paths declined, matching native's dispatch
# order (nullary-variant method first, then enum-assoc).
sub g5_enum_assoc_call_target($recv: Expr, $method: Str, $args: ExprList, $env: CgEnv): Option[CgCallTarget] {
    match $recv {
        ETypeName($tn) {
            match cg_env_lookup_enum($env, $tn) {
                Some($info) {
                    match cg_env_lookup_sub($env, $tn ~ "." ~ $method) {
                        Some($sig) { Some(CgCallTarget(sig: $sig, args: $args)) }
                        None {
                            # P5b-2e: generic-enum TEMPLATE assoc dispatch (native
                            # genericEnumAssocSpecKey): `Box.make(7)` resolves to the
                            # concrete spec's assoc sig `Box__Int.make` by argument
                            # kinds. The kind-match must be UNIQUE across the specs —
                            # an ambiguous match (a type param the assoc params never
                            # mention) declines exactly like native's failed binding.
                            match g5_enum_assoc_spec_sig($env, $tn ~ "__", "." ~ $method, $args, $env) {
                                Some($sig) { Some(CgCallTarget(sig: $sig, args: $args)) }
                                None { None }
                            }
                        }
                    }
                }
                None { None }
            }
        }
        # P9-5c: `tokens::Choice.pick(1)` — resolve the imported enum via the
        # non-callable `#enum` marker, then the bare `Choice.pick` method sig
        # (alias-prefixed C name) already exported by g5_collect_import_public_sigs_on.
        EQualified($module, $member) {
            match g9_qualified_enum_name($module, $member, $env) {
                Some($tn) {
                    match cg_env_lookup_enum($env, $tn) {
                        Some($info) {
                            match cg_env_lookup_sub($env, $tn ~ "." ~ $method) {
                                Some($sig) { Some(CgCallTarget(sig: $sig, args: $args)) }
                                None { None }
                            }
                        }
                        None { None }
                    }
                }
                None { None }
            }
        }
        _ { None }
    }
}

sub ends_with($s: Str, $p: Str): Bool {
    @sc = split($s, "")
    @pc = split($p, "")
    if @pc.count() > @sc.count() {
        false
    } else {
        drop(@sc, @sc.count() - @pc.count()).join("") == $p
    }
}

sub g5_assoc_spec_match_more($env: CgEnv, $prefix: Str, $suffix: Str, $args: ExprList, $lookup: CgEnv): Bool {
    match $env {
        CgEnvNil { false }
        CgEnvCons($h, $t) { g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup) }
        CgEnvSub($s, $t) {
            if starts_with($s.name, $prefix) && ends_with($s.name, $suffix) && g5g_args_match_kinds($args, $s.params, $lookup) {
                true
            } else {
                g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup)
            }
        }
        CgEnvEnum($e, $t) { g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup) }
        CgEnvClass($c, $t) { g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup) }
        CgEnvSubIdx($i, $t) {
            # Prefix/suffix scans are not name-keyed; walk the extracted sub
            # cells in original order, then whatever follows the index node.
            g5_assoc_spec_match_more($i.flat, $prefix, $suffix, $args, $lookup) || g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup)
        }
    }
}

# The UNIQUE spec assoc sig named `<template>__<tags>.<assoc>` whose parameter
# kinds match the call arguments; two matches mean the argument kinds cannot
# pin the instantiation, so the call declines (None).
sub g5_enum_assoc_spec_sig($env: CgEnv, $prefix: Str, $suffix: Str, $args: ExprList, $lookup: CgEnv): Option[CgSig] {
    match $env {
        CgEnvNil { None }
        CgEnvCons($h, $t) { g5_enum_assoc_spec_sig($t, $prefix, $suffix, $args, $lookup) }
        CgEnvSub($s, $t) {
            if starts_with($s.name, $prefix) && ends_with($s.name, $suffix) && g5g_args_match_kinds($args, $s.params, $lookup) {
                if g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup) {
                    None
                } else {
                    Some($s)
                }
            } else {
                g5_enum_assoc_spec_sig($t, $prefix, $suffix, $args, $lookup)
            }
        }
        CgEnvEnum($e, $t) { g5_enum_assoc_spec_sig($t, $prefix, $suffix, $args, $lookup) }
        CgEnvClass($c, $t) { g5_enum_assoc_spec_sig($t, $prefix, $suffix, $args, $lookup) }
        CgEnvSubIdx($i, $t) {
            match g5_enum_assoc_spec_sig($i.flat, $prefix, $suffix, $args, $lookup) {
                Some($s) {
                    if g5_assoc_spec_match_more($t, $prefix, $suffix, $args, $lookup) { None } else { Some($s) }
                }
                None { g5_enum_assoc_spec_sig($t, $prefix, $suffix, $args, $lookup) }
            }
        }
    }
}

sub g5_call_result_temp($ret: CgRet, $idx: Int): Str {
    match $ret {
        RFloat { "gd" ~ c_int($idx) }
        RBool { "gb" ~ c_int($idx) }
        RStr { "gt" ~ c_int($idx) }
        REnum($n) { g4_value_tmp(CgEnum($n), $idx) }
        RClass($n) { g4_value_tmp(CgClass($n), $idx) }
        ROpt($k) { g4_value_tmp($k, $idx) }
        RRes($k) { g4_value_tmp($k, $idx) }
        RList($el) { g4_value_tmp(CgList($el), $idx) }
        RMap($v) { g4_value_tmp(CgMap($v), $idx) }
        RBush { g4_value_tmp(CgBush, $idx) }
        RChan($el) { g4_value_tmp(CgChan($el), $idx) }
        RFn($p, $r) { g4_value_tmp(CgFn($p, $r), $idx) }
        _ { "gi" ~ c_int($idx) }
    }
}

sub g5_call_result_decl($ret: CgRet, $tmp: Str): Str {
    match $ret {
        RFloat { "\tdouble " ~ $tmp ~ " = 0.0;\n" }
        RStr { "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n" }
        REnum($n) { g4_value_decl(CgEnum($n), $tmp) }
        RClass($n) { g4_value_decl(CgClass($n), $tmp) }
        ROpt($k) { g4_value_decl($k, $tmp) }
        RRes($k) { g4_value_decl($k, $tmp) }
        RList($el) { g4_value_decl(CgList($el), $tmp) }
        RMap($v) { g4_value_decl(CgMap($v), $tmp) }
        RBush { g4_value_decl(CgBush, $tmp) }
        RChan($el) { g4_value_decl(CgChan($el), $tmp) }
        RFn($p, $r) { g4_value_decl(CgFn($p, $r), $tmp) }
        _ { "\tint64_t " ~ $tmp ~ " = 0;\n" }
    }
}

sub g5_call_value($want: CgRet, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_resolve_call_target($callee, $args, $env) {
        Err($m) {
            # A bound first-class function is not present in the sub-signature
            # index. Route it through the same owned result-temp ABI as a named
            # sub. Keeping this fallback here makes non-scalar List/Map returns
            # available to their ordinary value lowerers as well as scalars.
            match g5_ret_value_kind($want) {
                None { Err($m) }
                Some($kind) { g5_fn_call_value($kind, $callee, $args, $state, $env) }
            }
        }
        Ok($target) {
            $sig = $target.sig
            if cg_ret_eq($sig.ret, $want) {
                match g5_lower_call_args_state($sig.params, $target.args, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($ao) {
                        $tmp = g5_call_result_temp($want, $ao.state.ntmp)
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $ao.state.interns,
                                decls: $ao.state.decls ~ g5_call_result_decl($want, $tmp),
                                body: $ao.state.body ~ "\t" ~ $tmp ~ " = " ~ $sig.cname ~ "(" ~ $ao.args ~ ");\n" ~ $ao.releases,
                                nstr: $ao.state.nstr,
                                ntmp: $ao.state.ntmp + 1
                            ),
                            c: $tmp
                        ))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g5_read_file_arg($callee: Expr, $args: ExprList): Result[Expr, Str] {
    match $callee {
        EName($name) {
            if $name == "read_file" {
                match $args {
                    ExprCons($path, ExprNil) { Ok($path) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "read_file" {
                match $args {
                    ExprNil { Ok($recv) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_lower_read_file_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_read_file_arg($callee, $args) {
        Err($m) { Err($m) }
        Ok($path) {
            match g3_str_lower($path, $state, $env) {
                Err($m) { Err($m) }
                Ok($ps) {
                    $res = g4_value_tmp(CgRes(CgStr, CgStr), $ps.state.ntmp)
                    $err = "gt" ~ c_int($ps.state.ntmp + 1)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $ps.state.interns,
                            decls: $ps.state.decls ~ g4_value_decl(CgRes(CgStr, CgStr), $res) ~ "\tconst char* " ~ $err ~ " = NULL;\n",
                            body: $ps.state.body ~
                                "\t" ~ $err ~ " = guji_read_file(" ~ $ps.tmp ~ ", &" ~ $res ~ ".ok);\n" ~
                                "\tif (" ~ $err ~ " == NULL) \{ " ~ $res ~ ".tag = 0LL; } else \{ " ~ $res ~ ".tag = 1LL; " ~ $res ~ ".err = " ~ $err ~ "; }\n" ~
                                "\tguji_release(" ~ $ps.tmp ~ ");\n",
                            nstr: $ps.state.nstr,
                            ntmp: $ps.state.ntmp + 2
                        ),
                        c: $res
                    ))
                }
            }
        }
    }
}

class HandleOpenArgs {
    has $.helper: Str
    has $.path: Expr
}

# Recognise §15.4 `open(path)` / `create(path)` and their data-first method
# spellings. A user sub shadows only the bare function form; method syntax is
# the prelude operation on its receiver, matching the native dispatch order.
sub g5_handle_open_args($callee: Expr, $args: ExprList, $env: CgEnv): Result[HandleOpenArgs, Str] {
    match $callee {
        EName($name) {
            if $name == "open" || $name == "create" {
                match cg_env_lookup_sub($env, $name) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($path, ExprNil) { Ok(HandleOpenArgs(helper: "guji_" ~ $name, path: $path)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "open" || $method == "create" {
                match $args {
                    ExprNil { Ok(HandleOpenArgs(helper: "guji_" ~ $method, path: $recv)) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower open/create to the native Result[Handle, Str] carrier. The helper fills
# an owned counted Handle in `.ok` on success or returns an owned error Str.
sub g5_lower_handle_open_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_handle_open_args($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($ha) {
            match g3_str_lower($ha.path, $state, $env) {
                Err($m) { Err($m) }
                Ok($ps) {
                    $kind = CgRes(CgHandle, CgStr)
                    $res = g4_value_tmp($kind, $ps.state.ntmp)
                    $err = "gt" ~ c_int($ps.state.ntmp + 1)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $ps.state.interns,
                            decls: $ps.state.decls ~ g4_value_decl($kind, $res) ~ "\tconst char* " ~ $err ~ " = NULL;\n",
                            body: $ps.state.body ~
                                "\t" ~ $err ~ " = " ~ $ha.helper ~ "(" ~ $ps.tmp ~ ", &" ~ $res ~ ".ok);\n" ~
                                "\tif (" ~ $err ~ " == NULL) \{ " ~ $res ~ ".tag = 0LL; } else \{ " ~ $res ~ ".tag = 1LL; " ~ $res ~ ".err = " ~ $err ~ "; }\n" ~
                                "\tguji_release(" ~ $ps.tmp ~ ");\n",
                            nstr: $ps.state.nstr,
                            ntmp: $ps.state.ntmp + 2
                        ),
                        c: $res
                    ))
                }
            }
        }
    }
}

sub g5_parse_int_arg($callee: Expr, $args: ExprList, $env: CgEnv): Result[Expr, Str] {
    match cg_env_lookup_sub($env, "parse_int") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($name) {
                    if $name == "parse_int" {
                        match $args {
                            ExprCons($src, ExprNil) { Ok($src) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "parse_int" {
                        match $args {
                            ExprNil { Ok($recv) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g5_lower_parse_int_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_parse_int_arg($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($src) {
            match g3_str_lower($src, $state, $env) {
                Err($m) { Err($m) }
                Ok($ss) {
                    $res = g4_value_tmp(CgRes(CgInt, CgStr), $ss.state.ntmp)
                    $err = "gt" ~ c_int($ss.state.ntmp + 1)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $ss.state.interns,
                            decls: $ss.state.decls ~ g4_value_decl(CgRes(CgInt, CgStr), $res) ~ "\tconst char* " ~ $err ~ " = NULL;\n",
                            body: $ss.state.body ~
                                "\t" ~ $err ~ " = guji_parse_int(" ~ $ss.tmp ~ ", &" ~ $res ~ ".ok);\n" ~
                                "\tif (" ~ $err ~ " == NULL) \{ " ~ $res ~ ".tag = 0LL; } else \{ " ~ $res ~ ".tag = 1LL; " ~ $res ~ ".err = " ~ $err ~ "; }\n" ~
                                "\tguji_release(" ~ $ss.tmp ~ ");\n",
                            nstr: $ss.state.nstr,
                            ntmp: $ss.state.ntmp + 2
                        ),
                        c: $res
                    ))
                }
            }
        }
    }
}

# The path + content of a recognised `write_file`/`append_file` prelude call, plus
# the C helper name to invoke (slice 5 E5d-8z). The driver's `main` ends with a
# statement-position `match write_file($cpath, $prologue ~ $program_c) { ... }`.
class WriteFileArgs {
    has $.helper: Str
    has $.path: Expr
    has $.content: Expr
}

# Recognise a `write_file(path, content)` / `path.write_file(content)` (and the
# `append_file` twins) PRELUDE call, unless a user sub shadows the name. Both yield
# `Result[Unit, Str]` (§15.4): the C helper returns NULL for `Ok(())` or an owned
# error string for `Err(<msg>)`. Mirrors g5_parse_int_arg / g5_read_file_arg (the
# parse_int / read_file Result preludes) for the two-Str-argument file writers.
sub g5_write_file_args($callee: Expr, $args: ExprList, $env: CgEnv): Result[WriteFileArgs, Str] {
    match $callee {
        EName($name) {
            if $name == "write_file" || $name == "append_file" {
                match cg_env_lookup_sub($env, $name) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($path, ExprCons($content, ExprNil)) {
                                Ok(WriteFileArgs(helper: g5_write_file_helper($name), path: $path, content: $content))
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "write_file" || $method == "append_file" {
                match cg_env_lookup_sub($env, $method) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($content, ExprNil) {
                                Ok(WriteFileArgs(helper: g5_write_file_helper($method), path: $recv, content: $content))
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_write_file_helper($name: Str): Str {
    if $name == "append_file" { "guji_append_file" } else { "guji_write_file" }
}

# Lower a `write_file`/`append_file` prelude call to its `Result[Unit, Str]` carrier
# (slice 5 E5d-8z), the two-argument analogue of g5_lower_read_file_value. Both Str
# arguments lower to OWNED temps (g3_str_lower retains a bound name / builds a fresh
# concat), the C helper fills NULL (Ok) or an owned error string (Err), and both
# argument temps are released after the call (immortal-literal releases are no-ops).
# The Unit Ok slot owns nothing; the carrier owns only its active Err Str, released by
# the generic CgRes(CgUnit, CgStr) cleanup at scope/match end.
sub g5_lower_write_file_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_write_file_args($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($wf) {
            match g3_str_lower($wf.path, $state, $env) {
                Err($m) { Err($m) }
                Ok($ps) {
                    match g3_str_lower($wf.content, $ps.state, $env) {
                        Err($m) { Err($m) }
                        Ok($cs) {
                            $res = g4_value_tmp(CgRes(CgUnit, CgStr), $cs.state.ntmp)
                            $err = "gt" ~ c_int($cs.state.ntmp + 1)
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $cs.state.interns,
                                    decls: $cs.state.decls ~ g4_value_decl(CgRes(CgUnit, CgStr), $res) ~ "\tconst char* " ~ $err ~ " = NULL;\n",
                                    body: $cs.state.body ~
                                        "\t" ~ $err ~ " = " ~ $wf.helper ~ "(" ~ $ps.tmp ~ ", " ~ $cs.tmp ~ ");\n" ~
                                        "\tif (" ~ $err ~ " == NULL) \{ " ~ $res ~ ".tag = 0LL; } else \{ " ~ $res ~ ".tag = 1LL; " ~ $res ~ ".err = " ~ $err ~ "; }\n" ~
                                        "\tguji_release(" ~ $ps.tmp ~ ");\n" ~
                                        "\tguji_release(" ~ $cs.tmp ~ ");\n",
                                    nstr: $cs.state.nstr,
                                    ntmp: $cs.state.ntmp + 2
                                ),
                                c: $res
                            ))
                        }
                    }
                }
            }
        }
    }
}

class RunArgs {
    has $.cmd: Expr
    has $.args: Expr
}

sub g5_run_args($callee: Expr, $args: ExprList, $env: CgEnv): Result[RunArgs, Str] {
    match $callee {
        EName($name) {
            if $name == "run" {
                match cg_env_lookup_sub($env, "run") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($cmd, ExprCons($argv, ExprNil)) { Ok(RunArgs(cmd: $cmd, args: $argv)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "run" {
                match cg_env_lookup_sub($env, "run") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($argv, ExprNil) { Ok(RunArgs(cmd: $recv, args: $argv)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_lower_run_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_run_args($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($ra) {
            match g3_str_lower($ra.cmd, $state, $env) {
                Err($m) { Err($m) }
                Ok($cmd) {
                    match g7_lower_list_value(CgStr, $ra.args, $cmd.state, $env) {
                        Err($m) { Err($m) }
                        Ok($argv) {
                            $kind = CgRes(CgClass("Proc"), CgStr)
                            $res = g4_value_tmp($kind, $argv.state.ntmp)
                            $spawn_err = "gt" ~ c_int($argv.state.ntmp + 1)
                            $exit_code = "gi" ~ c_int($argv.state.ntmp + 2)
                            $out = "gt" ~ c_int($argv.state.ntmp + 3)
                            $err = "gt" ~ c_int($argv.state.ntmp + 4)
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $argv.state.interns,
                                    decls: $argv.state.decls ~
                                        g4_value_decl($kind, $res) ~
                                        "\tconst char* " ~ $spawn_err ~ " = NULL;\n" ~
                                        "\tint64_t " ~ $exit_code ~ " = 0;\n" ~
                                        "\tconst char* " ~ $out ~ " = GUJI_EMPTY_STR;\n" ~
                                        "\tconst char* " ~ $err ~ " = GUJI_EMPTY_STR;\n",
                                    body: $argv.state.body ~
                                        "\t" ~ $spawn_err ~ " = guji_run(" ~ $cmd.tmp ~ ", (const char**)" ~ $argv.c ~ ".data, " ~ $argv.c ~ ".len, &" ~ $exit_code ~ ", &" ~ $out ~ ", &" ~ $err ~ ");\n" ~
                                        "\tif (" ~ $spawn_err ~ " == NULL) \{ " ~ $res ~ ".tag = 0LL; " ~ $res ~ ".ok.f0 = " ~ $exit_code ~ "; " ~ $res ~ ".ok.f1 = " ~ $out ~ "; " ~ $res ~ ".ok.f2 = " ~ $err ~ "; " ~ $res ~ ".err = GUJI_EMPTY_STR; } else \{ " ~ $res ~ ".tag = 1LL; " ~ $res ~ ".err = " ~ $spawn_err ~ "; " ~ $res ~ ".ok.f1 = GUJI_EMPTY_STR; " ~ $res ~ ".ok.f2 = GUJI_EMPTY_STR; }\n" ~
                                        "\tguji_release(" ~ $cmd.tmp ~ ");\n" ~
                                        g7_slice_release($argv.c),
                                    nstr: $argv.state.nstr,
                                    ntmp: $argv.state.ntmp + 5
                                ),
                                c: $res
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub cg_ret_eq($a: CgRet, $b: CgRet): Bool {
    match $a {
        RInt { match $b { RInt { true } _ { false } } }
        RFloat { match $b { RFloat { true } _ { false } } }
        RBool { match $b { RBool { true } _ { false } } }
        RStr { match $b { RStr { true } _ { false } } }
        RUnit { match $b { RUnit { true } _ { false } } }
        REnum($na) { match $b { REnum($nb) { $na == $nb } _ { false } } }
        RClass($na) { match $b { RClass($nb) { $na == $nb } _ { false } } }
        ROpt($ka) { match $b { ROpt($kb) { cgkind_eq($ka, $kb) } _ { false } } }
        RRes($ka) { match $b { RRes($kb) { cgkind_eq($ka, $kb) } _ { false } } }
        RList($ea) { match $b { RList($eb) { cgkind_eq($ea, $eb) } _ { false } } }
        RMap($va) { match $b { RMap($vb) { cgkind_eq($va, $vb) } _ { false } } }
        RBush { match $b { RBush { true } _ { false } } }
        RChan($ea) { match $b { RChan($eb) { cgkind_eq($ea, $eb) } _ { false } } }
        RFn($pa, $ra) { match $b { RFn($pb, $rb) { cgkind_list_eq($pa, $pb) && cg_ret_eq($ra, $rb) } _ { false } } }
    }
}

# I10f1 private scheduler bridge. Ordinary statically-shaped `select` already
# emits these runtime calls directly; D's runtime-sized guest arm list needs the
# same pair once I10f2 adds its source call sites. Keep the recognizer exact so
# no ordinary prelude/user call is captured by this compiler-only ABI.
sub g11_is_progress_snapshot_call($callee: Expr, $args: ExprList): Bool {
    match $callee {
        EName($name) {
            if $name == "__guji_progress_snapshot" {
                match $args { ExprNil { true } _ { false } }
            } else {
                false
            }
        }
        _ { false }
    }
}

# I11b private exact-decimal evaluator bridge. The source-level
# `eval_float_literal` body stays expressible in the previously verified
# compiler, which is necessary for gen1 bootstrapping. When the new compiler
# emits D, however, its sole call site has one bound Str argument and lowers
# directly to the runtime's correctly-rounded strtod path. Keep this recognizer
# exact: it is compiler infrastructure, not a public parse_float builtin.
sub g11_eval_float_literal_rvalue($callee: Expr, $args: ExprList, $env: CgEnv): Option[Str] {
    match $callee {
        EName($name) {
            if $name == "eval_float_literal" {
                match $args {
                    ExprCons(EName($arg), ExprNil) {
                        match cg_env_lookup($env, $arg) {
                            Some($v) {
                                match $v.kind {
                                    CgStr { Some("guji_parse_float_literal(" ~ $v.cname ~ ")") }
                                    _ { None }
                                }
                            }
                            None { None }
                        }
                    }
                    _ { None }
                }
            } else {
                None
            }
        }
        _ { None }
    }
}

# Lower an Int-typed expression to a C `int64_t` rvalue string (pure — no
# statements). The §5.1 overflow / div-by-zero / mod-by-zero panics live in the
# reused runtime helpers, so the native binary and the interpreter panic
# identically. typecheck_verdict has already accepted the program and `main` must
# return Int, so a well-typed Int context never holds Str/Bool/Float operands;
# the non-Int arms reject defensively (out of subset).
sub g3_int_rvalue($e: Expr, $env: CgEnv): Result[Str, Str] {
    match $e {
        EInt($t) {
            match parse_int_lit($t) {
                Err($m) { Err($m) }
                Ok($n) { Ok(c_int($n) ~ "LL") }
            }
        }
        EUnary($op, $x) {
            if $op == "-" {
                match g3_int_rvalue($x, $env) {
                    Err($m) { Err($m) }
                    Ok($c) { Ok("guji_neg(" ~ $c ~ ")") }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EBinary($op, $l, $r) {
            match g3_int_binop_fn($op) {
                None { Err(g3_unsupported()) }
                Some($fn) {
                    match g3_int_rvalue($l, $env) {
                        Err($m) { Err($m) }
                        Ok($lc) {
                            match g3_int_rvalue($r, $env) {
                                Err($m) { Err($m) }
                                Ok($rc) { Ok($fn ~ "(" ~ $lc ~ ", " ~ $rc ~ ")") }
                            }
                        }
                    }
                }
            }
        }
        EUnit { Err(g3_unsupported()) }
        EFloat($t) { Err(g3_unsupported()) }
        EStr($t) { Err(g3_unsupported()) }
        ERawStr($t) { Err(g3_unsupported()) }
        ERegex($p, $l, $c) { Err(g3_unsupported()) }
        ECapture($o, $n) { Err(g3_unsupported()) }
        EQualified($m, $n) { Err(g3_unsupported()) }
        EBool($t) { Err(g3_unsupported()) }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgInt { Ok($v.cname) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        ETypeName($n) { Err(g3_unsupported()) }
        EList($x) { Err(g3_unsupported()) }
        EMap($x) { Err(g3_unsupported()) }
        ENamedArg($n, $v) { Err(g3_unsupported()) }
        ECall($c, $a) {
            Err(g3_unsupported())
        }
        EField($o, $n) { Err(g3_unsupported()) }
        EIndex($o, $i) { Err(g3_unsupported()) }
        EIf($c, $t, $e2, $el) { Err(g3_unsupported()) }
        EMatch($s, $arms) { Err(g3_unsupported()) }
        ELambda($params, $ret, $body, $topic) { Err(g3_unsupported()) }
        EQuestion($x) { Err(g3_unsupported()) }
    }
}

sub g3_int_materialize($c: Str, $state: CgState): CgValueOut {
    $tmp = g4_value_tmp(CgInt, $state.ntmp)
    CgValueOut(
        state: CgState(
            interns: $state.interns,
            decls: $state.decls ~ g4_value_decl(CgInt, $tmp),
            body: $state.body ~ "\t" ~ $tmp ~ " = " ~ $c ~ ";\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        ),
        c: $tmp
    )
}

sub g3_int_atomic_rvalue($e: Expr, $env: CgEnv): Result[Str, Str] {
    match $e {
        EInt($t) { g3_int_rvalue($e, $env) }
        EName($n) { g3_int_rvalue($e, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# ---- G5b-b: stateful Int rvalue composition -------------------------------
# Literals and bound Int names are the only atomic rvalues. Every unary/binary
# computation is assigned to a temp immediately after its operands are lowered so
# overflow, division/modulo by zero, and nested calls happen at that source-order
# point rather than after a later argument or field has already run.
sub g3_int_rvalue_state($e: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g3_int_atomic_rvalue($e, $env) {
        Ok($rv) { Ok(CgValueOut(state: $state, c: $rv)) }
        Err($pure) {
            match $e {
                EUnary($op, $x) {
                    if $op == "-" {
                        # §11.2 Never: native emits only the diverging operand;
                        # the enclosing unary operation is unreachable.
                        match $x {
                            ECall($c, $a) {
                                match g4_panic_value(CgInt, $c, $a, $state, $env) {
                                    Ok($nv) { Ok($nv) }
                                    Err($not_never) {
                                        match g3_int_rvalue_state($x, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($v) { Ok(g3_int_materialize("guji_neg(" ~ $v.c ~ ")", $v.state)) }
                                        }
                                    }
                                }
                            }
                            _ {
                                match g3_int_rvalue_state($x, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($v) { Ok(g3_int_materialize("guji_neg(" ~ $v.c ~ ")", $v.state)) }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EBinary($op, $l, $r) {
                    match g3_int_binop_fn($op) {
                        None { Err(g3_unsupported()) }
                        Some($fn) {
                            # Binary evaluation remains left-to-right, but a
                            # Never operand makes the operator itself unreachable.
                            $left = match $l {
                                ECall($c, $a) { g4_panic_value(CgInt, $c, $a, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                            match $left {
                                Ok($nv) { Ok($nv) }
                                Err($not_left_never) {
                                    match g3_int_rvalue_state($l, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($lv) {
                                            $right = match $r {
                                                ECall($c, $a) { g4_panic_value(CgInt, $c, $a, $lv.state, $env) }
                                                _ { Err(g3_unsupported()) }
                                            }
                                            match $right {
                                                Ok($nv) { Ok($nv) }
                                                Err($not_right_never) {
                                                    match g3_int_rvalue_state($r, $lv.state, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($rv) { Ok(g3_int_materialize($fn ~ "(" ~ $lv.c ~ ", " ~ $rv.c ~ ")", $rv.state)) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                ECall($c, $a) {
                    if g11_is_progress_snapshot_call($c, $a) {
                        Ok(g3_int_materialize("(int64_t)guji_progress_snapshot()", $state))
                    } else {
                        match g4_panic_value(CgInt, $c, $a, $state, $env) {
                            Ok($nv) { Ok($nv) }
                            Err($not_never) {
                                match g5_call_value(RInt, $c, $a, $state, $env) {
                                    Ok($v) { Ok($v) }
                                    Err($m) {
                                        match g5_fn_call_value(CgInt, $c, $a, $state, $env) {
                                            Ok($v) { Ok($v) }
                                            Err($fm) {
                                                match g7_reduce_value(CgInt, $c, $a, 0, $state, $env) {
                                                    Ok($rv) { Ok($rv) }
                                                    Err($rm) {
                                                        match g7_sum_call(CgInt, $c, $a, $state, $env) {
                                                            Ok($sv) { Ok($sv) }
                                                            Err($sm) {
                                                                match g7_minmax_call(CgInt, $c, $a, $state, $env) {
                                                                    Ok($mv) { Ok($mv) }
                                                                    Err($mm) {
                                                                        match g7_lower_list_count_call($c, $a, $state, $env) {
                                                                            Ok($cv) { Ok($cv) }
                                                                            Err($ccm) {
                                                                                match g4_unwrap_or_value(CgInt, $c, $a, $state, $env) {
                                                                                    Ok($uv) { Ok($uv) }
                                                                                    Err($um) {
                                                                                        match g4_result_unwrap_or_value(CgInt, $c, $a, $state, $env) {
                                                                                            Ok($ruv) { Ok($ruv) }
                                                                                            Err($rum) {
                                                                                                match g4_result_unwrap_or_else_value(CgInt, $c, $a, $state, $env) {
                                                                                                    Ok($ruev) { Ok($ruev) }
                                                                                                    Err($ruem) {
                                                                                                        match g4_result_expect_value(CgInt, $c, $a, $state, $env) {
                                                                                                            Ok($rev) { Ok($rev) }
                                                                                                            Err($rem) { g4_option_unwrap_value(CgInt, $c, $a, $state, $env) }
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EMatch($subj, $arms) { g6_lower_match(CgInt, $subj, $arms, $state, $env) }
                EField($obj, $name) { g8_lower_field_value(CgInt, $obj, $name, $state, $env) }
                EIndex($obj, $idx) { g7_lower_index(CgInt, $obj, $idx, $state, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# ---- G7: collections — list literal bindings + indexing --------------------
# A `List[Int|Float|Bool]`-annotated binding whose value is a list literal lowers
# to a FIXED-SIZE stack array `<cn>_data[N]` plus a parallel length `<cn>_len`,
# exactly the representation `guji build` emits for a statically-sized scalar
# list bound to a local (captured READ-ONLY via the cc-wrapper). A `List[Str]`
# binding uses native's owned heap array shape instead: `const char** <cn>_data =
# guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), N)`, released once at
# scope exit so the runtime drops each owned element.
#
# Indexing `$xs[i]` lowers to: an index temp, a bounds check that calls the shared
# runtime `guji_panic("list index out of bounds")` (byte-identical diagnostic to
# the native binary, since both reuse the same runtime), and the element access
# `<cn>_data[<idxtmp>]`. The panic message and exit behaviour therefore match both
# oracles. Int indexing is observable through `main`'s Int return / arithmetic;
# Float and Bool indexing are observable through conditions.
#
# SUBSET (everything else -> invalid-corpus): only `List[Int|Float|Bool|Str]`;
# only a literal initialiser (non-empty); whole-list reassignment remains scalar
# only for now; no list params/returns, no list as a value (print/match/call arg),
# no EField, no maps, no nested lists. Those widen in later G7 slices.

# Result of lowering the scalar elements of a list literal, left-to-right: the threaded
# state, the element rvalues in order, and the count.
class ScalarElemsOut {
    has $.state: CgState
    has $.rvals: StrList
    has $.count: Int
}

class NestedListElemsOut {
    has $.state: CgState
    has $.count: Int
}

sub g7_scalar_c_type($kind: CgKind): Result[Str, Str] {
    match $kind {
        CgInt { Ok("int64_t") }
        CgFloat { Ok("double") }
        CgBool { Ok("int64_t") }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_list_c_type($kind: CgKind): Result[Str, Str] {
    match $kind {
        CgStr { Ok("const char*") }
        CgList($inner) { Ok("guji_slice_t") }
        CgMap($val) { Ok("guji_map_t") }
        CgEnum($name) { Ok($name) }
        CgClass($name) { Ok($name) }
        _ { g7_scalar_c_type($kind) }
    }
}

sub g7_list_arr_kind($kind: CgKind): Result[Str, Str] {
    match $kind {
        CgStr { Ok("GUJI_KIND_ARR_STR") }
        CgInt { Ok("GUJI_KIND_ARR_SCALAR") }
        CgFloat { Ok("GUJI_KIND_ARR_SCALAR") }
        CgBool { Ok("GUJI_KIND_ARR_SCALAR") }
        CgList($inner) { Ok("GUJI_KIND_ARR_SLICE") }
        CgMap($val) { Ok("GUJI_KIND_ARR_MAP") }
        CgEnum($name) { Ok("GUJI_KIND_" ~ $name ~ "_ARR") }
        CgClass($name) { Ok("GUJI_KIND_" ~ $name ~ "_ARR") }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_list_release($kind: CgKind, $cn: Str): Str {
    match $kind {
        CgStr { "\tguji_release((const void*)" ~ $cn ~ "_data);\n" }
        _ { "" }
    }
}

sub g7_slice_release($slice: Str): Str {
    "\tguji_release((const void*)" ~ $slice ~ ".data);\n\t" ~ $slice ~ ".data = NULL;\n"
}

sub g7_lower_scalar_elem($kind: CgKind, $expr: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $kind {
        CgInt { g3_int_rvalue_state($expr, $state, $env) }
        CgFloat { g3b_float_rvalue_state($expr, $state, $env) }
        CgBool {
            match g4_bool_lower($expr, $state, $env) {
                Err($m) { Err($m) }
                Ok($bv) { Ok(CgValueOut(state: $bv.state, c: $bv.c)) }
            }
        }
        CgStr {
            match g3_str_lower($expr, $state, $env) {
                Err($m) { Err($m) }
                Ok($sv) { Ok(CgValueOut(state: $sv.state, c: $sv.tmp)) }
            }
        }
        CgEnum($name) { g4_lower_value($kind, $expr, $state, $env) }
        CgClass($name) { g4_lower_value($kind, $expr, $state, $env) }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_lower_scalar_elems($kind: CgKind, $items: ExprList, $state: CgState, $env: CgEnv): Result[ScalarElemsOut, Str] {
    match $items {
        ExprNil { Ok(ScalarElemsOut(state: $state, rvals: StrNil, count: 0)) }
        ExprCons($head, $tail) {
            match g7_lower_scalar_elem($kind, $head, $state, $env) {
                Err($m) { Err($m) }
                Ok($hv) {
                    match g7_lower_scalar_elems($kind, $tail, $hv.state, $env) {
                        Err($m) { Err($m) }
                        Ok($to) {
                            Ok(ScalarElemsOut(state: $to.state, rvals: StrCons($hv.c, $to.rvals), count: $to.count + 1))
                        }
                    }
                }
            }
        }
    }
}

# Emit `<cn>_data[i] = <rvalue>;` for each element rvalue, in order.
sub g7_elem_assigns($cn: Str, $rvals: StrList, $i: Int): Str {
    match $rvals {
        StrNil { "" }
        StrCons($h, $t) {
            "\t" ~ $cn ~ "_data[" ~ c_int($i) ~ "] = " ~ $h ~ ";\n" ~ g7_elem_assigns($cn, $t, $i + 1)
        }
    }
}

sub g7_slice_elem_assigns($slice: Str, $ctype: Str, $rvals: StrList, $i: Int): Str {
    match $rvals {
        StrNil { "" }
        StrCons($h, $t) {
            "\t((" ~ $ctype ~ "*)" ~ $slice ~ ".data)[" ~ c_int($i) ~ "] = " ~ $h ~ ";\n" ~ g7_slice_elem_assigns($slice, $ctype, $t, $i + 1)
        }
    }
}

sub g7_list_var_len($var: CgVar): Str {
    if $var.listlen == 0 { $var.cname ~ ".len" } else { $var.cname ~ "_len" }
}

sub g7_list_var_data($var: CgVar, $ctype: Str): Str {
    if $var.listlen == 0 { "((" ~ $ctype ~ "*)" ~ $var.cname ~ ".data)" } else { $var.cname ~ "_data" }
}

# Same-heap owned materialization of a guji_slice_t / guji_map_t row.
# Runtime `guji_copy_arr` only knows ARR_SCALAR/STR/SLICE/MAP/PTR — it panics on
# program-specific GUJI_KIND_<Enum|Class>_ARR leaves nested under List/Map.
# Native's mapFromListIndex / listFromMapIndex / mapFromMap share counted arrays
# via retain within one task heap; mirror that (not a cross-heap deep detach).
sub g7_slice_retain_copy($indent: Str, $dst: Str, $src: Str): Str {
    $indent ~ $dst ~ ".len = " ~ $src ~ ".len;\n" ~
    $indent ~ $dst ~ ".data = " ~ $src ~ ".data;\n" ~
    $indent ~ "guji_retain(" ~ $dst ~ ".data);\n"
}

sub g7_map_retain_copy($indent: Str, $dst: Str, $src: Str): Str {
    $indent ~ $dst ~ ".len = " ~ $src ~ ".len;\n" ~
    $indent ~ $dst ~ ".keys = (const char**)" ~ $src ~ ".keys;\n" ~
    $indent ~ $dst ~ ".vals = " ~ $src ~ ".vals;\n" ~
    $indent ~ "guji_retain((const void*)" ~ $dst ~ ".keys);\n" ~
    $indent ~ "guji_retain(" ~ $dst ~ ".vals);\n"
}

sub g7_arr_retain_copy($dst: Str, $src_data: Str, $src_len: Str): Str {
    "\t" ~ $dst ~ ".len = " ~ $src_len ~ ";\n" ~
    "\t" ~ $dst ~ ".data = " ~ $src_data ~ ";\n" ~
    "\tguji_retain(" ~ $dst ~ ".data);\n"
}

sub g7_copy_list_loop($tmp: Str, $elem: CgKind, $ctype: Str, $src_data: Str, $src_len: Str, $state: CgState): Result[CgState, Str] {
    match $elem {
        CgMap($vk) {
            # Share the outer ARR_MAP via retain (see g7_slice_retain_copy). Nested
            # nominal leaves live under row vals arrays the runtime cannot copy_arr.
            Ok(CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ g7_arr_retain_copy($tmp, $src_data, $src_len),
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ))
        }
        CgList($inner) {
            Ok(CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ g7_arr_retain_copy($tmp, $src_data, $src_len),
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ))
        }
        _ {
            match g7_list_arr_kind($elem) {
                Err($m) { Err($m) }
                Ok($ak) {
                    $idx = "gi" ~ c_int($state.ntmp)
                    $retain = match $elem {
                        CgStr { "\t\tguji_retain(((" ~ $ctype ~ "*)" ~ $tmp ~ ".data)[" ~ $idx ~ "]);\n" }
                        CgEnum($name) { "\t\tguji_retain_" ~ $name ~ "_fields(&((" ~ $ctype ~ "*)" ~ $tmp ~ ".data)[" ~ $idx ~ "]);\n" }
                        CgClass($name) { "\t\tguji_retain_" ~ $name ~ "_fields(&((" ~ $ctype ~ "*)" ~ $tmp ~ ".data)[" ~ $idx ~ "]);\n" }
                        _ { "" }
                    }
                    Ok(CgState(
                        interns: $state.interns,
                        decls: $state.decls ~ "\tint64_t " ~ $idx ~ " = 0;\n",
                        body: $state.body ~
                            "\t" ~ $tmp ~ ".len = " ~ $src_len ~ ";\n" ~
                            "\t" ~ $tmp ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $src_len ~ ");\n" ~
                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src_len ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                            "\t\t((" ~ $ctype ~ "*)" ~ $tmp ~ ".data)[" ~ $idx ~ "] = " ~ $src_data ~ "[" ~ $idx ~ "];\n" ~
                            $retain ~
                            "\t}\n",
                        nstr: $state.nstr,
                        ntmp: $state.ntmp + 1
                    ))
                }
            }
        }
    }
}

sub g7_lower_list_value_from_var($elem: CgKind, $var: CgVar, $state: CgState): Result[CgValueOut, Str] {
    match g7_list_c_type($elem) {
        Err($m) { Err($m) }
        Ok($ctype) {
            $tmp = g4_value_tmp(CgList($elem), $state.ntmp)
            $st0 = CgState(
                interns: $state.interns,
                decls: $state.decls ~ "\tguji_slice_t " ~ $tmp ~ " = \{0};\n",
                body: $state.body,
                nstr: $state.nstr,
                ntmp: $state.ntmp + 1
            )
            match g7_copy_list_loop($tmp, $elem, $ctype, g7_list_var_data($var, $ctype), g7_list_var_len($var), $st0) {
                Err($m) { Err($m) }
                Ok($st1) { Ok(CgValueOut(state: $st1, c: $tmp)) }
            }
        }
    }
}

sub g7_lower_list_literal_value($elem: CgKind, $items: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $elem {
        CgList($inner) { g7_lower_nested_list_literal_value($inner, $items, $state, $env) }
        CgMap($vk) { g7_lower_map_elem_list_literal_value($vk, $items, $state, $env) }
        _ {
            match g7_list_c_type($elem) {
                Err($m) { Err($m) }
                Ok($ctype) {
                    match g7_list_arr_kind($elem) {
                        Err($m) { Err($m) }
                        Ok($ak) {
                            match g7_lower_scalar_elems($elem, $items, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($lo) {
                                    $tmp = g4_value_tmp(CgList($elem), $lo.state.ntmp)
                                    $assigns = g7_slice_elem_assigns($tmp, $ctype, $lo.rvals, 0)
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $lo.state.interns,
                                            decls: $lo.state.decls ~ "\tguji_slice_t " ~ $tmp ~ " = \{0};\n",
                                            body: $lo.state.body ~ "\t" ~ $tmp ~ ".len = " ~ c_int($lo.count) ~ ";\n\t" ~ $tmp ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ c_int($lo.count) ~ ");\n" ~ $assigns,
                                            nstr: $lo.state.nstr,
                                            ntmp: $lo.state.ntmp + 1
                                        ),
                                        c: $tmp
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_lower_nested_list_items($inner: CgKind, $outer: Str, $items: ExprList, $idx: Int, $state: CgState, $env: CgEnv): Result[NestedListElemsOut, Str] {
    match $items {
        ExprNil { Ok(NestedListElemsOut(state: $state, count: $idx)) }
        ExprCons($head, $tail) {
            match g7_lower_list_value($inner, $head, $state, $env) {
                Err($m) { Err($m) }
                Ok($row) {
                    $st = CgState(
                        interns: $row.state.interns,
                        decls: $row.state.decls,
                        body: $row.state.body ~
                            "\t((guji_slice_t*)" ~ $outer ~ ".data)[" ~ c_int($idx) ~ "] = " ~ $row.c ~ ";\n" ~
                            "\t" ~ $row.c ~ ".data = NULL;\n" ~
                            "\t" ~ $row.c ~ ".len = 0;\n",
                        nstr: $row.state.nstr,
                        ntmp: $row.state.ntmp
                    )
                    g7_lower_nested_list_items($inner, $outer, $tail, $idx + 1, $st, $env)
                }
            }
        }
    }
}

sub g7_lower_nested_list_literal_value($inner: CgKind, $items: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    $count = exprlist_len($items)
    if $count == 0 {
        Err(g3_unsupported())
    } else {
        $tmp = g4_value_tmp(CgList(CgList($inner)), $state.ntmp)
        $st0 = CgState(
            interns: $state.interns,
            decls: $state.decls ~ "\tguji_slice_t " ~ $tmp ~ " = \{0};\n",
            body: $state.body ~
                "\t" ~ $tmp ~ ".len = " ~ c_int($count) ~ ";\n" ~
                "\t" ~ $tmp ~ ".data = guji_arr_alloc(GUJI_KIND_ARR_SLICE, sizeof(guji_slice_t), " ~ c_int($count) ~ ");\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        )
        match g7_lower_nested_list_items($inner, $tmp, $items, 0, $st0, $env) {
            Err($m) { Err($m) }
            Ok($lo) {
                Ok(CgValueOut(
                    state: $lo.state,
                    c: $tmp
                ))
            }
        }
    }
}

# ---- Nested collection literals: a list whose ELEMENTS are maps ---------------
# `List[Map[Str, V]]` (a list of scalar-valued maps) lowers exactly like native's
# emitted C (measured via a throwaway GenerateC dumper): the outer list backing is
# a `GUJI_KIND_ARR_MAP` array of `guji_map_t`, and each element map literal is
# materialized to an owned `guji_map_t` value via the existing map-value path, then
# MOVED into the array slot (nulling the temp's keys/vals so no double-free). The
# ARR_MAP drop cascades to release each element map when the outer list dies. This
# mirrors g7_lower_nested_list_items (which does the same for ARR_SLICE list
# elements) but with a map value in each slot.
sub g7_lower_map_elem_list_items($vk: CgKind, $outer: Str, $items: ExprList, $idx: Int, $state: CgState, $env: CgEnv): Result[NestedListElemsOut, Str] {
    match $items {
        ExprNil { Ok(NestedListElemsOut(state: $state, count: $idx)) }
        ExprCons($head, $tail) {
            match g7_lower_map_value($vk, $head, $state, $env) {
                Err($m) { Err($m) }
                Ok($row) {
                    $st = CgState(
                        interns: $row.state.interns,
                        decls: $row.state.decls,
                        body: $row.state.body ~
                            "\t((guji_map_t*)" ~ $outer ~ ".data)[" ~ c_int($idx) ~ "] = " ~ $row.c ~ ";\n" ~
                            "\t" ~ $row.c ~ ".keys = NULL;\n" ~
                            "\t" ~ $row.c ~ ".vals = NULL;\n",
                        nstr: $row.state.nstr,
                        ntmp: $row.state.ntmp
                    )
                    g7_lower_map_elem_list_items($vk, $outer, $tail, $idx + 1, $st, $env)
                }
            }
        }
    }
}

sub g7_lower_map_elem_list_literal_value($vk: CgKind, $items: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    $count = exprlist_len($items)
    if $count == 0 {
        Err(g3_unsupported())
    } else {
        $tmp = g4_value_tmp(CgList(CgMap($vk)), $state.ntmp)
        $st0 = CgState(
            interns: $state.interns,
            decls: $state.decls ~ "\tguji_slice_t " ~ $tmp ~ " = \{0};\n",
            body: $state.body ~
                "\t" ~ $tmp ~ ".len = " ~ c_int($count) ~ ";\n" ~
                "\t" ~ $tmp ~ ".data = guji_arr_alloc(GUJI_KIND_ARR_MAP, sizeof(guji_map_t), " ~ c_int($count) ~ ");\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        )
        match g7_lower_map_elem_list_items($vk, $tmp, $items, 0, $st0, $env) {
            Err($m) { Err($m) }
            Ok($lo) {
                Ok(CgValueOut(
                    state: $lo.state,
                    c: $tmp
                ))
            }
        }
    }
}

sub g7_lower_list_value($elem: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EList($items) { g7_lower_list_literal_value($elem, $items, $state, $env) }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgList($actual) {
                            if cgkind_eq($actual, $elem) { g7_lower_list_value_from_var($elem, $var, $state) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        ECall($callee, $args) {
            # The `args()` prelude (§15.1) returns a heap-backed List[Str] of the
            # program's command-line arguments. It is the first value-returning
            # builtin the selfhost codegen models; every other list-valued call is
            # a user sub lowered through the generic call path.
            if g7_is_args_callee($callee, $args) && cgkind_eq($elem, CgStr) {
                Ok(g7_lower_args_value($state))
            } else {
                match g7_reverse_value($callee, $args, $elem, $state, $env) {
                    Ok($v) { Ok($v) }
                    Err($mr) {
                        match g7_sort_value($callee, $args, $elem, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($msv) {
                        match g7_sort_by_value($callee, $args, $elem, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($msbv) {
                        match g7_take_value($callee, $args, $elem, $state, $env) {
                            Ok($v) { Ok($v) }
                            Err($mt) {
                                match g7_drop_value($callee, $args, $elem, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($md) {
                                    match g7_map_projection_value($callee, $args, $elem, $state, $env) {
                                    Ok($v) { Ok($v) }
                                    Err($mp) {
                                    match g7_split_value($callee, $args, $elem, $state, $env) {
                                        Ok($v) { Ok($v) }
                                        Err($ms) {
                                            match g7_lines_value($callee, $args, $elem, $state, $env) {
                                            Ok($v) { Ok($v) }
                                            Err($mls) {
                                            match g7_map_value($callee, $args, $elem, $state, $env) {
                                                Ok($v) { Ok($v) }
                                                Err($mm) {
                                                    match g7_filter_value($callee, $args, $state, $env) {
                                                        Ok($v) { Ok($v) }
                                                        Err($mf) {
                                                            match g4_unwrap_or_list($elem, $callee, $args, $state, $env) {
                                                                Ok($v) { Ok($v) }
                                                                Err($muor) {
                                                            match g4_option_unwrap_list($elem, $callee, $args, $state, $env) {
                                                                Ok($v) { Ok($v) }
                                                                Err($mu) {
                                                                    match g7_reduce_value(CgList($elem), $callee, $args, 1, $state, $env) {
                                                                        Ok($v) { Ok($v) }
                                                                        Err($mreduce) { g5_call_value(RList($elem), $callee, $args, $state, $env) }
                                                                    }
                                                                }
                                                            }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            }
                                            }
                                        }
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        }
        }
        }
        }
        }
        EIf($cond, $then, $elifs, $els) { g4_lower_if_value(CgList($elem), $cond, $then, $elifs, $els, $state, $env) }
        EMatch($subj, $arms) { g6_lower_match(CgList($elem), $subj, $arms, $state, $env) }
        EField($obj, $name) { g8_lower_field_value(CgList($elem), $obj, $name, $state, $env) }
        EIndex($obj, $idx) { g7_lower_index(CgList($elem), $obj, $idx, $state, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# True iff `$callee($args)` is the niladic `args()` prelude call.
sub g7_is_args_callee($callee: Expr, $args: ExprList): Bool {
    match $callee {
        EName($fn) {
            if $fn == "args" {
                match $args { ExprNil { true } _ { false } }
            } else {
                false
            }
        }
        _ { false }
    }
}

# True iff `$callee($args)` is the dyadic `split($s, $sep)` prelude call or the
# method-form `$s.split($sep)`, which always yields List[Str] (§15.3). Used by
# element-kind inference for unannotated `@nc = split(...)` / `@nc = $s.split(...)`
# bindings — the split lowering itself lives in g7_split_value.
sub g7_is_split_callee($callee: Expr, $args: ExprList): Bool {
    match $callee {
        EName($fn) {
            if $fn == "split" {
                match $args { ExprCons($s, ExprCons($sep, ExprNil)) { true } _ { false } }
            } else {
                false
            }
        }
        EField($recv, $method) {
            if $method == "split" {
                match $args { ExprCons($sep, ExprNil) { true } _ { false } }
            } else {
                false
            }
        }
        _ { false }
    }
}

# True iff `$callee($args)` is the `lines($s)` (unary) or `$s.lines()` (niladic method)
# prelude call, which always yields List[Str] (§15.3). Used by element-kind inference
# for unannotated `@ls = lines(...)` / `@ls = $s.lines()` bindings — the lines lowering
# itself lives in g7_lines_value.
sub g7_is_lines_callee($callee: Expr, $args: ExprList): Bool {
    match $callee {
        EName($fn) {
            if $fn == "lines" {
                match $args { ExprCons($s, ExprNil) { true } _ { false } }
            } else {
                false
            }
        }
        EField($recv, $method) {
            if $method == "lines" {
                match $args { ExprNil { true } _ { false } }
            } else {
                false
            }
        }
        _ { false }
    }
}

# Lower `args()` to an owned `guji_slice_t` of List[Str]. `guji_args` allocates a
# GUJI_KIND_ARR_STR payload and writes its length through the out-param; the slice
# OWNS that payload, so the binding (or arg-passing) site releases it via `.data`.
sub g7_lower_args_value($state: CgState): CgValueOut {
    $cn = g4_value_tmp(CgList(CgStr), $state.ntmp)
    CgValueOut(
        state: CgState(
            interns: $state.interns,
            decls: $state.decls ~ "\tguji_slice_t " ~ $cn ~ " = \{0};\n",
            body: $state.body ~ "\t" ~ $cn ~ ".data = (void*)guji_args(&" ~ $cn ~ ".len);\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        ),
        c: $cn
    )
}

# Lower the `split($s, $sep)` / `$s.split($sep)` prelude (§15.3) to an OWNED
# `guji_slice_t` of List[Str]. `guji_split` returns a counted GUJI_KIND_ARR_STR
# array whose elements it owns; the produced slice OWNS that `.data` pointer, so the
# binding/consumer releases it via `.data` (slice 5 E5d-8d). Only List[Str] — `split`
# always yields string pieces. The two Str arguments are lowered to OWNED temps
# (g3_str_lower retains a bound name) and released right after the call, since
# `guji_split` copies the bytes it needs and does NOT take ownership of the argument
# strings. Mirrors native's `strSplit` behaviorally (native borrows recv/sep; the
# selfhost retain+release nets the same refcount).
sub g7_split_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if cgkind_eq($elem, CgStr) {
        match $callee {
            EName($fn) {
                if $fn == "split" {
                    match $args {
                        ExprCons($s, ExprCons($sep, ExprNil)) { g7_split_core($s, $sep, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
            EField($recv, $method) {
                if $method == "split" {
                    match $args {
                        ExprCons($sep, ExprNil) { g7_split_core($recv, $sep, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g7_split_core($s: Expr, $sep: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g3_str_lower($s, $state, $env) {
        Err($m) { Err($m) }
        Ok($sl) {
            match g3_str_lower($sep, $sl.state, $env) {
                Err($m) { Err($m) }
                Ok($pl) {
                    $tmp = g4_value_tmp(CgList(CgStr), $pl.state.ntmp)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $pl.state.interns,
                            decls: $pl.state.decls ~ "\tguji_slice_t " ~ $tmp ~ " = \{0};\n",
                            body: $pl.state.body ~
                                "\t" ~ $tmp ~ ".data = (void*)guji_split(" ~ $sl.tmp ~ ", " ~ $pl.tmp ~ ", &" ~ $tmp ~ ".len);\n" ~
                                "\tguji_release(" ~ $sl.tmp ~ ");\n" ~
                                "\tguji_release(" ~ $pl.tmp ~ ");\n",
                            nstr: $pl.state.nstr,
                            ntmp: $pl.state.ntmp + 1
                        ),
                        c: $tmp
                    ))
                }
            }
        }
    }
}

# Lower the `lines($s)` / `$s.lines()` prelude (§15.3) to an OWNED `guji_slice_t` of
# List[Str]. Like `split`, `guji_lines` hands back a counted GUJI_KIND_ARR_STR array it
# filled with owned fresh copies, so the produced slice OWNS that `.data` pointer and the
# consumer releases it via `.data`. `lines` takes NO separator — the function form is
# unary (`lines($s)`), the method form niladic (`$s.lines()`), mirroring native's
# `strLines` dispatch (`codegen.go` case "lines"). The Str receiver lowers to an OWNED
# temp (`g3_str_lower` retains a bound name) and is released after the call, since
# `guji_lines` copies the bytes it keeps and does NOT take ownership of the argument —
# exactly the split ownership shape (retain+release nets native's borrow refcount).
sub g7_lines_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if cgkind_eq($elem, CgStr) {
        match $callee {
            EName($fn) {
                if $fn == "lines" {
                    match $args {
                        ExprCons($s, ExprNil) { g7_lines_core($s, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
            EField($recv, $method) {
                if $method == "lines" {
                    match $args {
                        ExprNil { g7_lines_core($recv, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g7_lines_core($s: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g3_str_lower($s, $state, $env) {
        Err($m) { Err($m) }
        Ok($sl) {
            $tmp = g4_value_tmp(CgList(CgStr), $sl.state.ntmp)
            Ok(CgValueOut(
                state: CgState(
                    interns: $sl.state.interns,
                    decls: $sl.state.decls ~ "\tguji_slice_t " ~ $tmp ~ " = \{0};\n",
                    body: $sl.state.body ~
                        "\t" ~ $tmp ~ ".data = (void*)guji_lines(" ~ $sl.tmp ~ ", &" ~ $tmp ~ ".len);\n" ~
                        "\tguji_release(" ~ $sl.tmp ~ ");\n",
                    nstr: $sl.state.nstr,
                    ntmp: $sl.state.ntmp + 1
                ),
                c: $tmp
            ))
        }
    }
}

sub g7_take_core($recv: Expr, $count: Expr, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_c_type($elem) {
        Err($m) { Err($m) }
        Ok($ctype) {
            match g7_list_arr_kind($elem) {
                Err($m) { Err($m) }
                Ok($ak) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($src) {
                            match g3_int_rvalue_state($count, $src.state, $env) {
                                Err($m) { Err($m) }
                                Ok($cv) {
                                    $ct = "gi" ~ c_int($cv.state.ntmp)
                                    $dst = g4_value_tmp(CgList($elem), $cv.state.ntmp + 1)
                                    $idx = "gi" ~ c_int($cv.state.ntmp + 2)
                                    $retain = g7_row_retain_slot($elem, $ctype, $dst, $idx)
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $cv.state.interns,
                                            decls: $cv.state.decls ~
                                                "\tint64_t " ~ $ct ~ " = 0;\n" ~
                                                "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                                "\tint64_t " ~ $idx ~ " = 0;\n",
                                            body: $cv.state.body ~
                                                "\t" ~ $ct ~ " = " ~ $cv.c ~ ";\n" ~
                                                "\tif (" ~ $ct ~ " < 0) \{ " ~ $ct ~ " = 0; }\n" ~
                                                "\tif (" ~ $ct ~ " > " ~ $src.c ~ ".len) \{ " ~ $ct ~ " = " ~ $src.c ~ ".len; }\n" ~
                                                "\t" ~ $dst ~ ".len = " ~ $ct ~ ";\n" ~
                                                "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $ct ~ ");\n" ~
                                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $ct ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                "\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                $retain ~
                                                "\t}\n" ~
                                                g7_slice_release($src.c),
                                            nstr: $cv.state.nstr,
                                            ntmp: $cv.state.ntmp + 3
                                        ),
                                        c: $dst
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_take_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "take") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "take" {
                        match $args {
                            ExprCons($recv, ExprCons($count, ExprNil)) { g7_take_core($recv, $count, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "take" {
                        match $args {
                            ExprCons($count, ExprNil) { g7_take_core($recv, $count, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Infer the CgKind of a flat list ELEMENT expression by trying to lower it under
# each supported built-in scalar kind first, then resolving a user enum/class.
# The lowering
# runs against a THROWAWAY probe state and its result is discarded — only the
# accept/reject verdict is consumed, so no C is emitted here; the real element
# lowering happens later in g7_lower_scalar_elems under the returned kind. Env
# references (`[$a, $b]`) resolve because the caller's real env is threaded in. The
# typechecker has already verified the list is homogeneous, so the first element's
# kind is the list's kind.
sub g7_scalar_elem_kind($expr: Expr, $env: CgEnv): Result[CgKind, Str] {
    $probe = CgState(interns: "", decls: "", body: "", nstr: 0, ntmp: 0)
    match g7_lower_scalar_elem(CgInt, $expr, $probe, $env) {
        Ok($iv) { Ok(CgInt) }
        Err($mi) {
            match g7_lower_scalar_elem(CgFloat, $expr, $probe, $env) {
                Ok($fv) { Ok(CgFloat) }
                Err($mf) {
                    match g7_lower_scalar_elem(CgBool, $expr, $probe, $env) {
                        Ok($bv) { Ok(CgBool) }
                        Err($mb) {
                            match g7_lower_scalar_elem(CgStr, $expr, $probe, $env) {
                                Ok($sv) { Ok(CgStr) }
                                Err($ms) {
                                    match g6e_enum_kind_from_value($expr, $env) {
                                        Ok($ek) { Ok($ek) }
                                        Err($me) {
                                            match g8_class_kind_from_value($expr, $env) {
                                                Ok($ck) { Ok($ck) }
                                                Err($mc) { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Infer a list element kind from a control-flow branch's final value. The
# typechecker has already proved all value branches agree, so the first branch
# whose final expression can be classified is authoritative. A branch-final
# local that is not in the outer codegen env is skipped in favor of a later arm.
sub g7_list_kind_from_block($stmts: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match g6e_block_final_expr($stmts) {
        None { Err(g3_unsupported()) }
        Some($e) { g7_list_kind_from_value($e, $env) }
    }
}

sub g7_list_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g7_list_kind_from_block($arm.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g7_list_kind_from_arms($rest, $env) }
            }
        }
    }
}

sub g7_list_kind_from_if_tail($elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) { g7_list_kind_from_block($body, $env) }
            }
        }
        ElifCons($head, $tail) {
            match g7_list_kind_from_block($head.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g7_list_kind_from_if_tail($tail, $els, $env) }
            }
        }
    }
}

sub g7_list_kind_from_if($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match g7_list_kind_from_block($then, $env) {
        Ok($k) { Ok($k) }
        Err($m) { g7_list_kind_from_if_tail($elifs, $els, $env) }
    }
}

# Infer a list binding's element kind from its RHS value when there is no type
# annotation (`@argv = args()`): the `args()` prelude yields List[Str], a call to
# a user sub yields its declared RList element, a list local yields its element
# kind, and a non-empty list LITERAL (`@xs = [1, 2, 3]`) yields its first element's
# scalar/nested kind. An empty literal `[]` carries no element to fix the kind and
# defaults to Int, matching the existing empty-map default.
sub g7_list_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $value {
        EList($items) {
            match $items {
                # Empty `[]` has no element to fix V; native defaults to Int
                # (list()). Twin of MapEntryNil → CgInt in g7_map_val_kind_from_value.
                ExprNil { Ok(CgInt) }
                ExprCons($first, $rest) {
                    match g7_scalar_elem_kind($first, $env) {
                        Ok($sk) { Ok($sk) }
                        Err($ms) {
                            match g7_list_kind_from_value($first, $env) {
                                Ok($lk) { Ok(CgList($lk)) }
                                Err($ml) {
                                    match g7_map_val_kind_from_value($first, $env) {
                                        Ok($vk) { Ok(CgMap($vk)) }
                                        Err($mm) { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ECall($callee, $args) {
            match g4_unwrap_or_list_elem_kind($callee, $args, $env) {
                Ok($el) { Ok($el) }
                Err($not_uor) {
            match g4_option_unwrap_list_elem_kind($callee, $args, $env) {
                Ok($el) { Ok($el) }
                Err($not_unwrap) {
            if g7_is_args_callee($callee, $args) {
                Ok(CgStr)
            } else {
                if g7_is_split_callee($callee, $args) {
                    Ok(CgStr)
                } else {
                if g7_is_lines_callee($callee, $args) {
                    Ok(CgStr)
                } else {
                    match g7_reverse_kind($callee, $args, $env) {
                        Ok($rk) { Ok($rk) }
                        Err($mr) {
                            match g7_sort_kind($callee, $args, $env) {
                            Ok($sk) { Ok($sk) }
                            Err($msk) {
                            match g7_sort_by_kind($callee, $args, $env) {
                            Ok($sbk) { Ok($sbk) }
                            Err($msbk) {
                            match g7_take_kind($callee, $args, $env) {
                                Ok($tk) { Ok($tk) }
                                Err($mt) {
                                    match g7_drop_kind($callee, $args, $env) {
                                        Ok($dk) { Ok($dk) }
                                        Err($md) {
                                            match g7_map_projection_kind($callee, $args, $env) {
                                                Ok($pk) { Ok($pk) }
                                                Err($mp) {
                                            match g7_map_kind($callee, $args, $env) {
                                                Ok($mk) { Ok($mk) }
                                                Err($mm) {
                                                    match g7_filter_kind($callee, $args, $env) {
                                                        Ok($fk) { Ok($fk) }
                                                        Err($mf) {
                                                            match g7_reduce_list_kind($callee, $args, $env) {
                                                                Ok($rk) { Ok($rk) }
                                                                Err($mreduce) {
                                                                    match g5_resolve_call_target($callee, $args, $env) {
                                                                        Err($m) {
                                                                            match g5_fn_arg_kind($callee, $env) {
                                                                                Ok($fk) {
                                                                                    match $fk {
                                                                                        CgFn($p, $r) {
                                                                                            match $r {
                                                                                                RList($el) { Ok($el) }
                                                                                                _ { Err(g3_unsupported()) }
                                                                                            }
                                                                                        }
                                                                                        _ { Err(g3_unsupported()) }
                                                                                    }
                                                                                }
                                                                                Err($fm) { Err($m) }
                                                                            }
                                                                        }
                                                                        Ok($target) {
                                                                            match $target.sig.ret {
                                                                                RList($el) { Ok($el) }
                                                                                _ { Err(g3_unsupported()) }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                                }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
                    }
                }
                }
            }
                }
            }
                }
            }
        }
        }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgList($el) { Ok($el) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EIndex($obj, $idx) {
            match g7_list_kind_from_value($obj, $env) {
                Err($m) {
                    # A map index can itself yield a list. Preserve the element
                    # kind so a following `[i]` can lower through the same
                    # recursive collection-index path.
                    match g7_map_val_kind_from_value($obj, $env) {
                        Err($mm) { Err($mm) }
                        Ok($outer) {
                            match $outer {
                                CgList($inner) { Ok($inner) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                Ok($outer) {
                    match $outer {
                        CgList($inner) { Ok($inner) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        # Class List field (`$obj.tags` / `@rows[0].tags`): element kind comes
        # from the field's declared CgList — unlocks sum/min/max/reduce and the
        # owned materialization path used by chained index receivers.
        EField($obj, $name) {
            match g8_resolve_field_acc($obj, $name, $env) {
                Ok($fa) {
                    match $fa.kind {
                        CgList($el) { Ok($el) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                Err($ignored) {
                    match g8_class_kind_from_value($obj, $env) {
                        Err($m) { Err($m) }
                        Ok($okind) {
                            match $okind {
                                CgClass($cn) {
                                    match cg_env_lookup_class($env, $cn) {
                                        None { Err(g3_unsupported()) }
                                        Some($info) {
                                            match g8_class_field_lookup($info.fields, $name) {
                                                None { Err(g3_unsupported()) }
                                                Some($f) {
                                                    match $f.kind {
                                                        CgList($el) { Ok($el) }
                                                        _ { Err(g3_unsupported()) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
        EIf($cond, $then, $elifs, $els) { g7_list_kind_from_if($then, $elifs, $els, $env) }
        EMatch($subject, $arms) { g7_list_kind_from_arms($arms, $env) }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_take_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "take") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "take" {
                        match $args {
                            ExprCons($recv, ExprCons($count, ExprNil)) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "take" {
                        match $args {
                            ExprCons($count, ExprNil) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# After `dst.data[idx] = src-row`, retain whatever counted storage the copied
# row points at, so the destination survives the source slice's release: a Str
# row retains the string, a nested-list row retains its element array, a map
# row retains BOTH its keys and vals arrays. Scalar rows copy by value. Shared
# by reverse/take/drop — every core that copies rows out of an owned source
# slice it then releases.
sub g7_row_retain_slot($elem: CgKind, $ctype: Str, $dst: Str, $idx: Str): Str {
    match $elem {
        CgStr { "\t\tguji_retain(((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "]);\n" }
        CgList($inner) { "\t\tguji_retain((const void*)(((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "].data));\n" }
        CgMap($vk) {
            "\t\tguji_retain((const void*)(((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "].keys));\n" ~
            "\t\tguji_retain((const void*)(((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "].vals));\n"
        }
        _ { "" }
    }
}

# Lower `reverse(@xs)` / `@xs.reverse()` (§15) to a fresh OWNED list whose slots
# are copied from the source in reverse order. This mirrors native `listReverse`:
# materialize the receiver through the owned-list path, allocate a same-length
# destination, copy slot `src.len - 1 - i`, retain counted slots the destination
# now owns (Str payloads and nested-list row storage), then release the source
# slice.
sub g7_reverse_core($recv: Expr, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_c_type($elem) {
        Err($m) { Err($m) }
        Ok($ctype) {
            match g7_list_arr_kind($elem) {
                Err($m) { Err($m) }
                Ok($ak) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($src) {
                            $dst = g4_value_tmp(CgList($elem), $src.state.ntmp)
                            $idx = "gi" ~ c_int($src.state.ntmp + 1)
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $src.state.interns,
                                    decls: $src.state.decls ~
                                        "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                        "\tint64_t " ~ $idx ~ " = 0;\n",
                                    body: $src.state.body ~
                                        "\t" ~ $dst ~ ".len = " ~ $src.c ~ ".len;\n" ~
                                        "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $src.c ~ ".len);\n" ~
                                        "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                        "\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $src.c ~ ".len - 1 - " ~ $idx ~ "];\n" ~
                                        g7_row_retain_slot($elem, $ctype, $dst, $idx) ~
                                        "\t}\n" ~
                                        g7_slice_release($src.c),
                                    nstr: $src.state.nstr,
                                    ntmp: $src.state.ntmp + 2
                                ),
                                c: $dst
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g7_reverse_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "reverse") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "reverse" {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_reverse_core($recv, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "reverse" {
                        match $args {
                            ExprNil { g7_reverse_core($recv, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_reverse_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "reverse") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "reverse" {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "reverse" {
                        match $args {
                            ExprNil { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# True iff `sort` can lower a list of this element kind. Native `listSort`
# (`codegen.go`) supports only ordered scalar/Str surfaces — Int, Float, Str
# (NOT Bool, NOT nested lists); C is entitled to decline everything else, matching
# native's own `sort requires List[Int], List[Float], or List[Str]` reject.
sub g7_sort_supported($elem: CgKind): Bool {
    match $elem {
        CgInt { true }
        CgFloat { true }
        CgStr { true }
        _ { false }
    }
}

# The per-element strict `<` comparison uses counted Guji Str ordering for Str
# and plain `a < b` for numeric scalars.
sub g7_sort_less($elem: CgKind, $a: Str, $b: Str): Str {
    match $elem {
        CgStr { "guji_str_compare(" ~ $a ~ ", " ~ $b ~ ") < 0" }
        _ { $a ~ " < " ~ $b }
    }
}

# Lower `sort(@xs)` / `@xs.sort()` (§15.1) to a fresh OWNED list holding a STABLE
# ordered copy of the source. Mirrors native `listSort` + `sortedOrder`: build an
# index permutation `order` (0..len-1), stable insertion-sort it by the per-element
# `<` comparison over the source elements, allocate a same-length destination, copy
# `dst[i] = src[order[i]]`, retain the counted Str slots the destination now owns,
# release the order array, then release the materialized source slice. Element kinds
# are Int/Float/Str only (native declines the rest); the receiver is materialized
# through the same `g7_lower_list_value` owned-list path `reverse` uses.
sub g7_sort_core($recv: Expr, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if g7_sort_supported($elem) {
        match g7_list_c_type($elem) {
            Err($m) { Err($m) }
            Ok($ctype) {
                match g7_list_arr_kind($elem) {
                    Err($m) { Err($m) }
                    Ok($ak) {
                        match g7_lower_list_value($elem, $recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($src) {
                                $n = $src.state.ntmp
                                $dst = g4_value_tmp(CgList($elem), $n)
                                $order = "go" ~ c_int($n + 1)
                                $idx = "gi" ~ c_int($n + 2)
                                $outer = "gi" ~ c_int($n + 3)
                                $cur = "gi" ~ c_int($n + 4)
                                $j = "gi" ~ c_int($n + 5)
                                $srclen = $src.c ~ ".len"
                                $srcdata = "((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)"
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $src.state.interns,
                                        decls: $src.state.decls ~
                                            "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                            "\tint64_t* " ~ $order ~ " = NULL;\n" ~
                                            "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                            "\tint64_t " ~ $outer ~ " = 0;\n" ~
                                            "\tint64_t " ~ $cur ~ " = 0;\n" ~
                                            "\tint64_t " ~ $j ~ " = 0;\n",
                                        body: $src.state.body ~
                                            "\t" ~ $order ~ " = (int64_t*)guji_arr_alloc(GUJI_KIND_ARR_SCALAR, sizeof(int64_t), " ~ $srclen ~ ");\n" ~
                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $srclen ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                            "\t\t" ~ $order ~ "[" ~ $idx ~ "] = " ~ $idx ~ ";\n" ~
                                            "\t}\n" ~
                                            "\tfor (" ~ $outer ~ " = 1; " ~ $outer ~ " < " ~ $srclen ~ "; " ~ $outer ~ " = guji_add(" ~ $outer ~ ", 1)) \{\n" ~
                                            "\t\t" ~ $cur ~ " = " ~ $order ~ "[" ~ $outer ~ "];\n" ~
                                            "\t\t" ~ $j ~ " = " ~ $outer ~ " - 1;\n" ~
                                            "\t\twhile (" ~ $j ~ " >= 0 && " ~ g7_sort_less($elem, $srcdata ~ "[" ~ $cur ~ "]", $srcdata ~ "[" ~ $order ~ "[" ~ $j ~ "]]") ~ ") \{\n" ~
                                            "\t\t\t" ~ $order ~ "[" ~ $j ~ " + 1] = " ~ $order ~ "[" ~ $j ~ "];\n" ~
                                            "\t\t\t" ~ $j ~ " = " ~ $j ~ " - 1;\n" ~
                                            "\t\t}\n" ~
                                            "\t\t" ~ $order ~ "[" ~ $j ~ " + 1] = " ~ $cur ~ ";\n" ~
                                            "\t}\n" ~
                                            "\t" ~ $dst ~ ".len = " ~ $srclen ~ ";\n" ~
                                            "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $srclen ~ ");\n" ~
                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $srclen ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                            "\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = " ~ $srcdata ~ "[" ~ $order ~ "[" ~ $idx ~ "]];\n" ~
                                            g7_row_retain_slot($elem, $ctype, $dst, $idx) ~
                                            "\t}\n" ~
                                            "\tguji_release((const void*)" ~ $order ~ ");\n" ~
                                            g7_slice_release($src.c),
                                        nstr: $src.state.nstr,
                                        ntmp: $n + 6
                                    ),
                                    c: $dst
                                ))
                            }
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g7_sort_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "sort") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "sort" {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_sort_core($recv, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "sort" {
                        match $args {
                            ExprNil { g7_sort_core($recv, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_sort_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "sort") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "sort" {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "sort" {
                        match $args {
                            ExprNil { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# `sort_by` keys are comparable Int/Float/Str values. Native rejects Bool keys
# (`sort_by key must be Int, Float, or Str for codegen`), so the selfhost port
# mirrors that boundary.
sub g7_sort_by_key_supported($kind: CgKind): Bool {
    match $kind {
        CgInt { true }
        CgFloat { true }
        CgStr { true }
        _ { false }
    }
}

sub g7_sort_by_key_kind_probe($expr: Expr, $env: CgEnv): Result[CgKind, Str] {
    $probe = CgState(interns: "", decls: "", body: "", nstr: 0, ntmp: 0)
    match g4_lower_value(CgInt, $expr, $probe, $env) {
        Ok($iv) { Ok(CgInt) }
        Err($mi) {
            match g4_lower_value(CgFloat, $expr, $probe, $env) {
                Ok($fv) { Ok(CgFloat) }
                Err($mf) {
                    match g4_lower_value(CgStr, $expr, $probe, $env) {
                        Ok($sv) { Ok(CgStr) }
                        Err($ms) { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g7_sort_by_key_kind($src_elem: CgKind, $lam: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $lam {
        ELambda($params, $ret, $body, $topic) {
            match g7_lambda_body_expr($body) {
                Err($m) { Err($m) }
                Ok($expr) {
                    match g7_lambda_env($params, $src_elem, "gsort_by_probe", $env) {
                        Err($m) { Err($m) }
                        Ok($lenv) {
                            match g7_sort_by_key_kind_probe($expr, $lenv) {
                                Err($m) { Err($m) }
                                Ok($kind) {
                                    if g7_sort_by_key_supported($kind) { Ok($kind) } else { Err(g3_unsupported()) }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_sort_by_key_arr_kind($kind: CgKind): Result[Str, Str] {
    match $kind {
        CgStr { Ok("GUJI_KIND_ARR_STR") }
        CgInt { Ok("GUJI_KIND_ARR_SCALAR") }
        CgFloat { Ok("GUJI_KIND_ARR_SCALAR") }
        _ { Err(g3_unsupported()) }
    }
}

# Lower `sort_by(@xs, lam)` / `@xs.sort_by(lam)` (§15.1) to a fresh stable ordered
# copy of the source. Mirrors native's `listSortBy`: compute each lambda key once,
# stable insertion-sort an order permutation by the key array, then copy source
# elements through that order. The result element kind is unchanged. Unlike native's
# Str-key scratch (borrowed aliases), selfhost Str lowering yields owned temps, so
# the key array is `GUJI_KIND_ARR_STR` and is released after sorting.
sub g7_sort_by_core($recv: Expr, $lam: Expr, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($actual) {
            if cgkind_eq($actual, $elem) {
                match g7_list_c_type($elem) {
                    Err($m) { Err($m) }
                    Ok($ctype) {
                        match g7_list_arr_kind($elem) {
                            Err($m) { Err($m) }
                            Ok($ak) {
                                match g7_lower_list_value($elem, $recv, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($src) {
                                        match $lam {
                                            ELambda($params, $ret, $body, $topic) {
                                                match g7_lambda_body_expr($body) {
                                                    Err($m) { Err($m) }
                                                    Ok($expr) {
                                                        $binder = g4_value_tmp($elem, $src.state.ntmp)
                                                        match g7_lambda_env($params, $elem, $binder, $env) {
                                                            Err($m) { Err($m) }
                                                            Ok($lenv) {
                                                                match g7_sort_by_key_kind($elem, $lam, $env) {
                                                                    Err($m) { Err($m) }
                                                                    Ok($key_kind) {
                                                                        match g7_list_c_type($key_kind) {
                                                                            Err($m) { Err($m) }
                                                                            Ok($key_ctype) {
                                                                                match g7_sort_by_key_arr_kind($key_kind) {
                                                                                    Err($m) { Err($m) }
                                                                                    Ok($key_ak) {
                                                                                        $n = $src.state.ntmp
                                                                                        $keys = "gk" ~ c_int($n + 1)
                                                                                        $idx = "gi" ~ c_int($n + 2)
                                                                                        $dst = g4_value_tmp(CgList($elem), $n + 3)
                                                                                        $order = "go" ~ c_int($n + 4)
                                                                                        $outer = "gi" ~ c_int($n + 5)
                                                                                        $cur = "gi" ~ c_int($n + 6)
                                                                                        $j = "gi" ~ c_int($n + 7)
                                                                                        $srcdata = "((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)"
                                                                                        $keydata = "((" ~ $key_ctype ~ "*)" ~ $keys ~ ")"
                                                                                        $loop_start = CgState(
                                                                                            interns: $src.state.interns,
                                                                                            decls: $src.state.decls ~
                                                                                                g4_value_decl($elem, $binder) ~
                                                                                                "\t" ~ $key_ctype ~ "* " ~ $keys ~ " = NULL;\n" ~
                                                                                                "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                                                                "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                                                                                "\tint64_t* " ~ $order ~ " = NULL;\n" ~
                                                                                                "\tint64_t " ~ $outer ~ " = 0;\n" ~
                                                                                                "\tint64_t " ~ $cur ~ " = 0;\n" ~
                                                                                                "\tint64_t " ~ $j ~ " = 0;\n",
                                                                                            body: "",
                                                                                            nstr: $src.state.nstr,
                                                                                            ntmp: $n + 8
                                                                                        )
                                                                                        match g4_lower_value($key_kind, $expr, $loop_start, $lenv) {
                                                                                            Err($m) { Err($m) }
                                                                                            Ok($kv) {
                                                                                                Ok(CgValueOut(
                                                                                                    state: CgState(
                                                                                                        interns: $kv.state.interns,
                                                                                                        decls: $kv.state.decls,
                                                                                                        body: $src.state.body ~
                                                                                                            "\t" ~ $keys ~ " = (" ~ $key_ctype ~ "*)guji_arr_alloc(" ~ $key_ak ~ ", sizeof(" ~ $key_ctype ~ "), " ~ $src.c ~ ".len);\n" ~
                                                                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                                                            "\t\t" ~ $binder ~ " = " ~ $srcdata ~ "[" ~ $idx ~ "];\n" ~
                                                                                                            $kv.state.body ~
                                                                                                            "\t\t" ~ $keydata ~ "[" ~ $idx ~ "] = " ~ $kv.c ~ ";\n" ~
                                                                                                            "\t}\n" ~
                                                                                                            "\t" ~ $order ~ " = (int64_t*)guji_arr_alloc(GUJI_KIND_ARR_SCALAR, sizeof(int64_t), " ~ $src.c ~ ".len);\n" ~
                                                                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                                                            "\t\t" ~ $order ~ "[" ~ $idx ~ "] = " ~ $idx ~ ";\n" ~
                                                                                                            "\t}\n" ~
                                                                                                            "\tfor (" ~ $outer ~ " = 1; " ~ $outer ~ " < " ~ $src.c ~ ".len; " ~ $outer ~ " = guji_add(" ~ $outer ~ ", 1)) \{\n" ~
                                                                                                            "\t\t" ~ $cur ~ " = " ~ $order ~ "[" ~ $outer ~ "];\n" ~
                                                                                                            "\t\t" ~ $j ~ " = " ~ $outer ~ " - 1;\n" ~
                                                                                                            "\t\twhile (" ~ $j ~ " >= 0 && " ~ g7_sort_less($key_kind, $keydata ~ "[" ~ $cur ~ "]", $keydata ~ "[" ~ $order ~ "[" ~ $j ~ "]]") ~ ") \{\n" ~
                                                                                                            "\t\t\t" ~ $order ~ "[" ~ $j ~ " + 1] = " ~ $order ~ "[" ~ $j ~ "];\n" ~
                                                                                                            "\t\t\t" ~ $j ~ " = " ~ $j ~ " - 1;\n" ~
                                                                                                            "\t\t}\n" ~
                                                                                                            "\t\t" ~ $order ~ "[" ~ $j ~ " + 1] = " ~ $cur ~ ";\n" ~
                                                                                                            "\t}\n" ~
                                                                                                            "\tguji_release((const void*)" ~ $keys ~ ");\n" ~
                                                                                                            "\t" ~ $dst ~ ".len = " ~ $src.c ~ ".len;\n" ~
                                                                                                            "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $src.c ~ ".len);\n" ~
                                                                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                                                            "\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = " ~ $srcdata ~ "[" ~ $order ~ "[" ~ $idx ~ "]];\n" ~
                                                                                                            g7_row_retain_slot($elem, $ctype, $dst, $idx) ~
                                                                                                            "\t}\n" ~
                                                                                                            "\tguji_release((const void*)" ~ $order ~ ");\n" ~
                                                                                                            g7_slice_release($src.c),
                                                                                                        nstr: $kv.state.nstr,
                                                                                                        ntmp: $kv.state.ntmp
                                                                                                    ),
                                                                                                    c: $dst
                                                                                                ))
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            _ { Err(g3_unsupported()) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g7_sort_by_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "sort_by") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "sort_by" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_sort_by_core($recv, $lam, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "sort_by" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_sort_by_core($recv, $lam, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_sort_by_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "sort_by") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "sort_by" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) {
                                match g7_list_kind_from_value($recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($elem) {
                                        match g7_sort_by_key_kind($elem, $lam, $env) {
                                            Ok($kk) { Ok($elem) }
                                            Err($m) { Err($m) }
                                        }
                                    }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "sort_by" {
                        match $args {
                            ExprCons($lam, ExprNil) {
                                match g7_list_kind_from_value($recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($elem) {
                                        match g7_sort_by_key_kind($elem, $lam, $env) {
                                            Ok($kk) { Ok($elem) }
                                            Err($m) { Err($m) }
                                        }
                                    }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Lower `drop(@xs, $n)` / `@xs.drop($n)` (§15) to an OWNED `guji_slice_t` holding the
# elements AFTER the first `$n` (mirrors native `listDrop`). The count is clamped to
# [0, len] exactly like `take`, the result length is `len - count`, and slot `i` copies
# source slot `count + i`. Str element slots are retained (the fresh prefix owns its own
# refs); the owned source slice is released after the copy. The receiver is lowered
# through the same `g7_lower_list_value` owned-list path `take` uses.
sub g7_drop_core($recv: Expr, $count: Expr, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_c_type($elem) {
        Err($m) { Err($m) }
        Ok($ctype) {
            match g7_list_arr_kind($elem) {
                Err($m) { Err($m) }
                Ok($ak) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($src) {
                            match g3_int_rvalue_state($count, $src.state, $env) {
                                Err($m) { Err($m) }
                                Ok($cv) {
                                    $ct = "gi" ~ c_int($cv.state.ntmp)
                                    $dst = g4_value_tmp(CgList($elem), $cv.state.ntmp + 1)
                                    $idx = "gi" ~ c_int($cv.state.ntmp + 2)
                                    $rl = "gi" ~ c_int($cv.state.ntmp + 3)
                                    $retain = g7_row_retain_slot($elem, $ctype, $dst, $idx)
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $cv.state.interns,
                                            decls: $cv.state.decls ~
                                                "\tint64_t " ~ $ct ~ " = 0;\n" ~
                                                "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                                "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                "\tint64_t " ~ $rl ~ " = 0;\n",
                                            body: $cv.state.body ~
                                                "\t" ~ $ct ~ " = " ~ $cv.c ~ ";\n" ~
                                                "\tif (" ~ $ct ~ " < 0) \{ " ~ $ct ~ " = 0; }\n" ~
                                                "\tif (" ~ $ct ~ " > " ~ $src.c ~ ".len) \{ " ~ $ct ~ " = " ~ $src.c ~ ".len; }\n" ~
                                                "\t" ~ $rl ~ " = " ~ $src.c ~ ".len - " ~ $ct ~ ";\n" ~
                                                "\t" ~ $dst ~ ".len = " ~ $rl ~ ";\n" ~
                                                "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $rl ~ ");\n" ~
                                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $rl ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                "\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $ct ~ " + " ~ $idx ~ "];\n" ~
                                                $retain ~
                                                "\t}\n" ~
                                                g7_slice_release($src.c),
                                            nstr: $cv.state.nstr,
                                            ntmp: $cv.state.ntmp + 4
                                        ),
                                        c: $dst
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_drop_value($callee: Expr, $args: ExprList, $elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "drop") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "drop" {
                        match $args {
                            ExprCons($recv, ExprCons($count, ExprNil)) { g7_drop_core($recv, $count, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "drop" {
                        match $args {
                            ExprCons($count, ExprNil) { g7_drop_core($recv, $count, $elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_drop_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "drop") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "drop" {
                        match $args {
                            ExprCons($recv, ExprCons($count, ExprNil)) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "drop" {
                        match $args {
                            ExprCons($count, ExprNil) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_lambda_binder_name($params: ParamList): Result[Str, Str] {
    match $params {
        ParamCons($head, ParamNil) { Ok($head.name) }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_lambda_body_expr($body: StmtList): Result[Expr, Str] {
    match $body {
        StmtCons($head, StmtNil) {
            match $head {
                SExpr($e) { Ok($e) }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Callback collection rows are shallow by-value views into the owned source
# slice. Lists use the ordinary guji_slice_t form (listlen 0), while maps use a
# guji_map_t and therefore need the negative struct-form sentinel. Without the
# sentinel, g7_map_var_* invents undeclared `<binder>_keys`/`_vals`/`_len`
# locals when a callback body reads the borrowed map row.
sub g7_callback_binder_listlen($kind: CgKind): Int {
    match $kind {
        CgMap($val) { 0 - 1 }
        _ { 0 }
    }
}

sub g7_lambda_env($params: ParamList, $src_elem: CgKind, $binder_c: Str, $env: CgEnv): Result[CgEnv, Str] {
    match g7_lambda_binder_name($params) {
        Err($m) { Err($m) }
        Ok($name) {
            Ok(CgEnvCons(CgVar(name: $name, cname: $binder_c, kind: $src_elem, mutable: false, borrowed: true, listlen: g7_callback_binder_listlen($src_elem)), $env))
        }
    }
}

# §15 higher-order list `.reduce`: fold an owned source list with a two-parameter
# inline lambda `(accumulator, element)`. The accumulator kind is the value
# context (`$want`) and may differ from the element kind. Scalar accumulators are
# assigned directly; a Str accumulator owns its current value, so each iteration
# computes the next owned Str, releases the previous accumulator, then transfers
# ownership into the accumulator slot. The source slice is released after the
# loop, after any retained/constructed accumulator value has been installed.
sub g7_reduce_lambda_env($params: ParamList, $acc_kind: CgKind, $acc_c: Str, $elem_kind: CgKind, $elem_c: Str, $env: CgEnv): Result[CgEnv, Str] {
    match $params {
        ParamCons($acc, ParamCons($elem, ParamNil)) {
            Ok(CgEnvCons(
                CgVar(name: $elem.name, cname: $elem_c, kind: $elem_kind, mutable: false, borrowed: true, listlen: g7_callback_binder_listlen($elem_kind)),
                CgEnvCons(CgVar(name: $acc.name, cname: $acc_c, kind: $acc_kind, mutable: false, borrowed: true, listlen: g7_callback_binder_listlen($acc_kind)), $env)
            ))
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_reduce_assign($kind: CgKind, $acc: Str, $rv: Str, $collection: Int): Str {
    if $collection == 1 {
        "\t\tguji_release((const void*)" ~ $acc ~ ".data);\n" ~
        "\t\t" ~ $acc ~ " = " ~ $rv ~ ";\n" ~
        "\t\t" ~ $rv ~ ".data = NULL;\n" ~
        "\t\t" ~ $rv ~ ".len = 0;\n"
    } else if $collection == 2 {
        "\t\tguji_release((const void*)" ~ $acc ~ ".keys);\n" ~
        "\t\tguji_release(" ~ $acc ~ ".vals);\n" ~
        "\t\t" ~ $acc ~ " = " ~ $rv ~ ";\n" ~
        "\t\t" ~ $rv ~ ".keys = NULL;\n" ~
        "\t\t" ~ $rv ~ ".vals = NULL;\n" ~
        "\t\t" ~ $rv ~ ".len = 0;\n"
    } else {
        match $kind {
            CgStr { "\t\tguji_release(" ~ $acc ~ ");\n\t\t" ~ $acc ~ " = " ~ $rv ~ ";\n" }
            _ { "\t\t" ~ $acc ~ " = " ~ $rv ~ ";\n" }
        }
    }
}

sub g7_reduce_seed_move_null($seed: Str, $collection: Int): Str {
    if $collection == 1 {
        "\t" ~ $seed ~ ".data = NULL;\n\t" ~ $seed ~ ".len = 0;\n"
    } else if $collection == 2 {
        "\t" ~ $seed ~ ".keys = NULL;\n\t" ~ $seed ~ ".vals = NULL;\n\t" ~ $seed ~ ".len = 0;\n"
    } else {
        ""
    }
}

sub g7_reduce_core($want: CgKind, $recv: Expr, $seed: Expr, $lam: Expr, $collection: Int, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($elem) {
            match g7_list_c_type($elem) {
                Err($m) { Err($m) }
                Ok($ctype) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($src) {
                            match g4_lower_value($want, $seed, $src.state, $env) {
                                Err($m) { Err($m) }
                                Ok($sv) {
                                    match $lam {
                                        ELambda($params, $ret, $body, $topic) {
                                            match g7_lambda_body_expr($body) {
                                                Err($m) { Err($m) }
                                                Ok($expr) {
                                                    $acc = g4_value_tmp($want, $sv.state.ntmp)
                                                    $idx = "gi" ~ c_int($sv.state.ntmp + 1)
                                                    $binder = g4_value_tmp($elem, $sv.state.ntmp + 2)
                                                    match g7_reduce_lambda_env($params, $want, $acc, $elem, $binder, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($lenv) {
                                                            $loop_start = CgState(
                                                                interns: $sv.state.interns,
                                                                decls: $sv.state.decls ~
                                                                    g4_value_decl($want, $acc) ~
                                                                    "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                                    g4_value_decl($elem, $binder),
                                                                body: "",
                                                                nstr: $sv.state.nstr,
                                                                ntmp: $sv.state.ntmp + 3
                                                            )
                                                            match g4_lower_value($want, $expr, $loop_start, $lenv) {
                                                                Err($m) { Err($m) }
                                                                Ok($rv) {
                                                                    Ok(CgValueOut(
                                                                        state: CgState(
                                                                            interns: $rv.state.interns,
                                                                            decls: $rv.state.decls,
                                                                            body: $sv.state.body ~
                                                                                "\t" ~ $acc ~ " = " ~ $sv.c ~ ";\n" ~
                                                                                g7_reduce_seed_move_null($sv.c, $collection) ~
                                                                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                                "\t\t" ~ $binder ~ " = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                                                $rv.state.body ~
                                                                                g7_reduce_assign($want, $acc, $rv.c, $collection) ~
                                                                                "\t}\n" ~
                                                                                g7_slice_release($src.c),
                                                                            nstr: $rv.state.nstr,
                                                                            ntmp: $rv.state.ntmp
                                                                        ),
                                                                        c: $acc
                                                                    ))
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_reduce_value($want: CgKind, $callee: Expr, $args: ExprList, $collection: Int, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "reduce") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "reduce" {
                        match $args {
                            ExprCons($recv, ExprCons($seed, ExprCons($lam, ExprNil))) { g7_reduce_core($want, $recv, $seed, $lam, $collection, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "reduce" {
                        match $args {
                            ExprCons($seed, ExprCons($lam, ExprNil)) { g7_reduce_core($want, $recv, $seed, $lam, $collection, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Recover reduce's accumulator shape from its seed expression. Collection-valued
# reduce results have no declared user-sub signature to consult, so unannotated
# List/Map bindings and display positions must infer their nested kind from the
# seed, exactly as the checker/native codegen do. A user `sub reduce` shadows this
# prelude path and continues through ordinary call inference.
sub g7_reduce_seed_expr($callee: Expr, $args: ExprList, $env: CgEnv): Result[Expr, Str] {
    match cg_env_lookup_sub($env, "reduce") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "reduce" {
                        match $args {
                            ExprCons($recv, ExprCons($seed, ExprCons($lam, ExprNil))) { Ok($seed) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "reduce" {
                        match $args {
                            ExprCons($seed, ExprCons($lam, ExprNil)) { Ok($seed) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_reduce_list_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g7_reduce_seed_expr($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($seed) { g7_list_kind_from_value($seed, $env) }
    }
}

sub g7_reduce_map_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g7_reduce_seed_expr($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($seed) { g7_map_val_kind_from_value($seed, $env) }
    }
}

# §15.1 list `sum(@xs)` / `@xs.sum()` — the numeric total of a List[Int] (result
# Int) or List[Float] (result Float). Mirrors native's numeric aggregate lowering
# (`codegen.go` "sum"): an accumulator seeded to zero folded over the elements —
# `guji_add` for Int (so an overflowing total panics exactly as `+` would) and plain
# `+` for Float. The receiver is materialized to an OWNED `guji_slice_t` via
# g7_lower_list_value (a deep copy for a bound var, so the post-loop release is not a
# double-free) and released after the loop — the same ownership shape as `.reduce`.
# `$want` (CgInt/CgFloat) is the value-context result kind; the element kind must
# equal it (a List[Float] summed in Int context — impossible after typecheck —
# declines to the fallback).
sub g7_sum_core($want: CgKind, $recv: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($elem) {
            if cgkind_eq($elem, $want) {
                match g7_list_c_type($elem) {
                    Err($m) { Err($m) }
                    Ok($ctype) {
                        match g7_lower_list_value($elem, $recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($src) {
                                $acc = g4_value_tmp($want, $src.state.ntmp)
                                $idx = "gi" ~ c_int($src.state.ntmp + 1)
                                $seed = match $want { CgFloat { "0.0" } _ { "0" } }
                                $step = match $want {
                                    CgInt { "\t\t" ~ $acc ~ " = guji_add(" ~ $acc ~ ", ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "]);\n" }
                                    _ { "\t\t" ~ $acc ~ " = " ~ $acc ~ " + ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" }
                                }
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $src.state.interns,
                                        decls: $src.state.decls ~
                                            g4_value_decl($want, $acc) ~
                                            "\tint64_t " ~ $idx ~ " = 0;\n",
                                        body: $src.state.body ~
                                            "\t" ~ $acc ~ " = " ~ $seed ~ ";\n" ~
                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                            $step ~
                                            "\t}\n" ~
                                            g7_slice_release($src.c),
                                        nstr: $src.state.nstr,
                                        ntmp: $src.state.ntmp + 2
                                    ),
                                    c: $acc
                                ))
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# Dispatch `sum(@xs)` (function form) and `@xs.sum()` (method form) as a numeric
# fold. A user `sub sum` shadows and disables the prelude lowering.
sub g7_sum_call($want: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "sum") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "sum" {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_sum_core($want, $recv, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "sum" {
                        match $args {
                            ExprNil { g7_sum_core($want, $recv, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15.1 list `min(@xs)` / `@xs.min()` and `max(@xs)` / `@xs.max()` — numeric
# extrema for List[Int] and List[Float]. Mirrors native's lowering: materialize an
# owned list, panic on empty, seed the result from element zero, then scan from
# element one with a strict comparison (ties keep the first element).
sub g7_minmax_core($want: CgKind, $name: Str, $recv: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($elem) {
            if cgkind_eq($elem, $want) {
                match g7_list_c_type($elem) {
                    Err($m) { Err($m) }
                    Ok($ctype) {
                        match g7_lower_list_value($elem, $recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($src) {
                                $acc = g4_value_tmp($want, $src.state.ntmp)
                                $idx = "gi" ~ c_int($src.state.ntmp + 1)
                                $op = if $name == "max" { ">" } else { "<" }
                                $cand = "((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "]"
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $src.state.interns,
                                        decls: $src.state.decls ~
                                            g4_value_decl($want, $acc) ~
                                            "\tint64_t " ~ $idx ~ " = 0;\n",
                                        body: $src.state.body ~
                                            "\tif (" ~ $src.c ~ ".len == 0) \{ guji_panic(\"" ~ $name ~ " of an empty list\"); }\n" ~
                                            "\t" ~ $acc ~ " = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[0];\n" ~
                                            "\tfor (" ~ $idx ~ " = 1; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                            "\t\tif (" ~ $cand ~ " " ~ $op ~ " " ~ $acc ~ ") \{\n" ~
                                            "\t\t\t" ~ $acc ~ " = " ~ $cand ~ ";\n" ~
                                            "\t\t}\n" ~
                                            "\t}\n" ~
                                            g7_slice_release($src.c),
                                        nstr: $src.state.nstr,
                                        ntmp: $src.state.ntmp + 2
                                    ),
                                    c: $acc
                                ))
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g7_minmax_dispatch($want: CgKind, $name: Str, $recv: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, $name) {
        Some($sig) { Err(g3_unsupported()) }
        None { g7_minmax_core($want, $name, $recv, $state, $env) }
    }
}

# Dispatch both data-first and method spellings for numeric min/max. The caller
# passes the scalar value context (`CgInt` or `CgFloat`), so non-numeric and
# mismatched element kinds decline to the generic call path.
sub g7_minmax_call($want: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $callee {
        EName($fn) {
            if $fn == "min" || $fn == "max" {
                match $args {
                    ExprCons($recv, ExprNil) { g7_minmax_dispatch($want, $fn, $recv, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "min" || $method == "max" {
                match $args {
                    ExprNil { g7_minmax_dispatch($want, $method, $recv, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15 higher-order list `.each`: run a one-parameter inline lambda for its side
# effects over every element, yielding Unit. Unlike `.reduce`/`.map`/`.filter` this
# produces NO value — it lives in statement position (`g5_unit_call_code`) — so it
# returns the extended `CgState` directly. The source list is materialized to an
# owned `guji_slice_t`; each iteration binds the current element to the lambda
# parameter as a BORROW into that owned array (scalar: a plain copy; Str: a borrowed
# `const char*` — the lambda body's own `g3_str_lower` retains any use, balanced),
# lowers the lambda body via the ordinary Unit-statement machinery, then the source
# slice is released after the loop. Only single-parameter lambdas over scalar/Str
# element lists; user `sub each` shadowing bypasses this (handled by the dispatcher).
sub g7_each_core($recv: Expr, $lam: Expr, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($elem) {
            match g7_list_c_type($elem) {
                Err($m) { Err($m) }
                Ok($ctype) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($src) {
                            match $lam {
                                ELambda($params, $ret, $body, $topic) {
                                    $idx = "gi" ~ c_int($src.state.ntmp)
                                    $binder = g4_value_tmp($elem, $src.state.ntmp + 1)
                                    match g7_lambda_env($params, $elem, $binder, $env) {
                                        Err($m) { Err($m) }
                                        Ok($lenv) {
                                            $loop_start = CgState(
                                                interns: $src.state.interns,
                                                decls: $src.state.decls ~
                                                    "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                    g4_value_decl($elem, $binder),
                                                body: "",
                                                nstr: $src.state.nstr,
                                                ntmp: $src.state.ntmp + 2
                                            )
                                            match g5_lower_unit_stmts($body, $loop_start, $lenv) {
                                                Err($m) { Err($m) }
                                                Ok($bo) {
                                                    Ok(CgState(
                                                        interns: $bo.state.interns,
                                                        decls: $bo.state.decls,
                                                        body: $src.state.body ~
                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                            "\t\t" ~ $binder ~ " = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                            $bo.state.body ~
                                                            "\t}\n" ~
                                                            g7_slice_release($src.c),
                                                        nstr: $bo.state.nstr,
                                                        ntmp: $bo.state.ntmp
                                                    ))
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Dispatch `each(@xs, lam)` (data-first) and `@xs.each(lam)` (method-style) to the
# §15 each lowering. A user `sub each` shadows the prelude and disables the path.
sub g7_each_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match cg_env_lookup_sub($env, "each") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "each" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_each_core($recv, $lam, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "each" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_each_core($recv, $lam, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_map_result_kind_probe($src_elem: CgKind, $lam: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $lam {
        ELambda($params, $ret, $body, $topic) {
            match g7_lambda_body_expr($body) {
                Err($m) { Err($m) }
                Ok($expr) {
                    match g7_lambda_env($params, $src_elem, "gmap_probe", $env) {
                        Err($m) { Err($m) }
                        Ok($lenv) {
                            match g7_scalar_elem_kind($expr, $lenv) {
                                Ok($sk) { Ok($sk) }
                                Err($ms) {
                                    # A nested-list-producing body (`{ [$n, $n * 10] }`)
                                    # makes each map OUTPUT element a List. The body's
                                    # value kind is CgList(<the produced list's element
                                    # kind>), so reuse the same nested-literal element
                                    # inference `g7_list_kind_from_value` uses for
                                    # `[[..], ..]` and wrap it in one more CgList. A
                                    # Map-producing body is the exact sibling: infer its
                                    # value kind and wrap it in CgMap so List.map can
                                    # allocate an ARR_MAP result.
                                    match g7_list_kind_from_value($expr, $lenv) {
                                        Ok($ek) { Ok(CgList($ek)) }
                                        Err($ml) {
                                            match g7_map_val_kind_from_value($expr, $lenv) {
                                                Ok($vk) { Ok(CgMap($vk)) }
                                                Err($mm) { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_map_result_kind($recv: Expr, $lam: Expr, $env: CgEnv): Result[CgKind, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($src_elem) { g7_map_result_kind_probe($src_elem, $lam, $env) }
    }
}

sub g7_map_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "map") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "map" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_map_result_kind($recv, $lam, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "map" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_map_result_kind($recv, $lam, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# When a `.map` produces a collection row, each lambda body yields a freshly-owned
# `guji_slice_t` / `guji_map_t` temp that is MOVED into the destination
# ARR_SLICE/ARR_MAP slot. Null the source temp after the move so the destination's
# recursive array drop is its sole owner. This mirrors the row-move nulling in the
# nested List/Map literal lowerers. Scalar/Str output carries no inner ownership.
sub g7_map_move_null($out_elem: CgKind, $tmp: Str): Str {
    match $out_elem {
        CgList($inner) { "\t\t" ~ $tmp ~ ".data = NULL; " ~ $tmp ~ ".len = 0;\n" }
        CgMap($val) { "\t\t" ~ $tmp ~ ".keys = NULL; " ~ $tmp ~ ".vals = NULL; " ~ $tmp ~ ".len = 0;\n" }
        _ { "" }
    }
}

sub g7_map_core($recv: Expr, $lam: Expr, $out_elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($src_elem) {
            match g7_list_c_type($src_elem) {
                Err($m) { Err($m) }
                Ok($src_ctype) {
                    match g7_list_c_type($out_elem) {
                        Err($m) { Err($m) }
                        Ok($out_ctype) {
                            match g7_list_arr_kind($out_elem) {
                                Err($m) { Err($m) }
                                Ok($out_ak) {
                                    match g7_lower_list_value($src_elem, $recv, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($src) {
                                            match $lam {
                                                ELambda($params, $ret, $body, $topic) {
                                                    match g7_lambda_body_expr($body) {
                                                        Err($m) { Err($m) }
                                                        Ok($expr) {
                                                            $idx = "gi" ~ c_int($src.state.ntmp)
                                                            $dst = g4_value_tmp(CgList($out_elem), $src.state.ntmp + 1)
                                                            $binder = g4_value_tmp($src_elem, $src.state.ntmp + 2)
                                                            match g7_lambda_env($params, $src_elem, $binder, $env) {
                                                                Err($m) { Err($m) }
                                                                Ok($lenv) {
                                                                    $loop_start = CgState(
                                                                        interns: $src.state.interns,
                                                                        decls: $src.state.decls ~
                                                                            "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                                            "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                                                            g4_value_decl($src_elem, $binder),
                                                                        body: "",
                                                                        nstr: $src.state.nstr,
                                                                        ntmp: $src.state.ntmp + 3
                                                                    )
                                                                    match g4_lower_value($out_elem, $expr, $loop_start, $lenv) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($rv) {
                                                                            Ok(CgValueOut(
                                                                                state: CgState(
                                                                                    interns: $rv.state.interns,
                                                                                    decls: $rv.state.decls,
                                                                                    body: $src.state.body ~
                                                                                        "\t" ~ $dst ~ ".len = " ~ $src.c ~ ".len;\n" ~
                                                                                        "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $out_ak ~ ", sizeof(" ~ $out_ctype ~ "), " ~ $src.c ~ ".len);\n" ~
                                                                                        "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                                        "\t\t" ~ $binder ~ " = ((" ~ $src_ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                                                        $rv.state.body ~
                                                                                        "\t\t((" ~ $out_ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = " ~ $rv.c ~ ";\n" ~
                                                                                        g7_map_move_null($out_elem, $rv.c) ~
                                                                                        "\t}\n" ~
                                                                                        g7_slice_release($src.c),
                                                                                    nstr: $rv.state.nstr,
                                                                                    ntmp: $rv.state.ntmp
                                                                                ),
                                                                                c: $dst
                                                                            ))
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                _ { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_map_value($callee: Expr, $args: ExprList, $out_elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "map") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "map" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_map_core($recv, $lam, $out_elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "map" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_map_core($recv, $lam, $out_elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15 higher-order list `.filter`: keep the source elements for which the inline
# Bool predicate lambda holds. The result list has the SAME element kind as the
# source (filter never changes the type), so — unlike `.map` — no result-kind
# inference is needed. Mirrors native's inline predicate loop against the
# selfhost owned-slice representation used by `.map`: materialise an owned source
# slice, allocate a destination slice sized to the source length (an upper
# bound), then walk the source, run the predicate body under a borrowed
# element binder, and conditionally append the kept element. For a Str element
# list the kept pointer is a borrow into the source array, so it is RETAINED
# before storage (the destination owns +1); the trailing unfilled slots stay
# zero-filled NULL, which `guji_drop_arr_str` releases as a no-op. Scalar
# (Int/Float/Bool) element arrays carry no per-element ownership, so the copy is
# a plain assignment. The source slice is released after the loop.
sub g7_filter_keep_retain($kind: CgKind, $binder: Str): Str {
    match $kind {
        CgStr { "\t\t\tguji_retain((const void*)" ~ $binder ~ ");\n" }
        _ { "" }
    }
}

# Emit the kept-element store for one predicate-true iteration. A scalar/Str
# element is a plain by-value copy into the next destination slot (Str is
# retained first — the destination owns +1). A NESTED (`CgList`) element is a
# borrow into the OWNED source slice, which is deep-dropped when the source is
# released after the loop; a shallow struct copy would leave the kept row's
# `.data` dangling, so it must be DEEP-COPIED. `guji_copy_arr` clones the row's
# backing storage recursively (per its ARR_* kind tag) into a slot the
# destination array owns outright, exactly like the nested branch of
# `g7_copy_list_loop`. `dst.len` is only bumped after the writes, so every
# `[dst.len]` in a single keep block addresses the same slot.
sub g7_filter_keep_store($elem: CgKind, $ctype: Str, $dst: Str, $binder: Str): Str {
    match $elem {
        CgList($inner) {
            "\t\t\t((guji_slice_t*)" ~ $dst ~ ".data)[" ~ $dst ~ ".len].len = " ~ $binder ~ ".len;\n" ~
            "\t\t\t((guji_slice_t*)" ~ $dst ~ ".data)[" ~ $dst ~ ".len].data = guji_copy_arr((const void*)" ~ $binder ~ ".data);\n" ~
            "\t\t\t" ~ $dst ~ ".len = guji_add(" ~ $dst ~ ".len, 1);\n"
        }
        CgMap($vk) {
            # A kept map row deep-copies BOTH arrays (the binder is a borrowed
            # view of the source row, which the loop's source release will drop).
            "\t\t\t((guji_map_t*)" ~ $dst ~ ".data)[" ~ $dst ~ ".len].len = " ~ $binder ~ ".len;\n" ~
            "\t\t\t((guji_map_t*)" ~ $dst ~ ".data)[" ~ $dst ~ ".len].keys = (const char**)guji_copy_arr((const void*)" ~ $binder ~ ".keys);\n" ~
            "\t\t\t((guji_map_t*)" ~ $dst ~ ".data)[" ~ $dst ~ ".len].vals = guji_copy_arr((const void*)" ~ $binder ~ ".vals);\n" ~
            "\t\t\t" ~ $dst ~ ".len = guji_add(" ~ $dst ~ ".len, 1);\n"
        }
        _ {
            g7_filter_keep_retain($elem, $binder) ~
            "\t\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $dst ~ ".len] = " ~ $binder ~ ";\n" ~
            "\t\t\t" ~ $dst ~ ".len = guji_add(" ~ $dst ~ ".len, 1);\n"
        }
    }
}

sub g7_filter_core($recv: Expr, $lam: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Err($m) { Err($m) }
        Ok($elem) {
            match g7_list_c_type($elem) {
                Err($m) { Err($m) }
                Ok($ctype) {
                    match g7_list_arr_kind($elem) {
                        Err($m) { Err($m) }
                        Ok($ak) {
                            match g7_lower_list_value($elem, $recv, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($src) {
                                    match $lam {
                                        ELambda($params, $ret, $body, $topic) {
                                            match g7_lambda_body_expr($body) {
                                                Err($m) { Err($m) }
                                                Ok($expr) {
                                                    $idx = "gi" ~ c_int($src.state.ntmp)
                                                    $dst = g4_value_tmp(CgList($elem), $src.state.ntmp + 1)
                                                    $binder = g4_value_tmp($elem, $src.state.ntmp + 2)
                                                    match g7_lambda_env($params, $elem, $binder, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($lenv) {
                                                            $loop_start = CgState(
                                                                interns: $src.state.interns,
                                                                decls: $src.state.decls ~
                                                                    "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                                    "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                                                    g4_value_decl($elem, $binder),
                                                                body: "",
                                                                nstr: $src.state.nstr,
                                                                ntmp: $src.state.ntmp + 3
                                                            )
                                                            match g4_lower_value(CgBool, $expr, $loop_start, $lenv) {
                                                                Err($m) { Err($m) }
                                                                Ok($pv) {
                                                                    Ok(CgValueOut(
                                                                        state: CgState(
                                                                            interns: $pv.state.interns,
                                                                            decls: $pv.state.decls,
                                                                            body: $src.state.body ~
                                                                                "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ $src.c ~ ".len);\n" ~
                                                                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                                "\t\t" ~ $binder ~ " = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                                                $pv.state.body ~
                                                                                "\t\tif (" ~ $pv.c ~ ") \{\n" ~
                                                                                g7_filter_keep_store($elem, $ctype, $dst, $binder) ~
                                                                                "\t\t}\n" ~
                                                                                "\t}\n" ~
                                                                                g7_slice_release($src.c),
                                                                            nstr: $pv.state.nstr,
                                                                            ntmp: $pv.state.ntmp
                                                                        ),
                                                                        c: $dst
                                                                    ))
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_filter_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "filter") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "filter" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_filter_core($recv, $lam, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "filter" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_filter_core($recv, $lam, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Result-kind inference for `.filter`: the element kind is unchanged, so probe
# the receiver's element kind (mirrors `g7_map_kind` but with no lambda probe).
sub g7_filter_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "filter") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "filter" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "filter" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_list_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15 higher-order list `.find`: return the first source element whose inline
# Bool predicate holds, as Option[T]. This mirrors native's scalar/Str path:
# initialise a None carrier, loop the owned source slice, fill Some(element) on
# the first hit, retain a Str hit so the carrier owns it independently of the
# source array, then break and release the source slice.
sub g7_find_keep_retain($elem: CgKind, $opt: Str): Str {
    match $elem {
        CgStr { "\t\t\tguji_retain(" ~ $opt ~ ".val);\n" }
        _ { "" }
    }
}

sub g7_find_keep_store($elem: CgKind, $opt: Str, $binder: Str): Str {
    match $elem {
        CgList($inner) {
            "\t\t\t" ~ $opt ~ ".tag = 1LL;\n" ~
            "\t\t\t" ~ $opt ~ ".val.len = " ~ $binder ~ ".len;\n" ~
            "\t\t\t" ~ $opt ~ ".val.data = guji_copy_arr((const void*)" ~ $binder ~ ".data);\n"
        }
        CgMap($val) {
            # The loop binder is a borrowed guji_map_t row in the owned source
            # slice. The Option takes an independent +1 on both backing arrays
            # before the source is released, matching native listFind.
            "\t\t\t" ~ $opt ~ ".tag = 1LL; " ~ $opt ~ ".val = " ~ $binder ~ ";\n" ~
            "\t\t\tguji_retain((const void*)" ~ $opt ~ ".val.keys);\n" ~
            "\t\t\tguji_retain((const void*)" ~ $opt ~ ".val.vals);\n"
        }
        _ {
            "\t\t\t" ~ $opt ~ ".tag = 1LL; " ~ $opt ~ ".val = " ~ $binder ~ ";\n" ~
            g7_find_keep_retain($elem, $opt)
        }
    }
}

sub g7_find_core($okind: CgKind, $recv: Expr, $lam: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_payload_kind($okind) {
        Err($m) { Err($m) }
        Ok($elem) {
            match g7_list_c_type($elem) {
                Err($m) { Err($m) }
                Ok($ctype) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($src) {
                            match $lam {
                                ELambda($params, $ret, $body, $topic) {
                                    match g7_lambda_body_expr($body) {
                                        Err($m) { Err($m) }
                                        Ok($expr) {
                                            $idx = "gi" ~ c_int($src.state.ntmp)
                                            $opt = g4_value_tmp($okind, $src.state.ntmp + 1)
                                            $binder = g4_value_tmp($elem, $src.state.ntmp + 2)
                                            match g7_lambda_env($params, $elem, $binder, $env) {
                                                Err($m) { Err($m) }
                                                Ok($lenv) {
                                                    $loop_start = CgState(
                                                        interns: $src.state.interns,
                                                        decls: $src.state.decls ~
                                                            "\tint64_t " ~ $idx ~ " = 0;\n" ~
                                                            g4_value_decl($okind, $opt) ~
                                                            g4_value_decl($elem, $binder),
                                                        body: "",
                                                        nstr: $src.state.nstr,
                                                        ntmp: $src.state.ntmp + 3
                                                    )
                                                    match g4_lower_value(CgBool, $expr, $loop_start, $lenv) {
                                                        Err($m) { Err($m) }
                                                        Ok($pv) {
                                                            Ok(CgValueOut(
                                                                state: CgState(
                                                                    interns: $pv.state.interns,
                                                                    decls: $pv.state.decls,
                                                                    body: $src.state.body ~
                                                                        "\t" ~ $opt ~ ".tag = 0LL; " ~ $opt ~ ".val = " ~ g6_option_zero($okind) ~ ";\n" ~
                                                                        "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                                        "\t\t" ~ $binder ~ " = ((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "];\n" ~
                                                                        $pv.state.body ~
                                                                        "\t\tif (" ~ $pv.c ~ ") \{\n" ~
                                                                        g7_find_keep_store($elem, $opt, $binder) ~
                                                                        "\t\t\tbreak;\n" ~
                                                                        "\t\t}\n" ~
                                                                        "\t}\n" ~
                                                                        g7_slice_release($src.c),
                                                                    nstr: $pv.state.nstr,
                                                                    ntmp: $pv.state.ntmp
                                                                ),
                                                                c: $opt
                                                            ))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g7_find_value($okind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "find") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "find" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { g7_find_core($okind, $recv, $lam, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "find" {
                        match $args {
                            ExprCons($lam, ExprNil) { g7_find_core($okind, $recv, $lam, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_option_kind_for_list_elem($elem: CgKind): Result[CgKind, Str] {
    match $elem {
        CgInt { Ok(CgOptInt) }
        CgFloat { Ok(CgOptFloat) }
        CgBool { Ok(CgOptBool) }
        CgStr { Ok(CgOptStr) }
        CgList($inner) { Ok(CgOptList($inner)) }
        CgMap($val) { Ok(CgOptMap($val)) }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_find_option_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match cg_env_lookup_sub($env, "find") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "find" {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) {
                                match g7_list_kind_from_value($recv, $env) {
                                    Ok($elem) { g7_option_kind_for_list_elem($elem) }
                                    Err($m) { Err($m) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "find" {
                        match $args {
                            ExprCons($lam, ExprNil) {
                                match g7_list_kind_from_value($recv, $env) {
                                    Ok($elem) { g7_option_kind_for_list_elem($elem) }
                                    Err($m) { Err($m) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_find_option_kind_from_value($subject: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $subject {
        ECall($callee, $args) { g7_find_option_kind($callee, $args, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# Infer the Option kind of a list `get` result (`@xs.get($i)` / `get(@xs, $i)`), the
# `find` twin so an UNANNOTATED bind (`$got = @words.get(1)`) resolves its carrier kind
# without an annotation. Mirrors g6_get_option_value's dispatch shape EXACTLY so
# inference accepts precisely what the lowering accepts: the ordinary-call form defers
# to a user `sub get` shadow (native lets it shadow the prelude call), while the method
# form always uses the prelude get. Lists and maps share the same collection-payload
# classifier: a list contributes its element kind; a map contributes its value kind.
# Both map to the Option carrier through g7_option_kind_for_list_elem, which preserves
# nested List/Map payload metadata without per-leaf dispatch.
sub g6_get_receiver_option_kind($recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match g7_list_kind_from_value($recv, $env) {
        Ok($elem) { g7_option_kind_for_list_elem($elem) }
        Err($not_list) {
            match g7_map_val_kind_from_value($recv, $env) {
                Ok($val) { g7_option_kind_for_list_elem($val) }
                Err($not_map) { Err(g3_unsupported()) }
            }
        }
    }
}

sub g6_get_option_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match $callee {
        EName($fn) {
            if $fn == "get" {
                match cg_env_lookup_sub($env, "get") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($index, ExprNil)) { g6_get_receiver_option_kind($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "get" {
                match $args {
                    ExprCons($index, ExprNil) { g6_get_receiver_option_kind($recv, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_get_option_kind_from_value($subject: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $subject {
        ECall($callee, $args) { g6_get_option_kind($callee, $args, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# Lower a list argument by COPY: materialise an owned slice temp (literal alloc,
# list-returning call result, or — for a bound variable — a full element-wise
# clone) and release it after the call. This is the conservative path used for
# every argument shape that is NOT a directly-borrowable bound list variable.
sub g7_lower_one_list_arg_copy($elem: CgKind, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match g7_lower_list_value($elem, $arg, $state, $env) {
        Err($m) { Err($m) }
        Ok($lv) { Ok(CgArgsOut(state: $lv.state, args: $lv.c, releases: g7_slice_release($lv.c))) }
    }
}

# Lower one list argument. A bound list variable stored as a `guji_slice_t`
# (`listlen == 0`: every parameter and every non-literal binding) is passed BY
# BORROW — the variable's own slice handle is forwarded directly with no element
# copy and no post-call release. This is semantics-identical to the old clone:
#   * No callee ever frees a list parameter (the borrowed by-value ABI — verified:
#     0 `guji_release` on any `gpN.data` across the whole self-compiled compiler),
#     so the caller's binding stays the sole owner and frees it at scope end.
#   * The selfhost subset has NO list mutation (no append/prepend/in-place store;
#     `~` is Str-only), so a borrowing callee cannot observably diverge from a
#     callee handed a private clone.
# The old per-argument clone was O(n) in the list length, which made recursive
# char-list threading (the lexer's `scan_*`/`lex_step` re-passing `@chars` once
# per token) O(n^2) over the source — the EB-5 gen2 self-compile wall. Literals,
# list-returning calls, and fixed-length (`listlen != 0`) bindings keep the copy
# path, which already produces a correctly-owned, released temp.
sub g7_lower_one_list_arg($elem: CgKind, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $arg {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { g7_lower_one_list_arg_copy($elem, $arg, $state, $env) }
                Some($var) {
                    match $var.kind {
                        CgList($actual) {
                            if cgkind_eq($actual, $elem) && $var.listlen == 0 {
                                Ok(CgArgsOut(state: $state, args: $var.cname, releases: ""))
                            } else {
                                g7_lower_one_list_arg_copy($elem, $arg, $state, $env)
                            }
                        }
                        _ { g7_lower_one_list_arg_copy($elem, $arg, $state, $env) }
                    }
                }
            }
        }
        _ { g7_lower_one_list_arg_copy($elem, $arg, $state, $env) }
    }
}

sub g7_lower_list_count_receiver($recv: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgList($el) { Ok(CgValueOut(state: $state, c: g7_list_var_len($var))) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EField($obj, $name) {
            match $obj {
                EName($owner) {
                    match cg_env_lookup($env, $owner) {
                        None { Err(g3_unsupported()) }
                        Some($var) {
                            match $var.kind {
                                CgClass($cn) {
                                    match cg_env_lookup_class($env, $cn) {
                                        None { Err(g3_unsupported()) }
                                        Some($info) {
                                            match g8_class_field_lookup($info.fields, $name) {
                                                None { Err(g3_unsupported()) }
                                                Some($f) {
                                                    match $f.kind {
                                                        CgList($el) { Ok(CgValueOut(state: $state, c: $var.cname ~ ".f" ~ c_int($f.index) ~ ".len")) }
                                                        _ { Err(g3_unsupported()) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                # Non-lvalue class receiver (`@rows[0].tags.count()`): materialize
                # the List field into an owned slice, read `.len`, then release.
                _ {
                    match g7_list_kind_from_value(EField($obj, $name), $env) {
                        Err($m) { Err($m) }
                        Ok($elem) {
                            match g7_lower_list_value($elem, EField($obj, $name), $state, $env) {
                                Err($m) { Err($m) }
                                Ok($lv) {
                                    $st = $lv.state
                                    $ti = c_int($st.ntmp)
                                    $tmp = "gi" ~ $ti
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $st.interns,
                                            decls: $st.decls ~ "\tint64_t " ~ $tmp ~ " = 0;\n",
                                            body: $st.body ~
                                                "\t" ~ $tmp ~ " = " ~ $lv.c ~ ".len;\n" ~
                                                g7_slice_release($lv.c),
                                            nstr: $st.nstr,
                                            ntmp: $st.ntmp + 1
                                        ),
                                        c: $tmp
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
        ECall($callee, $args) {
            match g7_list_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($elem) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($lv) {
                            $st = $lv.state
                            $ti = c_int($st.ntmp)
                            $tmp = "gi" ~ $ti
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $st.interns,
                                    decls: $st.decls ~ "\tint64_t " ~ $tmp ~ " = 0;\n",
                                    body: $st.body ~
                                        "\t" ~ $tmp ~ " = " ~ $lv.c ~ ".len;\n" ~
                                        g7_slice_release($lv.c),
                                    nstr: $st.nstr,
                                    ntmp: $st.ntmp + 1
                                ),
                                c: $tmp
                            ))
                        }
                    }
                }
            }
        }
        EIndex($obj, $idx) {
            match g7_list_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($elem) {
                    match g7_lower_list_value($elem, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($lv) {
                            $st = $lv.state
                            $ti = c_int($st.ntmp)
                            $tmp = "gi" ~ $ti
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $st.interns,
                                    decls: $st.decls ~ "\tint64_t " ~ $tmp ~ " = 0;\n",
                                    body: $st.body ~
                                        "\t" ~ $tmp ~ " = " ~ $lv.c ~ ".len;\n" ~
                                        g7_slice_release($lv.c),
                                    nstr: $st.nstr,
                                    ntmp: $st.ntmp + 1
                                ),
                                c: $tmp
                            ))
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_lower_list_count_call($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_sub($env, "count") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $args {
                ExprNil {
                    match $callee {
                        EField($recv, $method) {
                            if $method == "count" { g7_lower_list_count_receiver($recv, $state, $env) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                ExprCons($arg, ExprNil) {
                    match $callee {
                        EName($name) {
                            if $name == "count" { g7_lower_list_count_receiver($arg, $state, $env) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# A scalar list binding from a non-empty list literal. The binding's C name is
# chosen from the POST-element-lowering temp counter (so element rvalues that
# allocate temps — e.g. a call element — never collide with the array name), then
# the two declarations and the per-element assignments are emitted.
sub g7_lower_list_bind($elem: CgKind, $mutable: Bool, $name: Str, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $value {
        EList($items) {
            match $elem {
                CgList($inner) {
                    match g7_lower_list_value($elem, $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($lv) {
                            Ok(BindOut(state: $lv.state, env: CgEnvCons(CgVar(name: $name, cname: $lv.c, kind: CgList($elem), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                        }
                    }
                }
                # A list whose ELEMENTS are maps materializes to an owned slice temp
                # (ARR_MAP of guji_map_t), registered slice-shaped (listlen 0) so
                # scope-exit cleanup releases it via the slice path — the ARR_MAP
                # drop cascades to each element map. Mirrors the nested-list arm.
                CgMap($v) {
                    match g7_lower_list_value($elem, $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($lv) {
                            Ok(BindOut(state: $lv.state, env: CgEnvCons(CgVar(name: $name, cname: $lv.c, kind: CgList($elem), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                        }
                    }
                }
                # User enum/class rows are by-value structs whose fields may own
                # counted values. Store them in a program-specific counted array;
                # its drop callback releases every row's fields. Using the owned
                # slice path also makes list copies retain each row transitively.
                CgEnum($ename) {
                    match g7_lower_list_value($elem, $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($lv) {
                            Ok(BindOut(state: $lv.state, env: CgEnvCons(CgVar(name: $name, cname: $lv.c, kind: CgList($elem), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                        }
                    }
                }
                CgClass($cname) {
                    match g7_lower_list_value($elem, $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($lv) {
                            Ok(BindOut(state: $lv.state, env: CgEnvCons(CgVar(name: $name, cname: $lv.c, kind: CgList($elem), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                        }
                    }
                }
                _ {
                    match g7_list_c_type($elem) {
                        Err($m) { Err($m) }
                        Ok($ctype) {
                            match g7_lower_scalar_elems($elem, $items, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($lo) {
                                    if $lo.count == 0 {
                                        # An empty list literal (`@e: List[T] = []`). A zero-length C
                                        # array is non-portable, so — exactly like native (cc-wrapper
                                        # captured: `int64_t <cn>_data[1] = {0}; <cn>_len = 0;`) — emit
                                        # a ONE-slot stack backing array with `_len = 0`. No element is
                                        # ever read (count 0; any index bounds-panics; iteration runs 0
                                        # times), so there is no heap alloc and nothing to free: the
                                        # binding is FIXED-array shaped (listlen 1 -> `_data`/`_len`
                                        # accessors, so a pass-as-arg takes the len-0 copy path native
                                        # uses) and marked BORROWED so scope-exit cleanup skips the Str
                                        # `guji_release` that a real owned heap array would need.
                                        $cn = "gv" ~ c_int($lo.state.ntmp)
                                        $decls = "\t" ~ $ctype ~ " " ~ $cn ~ "_data[1] = \{0};\n\tint64_t " ~ $cn ~ "_len = 0;\n"
                                        $st2 = CgState(
                                            interns: $lo.state.interns,
                                            decls: $lo.state.decls ~ $decls,
                                            body: $lo.state.body ~ "\t" ~ $cn ~ "_len = 0;\n",
                                            nstr: $lo.state.nstr,
                                            ntmp: $lo.state.ntmp + 1
                                        )
                                        Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgList($elem), mutable: $mutable, borrowed: true, listlen: 1), $env)))
                                    } else {
                                        $cn = "gv" ~ c_int($lo.state.ntmp)
                                        $decls = match $elem {
                                            CgStr { "\tconst char** " ~ $cn ~ "_data = NULL;\n\tint64_t " ~ $cn ~ "_len = 0;\n" }
                                            _ { "\t" ~ $ctype ~ " " ~ $cn ~ "_data[" ~ c_int($lo.count) ~ "] = \{0};\n\tint64_t " ~ $cn ~ "_len = 0;\n" }
                                        }
                                        $alloc = match $elem {
                                            CgStr { "\t" ~ $cn ~ "_data = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ c_int($lo.count) ~ ");\n" }
                                            _ { "" }
                                        }
                                        $assigns = $alloc ~ g7_elem_assigns($cn, $lo.rvals, 0) ~ "\t" ~ $cn ~ "_len = " ~ c_int($lo.count) ~ ";\n"
                                        $st2 = CgState(
                                            interns: $lo.state.interns,
                                            decls: $lo.state.decls ~ $decls,
                                            body: $lo.state.body ~ $assigns,
                                            nstr: $lo.state.nstr,
                                            ntmp: $lo.state.ntmp + 1
                                        )
                                        Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgList($elem), mutable: $mutable, borrowed: false, listlen: $lo.count), $env)))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        # A non-literal RHS (a call such as `args()`/a user sub returning a list, or
        # another list local) produces an OWNED `guji_slice_t`. Register that temp
        # directly as the binding's C local with the SLICE representation (listlen 0,
        # so g7_list_var_data/len read `.data`/`.len`); function-exit cleanup releases
        # it via the slice path. No copy/move is needed: the value temp IS the local.
        _ {
            match g7_lower_list_value($elem, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($lv) {
                    Ok(BindOut(state: $lv.state, env: CgEnvCons(CgVar(name: $name, cname: $lv.c, kind: CgList($elem), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                }
            }
        }
    }
}

# Lower `%map{$key}` to an owned/materialized value of `$want`. The receiver is
# any map storage view (local two-array form or borrowed `guji_map_t` struct).
sub g7_lower_map_index($want: CgKind, $var: CgVar, $key: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_list_c_type($want) {
        Err($m) { Err($m) }
        Ok($ctype) {
            match g3_str_lower($key, $state, $env) {
                Err($m) { Err($m) }
                Ok($ks) {
                    $valtmp = g4_value_tmp($want, $ks.state.ntmp)
                    $found = "gfnd" ~ c_int($ks.state.ntmp + 1)
                    $loop = "gi" ~ c_int($ks.state.ntmp + 2)
                    $src = g7_map_var_vals_typed($var, $ctype)
                    # A map index is an owned/materialized value. Scalars copy and
                    # Str retains; collection rows retain their counted backing
                    # (same-heap) before an intermediate receiver can be released.
                    # guji_copy_arr cannot recurse through nested GUJI_KIND_<T>_ARR.
                    $assign = match $want {
                        CgStr { "\t\t\t" ~ $valtmp ~ " = guji_retain(" ~ $src ~ "[" ~ $loop ~ "]);\n" }
                        CgList($inner) {
                            g7_slice_retain_copy("\t\t\t", $valtmp, $src ~ "[" ~ $loop ~ "]")
                        }
                        CgMap($inner) {
                            g7_map_retain_copy("\t\t\t", $valtmp, $src ~ "[" ~ $loop ~ "]")
                        }
                        CgEnum($ename) {
                            "\t\t\t" ~ $valtmp ~ " = " ~ $src ~ "[" ~ $loop ~ "];\n" ~ g6e_enum_retain($ename, $valtmp)
                        }
                        CgClass($cname) {
                            "\t\t\t" ~ $valtmp ~ " = " ~ $src ~ "[" ~ $loop ~ "];\n" ~ g8_class_retain($cname, $valtmp)
                        }
                        _ { "\t\t\t" ~ $valtmp ~ " = " ~ $src ~ "[" ~ $loop ~ "];\n" }
                    }
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $ks.state.interns,
                            decls: $ks.state.decls ~ g4_value_decl($want, $valtmp) ~ "\tint64_t " ~ $found ~ " = 0;\n\tint64_t " ~ $loop ~ " = 0;\n",
                            body: $ks.state.body ~
                                "\t" ~ $found ~ " = 0;\n" ~
                                "\tfor (" ~ $loop ~ " = 0; " ~ $loop ~ " < " ~ g7_map_var_len($var) ~ "; " ~ $loop ~ " = guji_add(" ~ $loop ~ ", 1)) \{\n" ~
                                "\t\tif (guji_str_equal(" ~ g7_map_var_keys($var) ~ "[" ~ $loop ~ "], " ~ $ks.tmp ~ ")) \{\n" ~
                                $assign ~
                                "\t\t\t" ~ $found ~ " = 1;\n" ~
                                "\t\t\tbreak;\n" ~
                                "\t\t}\n" ~
                                "\t}\n" ~
                                "\tguji_release(" ~ $ks.tmp ~ ");\n" ~
                                "\tif (!" ~ $found ~ ") \{ guji_panic(\"map key not found\"); }\n",
                            nstr: $ks.state.nstr,
                            ntmp: $ks.state.ntmp + 3
                        ),
                        c: $valtmp
                    ))
                }
            }
        }
    }
}

# Index a map-valued expression rather than a named/field map view. Materialize
# the receiver as an owned guji_map_t, read an owned result through the ordinary
# map-index path, then release the intermediate receiver. This is the recursive
# step for `%m{"a"}{"b"}{"c"}` and for a map row reached through a list hop.
sub g7_lower_map_value_index($want: CgKind, $obj: Expr, $idx: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_map_val_kind_from_value($obj, $env) {
        Err($m) { Err($m) }
        Ok($actual) {
            if cgkind_eq($actual, $want) {
                match g7_lower_map_value($want, $obj, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($mv) {
                        $view = CgVar(name: "", cname: $mv.c, kind: CgMap($want), mutable: false, borrowed: true, listlen: 0 - 1)
                        match g7_lower_map_index($want, $view, $idx, $mv.state, $env) {
                            Err($m) { Err($m) }
                            Ok($out) {
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $out.state.interns,
                                        decls: $out.state.decls,
                                        body: $out.state.body ~ g7_map_value_release($mv.c),
                                        nstr: $out.state.nstr,
                                        ntmp: $out.state.ntmp
                                    ),
                                    c: $out.c
                                ))
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# Lower `$obj[$idx]` / `%map{$key}` to an rvalue of `$want`. List indexes are
# lowered to bounds-checked element reads; map indexes scan keys and panic on a
# miss, matching native's `indexExpr`.
sub g7_lower_index($want: CgKind, $obj: Expr, $idx: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    # Indexing a Never object is itself Never. As with native indexExpr, emit
    # the diverging receiver and return the wanted kind's unreachable sentinel.
    match $obj {
        ECall($c, $args) {
            match g4_panic_value($want, $c, $args, $state, $env) {
                Ok($nv) { Ok($nv) }
                Err($not_never) { g7_lower_index_nonnever($want, $obj, $idx, $state, $env) }
            }
        }
        _ { g7_lower_index_nonnever($want, $obj, $idx, $state, $env) }
    }
}

sub g7_lower_index_nonnever($want: CgKind, $obj: Expr, $idx: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $obj {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgList($elem) {
                            if cgkind_eq($elem, $want) {
                                match g7_list_c_type($want) {
                                    Err($m) { Err($m) }
                                    Ok($ctype) {
                                        match g3_int_rvalue_state($idx, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($iv) {
                                                $tmp = "gi" ~ c_int($iv.state.ntmp)
                                                $data = g7_list_var_data($v, $ctype)
                                                $len = g7_list_var_len($v)
                                                $decl = "\tint64_t " ~ $tmp ~ " = 0;\n"
                                                $check = "\t" ~ $tmp ~ " = " ~ $iv.c ~ ";\n\tif (" ~ $tmp ~ " < 0 || " ~ $tmp ~ " >= " ~ $len ~ ") \{ guji_panic(\"list index out of bounds\"); }\n"
                                                $st2 = CgState(
                                                    interns: $iv.state.interns,
                                                    decls: $iv.state.decls ~ $decl,
                                                    body: $iv.state.body ~ $check,
                                                    nstr: $iv.state.nstr,
                                                    ntmp: $iv.state.ntmp + 1
                                                )
                                                match $want {
                                                    CgStr {
                                                        $stmp = "gt" ~ c_int($st2.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st2.interns,
                                                                decls: $st2.decls ~ "\tconst char* " ~ $stmp ~ " = GUJI_EMPTY_STR;\n",
                                                                body: $st2.body ~ "\t" ~ $stmp ~ " = guji_retain(" ~ $data ~ "[" ~ $tmp ~ "]);\n",
                                                                nstr: $st2.nstr,
                                                                ntmp: $st2.ntmp + 1
                                                            ),
                                                            c: $stmp
                                                        ))
                                                    }
                                                    CgList($inner) {
                                                        $ltmp = g4_value_tmp($want, $st2.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st2.interns,
                                                                decls: $st2.decls ~ g4_value_decl($want, $ltmp),
                                                                body: $st2.body ~
                                                                    g7_slice_retain_copy("\t", $ltmp, $data ~ "[" ~ $tmp ~ "]"),
                                                                nstr: $st2.nstr,
                                                                ntmp: $st2.ntmp + 1
                                                            ),
                                                            c: $ltmp
                                                        ))
                                                    }
                                                    CgMap($vk) {
                                                        # List[Map] index: retain the row's counted keys+vals (same-
                                                        # heap owned temp). guji_copy_arr panics when vals hold
                                                        # List/Map of nominal leaves (GUJI_KIND_<T>_ARR).
                                                        $mtmp = g4_value_tmp($want, $st2.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st2.interns,
                                                                decls: $st2.decls ~ g4_value_decl($want, $mtmp),
                                                                body: $st2.body ~
                                                                    g7_map_retain_copy("\t", $mtmp, $data ~ "[" ~ $tmp ~ "]"),
                                                                nstr: $st2.nstr,
                                                                ntmp: $st2.ntmp + 1
                                                            ),
                                                            c: $mtmp
                                                        ))
                                                    }
                                                    CgEnum($ename) {
                                                        $etmp = g4_value_tmp($want, $st2.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st2.interns,
                                                                decls: $st2.decls ~ g4_value_decl($want, $etmp),
                                                                body: $st2.body ~ "\t" ~ $etmp ~ " = " ~ $data ~ "[" ~ $tmp ~ "];\n" ~ g6e_enum_retain($ename, $etmp),
                                                                nstr: $st2.nstr,
                                                                ntmp: $st2.ntmp + 1
                                                            ),
                                                            c: $etmp
                                                        ))
                                                    }
                                                    CgClass($cname) {
                                                        $ctmp = g4_value_tmp($want, $st2.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st2.interns,
                                                                decls: $st2.decls ~ g4_value_decl($want, $ctmp),
                                                                body: $st2.body ~ "\t" ~ $ctmp ~ " = " ~ $data ~ "[" ~ $tmp ~ "];\n" ~ g8_class_retain($cname, $ctmp),
                                                                nstr: $st2.nstr,
                                                                ntmp: $st2.ntmp + 1
                                                            ),
                                                            c: $ctmp
                                                        ))
                                                    }
                                                    _ {
                                                        # Materialize every scalar read immediately after its bounds
                                                        # check. This both precedes later expression effects and keeps a
                                                        # slice-backed value alive across function-exit cleanup.
                                                        $etmp = g4_value_tmp($want, $st2.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st2.interns,
                                                                decls: $st2.decls ~ g4_value_decl($want, $etmp),
                                                                body: $st2.body ~ "\t" ~ $etmp ~ " = " ~ $data ~ "[" ~ $tmp ~ "];\n",
                                                                nstr: $st2.nstr,
                                                                ntmp: $st2.ntmp + 1
                                                            ),
                                                            c: $etmp
                                                        ))
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        CgMap($val) {
                            if cgkind_eq($val, $want) {
                                g7_lower_map_index($want, $v, $idx, $state, $env)
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ {
            match g7_lower_list_value($want, $obj, $state, $env) {
                Err($m) { g7_lower_map_value_index($want, $obj, $idx, $state, $env) }
                Ok($lv) {
                    match g3_int_rvalue_state($idx, $lv.state, $env) {
                        Err($m) { Err($m) }
                        Ok($iv) {
                            match g7_list_c_type($want) {
                                Err($m) { Err($m) }
                                Ok($ctype) {
                                    $tmp = "gi" ~ c_int($iv.state.ntmp)
                                    $decl = "\tint64_t " ~ $tmp ~ " = 0;\n"
                                    $check = "\t" ~ $tmp ~ " = " ~ $iv.c ~ ";\n\tif (" ~ $tmp ~ " < 0 || " ~ $tmp ~ " >= " ~ $lv.c ~ ".len) \{ guji_panic(\"list index out of bounds\"); }\n"
                                    $st2 = CgState(
                                        interns: $iv.state.interns,
                                        decls: $iv.state.decls ~ $decl,
                                        body: $iv.state.body ~ $check,
                                        nstr: $iv.state.nstr,
                                        ntmp: $iv.state.ntmp + 1
                                    )
                                    match $want {
                                        CgStr {
                                            $stmp = "gt" ~ c_int($st2.ntmp)
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st2.interns,
                                                    decls: $st2.decls ~ "\tconst char* " ~ $stmp ~ " = GUJI_EMPTY_STR;\n",
                                                    body: $st2.body ~ "\t" ~ $stmp ~ " = guji_retain(((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)[" ~ $tmp ~ "]);\n" ~ g7_slice_release($lv.c),
                                                    nstr: $st2.nstr,
                                                    ntmp: $st2.ntmp + 1
                                                ),
                                                c: $stmp
                                            ))
                                        }
                                        CgList($inner) {
                                            $valtmp = g4_value_tmp($want, $st2.ntmp)
                                            $row = "((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)[" ~ $tmp ~ "]"
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st2.interns,
                                                    decls: $st2.decls ~ g4_value_decl($want, $valtmp),
                                                    body: $st2.body ~
                                                        g7_slice_retain_copy("\t", $valtmp, $row) ~
                                                        g7_slice_release($lv.c),
                                                    nstr: $st2.nstr,
                                                    ntmp: $st2.ntmp + 1
                                                ),
                                                c: $valtmp
                                            ))
                                        }
                                        CgMap($vk) {
                                            $valtmp = g4_value_tmp($want, $st2.ntmp)
                                            $row = "((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)[" ~ $tmp ~ "]"
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st2.interns,
                                                    decls: $st2.decls ~ g4_value_decl($want, $valtmp),
                                                    body: $st2.body ~
                                                        g7_map_retain_copy("\t", $valtmp, $row) ~
                                                        g7_slice_release($lv.c),
                                                    nstr: $st2.nstr,
                                                    ntmp: $st2.ntmp + 1
                                                ),
                                                c: $valtmp
                                            ))
                                        }
                                        CgEnum($ename) {
                                            $valtmp = g4_value_tmp($want, $st2.ntmp)
                                            $row = "((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)[" ~ $tmp ~ "]"
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st2.interns,
                                                    decls: $st2.decls ~ g4_value_decl($want, $valtmp),
                                                    body: $st2.body ~ "\t" ~ $valtmp ~ " = " ~ $row ~ ";\n" ~ g6e_enum_retain($ename, $valtmp) ~ g7_slice_release($lv.c),
                                                    nstr: $st2.nstr,
                                                    ntmp: $st2.ntmp + 1
                                                ),
                                                c: $valtmp
                                            ))
                                        }
                                        CgClass($cname) {
                                            $valtmp = g4_value_tmp($want, $st2.ntmp)
                                            $row = "((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)[" ~ $tmp ~ "]"
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st2.interns,
                                                    decls: $st2.decls ~ g4_value_decl($want, $valtmp),
                                                    body: $st2.body ~ "\t" ~ $valtmp ~ " = " ~ $row ~ ";\n" ~ g8_class_retain($cname, $valtmp) ~ g7_slice_release($lv.c),
                                                    nstr: $st2.nstr,
                                                    ntmp: $st2.ntmp + 1
                                                ),
                                                c: $valtmp
                                            ))
                                        }
                                        _ {
                                            $valtmp = g4_value_tmp($want, $st2.ntmp)
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st2.interns,
                                                    decls: $st2.decls ~ g4_value_decl($want, $valtmp),
                                                    body: $st2.body ~ "\t" ~ $valtmp ~ " = ((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)[" ~ $tmp ~ "];\n" ~ g7_slice_release($lv.c),
                                                    nstr: $st2.nstr,
                                                    ntmp: $st2.ntmp + 1
                                                ),
                                                c: $valtmp
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Element CgKind for a `List[T]` type annotation. Int/Float/Bool/Str lists are
# in subset for literal bindings + indexing; every other element type -> out of
# subset.
sub g7_list_elem_kind_from_type($ty: Option[TypeRef]): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "List" {
                match typelist_at($tr.args, 0) {
                    None { Err(g3_unsupported()) }
                    Some($elem) {
                        if $elem.name == "Int" {
                            Ok(CgInt)
                        } else if $elem.name == "Float" {
                            Ok(CgFloat)
                        } else if $elem.name == "Bool" {
                            Ok(CgBool)
                        } else if $elem.name == "Str" {
                            Ok(CgStr)
                        } else if $elem.name == "List" {
                            match g7_list_elem_kind_from_type(Some($elem)) {
                                Ok($inner) { Ok(CgList($inner)) }
                                Err($m) { Err($m) }
                            }
                        } else if $elem.name == "Map" {
                            match g7_map_val_kind_from_type(Some($elem)) {
                                Ok($v) { Ok(CgMap($v)) }
                                Err($m) { Err($m) }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# ---- G7-c: Map[Str, V] literal bindings + print(%m) display ----------------
# A `Map[Str, V]`-annotated binding whose value is a non-empty map literal lowers
# to the same TWO PARALLEL HEAP ARRAYS `guji build` emits (captured READ-ONLY via
# the cc-wrapper): a `const char** <cn>_keys` ARR_STR array, a `<vctype>* <cn>_vals`
# array (ARR_SCALAR for Int/Float/Bool, ARR_STR for Str), and an `int64_t <cn>_len`.
# Keys are stored in SOURCE order (not sorted); the runtime `guji_map_str` sorts at
# display time. `print(%m)` lowers `%m` to a Str temp via `guji_map_str(keys, vals,
# len, <val_arr_kind>, <leaf>)`, then prints + releases it. Both arrays are released
# at scope exit (the ARR_STR drops cascade to each owned key/Str-value element).
#
# SUBSET: v0 Str-keyed maps only; the binding MUST be annotated `Map[Str, V]` with
# V in Int/Float/Bool/Str (no inference), and the initialiser MUST be a map literal.
# Empty maps allocate length-0 heap arrays in the selfhost C tail; this is behavior-
# equivalent to native's length-0 local backing and keeps release/display uniform.
# Out of subset (-> invalid-corpus): unannotated map bindings, map reassignment, a
# map used as a value (call arg/return/if/match), nested/compound value types, and
# most map access prelude fns (get/set/remove; class-field has_key and keys/values
# snapshots are the documented exceptions).
# DUPLICATE KEYS ARE AN ORACLE DIVERGENCE (interp last-wins-dedups, native keeps
# both), so the corpus must keep keys distinct; this slice does not detect dups.

# Value CgKind for a `Map[K, V]` annotation. v0 keys are always Str (key type
# ignored); the value type (arg index 1) must be a supported scalar/Str.
sub g7_map_val_kind_from_type($ty: Option[TypeRef]): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Map" {
                match typelist_at($tr.args, 1) {
                    None { Err(g3_unsupported()) }
                    Some($vt) {
                        if $vt.name == "Int" {
                            Ok(CgInt)
                        } else if $vt.name == "Float" {
                            Ok(CgFloat)
                        } else if $vt.name == "Bool" {
                            Ok(CgBool)
                        } else if $vt.name == "Str" {
                            Ok(CgStr)
                        } else if $vt.name == "List" {
                            match g7_list_elem_kind_from_type(Some($vt)) {
                                Ok($elem) { Ok(CgList($elem)) }
                                Err($m) { Err($m) }
                            }
                        } else if $vt.name == "Map" {
                            match g7_map_val_kind_from_type(Some($vt)) {
                                Ok($val) { Ok(CgMap($val)) }
                                Err($m) { Err($m) }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# I5g4: class-field collection annotations are resolved while only the full
# declaration list is available (before CgEnv exists).  The ordinary List/Map
# resolvers intentionally know only built-in leaves; this declaration-aware
# twin additionally preserves user class/enum leaves through arbitrary nested
# List/Map carriers.
sub g7_kind_from_type_decls($tr: TypeRef, $decls: DeclList): Result[CgKind, Str] {
    if $tr.name == "Int" {
        Ok(CgInt)
    } else if $tr.name == "Float" {
        Ok(CgFloat)
    } else if $tr.name == "Bool" {
        Ok(CgBool)
    } else if $tr.name == "Str" {
        Ok(CgStr)
    } else if $tr.name == "List" {
        match typelist_at($tr.args, 0) {
            None { Err(g3_unsupported()) }
            Some($elem) {
                match g7_kind_from_type_decls($elem, $decls) {
                    Ok($kind) { Ok(CgList($kind)) }
                    Err($m) { Err($m) }
                }
            }
        }
    } else if $tr.name == "Map" {
        match typelist_at($tr.args, 1) {
            None { Err(g3_unsupported()) }
            Some($val) {
                match g7_kind_from_type_decls($val, $decls) {
                    Ok($kind) { Ok(CgMap($kind)) }
                    Err($m) { Err($m) }
                }
            }
        }
    } else if decl_class_named($decls, $tr.name) {
        Ok(CgClass($tr.name))
    } else if decl_enum_named($decls, $tr.name) {
        Ok(CgEnum($tr.name))
    } else {
        Err(g3_unsupported())
    }
}

# Infer a map value kind from control-flow branch finals. This mirrors list,
# Option, Result, and user-enum inference: typechecking has already established
# branch agreement, while codegen only needs one classifiable final expression.
sub g7_map_val_kind_from_block($stmts: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match g6e_block_final_expr($stmts) {
        None { Err(g3_unsupported()) }
        Some($e) { g7_map_val_kind_from_value($e, $env) }
    }
}

sub g7_map_val_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g7_map_val_kind_from_block($arm.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g7_map_val_kind_from_arms($rest, $env) }
            }
        }
    }
}

sub g7_map_val_kind_from_if_tail($elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) { g7_map_val_kind_from_block($body, $env) }
            }
        }
        ElifCons($head, $tail) {
            match g7_map_val_kind_from_block($head.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g7_map_val_kind_from_if_tail($tail, $els, $env) }
            }
        }
    }
}

sub g7_map_val_kind_from_if($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match g7_map_val_kind_from_block($then, $env) {
        Ok($k) { Ok($k) }
        Err($m) { g7_map_val_kind_from_if_tail($elifs, $els, $env) }
    }
}

# Value kind for a map-valued expression in a context that has no annotation,
# such as `for $k, $v in <expr>`. Named/field receivers reuse the existing map
# view; map-returning calls use their declared RMap kind; a non-empty map literal
# uses its first value to fix V.
sub g7_map_val_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match g7_map_receiver_val_kind($value, $env) {
        Ok($v) { Ok($v) }
        Err($not_recv) {
            match $value {
                ECall($callee, $args) {
                    match g4_option_unwrap_map_val_kind($callee, $args, $env) {
                        Ok($v) { Ok($v) }
                        Err($not_unwrap) {
                            match g7_reduce_map_kind($callee, $args, $env) {
                                Ok($v) { Ok($v) }
                                Err($not_reduce) {
                                    match g7_map_set_remove_result_kind($callee, $args, $env) {
                                        Some($v) { Ok($v) }
                                        None {
                                            match g7_call_map_kind($callee, $args, $env) {
                                                Some($v) { Ok($v) }
                                                None { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EMap($entries) {
                    match $entries {
                        # Empty `{}` has no value to fix V; native defaults to Int
                        # (mapExpr). Needed so unannotated `[{}]` infers List[Map[Str,Int]].
                        MapEntryNil { Ok(CgInt) }
                        MapEntryCons($first, $rest) {
                            # The first value fixes V: a scalar first, else a nested
                            # list element (CgList), else a nested map value (CgMap) —
                            # the same try-order as g7_list_kind_from_value so deep
                            # mixed nesting composes recursively.
                            match g7_scalar_elem_kind($first.value, $env) {
                                Ok($sk) { Ok($sk) }
                                Err($ms) {
                                    match g7_list_kind_from_value($first.value, $env) {
                                        Ok($lk) { Ok(CgList($lk)) }
                                        Err($ml) {
                                            match g7_map_val_kind_from_value($first.value, $env) {
                                                Ok($vk) { Ok(CgMap($vk)) }
                                                Err($mm) { Err(g3_unsupported()) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EIndex($obj, $idx) {
                    # `@maps[i]` yields a map when the list element is CgMap(V).
                    # A map index also yields a map when the receiver value kind
                    # is CgMap(V). Trying both recursively preserves arbitrary
                    # supported Map/List hops instead of stopping after one level.
                    match g7_list_kind_from_value($obj, $env) {
                        Err($m) {
                            match g7_map_val_kind_from_value($obj, $env) {
                                Err($mm) { Err($mm) }
                                Ok($outer) {
                                    match $outer {
                                        CgMap($v) { Ok($v) }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                        Ok($elem) {
                            match $elem {
                                CgMap($v) { Ok($v) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                EIf($cond, $then, $elifs, $els) { g7_map_val_kind_from_if($then, $elifs, $els, $env) }
                EMatch($subject, $arms) { g7_map_val_kind_from_arms($arms, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# The `guji_arr_alloc` kind for a map's VALUE array: ARR_STR for Str, ARR_SCALAR
# otherwise — identical to a list's element-array kind, so reuse it.
sub g7_map_val_arr_kind($val: CgKind): Result[Str, Str] {
    g7_list_arr_kind($val)
}

# Per-slot VALUE retain for map set/remove copy loops (native retainMapSlot).
# Keys are always retained separately; this only covers the value side. Str
# retains the string pointer; List/Map retain the row's counted storage (the
# shallow struct copy alone would alias and double-release). Scalars are a no-op.
sub g7_map_val_slot_retain($val: CgKind, $slot: Str): Str {
    match $val {
        CgStr { "\t\tguji_retain(" ~ $slot ~ ");\n" }
        CgList($e) { "\t\tguji_retain(" ~ $slot ~ ".data);\n" }
        CgMap($v) {
            "\t\tguji_retain((const void*)" ~ $slot ~ ".keys);\n" ~
            "\t\tguji_retain(" ~ $slot ~ ".vals);\n"
        }
        _ { "" }
    }
}

# Per-slot VALUE release before replacing an existing key (native
# releaseMapValueSlot). Indentation matches the set-core replace arm (3 tabs).
sub g7_map_val_slot_release($val: CgKind, $slot: Str): Str {
    match $val {
        CgStr { "\t\t\tguji_release(" ~ $slot ~ ");\n" }
        CgList($e) { "\t\t\tguji_release(" ~ $slot ~ ".data);\n" }
        CgMap($v) {
            "\t\t\tguji_release((const void*)" ~ $slot ~ ".keys);\n" ~
            "\t\t\tguji_release(" ~ $slot ~ ".vals);\n"
        }
        _ { "" }
    }
}

# Infer V for a prelude `set`/`remove` call from the receiver's map value kind
# (user `sub set`/`sub remove` shadows decline to None). Enables unannotated
# `%r = %m.set(...)` / `%r = %m.remove(...)` binds.
sub g7_map_set_remove_result_kind($callee: Expr, $args: ExprList, $env: CgEnv): Option[CgKind] {
    match $callee {
        EName($fn) {
            if $fn == "set" {
                match cg_env_lookup_sub($env, "set") {
                    Some($sig) { None }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprCons($vexpr, ExprNil))) {
                                match g7_map_val_kind_from_value($recv, $env) {
                                    Ok($v) { Some($v) }
                                    Err($m) { None }
                                }
                            }
                            _ { None }
                        }
                    }
                }
            } else if $fn == "remove" {
                match cg_env_lookup_sub($env, "remove") {
                    Some($sig) { None }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprNil)) {
                                match g7_map_val_kind_from_value($recv, $env) {
                                    Ok($v) { Some($v) }
                                    Err($m) { None }
                                }
                            }
                            _ { None }
                        }
                    }
                }
            } else {
                None
            }
        }
        EField($recv, $method) {
            if $method == "set" {
                match $args {
                    ExprCons($key, ExprCons($vexpr, ExprNil)) {
                        match g7_map_val_kind_from_value($recv, $env) {
                            Ok($v) { Some($v) }
                            Err($m) { None }
                        }
                    }
                    _ { None }
                }
            } else if $method == "remove" {
                match $args {
                    ExprCons($key, ExprNil) {
                        match g7_map_val_kind_from_value($recv, $env) {
                            Ok($v) { Some($v) }
                            Err($m) { None }
                        }
                    }
                    _ { None }
                }
            } else {
                None
            }
        }
        _ { None }
    }
}

# Keep-arm retain for remove's skip-copy loop (same snippets as copy-retain, but
# nested one tab deeper under the non-equal-key arm).
sub g7_map_val_slot_keep_retain($val: CgKind, $slot: Str): Str {
    match $val {
        CgStr { "\t\t\tguji_retain(" ~ $slot ~ ");\n" }
        CgList($e) { "\t\t\tguji_retain(" ~ $slot ~ ".data);\n" }
        CgMap($v) {
            "\t\t\tguji_retain((const void*)" ~ $slot ~ ".keys);\n" ~
            "\t\t\tguji_retain(" ~ $slot ~ ".vals);\n"
        }
        _ { "" }
    }
}

# The leaf-type tag `guji_map_str` / `guji_map_equal` use to render/compare each
# value (native: GUJI_LEAF_INT for Int, GUJI_LEAF_FLOAT for Float, GUJI_LEAF_BOOL
# for Bool; for Str the value array is ARR_STR and the leaf tag is ignored — native
# passes GUJI_LEAF_INT). Collection value arrays carry their shape in ARR_SLICE /
# ARR_MAP; recurse to the innermost scalar leaf exactly like native's
# displayLeafKindFromType.
sub g7_map_leaf($val: CgKind): Result[Str, Str] {
    match $val {
        CgInt { Ok("GUJI_LEAF_INT") }
        CgFloat { Ok("GUJI_LEAF_FLOAT") }
        CgBool { Ok("GUJI_LEAF_BOOL") }
        CgStr { Ok("GUJI_LEAF_INT") }
        CgList($elem) { g7_map_leaf($elem) }
        CgMap($inner) { g7_map_leaf($inner) }
        _ { Err(g3_unsupported()) }
    }
}

# Release a map binding's two heap arrays at scope exit. Keys are always ARR_STR
# (drop cascades to each owned key); the value array's drop frees scalars or
# cascades through ARR_STR Str values.
sub g7_map_release($cn: Str): Str {
    "\tguji_release((const void*)" ~ $cn ~ "_keys);\n\tguji_release((const void*)" ~ $cn ~ "_vals);\n"
}

# Snapshot a map literal one entry at a time. Guji evaluates each source entry's
# key before its value, then advances to the next entry (§5.6); collecting all
# keys and then all values changes observable call/trap order. Collection rows
# remain owned temps until the caller moves them into the destination array.
class MapEntryTemps {
    has $.state: CgState
    has $.keys: StrList
    has $.vals: StrList
    has $.count: Int
}

sub g7_lower_map_entry_temps($val: CgKind, $entries: MapEntryList, $state: CgState, $env: CgEnv): Result[MapEntryTemps, Str] {
    match $entries {
        MapEntryNil { Ok(MapEntryTemps(state: $state, keys: StrNil, vals: StrNil, count: 0)) }
        MapEntryCons($entry, $rest) {
            match g7_lower_scalar_elem(CgStr, $entry.key, $state, $env) {
                Err($m) { Err($m) }
                Ok($key) {
                    match $val {
                        CgList($elem) {
                            match g7_lower_list_value($elem, $entry.value, $key.state, $env) {
                                Err($m) { Err($m) }
                                Ok($value) {
                                    match g7_lower_map_entry_temps($val, $rest, $value.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($tail) {
                                            Ok(MapEntryTemps(
                                                state: $tail.state,
                                                keys: StrCons($key.c, $tail.keys),
                                                vals: StrCons($value.c, $tail.vals),
                                                count: $tail.count + 1
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                        CgMap($inner) {
                            match g7_lower_map_value($inner, $entry.value, $key.state, $env) {
                                Err($m) { Err($m) }
                                Ok($value) {
                                    match g7_lower_map_entry_temps($val, $rest, $value.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($tail) {
                                            Ok(MapEntryTemps(
                                                state: $tail.state,
                                                keys: StrCons($key.c, $tail.keys),
                                                vals: StrCons($value.c, $tail.vals),
                                                count: $tail.count + 1
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                        _ {
                            match g7_lower_scalar_elem($val, $entry.value, $key.state, $env) {
                                Err($m) { Err($m) }
                                Ok($value) {
                                    match g7_lower_map_entry_temps($val, $rest, $value.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($tail) {
                                            Ok(MapEntryTemps(
                                                state: $tail.state,
                                                keys: StrCons($key.c, $tail.keys),
                                                vals: StrCons($value.c, $tail.vals),
                                                count: $tail.count + 1
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Emit `<cn>_keys[i] = <krval>; <cn>_vals[i] = <vrval>;` for each pair, in order.
sub g7_map_assigns($cn: Str, $krvals: StrList, $vrvals: StrList, $i: Int): Str {
    match $krvals {
        StrNil { "" }
        StrCons($kh, $kt) {
            match $vrvals {
                StrNil { "" }
                StrCons($vh, $vt) {
                    "\t" ~ $cn ~ "_keys[" ~ c_int($i) ~ "] = " ~ $kh ~ ";\n\t" ~ $cn ~ "_vals[" ~ c_int($i) ~ "] = " ~ $vh ~ ";\n" ~ g7_map_assigns($cn, $kt, $vt, $i + 1)
                }
            }
        }
    }
}

# Emit `<keys>[i] = <krval>;` for each key, in order. The collection-valued map
# branches use this keys-only twin of g7_map_assigns: the owned key Strs MOVE
# into the ARR_STR keys array here, while the already-snapshotted value rows move
# separately through g7_map_coll_move_temps.
sub g7_map_key_assigns($keys: Str, $krvals: StrList, $i: Int): Str {
    match $krvals {
        StrNil { "" }
        StrCons($kh, $kt) {
            "\t" ~ $keys ~ "[" ~ c_int($i) ~ "] = " ~ $kh ~ ";\n" ~ g7_map_key_assigns($keys, $kt, $i + 1)
        }
    }
}

# A map binding lives in one of two C storage forms, distinguished by `listlen`:
#   * NAMED two-array form (a top-level `%m = {...}` binding via g7_lower_map_bind):
#     listlen >= 0; the keys/vals/len are three named locals `<cn>_keys`/`_vals`/`_len`.
#   * STRUCT (by-value `guji_map_t`) form (a Map enum-carrier field bound in a match
#     arm): listlen < 0 (the sentinel set at bind time); keys/vals/len are the struct
#     members `<cn>.keys`/`.vals`/`.len`. An EMPTY top-level map binding is listlen 0,
#     so the sentinel MUST be negative, never 0 — else empty bindings would misread.
sub g7_map_var_keys($var: CgVar): Str {
    if $var.listlen < 0 { $var.cname ~ ".keys" } else { $var.cname ~ "_keys" }
}

sub g7_map_var_vals($var: CgVar): Str {
    if $var.listlen < 0 { $var.cname ~ ".vals" } else { $var.cname ~ "_vals" }
}

sub g7_map_var_len($var: CgVar): Str {
    if $var.listlen < 0 { $var.cname ~ ".len" } else { $var.cname ~ "_len" }
}

# Typed value-array base: the struct form's `void* .vals` needs an explicit cast to
# the value C type; the named form's `<cn>_vals` is already typed.
sub g7_map_var_vals_typed($var: CgVar, $vctype: Str): Str {
    if $var.listlen < 0 { "((" ~ $vctype ~ "*)" ~ $var.cname ~ ".vals)" } else { $var.cname ~ "_vals" }
}

# Resolve a Map receiver to the storage view expected by g7_map_var_* helpers.
# Named map bindings use the two-array `<cn>_keys`/`_vals` form; class fields use
# the by-value `guji_map_t` struct form and are marked with the negative listlen
# sentinel.
sub g7_map_receiver_var($recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgMap($v) { Ok($var) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EField($obj, $field) {
            match g8_resolve_field_acc($obj, $field, $env) {
                Err($m) { Err($m) }
                Ok($fa) {
                    match $fa.kind {
                        CgMap($v) { Ok(CgVar(name: "", cname: $fa.acc, kind: CgMap($v), mutable: false, borrowed: true, listlen: 0 - 1)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Pure kind of V for a Map receiver, including List[Map] index hops that
# g7_map_receiver_var cannot name (no stateful temp yet). Used by values()
# element-kind inference and keys() "is a map" checks.
sub g7_map_receiver_val_kind($recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match g7_map_receiver_var($recv, $env) {
        Ok($var) {
            match $var.kind {
                CgMap($v) { Ok($v) }
                _ { Err(g3_unsupported()) }
            }
        }
        Err($m) {
            match $recv {
                EIndex($obj, $idx) {
                    match $obj {
                        EName($n) {
                            match cg_env_lookup($env, $n) {
                                None { Err($m) }
                                Some($v) {
                                    match $v.kind {
                                        CgList($elem) {
                                            match $elem {
                                                CgMap($vk) { Ok($vk) }
                                                _ { Err($m) }
                                            }
                                        }
                                        _ { Err($m) }
                                    }
                                }
                            }
                        }
                        _ { Err($m) }
                    }
                }
                _ { Err($m) }
            }
        }
    }
}

# P9-6b-10 / P9-6b-14: resolve a map method/projection receiver.
# Named/field maps borrow in place. A List[Map] index (`@maps[i].values()` /
# `.keys()` / `.has_key` / `.get`) materializes a SHALLOW borrowed `guji_map_t`
# temp — native assigns `gtN = data[i]` with no retain/release — so the
# struct-view helpers work. P9-6b-14: a set/remove call, fresh map literal, or
# other map-valued expr (`%m.set(...).keys()`, `{...}.values()`) is lowered to
# an OWNED `guji_map_t` temp (same shape as g7_map_setremove_recv) and released
# after the projection/method body retains the slots it keeps.
# Reuses SetRemoveRecv's (var, state, release) shape; release stays empty for
# the borrowed index view (the list owns the arrays).
sub g7_list_map_index_recv($recv: Expr, $state: CgState, $env: CgEnv): Result[SetRemoveRecv, Str] {
    match $recv {
        EIndex($obj, $idx) {
            match $obj {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgList($elem) {
                                    match $elem {
                                        CgMap($vk) {
                                            match g7_list_c_type($elem) {
                                                Err($e) { Err($e) }
                                                Ok($ctype) {
                                                    match g3_int_rvalue_state($idx, $state, $env) {
                                                        Err($e) { Err($e) }
                                                        Ok($iv) {
                                                            $itmp = "gi" ~ c_int($iv.state.ntmp)
                                                            $mtmp = g4_value_tmp(CgMap($vk), $iv.state.ntmp + 1)
                                                            $data = g7_list_var_data($v, $ctype)
                                                            $len = g7_list_var_len($v)
                                                            Ok(SetRemoveRecv(
                                                                var: CgVar(name: "", cname: $mtmp, kind: CgMap($vk), mutable: false, borrowed: true, listlen: 0 - 1),
                                                                state: CgState(
                                                                    interns: $iv.state.interns,
                                                                    decls: $iv.state.decls ~
                                                                        "\tint64_t " ~ $itmp ~ " = 0;\n" ~
                                                                        g4_value_decl(CgMap($vk), $mtmp),
                                                                    body: $iv.state.body ~
                                                                        "\t" ~ $itmp ~ " = " ~ $iv.c ~ ";\n" ~
                                                                        "\tif (" ~ $itmp ~ " < 0 || " ~ $itmp ~ " >= " ~ $len ~ ") \{ guji_panic(\"list index out of bounds\"); }\n" ~
                                                                        "\t" ~ $mtmp ~ " = " ~ $data ~ "[" ~ $itmp ~ "];\n",
                                                                    nstr: $iv.state.nstr,
                                                                    ntmp: $iv.state.ntmp + 2
                                                                ),
                                                                release: ""
                                                            ))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_map_owned_method_recv($recv: Expr, $state: CgState, $env: CgEnv, $fallback: Str): Result[SetRemoveRecv, Str] {
    # Owned map temp: map indexes, set/remove chains, literals, map-returning
    # calls — anything g7_lower_map_value already accepts.
    match g7_map_val_kind_from_value($recv, $env) {
        Err($e) { Err($fallback) }
        Ok($val) {
            match g7_lower_map_value($val, $recv, $state, $env) {
                Err($e) { Err($e) }
                Ok($mv) {
                    Ok(SetRemoveRecv(
                        var: CgVar(name: "", cname: $mv.c, kind: CgMap($val), mutable: false, borrowed: true, listlen: 0 - 1),
                        state: $mv.state,
                        release: g7_map_value_release($mv.c)
                    ))
                }
            }
        }
    }
}

sub g7_map_method_recv($recv: Expr, $state: CgState, $env: CgEnv): Result[SetRemoveRecv, Str] {
    match g7_map_receiver_var($recv, $env) {
        Ok($var) { Ok(SetRemoveRecv(var: $var, state: $state, release: "")) }
        Err($m) {
            match $recv {
                # A List[Map] row remains a shallow BORROW. A Map[Str, Map]
                # value index is instead materialized as an owned map temp and
                # released after the method has retained any result it keeps.
                EIndex($obj, $idx) {
                    match g7_list_map_index_recv($recv, $state, $env) {
                        Ok($rv) { Ok($rv) }
                        Err($not_list_index) { g7_map_owned_method_recv($recv, $state, $env, $m) }
                    }
                }
                _ { g7_map_owned_method_recv($recv, $state, $env, $m) }
            }
        }
    }
}

# Lower `keys(%m)` / `%m.keys()` to an owned List[Str] snapshot sorted by key, and
# `values(%m)` / `%m.values()` to an owned List[V] in that same sorted-key order.
# Native's `mapKeys`/`mapValues` calls `guji_map_order` first so the result order
# matches the interpreter's deterministic map order. The receiver is borrowed from
# an existing map binding, field, or List[Map] index (P9-6b-10), or an owned
# set/remove/literal/call temp released after the copy (P9-6b-14); the result owns
# its copied array and retains counted slots (keys and Str values).
sub g7_map_projection_core($name: Str, $recv: Expr, $out_elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_map_method_recv($recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($rv) {
            match $rv.var.kind {
                CgMap($val) {
                    if ($name == "keys" && cgkind_eq($out_elem, CgStr)) || ($name == "values" && cgkind_eq($out_elem, $val)) {
                        match g7_list_c_type($out_elem) {
                            Err($m) { Err($m) }
                            Ok($ctype) {
                                match g7_list_arr_kind($out_elem) {
                                    Err($m) { Err($m) }
                                    Ok($ak) {
                                        $dst = g4_value_tmp(CgList($out_elem), $rv.state.ntmp)
                                        $order = "go" ~ c_int($rv.state.ntmp + 1)
                                        $idx = "gi" ~ c_int($rv.state.ntmp + 2)
                                        $src = if $name == "keys" {
                                            g7_map_var_keys($rv.var)
                                        } else {
                                            g7_map_var_vals_typed($rv.var, $ctype)
                                        }
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $rv.state.interns,
                                                decls: $rv.state.decls ~
                                                    "\tguji_slice_t " ~ $dst ~ " = \{0};\n" ~
                                                    "\tint64_t* " ~ $order ~ " = NULL;\n" ~
                                                    "\tint64_t " ~ $idx ~ " = 0;\n",
                                                body: $rv.state.body ~
                                                    "\t" ~ $order ~ " = (int64_t*)guji_arr_alloc(GUJI_KIND_ARR_SCALAR, sizeof(int64_t), " ~ g7_map_var_len($rv.var) ~ ");\n" ~
                                                    "\tguji_map_order(" ~ g7_map_var_keys($rv.var) ~ ", " ~ g7_map_var_len($rv.var) ~ ", " ~ $order ~ ");\n" ~
                                                    "\t" ~ $dst ~ ".len = " ~ g7_map_var_len($rv.var) ~ ";\n" ~
                                                    "\t" ~ $dst ~ ".data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ctype ~ "), " ~ g7_map_var_len($rv.var) ~ ");\n" ~
                                                    "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ g7_map_var_len($rv.var) ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                    "\t\t((" ~ $ctype ~ "*)" ~ $dst ~ ".data)[" ~ $idx ~ "] = " ~ $src ~ "[" ~ $order ~ "[" ~ $idx ~ "]];\n" ~
                                                    g7_row_retain_slot($out_elem, $ctype, $dst, $idx) ~
                                                    "\t}\n" ~
                                                    "\tguji_release((const void*)" ~ $order ~ ");\n" ~
                                                    $rv.release,
                                                nstr: $rv.state.nstr,
                                                ntmp: $rv.state.ntmp + 3
                                            ),
                                            c: $dst
                                        ))
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_map_projection_value($callee: Expr, $args: ExprList, $out_elem: CgKind, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $callee {
        EName($fn) {
            if $fn == "keys" || $fn == "values" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_map_projection_core($fn, $recv, $out_elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "keys" || $method == "values" {
                match cg_env_lookup_sub($env, $method) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprNil { g7_map_projection_core($method, $recv, $out_elem, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_map_projection_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match $callee {
        EName($fn) {
            if $fn == "keys" {
                match cg_env_lookup_sub($env, "keys") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprNil) {
                                # g7_map_val_kind_from_value covers set/remove/literal
                                # receivers (P9-6b-14), not only named/index maps.
                                match g7_map_val_kind_from_value($recv, $env) {
                                    Ok($v) { Ok(CgStr) }
                                    Err($m) { Err($m) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else if $fn == "values" {
                match cg_env_lookup_sub($env, "values") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_map_val_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "keys" {
                match cg_env_lookup_sub($env, "keys") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprNil {
                                match g7_map_val_kind_from_value($recv, $env) {
                                    Ok($v) { Ok(CgStr) }
                                    Err($m) { Err($m) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else if $method == "values" {
                match cg_env_lookup_sub($env, "values") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprNil { g7_map_val_kind_from_value($recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_map_has_key_core($recv: Expr, $key: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g7_map_method_recv($recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($rv) {
            match g3_str_lower($key, $rv.state, $env) {
                Err($m) { Err($m) }
                Ok($ks) {
                    $bi = c_int($ks.state.ntmp)
                    $bt = "gb" ~ $bi
                    $idx = "gi" ~ c_int($ks.state.ntmp + 1)
                    Ok(BoolLower(
                        state: CgState(
                            interns: $ks.state.interns,
                            decls: $ks.state.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n\tint64_t " ~ $idx ~ " = 0;\n",
                            body: $ks.state.body ~
                                "\t" ~ $bt ~ " = 0;\n" ~
                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ g7_map_var_len($rv.var) ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                "\t\tif (guji_str_equal(" ~ g7_map_var_keys($rv.var) ~ "[" ~ $idx ~ "], " ~ $ks.tmp ~ ")) \{ " ~ $bt ~ " = 1; break; }\n" ~
                                "\t}\n" ~
                                "\tguji_release(" ~ $ks.tmp ~ ");\n" ~
                                $rv.release,
                            nstr: $ks.state.nstr,
                            ntmp: $ks.state.ntmp + 2
                        ),
                        c: $bt
                    ))
                }
            }
        }
    }
}

# Lower `has_key(%m, <Str>)` / `<map-receiver>.has_key(<Str>)` to an inline scan
# of the receiver's key array. Function form respects a user `sub has_key`;
# method form remains prelude, matching the other data-first helpers.
sub g7_lower_map_has_key_call($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $callee {
        EName($fn) {
            if $fn == "has_key" {
                match cg_env_lookup_sub($env, "has_key") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprNil)) { g7_map_has_key_core($recv, $key, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "has_key" {
                match $args {
                    ExprCons($key, ExprNil) { g7_map_has_key_core($recv, $key, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# ---- P2c-32: map `get` (§15.2) as an Option[V] carrier producer ------------
# `get(%m, k)` / `%m.get(k)` yields Some(value) when the key is present, else
# None. The lowering scans the receiver's `.keys` with counted equality, breaks
# on the first hit filling a zeroed Option carrier's `tag`/`val`, and (for a Str value) retains
# `.val` so the carrier co-owns its own +1. This mirrors `g6_get_option_core`
# (list get) but resolves the receiver as a MAP and reads the value array by hit
# index instead of indexing a list.
#
# CLEANER-THAN-NATIVE (precedent P2c-20/P2c-30): native LEAKS the key temp on this
# path — it aliases the owned key into the comparison operand and NEVER releases it
# (cc-wrapper-verified), whereas `has_key` DOES release it. The selfhost port
# releases the owned key temp after the scan; that is refcount-balanced and
# observably identical (three-way = stdout+stderr+exit) while the sanitizer oracle
# requires a leak-clean emission. `g3_str_lower`'s `.tmp` is always safe to
# release (owned for concat/var-read, immortal-safe for a literal).
#
# SUBSET: bound map locals / borrowed struct-form map receivers (anything
# g7_map_receiver_var resolves), scalar/Str value kinds equal to the expected
# Option payload kind. Function form respects a user `sub get` shadow; method form
# remains prelude (native's method-shadow asymmetry, matching list get / P2c-31).
sub g7_map_get_core($kind: CgKind, $recv: Expr, $key: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_payload_kind($kind) {
        Err($m) { Err($m) }
        Ok($pk) {
            match g7_map_method_recv($recv, $state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    match $rv.var.kind {
                        CgMap($v) {
                            if cgkind_eq($v, $pk) {
                                match g7_list_c_type($pk) {
                                    Err($m) { Err($m) }
                                    Ok($vctype) {
                                        match g3_str_lower($key, $rv.state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($ks) {
                                                $idx = "gi" ~ c_int($ks.state.ntmp)
                                                $opt = g4_value_tmp($kind, $ks.state.ntmp + 1)
                                                $retain = g6_get_hit_retain($kind, $opt, "\t\t\t")
                                                Ok(CgValueOut(
                                                    state: CgState(
                                                        interns: $ks.state.interns,
                                                        decls: $ks.state.decls ~ "\tint64_t " ~ $idx ~ " = 0;\n" ~ g4_value_decl($kind, $opt),
                                                        body: $ks.state.body ~
                                                            "\t" ~ $opt ~ ".tag = 0LL; " ~ $opt ~ ".val = " ~ g6_option_zero($kind) ~ ";\n" ~
                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ g7_map_var_len($rv.var) ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                            "\t\tif (guji_str_equal(" ~ g7_map_var_keys($rv.var) ~ "[" ~ $idx ~ "], " ~ $ks.tmp ~ ")) \{\n" ~
                                                            "\t\t\t" ~ $opt ~ ".tag = 1LL; " ~ $opt ~ ".val = " ~ g7_map_var_vals_typed($rv.var, $vctype) ~ "[" ~ $idx ~ "];\n" ~
                                                            $retain ~
                                                            "\t\t\tbreak;\n" ~
                                                            "\t\t}\n" ~
                                                            "\t}\n" ~
                                                            "\tguji_release(" ~ $ks.tmp ~ ");\n" ~
                                                            $rv.release,
                                                        nstr: $ks.state.nstr,
                                                        ntmp: $ks.state.ntmp + 2
                                                    ),
                                                    c: $opt
                                                ))
                                            }
                                        }
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# Dispatch map `get` as ordinary `get(%m, k)` or method-form `%m.get(k)`. Native
# lets a user `sub get` shadow the ordinary call; method form stays prelude. The
# map receiver resolution (g7_map_receiver_var) declines non-map receivers, so
# this candidate is tried BEFORE list get and cleanly falls through for lists.
sub g7_map_get_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $callee {
        EName($fn) {
            if $fn == "get" {
                match cg_env_lookup_sub($env, "get") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprNil)) { g7_map_get_core($kind, $recv, $key, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "get" {
                match $args {
                    ExprCons($key, ExprNil) { g7_map_get_core($kind, $recv, $key, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# ---- P2c-30: map `set` / `remove` (§15.2) as bind-RHS copy producers -------
# `set(%m, k, v)` / `%m.set(k, v)` and `remove(%m, k)` / `%m.remove(k)` yield a
# COPY of the receiver with the key set/removed. Native's lowering is liveness-
# driven: when the source binding is DEAD after the call it emits a dual-path
# form (`GUJI_HDR(keys)->rc == 1 && ...->rc == 1` -> mutate the source arrays
# in place and NULL the source locals, else copy), and when the source is still
# LIVE it emits the copy path only (both captured via the cc-wrapper). The
# selfhost port has no liveness analysis, so it emits native's COPY path
# UNCONDITIONALLY — emitting the move arm for a still-live source would consume
# it, and the copy path is observably identical (three-way = stdout+stderr+
# exit) and refcount-balanced on every path (the skipped rc==1 move is only an
# allocation-count optimization; both source and copy release at scope exit).
#
# set copy shape (fresh named two-array binding <cn>, capacity src_len + 1):
#   copy loop: keys/vals copied in SOURCE order, each key retained (+ Str vals);
#   scan loop: counted-key replace — Str slot releases the OLD value first, the new
#     value temp is MOVED in; `found = 1; break;`
#   append arm (`if (found == 0)`): key + value MOVED into slot src_len;
#   `if (found != 0) { guji_release(<key>); }` — the key temp is consumed only
#   by the append arm (native's exact conditional-release shape).
# remove copy shape (capacity src_len, zero-filled tail is drop-safe — arrays
# are memset at alloc and guji_release(NULL) is a no-op, native relies on the
# same):
#   one skip-copy loop keeping every non-equal key/value pair (keys retained,
#   + Str vals), then an UNCONDITIONAL key release.
#
# SUBSET: the RHS of a Map binding (annotated, or unannotated via
# g7_map_set_remove_result_kind from the receiver), V = scalar/Str/List/Map,
# plus map VALUE position through g7_map_set_remove_value.
# The receiver is anything g7_map_receiver_var resolves (a named map binding or
# a borrowed struct-form map). Function forms respect a user `sub set`/`sub
# remove` (decline -> generic path); method forms remain prelude. Map
# REASSIGNMENT from a set/remove call is in subset via g7_lower_map_reassign's
# value path (P9-6b-12): lower to an owned guji_map_t, release the old two
# arrays, then steal. Collection values use retainMapSlot-shaped
# retain/release (g7_map_val_slot_*), not deep-copy.

# Resolve the receiver of a map set/remove copy loop. A direct map binding/field
# borrows in place (no release). A CHAINED receiver — the receiver is itself a
# set/remove call (`%m.set(...).remove(...)`) — or a FRESH map literal
# (`{ "a": 1 }.set("c", 3)` / `set({ "a": 1 }, "c", 3)`) is materialized into an
# OWNED guji_map_t temp (recursively for chains) and wrapped as a struct-view
# CgVar (listlen = -1), with a release snippet to free it after the copy loop
# retains the slots it keeps. `$val` is the map's VALUE kind V, which is
# invariant through set/remove, so the same V flows into the inner call.
# P9-5d: the literal arm is what flips `import_ownership` (vals.scores) — the
# module boundary was already fine; only fresh-literal `.set` as RHS declined.
sub g7_map_setremove_recv($val: CgKind, $recv: Expr, $state: CgState, $env: CgEnv): Result[SetRemoveRecv, Str] {
    match g7_map_receiver_var($recv, $env) {
        Ok($var) { Ok(SetRemoveRecv(var: $var, state: $state, release: "")) }
        Err($m) {
            match $recv {
                EIndex($obj, $idx) { g7_list_map_index_recv($recv, $state, $env) }
                ECall($callee, $args) {
                    match g7_map_set_remove_value($val, $callee, $args, $state, $env) {
                        Err($e) { Err($e) }
                        Ok($mv) {
                            Ok(SetRemoveRecv(
                                var: CgVar(name: "", cname: $mv.c, kind: CgMap($val), mutable: false, borrowed: true, listlen: 0 - 1),
                                state: $mv.state,
                                release: g7_map_value_release($mv.c)
                            ))
                        }
                    }
                }
                EMap($entries) {
                    match g7_lower_map_literal_value($val, $entries, $state, $env) {
                        Err($e) { Err($e) }
                        Ok($mv) {
                            Ok(SetRemoveRecv(
                                var: CgVar(name: "", cname: $mv.c, kind: CgMap($val), mutable: false, borrowed: true, listlen: 0 - 1),
                                state: $mv.state,
                                release: g7_map_value_release($mv.c)
                            ))
                        }
                    }
                }
                _ { Err($m) }
            }
        }
    }
}

sub g7_map_set_bind_core($val: CgKind, $mutable: Bool, $name: Str, $recv: Expr, $key: Expr, $vexpr: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g7_map_setremove_recv($val, $recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($rv) {
            match $rv.var.kind {
                CgMap($actual) {
                    if cgkind_eq($actual, $val) {
                        match g7_map_val_arr_kind($val) {
                            Err($m) { Err($m) }
                            Ok($vak) {
                                match g7_list_c_type($val) {
                                    Err($m) { Err($m) }
                                    Ok($vctype) {
                                        match g3_str_lower($key, $rv.state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($ks) {
                                                match g4_lower_value($val, $vexpr, $ks.state, $env) {
                                                    Err($m) { Err($m) }
                                                    Ok($vo) {
                                                        $base = $vo.state.ntmp
                                                        $vtn = g4_value_tmp($val, $base)
                                                        # Str/List/Map values are already OWNED named
                                                        # temps from g4_lower_value; scalars materialize
                                                        # so the rvalue is evaluated once even though
                                                        # two arms reference it. Fresh collection values
                                                        # MOVE into the slot (no extra retain) — native
                                                        # retainMapSlot(valFresh=true).
                                                        $vt = match $val {
                                                            CgStr { $vo.c }
                                                            CgList($e) { $vo.c }
                                                            CgMap($v) { $vo.c }
                                                            _ { $vtn }
                                                        }
                                                        $matdecl = match $val {
                                                            CgStr { "" }
                                                            CgList($e) { "" }
                                                            CgMap($v) { "" }
                                                            _ { g4_value_decl($val, $vtn) }
                                                        }
                                                        $mat = match $val {
                                                            CgStr { "" }
                                                            CgList($e) { "" }
                                                            CgMap($v) { "" }
                                                            _ { "\t" ~ $vtn ~ " = " ~ $vo.c ~ ";\n" }
                                                        }
                                                        $found = "gb" ~ c_int($base + 1)
                                                        $ci = "gi" ~ c_int($base + 2)
                                                        $cj = "gi" ~ c_int($base + 3)
                                                        $cn = "gv" ~ c_int($base + 4)
                                                        $kacc = g7_map_var_keys($rv.var)
                                                        $vacc = g7_map_var_vals_typed($rv.var, $vctype)
                                                        $lacc = g7_map_var_len($rv.var)
                                                        $copyretain = g7_map_val_slot_retain($val, $cn ~ "_vals[" ~ $ci ~ "]")
                                                        $replrel = g7_map_val_slot_release($val, $cn ~ "_vals[" ~ $cj ~ "]")
                                                        $decls = $matdecl ~ "\tint64_t " ~ $found ~ " = 0;\n\tint64_t " ~ $ci ~ " = 0;\n\tint64_t " ~ $cj ~ " = 0;\n\tconst char** " ~ $cn ~ "_keys = NULL;\n\t" ~ $vctype ~ "* " ~ $cn ~ "_vals = NULL;\n\tint64_t " ~ $cn ~ "_len = 0;\n"
                                                        $body = $mat ~
                                                            "\t" ~ $cn ~ "_keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ $lacc ~ " + 1);\n" ~
                                                            "\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ $lacc ~ " + 1);\n" ~
                                                            "\t" ~ $cn ~ "_len = " ~ $lacc ~ ";\n" ~
                                                            "\tfor (" ~ $ci ~ " = 0; " ~ $ci ~ " < " ~ $lacc ~ "; " ~ $ci ~ " = guji_add(" ~ $ci ~ ", 1)) \{\n" ~
                                                            "\t\t" ~ $cn ~ "_keys[" ~ $ci ~ "] = " ~ $kacc ~ "[" ~ $ci ~ "];\n" ~
                                                            "\t\t" ~ $cn ~ "_vals[" ~ $ci ~ "] = " ~ $vacc ~ "[" ~ $ci ~ "];\n" ~
                                                            "\t\tguji_retain(" ~ $cn ~ "_keys[" ~ $ci ~ "]);\n" ~
                                                            $copyretain ~
                                                            "\t}\n" ~
                                                            "\t" ~ $found ~ " = 0;\n" ~
                                                            "\tfor (" ~ $cj ~ " = 0; " ~ $cj ~ " < " ~ $cn ~ "_len; " ~ $cj ~ " = guji_add(" ~ $cj ~ ", 1)) \{\n" ~
                                                            "\t\tif (guji_str_equal(" ~ $cn ~ "_keys[" ~ $cj ~ "], " ~ $ks.tmp ~ ")) \{\n" ~
                                                            $replrel ~
                                                            "\t\t\t" ~ $cn ~ "_vals[" ~ $cj ~ "] = " ~ $vt ~ ";\n" ~
                                                            "\t\t\t" ~ $found ~ " = 1;\n" ~
                                                            "\t\t\tbreak;\n" ~
                                                            "\t\t}\n" ~
                                                            "\t}\n" ~
                                                            "\tif (" ~ $found ~ " == 0) \{\n" ~
                                                            "\t\t" ~ $cn ~ "_keys[" ~ $cn ~ "_len] = " ~ $ks.tmp ~ ";\n" ~
                                                            "\t\t" ~ $cn ~ "_vals[" ~ $cn ~ "_len] = " ~ $vt ~ ";\n" ~
                                                            "\t\t" ~ $cn ~ "_len = guji_add(" ~ $cn ~ "_len, 1);\n" ~
                                                            "\t}\n" ~
                                                            "\tif (" ~ $found ~ " != 0) \{ guji_release(" ~ $ks.tmp ~ "); }\n"
                                                        $st2 = CgState(
                                                            interns: $vo.state.interns,
                                                            decls: $vo.state.decls ~ $decls,
                                                            body: $vo.state.body ~ $body ~ $rv.release,
                                                            nstr: $vo.state.nstr,
                                                            ntmp: $base + 5
                                                        )
                                                        Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMap($val), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_map_remove_bind_core($val: CgKind, $mutable: Bool, $name: Str, $recv: Expr, $key: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g7_map_setremove_recv($val, $recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($rv) {
            match $rv.var.kind {
                CgMap($actual) {
                    if cgkind_eq($actual, $val) {
                        match g7_map_val_arr_kind($val) {
                            Err($m) { Err($m) }
                            Ok($vak) {
                                match g7_list_c_type($val) {
                                    Err($m) { Err($m) }
                                    Ok($vctype) {
                                        match g3_str_lower($key, $rv.state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($ks) {
                                                $base = $ks.state.ntmp
                                                $ci = "gi" ~ c_int($base)
                                                $cn = "gv" ~ c_int($base + 1)
                                                $kacc = g7_map_var_keys($rv.var)
                                                $vacc = g7_map_var_vals_typed($rv.var, $vctype)
                                                $lacc = g7_map_var_len($rv.var)
                                                $keepretain = g7_map_val_slot_keep_retain($val, $cn ~ "_vals[" ~ $cn ~ "_len]")
                                                $decls = "\tint64_t " ~ $ci ~ " = 0;\n\tconst char** " ~ $cn ~ "_keys = NULL;\n\t" ~ $vctype ~ "* " ~ $cn ~ "_vals = NULL;\n\tint64_t " ~ $cn ~ "_len = 0;\n"
                                                $body = "\t" ~ $cn ~ "_keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ $lacc ~ ");\n" ~
                                                    "\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ $lacc ~ ");\n" ~
                                                    "\t" ~ $cn ~ "_len = 0;\n" ~
                                                    "\tfor (" ~ $ci ~ " = 0; " ~ $ci ~ " < " ~ $lacc ~ "; " ~ $ci ~ " = guji_add(" ~ $ci ~ ", 1)) \{\n" ~
                                                    "\t\tif (!guji_str_equal(" ~ $kacc ~ "[" ~ $ci ~ "], " ~ $ks.tmp ~ ")) \{\n" ~
                                                    "\t\t\t" ~ $cn ~ "_keys[" ~ $cn ~ "_len] = " ~ $kacc ~ "[" ~ $ci ~ "];\n" ~
                                                    "\t\t\t" ~ $cn ~ "_vals[" ~ $cn ~ "_len] = " ~ $vacc ~ "[" ~ $ci ~ "];\n" ~
                                                    "\t\t\tguji_retain(" ~ $cn ~ "_keys[" ~ $cn ~ "_len]);\n" ~
                                                    $keepretain ~
                                                    "\t\t\t" ~ $cn ~ "_len = guji_add(" ~ $cn ~ "_len, 1);\n" ~
                                                    "\t\t}\n" ~
                                                    "\t}\n" ~
                                                    "\tguji_release(" ~ $ks.tmp ~ ");\n"
                                                $st2 = CgState(
                                                    interns: $ks.state.interns,
                                                    decls: $ks.state.decls ~ $decls,
                                                    body: $ks.state.body ~ $body ~ $rv.release,
                                                    nstr: $ks.state.nstr,
                                                    ntmp: $base + 2
                                                )
                                                Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMap($val), mutable: $mutable, borrowed: false, listlen: 0), $env)))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Dispatch a Map-annotated bind whose RHS is a call: `set`/`remove` in both the
# ordinary data-first and method spellings. Any other callee stays out of subset
# (there is no general map-returning-call bind path yet).
sub g7_map_set_remove_bind($val: CgKind, $mutable: Bool, $name: Str, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $callee {
        EName($fn) {
            if $fn == "set" {
                match cg_env_lookup_sub($env, "set") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprCons($vexpr, ExprNil))) { g7_map_set_bind_core($val, $mutable, $name, $recv, $key, $vexpr, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else if $fn == "remove" {
                match cg_env_lookup_sub($env, "remove") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprNil)) { g7_map_remove_bind_core($val, $mutable, $name, $recv, $key, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "set" {
                match $args {
                    ExprCons($key, ExprCons($vexpr, ExprNil)) { g7_map_set_bind_core($val, $mutable, $name, $recv, $key, $vexpr, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else if $method == "remove" {
                match $args {
                    ExprCons($key, ExprNil) { g7_map_remove_bind_core($val, $mutable, $name, $recv, $key, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_map_bindout_to_value($val: CgKind, $bo: BindOut): Result[CgValueOut, Str] {
    match $bo.env {
        CgEnvCons($var, $rest) {
            match $var.kind {
                CgMap($actual) {
                    if cgkind_eq($actual, $val) {
                        $tmp = g4_value_tmp(CgMap($val), $bo.state.ntmp)
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $bo.state.interns,
                                decls: $bo.state.decls ~ "\tguji_map_t " ~ $tmp ~ " = \{0};\n",
                                body: $bo.state.body ~
                                    "\t" ~ $tmp ~ ".keys = " ~ $var.cname ~ "_keys;\n" ~
                                    "\t" ~ $tmp ~ ".vals = (void*)" ~ $var.cname ~ "_vals;\n" ~
                                    "\t" ~ $tmp ~ ".len = " ~ $var.cname ~ "_len;\n" ~
                                    "\t" ~ $var.cname ~ "_keys = NULL;\n" ~
                                    "\t" ~ $var.cname ~ "_vals = NULL;\n" ~
                                    "\t" ~ $var.cname ~ "_len = 0;\n",
                                nstr: $bo.state.nstr,
                                ntmp: $bo.state.ntmp + 1
                            ),
                            c: $tmp
                        ))
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g7_map_set_remove_value($val: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $callee {
        EName($fn) {
            if $fn == "set" {
                match cg_env_lookup_sub($env, "set") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprCons($vexpr, ExprNil))) {
                                match g7_map_set_bind_core($val, false, "", $recv, $key, $vexpr, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($bo) { g7_map_bindout_to_value($val, $bo) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else if $fn == "remove" {
                match cg_env_lookup_sub($env, "remove") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($key, ExprNil)) {
                                match g7_map_remove_bind_core($val, false, "", $recv, $key, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($bo) { g7_map_bindout_to_value($val, $bo) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "set" {
                match $args {
                    ExprCons($key, ExprCons($vexpr, ExprNil)) {
                        match g7_map_set_bind_core($val, false, "", $recv, $key, $vexpr, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($bo) { g7_map_bindout_to_value($val, $bo) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else if $method == "remove" {
                match $args {
                    ExprCons($key, ExprNil) {
                        match g7_map_remove_bind_core($val, false, "", $recv, $key, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($bo) { g7_map_bindout_to_value($val, $bo) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower `print(%m)` (a map-binding read in Str context) to a Str temp holding the
# `guji_map_str` display string. The caller (g3_lower_print) prints + releases it.
sub g7_lower_map_display($var: CgVar, $val: CgKind, $state: CgState): Result[StrLower, Str] {
    match g7_map_val_arr_kind($val) {
        Err($m) { Err($m) }
        Ok($vak) {
            match g7_map_leaf($val) {
                Err($m) { Err($m) }
                Ok($leaf) {
                    $ti = c_int($state.ntmp)
                    $tmp = "gt" ~ $ti
                    $decl = "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n"
                    $body = "\t" ~ $tmp ~ " = guji_map_str((const char**)" ~ g7_map_var_keys($var) ~ ", (const void*)" ~ g7_map_var_vals($var) ~ ", " ~ g7_map_var_len($var) ~ ", " ~ $vak ~ ", " ~ $leaf ~ ");\n"
                    Ok(StrLower(
                        state: CgState(
                            interns: $state.interns,
                            decls: $state.decls ~ $decl,
                            body: $state.body ~ $body,
                            nstr: $state.nstr,
                            ntmp: $state.ntmp + 1
                        ),
                        tmp: $tmp
                    ))
                }
            }
        }
    }
}

# A `Map[Str, V]` binding from a map literal. Keys lower as Str owned refs
# (reusing the List[Str] element path) and are MOVED into the ARR_STR keys array;
# values lower under V and are MOVED into the value array. Each key/value pair is
# snapshotted before the next pair. The binding's C name is chosen from the
# POST-entry temp counter so an entry temp never collides with the array name.
sub g7_lower_map_bind($val: CgKind, $mutable: Bool, $name: Str, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $value {
        EMap($entries) {
            match g7_map_val_arr_kind($val) {
                Err($m) { Err($m) }
                Ok($vak) {
                    match g7_list_c_type($val) {
                        Err($m) { Err($m) }
                        Ok($vctype) {
                            match g7_lower_map_entry_temps($val, $entries, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($eo) {
                                    $cn = "gv" ~ c_int($eo.state.ntmp)
                                    $decls = "\tconst char** " ~ $cn ~ "_keys = NULL;\n\t" ~ $vctype ~ "* " ~ $cn ~ "_vals = NULL;\n\tint64_t " ~ $cn ~ "_len = 0;\n"
                                    $allocs = "\t" ~ $cn ~ "_keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ c_int($eo.count) ~ ");\n\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ c_int($eo.count) ~ ");\n"
                                    match $val {
                                        CgList($elem) {
                                            match g7_map_coll_move_temps($val, $cn ~ "_vals", $eo.vals, 0) {
                                                Err($m) { Err($m) }
                                                Ok($moves) {
                                                    $body = $eo.state.body ~ $allocs ~ g7_map_key_assigns($cn ~ "_keys", $eo.keys, 0) ~ $moves ~ "\t" ~ $cn ~ "_len = " ~ c_int($eo.count) ~ ";\n"
                                                    $st1 = CgState(interns: $eo.state.interns, decls: $eo.state.decls ~ $decls, body: $body, nstr: $eo.state.nstr, ntmp: $eo.state.ntmp + 1)
                                                    Ok(BindOut(state: $st1, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMap($val), mutable: $mutable, borrowed: false, listlen: $eo.count), $env)))
                                                }
                                            }
                                        }
                                        CgMap($inner) {
                                            match g7_map_coll_move_temps($val, $cn ~ "_vals", $eo.vals, 0) {
                                                Err($m) { Err($m) }
                                                Ok($moves) {
                                                    $body = $eo.state.body ~ $allocs ~ g7_map_key_assigns($cn ~ "_keys", $eo.keys, 0) ~ $moves ~ "\t" ~ $cn ~ "_len = " ~ c_int($eo.count) ~ ";\n"
                                                    $st1 = CgState(interns: $eo.state.interns, decls: $eo.state.decls ~ $decls, body: $body, nstr: $eo.state.nstr, ntmp: $eo.state.ntmp + 1)
                                                    Ok(BindOut(state: $st1, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMap($val), mutable: $mutable, borrowed: false, listlen: $eo.count), $env)))
                                                }
                                            }
                                        }
                                        _ {
                                            $assigns = g7_map_assigns($cn, $eo.keys, $eo.vals, 0) ~ "\t" ~ $cn ~ "_len = " ~ c_int($eo.count) ~ ";\n"
                                            $st2 = CgState(interns: $eo.state.interns, decls: $eo.state.decls ~ $decls, body: $eo.state.body ~ $allocs ~ $assigns, nstr: $eo.state.nstr, ntmp: $eo.state.ntmp + 1)
                                            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMap($val), mutable: $mutable, borrowed: false, listlen: $eo.count), $env)))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ECall($callee, $args) {
            match g7_map_set_remove_bind($val, $mutable, $name, $callee, $args, $state, $env) {
                Ok($bo) { Ok($bo) }
                Err($not_set_remove) { g7_lower_map_bind_from_value($val, $mutable, $name, $value, $state, $env) }
            }
        }
        # Non-literal RHS (EIndex `@m[0]`, EName `%c = %m`, field reads, …):
        # materialize an owned guji_map_t via g7_lower_map_value, then MOVE its
        # arrays into the named two-array binding. Expressions g7_lower_map_value
        # still declines (if/match) stay Err here.
        _ { g7_lower_map_bind_from_value($val, $mutable, $name, $value, $state, $env) }
    }
}

# ---- G7-c-2b: `Map[Str, V]` as a VALUE (the heap guji_map_t rep) ------------
# A map crossing a sub boundary (a return value, a value-returning call) is the
# runtime's single `guji_map_t` struct: `const char** keys`, `void* vals`,
# `int64_t len`, where keys is an owned ARR_STR and vals an owned ARR_SCALAR (or
# ARR_STR for Str values). This mirrors the list-value path (g7_lower_list_value)
# but with two parallel arrays instead of one.
#
# Map ARGUMENTS are deliberately NOT in subset: g5_param_kind rejects a `Map`
# parameter, so no program with a map-typed argument is ever lowered. This is
# required — the native oracle's map-argument codegen is buggy (it releases the
# freshly-allocated keys/vals arrays of the map value BEFORE passing it to the
# callee, then passes NULL pointers, which segfaults), so a map-argument program
# can never three-way agree. Map RETURNS are correct in the native oracle.

# Emit, for a guji_map_t value temp `$tmp`, the per-pair stores
# `<tmp>.keys[i] = <krval>; ((<vctype>*)<tmp>.vals)[i] = <vrval>;`. Keys are owned
# ARR_STR slots (immortal literals or retained refs from the element lowerer) that
# are MOVED in; the map's drop releases them at the end of its lifetime.
sub g7_map_value_assigns($tmp: Str, $vctype: Str, $krvals: StrList, $vrvals: StrList, $i: Int): Str {
    match $krvals {
        StrNil { "" }
        StrCons($kh, $kt) {
            match $vrvals {
                StrNil { "" }
                StrCons($vh, $vt) {
                    "\t" ~ $tmp ~ ".keys[" ~ c_int($i) ~ "] = " ~ $kh ~ ";\n\t((" ~ $vctype ~ "*)" ~ $tmp ~ ".vals)[" ~ c_int($i) ~ "] = " ~ $vh ~ ";\n" ~ g7_map_value_assigns($tmp, $vctype, $kt, $vt, $i + 1)
                }
            }
        }
    }
}

# Release a temporary guji_map_t value (its two heap arrays). Used after a map
# value is displayed/consumed. The ARR_STR keys drop cascades to each owned key;
# the value array's drop frees scalars or cascades through ARR_STR Str values.
sub g7_map_value_release($mv: Str): Str {
    "\tguji_release((const void*)" ~ $mv ~ ".keys);\n\t" ~ $mv ~ ".keys = NULL;\n\tguji_release((const void*)" ~ $mv ~ ".vals);\n\t" ~ $mv ~ ".vals = NULL;\n"
}

sub g7_lower_one_map_arg($val: CgKind, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match g7_lower_map_value($val, $arg, $state, $env) {
        Err($m) { Err($m) }
        Ok($mv) {
            Ok(CgArgsOut(state: $mv.state, args: $mv.c, releases: g7_map_value_release($mv.c)))
        }
    }
}

# Copy a map binding with COLLECTION values (List/Map rows) into an owned
# guji_map_t: retain both counted arrays (same-heap share). guji_copy_arr cannot
# recurse through nested GUJI_KIND_<T>_ARR leaves under List/Map vals.
# Collection-valued maps dispatch here; scalar maps keep the assign+retain loop.
sub g7_map_copy_from_var_deep($val: CgKind, $var: CgVar, $state: CgState): Result[CgValueOut, Str] {
    $tmp = g4_value_tmp(CgMap($val), $state.ntmp)
    Ok(CgValueOut(
        state: CgState(
            interns: $state.interns,
            decls: $state.decls ~ "\tguji_map_t " ~ $tmp ~ " = \{0};\n",
            body: $state.body ~
                "\t" ~ $tmp ~ ".len = " ~ g7_map_var_len($var) ~ ";\n" ~
                "\t" ~ $tmp ~ ".keys = (const char**)" ~ g7_map_var_keys($var) ~ ";\n" ~
                "\t" ~ $tmp ~ ".vals = " ~ g7_map_var_vals($var) ~ ";\n" ~
                "\tguji_retain((const void*)" ~ $tmp ~ ".keys);\n" ~
                "\tguji_retain(" ~ $tmp ~ ".vals);\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        ),
        c: $tmp
    ))
}

# Copy a two-array map binding into an owned guji_map_t value. The copy owns fresh
# key/value arrays; every key is retained, and Str values are retained too.
# Collection-valued maps dispatch to the deep-copy form above.
sub g7_lower_map_value_from_var($val: CgKind, $var: CgVar, $state: CgState): Result[CgValueOut, Str] {
    match $val {
        CgList($e) { g7_map_copy_from_var_deep($val, $var, $state) }
        CgMap($v) { g7_map_copy_from_var_deep($val, $var, $state) }
        _ { g7_lower_map_value_from_var_scalar($val, $var, $state) }
    }
}

sub g7_lower_map_value_from_var_scalar($val: CgKind, $var: CgVar, $state: CgState): Result[CgValueOut, Str] {
    match g7_map_val_arr_kind($val) {
        Err($m) { Err($m) }
        Ok($vak) {
            match g7_list_c_type($val) {
                Err($m) { Err($m) }
                Ok($vctype) {
                    $tmp = g4_value_tmp(CgMap($val), $state.ntmp)
                    $idx = "gi" ~ c_int($state.ntmp + 1)
                    $retain_vals = match $val {
                        CgStr { "\t\tguji_retain(((" ~ $vctype ~ "*)" ~ $tmp ~ ".vals)[" ~ $idx ~ "]);\n" }
                        _ { "" }
                    }
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $state.interns,
                            decls: $state.decls ~ "\tguji_map_t " ~ $tmp ~ " = \{0};\n\tint64_t " ~ $idx ~ " = 0;\n",
                            body: $state.body ~
                                "\t" ~ $tmp ~ ".len = " ~ g7_map_var_len($var) ~ ";\n" ~
                                "\t" ~ $tmp ~ ".keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ g7_map_var_len($var) ~ ");\n" ~
                                "\t" ~ $tmp ~ ".vals = guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ g7_map_var_len($var) ~ ");\n" ~
                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ g7_map_var_len($var) ~ "; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                "\t\t" ~ $tmp ~ ".keys[" ~ $idx ~ "] = " ~ g7_map_var_keys($var) ~ "[" ~ $idx ~ "];\n" ~
                                "\t\tguji_retain(" ~ $tmp ~ ".keys[" ~ $idx ~ "]);\n" ~
                                "\t\t((" ~ $vctype ~ "*)" ~ $tmp ~ ".vals)[" ~ $idx ~ "] = " ~ g7_map_var_vals_typed($var, $vctype) ~ "[" ~ $idx ~ "];\n" ~
                                $retain_vals ~
                                "\t}\n",
                            nstr: $state.nstr,
                            ntmp: $state.ntmp + 2
                        ),
                        c: $tmp
                    ))
                }
            }
        }
    }
}

sub g7_lower_map_bind_from_value($val: CgKind, $mutable: Bool, $name: Str, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g7_list_c_type($val) {
        Err($m) { Err($m) }
        Ok($vctype) {
            match g7_lower_map_value($val, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($mv) {
                    $cn = "gv" ~ c_int($mv.state.ntmp)
                    $decls = "\tconst char** " ~ $cn ~ "_keys = NULL;\n\t" ~ $vctype ~ "* " ~ $cn ~ "_vals = NULL;\n\tint64_t " ~ $cn ~ "_len = 0;\n"
                    $body = "\t" ~ $cn ~ "_keys = " ~ $mv.c ~ ".keys;\n\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)" ~ $mv.c ~ ".vals;\n\t" ~ $cn ~ "_len = " ~ $mv.c ~ ".len;\n\t" ~ $mv.c ~ ".keys = NULL;\n\t" ~ $mv.c ~ ".vals = NULL;\n"
                    Ok(BindOut(
                        state: CgState(
                            interns: $mv.state.interns,
                            decls: $mv.state.decls ~ $decls,
                            body: $mv.state.body ~ $body,
                            nstr: $mv.state.nstr,
                            ntmp: $mv.state.ntmp + 1
                        ),
                        env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMap($val), mutable: $mutable, borrowed: false, listlen: 0), $env)
                    ))
                }
            }
        }
    }
}

# Lower a map literal to an owned guji_map_t value temp. Keys lower as Str owned
# refs (reusing the List[Str] element path) and are MOVED into the ARR_STR keys
# array; values lower under V and are MOVED into the value array. This is the
# value analogue of g7_lower_map_bind (which targets two NAMED arrays); here the
# arrays hang off a single `gmvN` struct so the map can be returned by value.
# An empty literal yields length-0 arrays, exactly like the empty-map binding.
sub g7_lower_map_literal_value($val: CgKind, $entries: MapEntryList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g7_map_val_arr_kind($val) {
        Err($m) { Err($m) }
        Ok($vak) {
            match g7_list_c_type($val) {
                Err($m) { Err($m) }
                Ok($vctype) {
                    match g7_lower_map_entry_temps($val, $entries, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($eo) {
                            $tmp = g4_value_tmp(CgMap($val), $eo.state.ntmp)
                            $decl = "\tguji_map_t " ~ $tmp ~ " = \{0};\n"
                            $alloc = "\t" ~ $tmp ~ ".len = " ~ c_int($eo.count) ~ ";\n\t" ~ $tmp ~ ".keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ c_int($eo.count) ~ ");\n\t" ~ $tmp ~ ".vals = guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ c_int($eo.count) ~ ");\n"
                            match $val {
                                CgList($elem) {
                                    match g7_map_coll_move_temps($val, $tmp ~ ".vals", $eo.vals, 0) {
                                        Err($m) { Err($m) }
                                        Ok($moves) {
                                            $body = $eo.state.body ~ $alloc ~ g7_map_key_assigns($tmp ~ ".keys", $eo.keys, 0) ~ $moves
                                            Ok(CgValueOut(state: CgState(interns: $eo.state.interns, decls: $eo.state.decls ~ $decl, body: $body, nstr: $eo.state.nstr, ntmp: $eo.state.ntmp + 1), c: $tmp))
                                        }
                                    }
                                }
                                CgMap($inner) {
                                    match g7_map_coll_move_temps($val, $tmp ~ ".vals", $eo.vals, 0) {
                                        Err($m) { Err($m) }
                                        Ok($moves) {
                                            $body = $eo.state.body ~ $alloc ~ g7_map_key_assigns($tmp ~ ".keys", $eo.keys, 0) ~ $moves
                                            Ok(CgValueOut(state: CgState(interns: $eo.state.interns, decls: $eo.state.decls ~ $decl, body: $body, nstr: $eo.state.nstr, ntmp: $eo.state.ntmp + 1), c: $tmp))
                                        }
                                    }
                                }
                                _ {
                                    $assigns = g7_map_value_assigns($tmp, $vctype, $eo.keys, $eo.vals, 0)
                                    Ok(CgValueOut(state: CgState(interns: $eo.state.interns, decls: $eo.state.decls ~ $decl, body: $eo.state.body ~ $alloc ~ $assigns, nstr: $eo.state.nstr, ntmp: $eo.state.ntmp + 1), c: $tmp))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Lower a map-valued expression to an owned guji_map_t value temp. Control-flow
# values share one zeroed result struct and move the selected branch's owned map
# into it, matching the existing list and carrier lowering convention.
sub g7_lower_map_value($val: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EMap($entries) { g7_lower_map_literal_value($val, $entries, $state, $env) }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($var) {
                    match $var.kind {
                        CgMap($actual) {
                            if cgkind_eq($actual, $val) { g7_lower_map_value_from_var($val, $var, $state) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EIndex($obj, $idx) { g7_lower_index(CgMap($val), $obj, $idx, $state, $env) }
        ECall($callee, $args) {
            match g7_reduce_value(CgMap($val), $callee, $args, 2, $state, $env) {
                Ok($mv) { Ok($mv) }
                Err($not_reduce) {
                    match g7_map_set_remove_value($val, $callee, $args, $state, $env) {
                        Ok($mv) { Ok($mv) }
                        Err($not_set_remove) {
                            # Recv-carrier extraction (P8d-2c-3d-2b): `$ch.recv().unwrap()`
                            # and bound `$opt.unwrap()` yield an owned map before the
                            # general RMap call resolver runs (unwrap/expect are not user
                            # subs, so the resolver would decline them).
                            match g4_option_unwrap_map($val, $callee, $args, $state, $env) {
                                Ok($mv) { Ok($mv) }
                                Err($not_unwrap) { g5_call_value(RMap($val), $callee, $args, $state, $env) }
                            }
                        }
                    }
                }
            }
        }
        EField($obj, $name) { g8_lower_field_value(CgMap($val), $obj, $name, $state, $env) }
        EIf($cond, $then, $elifs, $els) { g4_lower_if_value(CgMap($val), $cond, $then, $elifs, $els, $state, $env) }
        EMatch($subject, $arms) { g6_lower_match(CgMap($val), $subject, $arms, $state, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# If `$callee($args)` resolves to a user sub whose return kind is `Map[Str, V]`,
# return Some(V); else None. Used by the print path to route a map-returning call
# to the map-value display (rather than the Str-returning-call path).
sub g7_call_map_kind($callee: Expr, $args: ExprList, $env: CgEnv): Option[CgKind] {
    match g5_resolve_call_target($callee, $args, $env) {
        Err($m) {
            match g5_fn_arg_kind($callee, $env) {
                Ok($fk) {
                    match $fk {
                        CgFn($p, $r) {
                            match $r {
                                RMap($v) { Some($v) }
                                _ { None }
                            }
                        }
                        _ { None }
                    }
                }
                Err($fm) { None }
            }
        }
        Ok($target) {
            match $target.sig.ret {
                RMap($v) { Some($v) }
                _ { None }
            }
        }
    }
}

# Lower `print(<map-valued expr>)`: build the map value, render it with the
# runtime `guji_map_str` (sorts keys at display time, returns an owned Str), then
# release the temporary map value's two arrays. Returns the display-Str temp; the
# print path (g3_lower_print) prints + releases it. Releasing the source map after
# building the display string is safe — guji_map_str copies the rendered text.
sub g7_lower_map_value_display($val: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g7_map_val_arr_kind($val) {
        Err($m) { Err($m) }
        Ok($vak) {
            match g7_map_leaf($val) {
                Err($m) { Err($m) }
                Ok($leaf) {
                    match g4_lower_value(CgMap($val), $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($mv) {
                            $st = $mv.state
                            $tmp = "gt" ~ c_int($st.ntmp)
                            $decl = "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n"
                            $body = "\t" ~ $tmp ~ " = guji_map_str((const char**)" ~ $mv.c ~ ".keys, (const void*)" ~ $mv.c ~ ".vals, " ~ $mv.c ~ ".len, " ~ $vak ~ ", " ~ $leaf ~ ");\n" ~ g7_map_value_release($mv.c)
                            Ok(StrLower(
                                state: CgState(
                                    interns: $st.interns,
                                    decls: $st.decls ~ $decl,
                                    body: $st.body ~ $body,
                                    nstr: $st.nstr,
                                    ntmp: $st.ntmp + 1
                                ),
                                tmp: $tmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g7_lower_map_display_expr_generic($value: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g7_map_receiver_var($value, $env) {
        Ok($var) {
            match $var.kind {
                CgMap($val) { g7_lower_map_display($var, $val, $state) }
                _ { Err(g3_unsupported()) }
            }
        }
        Err($m) {
            match $value {
                ECall($callee, $args) {
                    match g7_call_map_kind($callee, $args, $env) {
                        Some($mv) { g7_lower_map_value_display($mv, $value, $state, $env) }
                        None { Err(g3_unsupported()) }
                    }
                }
                EIndex($obj, $idx) {
                    match g7_map_val_kind_from_value($value, $env) {
                        Ok($mv) { g7_lower_map_value_display($mv, $value, $state, $env) }
                        Err($mm) { Err($mm) }
                    }
                }
                EMap($entries) {
                    match g7_map_val_kind_from_value($value, $env) {
                        Ok($mv) { g7_lower_map_value_display($mv, $value, $state, $env) }
                        Err($mm) { Err($mm) }
                    }
                }
                EIf($cond, $then, $elifs, $els) {
                    match g7_map_val_kind_from_value($value, $env) {
                        Ok($mv) { g7_lower_map_value_display($mv, $value, $state, $env) }
                        Err($mm) { Err($mm) }
                    }
                }
                EMatch($subject, $arms) {
                    match g7_map_val_kind_from_value($value, $env) {
                        Ok($mv) { g7_lower_map_value_display($mv, $value, $state, $env) }
                        Err($mm) { Err($mm) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g7_lower_nominal_map_display($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g_nominal_collection_display_name($kind, $env) {
        None { Err(g3_unsupported()) }
        Some($name) {
            match g4_lower_value(CgMap($kind), $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($mv) {
                    $st = $mv.state
                    $tmp = "gt" ~ c_int($st.ntmp)
                    Ok(StrLower(
                        state: CgState(
                            interns: $st.interns,
                            decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                            body: $st.body ~ "\t" ~ $tmp ~ " = guji_map_str_" ~ $name ~ "((const char**)" ~ $mv.c ~ ".keys, (const " ~ $name ~ "*)" ~ $mv.c ~ ".vals, " ~ $mv.c ~ ".len);\n" ~ g7_map_value_release($mv.c),
                            nstr: $st.nstr,
                            ntmp: $st.ntmp + 1
                        ),
                        tmp: $tmp
                    ))
                }
            }
        }
    }
}

sub g7_lower_map_display_expr($value: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g7_map_val_kind_from_value($value, $env) {
        Ok(CgClass($name)) { g7_lower_nominal_map_display(CgClass($name), $value, $state, $env) }
        Ok(CgEnum($name)) { g7_lower_nominal_map_display(CgEnum($name), $value, $state, $env) }
        _ { g7_lower_map_display_expr_generic($value, $state, $env) }
    }
}

# The GUJI_LEAF_* tag the runtime display recursion needs to render ARR_SCALAR
# slots — the one classification the KIND tags cannot encode (native
# displayLeafKindFromType). The leaf is the INNERMOST scalar kind at any nesting
# depth; a Str leaf passes GUJI_LEAF_INT exactly like native's leafKindMacro
# default (ARR_STR slots carry their own kind, so the leaf tag is never read).
sub g7_display_leaf($elem: CgKind): Result[Str, Str] {
    g7_map_leaf($elem)
}

# I5g2: program-specific GUJI_KIND_<Type>_ARR values cannot pass through the
# scalar runtime collection walker. Resolve the generated nominal collection
# helper only when the element's own display helper is available.
sub g_nominal_collection_display_name($kind: CgKind, $env: CgEnv): Option[Str] {
    match $kind {
        CgClass($name) {
            match cg_env_lookup_class($env, $name) {
                Some($info) { if g8_class_display_supported($info.fields) { Some($name) } else { None } }
                None { None }
            }
        }
        CgEnum($name) {
            match cg_env_lookup_enum($env, $name) {
                Some($info) { if g6e_enum_display_supported($info.variants) { Some($name) } else { None } }
                None { None }
            }
        }
        _ { None }
    }
}

sub g7_lower_nominal_list_display($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g_nominal_collection_display_name($kind, $env) {
        None { Err(g3_unsupported()) }
        Some($name) {
            match g7_lower_list_value($kind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($lv) {
                    $st = $lv.state
                    $tmp = "gt" ~ c_int($st.ntmp)
                    Ok(StrLower(
                        state: CgState(
                            interns: $st.interns,
                            decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                            body: $st.body ~ "\t" ~ $tmp ~ " = guji_list_str_" ~ $name ~ "((const " ~ $name ~ "*)" ~ $lv.c ~ ".data, " ~ $lv.c ~ ".len);\n" ~ g7_slice_release($lv.c),
                            nstr: $st.nstr,
                            ntmp: $st.ntmp + 1
                        ),
                        tmp: $tmp
                    ))
                }
            }
        }
    }
}

# Lower a LIST-valued expression in Str/display position (`print(@xs)`,
# `note(@xs)`, `"{ @xs }"`, `print(sort(@xs))`, `print([1, 2])`) to the display
# Str: materialize the list value to an OWNED slice (the sum/reverse deep-copy
# convention — display is a pure read, so the copy is behavior-identical to
# native's borrowed ref), render it with the runtime `guji_list_str` (the SAME
# ARR_* KIND-tag recursion `guji build` emits — nested rows recurse through
# GUJI_KIND_ARR_SLICE with no per-shape code), then release the materialized
# slice. Lists of displayable classes/enums use their generated nominal walker.
# The caller owns the returned display-Str temp.
sub g7_lower_list_display($value: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g7_list_kind_from_value($value, $env) {
        Err($m) { Err($m) }
        Ok($elem) {
            match $elem {
                CgClass($name) { g7_lower_nominal_list_display(CgClass($name), $value, $state, $env) }
                CgEnum($name) { g7_lower_nominal_list_display(CgEnum($name), $value, $state, $env) }
                _ {
                    match g7_list_arr_kind($elem) {
                        Err($m) { Err($m) }
                        Ok($ak) {
                            match g7_display_leaf($elem) {
                                Err($m) { Err($m) }
                                Ok($leaf) {
                                    match g7_lower_list_value($elem, $value, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($lv) {
                                            $st = $lv.state
                                            $tmp = "gt" ~ c_int($st.ntmp)
                                            $decl = "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n"
                                            $body = "\t" ~ $tmp ~ " = guji_list_str((const void*)" ~ $lv.c ~ ".data, " ~ $lv.c ~ ".len, " ~ $ak ~ ", " ~ $leaf ~ ");\n" ~ g7_slice_release($lv.c)
                                            Ok(StrLower(
                                                state: CgState(
                                                    interns: $st.interns,
                                                    decls: $st.decls ~ $decl,
                                                    body: $st.body ~ $body,
                                                    nstr: $st.nstr,
                                                    ntmp: $st.ntmp + 1
                                                ),
                                                tmp: $tmp
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# ---- Collection-valued map reassignment support ----------------------------
# A `mut Map[Str, List[V]]` / `mut Map[Str, Map[Str, V]]` binding reassigned to a
# NEW map literal needs the collection twin of the scalar reassign copy loop.
# Native saves the old arrays, allocates fresh ones, materialises the literal into
# them, then releases the old arrays LAST. Selfhost mirrors that snapshot-safe
# order: snapshot each new entry as key then owned row before advancing (so any
# read of the old binding completes before it is released), release the old two
# arrays, reallocate to the new length, then MOVE each key temp + row temp into
# the fresh slots. Moving nulls each row temp so the counted ARR_SLICE/ARR_MAP
# backing owns the sole release.

# Emit the per-slot MOVE of each materialised row temp into the freshly allocated
# value array, nulling the temp so the array owns the row.
sub g7_map_coll_move_temps($val: CgKind, $vals: Str, $names: StrList, $i: Int): Result[Str, Str] {
    match $names {
        StrNil { Ok("") }
        StrCons($h, $t) {
            match g7_map_coll_move_temps($val, $vals, $t, $i + 1) {
                Err($m) { Err($m) }
                Ok($rest) {
                    match $val {
                        CgList($elem) {
                            Ok("\t((guji_slice_t*)" ~ $vals ~ ")[" ~ c_int($i) ~ "] = " ~ $h ~ ";\n\t" ~ $h ~ ".data = NULL;\n\t" ~ $h ~ ".len = 0;\n" ~ $rest)
                        }
                        CgMap($inner) {
                            Ok("\t((guji_map_t*)" ~ $vals ~ ")[" ~ c_int($i) ~ "] = " ~ $h ~ ";\n\t" ~ $h ~ ".keys = NULL;\n\t" ~ $h ~ ".vals = NULL;\n" ~ $rest)
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# The collection-valued arm of g7_lower_map_reassign: $eo already holds each
# key followed by its corresponding owned row temp in source evaluation order.
# Release-old / realloc / assign-keys / move-rows stays snapshot-safe.
sub g7_lower_map_reassign_collection($var: CgVar, $val: CgKind, $vak: Str, $vctype: Str, $eo: MapEntryTemps, $env: CgEnv): Result[BindOut, Str] {
    match g7_map_coll_move_temps($val, $var.cname ~ "_vals", $eo.vals, 0) {
        Err($m) { Err($m) }
        Ok($moves) {
            $cn = $var.cname
            $release_old = g7_map_release($cn)
            $allocs = "\t" ~ $cn ~ "_keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ c_int($eo.count) ~ ");\n\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ c_int($eo.count) ~ ");\n"
            $key_assigns = g7_map_key_assigns($cn ~ "_keys", $eo.keys, 0) ~ "\t" ~ $cn ~ "_len = " ~ c_int($eo.count) ~ ";\n"
            $st2 = CgState(
                interns: $eo.state.interns,
                decls: $eo.state.decls,
                body: $eo.state.body ~ $release_old ~ $allocs ~ $key_assigns ~ $moves,
                nstr: $eo.state.nstr,
                ntmp: $eo.state.ntmp
            )
            Ok(BindOut(state: $st2, env: $env))
        }
    }
}

# ---- G7-c-2b-ii-b: whole-map reassignment (`%m = {...}`) ------------------
# A `mut`-declared `Map[Str, V]` binding (the two-parallel-heap-array form from
# g7_lower_map_bind: `<cn>_keys` / `<cn>_vals` / `<cn>_len`) may be reassigned to
# a NEW map literal of ANY length. Native reallocates both arrays to the new
# length (cc-wrapper capture: save the old arrays, `guji_arr_alloc` fresh ones,
# copy the literal in retaining keys + Str values, then release the old arrays and
# the literal temp), so a different length is safe — heap arrays have no fixed-size
# UB, unlike the scalar-list stack-array reassignment (G7-b-2).
#
# The selfhost path is simpler but observably identical: snapshot each new
# literal entry key-then-value in source order (so every read completes before
# any array is touched), RELEASE the old keys/vals arrays, REALLOCATE both to the
# new length, then MOVE each owned ref into a fresh slot and set `<cn>_len`.
# Each owned ref is moved in exactly as g7_lower_map_bind does it (an immortal
# literal releases to a no-op; a retained Str temp becomes owned by the array),
# and scope cleanup releases the latest arrays once via g7_map_release — so
# allocs and releases stay balanced across any number of reassignments.
#
# SUBSET: EMap literal RHS (scalar/Str via assigns; List/Map via collection
# materialise), OR any map-valued RHS g7_lower_map_value accepts — set/remove
# (self-rebind `%m = %m.set/remove`, fresh-literal `.set`, chained), another map
# binding, a map-returning call. Native's RC2.1 uniqueness in-place arm is an
# allocation optimization; the unconditional copy+steal path is observably
# identical (three-way) and keeps aliased maps intact because set/remove already
# retain into a fresh pair of arrays before this release. Borrowed / struct-form
# receivers (listlen < 0) stay out of subset — they are not mut two-array locals.
sub g7_lower_map_reassign_from_value($var: CgVar, $val: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    if $var.borrowed || $var.listlen < 0 {
        Err(g3_unsupported())
    } else {
        match g7_list_c_type($val) {
            Err($m) { Err($m) }
            Ok($vctype) {
                match g7_lower_map_value($val, $value, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($mv) {
                        $cn = $var.cname
                        $body = $mv.state.body ~
                            g7_map_release($cn) ~
                            "\t" ~ $cn ~ "_keys = (const char**)" ~ $mv.c ~ ".keys;\n" ~
                            "\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)" ~ $mv.c ~ ".vals;\n" ~
                            "\t" ~ $cn ~ "_len = " ~ $mv.c ~ ".len;\n" ~
                            "\t" ~ $mv.c ~ ".keys = NULL;\n" ~
                            "\t" ~ $mv.c ~ ".vals = NULL;\n" ~
                            "\t" ~ $mv.c ~ ".len = 0;\n"
                        Ok(BindOut(
                            state: CgState(
                                interns: $mv.state.interns,
                                decls: $mv.state.decls,
                                body: $body,
                                nstr: $mv.state.nstr,
                                ntmp: $mv.state.ntmp
                            ),
                            env: $env
                        ))
                    }
                }
            }
        }
    }
}

sub g7_lower_map_reassign($var: CgVar, $val: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $value {
        EMap($entries) {
            match g7_map_val_arr_kind($val) {
                Err($m) { Err($m) }
                Ok($vak) {
                    match g7_list_c_type($val) {
                        Err($m) { Err($m) }
                        Ok($vctype) {
                            match g7_lower_map_entry_temps($val, $entries, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($eo) {
                                    match $val {
                                        CgList($elem) { g7_lower_map_reassign_collection($var, $val, $vak, $vctype, $eo, $env) }
                                        CgMap($inner) { g7_lower_map_reassign_collection($var, $val, $vak, $vctype, $eo, $env) }
                                        _ {
                                            $cn = $var.cname
                                            $release_old = g7_map_release($cn)
                                            $allocs = "\t" ~ $cn ~ "_keys = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ c_int($eo.count) ~ ");\n\t" ~ $cn ~ "_vals = (" ~ $vctype ~ "*)guji_arr_alloc(" ~ $vak ~ ", sizeof(" ~ $vctype ~ "), " ~ c_int($eo.count) ~ ");\n"
                                            $assigns = g7_map_assigns($cn, $eo.keys, $eo.vals, 0) ~ "\t" ~ $cn ~ "_len = " ~ c_int($eo.count) ~ ";\n"
                                            $st2 = CgState(
                                                interns: $eo.state.interns,
                                                decls: $eo.state.decls,
                                                body: $eo.state.body ~ $release_old ~ $allocs ~ $assigns,
                                                nstr: $eo.state.nstr,
                                                ntmp: $eo.state.ntmp
                                            )
                                            Ok(BindOut(state: $st2, env: $env))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ { g7_lower_map_reassign_from_value($var, $val, $value, $state, $env) }
    }
}

# ---- G7-b-2 / P9-6b-9: whole-list reassignment (`@xs = [...]`) ------------
# A `mut`-declared scalar list binding (the fixed-size `<cn>_data[N]` stack-array
# form from g7_lower_list_bind, `listlen > 0`) may be reassigned to a NEW list
# literal whose length is at most N. The new elements are first snapshotted into
# fresh temps, then written into the existing array, then `<cn>_len` is set.
# Snapshotting before writing mirrors what `guji build` emits (it materialises
# the literal into a separate temp array, then copies it into the binding array)
# and is required for self-referencing reassignment like `@xs = [@xs[1], @xs[0]]`
# — every old element is read before any slot is overwritten.
#
# Native (cc-wrapper) sizes the binding array to the FIRST literal's length N and
# on reassignment copies only the new literal's prefix, then sets `_len`. A
# SHORTER non-empty literal is therefore safe (unused slots are ignored). A
# LONGER literal makes native's copy-loop write past the fixed array —
# stack-buffer-overflow UB — so longer stays out of subset. An empty RHS (`[]`)
# is also out of subset: native rejects rebinding a fixed-capacity list from a
# runtime-sized empty list. Owned-slice bindings (`listlen == 0`) and
# non-literal RHS still decline for fixed arrays. Owned-slice bindings
# (`listlen == 0`) instead lower any supported List value to a fresh owned slice,
# release the old backing array, and move the new slice into the binding.

# The threaded state plus the snapshot temp names, in element order.
class SnapOut {
    has $.state: CgState
    has $.names: StrList
}

# Snapshot each lowered element rvalue into its own fresh `gtN` temp (declared in
# `decls`, assigned in `body`), so every read of the old array completes before
# any write. Returns the new state and the temp names in order.
sub g7_snapshot_elems($ctype: Str, $rvals: StrList, $state: CgState): SnapOut {
    match $rvals {
        StrNil { SnapOut(state: $state, names: StrNil) }
        StrCons($h, $t) {
            $tmp = "gt" ~ c_int($state.ntmp)
            $st1 = CgState(
                interns: $state.interns,
                decls: $state.decls ~ "\t" ~ $ctype ~ " " ~ $tmp ~ " = 0;\n",
                body: $state.body ~ "\t" ~ $tmp ~ " = " ~ $h ~ ";\n",
                nstr: $state.nstr,
                ntmp: $state.ntmp + 1
            )
            $rest = g7_snapshot_elems($ctype, $t, $st1)
            SnapOut(state: $rest.state, names: StrCons($tmp, $rest.names))
        }
    }
}

# Emit `<cn>_data[i] = <temp>;` for each snapshot temp, in order.
sub g7_arr_writes_from_temps($cn: Str, $names: StrList, $i: Int): Str {
    match $names {
        StrNil { "" }
        StrCons($h, $t) {
            "\t" ~ $cn ~ "_data[" ~ c_int($i) ~ "] = " ~ $h ~ ";\n" ~ g7_arr_writes_from_temps($cn, $t, $i + 1)
        }
    }
}

# Reassign a heap-backed `guji_slice_t` local from any List-valued expression the
# ordinary value path supports (another local, a prelude transform, or a
# list-returning call). Lower the RHS before releasing the old binding so a
# self-rebind can still read it. Then move the owned result and clear its source
# temp: the binding is the sole owner of the RHS array after this point.
sub g7_lower_list_slice_reassign($var: CgVar, $elem: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g7_lower_list_value($elem, $value, $state, $env) {
        Err($m) { Err($m) }
        Ok($lv) {
            $st2 = CgState(
                interns: $lv.state.interns,
                decls: $lv.state.decls,
                body: $lv.state.body ~
                    g7_slice_release($var.cname) ~
                    "\t" ~ $var.cname ~ " = " ~ $lv.c ~ ";\n" ~
                    "\t" ~ $lv.c ~ ".data = NULL; " ~ $lv.c ~ ".len = 0;\n",
                nstr: $lv.state.nstr,
                ntmp: $lv.state.ntmp
            )
            Ok(BindOut(state: $st2, env: $env))
        }
    }
}

sub g7_lower_list_reassign($var: CgVar, $elem: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    if $var.listlen == 0 {
        g7_lower_list_slice_reassign($var, $elem, $value, $state, $env)
    } else {
        match $elem {
            CgStr { g7_lower_list_reassign_str($var, $value, $state, $env) }
            _ {
                match $value {
                    EList($items) {
                        match g7_scalar_c_type($elem) {
                            Err($m) { Err($m) }
                            Ok($ctype) {
                                match g7_lower_scalar_elems($elem, $items, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($lo) {
                                        # Non-empty and shorter-or-equal only.
                                        # Empty: native rejects fixed←runtime-sized.
                                        # Longer: overflows the fixed stack array.
                                        if $lo.count == 0 || $lo.count > $var.listlen {
                                            Err(g3_unsupported())
                                        } else {
                                            $snap = g7_snapshot_elems($ctype, $lo.rvals, $lo.state)
                                            $writes = g7_arr_writes_from_temps($var.cname, $snap.names, 0) ~ "\t" ~ $var.cname ~ "_len = " ~ c_int($lo.count) ~ ";\n"
                                            $st2 = CgState(
                                                interns: $snap.state.interns,
                                                decls: $snap.state.decls,
                                                body: $snap.state.body ~ $writes,
                                                nstr: $snap.state.nstr,
                                                ntmp: $snap.state.ntmp
                                            )
                                            Ok(BindOut(state: $st2, env: $env))
                                        }
                                    }
                                }
                            }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            }
        }
    }
}

# Whole-list reassignment for a `mut List[Str]` binding (heap ARR_STR `_data` /
# `_len` form from g7_lower_list_bind). Native reallocates on every rebind
# (cc-wrapper: save old pointer, `guji_arr_alloc` to the NEW length, retain-copy
# from the materialised literal temp, release old + temp), so shorter AND longer
# literals are safe — unlike scalar stack arrays. Selfhost mirrors the ownership
# with a simpler move path: lower each new element to an owned Str temp FIRST
# (snapshot-before-write; self-ref `@xs = [@xs[1], @xs[0]]` retains into temps),
# save the old `_data` pointer, allocate a fresh ARR_STR of the new length, MOVE
# each owned temp into a slot, set `_len`, then `guji_release` the old array
# (ARR_STR drop releases every previous element). Empty RHS stays out of subset
# (native rejects fixed←runtime-sized empty). Non-literal RHS still declines
# here; owned-slice bindings (`listlen == 0`) take `g7_lower_list_slice_reassign`.
sub g7_lower_list_reassign_str($var: CgVar, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $value {
        EList($items) {
            match g7_lower_scalar_elems(CgStr, $items, $state, $env) {
                Err($m) { Err($m) }
                Ok($lo) {
                    if $lo.count == 0 {
                        Err(g3_unsupported())
                    } else {
                        $cn = $var.cname
                        $old = "gt" ~ c_int($lo.state.ntmp)
                        $decls = $lo.state.decls ~ "\tconst char** " ~ $old ~ " = NULL;\n"
                        $body = $lo.state.body ~
                            "\t" ~ $old ~ " = " ~ $cn ~ "_data;\n" ~
                            "\t" ~ $cn ~ "_data = (const char**)guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*), " ~ c_int($lo.count) ~ ");\n" ~
                            g7_elem_assigns($cn, $lo.rvals, 0) ~
                            "\t" ~ $cn ~ "_len = " ~ c_int($lo.count) ~ ";\n" ~
                            "\tguji_release((const void*)" ~ $old ~ ");\n"
                        $st2 = CgState(
                            interns: $lo.state.interns,
                            decls: $decls,
                            body: $body,
                            nstr: $lo.state.nstr,
                            ntmp: $lo.state.ntmp + 1
                        )
                        Ok(BindOut(state: $st2, env: $env))
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# ---- G3b-b: Float literals + Float arithmetic ----------------------------
# Floats are NEVER the return value of `main` (it must be Unit/Int), so a Float
# is only ever observable through a comparison feeding an `if` condition. Float
# codegen mirrors EXACTLY what `guji build` emits: native C `double` arithmetic
# (NOT the overflow-checked guji_* Int helpers). + - * / are infix; `%` is
# fmod(); `**` is pow() — both from math.h, always linked via `-lm`. NaN, ±Inf
# and -0.0 therefore arise from identical IEEE-754 ops in the selfhost binary,
# the native binary, and the Go interpreter, so all three agree by construction.
sub g3b_float_binop_c($op: Str, $lc: Str, $rc: Str): Str {
    if $op == "%" {
        "fmod(" ~ $lc ~ ", " ~ $rc ~ ")"
    } else if $op == "**" {
        "pow(" ~ $lc ~ ", " ~ $rc ~ ")"
    } else {
        "((" ~ $lc ~ ") " ~ $op ~ " (" ~ $rc ~ "))"
    }
}

# Lower a Float-typed expression to a C `double` rvalue (pure — no statements).
# A Float literal lexeme is emitted with underscores stripped; the remaining
# text (`1.5`, `1e3`, `0.5`, …) is a valid C floating constant that strtod parses
# to the SAME IEEE-754 double Go's parser produced (round-to-nearest in both), so
# the value matches the oracle even though `guji build` prints a normalized form.
# guji has no implicit Int->Float, so a well-typed Float expression never holds an
# Int/Str/Bool operand; those arms reject defensively (out of subset).
sub g3b_float_rvalue($e: Expr, $env: CgEnv): Result[Str, Str] {
    match $e {
        EFloat($t) { Ok(split($t, "_").join("")) }
        EUnary($op, $x) {
            if $op == "-" {
                match g3b_float_rvalue($x, $env) {
                    Err($m) { Err($m) }
                    Ok($c) { Ok("(-(" ~ $c ~ "))") }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EBinary($op, $l, $r) {
            if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" {
                match g3b_float_rvalue($l, $env) {
                    Err($m) { Err($m) }
                    Ok($lc) {
                        match g3b_float_rvalue($r, $env) {
                            Err($m) { Err($m) }
                            Ok($rc) { Ok(g3b_float_binop_c($op, $lc, $rc)) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgFloat { Ok($v.cname) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        ECall($c, $a) {
            match g11_eval_float_literal_rvalue($c, $a, $env) {
                Some($rv) { Ok($rv) }
                None { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Stateful Float rvalue composition (G5b-b), mirroring g3_int_rvalue_state: a
# Float-typed operand that needs prep (a Float-returning call with Str arguments)
# can appear inside Float arithmetic. Pure expressions return state unchanged.
sub g3b_float_rvalue_state($e: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g3b_float_rvalue($e, $env) {
        Ok($rv) { Ok(CgValueOut(state: $state, c: $rv)) }
        Err($pure) {
            match $e {
                EUnary($op, $x) {
                    if $op == "-" {
                        match g3b_float_rvalue_state($x, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($v) { Ok(CgValueOut(state: $v.state, c: "(-(" ~ $v.c ~ "))")) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EBinary($op, $l, $r) {
                    if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" {
                        match g3b_float_rvalue_state($l, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($lv) {
                                match g3b_float_rvalue_state($r, $lv.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($rv) { Ok(CgValueOut(state: $rv.state, c: g3b_float_binop_c($op, $lv.c, $rv.c))) }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                ECall($c, $a) {
                    match g5_call_value(RFloat, $c, $a, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($m) {
                            match g5_fn_call_value(CgFloat, $c, $a, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($fm) {
                                    match g7_reduce_value(CgFloat, $c, $a, 0, $state, $env) {
                                        Ok($rv) { Ok($rv) }
                                        Err($rm) {
                                            match g7_sum_call(CgFloat, $c, $a, $state, $env) {
                                                Ok($sv) { Ok($sv) }
                                                Err($sm) {
                                                    match g7_minmax_call(CgFloat, $c, $a, $state, $env) {
                                                        Ok($mv) { Ok($mv) }
                                                        Err($mm) {
                                                            match g4_unwrap_or_value(CgFloat, $c, $a, $state, $env) {
                                                                Ok($uv) { Ok($uv) }
                                                                Err($um) {
                                                                    match g4_result_unwrap_or_value(CgFloat, $c, $a, $state, $env) {
                                                                        Ok($ruv) { Ok($ruv) }
                                                                        Err($rum) {
                                                                            match g4_result_unwrap_or_else_value(CgFloat, $c, $a, $state, $env) {
                                                                                Ok($ruev) { Ok($ruev) }
                                                                                Err($ruem) {
                                                                                    match g4_result_expect_value(CgFloat, $c, $a, $state, $env) {
                                                                                        Ok($rev) { Ok($rev) }
                                                                                        Err($rem) { g4_option_unwrap_value(CgFloat, $c, $a, $state, $env) }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EMatch($subj, $arms) { g6_lower_match(CgFloat, $subj, $arms, $state, $env) }
                EField($obj, $name) { g8_lower_field_value(CgFloat, $obj, $name, $state, $env) }
                EIndex($obj, $idx) { g7_lower_index(CgFloat, $obj, $idx, $state, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Escape a decoded guji Str literal for use inside a C string literal. The C
# header count is emitted as `sizeof("...") - 1`, so UTF-8 byte length is counted
# by the C compiler without a guji byte-count primitive.
sub g2_c_escape_char($c: Str): Str {
    if $c == "\\" {
        "\\\\"
    } else if $c == "\"" {
        "\\\""
    } else if $c == "\n" {
        "\\n"
    } else if $c == "\r" {
        "\\r"
    } else if $c == "\t" {
        "\\t"
    } else {
        $c
    }
}

sub g2_c_escape_chars(@chars: List[Str], $i: Int): Str {
    match get(@chars, $i) {
        None { "" }
        Some($c) { g2_c_escape_char($c) ~ g2_c_escape_chars(@chars, $i + 1) }
    }
}

sub g2_c_escape($s: Str): Str {
    g2_c_escape_chars(split($s, ""), 0)
}

sub g7_join_core($recv: Expr, $sep: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g7_lower_list_value(CgStr, $recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($src) {
            match g3_str_lower($sep, $src.state, $env) {
                Err($m) { Err($m) }
                Ok($sv) {
                    $res = "gt" ~ c_int($sv.state.ntmp)
                    $old = "gt" ~ c_int($sv.state.ntmp + 1)
                    $idx = "gi" ~ c_int($sv.state.ntmp + 2)
                    Ok(StrLower(
                        state: CgState(
                            interns: $sv.state.interns,
                            decls: $sv.state.decls ~
                                "\tconst char* " ~ $res ~ " = GUJI_EMPTY_STR;\n" ~
                                "\tconst char* " ~ $old ~ " = GUJI_EMPTY_STR;\n" ~
                                "\tint64_t " ~ $idx ~ " = 0;\n",
                            body: $sv.state.body ~
                                "\t" ~ $res ~ " = GUJI_EMPTY_STR;\n" ~
                                "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                "\t\tif (" ~ $idx ~ " > 0) \{ " ~ $old ~ " = " ~ $res ~ "; " ~ $res ~ " = guji_str_cat(" ~ $res ~ ", " ~ $sv.tmp ~ "); guji_release(" ~ $old ~ "); }\n" ~
                                "\t\t" ~ $old ~ " = " ~ $res ~ "; " ~ $res ~ " = guji_str_cat(" ~ $res ~ ", ((const char**)" ~ $src.c ~ ".data)[" ~ $idx ~ "]); guji_release(" ~ $old ~ ");\n" ~
                                "\t}\n" ~
                                "\tguji_release(" ~ $sv.tmp ~ ");\n" ~
                                g7_slice_release($src.c),
                            nstr: $sv.state.nstr,
                            ntmp: $sv.state.ntmp + 3
                        ),
                        tmp: $res
                    ))
                }
            }
        }
    }
}

sub g7_join_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match cg_env_lookup_sub($env, "join") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($fn) {
                    if $fn == "join" {
                        match $args {
                            ExprCons($recv, ExprCons($sep, ExprNil)) { g7_join_core($recv, $sep, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EField($recv, $method) {
                    if $method == "join" {
                        match $args {
                            ExprCons($sep, ExprNil) { g7_join_core($recv, $sep, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# The unary Str->Str string-prelude functions that `guji build` lowers through the
# same `strUnaryCall` helper (`codegen.go`): each emits `guji_<name>(<recv>)` over a
# borrowed Str receiver and returns a FRESH owned Str. The selfhost mirror lowers the
# receiver via `g3_str_lower` (an OWNED temp), calls `guji_<name>`, then releases the
# receiver — exactly the `~`-concat ownership shape (the helper reads, never consumes,
# its argument; releasing an immortal-literal receiver is a no-op).
sub g7_is_strunary($name: Str): Bool {
    $name == "lower" || $name == "upper" || $name == "trim"
}

sub g7_strunary_core($recv: Expr, $name: Str, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g3_str_lower($recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($rs) {
            $st = $rs.state
            $ti = c_int($st.ntmp)
            $tmp = "gt" ~ $ti
            $decl = "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n"
            $body = "\t" ~ $tmp ~ " = guji_" ~ $name ~ "(" ~ $rs.tmp ~ ");\n" ~
                "\tguji_release(" ~ $rs.tmp ~ ");\n"
            Ok(StrLower(
                state: CgState(
                    interns: $st.interns,
                    decls: $st.decls ~ $decl,
                    body: $st.body ~ $body,
                    nstr: $st.nstr,
                    ntmp: $st.ntmp + 1
                ),
                tmp: $tmp
            ))
        }
    }
}

# Lower a `lower`/`upper`/`trim` prelude call as a Str value, in both the ordinary
# (`lower($s)`) and method-style (`$s.lower()`) forms. A user sub that shadows the
# name keeps the prelude lowering OUT (the call routes to the user sub instead),
# matching the native `!defined` guard.
sub g7_strunary_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $callee {
        EName($fn) {
            if g7_is_strunary($fn) {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprNil) { g7_strunary_core($recv, $fn, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if g7_is_strunary($method) {
                match cg_env_lookup_sub($env, $method) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprNil { g7_strunary_core($recv, $method, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower a Str-typed expression, emitting statements that leave a fresh `gt` temp
# holding the result. Str-expr subset: a Str literal (including §12 `{ expr }`
# interpolation), `~` concatenation of Str exprs (§5.2), or a Str-valued `if`.
# Mirrors what `guji build` emits: each literal becomes a header-backed immortal
# `gs_N` static aliased into a temp; each concat calls guji_str_cat and releases
# both operand temps (releasing an immortal literal is a no-op), so the result temp
# owns exactly one reference, freed after use.
class StrBuild {
    has $.state: CgState
    has $.tmp: Str
    has $.present: Bool
}

# C08d: interpolation lowering that also threads the synthetic bindings created
# by retkind-aware `?` guards.  `found` distinguishes a genuinely hoisted string
# from an ordinary interpolation, which must stay on the established lowerer.
class QuestionInterpOut {
    has $.build: StrBuild
    has $.env: CgEnv
    has $.found: Bool
}

class InterpFlags {
    has $.open: Bool
    has $.escaped: Bool
}

sub g3_interp_flags(@chars: List[Str], $i: Int, $n: Int, $escaped: Bool): InterpFlags {
    if $i >= $n {
        InterpFlags(open: false, escaped: $escaped)
    } else {
        $c = at(@chars, $i)
        $nxt = at(@chars, $i + 1)
        if $c == "\\" && ($nxt == '{' || $nxt == '}' || $nxt == '$' || $nxt == '@' || $nxt == '%') {
            g3_interp_flags(@chars, $i + 2, $n, true)
        } else if $c == '{' {
            InterpFlags(open: true, escaped: $escaped)
        } else {
            g3_interp_flags(@chars, $i + 1, $n, $escaped)
        }
    }
}

sub g3_str_literal_lower($text: Str, $state: CgState): StrLower {
    $si = c_int($state.nstr)
    $ti = c_int($state.ntmp)
    $esc = g2_c_escape($text)
    $intern = 'static const struct { guji_obj_t h; char b[sizeof("' ~ $esc ~ '")]; } gs_' ~ $si ~ ' = { {0, GUJI_KIND_STR, GUJI_IMMORTAL, (int64_t)(sizeof("' ~ $esc ~ '") - 1)}, "' ~ $esc ~ '" };' ~ "\n"
    $decl = "\tconst char* gt" ~ $ti ~ " = GUJI_EMPTY_STR;\n"
    $body = "\tgt" ~ $ti ~ " = gs_" ~ $si ~ ".b;\n"
    StrLower(
        state: CgState(
            interns: $state.interns ~ $intern,
            decls: $state.decls ~ $decl,
            body: $state.body ~ $body,
            nstr: $state.nstr + 1,
            ntmp: $state.ntmp + 1
        ),
        tmp: "gt" ~ $ti
    )
}

sub g3_str_concat_tmps($left: Str, $right: StrLower): StrLower {
    $st = $right.state
    $ti = c_int($st.ntmp)
    $tmp = "gt" ~ $ti
    StrLower(
        state: CgState(
            interns: $st.interns,
            decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
            body: $st.body ~ "\t" ~ $tmp ~ " = guji_str_cat(" ~ $left ~ ", " ~ $right.tmp ~ ");\n" ~
                "\tguji_release(" ~ $right.tmp ~ ");\n" ~
                "\tguji_release(" ~ $left ~ ");\n",
            nstr: $st.nstr,
            ntmp: $st.ntmp + 1
        ),
        tmp: $tmp
    )
}

sub g3_str_build_append($b: StrBuild, $part: StrLower): StrBuild {
    if $b.present {
        $joined = g3_str_concat_tmps($b.tmp, $part)
        StrBuild(state: $joined.state, tmp: $joined.tmp, present: true)
    } else {
        StrBuild(state: $part.state, tmp: $part.tmp, present: true)
    }
}

# Find the `}` closing a `{ expr }` interpolation, starting just AFTER the
# opening `{`. Braces are BALANCED with a depth counter, mirroring native
# scanBraceExpr (codegen.go / eval.go): `{ match $d { Red { 0 } _ { 1 } } }` and
# `{ %m{$k} }` scan to the matching outer `}`, not the first one (the first-`}`
# scan MISCOMPILED nested-brace interpolations: the unparseable prefix was
# emitted literally and inner `{ 1 }` fragments evaluated on their own — found
# 2026-07-05). Like native, the counter is escape- and string-blind inside the
# braces: every `{`/`}` counts. None = unterminated (native rejects the program).
sub g3_interp_find_close(@chars: List[Str], $i: Int, $n: Int, $depth: Int, $acc: Str): Option[Scan] {
    if $i >= $n {
        None
    } else {
        match get(@chars, $i) {
            None { None }
            Some($c) {
                if $c == '}' {
                    if $depth == 0 {
                        Some(Scan(text: $acc, next: $i + 1, line: 0, col: 0))
                    } else {
                        g3_interp_find_close(@chars, $i + 1, $n, $depth - 1, $acc ~ $c)
                    }
                } else if $c == '{' {
                    g3_interp_find_close(@chars, $i + 1, $n, $depth + 1, $acc ~ $c)
                } else {
                    g3_interp_find_close(@chars, $i + 1, $n, $depth, $acc ~ $c)
                }
            }
        }
    }
}

sub g3_parse_interpolation_expr($src: Str): Option[Expr] {
    match parse_interpolation_expr($src) {
        Err($e) { None }
        Ok($expr) { Some($expr) }
    }
}

# §11.1 / I6a: display helpers for scalar Option carriers. Option[Str] was the
# first admitted shape (P6g-a); Int/Float/Bool share the same Some/None spelling.
sub g3_option_display_helper($kind: CgKind): Result[Str, Str] {
    match $kind {
        CgOptInt { Ok("guji_carrier_str_guji_opt_int") }
        CgOptFloat { Ok("guji_carrier_str_guji_opt_float") }
        CgOptBool { Ok("guji_carrier_str_guji_opt_bool") }
        CgOptStr { Ok("guji_carrier_str_guji_opt_str") }
        _ { Err(g3_unsupported()) }
    }
}

sub g3_option_display_one($kind: CgKind, $e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g3_option_display_helper($kind) {
        Err($m) { Err($m) }
        Ok($helper) {
            match g4_lower_value($kind, $e, $state, $env) {
                Err($m) { Err($m) }
                Ok($ov) {
                    # Move into a distinct carrier temp before render+release so a
                    # bound local stays reusable (Str retain already happened in
                    # g6_option_value; scalars own nothing).
                    $oi = c_int($ov.state.ntmp)
                    $si = c_int($ov.state.ntmp + 1)
                    $ot = "go" ~ $oi
                    $st = "gt" ~ $si
                    $ctype = g6_option_ctype($kind)
                    Ok(StrLower(
                        state: CgState(
                            interns: $ov.state.interns,
                            decls: $ov.state.decls ~ "\t" ~ $ctype ~ " " ~ $ot ~ " = \{0};\n" ~
                                "\tconst char* " ~ $st ~ " = GUJI_EMPTY_STR;\n",
                            body: $ov.state.body ~ "\t" ~ $ot ~ " = " ~ $ov.c ~ ";\n" ~
                                "\t" ~ $st ~ " = " ~ $helper ~ "(&" ~ $ot ~ ");\n" ~
                                g6_option_release($kind, $ot),
                            nstr: $ov.state.nstr,
                            ntmp: $ov.state.ntmp + 2
                        ),
                        tmp: $st
                    ))
                }
            }
        }
    }
}

sub g3_option_str_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    g3_option_display_one(CgOptStr, $e, $state, $env)
}

# Prefer the env-resolved carrier kind; fall back through scalar Option shapes so
# polymorphic `None` / fresh `Some(...)` still display when kind inference is weak.
sub g3_option_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g6_option_kind_from_value($e, $env) {
        Ok($kind) { g3_option_display_one($kind, $e, $state, $env) }
        Err($m0) {
            match g3_option_display_one(CgOptInt, $e, $state, $env) {
                Ok($sl) { Ok($sl) }
                Err($m1) {
                    match g3_option_display_one(CgOptFloat, $e, $state, $env) {
                        Ok($sl) { Ok($sl) }
                        Err($m2) {
                            match g3_option_display_one(CgOptBool, $e, $state, $env) {
                                Ok($sl) { Ok($sl) }
                                Err($m3) { g3_option_display_one(CgOptStr, $e, $state, $env) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# §11.1 / I6a: Result[T,E] display for scalar/Str T and E. Build the Ok(...)/Err(...)
# spelling inline (many T×E pairs); release a moved carrier temp afterward.
sub g3_result_payload_disp($kind: CgKind, $slot: Str): Result[Str, Str] {
    match $kind {
        CgInt {
            Ok("\t\{ const char* _ds = guji_int_str(" ~ $slot ~ "); guji_disp_puts(&b, _ds); guji_release(_ds); }\n")
        }
        CgFloat {
            Ok("\t\{ const char* _ds = guji_float_str(" ~ $slot ~ "); guji_disp_puts(&b, _ds); guji_release(_ds); }\n")
        }
        CgBool {
            Ok("\t\{ const char* _ds = guji_bool_str(" ~ $slot ~ "); guji_disp_puts(&b, _ds); guji_release(_ds); }\n")
        }
        CgStr {
            Ok("\tguji_disp_putn(&b, " ~ $slot ~ ", (size_t)GUJI_HDR(" ~ $slot ~ ")->count);\n")
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g3_result_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g6_result_kind_from_value($e, $env) {
        Err($m) { Err($m) }
        Ok($kind) {
            match $kind {
                CgRes($ok, $err) {
                    match g3_result_payload_disp($ok, "rv.ok") {
                        Err($m) { Err($m) }
                        Ok($ok_disp) {
                            match g3_result_payload_disp($err, "rv.err") {
                                Err($m) { Err($m) }
                                Ok($err_disp) {
                                    match g4_lower_value($kind, $e, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($rv) {
                                            $ri = c_int($rv.state.ntmp)
                                            $si = c_int($rv.state.ntmp + 1)
                                            $rt = "gr" ~ $ri
                                            $st = "gt" ~ $si
                                            $ctype = g6_result_ctype($kind)
                                            Ok(StrLower(
                                                state: CgState(
                                                    interns: $rv.state.interns,
                                                    decls: $rv.state.decls ~ "\t" ~ $ctype ~ " " ~ $rt ~ " = \{0};\n" ~
                                                        "\tconst char* " ~ $st ~ " = GUJI_EMPTY_STR;\n",
                                                    body: $rv.state.body ~ "\t" ~ $rt ~ " = " ~ $rv.c ~ ";\n" ~
                                                        "\t\{\n" ~
                                                        "\t\tguji_disp_buf b = \{0, 0, 0};\n" ~
                                                        "\t\t" ~ $ctype ~ " rv = " ~ $rt ~ ";\n" ~
                                                        "\t\tif (rv.tag == 0LL) \{\n" ~
                                                        "\t\t\tguji_disp_puts(&b, \"Ok(\");\n" ~
                                                        $ok_disp ~
                                                        "\t\t\tguji_disp_puts(&b, \")\");\n" ~
                                                        "\t\t} else \{\n" ~
                                                        "\t\t\tguji_disp_puts(&b, \"Err(\");\n" ~
                                                        $err_disp ~
                                                        "\t\t\tguji_disp_puts(&b, \")\");\n" ~
                                                        "\t\t}\n" ~
                                                        "\t\t" ~ $st ~ " = guji_disp_finish(&b);\n" ~
                                                        "\t}\n" ~
                                                        g6_result_release($kind, $rt),
                                                    nstr: $rv.state.nstr,
                                                    ntmp: $rv.state.ntmp + 2
                                                ),
                                                tmp: $st
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §7.4 function display. Evaluate the function-valued expression normally, drop
# a freshly produced closure environment after its opaque display value has been
# determined, and render the canonical `<function>` string. Bound function names
# are borrowed here; their binding remains the owner of the environment.
sub g3_fn_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g5_fn_arg_kind($e, $env) {
        Err($m) { Err($m) }
        Ok($kind) {
            match $kind {
                CgFn($p, $r) {
                    match g4_lower_value($kind, $e, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($fv) {
                            $release = if g5_fn_init_fresh($e) {
                                "\tguji_release(" ~ $fv.c ~ ".env);\n"
                            } else {
                                ""
                            }
                            $st = CgState(
                                interns: $fv.state.interns,
                                decls: $fv.state.decls,
                                body: $fv.state.body ~ $release,
                                nstr: $fv.state.nstr,
                                ntmp: $fv.state.ntmp
                            )
                            Ok(g3_str_literal_lower("<function>", $st))
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §17.2 channel display. Materialize an owned handle even for a bound name so
# the opaque spelling does not expose identity/state and cleanup is uniform for
# aliases and call-produced values.
sub g3_chan_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g11_chan_kind_from_value($e, $env) {
        Err($m) { Err($m) }
        Ok($kind) {
            match $kind {
                CgChan($el) {
                    match g11_chan_owned_value($el, $e, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cv) {
                            $next = CgState(
                                interns: $cv.state.interns,
                                decls: $cv.state.decls,
                                body: $cv.state.body ~ "\tguji_chan_release(" ~ $cv.c ~ ");\n",
                                nstr: $cv.state.nstr,
                                ntmp: $cv.state.ntmp
                            )
                            Ok(g3_str_literal_lower("<chan>", $next))
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15.4 Handle display. Materialize the expression through the ordinary owned
# Handle path so standard handles, bound aliases, and Result unwrap/expect calls
# all execute exactly once. The opaque display does not expose identity; drop the
# owned reference before returning the canonical legacy spelling.
sub g3_handle_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_handle_owned_value($e, $state, $env) {
        Err($m) { Err($m) }
        Ok($hv) {
            $next = CgState(
                interns: $hv.state.interns,
                decls: $hv.state.decls,
                body: $hv.state.body ~ "\tguji_release((const void*)" ~ $hv.c ~ ");\n",
                nstr: $hv.state.nstr,
                ntmp: $hv.state.ntmp
            )
            Ok(g3_str_literal_lower("<reader>", $next))
        }
    }
}

# §13 display of a first-class Regex VALUE: interp and native both render
# `/<pattern>/` in DISPLAY position only (print/note args + interpolation
# parts); concat (`~`) with a Regex is a type error in both oracles, so the
# slash wrap must NOT live in g3_str_lower (also the Str-kind inference probe —
# see RAW-OPTION-STR-DISPLAY). Native's shape (dumpc): guji_concat("/", v) then
# guji_concat(mid, "/"), releasing the middle temp. Our g3_str_lower tmps are
# OWNED (EName retains into a fresh temp), so the inner tmp is released too.
sub g3_regex_display_wrap($s: StrLower): StrLower {
    $st = $s.state
    $mid = "gt" ~ c_int($st.ntmp)
    $out = "gt" ~ c_int($st.ntmp + 1)
    StrLower(
        state: CgState(
            interns: $st.interns,
            decls: $st.decls ~ "\tconst char* " ~ $mid ~ " = GUJI_EMPTY_STR;\n" ~
                "\tconst char* " ~ $out ~ " = GUJI_EMPTY_STR;\n",
            body: $st.body ~ "\t" ~ $mid ~ " = guji_concat(\"/\", " ~ $s.tmp ~ ");\n" ~
                "\t" ~ $out ~ " = guji_concat(" ~ $mid ~ ", \"/\");\n" ~
                "\tguji_release(" ~ $mid ~ ");\n" ~
                "\tguji_release(" ~ $s.tmp ~ ");\n",
            nstr: $st.nstr,
            ntmp: $st.ntmp + 2
        ),
        tmp: $out
    )
}

sub g3_display_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    if g6_expr_is_regex_val($e, $env) {
        match g3_str_lower($e, $state, $env) {
            Err($m) { Err($m) }
            Ok($s) { Ok(g3_regex_display_wrap($s)) }
        }
    } else {
        g3_display_lower_plain($e, $state, $env)
    }
}

sub g3_display_lower_plain($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g3_handle_display_lower($e, $state, $env) {
        Ok($hl) { Ok($hl) }
        Err($mh) { g3_display_lower_nonhandle($e, $state, $env) }
    }
}

sub g3_display_lower_nonhandle($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g3_str_lower($e, $state, $env) {
        Ok($s) { Ok($s) }
        Err($ms) {
            match g4_lower_value(CgInt, $e, $state, $env) {
                Ok($iv) {
                    $ti = c_int($iv.state.ntmp)
                    $tmp = "gt" ~ $ti
                    Ok(StrLower(
                        state: CgState(
                            interns: $iv.state.interns,
                            decls: $iv.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                            body: $iv.state.body ~ "\t" ~ $tmp ~ " = guji_int_str(" ~ $iv.c ~ ");\n",
                            nstr: $iv.state.nstr,
                            ntmp: $iv.state.ntmp + 1
                        ),
                        tmp: $tmp
                    ))
                }
                Err($mi) {
                    match g4_lower_value(CgFloat, $e, $state, $env) {
                        Ok($fv) {
                            $ti = c_int($fv.state.ntmp)
                            $tmp = "gt" ~ $ti
                            Ok(StrLower(
                                state: CgState(
                                    interns: $fv.state.interns,
                                    decls: $fv.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                    body: $fv.state.body ~ "\t" ~ $tmp ~ " = guji_float_str(" ~ $fv.c ~ ");\n",
                                    nstr: $fv.state.nstr,
                                    ntmp: $fv.state.ntmp + 1
                                ),
                                tmp: $tmp
                            ))
                        }
                        Err($mf) {
                            match g4_lower_value(CgBool, $e, $state, $env) {
                                Ok($bv) {
                                    $ti = c_int($bv.state.ntmp)
                                    $tmp = "gt" ~ $ti
                                    Ok(StrLower(
                                        state: CgState(
                                            interns: $bv.state.interns,
                                            decls: $bv.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                            body: $bv.state.body ~ "\t" ~ $tmp ~ " = guji_bool_str(" ~ $bv.c ~ ");\n",
                                            nstr: $bv.state.nstr,
                                            ntmp: $bv.state.ntmp + 1
                                        ),
                                        tmp: $tmp
                                    ))
                                }
                                Err($mb) {
                                    match g4_lower_value(CgUnit, $e, $state, $env) {
                                        Ok($uv) { Ok(g3_str_literal_lower("()", $uv.state)) }
                                        Err($mu) {
                                            match g3_fn_display_lower($e, $state, $env) {
                                                Ok($fl) { Ok($fl) }
                                                Err($mfn) {
                                                    match g3_chan_display_lower($e, $state, $env) {
                                                        Ok($chl) { Ok($chl) }
                                                        Err($mch) {
                                                    match g3_option_display_lower($e, $state, $env) {
                                                        Ok($ol) { Ok($ol) }
                                                        Err($mo) {
                                                    match g3_result_display_lower($e, $state, $env) {
                                                        Ok($rl) { Ok($rl) }
                                                        Err($mr) {
                                                    match g8_class_display_lower($e, $state, $env) {
                                                        Ok($cl) { Ok($cl) }
                                                        Err($mc) {
                                                            match g6e_enum_display_lower($e, $state, $env) {
                                                                Ok($el) { Ok($el) }
                                                                Err($me) {
                                                                    # Interpolated collection values render only
                                                                    # in this display position; keep them out of
                                                                    # g3_str_lower so kind probes never classify a
                                                                    # collection as a Str element.
                                                                    match g7_lower_list_display($e, $state, $env) {
                                                                        Err($md) {
                                                                            match g7_lower_map_display_expr($e, $state, $env) {
                                                                                Err($mm) { Err(g3_unsupported()) }
                                                                                Ok($ml) { Ok($ml) }
                                                                            }
                                                                        }
                                                                        Ok($dl) { Ok($dl) }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                        }
                                                    }
                                                        }
                                                    }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g3_interp_finish_chunk($chunk: Str, $b: StrBuild): StrBuild {
    if $chunk == "" {
        $b
    } else {
        g3_str_build_append($b, g3_str_literal_lower($chunk, $b.state))
    }
}

sub g3_interp_bare_sigil_part($name: Str, $b: StrBuild, $env: CgEnv): Result[StrBuild, Str] {
    match g3_display_lower(EName($name), $b.state, $env) {
        Err($m) { Err($m) }
        Ok($part) { Ok(g3_str_build_append($b, $part)) }
    }
}

sub g3_interp_parts(@chars: List[Str], $i: Int, $n: Int, $chunk: Str, $b: StrBuild, $env: CgEnv): Result[StrBuild, Str] {
    if $i >= $n {
        Ok(g3_interp_finish_chunk($chunk, $b))
    } else {
        match get(@chars, $i) {
            None { Ok(g3_interp_finish_chunk($chunk, $b)) }
            Some($c) {
                if $c == "\\" && at(@chars, $i + 1) == '{' {
                    # `\{` -> literal `{` (matches the Go lexer's `\{` -> `{`).
                    g3_interp_parts(@chars, $i + 2, $n, $chunk ~ '{', $b, $env)
                } else if $c == "\\" && at(@chars, $i + 1) == '}' {
                    # `\}` -> backslash+`}` verbatim (the Go lexer has no `}` escape,
                    # so it keeps both chars). Keeping the backslash matches interp.
                    g3_interp_parts(@chars, $i + 2, $n, $chunk ~ "\\" ~ '}', $b, $env)
                } else if $c == "\\" && (at(@chars, $i + 1) == '$' || at(@chars, $i + 1) == '@' || at(@chars, $i + 1) == '%') {
                    # Escaped sigils are literal sigil characters, not binding
                    # interpolation. The lexer keeps the backslash marker so this
                    # branch can distinguish `\$x` from `$x`.
                    g3_interp_parts(@chars, $i + 2, $n, $chunk ~ at(@chars, $i + 1), $b, $env)
                } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start(at(@chars, $i + 1)) {
                    # BARE sigil interpolation (`"got $x"` with no braces).
                    # Mirror native scanSigilName: consume the whole sigil-name,
                    # display-lower that binding, and leave a lone sigil literal.
                    $run = take_ident(@chars, $i + 1, $c)
                    $b1 = g3_interp_finish_chunk($chunk, $b)
                    match g3_interp_bare_sigil_part($run.text, $b1, $env) {
                        Err($m) { Err($m) }
                        Ok($b2) { g3_interp_parts(@chars, $run.next, $n, "", $b2, $env) }
                    }
                } else if $c == '{' {
                    # Native REJECTS an unterminated `{` and an unparseable
                    # interpolation body (`guji build`: "unterminated {
                    # interpolation in string" / "in interpolation ...: parse
                    # error"; interp errors at runtime). Emitting the text
                    # literally instead would MISCOMPILE relative to native, so
                    # both shapes DECLINE (rc 4) — never a silent divergence.
                    match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                        None { Err(g3_unsupported()) }
                        Some($scan) {
                            match g3_parse_interpolation_expr($scan.text) {
                                None { Err(g3_unsupported()) }
                                Some($expr) {
                                    $b1 = g3_interp_finish_chunk($chunk, $b)
                                    match g3_display_lower($expr, $b1.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($part) {
                                            g3_interp_parts(@chars, $scan.next, $n, "", g3_str_build_append($b1, $part), $env)
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else {
                    g3_interp_parts(@chars, $i + 1, $n, $chunk ~ $c, $b, $env)
                }
            }
        }
    }
}

# True when the decoded text contains a BARE sigil interpolation (`$x`/`@xs`/
# `%m` outside braces — native scanSigilName: a sigil char directly followed by
# an identifier start). Escaped sigils (`\$x`, `\@xs`, `\%m`) are skipped because
# decode_escape keeps the backslash marker until g3_interp_parts consumes it.
sub g3_text_has_bare_sigil(@chars: List[Str], $i: Int, $n: Int): Bool {
    if $i >= $n {
        false
    } else {
        $c = at(@chars, $i)
        $nxt = at(@chars, $i + 1)
        if $c == "\\" && ($nxt == '$' || $nxt == '@' || $nxt == '%' || $nxt == '{' || $nxt == '}') {
            g3_text_has_bare_sigil(@chars, $i + 2, $n)
        } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start($nxt) {
            true
        } else {
            g3_text_has_bare_sigil(@chars, $i + 1, $n)
        }
    }
}

sub g3_str_has_bare_sigil($text: Str): Bool {
    if has_char($text, '$') || has_char($text, '@') || has_char($text, '%') {
        @chars = split($text, "")
        g3_text_has_bare_sigil(@chars, 0, @chars.count())
    } else {
        false
    }
}

sub g3_interp_str_lower($text: Str, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    @chars = split($text, "")
    $n = @chars.count()
    $flags = g3_interp_flags(@chars, 0, $n, false)
    $has_sigil = g3_str_has_bare_sigil($text)
    if !$flags.open && !$flags.escaped && !$has_sigil {
        Ok(g3_str_literal_lower($text, $state))
    } else {
        if $flags.open {
            match g3_interp_parts(@chars, 0, $n, "", StrBuild(state: $state, tmp: "", present: false), $env) {
                Err($m) { Err($m) }
                Ok($b) {
                    if $b.present {
                        Ok(StrLower(state: $b.state, tmp: $b.tmp))
                    } else {
                        Ok(g3_str_literal_lower("", $b.state))
                    }
                }
            }
        } else {
            match g3_interp_parts(@chars, 0, $n, "", StrBuild(state: $state, tmp: "", present: false), $env) {
                Err($m) { Err($m) }
                Ok($b) {
                    if $b.present {
                        Ok(StrLower(state: $b.state, tmp: $b.tmp))
                    } else {
                        Ok(g3_str_literal_lower("", $b.state))
                    }
                }
            }
        }
    }
}

sub g3_str_lower($e: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $e {
        EStr($text) {
            g3_interp_str_lower($text, $state, $env)
        }
        ERawStr($text) {
            Ok(g3_str_literal_lower($text, $state))
        }
        # §13 first-class Regex VALUE: a regex literal in value position is its
        # validated pattern text as a fresh counted Str (never an intern, so the
        # binding is releasable like any owned Str). Spliced values evaluate
        # their parts left-to-right, assemble the canonical capture-demoted
        # source in the runtime, and validate it before ownership transfers.
        ERegex($pattern, $rl, $rc) {
            if g6_regex_pattern_has_splice($pattern) {
                match g6_regex_parse_parts($pattern) {
                    Err($m) { Err($m) }
                    Ok($parts) {
                        match g6_regex_emit_parts($parts, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($po) {
                                $tmp = "gt" ~ c_int($po.state.ntmp)
                                Ok(StrLower(
                                    state: CgState(
                                        interns: $po.state.interns,
                                        decls: $po.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                        body: $po.state.body ~
                                            "\t" ~ $tmp ~ " = guji_regex_value_from_parts(\"" ~
                                                c_int($rl) ~ ":" ~ c_int($rc) ~ "\", " ~
                                                $po.parts ~ ", " ~ c_int($po.count) ~ ");\n" ~
                                            $po.release,
                                        nstr: $po.state.nstr,
                                        ntmp: $po.state.ntmp + 1
                                    ),
                                    tmp: $tmp
                                ))
                            }
                        }
                    }
                }
            } else {
                $tmp = "gt" ~ c_int($state.ntmp)
                Ok(StrLower(
                    state: CgState(
                        interns: $state.interns,
                        decls: $state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                        body: $state.body ~ "\t" ~ $tmp ~ " = guji_str_from_c(\"" ~ g2_c_escape($pattern) ~ "\");\n",
                        nstr: $state.nstr,
                        ntmp: $state.ntmp + 1
                    ),
                    tmp: $tmp
                ))
            }
        }
        EBinary($op, $l, $r) {
            if $op == "~" {
                match g3_str_lower($l, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($ls) {
                        match g3_str_lower($r, $ls.state, $env) {
                            Err($m) { Err($m) }
                            Ok($rs) { Ok(g3_str_concat_tmps($ls.tmp, $rs)) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgStr {
                            $ti = c_int($state.ntmp)
                            $tmp = "gt" ~ $ti
                            Ok(StrLower(
                                state: CgState(
                                    interns: $state.interns,
                                    decls: $state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                    body: $state.body ~ "\t" ~ $tmp ~ " = guji_retain(" ~ $v.cname ~ ");\n",
                                    nstr: $state.nstr,
                                    ntmp: $state.ntmp + 1
                                ),
                                tmp: $tmp
                            ))
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EIf($cond, $then, $elifs, $els) {
            match g4_lower_if_value(CgStr, $cond, $then, $elifs, $els, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
            }
        }
        ECall($c, $a) {
            match g6_regex_assoc_str($c, $a, $state, $env) {
                Ok($ra) { Ok($ra) }
                Err($ram) {
            match g6_replace_value($c, $a, $state, $env) {
                Ok($r) { Ok($r) }
                Err($rm) {
            match g6_replace_with_value($c, $a, $state, $env) {
                Ok($rw) { Ok($rw) }
                Err($rwm) {
                    match g7_join_value($c, $a, $state, $env) {
                        Ok($jv) { Ok($jv) }
                        Err($mj) {
                            match g7_strunary_value($c, $a, $state, $env) {
                                Ok($uv) { Ok($uv) }
                                Err($mu) {
                                    match g4_handle_slurp_value($c, $a, $state, $env) {
                                        Ok($hv) { Ok($hv) }
                                        Err($mh) {
                                    match g7_reduce_value(CgStr, $c, $a, 0, $state, $env) {
                                        Ok($rv) { Ok(StrLower(state: $rv.state, tmp: $rv.c)) }
                                        Err($mr) {
                                            match g5_call_value(RStr, $c, $a, $state, $env) {
                                                Err($m) {
                                                    match g5_fn_call_value(CgStr, $c, $a, $state, $env) {
                                                        Err($fm) {
                                                            match g4_unwrap_or_str($c, $a, $state, $env) {
                                                                Ok($uv) { Ok($uv) }
                                                                Err($um) {
                                                                    match g4_result_unwrap_or_str($c, $a, $state, $env) {
                                                                        Ok($rv) { Ok($rv) }
                                                                        Err($rum) {
                                                                            match g4_result_unwrap_or_else_str($c, $a, $state, $env) {
                                                                                Ok($ruev) { Ok($ruev) }
                                                                                Err($ruem) {
                                                                                    match g4_result_expect_str($c, $a, $state, $env) {
                                                                                        Ok($rev) { Ok($rev) }
                                                                                        Err($rem) {
                                                                                            match g4_option_unwrap_str($c, $a, $state, $env) {
                                                                                                Ok($ov) { Ok($ov) }
                                                                                                Err($oum) { Err($m) }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                                                    }
                                                }
                                                Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                                            }
                                        }
                                        Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                                    }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
                }
            }
        }
            }
        }
        EMatch($subj, $arms) {
            match g6_lower_match(CgStr, $subj, $arms, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
            }
        }
        EIndex($obj, $idx) {
            match g7_lower_index(CgStr, $obj, $idx, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
            }
        }
        EField($obj, $name) {
            if $name == "text" {
                match g6_match_text_value($obj, $state, $env) {
                    Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                    Err($mt) {
                        match g10_bush_text_value($obj, $state, $env) {
                            Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                            Err($bt) {
                                match g8_lower_field_value(CgStr, $obj, $name, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                                }
                            }
                        }
                    }
                }
            } else {
                match g8_lower_field_value(CgStr, $obj, $name, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower `print(<Str expr>)` / `note(<Str expr>)`: build the string into a temp,
# write its exact byte count through the captured runtime helper, then release it.
sub g3_str_sink_emit($sl: StrLower, $sink: Str): CgState {
    $st = $sl.state
    CgState(
        interns: $st.interns,
        decls: $st.decls,
        body: $st.body ~ "\t" ~ $sink ~ "(" ~ $sl.tmp ~ ");\n" ~ "\tguji_release(" ~ $sl.tmp ~ ");\n",
        nstr: $st.nstr,
        ntmp: $st.ntmp
    )
}

sub g3_lower_str_sink($arg: Expr, $sink: Str, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g3_display_lower($arg, $state, $env) {
        Ok($sl) { Ok(g3_str_sink_emit($sl, $sink)) }
        Err($m) { Err($m) }
    }
}

sub g3_lower_print($arg: Expr, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    g3_lower_str_sink($arg, "guji_print", $state, $env)
}

sub g3_lower_note($arg: Expr, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    g3_lower_str_sink($arg, "guji_note", $state, $env)
}

# If `$e` is exactly `<name>(<one arg>)`, return Some(arg); else None.
sub g3_expr_builtin_arg($e: Expr, $want: Str): Option[Expr] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                EName($name) {
                    if $name == $want {
                        match $args {
                            ExprCons($arg, ExprNil) { Some($arg) }
                            _ { None }
                        }
                    } else {
                        None
                    }
                }
                _ { None }
            }
        }
        _ { None }
    }
}

sub g3_expr_print_arg($e: Expr): Option[Expr] {
    g3_expr_builtin_arg($e, "print")
}

sub g3_expr_note_arg($e: Expr): Option[Expr] {
    g3_expr_builtin_arg($e, "note")
}

# If `$s` is an expression statement that is exactly `print(<one arg>)`, return
# Some(arg); else None.
sub g3_as_print($s: Stmt): Option[Expr] {
    match $s {
        SExpr($e) { g3_expr_print_arg($e) }
        _ { None }
    }
}

# If `$s` is an expression statement that is exactly `note(<one arg>)`, return
# Some(arg); else None.
sub g3_as_note($s: Stmt): Option[Expr] {
    match $s {
        SExpr($e) { g3_expr_note_arg($e) }
        _ { None }
    }
}

# ---- G3b-c/G4a: Bool conditions + final `if` Int expression ---------------

sub g4_compare_c($op: Str, $lc: Str, $rc: Str): Result[Str, Str] {
    if $op == "==" || $op == "!=" || $op == "<" || $op == "<=" || $op == ">" || $op == ">=" {
        Ok("((" ~ $lc ~ ") " ~ $op ~ " (" ~ $rc ~ ") ? 1LL : 0LL)")
    } else {
        Err(g3_unsupported())
    }
}

sub g4_bool_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g4_bool_lower($l, $state, $env) {
            Err($m) { Err($m) }
            Ok($lv) {
                match g4_bool_lower($r, $lv.state, $env) {
                    Err($m) { Err($m) }
                    Ok($rv) {
                        match g4_compare_c($op, $lv.c, $rv.c) {
                            Err($m) { Err($m) }
                            Ok($c) { Ok(BoolLower(state: $rv.state, c: $c)) }
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Unit has a single value, but it still participates in the scalar equality
# surface. Lower both operands so future Unit-valued expressions retain their
# evaluation effects, then compare their zero sentinels like the native backend.
sub g4_unit_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g4_lower_value(CgUnit, $l, $state, $env) {
            Err($m) { Err($m) }
            Ok($lv) {
                match g4_lower_value(CgUnit, $r, $lv.state, $env) {
                    Err($m) { Err($m) }
                    Ok($rv) {
                        match g4_compare_c($op, $lv.c, $rv.c) {
                            Err($m) { Err($m) }
                            Ok($c) { Ok(BoolLower(state: $rv.state, c: $c)) }
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Stateful Int comparison (G5b-b): lower each Int operand through the stateful
# rvalue lowerer so a Str-arg call operand (e.g. `score("ok") == 7`) can emit its
# prep before the comparison. When both operands are pure the threaded state is
# unchanged, so the emitted condition is byte-identical to g4_int_compare.
sub g4_int_compare_state($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g3_int_rvalue_state($l, $state, $env) {
        Err($m) { Err($m) }
        Ok($lv) {
            match g3_int_rvalue_state($r, $lv.state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    match g4_compare_c($op, $lv.c, $rv.c) {
                        Err($m) { Err($m) }
                        Ok($c) { Ok(BoolLower(state: $rv.state, c: $c)) }
                    }
                }
            }
        }
    }
}

# Stateful Float comparison (G5b-b), mirroring g4_int_compare_state.
sub g4_float_compare_state($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g3b_float_rvalue_state($l, $state, $env) {
        Err($m) { Err($m) }
        Ok($lv) {
            match g3b_float_rvalue_state($r, $lv.state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    match g4_compare_c($op, $lv.c, $rv.c) {
                        Err($m) { Err($m) }
                        Ok($c) { Ok(BoolLower(state: $rv.state, c: $c)) }
                    }
                }
            }
        }
    }
}

sub g4_str_compare_c($op: Str, $lc: Str, $rc: Str): Result[Str, Str] {
    if $op == "==" || $op == "!=" || $op == "<" || $op == "<=" || $op == ">" || $op == ">=" {
        Ok("((guji_str_compare(" ~ $lc ~ ", " ~ $rc ~ ") " ~ $op ~ " 0) ? 1LL : 0LL)")
    } else {
        Err(g3_unsupported())
    }
}

# Str operands need stateful lowering: literals become immortal `gs_N` statics
# and concatenations may allocate fresh strings. Compute the comparison into a
# bool temp before releasing the operand temps, then return that temp as the
# condition rvalue.
sub g4_str_compare($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g3_str_lower($l, $state, $env) {
        Err($m) { Err($m) }
        Ok($ls) {
            match g3_str_lower($r, $ls.state, $env) {
                Err($m) { Err($m) }
                Ok($rs) {
                    match g4_str_compare_c($op, $ls.tmp, $rs.tmp) {
                        Err($m) { Err($m) }
                        Ok($cmp) {
                            $st = $rs.state
                            $ti = c_int($st.ntmp)
                            $bt = "gb" ~ $ti
                            Ok(BoolLower(
                                state: CgState(
                                    interns: $st.interns,
                                    decls: $st.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                    body: $st.body ~ "\t" ~ $bt ~ " = " ~ $cmp ~ ";\n" ~
                                        "\tguji_release(" ~ $rs.tmp ~ ");\n" ~
                                        "\tguji_release(" ~ $ls.tmp ~ ");\n",
                                    nstr: $st.nstr,
                                    ntmp: $st.ntmp + 1
                                ),
                                c: $bt
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g4_carrier_eq_payload_expr($kind: CgKind, $lc: Str, $rc: Str): Result[Str, Str] {
    match $kind {
        CgStr { Ok("guji_str_equal(" ~ $lc ~ ", " ~ $rc ~ ")") }
        CgList($el) {
            match $el {
                CgClass($name) { Ok("guji_list_eq_" ~ $name ~ "((const " ~ $name ~ "*)" ~ $lc ~ ".data, " ~ $lc ~ ".len, (const " ~ $name ~ "*)" ~ $rc ~ ".data, " ~ $rc ~ ".len)") }
                CgEnum($name) { Ok("guji_list_eq_" ~ $name ~ "((const " ~ $name ~ "*)" ~ $lc ~ ".data, " ~ $lc ~ ".len, (const " ~ $name ~ "*)" ~ $rc ~ ".data, " ~ $rc ~ ".len)") }
                _ {
                    match g7_list_arr_kind($el) {
                        Err($m) { Err($m) }
                        Ok($ak) {
                            # Equality can alternate List and Map rows. Use the fully
                            # recursive leaf classifier rather than the display-only
                            # List classifier, which stops when it reaches a Map row.
                            match g7_map_leaf($el) {
                                Err($m) { Err($m) }
                                Ok($leaf) {
                                    Ok("guji_list_equal((const void*)" ~ $lc ~ ".data, " ~ $lc ~ ".len, " ~ $ak ~ ", (const void*)" ~ $rc ~ ".data, " ~ $rc ~ ".len, " ~ $ak ~ ", " ~ $leaf ~ ")")
                                }
                            }
                        }
                    }
                }
            }
        }
        CgMap($v) {
            match $v {
                CgClass($name) { Ok("guji_map_eq_" ~ $name ~ "((const char**)" ~ $lc ~ ".keys, (const " ~ $name ~ "*)" ~ $lc ~ ".vals, " ~ $lc ~ ".len, (const char**)" ~ $rc ~ ".keys, (const " ~ $name ~ "*)" ~ $rc ~ ".vals, " ~ $rc ~ ".len)") }
                CgEnum($name) { Ok("guji_map_eq_" ~ $name ~ "((const char**)" ~ $lc ~ ".keys, (const " ~ $name ~ "*)" ~ $lc ~ ".vals, " ~ $lc ~ ".len, (const char**)" ~ $rc ~ ".keys, (const " ~ $name ~ "*)" ~ $rc ~ ".vals, " ~ $rc ~ ".len)") }
                _ {
                    match g7_map_val_arr_kind($v) {
                        Err($m) { Err($m) }
                        Ok($ak) {
                            match g7_map_leaf($v) {
                                Err($m) { Err($m) }
                                Ok($leaf) {
                                    Ok("guji_map_equal((const char**)" ~ $lc ~ ".keys, (const void*)" ~ $lc ~ ".vals, " ~ $lc ~ ".len, " ~ $ak ~ ", (const char**)" ~ $rc ~ ".keys, (const void*)" ~ $rc ~ ".vals, " ~ $rc ~ ".len, " ~ $ak ~ ", " ~ $leaf ~ ")")
                                }
                            }
                        }
                    }
                }
            }
        }
        CgOptInt { g4_carrier_eq_expr(CgOptInt, $lc, $rc) }
        CgOptFloat { g4_carrier_eq_expr(CgOptFloat, $lc, $rc) }
        CgOptBool { g4_carrier_eq_expr(CgOptBool, $lc, $rc) }
        CgOptStr { g4_carrier_eq_expr(CgOptStr, $lc, $rc) }
        CgOptClass($n) { g4_carrier_eq_expr(CgOptClass($n), $lc, $rc) }
        CgOptEnum($n) { g4_carrier_eq_expr(CgOptEnum($n), $lc, $rc) }
        CgOptList($el) { g4_carrier_eq_expr(CgOptList($el), $lc, $rc) }
        CgOptMap($v) { g4_carrier_eq_expr(CgOptMap($v), $lc, $rc) }
        CgRes($ok, $err) { g4_carrier_eq_expr($kind, $lc, $rc) }
        _ { Ok("(" ~ $lc ~ " == " ~ $rc ~ ")") }
    }
}

# Lower direct List/Map `==` and `!=` through the same generic KIND-tag runtime
# recursion used for carrier payload equality. Each operand is materialized as an
# owned value, left-to-right, so literals/calls/indexes and named bindings share
# one path; the Bool result is saved before both values are released. Kind
# inference tries the left operand first and the right operand second, so either
# side can be the expression that exposes the element/value kind.
sub g4_collection_value_err(): Result[CgValueOut, Str] {
    Err(g3_unsupported())
}

sub g4_collection_compare_kind($op: Str, $kind: CgKind, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    $lv: Result[CgValueOut, Str] = match $kind {
        CgList($el) { g7_lower_list_value($el, $l, $state, $env) }
        CgMap($v) { g7_lower_map_value($v, $l, $state, $env) }
        _ { g4_collection_value_err() }
    }
    match $lv {
        Err($m) { Err($m) }
        Ok($left) {
            $rv: Result[CgValueOut, Str] = match $kind {
                CgList($el) { g7_lower_list_value($el, $r, $left.state, $env) }
                CgMap($v) { g7_lower_map_value($v, $r, $left.state, $env) }
                _ { g4_collection_value_err() }
            }
            match $rv {
                Err($m) { Err($m) }
                Ok($right) {
                    match g4_carrier_eq_payload_expr($kind, $left.c, $right.c) {
                        Err($m) { Err($m) }
                        Ok($eq) {
                            $st = $right.state
                            $bt = "gb" ~ c_int($st.ntmp)
                            $expr = if $op == "!=" { "!(" ~ $eq ~ ")" } else { $eq }
                            $lrel = match $kind {
                                CgList($el) { g7_slice_release($left.c) }
                                CgMap($v) { g7_map_value_release($left.c) }
                                _ { "" }
                            }
                            $rrel = match $kind {
                                CgList($el) { g7_slice_release($right.c) }
                                CgMap($v) { g7_map_value_release($right.c) }
                                _ { "" }
                            }
                            Ok(BoolLower(
                                state: CgState(
                                    interns: $st.interns,
                                    decls: $st.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                    body: $st.body ~ "\t" ~ $bt ~ " = (" ~ $expr ~ ") ? 1LL : 0LL;\n" ~ $rrel ~ $lrel,
                                    nstr: $st.nstr,
                                    ntmp: $st.ntmp + 1
                                ),
                                c: $bt
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g4_list_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g7_list_kind_from_value($l, $env) {
        Ok($el) {
            match g4_collection_compare_kind($op, CgList($el), $l, $r, $state, $env) {
                Ok($v) { Ok($v) }
                Err($m) {
                    match g7_list_kind_from_value($r, $env) {
                        Ok($rel) { g4_collection_compare_kind($op, CgList($rel), $l, $r, $state, $env) }
                        Err($rm) { Err($m) }
                    }
                }
            }
        }
        Err($m) {
            match g7_list_kind_from_value($r, $env) {
                Ok($el) { g4_collection_compare_kind($op, CgList($el), $l, $r, $state, $env) }
                Err($rm) { Err($m) }
            }
        }
    }
}

sub g4_map_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g7_map_val_kind_from_value($l, $env) {
        Ok($v) {
            match g4_collection_compare_kind($op, CgMap($v), $l, $r, $state, $env) {
                Ok($out) { Ok($out) }
                Err($m) {
                    match g7_map_val_kind_from_value($r, $env) {
                        Ok($rv) { g4_collection_compare_kind($op, CgMap($rv), $l, $r, $state, $env) }
                        Err($rm) { Err($m) }
                    }
                }
            }
        }
        Err($m) {
            match g7_map_val_kind_from_value($r, $env) {
                Ok($v) { g4_collection_compare_kind($op, CgMap($v), $l, $r, $state, $env) }
                Err($rm) { Err($m) }
            }
        }
    }
}

sub g4_collection_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g4_list_compare_lower($op, $l, $r, $state, $env) {
            Ok($v) { Ok($v) }
            Err($m) { g4_map_compare_lower($op, $l, $r, $state, $env) }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Match values are counted pointers, but equality is structural by capture
# state (§13.3), never pointer identity. Both operands are borrowed Match locals
# here; their enclosing Option/binding owners keep them alive through the pure
# runtime comparison.
sub g4_match_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g6_match_value($l, $state, $env) {
            Err($m) { Err($m) }
            Ok($lv) {
                match g6_match_value($r, $lv.state, $env) {
                    Err($m) { Err($m) }
                    Ok($rv) {
                        $eq = "guji_match_equal(" ~ $lv.c ~ ", " ~ $rv.c ~ ")"
                        $expr = if $op == "!=" { "!(" ~ $eq ~ ")" } else { $eq }
                        Ok(BoolLower(state: $rv.state, c: "((" ~ $expr ~ ") ? 1LL : 0LL)"))
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Class and enum values are by-value C structs, but guji equality is nominal and
# structural (§8/§9): the concrete type must agree, then every class field or the
# active enum payload is compared recursively. Materialize each operand into an
# owned local before calling its generated `guji_eq_<Type>` helper. This keeps
# constructor/call/name operands on one lifetime path and makes both addresses
# stable while the comparison runs.
sub g4_nominal_operand($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    $lowered: Result[CgValueOut, Str] = match $kind {
        CgClass($n) { g8_class_value($n, $value, $state, $env) }
        CgEnum($n) { g6e_enum_value($n, $value, $state, $env) }
        _ { Err(g3_unsupported()) }
    }
    match $lowered {
        Err($m) { Err($m) }
        Ok($v) {
            $tmp = g4_value_tmp($kind, $v.state.ntmp)
            Ok(CgValueOut(
                state: CgState(
                    interns: $v.state.interns,
                    decls: $v.state.decls ~ g4_value_decl($kind, $tmp),
                    body: $v.state.body ~ "\t" ~ $tmp ~ " = " ~ $v.c ~ ";\n",
                    nstr: $v.state.nstr,
                    ntmp: $v.state.ntmp + 1
                ),
                c: $tmp
            ))
        }
    }
}

sub g4_nominal_release($kind: CgKind, $c: Str): Str {
    match $kind {
        CgClass($n) { g8_class_release($n, $c) }
        CgEnum($n) { g6e_enum_release($n, $c) }
        _ { "" }
    }
}

sub g4_nominal_compare_kind($op: Str, $kind: CgKind, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g4_nominal_operand($kind, $l, $state, $env) {
        Err($m) { Err($m) }
        Ok($lv) {
            match g4_nominal_operand($kind, $r, $lv.state, $env) {
                Err($m) { Err($m) }
                Ok($rv) {
                    $name = match $kind {
                        CgClass($n) { $n }
                        CgEnum($n) { $n }
                        _ { "" }
                    }
                    if $name == "" {
                        Err(g3_unsupported())
                    } else {
                        $st = $rv.state
                        $bt = "gb" ~ c_int($st.ntmp)
                        $eq = "guji_eq_" ~ $name ~ "(&" ~ $lv.c ~ ", &" ~ $rv.c ~ ")"
                        $expr = if $op == "!=" { "!(" ~ $eq ~ ")" } else { $eq }
                        Ok(BoolLower(
                            state: CgState(
                                interns: $st.interns,
                                decls: $st.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                body: $st.body ~ "\t" ~ $bt ~ " = (" ~ $expr ~ ") ? 1LL : 0LL;\n" ~
                                    g4_nominal_release($kind, $rv.c) ~ g4_nominal_release($kind, $lv.c),
                                nstr: $st.nstr,
                                ntmp: $st.ntmp + 1
                            ),
                            c: $bt
                        ))
                    }
                }
            }
        }
    }
}

sub g4_class_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g8_class_kind_from_value($l, $env) {
            Err($m) { Err($m) }
            Ok($kind) {
                match g8_class_kind_from_value($r, $env) {
                    Ok($rkind) {
                        if cgkind_eq($kind, $rkind) { g4_nominal_compare_kind($op, $kind, $l, $r, $state, $env) }
                        else { Err(g3_unsupported()) }
                    }
                    Err($m) { Err($m) }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g4_enum_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g6e_enum_kind_from_value($l, $env) {
            Err($m) { Err($m) }
            Ok($kind) {
                match g6e_enum_kind_from_value($r, $env) {
                    Ok($rkind) {
                        if cgkind_eq($kind, $rkind) { g4_nominal_compare_kind($op, $kind, $l, $r, $state, $env) }
                        else { Err(g3_unsupported()) }
                    }
                    Err($m) { Err($m) }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g4_carrier_eq_expr($kind: CgKind, $lc: Str, $rc: Str): Result[Str, Str] {
    match $kind {
        CgOptInt {
            match g4_carrier_eq_payload_expr(CgInt, $lc ~ ".val", $rc ~ ".val") {
                Err($m) { Err($m) }
                Ok($p) { Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || (" ~ $p ~ ")))") }
            }
        }
        CgOptFloat {
            match g4_carrier_eq_payload_expr(CgFloat, $lc ~ ".val", $rc ~ ".val") {
                Err($m) { Err($m) }
                Ok($p) { Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || (" ~ $p ~ ")))") }
            }
        }
        CgOptBool {
            match g4_carrier_eq_payload_expr(CgBool, $lc ~ ".val", $rc ~ ".val") {
                Err($m) { Err($m) }
                Ok($p) { Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || (" ~ $p ~ ")))") }
            }
        }
        CgOptStr {
            match g4_carrier_eq_payload_expr(CgStr, $lc ~ ".val", $rc ~ ".val") {
                Err($m) { Err($m) }
                Ok($p) { Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || (" ~ $p ~ ")))") }
            }
        }
        CgOptClass($n) {
            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || guji_eq_" ~ $n ~ "(&(" ~ $lc ~ ".val), &(" ~ $rc ~ ".val))))")
        }
        CgOptEnum($n) {
            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || guji_eq_" ~ $n ~ "(&(" ~ $lc ~ ".val), &(" ~ $rc ~ ".val))))")
        }
        CgOptList($el) {
            match g4_carrier_eq_payload_expr(CgList($el), $lc ~ ".val", $rc ~ ".val") {
                Err($m) { Err($m) }
                Ok($p) { Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || (" ~ $p ~ ")))") }
            }
        }
        CgOptMap($v) {
            match g4_carrier_eq_payload_expr(CgMap($v), $lc ~ ".val", $rc ~ ".val") {
                Err($m) { Err($m) }
                Ok($p) { Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) || (" ~ $p ~ ")))") }
            }
        }
        CgRes($ok, $err) {
            match g4_carrier_eq_payload_expr($ok, $lc ~ ".ok", $rc ~ ".ok") {
                Err($m) { Err($m) }
                Ok($okp) {
                    match g4_carrier_eq_payload_expr($err, $lc ~ ".err", $rc ~ ".err") {
                        Err($m) { Err($m) }
                        Ok($errp) {
                            Ok("((" ~ $lc ~ ".tag == " ~ $rc ~ ".tag) && ((" ~ $lc ~ ".tag == 0LL) ? (" ~ $okp ~ ") : (" ~ $errp ~ ")))")
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_carrier_kind_from_value($e: Expr, $env: CgEnv): Result[CgKind, Str] {
    match g6_option_kind_from_value($e, $env) {
        Ok($k) { Ok($k) }
        Err($om) { g6_result_kind_from_value($e, $env) }
    }
}

sub g4_carrier_release($kind: CgKind, $c: Str): Str {
    if g6_is_option_kind($kind) {
        g6_option_release($kind, $c)
    } else {
        g6_result_release($kind, $c)
    }
}

sub g4_carrier_operand($kind: CgKind, $e: Expr, $state: CgState, $env: CgEnv): Result[CgArgsOut, Str] {
    match $e {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    if cgkind_eq($kind, $v.kind) {
                        Ok(CgArgsOut(state: $state, args: $v.cname, releases: ""))
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
        _ {
            match g4_lower_value($kind, $e, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(CgArgsOut(state: $v.state, args: $v.c, releases: g4_carrier_release($kind, $v.c))) }
            }
        }
    }
}

sub g4_carrier_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g4_carrier_kind_from_value($l, $env) {
            Err($m) { Err($m) }
            Ok($kind) {
                match g4_carrier_kind_from_value($r, $env) {
                    Err($m) { Err($m) }
                    Ok($rkind) {
                        if cgkind_eq($kind, $rkind) {
                            match g4_carrier_operand($kind, $l, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($lv) {
                                    match g4_carrier_operand($kind, $r, $lv.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($rv) {
                                            match g4_carrier_eq_expr($kind, $lv.args, $rv.args) {
                                                Err($m) { Err($m) }
                                                Ok($eq) {
                                                    $st = $rv.state
                                                    $bt = "gb" ~ c_int($st.ntmp)
                                                    $expr = if $op == "!=" { "!(" ~ $eq ~ ")" } else { $eq }
                                                    Ok(BoolLower(
                                                        state: CgState(
                                                            interns: $st.interns,
                                                            decls: $st.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                                            body: $st.body ~ "\t" ~ $bt ~ " = (" ~ $expr ~ ") ? 1LL : 0LL;\n" ~ $rv.releases ~ $lv.releases,
                                                            nstr: $st.nstr,
                                                            ntmp: $st.ntmp + 1
                                                        ),
                                                        c: $bt
                                                    ))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# §17.2 opaque channel equality is handle identity. Both operands become owned
# stable temps before comparison, then are released after the Bool is saved;
# this also evaluates call-produced operands exactly once.
sub g4_chan_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g11_chan_kind_from_value($l, $env) {
            Err($m) { Err($m) }
            Ok($lk) {
                match g11_chan_kind_from_value($r, $env) {
                    Err($m) { Err($m) }
                    Ok($rk) {
                        if cgkind_eq($lk, $rk) {
                            match $lk {
                                CgChan($el) {
                                    match g11_chan_owned_value($el, $l, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($lv) {
                                            match g11_chan_owned_value($el, $r, $lv.state, $env) {
                                                Err($m) { Err($m) }
                                                Ok($rv) {
                                                    $st = $rv.state
                                                    $bt = "gb" ~ c_int($st.ntmp)
                                                    Ok(BoolLower(
                                                        state: CgState(
                                                            interns: $st.interns,
                                                            decls: $st.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                                            body: $st.body ~ "\t" ~ $bt ~ " = ((" ~ $lv.c ~ ") " ~ $op ~ " (" ~ $rv.c ~ ")) ? 1LL : 0LL;\n" ~
                                                                "\tguji_chan_release(" ~ $rv.c ~ ");\n" ~
                                                                "\tguji_chan_release(" ~ $lv.c ~ ");\n",
                                                            nstr: $st.nstr,
                                                            ntmp: $st.ntmp + 1
                                                        ),
                                                        c: $bt
                                                    ))
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# §7.4 opaque function equality. Both operands are evaluated left-to-right and
# fresh closure environments are released, but no code/environment identity is
# exposed: == is always false and != is always true, even for aliases.
sub g4_fn_compare_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $op == "==" || $op == "!=" {
        match g5_fn_arg_kind($l, $env) {
            Err($m) { Err($m) }
            Ok($lk) {
                match g5_fn_arg_kind($r, $env) {
                    Err($m) { Err($m) }
                    Ok($rk) {
                        if cgkind_eq($lk, $rk) {
                            match g4_lower_value($lk, $l, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($lv) {
                                    match g4_lower_value($rk, $r, $lv.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($rv) {
                                            $rrelease = if g5_fn_init_fresh($r) { "\tguji_release(" ~ $rv.c ~ ".env);\n" } else { "" }
                                            $lrelease = if g5_fn_init_fresh($l) { "\tguji_release(" ~ $lv.c ~ ".env);\n" } else { "" }
                                            Ok(BoolLower(
                                                state: CgState(
                                                    interns: $rv.state.interns,
                                                    decls: $rv.state.decls,
                                                    body: $rv.state.body ~ $rrelease ~ $lrelease,
                                                    nstr: $rv.state.nstr,
                                                    ntmp: $rv.state.ntmp
                                                ),
                                                c: if $op == "!=" { "1LL" } else { "0LL" }
                                            ))
                                        }
                                    }
                                }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Dispatch a comparison by operand kind. The operands are homogeneous (the
# typechecker already accepted the program), so we try Int, then Float, then Str,
# then Bool: each lowerer rejects (Err) on a non-matching operand kind, so the
# first Ok is the right one.
sub g4_comparison_lower($op: Str, $l: Expr, $r: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g4_int_compare_state($op, $l, $r, $state, $env) {
        Ok($v) { Ok($v) }
        Err($m) {
            match g4_float_compare_state($op, $l, $r, $state, $env) {
                Ok($v) { Ok($v) }
                Err($m2) {
                    match g4_str_compare($op, $l, $r, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($m3) {
                            match g4_match_compare_lower($op, $l, $r, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($m4) {
                            match g4_class_compare_lower($op, $l, $r, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($classm) {
                            match g4_enum_compare_lower($op, $l, $r, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($enumm) {
                            match g4_collection_compare_lower($op, $l, $r, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($m5) {
                                    match g4_carrier_compare_lower($op, $l, $r, $state, $env) {
                                        Ok($v) { Ok($v) }
                                        Err($m6) {
                                            match g4_chan_compare_lower($op, $l, $r, $state, $env) {
                                                Ok($v) { Ok($v) }
                                                Err($mch) {
                                                    match g4_fn_compare_lower($op, $l, $r, $state, $env) {
                                                        Ok($v) { Ok($v) }
                                                        Err($mfn) {
                                                    match g4_unit_compare_lower($op, $l, $r, $state, $env) {
                                                        Ok($v) { Ok($v) }
                                                        Err($mu) { g4_bool_compare_lower($op, $l, $r, $state, $env) }
                                                    }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g4_regex_is_some_lower($e: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $e {
        ECall($callee, $args) {
            match $args {
                ExprNil {
                    match $callee {
                        EField($recv, $method) {
                            if $method == "is_some" {
                                match $recv {
                                    EBinary($op, $left, $right) {
                                        if $op == "~~" {
                                            match $right {
                                                ERegex($pattern, $rline, $rcol) {
                                                    match g3_str_lower($left, $state, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($sl) {
                                                            $loc = c_int($rline) ~ ":" ~ c_int($rcol)
                                                            if g6_regex_pattern_has_splice($pattern) {
                                                                match g6_regex_parse_parts($pattern) {
                                                                    Err($m) { Err($m) }
                                                                    Ok($parts) {
                                                                        match g6_regex_emit_parts($parts, $sl.state, $env) {
                                                                            Err($m) { Err($m) }
                                                                            Ok($po) {
                                                                                $st = $po.state
                                                                                $mi = c_int($st.ntmp)
                                                                                $bi = c_int($st.ntmp + 1)
                                                                                $mt = "gm" ~ $mi
                                                                                $bt = "gb" ~ $bi
                                                                                Ok(BoolLower(
                                                                                    state: CgState(
                                                                                        interns: $st.interns,
                                                                                        decls: $st.decls ~ "\tguji_match_t* " ~ $mt ~ " = NULL;\n" ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                                                                        body: $st.body ~
                                                                                            "\t" ~ $mt ~ " = guji_regex_match_parts_engine(\"" ~ $loc ~ "\", " ~ $po.parts ~ ", " ~ c_int($po.count) ~ ", " ~ $sl.tmp ~ ", 0, NULL);\n" ~
                                                                                            "\t" ~ $bt ~ " = (" ~ $mt ~ " != NULL) ? 1LL : 0LL;\n" ~
                                                                                            "\tguji_release((const void*)" ~ $mt ~ ");\n" ~
                                                                                            "\tguji_release(" ~ $sl.tmp ~ ");\n" ~
                                                                                            $po.release,
                                                                                        nstr: $st.nstr,
                                                                                        ntmp: $st.ntmp + 2
                                                                                    ),
                                                                                    c: $bt
                                                                                ))
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            } else {
                                                                $st = $sl.state
                                                                $mi = c_int($st.ntmp)
                                                                $bi = c_int($st.ntmp + 1)
                                                                $mt = "gm" ~ $mi
                                                                $bt = "gb" ~ $bi
                                                                $pat = g2_c_escape($pattern)
                                                                Ok(BoolLower(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ "\tguji_match_t* " ~ $mt ~ " = NULL;\n" ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                                                        body: $st.body ~
                                                                            "\t" ~ $mt ~ " = guji_regex_match_pattern_engine(\"" ~ $pat ~ "\", " ~ $sl.tmp ~ ", 0, NULL);\n" ~
                                                                            "\t" ~ $bt ~ " = (" ~ $mt ~ " != NULL) ? 1LL : 0LL;\n" ~
                                                                            "\tguji_release((const void*)" ~ $mt ~ ");\n" ~
                                                                            "\tguji_release(" ~ $sl.tmp ~ ");\n",
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 2
                                                                    ),
                                                                    c: $bt
                                                                ))
                                                            }
                                                        }
                                                    }
                                                }
                                                _ { Err(g3_unsupported()) }
                                            }
                                        } else {
                                            Err(g3_unsupported())
                                        }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15.5 `is_some($o)`/`$o.is_some()` and `is_none($o)`/`$o.is_none()` over a bound
# `Option[T]` local, for ANY payload kind — the test reads only the tag, never the
# payload, so it is uniform. Native lowers both to a pure tag test that normalizes to
# 0/1 — `(opt.tag != 0 ? 1LL : 0LL)` for is_some, `(opt.tag == 0 ? 1LL : 0LL)` for
# is_none — a BORROW of the receiver (no payload touch => no retain/release; the
# binding keeps ownership and the existing scope-exit cleanup frees it). The receiver
# must be a bound Option VALUE carrier (a boxed recursive-carrier Option is a pointer,
# never a plain local, so it is declined here). Distinct from g4_regex_is_some_lower,
# which handles `(<str> ~~ /re/).is_some()` and runs FIRST in the bool-lower chain
# (its `~~`-regex receiver never overlaps this hook's bound-Option-local receiver).
sub g4_option_tag_test($method: Str, $recv: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $method == "is_some" || $method == "is_none" {
        match $recv {
            EName($n) {
                match cg_env_lookup($env, $n) {
                    None { Err(g3_unsupported()) }
                    Some($v) {
                        match $v.kind {
                            CgBoxOptClass($bn) { Err(g3_unsupported()) }
                            CgBoxOptEnum($bn) { Err(g3_unsupported()) }
                            _ {
                                if g6_is_option_kind($v.kind) {
                                    $cmp = if $method == "is_some" { "!= 0LL" } else { "== 0LL" }
                                    Ok(BoolLower(state: $state, c: "(" ~ $v.cname ~ ".tag " ~ $cmp ~ " ? 1LL : 0LL)"))
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                        }
                    }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Dispatch the method form `$o.is_some()`/`$o.is_none()` (callee EField, no args) and
# the function form `is_some($o)`/`is_none($o)` (callee EName, one arg). A user
# `sub is_some`/`sub is_none` shadows the FUNCTION form (defer to the general call
# path); the method form is a call on the Option value, so no shadow can apply.
sub g4_option_is_some_lower($e: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                EField($recv, $method) {
                    match $args {
                        ExprNil { g4_option_tag_test($method, $recv, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                EName($fn) {
                    if $fn == "is_some" || $fn == "is_none" {
                        match cg_env_lookup_sub($env, $fn) {
                            Some($sig) { Err(g3_unsupported()) }
                            None {
                                match $args {
                                    ExprCons($recv, ExprNil) { g4_option_tag_test($fn, $recv, $state, $env) }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15.5 `is_ok($r)`/`$r.is_ok()` and `is_err($r)`/`$r.is_err()` over a fresh
# Result expression. Materialize the owned carrier, save its tag test, then
# release its active slot before returning the Bool temp. Saving the Bool first
# is essential: a call such as `read_file(path).is_ok()` owns an Err Str which
# must be dropped on both an ordinary fall-through and an enclosing branch's
# early-return path.
sub g4_result_tag_test_fresh($method: Str, $recv: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $recv {
        EName($n) { Err(g3_unsupported()) }
        _ {
            match g6_result_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($kind) {
                    match g6_result_value($kind, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cv) {
                            $qtmp = g4_value_tmp($kind, $cv.state.ntmp)
                            $btmp = g4_value_tmp(CgBool, $cv.state.ntmp + 1)
                            $cmp = if $method == "is_ok" { "== 0LL" } else { "!= 0LL" }
                            Ok(BoolLower(
                                state: CgState(
                                    interns: $cv.state.interns,
                                    decls: $cv.state.decls ~ g4_value_decl($kind, $qtmp) ~ g4_value_decl(CgBool, $btmp),
                                    body: $cv.state.body ~
                                        "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n" ~
                                        "\t" ~ $btmp ~ " = (" ~ $qtmp ~ ".tag " ~ $cmp ~ " ? 1LL : 0LL);\n" ~
                                        g6_result_release($kind, $qtmp),
                                    nstr: $cv.state.nstr,
                                    ntmp: $cv.state.ntmp + 2
                                ),
                                c: $btmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

# A bound `Result[T,E]` local is the borrow twin: Result tags are native-shaped
# (0=Ok, 1=Err), and the binding remains responsible for active-slot cleanup.
sub g4_result_tag_test($method: Str, $recv: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    if $method == "is_ok" || $method == "is_err" {
        match $recv {
            EName($n) {
                match cg_env_lookup($env, $n) {
                    None { Err(g3_unsupported()) }
                    Some($v) {
                        if g6_is_result_kind($v.kind) {
                            $cmp = if $method == "is_ok" { "== 0LL" } else { "!= 0LL" }
                            Ok(BoolLower(state: $state, c: "(" ~ $v.cname ~ ".tag " ~ $cmp ~ " ? 1LL : 0LL)"))
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            }
            _ { g4_result_tag_test_fresh($method, $recv, $state, $env) }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Dispatch the method form `$r.is_ok()`/`$r.is_err()` (callee EField, no args) and
# the function form `is_ok($r)`/`is_err($r)` (callee EName, one arg). A user
# `sub is_ok`/`sub is_err` shadows the function form; method form remains a carrier
# prelude call on the Result receiver.
sub g4_result_is_ok_lower($e: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                EField($recv, $method) {
                    match $args {
                        ExprNil { g4_result_tag_test($method, $recv, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                EName($fn) {
                    if $fn == "is_ok" || $fn == "is_err" {
                        match cg_env_lookup_sub($env, $fn) {
                            Some($sig) { Err(g3_unsupported()) }
                            None {
                                match $args {
                                    ExprCons($recv, ExprNil) { g4_result_tag_test($fn, $recv, $state, $env) }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15.5 `unwrap_or($o, $d)` / `$o.unwrap_or($d)` over a bound `Option[T]` local with
# a scalar/Str payload (T = Int/Float/Bool/Str). Native lowers it to a pure BORROW
# ternary — `(opt.tag != 0 ? opt.val : <default>)` — with the default lowered in its
# natural T value position (captured via the cc wrapper: Int `gv_d_a.tag != 0 ?
# gv_d_a.val : 0LL`, Str default a borrowed static/local). Scalar payloads mirror
# that shape verbatim. A Str result follows the selfhost owned-tmp Str convention
# instead of native's raw borrow: the default lowers first to an owned tmp, the
# result tmp retains whichever pointer the tag picks, and the default tmp is then
# released unconditionally — refcounts balance on both arms (Some: payload +1,
# default +1/-1; None: default +1+1/-1, owned by the result). Behavior-identical to
# native (three-way + sanitizer verified). The default is lowered EAGERLY (hoisted
# before the ternary), matching the interpreter's ordinary argument evaluation.
# Class/enum/list payloads and the boxed recursive carriers (pointers) decline.
# (P9-6b-3: Option[List] unwrap_or is handled separately via g4_unwrap_or_list —
# list results need owned-slice retain/steal, not the scalar/Str ternary paths.)
class UnwrapOrParts {
    has $.v: CgVar
    has $.dflt: Expr
}

sub g4_unwrap_or_recv($recv: Expr, $d: Expr, $env: CgEnv): Result[UnwrapOrParts, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) { Ok(UnwrapOrParts(v: $v, dflt: $d)) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# The purely SYNTACTIC unwrap_or match — receiver expr + default expr, no binding
# lookup. Split out of g4_unwrap_or_parts (P3b-2b-1) so the call-receiver fallback
# can reuse the same spelling/shadow rules on receivers that are not bound locals.
class UnwrapOrSyntax {
    has $.recv: Expr
    has $.dflt: Expr
}

sub g4_unwrap_or_syntax($c: Expr, $a: ExprList, $env: CgEnv): Result[UnwrapOrSyntax, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap_or" {
                match $a {
                    ExprCons($d, ExprNil) { Ok(UnwrapOrSyntax(recv: $recv, dflt: $d)) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "unwrap_or" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprCons($d, ExprNil)) { Ok(UnwrapOrSyntax(recv: $recv, dflt: $d)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Match both spellings — method `$o.unwrap_or($d)` (callee EField, one arg) and
# function `unwrap_or($o, $d)` (callee EName, two args) — and return the receiver's
# binding plus the default expr. A user `sub unwrap_or` shadows the FUNCTION form
# (defer to the general call path); the method form is a call on the Option value,
# so no shadow can apply.
sub g4_unwrap_or_parts($c: Expr, $a: ExprList, $env: CgEnv): Result[UnwrapOrParts, Str] {
    match g4_unwrap_or_syntax($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($s) { g4_unwrap_or_recv($s.recv, $s.dflt, $env) }
    }
}

# P3b-2b-1: the receiver of an unwrap_or that is NOT a bound Option local — a
# CALL-produced Option carrier (`chained(5).unwrap_or(-1)`, the §11.1 feat_question
# observation shape). Resolve the receiver's Option carrier kind (user-sub ROpt
# return or find-produced) and require its payload to be exactly the wanted value
# kind, the same bar g4_unwrap_or_kind_ok sets for bound receivers. Bound EName
# locals decline here: the borrow path above already owns that shape.
sub g4_unwrap_or_call_carrier($want: CgKind, $recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $recv {
        EName($n) { Err(g3_unsupported()) }
        _ {
            # Prefer the full Option-kind inference (covers Match index/capture
            # `$m[1]` / `$m<name>` → CgOptStr, find/map/filter, ~~, and calls)
            # before the narrower question-carrier resolver.
            match g6_option_kind_from_value($recv, $env) {
                Ok($opkind) {
                    match g6_option_payload_kind($opkind) {
                        Err($m) { Err($m) }
                        Ok($payload) {
                            if cgkind_eq($payload, $want) { Ok($opkind) } else { Err(g3_unsupported()) }
                        }
                    }
                }
                Err($m0) {
                    match g5_question_option_carrier_of($recv, $env) {
                        Err($m) { Err($m) }
                        Ok($opkind) {
                            match g6_option_payload_kind($opkind) {
                                Err($m) { Err($m) }
                                Ok($payload) {
                                    if cgkind_eq($payload, $want) { Ok($opkind) } else { Err(g3_unsupported()) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Materialise a call-produced Option carrier receiver into a fresh carrier temp
# (the g5_question_bind_emit precedent: `goN = <carrier value>;`), mirroring
# native's shape for `chained(5).unwrap_or(-1)` (cc-captured: `gt0 = gf_chained(5LL);`
# then the SAME pure ternary the bound path emits). Scalar carriers own nothing,
# so the ternary borrows the slot exactly like the bound-local path.
sub g4_unwrap_or_call_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if g5_question_scalar_payload_supported($want) {
        match g4_unwrap_or_syntax($c, $a, $env) {
            Err($m) { Err($m) }
            Ok($s) {
                match g4_unwrap_or_call_carrier($want, $s.recv, $env) {
                    Err($m) { Err($m) }
                    Ok($opkind) {
                        match g6_option_value($opkind, $s.recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($cv) {
                                $qtmp = g4_value_tmp($opkind, $cv.state.ntmp)
                                $st1 = CgState(
                                    interns: $cv.state.interns,
                                    decls: $cv.state.decls ~ g4_value_decl($opkind, $qtmp),
                                    body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                    nstr: $cv.state.nstr,
                                    ntmp: $cv.state.ntmp + 1
                                )
                                match g4_lower_value($want, $s.dflt, $st1, $env) {
                                    Err($m) { Err($m) }
                                    Ok($dv) {
                                        Ok(CgValueOut(
                                            state: $dv.state,
                                            c: "(" ~ $qtmp ~ ".tag != 0 ? " ~ $qtmp ~ ".val : " ~ $dv.c ~ ")"
                                        ))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Str unwrap_or over a call-produced Option[Str] carrier. The materialised carrier
# temp OWNS its Some payload (g6_option_value hands back an owned carrier for a
# call), so after the bound-path retain/release ternary shape, the carrier's own
# payload slot is released too (g6_option_release) — refcounts balance on both
# arms (Some: payload +1 result, then carrier slot -1; None: default owned by the
# result, no carrier slot to drop).
sub g4_unwrap_or_str_call($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_unwrap_or_syntax($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($s) {
            match g4_unwrap_or_call_carrier(CgStr, $s.recv, $env) {
                Err($m) { Err($m) }
                Ok($opkind) {
                    match g6_option_value($opkind, $s.recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cv) {
                            $qtmp = g4_value_tmp($opkind, $cv.state.ntmp)
                            $st1 = CgState(
                                interns: $cv.state.interns,
                                decls: $cv.state.decls ~ g4_value_decl($opkind, $qtmp),
                                body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                nstr: $cv.state.nstr,
                                ntmp: $cv.state.ntmp + 1
                            )
                            match g3_str_lower($s.dflt, $st1, $env) {
                                Err($m) { Err($m) }
                                Ok($ds) {
                                    $st = $ds.state
                                    $tmp = "gt" ~ c_int($st.ntmp)
                                    Ok(StrLower(
                                        state: CgState(
                                            interns: $st.interns,
                                            decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                            body: $st.body ~
                                                "\t" ~ $tmp ~ " = guji_retain((" ~ $qtmp ~ ".tag != 0 ? " ~ $qtmp ~ ".val : " ~ $ds.tmp ~ "));\n" ~
                                                "\tguji_release(" ~ $ds.tmp ~ ");\n" ~
                                                g6_option_release(CgOptStr, $qtmp),
                                            nstr: $st.nstr,
                                            ntmp: $st.ntmp + 1
                                        ),
                                        tmp: $tmp
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Element-kind peel for `$o.unwrap_or(d)` / `unwrap_or($o, d)` over Option[List[V]]
# so `print(%m.get(k).unwrap_or([]))` resolves CgList without a TypeRef (P9-6b-3).
sub g4_unwrap_or_list_elem_kind($c: Expr, $a: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g4_unwrap_or_syntax($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($s) {
            match $s.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptList($el) { Ok($el) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ {
                    match g6_option_kind_from_value($s.recv, $env) {
                        Err($m) { Err($m) }
                        Ok($okind) {
                            match $okind {
                                CgOptList($el) { Ok($el) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Option[List] unwrap_or — owned-slice result (the g7_lower_list_value convention).
# Native borrows `(tag ? opt.val : dflt)` then releases both sources after the
# consumer; selfhost list values are owned temps, so mirror the Str call path:
# Some → result retains `.val.data`, then carrier release drops the get/+1;
# None → steal the lowered default into the result (null its `.data`) so the
# unconditional default release is a no-op. Bound locals keep their carrier for
# scope cleanup (retain only; no carrier release here).
sub g4_unwrap_or_list_from_carrier($elem: CgKind, $opt_c: Str, $dflt: Expr, $state: CgState, $env: CgEnv, $release_carrier: Bool): Result[CgValueOut, Str] {
    match g7_lower_list_value($elem, $dflt, $state, $env) {
        Err($m) { Err($m) }
        Ok($dv) {
            $st = $dv.state
            $out = g4_value_tmp(CgList($elem), $st.ntmp)
            $steal = "\t" ~ $out ~ " = " ~ $dv.c ~ ";\n\t" ~ $dv.c ~ ".data = NULL;\n\t" ~ $dv.c ~ ".len = 0;\n"
            $hit = "\t" ~ $out ~ " = " ~ $opt_c ~ ".val;\n\tguji_retain((const void*)" ~ $out ~ ".data);\n"
            $pick = "\tif (" ~ $opt_c ~ ".tag != 0LL) \{\n" ~ $hit ~ "\t} else \{\n" ~ $steal ~ "\t}\n"
            $crel = if $release_carrier {
                g6_option_release(CgOptList($elem), $opt_c)
            } else {
                ""
            }
            Ok(CgValueOut(
                state: CgState(
                    interns: $st.interns,
                    decls: $st.decls ~ g4_value_decl(CgList($elem), $out),
                    body: $st.body ~ $pick ~ g7_slice_release($dv.c) ~ $crel,
                    nstr: $st.nstr,
                    ntmp: $st.ntmp + 1
                ),
                c: $out
            ))
        }
    }
}

sub g4_unwrap_or_list($elem: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_unwrap_or_syntax($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($s) {
            match $s.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptList($el) {
                                    if cgkind_eq($el, $elem) {
                                        g4_unwrap_or_list_from_carrier($elem, $v.cname, $s.dflt, $state, $env, false)
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ {
                    match g6_option_kind_from_value($s.recv, $env) {
                        Err($m) { Err($m) }
                        Ok($okind) {
                            match $okind {
                                CgOptList($el) {
                                    if cgkind_eq($el, $elem) {
                                        match g6_option_value(CgOptList($elem), $s.recv, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($cv) {
                                                $qtmp = g4_value_tmp(CgOptList($elem), $cv.state.ntmp)
                                                $st1 = CgState(
                                                    interns: $cv.state.interns,
                                                    decls: $cv.state.decls ~ g4_value_decl(CgOptList($elem), $qtmp),
                                                    body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                                    nstr: $cv.state.nstr,
                                                    ntmp: $cv.state.ntmp + 1
                                                )
                                                g4_unwrap_or_list_from_carrier($elem, $qtmp, $s.dflt, $st1, $env, true)
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# True iff a bound Option carrier kind's PAYLOAD is exactly the wanted value kind.
# Only the scalar/Str VALUE carriers participate.
sub g4_unwrap_or_kind_ok($want: CgKind, $optkind: CgKind): Bool {
    match $optkind {
        CgOptInt { match $want { CgInt { true } _ { false } } }
        CgOptFloat { match $want { CgFloat { true } _ { false } } }
        CgOptBool { match $want { CgBool { true } _ { false } } }
        CgOptStr { match $want { CgStr { true } _ { false } } }
        _ { false }
    }
}

# Scalar (Int/Float/Bool) unwrap_or: the native pure ternary. The default is lowered
# in the payload's own value position; state threads through the default only.
sub g4_unwrap_or_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_unwrap_or_parts($c, $a, $env) {
        Err($m) { g4_unwrap_or_call_value($want, $c, $a, $state, $env) }
        Ok($p) {
            if g4_unwrap_or_kind_ok($want, $p.v.kind) {
                match g4_lower_value($want, $p.dflt, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($dv) {
                        Ok(CgValueOut(
                            state: $dv.state,
                            c: "(" ~ $p.v.cname ~ ".tag != 0 ? " ~ $p.v.cname ~ ".val : " ~ $dv.c ~ ")"
                        ))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# Str unwrap_or: the default lowers to an owned tmp first; the result tmp retains
# the picked pointer and the default tmp is released unconditionally (see the
# ownership note above). Kept OUT of g4_unwrap_or_value because the generic
# CgStr value path hands back an owned tmp that a bare ternary would leak.
sub g4_unwrap_or_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_unwrap_or_parts($c, $a, $env) {
        Err($m) { g4_unwrap_or_str_call($c, $a, $state, $env) }
        Ok($p) {
            if g4_unwrap_or_kind_ok(CgStr, $p.v.kind) {
                match g3_str_lower($p.dflt, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($ds) {
                        $st = $ds.state
                        $tmp = "gt" ~ c_int($st.ntmp)
                        Ok(StrLower(
                            state: CgState(
                                interns: $st.interns,
                                decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                body: $st.body ~
                                    "\t" ~ $tmp ~ " = guji_retain((" ~ $p.v.cname ~ ".tag != 0 ? " ~ $p.v.cname ~ ".val : " ~ $ds.tmp ~ "));\n" ~
                                    "\tguji_release(" ~ $ds.tmp ~ ");\n",
                                nstr: $st.nstr,
                                ntmp: $st.ntmp + 1
                            ),
                            tmp: $tmp
                        ))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# §15.5 `unwrap_or($r, $d)` / `$r.unwrap_or($d)` over a bound `Result[T,E]`
# local with a scalar/Str Ok payload. Result's native tag polarity is the inverse
# of Option's Some test: tag 0 means Ok, and the payload lives in `.ok`.
sub g4_result_unwrap_or_kind_ok($want: CgKind, $reskind: CgKind): Bool {
    match $reskind {
        CgRes($ok, $err) { cgkind_eq($want, $ok) }
        _ { false }
    }
}

sub g4_result_unwrap_or_else_recv($want: CgKind, $recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    if g4_result_unwrap_or_kind_ok($want, $v.kind) {
                        match $v.kind {
                            CgRes($ok, $err) {
                                if g6_ok_or_err_supported($err) { Ok($v) } else { Err(g3_unsupported()) }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

class ResultUnwrapOrElseParts {
    has $.v: CgVar
    has $.lam: Expr
}

sub g4_result_unwrap_or_else_parts($want: CgKind, $c: Expr, $a: ExprList, $env: CgEnv): Result[ResultUnwrapOrElseParts, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap_or_else" {
                match $a {
                    ExprCons($lam, ExprNil) {
                        match g4_result_unwrap_or_else_recv($want, $recv, $env) {
                            Err($m) { Err($m) }
                            Ok($v) { Ok(ResultUnwrapOrElseParts(v: $v, lam: $lam)) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "unwrap_or_else" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprCons($lam, ExprNil)) {
                                match g4_result_unwrap_or_else_recv($want, $recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($v) { Ok(ResultUnwrapOrElseParts(v: $v, lam: $lam)) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_result_unwrap_or_else_err_kind($v: CgVar): Result[CgKind, Str] {
    match $v.kind {
        CgRes($ok, $err) { Ok($err) }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_result_unwrap_or_else_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_result_unwrap_or_else_parts($want, $c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g4_result_unwrap_or_else_err_kind($p.v) {
                Err($m) { Err($m) }
                Ok($err) {
                    match $p.lam {
                        ELambda($params, $ret, $body, $topic) {
                            match g7_lambda_body_expr($body) {
                                Err($m) { Err($m) }
                                Ok($expr) {
                                    $tmp = g4_value_tmp($want, $state.ntmp)
                                    $binder = g4_value_tmp($err, $state.ntmp + 1)
                                    match g7_lambda_env($params, $err, $binder, $env) {
                                        Err($m) { Err($m) }
                                        Ok($lenv) {
                                            $else_start = CgState(
                                                interns: $state.interns,
                                                decls: $state.decls ~ g4_value_decl($want, $tmp) ~ g4_value_decl($err, $binder),
                                                body: "",
                                                nstr: $state.nstr,
                                                ntmp: $state.ntmp + 2
                                            )
                                            match g4_lower_value($want, $expr, $else_start, $lenv) {
                                                Err($m) { Err($m) }
                                                Ok($fb) {
                                                    Ok(CgValueOut(
                                                        state: CgState(
                                                            interns: $fb.state.interns,
                                                            decls: $fb.state.decls,
                                                            body: $state.body ~
                                                                "\tif (" ~ $p.v.cname ~ ".tag == 0) \{\n" ~
                                                                "\t\t" ~ $tmp ~ " = " ~ $p.v.cname ~ ".ok;\n" ~
                                                                "\t} else \{\n" ~
                                                                "\t\t" ~ $binder ~ " = " ~ $p.v.cname ~ ".err;\n" ~
                                                                $fb.state.body ~
                                                                "\t\t" ~ $tmp ~ " = " ~ $fb.c ~ ";\n" ~
                                                                "\t}\n",
                                                            nstr: $fb.state.nstr,
                                                            ntmp: $fb.state.ntmp
                                                        ),
                                                        c: $tmp
                                                    ))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g4_result_unwrap_or_else_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_result_unwrap_or_else_parts(CgStr, $c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g4_result_unwrap_or_else_err_kind($p.v) {
                Err($m) { Err($m) }
                Ok($err) {
                    match $p.lam {
                        ELambda($params, $ret, $body, $topic) {
                            match g7_lambda_body_expr($body) {
                                Err($m) { Err($m) }
                                Ok($expr) {
                                    $tmp = "gt" ~ c_int($state.ntmp)
                                    $binder = g4_value_tmp($err, $state.ntmp + 1)
                                    match g7_lambda_env($params, $err, $binder, $env) {
                                        Err($m) { Err($m) }
                                        Ok($lenv) {
                                            $else_start = CgState(
                                                interns: $state.interns,
                                                decls: $state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n" ~ g4_value_decl($err, $binder),
                                                body: "",
                                                nstr: $state.nstr,
                                                ntmp: $state.ntmp + 2
                                            )
                                            match g3_str_lower($expr, $else_start, $lenv) {
                                                Err($m) { Err($m) }
                                                Ok($fb) {
                                                    Ok(StrLower(
                                                        state: CgState(
                                                            interns: $fb.state.interns,
                                                            decls: $fb.state.decls,
                                                            body: $state.body ~
                                                                "\tif (" ~ $p.v.cname ~ ".tag == 0) \{\n" ~
                                                                "\t\t" ~ $tmp ~ " = guji_retain(" ~ $p.v.cname ~ ".ok);\n" ~
                                                                "\t} else \{\n" ~
                                                                "\t\t" ~ $binder ~ " = " ~ $p.v.cname ~ ".err;\n" ~
                                                                $fb.state.body ~
                                                                "\t\t" ~ $tmp ~ " = " ~ $fb.tmp ~ ";\n" ~
                                                                "\t}\n",
                                                            nstr: $fb.state.nstr,
                                                            ntmp: $fb.state.ntmp
                                                        ),
                                                        tmp: $tmp
                                                    ))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# P6f-unwrap-or: resolve a FRESH Result carrier receiver (call / Regex.compile /
# parse_int / …) whose Ok payload is exactly `$want`. Bound EName locals decline
# here — the borrow path above already owns that shape (mirrors
# g4_unwrap_or_call_carrier for Option).
sub g4_result_unwrap_or_call_carrier($want: CgKind, $recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $recv {
        EName($n) { Err(g3_unsupported()) }
        _ {
            match g6_result_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($reskind) {
                    if g4_result_unwrap_or_kind_ok($want, $reskind) {
                        match $reskind {
                            CgRes($ok, $err) {
                                if g6_ok_or_err_supported($err) { Ok($reskind) } else { Err(g3_unsupported()) }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

# Scalar Result unwrap_or over a call-produced carrier. Materialise into a
# carrier temp, pick into a value tmp, then release the carrier (Result[T,Str]
# owns an Err string — a pure ternary would leak it; native releases after the
# use site, which is equivalent once the pick is saved).
sub g4_result_unwrap_or_call_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if g5_question_scalar_payload_supported($want) {
        match g4_unwrap_or_syntax($c, $a, $env) {
            Err($m) { Err($m) }
            Ok($s) {
                match g4_result_unwrap_or_call_carrier($want, $s.recv, $env) {
                    Err($m) { Err($m) }
                    Ok($reskind) {
                        match g6_result_value($reskind, $s.recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($cv) {
                                $qtmp = g4_value_tmp($reskind, $cv.state.ntmp)
                                $st1 = CgState(
                                    interns: $cv.state.interns,
                                    decls: $cv.state.decls ~ g4_value_decl($reskind, $qtmp),
                                    body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                    nstr: $cv.state.nstr,
                                    ntmp: $cv.state.ntmp + 1
                                )
                                match g4_lower_value($want, $s.dflt, $st1, $env) {
                                    Err($m) { Err($m) }
                                    Ok($dv) {
                                        $vtmp = g4_value_tmp($want, $dv.state.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $dv.state.interns,
                                                decls: $dv.state.decls ~ g4_value_decl($want, $vtmp),
                                                body: $dv.state.body ~
                                                    "\t" ~ $vtmp ~ " = (" ~ $qtmp ~ ".tag == 0 ? " ~ $qtmp ~ ".ok : " ~ $dv.c ~ ");\n" ~
                                                    g6_result_release($reskind, $qtmp),
                                                nstr: $dv.state.nstr,
                                                ntmp: $dv.state.ntmp + 1
                                            ),
                                            c: $vtmp
                                        ))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Str/Regex Result unwrap_or over a call-produced carrier (e.g.
# `Regex.compile(x).unwrap_or($fb)`). Retain the pick, release the eager default,
# then release the consumed carrier — same ownership as g4_unwrap_or_str_call /
# g4_result_unwrap_fresh_str.
sub g4_result_unwrap_or_str_call($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_unwrap_or_syntax($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($s) {
            match g4_result_unwrap_or_call_carrier(CgStr, $s.recv, $env) {
                Err($m) { Err($m) }
                Ok($reskind) {
                    match g6_result_value($reskind, $s.recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cv) {
                            $qtmp = g4_value_tmp($reskind, $cv.state.ntmp)
                            $st1 = CgState(
                                interns: $cv.state.interns,
                                decls: $cv.state.decls ~ g4_value_decl($reskind, $qtmp),
                                body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                nstr: $cv.state.nstr,
                                ntmp: $cv.state.ntmp + 1
                            )
                            match g3_str_lower($s.dflt, $st1, $env) {
                                Err($m) { Err($m) }
                                Ok($ds) {
                                    $st = $ds.state
                                    $tmp = "gt" ~ c_int($st.ntmp)
                                    Ok(StrLower(
                                        state: CgState(
                                            interns: $st.interns,
                                            decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                            body: $st.body ~
                                                "\t" ~ $tmp ~ " = guji_retain((" ~ $qtmp ~ ".tag == 0 ? " ~ $qtmp ~ ".ok : " ~ $ds.tmp ~ "));\n" ~
                                                "\tguji_release(" ~ $ds.tmp ~ ");\n" ~
                                                g6_result_release($reskind, $qtmp),
                                            nstr: $st.nstr,
                                            ntmp: $st.ntmp + 1
                                        ),
                                        tmp: $tmp
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g4_result_unwrap_or_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_unwrap_or_parts($c, $a, $env) {
        Err($m) { g4_result_unwrap_or_call_value($want, $c, $a, $state, $env) }
        Ok($p) {
            if g4_result_unwrap_or_kind_ok($want, $p.v.kind) {
                match g4_lower_value($want, $p.dflt, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($dv) {
                        Ok(CgValueOut(
                            state: $dv.state,
                            c: "(" ~ $p.v.cname ~ ".tag == 0 ? " ~ $p.v.cname ~ ".ok : " ~ $dv.c ~ ")"
                        ))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g4_result_unwrap_or_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_unwrap_or_parts($c, $a, $env) {
        Err($m) { g4_result_unwrap_or_str_call($c, $a, $state, $env) }
        Ok($p) {
            if g4_result_unwrap_or_kind_ok(CgStr, $p.v.kind) {
                match g3_str_lower($p.dflt, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($ds) {
                        $st = $ds.state
                        $tmp = "gt" ~ c_int($st.ntmp)
                        Ok(StrLower(
                            state: CgState(
                                interns: $st.interns,
                                decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                body: $st.body ~
                                    "\t" ~ $tmp ~ " = guji_retain((" ~ $p.v.cname ~ ".tag == 0 ? " ~ $p.v.cname ~ ".ok : " ~ $ds.tmp ~ "));\n" ~
                                    "\tguji_release(" ~ $ds.tmp ~ ");\n",
                                nstr: $st.nstr,
                                ntmp: $st.ntmp + 1
                            ),
                            tmp: $tmp
                        ))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# §15.5 Option `unwrap`/`expect` — extract the `Some` payload or PANIC. Native
# lowers `unwrap($o)`/`$o.unwrap()` to a guard statement plus the borrowed payload:
#   if (opt.tag == 0) { guji_panic("unwrap on None"); }
#   <value> = opt.val
# and `expect($o, $msg)`/`$o.expect($msg)` to the same guard with the user message:
#   if (opt.tag == 0) { guji_panic(<msg>); }
# The panic message text and exit behaviour come from the shared `guji_panic`
# runtime, so a triggering fixture is three-way (native == selfhost byte-identical
# stderr; interp errored-ness consistent). Scalar payloads return the borrowed
# `opt.val` directly; a Str payload retains it into an owned tmp (the selfhost
# StrLower convention), balanced by the consumer's release. Class/enum/list
# payloads and boxed carriers decline (they are not value carriers). The result of
# the guard step: the threaded state plus the receiver's C name.
class UnwrapGuard {
    has $.state: CgState
    has $.cname: Str
}

# Resolve the receiver to a bound Option VALUE carrier whose payload kind is
# exactly `$want`; decline anything else (dynamic receivers, boxed carriers,
# payload-kind mismatch) so inference stays exact.
sub g4_unwrap_recv($want: CgKind, $recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    if g4_unwrap_or_kind_ok($want, $v.kind) { Ok($v) } else { Err(g3_unsupported()) }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# `unwrap`: emit the fixed-message None guard (native "unwrap on None").
sub g4_unwrap_do($want: CgKind, $recv: Expr, $state: CgState, $env: CgEnv): Result[UnwrapGuard, Str] {
    match g4_unwrap_recv($want, $recv, $env) {
        Err($m) { Err($m) }
        Ok($v) {
            Ok(UnwrapGuard(
                state: CgState(
                    interns: $state.interns,
                    decls: $state.decls,
                    body: $state.body ~ "\tif (" ~ $v.cname ~ ".tag == 0) \{ guji_panic(\"unwrap on None\"); }\n",
                    nstr: $state.nstr,
                    ntmp: $state.ntmp
                ),
                cname: $v.cname
            ))
        }
    }
}

# `expect`: lower the Str message EAGERLY (matching interp argument evaluation),
# guard on it, then release the owned message tmp on the SUCCESS path (the panic
# path never returns, so the message is consumed by `guji_panic` there). Native
# leaves the message live; the extra selfhost release is invisible (stdout/stderr/
# exit unchanged) and keeps the owned tmp balanced.
sub g4_expect_do($want: CgKind, $recv: Expr, $msg: Expr, $state: CgState, $env: CgEnv): Result[UnwrapGuard, Str] {
    match g4_unwrap_recv($want, $recv, $env) {
        Err($m) { Err($m) }
        Ok($v) {
            match g3_str_lower($msg, $state, $env) {
                Err($m) { Err($m) }
                Ok($ms) {
                    $st = $ms.state
                    Ok(UnwrapGuard(
                        state: CgState(
                            interns: $st.interns,
                            decls: $st.decls,
                            body: $st.body ~
                                "\tif (" ~ $v.cname ~ ".tag == 0) \{ guji_panic(" ~ $ms.tmp ~ "); }\n" ~
                                "\tguji_release(" ~ $ms.tmp ~ ");\n",
                            nstr: $st.nstr,
                            ntmp: $st.ntmp
                        ),
                        cname: $v.cname
                    ))
                }
            }
        }
    }
}

# Match both spellings for both helpers — method `$o.unwrap()`/`$o.expect($m)`
# (callee EField) and function `unwrap($o)`/`expect($o, $m)` (callee EName). A user
# `sub unwrap`/`sub expect` shadows the FUNCTION form (defer to the general call
# path); the method form is a call on the Option value, so no shadow can apply.
sub g4_option_unwrap_guard($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[UnwrapGuard, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap" {
                match $a {
                    ExprNil { g4_unwrap_do($want, $recv, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                if $method == "expect" {
                    match $a {
                        ExprCons($msg, ExprNil) { g4_expect_do($want, $recv, $msg, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        EName($fn) {
            if $fn == "unwrap" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprNil) { g4_unwrap_do($want, $recv, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                if $fn == "expect" {
                    match cg_env_lookup_sub($env, $fn) {
                        Some($sig) { Err(g3_unsupported()) }
                        None {
                            match $a {
                                ExprCons($recv, ExprCons($msg, ExprNil)) { g4_expect_do($want, $recv, $msg, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Scalar (Int/Float/Bool) unwrap/expect: emit the guard, then read the borrowed
# `opt.val` directly (no retain/release — the payload is a scalar). A non-name
# receiver (`$ch.recv().unwrap()`, P8d-2c-3d) takes the fresh-carrier path.
sub g4_option_unwrap_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_option_unwrap_guard($want, $c, $a, $state, $env) {
        Err($m) { g4_option_unwrap_fresh_scalar($want, $c, $a, $state, $env) }
        Ok($g) { Ok(CgValueOut(state: $g.state, c: $g.cname ~ ".val")) }
    }
}

# A fresh (non-name) carrier extraction call, both helpers and both spellings:
# method `$o.unwrap()` / `$o.expect($m)` and function `unwrap($o)` / `expect($o,
# $m)` (user-sub shadows defer the function form, mirroring the bound-carrier
# matcher above). `msg` is None for unwrap, Some(message expr) for expect.
class FreshUnwrapParts {
    has $.recv: Expr
    has $.msg: Option[Expr]
}

sub g4_option_unwrap_fresh_parts($c: Expr, $a: ExprList, $env: CgEnv): Result[FreshUnwrapParts, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap" {
                match $a {
                    ExprNil { Ok(FreshUnwrapParts(recv: $recv, msg: None)) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                if $method == "expect" {
                    match $a {
                        ExprCons($msg, ExprNil) { Ok(FreshUnwrapParts(recv: $recv, msg: Some($msg))) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        EName($fn) {
            if $fn == "unwrap" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprNil) { Ok(FreshUnwrapParts(recv: $recv, msg: None)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                if $fn == "expect" {
                    match cg_env_lookup_sub($env, $fn) {
                        Some($sig) { Err(g3_unsupported()) }
                        None {
                            match $a {
                                ExprCons($recv, ExprCons($msg, ExprNil)) { Ok(FreshUnwrapParts(recv: $recv, msg: Some($msg))) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Append the None guard for a FRESH carrier temp. unwrap panics with the fixed
# native message; expect lowers its Str message EAGERLY (interp argument order,
# matching g4_expect_do), panics with the owned tmp on None, and releases it on
# the success path (guji_panic never returns, so the panic path consumes it).
sub g4_fresh_unwrap_guard_state($carrier: Str, $msg: Option[Expr], $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $msg {
        None {
            Ok(CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ "\tif (" ~ $carrier ~ ".tag == 0) \{ guji_panic(\"unwrap on None\"); }\n",
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ))
        }
        Some($m) {
            match g3_str_lower($m, $state, $env) {
                Err($e) { Err($e) }
                Ok($ms) {
                    $st = $ms.state
                    Ok(CgState(
                        interns: $st.interns,
                        decls: $st.decls,
                        body: $st.body ~
                            "\tif (" ~ $carrier ~ ".tag == 0) \{ guji_panic(" ~ $ms.tmp ~ "); }\n" ~
                            "\tguji_release(" ~ $ms.tmp ~ ");\n",
                        nstr: $st.nstr,
                        ntmp: $st.ntmp
                    ))
                }
            }
        }
    }
}

# Fresh (non-name) Option[scalar] unwrap/expect — `$ch.recv().unwrap()` and
# friends (P8d-2c-3d). The carrier is a plain by-value struct, so after the
# guard the payload reads straight off `.val` with no retain/release (native:
# recv fill, `if (tag == 0) guji_panic(...)`, then a direct `.val` read).
# Owned-payload carriers (Str) use the consuming path below instead.
sub g4_option_unwrap_fresh_scalar($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if g5_question_scalar_payload_supported($want) {
        match g4_option_unwrap_fresh_parts($c, $a, $env) {
            Err($m) { Err($m) }
            Ok($p) {
                match g6_option_kind_from_value($p.recv, $env) {
                    Err($m) { Err($m) }
                    Ok($okind) {
                        if g4_unwrap_or_kind_ok($want, $okind) {
                            match g6_option_value($okind, $p.recv, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($fresh) {
                                    match g4_fresh_unwrap_guard_state($fresh.c, $p.msg, $fresh.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($st) { Ok(CgValueOut(state: $st, c: $fresh.c ~ ".val")) }
                                    }
                                }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Unwrap the OUTER receive-presence carrier for Option channel elements
# (`Option[Option[T]] -> Option[T]`). A scalar inner Option is a by-value struct
# that owns no heap, so extraction is the same native plain `.val` copy as scalar
# payloads, one carrier level higher. A COUNTED inner (Option[Str] or
# Option[List]) mirrors native's ownership dance instead: retain the delivered
# payload out into an owned inner-carrier temp, then release the fresh outer
# carrier's slot.
sub g4_option_unwrap_fresh_carrier($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_option_unwrap_fresh_parts($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_kind_from_value($p.recv, $env) {
                Err($m) { Err($m) }
                Ok($outer) {
                    match $outer {
                        CgOptCarrier($inner) {
                            if cgkind_eq($want, $inner) {
                                match g6_option_value($outer, $p.recv, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($fresh) {
                                        match g4_fresh_unwrap_guard_state($fresh.c, $p.msg, $fresh.state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($st) {
                                                match $inner {
                                                    CgOptStr {
                                                        $tmp = g4_value_tmp(CgOptStr, $st.ntmp)
                                                        match $p.recv {
                                                            # A held recv carrier keeps its detached
                                                            # message until scope exit. Retain the inner
                                                            # Option[Str] result, but do not release or
                                                            # NULL the still-live outer local.
                                                            EName($hn) {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl(CgOptStr, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            g6_option_retain(CgOptStr, $tmp),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                            _ {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl(CgOptStr, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            g6_option_retain(CgOptStr, $tmp) ~
                                                                            g6_option_release(CgOptCarrier(CgOptStr), $fresh.c),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                        }
                                                    }
                                                    # Chan[Option[Match]] recv unwrap: same retain-out
                                                    # split as Option[Str] — the Match pointer is counted,
                                                    # so a plain `.val` copy without retain double-frees
                                                    # against the outer OptCarrier scope release.
                                                    CgOptMatch {
                                                        $tmp = g4_value_tmp(CgOptMatch, $st.ntmp)
                                                        match $p.recv {
                                                            EName($hn) {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl(CgOptMatch, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            g6_option_retain(CgOptMatch, $tmp),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                            _ {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl(CgOptMatch, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            g6_option_retain(CgOptMatch, $tmp) ~
                                                                            g6_option_release(CgOptCarrier(CgOptMatch), $fresh.c),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                        }
                                                    }
                                                    CgOptList($el) {
                                                        $tmp = g4_value_tmp(CgOptList($el), $st.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st.interns,
                                                                decls: $st.decls ~ g4_value_decl(CgOptList($el), $tmp),
                                                                body: $st.body ~
                                                                    "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                    g6_option_retain(CgOptList($el), $tmp) ~
                                                                    g6_option_release(CgOptCarrier(CgOptList($el)), $fresh.c),
                                                                nstr: $st.nstr,
                                                                ntmp: $st.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    CgOptMap($mv) {
                                                        $tmp = g4_value_tmp(CgOptMap($mv), $st.ntmp)
                                                        Ok(CgValueOut(
                                                            state: CgState(
                                                                interns: $st.interns,
                                                                decls: $st.decls ~ g4_value_decl(CgOptMap($mv), $tmp),
                                                                body: $st.body ~
                                                                    "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                    g6_option_retain(CgOptMap($mv), $tmp) ~
                                                                    g6_option_release(CgOptCarrier(CgOptMap($mv)), $fresh.c),
                                                                nstr: $st.nstr,
                                                                ntmp: $st.ntmp + 1
                                                            ),
                                                            c: $tmp
                                                        ))
                                                    }
                                                    # Chan[Result] recv unwrap: retain active Str
                                                    # slots out of the Option[Result]. Fresh outer
                                                    # carriers release after the retain-out; bound
                                                    # `$held.unwrap()` keeps the Option local for
                                                    # scope-exit ownership (native's split).
                                                    CgRes($ok, $err) {
                                                        $rk = CgRes($ok, $err)
                                                        $tmp = g4_value_tmp($rk, $st.ntmp)
                                                        match $p.recv {
                                                            EName($hn) {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl($rk, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            g6_result_retain($rk, $tmp),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                            _ {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl($rk, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            g6_result_retain($rk, $tmp) ~
                                                                            g6_option_release(CgOptCarrier($rk), $fresh.c),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                        }
                                                    }
                                                    # Chan[Func] recv unwrap transfers a
                                                    # detached closure pair out of the outer
                                                    # Option.  The result gets its own +1;
                                                    # a fresh outer carrier then drops the
                                                    # message ownership it adopted.
                                                    CgFn($fp, $fr) {
                                                        $fk = CgFn($fp, $fr)
                                                        $tmp = g4_value_tmp($fk, $st.ntmp)
                                                        match $p.recv {
                                                            EName($hn) {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl($fk, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            "\tguji_retain(" ~ $tmp ~ ".env);\n",
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                            _ {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $st.interns,
                                                                        decls: $st.decls ~ g4_value_decl($fk, $tmp),
                                                                        body: $st.body ~
                                                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                                            "\tguji_retain(" ~ $tmp ~ ".env);\n" ~
                                                                            g6_option_release(CgOptCarrier($fk), $fresh.c),
                                                                        nstr: $st.nstr,
                                                                        ntmp: $st.ntmp + 1
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                        }
                                                    }
                                                    _ { Ok(CgValueOut(state: $st, c: $fresh.c ~ ".val")) }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# Str unwrap/expect from a FRESH Option[Str] expression.  Unlike a named carrier
# binding, a Match capture (`$m<name>` / `$m[index]`) materialises a temporary
# `guji_opt_str` which owns its Some payload.  Retain the payload before dropping
# that carrier: the returned StrLower owns the retained reference, and the capture
# carrier is consumed exactly once.  This also admits other fresh Option[Str]
# expressions without confusing their ownership with a borrowed local.
sub g4_option_unwrap_fresh_recv($c: Expr, $a: ExprList, $env: CgEnv): Result[Expr, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap" {
                match $a {
                    ExprNil { Ok($recv) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "unwrap" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprNil) { Ok($recv) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_option_unwrap_fresh_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_option_unwrap_guard(CgStr, $c, $a, $state, $env) {
        Ok($bound) {
            $st = $bound.state
            $tmp = "gt" ~ c_int($st.ntmp)
            Ok(StrLower(
                state: CgState(
                    interns: $st.interns,
                    decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                    body: $st.body ~ "\t" ~ $tmp ~ " = guji_retain(" ~ $bound.cname ~ ".val);\n",
                    nstr: $st.nstr,
                    ntmp: $st.ntmp + 1
                ),
                tmp: $tmp
            ))
        }
        Err($not_bound) {
            match g4_option_unwrap_fresh_parts($c, $a, $env) {
                Err($m) { Err($m) }
                Ok($p) {
                    match g6_option_kind_from_value($p.recv, $env) {
                        Ok($kind) {
                            match $kind {
                                CgOptStr {
                                    match g6_option_value(CgOptStr, $p.recv, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($fresh) {
                                    match g4_fresh_unwrap_guard_state($fresh.c, $p.msg, $fresh.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($gst) {
                                            $tmp = "gt" ~ c_int($gst.ntmp)
                                            Ok(StrLower(
                                                state: CgState(
                                                    interns: $gst.interns,
                                                    decls: $gst.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                                    body: $gst.body ~
                                                        "\t" ~ $tmp ~ " = guji_retain(" ~ $fresh.c ~ ".val);\n" ~
                                                        g6_option_release(CgOptStr, $fresh.c),
                                                    nstr: $gst.nstr,
                                                    ntmp: $gst.ntmp + 1
                                                ),
                                                tmp: $tmp
                                            ))
                                        }
                                    }
                                }
                            }
                        }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        Err($m) { Err($m) }
                    }
                }
            }
        }
    }
}

# Str unwrap/expect: named carriers retain their borrowed `opt.val` into an
# owned tmp (the selfhost StrLower convention). Fresh Option[Str] expressions
# instead use the consuming path above so their carrier temp is released.
sub g4_option_unwrap_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_option_unwrap_guard(CgStr, $c, $a, $state, $env) {
        Err($m) { g4_option_unwrap_fresh_str($c, $a, $state, $env) }
        Ok($g) {
            $st = $g.state
            $tmp = "gt" ~ c_int($st.ntmp)
            Ok(StrLower(
                state: CgState(
                    interns: $st.interns,
                    decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                    body: $st.body ~ "\t" ~ $tmp ~ " = guji_retain(" ~ $g.cname ~ ".val);\n",
                    nstr: $st.nstr,
                    ntmp: $st.ntmp + 1
                ),
                tmp: $tmp
            ))
        }
    }
}

# Fresh Option[List] unwrap/expect (P8d-2c-3d-2a): after the None guard, adopt
# `.val` into an owned slice temp, retain its `.data`, then release+NULL the
# fresh carrier slot — the Str fresh path's retain-out / carrier-release pair,
# applied to the list storage pointer. Bound Option[List] locals keep their
# carrier for scope cleanup, so they only retain into the result temp.
sub g4_option_unwrap_fresh_list_from_parts($elem: CgKind, $p: FreshUnwrapParts, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_kind_from_value($p.recv, $env) {
        Err($m) { Err($m) }
        Ok($okind) {
            match $okind {
                CgOptList($el) {
                    if cgkind_eq($el, $elem) {
                        match g6_option_value(CgOptList($elem), $p.recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($fresh) {
                                match g4_fresh_unwrap_guard_state($fresh.c, $p.msg, $fresh.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($gst) {
                                        $tmp = g4_value_tmp(CgList($elem), $gst.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $gst.interns,
                                                decls: $gst.decls ~ g4_value_decl(CgList($elem), $tmp),
                                                body: $gst.body ~
                                                    "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                    "\tguji_retain((const void*)" ~ $tmp ~ ".data);\n" ~
                                                    g6_option_release(CgOptList($elem), $fresh.c),
                                                nstr: $gst.nstr,
                                                ntmp: $gst.ntmp + 1
                                            ),
                                            c: $tmp
                                        ))
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g4_option_unwrap_list($elem: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_option_unwrap_fresh_parts($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptList($el) {
                                    if cgkind_eq($el, $elem) {
                                        match g4_fresh_unwrap_guard_state($v.cname, $p.msg, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($gst) {
                                                $tmp = g4_value_tmp(CgList($elem), $gst.ntmp)
                                                Ok(CgValueOut(
                                                    state: CgState(
                                                        interns: $gst.interns,
                                                        decls: $gst.decls ~ g4_value_decl(CgList($elem), $tmp),
                                                        body: $gst.body ~
                                                            "\t" ~ $tmp ~ " = " ~ $v.cname ~ ".val;\n" ~
                                                            "\tguji_retain((const void*)" ~ $tmp ~ ".data);\n",
                                                        nstr: $gst.nstr,
                                                        ntmp: $gst.ntmp + 1
                                                    ),
                                                    c: $tmp
                                                ))
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ { g4_option_unwrap_fresh_list_from_parts($elem, $p, $state, $env) }
            }
        }
    }
}

# Element-kind peel for `$ch.recv().unwrap()` / `expect` / function spellings so
# an unannotated `@ys = …` bind can resolve CgList without a TypeRef.
sub g4_option_unwrap_list_elem_kind($c: Expr, $a: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g4_option_unwrap_fresh_parts($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptList($el) { Ok($el) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ {
                    match g6_option_kind_from_value($p.recv, $env) {
                        Err($m) { Err($m) }
                        Ok($okind) {
                            match $okind {
                                CgOptList($el) { Ok($el) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Fresh Option[Map] unwrap/expect (P8d-2c-3d-2b): after the None guard, adopt
# `.val` into an owned guji_map_t temp, retain BOTH counted arrays (keys and
# vals — a map owns two-array storage where a list owns one), then release+NULL
# the fresh carrier slot. This is the List fresh path's retain-out /
# carrier-release pair applied to the map's paired storage; the runtime KIND
# tags on each array cascade ownership through nested row values. Bound
# Option[Map] locals keep their carrier for scope cleanup, so the bound path
# below only retains into the result temp.
sub g4_option_unwrap_fresh_map_from_parts($val: CgKind, $p: FreshUnwrapParts, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_kind_from_value($p.recv, $env) {
        Err($m) { Err($m) }
        Ok($okind) {
            match $okind {
                CgOptMap($v) {
                    if cgkind_eq($v, $val) {
                        match g6_option_value(CgOptMap($val), $p.recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($fresh) {
                                match g4_fresh_unwrap_guard_state($fresh.c, $p.msg, $fresh.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($gst) {
                                        $tmp = g4_value_tmp(CgMap($val), $gst.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $gst.interns,
                                                decls: $gst.decls ~ g4_value_decl(CgMap($val), $tmp),
                                                body: $gst.body ~
                                                    "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n" ~
                                                    "\tguji_retain((const void*)" ~ $tmp ~ ".keys);\n" ~
                                                    "\tguji_retain((const void*)" ~ $tmp ~ ".vals);\n" ~
                                                    g6_option_release(CgOptMap($val), $fresh.c),
                                                nstr: $gst.nstr,
                                                ntmp: $gst.ntmp + 1
                                            ),
                                            c: $tmp
                                        ))
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g4_option_unwrap_map($val: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_option_unwrap_fresh_parts($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptMap($mv) {
                                    if cgkind_eq($mv, $val) {
                                        match g4_fresh_unwrap_guard_state($v.cname, $p.msg, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($gst) {
                                                $tmp = g4_value_tmp(CgMap($val), $gst.ntmp)
                                                Ok(CgValueOut(
                                                    state: CgState(
                                                        interns: $gst.interns,
                                                        decls: $gst.decls ~ g4_value_decl(CgMap($val), $tmp),
                                                        body: $gst.body ~
                                                            "\t" ~ $tmp ~ " = " ~ $v.cname ~ ".val;\n" ~
                                                            "\tguji_retain((const void*)" ~ $tmp ~ ".keys);\n" ~
                                                            "\tguji_retain((const void*)" ~ $tmp ~ ".vals);\n",
                                                        nstr: $gst.nstr,
                                                        ntmp: $gst.ntmp + 1
                                                    ),
                                                    c: $tmp
                                                ))
                                            }
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ { g4_option_unwrap_fresh_map_from_parts($val, $p, $state, $env) }
            }
        }
    }
}

# Value-kind peel for `%m = $ch.recv().unwrap()` / `expect` / the function
# spellings so an unannotated map bind can resolve CgMap(V) without a TypeRef.
sub g4_option_unwrap_map_val_kind($c: Expr, $a: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g4_option_unwrap_fresh_parts($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptMap($mv) { Ok($mv) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ {
                    match g6_option_kind_from_value($p.recv, $env) {
                        Err($m) { Err($m) }
                        Ok($okind) {
                            match $okind {
                                CgOptMap($mv) { Ok($mv) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# True iff `$ename` is a registered enum whose fields sit inside the channel
# boundary (scalar, Str, or flat List/Map — g11_chan_enum_field_supported).
# Recursive-box graphs stay out until their clone helpers are ported.
sub g4_option_unwrap_enum_supported($ename: Str, $env: CgEnv): Bool {
    match cg_env_lookup_enum($env, $ename) {
        None { false }
        Some($info) { g11_chan_enum_fields_supported($info.variants) }
    }
}

# Fresh Option[scalar-enum] unwrap/expect (P8d-2c-3d-2c): after the None guard,
# materialize `.val` into a named enum temp by plain struct copy. Native does the
# same so downstream match/bind can resolve the enum via a named C local — no
# retain (scalar owns no heap) and no carrier release (native leaves the Option
# temp; scalar OptEnum cleanup is a no-op). Bound Option[E] locals keep their
# carrier for ordinary scope exit; the bound path below only copies `.val`.
sub g4_option_unwrap_fresh_enum_from_parts($ename: Str, $p: FreshUnwrapParts, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if !g4_option_unwrap_enum_supported($ename, $env) {
        Err(g3_unsupported())
    } else {
        match g6_option_kind_from_value($p.recv, $env) {
            Err($m) { Err($m) }
            Ok($okind) {
                match $okind {
                    CgOptEnum($en) {
                        if $en == $ename {
                            match g6_option_value(CgOptEnum($ename), $p.recv, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($fresh) {
                                    match g4_fresh_unwrap_guard_state($fresh.c, $p.msg, $fresh.state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($gst) {
                                            $tmp = g4_value_tmp(CgEnum($ename), $gst.ntmp)
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $gst.interns,
                                                    decls: $gst.decls ~ g4_value_decl(CgEnum($ename), $tmp),
                                                    body: $gst.body ~ "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n",
                                                    nstr: $gst.nstr,
                                                    ntmp: $gst.ntmp + 1
                                                ),
                                                c: $tmp
                                            ))
                                        }
                                    }
                                }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            }
        }
    }
}

sub g4_option_unwrap_enum($ename: Str, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if !g4_option_unwrap_enum_supported($ename, $env) {
        Err(g3_unsupported())
    } else {
        match g4_option_unwrap_fresh_parts($c, $a, $env) {
            Err($m) { Err($m) }
            Ok($p) {
                match $p.recv {
                    EName($n) {
                        match cg_env_lookup($env, $n) {
                            None { Err(g3_unsupported()) }
                            Some($v) {
                                match $v.kind {
                                    CgOptEnum($en) {
                                        if $en == $ename {
                                            match g4_fresh_unwrap_guard_state($v.cname, $p.msg, $state, $env) {
                                                Err($m) { Err($m) }
                                                Ok($gst) {
                                                    $tmp = g4_value_tmp(CgEnum($ename), $gst.ntmp)
                                                    Ok(CgValueOut(
                                                        state: CgState(
                                                            interns: $gst.interns,
                                                            decls: $gst.decls ~ g4_value_decl(CgEnum($ename), $tmp),
                                                            body: $gst.body ~ "\t" ~ $tmp ~ " = " ~ $v.cname ~ ".val;\n" ~ g6e_enum_retain($ename, $tmp),
                                                            nstr: $gst.nstr,
                                                            ntmp: $gst.ntmp + 1
                                                        ),
                                                        c: $tmp
                                                    ))
                                                }
                                            }
                                        } else {
                                            Err(g3_unsupported())
                                        }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                        }
                    }
                    _ { g4_option_unwrap_fresh_enum_from_parts($ename, $p, $state, $env) }
                }
            }
        }
    }
}

# Enum-name peel for `$a = $ch.recv().unwrap()` / `expect` / function spellings
# so an unannotated enum bind can resolve CgEnum without a TypeRef.
sub g4_option_unwrap_enum_name($c: Expr, $a: ExprList, $env: CgEnv): Result[Str, Str] {
    match g4_option_unwrap_fresh_parts($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptEnum($en) {
                                    if g4_option_unwrap_enum_supported($en, $env) { Ok($en) } else { Err(g3_unsupported()) }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ {
                    match g6_option_kind_from_value($p.recv, $env) {
                        Err($m) { Err($m) }
                        Ok($okind) {
                            match $okind {
                                CgOptEnum($en) {
                                    if g4_option_unwrap_enum_supported($en, $env) { Ok($en) } else { Err(g3_unsupported()) }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# §15.5 Result `unwrap`/`expect` — extract the `Ok` payload or panic. This is the
# Result half of the Option guard above, but Result tag polarity is inverse: tag 0
# means Ok, any nonzero tag is Err. `expect` panics with the user message (same as
# Option). `unwrap`'s panic message is COMPUTED from the Err payload display:
#   if (res.tag != 0) { guji_panic(guji_concat(guji_concat("unwrap on Err(", <display>), ")")); }
# where <display> renders `.err` per its kind — Str raw, Int guji_int_str, Float
# guji_float_str, Bool guji_bool_str (native emits exactly these). The concat chain
# only evaluates on the panic path, where guji_panic never returns; native leaks it
# identically, so the shape is byte-mirrorable and invisible to LeakSan (exit path).
sub g4_result_expect_recv($want: CgKind, $recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    if g4_result_unwrap_or_kind_ok($want, $v.kind) { Ok($v) } else { Err(g3_unsupported()) }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Render the borrowed `.err` slot as a display Str expression for the computed
# `unwrap on Err(<display>)` panic text. Only value err kinds have a native
# display shape here; anything else declines.
sub g4_result_err_display($v: CgVar): Result[Str, Str] {
    match $v.kind {
        CgRes($ok, $err) {
            match $err {
                CgStr { Ok($v.cname ~ ".err") }
                CgInt { Ok("guji_int_str(" ~ $v.cname ~ ".err)") }
                CgFloat { Ok("guji_float_str(" ~ $v.cname ~ ".err)") }
                CgBool { Ok("guji_bool_str(" ~ $v.cname ~ ".err)") }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# `unwrap`: emit the Result-polarity guard with the computed Err-display message.
sub g4_result_unwrap_do($want: CgKind, $recv: Expr, $state: CgState, $env: CgEnv): Result[UnwrapGuard, Str] {
    match g4_result_expect_recv($want, $recv, $env) {
        Err($m) { Err($m) }
        Ok($v) {
            match g4_result_err_display($v) {
                Err($m) { Err($m) }
                Ok($disp) {
                    Ok(UnwrapGuard(
                        state: CgState(
                            interns: $state.interns,
                            decls: $state.decls,
                            body: $state.body ~ "\tif (" ~ $v.cname ~ ".tag != 0) \{ guji_panic(guji_concat(guji_concat(\"unwrap on Err(\", " ~ $disp ~ "), \")\")); }\n",
                            nstr: $state.nstr,
                            ntmp: $state.ntmp
                        ),
                        cname: $v.cname
                    ))
                }
            }
        }
    }
}

sub g4_result_expect_do($want: CgKind, $recv: Expr, $msg: Expr, $state: CgState, $env: CgEnv): Result[UnwrapGuard, Str] {
    match g4_result_expect_recv($want, $recv, $env) {
        Err($m) { Err($m) }
        Ok($v) {
            match g3_str_lower($msg, $state, $env) {
                Err($m) { Err($m) }
                Ok($ms) {
                    $st = $ms.state
                    Ok(UnwrapGuard(
                        state: CgState(
                            interns: $st.interns,
                            decls: $st.decls,
                            body: $st.body ~
                                "\tif (" ~ $v.cname ~ ".tag != 0) \{ guji_panic(" ~ $ms.tmp ~ "); }\n" ~
                                "\tguji_release(" ~ $ms.tmp ~ ");\n",
                            nstr: $st.nstr,
                            ntmp: $st.ntmp
                        ),
                        cname: $v.cname
                    ))
                }
            }
        }
    }
}

# Match both spellings of both Result extraction helpers — method `$r.unwrap()`/
# `$r.expect($m)` and function `unwrap($r)`/`expect($r, $m)`. A user `sub unwrap`/
# `sub expect` shadows the FUNCTION form (defer to the general call path).
sub g4_result_expect_guard($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[UnwrapGuard, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap" {
                match $a {
                    ExprNil { g4_result_unwrap_do($want, $recv, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                if $method == "expect" {
                    match $a {
                        ExprCons($msg, ExprNil) { g4_result_expect_do($want, $recv, $msg, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        EName($fn) {
            if $fn == "unwrap" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprNil) { g4_result_unwrap_do($want, $recv, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                if $fn == "expect" {
                    match cg_env_lookup_sub($env, $fn) {
                        Some($sig) { Err(g3_unsupported()) }
                        None {
                            match $a {
                                ExprCons($recv, ExprCons($msg, ExprNil)) { g4_result_expect_do($want, $recv, $msg, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_result_expect_value($want: CgKind, $c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_result_expect_guard($want, $c, $a, $state, $env) {
        Err($m) { Err($m) }
        Ok($g) { Ok(CgValueOut(state: $g.state, c: $g.cname ~ ".ok")) }
    }
}

# Str `unwrap()` on a FRESH Result[Str,Str] expression (e.g.
# `Regex.compile("…").unwrap()`): the receiver is not a bound carrier local, so
# materialise it into an owned carrier temp, guard on the Err polarity with the
# same computed `unwrap on Err(<err>)` panic text the named path emits, retain
# the Ok payload into the returned owned tmp, then release the consumed carrier
# (the Result twin of g4_option_unwrap_fresh_str; g4_option_unwrap_fresh_recv
# only extracts the `unwrap` receiver spelling, so reusing it is kind-agnostic).
sub g4_result_unwrap_fresh_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_option_unwrap_fresh_recv($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($recv) {
            match g6_result_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($kind) {
                    if cgkind_eq($kind, CgRes(CgStr, CgStr)) {
                        match g6_result_value($kind, $recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($fresh) {
                                $qtmp = g4_value_tmp($kind, $fresh.state.ntmp)
                                $tmp = "gt" ~ c_int($fresh.state.ntmp + 1)
                                Ok(StrLower(
                                    state: CgState(
                                        interns: $fresh.state.interns,
                                        decls: $fresh.state.decls ~
                                            g4_value_decl($kind, $qtmp) ~
                                            "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                        body: $fresh.state.body ~
                                            "\t" ~ $qtmp ~ " = " ~ $fresh.c ~ ";\n" ~
                                            "\tif (" ~ $qtmp ~ ".tag != 0) \{ guji_panic(guji_concat(guji_concat(\"unwrap on Err(\", " ~ $qtmp ~ ".err), \")\")); }\n" ~
                                            "\t" ~ $tmp ~ " = guji_retain(" ~ $qtmp ~ ".ok);\n" ~
                                            g6_result_release($kind, $qtmp),
                                        nstr: $fresh.state.nstr,
                                        ntmp: $fresh.state.ntmp + 2
                                    ),
                                    tmp: $tmp
                                ))
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

sub g4_result_expect_str($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_result_expect_guard(CgStr, $c, $a, $state, $env) {
        Err($m) { g4_result_unwrap_fresh_str($c, $a, $state, $env) }
        Ok($g) {
            $st = $g.state
            $tmp = "gt" ~ c_int($st.ntmp)
            Ok(StrLower(
                state: CgState(
                    interns: $st.interns,
                    decls: $st.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                    body: $st.body ~ "\t" ~ $tmp ~ " = guji_retain(" ~ $g.cname ~ ".ok);\n",
                    nstr: $st.nstr,
                    ntmp: $st.ntmp + 1
                ),
                tmp: $tmp
            ))
        }
    }
}

# Fresh `Result[Unit, Str].unwrap()` (e.g. `write_file($p, $s).unwrap()`):
# materialise the carrier, panic on Err with the same computed display native
# emits, discard the Unit Ok payload, then release the consumed carrier. The
# Unit Ok slot owns nothing, so the value is the sentinel `0LL` (no retain).
# This is the Result-Unit twin of g4_result_unwrap_fresh_str — without it,
# statement-position write_file/append_file unwrap declines as a generic G4b-c
# gap even though the write_file carrier itself already lowers.
sub g4_result_unwrap_fresh_unit($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_option_unwrap_fresh_recv($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($recv) {
            match g6_result_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($kind) {
                    if cgkind_eq($kind, CgRes(CgUnit, CgStr)) {
                        match g6_result_value($kind, $recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($fresh) {
                                $qtmp = g4_value_tmp($kind, $fresh.state.ntmp)
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $fresh.state.interns,
                                        decls: $fresh.state.decls ~ g4_value_decl($kind, $qtmp),
                                        body: $fresh.state.body ~
                                            "\t" ~ $qtmp ~ " = " ~ $fresh.c ~ ";\n" ~
                                            "\tif (" ~ $qtmp ~ ".tag != 0) \{ guji_panic(guji_concat(guji_concat(\"unwrap on Err(\", " ~ $qtmp ~ ".err), \")\")); }\n" ~
                                            "\t(void)(" ~ $qtmp ~ ".ok);\n" ~
                                            g6_result_release($kind, $qtmp),
                                        nstr: $fresh.state.nstr,
                                        ntmp: $fresh.state.ntmp + 1
                                    ),
                                    c: "0LL"
                                ))
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

# Bound or fresh `Result[Unit, Str]` unwrap/expect → Unit (`0LL` / `.ok`).
# Bound locals keep their carrier (scope release owns the Err slot); fresh
# receivers consume the carrier inside g4_result_unwrap_fresh_unit.
sub g4_result_expect_unit($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_result_expect_guard(CgUnit, $c, $a, $state, $env) {
        Err($m) { g4_result_unwrap_fresh_unit($c, $a, $state, $env) }
        Ok($g) {
            Ok(CgValueOut(
                state: CgState(
                    interns: $g.state.interns,
                    decls: $g.state.decls,
                    body: $g.state.body ~ "\t(void)(" ~ $g.cname ~ ".ok);\n",
                    nstr: $g.state.nstr,
                    ntmp: $g.state.ntmp
                ),
                c: "0LL"
            ))
        }
    }
}

# Statement-position Result[Unit, Str] unwrap: returns the post-guard state so
# g5_unit_call_code can discard the Unit rvalue (native's write_file().unwrap()
# shape). Not-a-Unit-unwrap declines with g3_unsupported for the call-chain
# fallthrough.
sub g4_result_unit_unwrap_state($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g4_result_expect_unit($c, $a, $state, $env) {
        Err($m) { Err($m) }
        Ok($uv) { Ok($uv.state) }
    }
}

class HandleExtract {
    has $.recv: Expr
    has $.expect_msg: Option[Expr]
}

# Parse Result[Handle,Str] unwrap/expect syntax. Bare function forms respect a
# user-sub shadow; method forms are the carrier prelude operations.
sub g4_handle_extract($c: Expr, $a: ExprList, $env: CgEnv): Result[HandleExtract, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap" {
                match $a { ExprNil { Ok(HandleExtract(recv: $recv, expect_msg: None)) } _ { Err(g3_unsupported()) } }
            } else if $method == "expect" {
                match $a { ExprCons($msg, ExprNil) { Ok(HandleExtract(recv: $recv, expect_msg: Some($msg))) } _ { Err(g3_unsupported()) } }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "unwrap" || $fn == "expect" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        if $fn == "unwrap" {
                            match $a { ExprCons($recv, ExprNil) { Ok(HandleExtract(recv: $recv, expect_msg: None)) } _ { Err(g3_unsupported()) } }
                        } else {
                            match $a { ExprCons($recv, ExprCons($msg, ExprNil)) { Ok(HandleExtract(recv: $recv, expect_msg: Some($msg))) } _ { Err(g3_unsupported()) } }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_handle_unwrap_guard($carrier: Str, $msg: Option[Expr], $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $msg {
        None {
            Ok(CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ "\tif (" ~ $carrier ~ ".tag != 0LL) \{ guji_panic(guji_concat(guji_concat(\"unwrap on Err(\", " ~ $carrier ~ ".err), \")\")); }\n",
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ))
        }
        Some($m) {
            match g3_str_lower($m, $state, $env) {
                Err($e) { Err($e) }
                Ok($ms) {
                    Ok(CgState(
                        interns: $ms.state.interns,
                        decls: $ms.state.decls,
                        body: $ms.state.body ~
                            "\tif (" ~ $carrier ~ ".tag != 0LL) \{ guji_panic(" ~ $ms.tmp ~ "); }\n" ~
                            "\tguji_release(" ~ $ms.tmp ~ ");\n",
                        nstr: $ms.state.nstr,
                        ntmp: $ms.state.ntmp
                    ))
                }
            }
        }
    }
}

# Extract an OWNED Handle. Bound Result carriers keep their Ok reference, so
# retain it; fresh open/create carriers transfer their Ok slot and release only
# a possible Err slot (the successful guard makes that release a no-op).
sub g4_handle_unwrap_value($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_handle_extract($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($ex) {
            match $ex.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        Some($v) {
                            if cgkind_eq($v.kind, CgRes(CgHandle, CgStr)) {
                                match g4_handle_unwrap_guard($v.cname, $ex.expect_msg, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($st1) {
                                        $tmp = g4_value_tmp(CgHandle, $st1.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $st1.interns,
                                                decls: $st1.decls ~ g4_value_decl(CgHandle, $tmp),
                                                body: $st1.body ~ "\t" ~ $tmp ~ " = " ~ $v.cname ~ ".ok;\n\tguji_retain((const void*)" ~ $tmp ~ ");\n",
                                                nstr: $st1.nstr,
                                                ntmp: $st1.ntmp + 1
                                            ),
                                            c: $tmp
                                        ))
                                    }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        None { g4_handle_unwrap_fresh($ex, $state, $env) }
                    }
                }
                _ { g4_handle_unwrap_fresh($ex, $state, $env) }
            }
        }
    }
}

sub g4_handle_unwrap_fresh($ex: HandleExtract, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    $kind = CgRes(CgHandle, CgStr)
    match g6_result_kind_from_value($ex.recv, $env) {
        Ok($rk) {
            if cgkind_eq($rk, $kind) {
                match g6_result_value($kind, $ex.recv, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($fresh) {
                        match g4_handle_unwrap_guard($fresh.c, $ex.expect_msg, $fresh.state, $env) {
                            Err($m) { Err($m) }
                            Ok($st1) {
                                $tmp = g4_value_tmp(CgHandle, $st1.ntmp)
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $st1.interns,
                                        decls: $st1.decls ~ g4_value_decl(CgHandle, $tmp),
                                        body: $st1.body ~
                                            "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".ok;\n" ~
                                            g6_result_slot_release(CgStr, $fresh.c, "err", "!= 0LL"),
                                        nstr: $st1.nstr,
                                        ntmp: $st1.ntmp + 1
                                    ),
                                    c: $tmp
                                ))
                            }
                        }
                    }
                }
            } else { Err(g3_unsupported()) }
        }
        Err($m) { Err($m) }
    }
}

# Handle rvalues are owned. Local names retain; standard handles materialize a
# fresh no-close wrapper; Result unwrap/expect follows the split above.
sub g4_handle_owned_value($value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgHandle {
                            $tmp = g4_value_tmp(CgHandle, $state.ntmp)
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $state.interns,
                                    decls: $state.decls ~ g4_value_decl(CgHandle, $tmp),
                                    body: $state.body ~ "\t" ~ $tmp ~ " = (guji_reader_t*)guji_retain((const void*)" ~ $v.cname ~ ");\n",
                                    nstr: $state.nstr,
                                    ntmp: $state.ntmp + 1
                                ),
                                c: $tmp
                            ))
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                None {
                    if $n == "stdin" || $n == "stdout" || $n == "stderr" {
                        $tmp = g4_value_tmp(CgHandle, $state.ntmp)
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $state.interns,
                                decls: $state.decls ~ g4_value_decl(CgHandle, $tmp),
                                body: $state.body ~ "\t" ~ $tmp ~ " = guji_" ~ $n ~ "();\n",
                                nstr: $state.nstr,
                                ntmp: $state.ntmp + 1
                            ),
                            c: $tmp
                        ))
                    } else { Err(g3_unsupported()) }
                }
            }
        }
        ECall($c, $a) { g4_handle_unwrap_value($c, $a, $state, $env) }
        _ { Err(g3_unsupported()) }
    }
}

class HandleRecv {
    has $.state: CgState
    has $.c: Str
    has $.cleanup: Str
}

# Borrow a local Handle receiver. Fresh/std/unwrap receivers are owned temps and
# carry an explicit post-call release.
sub g4_handle_recv($recv: Expr, $state: CgState, $env: CgEnv): Result[HandleRecv, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgHandle { Ok(HandleRecv(state: $state, c: $v.cname, cleanup: "")) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                None {
                    match g4_handle_owned_value($recv, $state, $env) {
                        Ok($hv) { Ok(HandleRecv(state: $hv.state, c: $hv.c, cleanup: "\tguji_release((const void*)" ~ $hv.c ~ ");\n")) }
                        Err($m) { Err($m) }
                    }
                }
            }
        }
        _ {
            match g4_handle_owned_value($recv, $state, $env) {
                Ok($hv) { Ok(HandleRecv(state: $hv.state, c: $hv.c, cleanup: "\tguji_release((const void*)" ~ $hv.c ~ ");\n")) }
                Err($m) { Err($m) }
            }
        }
    }
}

sub g4_handle_unary_recv($callee: Expr, $args: ExprList, $name: Str, $env: CgEnv): Result[Expr, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == $name {
                match $args { ExprNil { Ok($recv) } _ { Err(g3_unsupported()) } }
            } else { Err(g3_unsupported()) }
        }
        EName($fn) {
            if $fn == $name {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None { match $args { ExprCons($recv, ExprNil) { Ok($recv) } _ { Err(g3_unsupported()) } } }
                }
            } else { Err(g3_unsupported()) }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_handle_slurp_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match g4_handle_unary_recv($callee, $args, "slurp", $env) {
        Err($m) { Err($m) }
        Ok($recv) {
            match g4_handle_recv($recv, $state, $env) {
                Err($m) { Err($m) }
                Ok($hr) {
                    $tmp = "gt" ~ c_int($hr.state.ntmp)
                    Ok(StrLower(
                        state: CgState(
                            interns: $hr.state.interns,
                            decls: $hr.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                            body: $hr.state.body ~ "\t" ~ $tmp ~ " = guji_slurp(" ~ $hr.c ~ ");\n" ~ $hr.cleanup,
                            nstr: $hr.state.nstr,
                            ntmp: $hr.state.ntmp + 1
                        ),
                        tmp: $tmp
                    ))
                }
            }
        }
    }
}

class HandleWriteArgs {
    has $.recv: Expr
    has $.text: Expr
}

sub g4_handle_write_args($callee: Expr, $args: ExprList, $env: CgEnv): Result[HandleWriteArgs, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "write" {
                match $args { ExprCons($text, ExprNil) { Ok(HandleWriteArgs(recv: $recv, text: $text)) } _ { Err(g3_unsupported()) } }
            } else { Err(g3_unsupported()) }
        }
        EName($fn) {
            if $fn == "write" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None { match $args { ExprCons($recv, ExprCons($text, ExprNil)) { Ok(HandleWriteArgs(recv: $recv, text: $text)) } _ { Err(g3_unsupported()) } } }
                }
            } else { Err(g3_unsupported()) }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g4_handle_write_state($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g4_handle_write_args($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($wa) {
            match g4_handle_recv($wa.recv, $state, $env) {
                Err($m) { Err($m) }
                Ok($hr) {
                    match g3_str_lower($wa.text, $hr.state, $env) {
                        Err($m) { Err($m) }
                        Ok($ss) {
                            Ok(CgState(
                                interns: $ss.state.interns,
                                decls: $ss.state.decls,
                                body: $ss.state.body ~ "\tguji_write(" ~ $hr.c ~ ", " ~ $ss.tmp ~ ");\n\tguji_release(" ~ $ss.tmp ~ ");\n" ~ $hr.cleanup,
                                nstr: $ss.state.nstr,
                                ntmp: $ss.state.ntmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g4_handle_lines_value($elem: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if !cgkind_eq($elem, CgStr) { Err(g3_unsupported()) } else {
        match g4_handle_unary_recv($callee, $args, "lines", $env) {
            Err($m) { Err($m) }
            Ok($recv) {
                match g4_handle_recv($recv, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($hr) {
                        $tmp = g4_value_tmp(CgChan(CgStr), $hr.state.ntmp)
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $hr.state.interns,
                                decls: $hr.state.decls ~ g4_value_decl(CgChan(CgStr), $tmp),
                                body: $hr.state.body ~ "\t" ~ $tmp ~ " = guji_reader_lines(" ~ $hr.c ~ ");\n" ~ $hr.cleanup,
                                nstr: $hr.state.nstr,
                                ntmp: $hr.state.ntmp + 1
                            ),
                            c: $tmp
                        ))
                    }
                }
            }
        }
    }
}

# Fold the elements of a `List[Str]` literal into an OR-chain of counted-Str
# equality terms (plus the per-element releases),
# threading codegen state through each element's `g3_str_lower`. The OR string
# is built head-first; element order is irrelevant since the terms are ORed.
# Returns expr == "" for an empty list (the caller lowers that to `0LL`).
sub g4_contains_or($subj: Str, $elems: ExprList, $state: CgState, $env: CgEnv): Result[ContainsAcc, Str] {
    match $elems {
        ExprNil { Ok(ContainsAcc(state: $state, expr: "", rel: "")) }
        ExprCons($e, $rest) {
            match g3_str_lower($e, $state, $env) {
                Err($m) { Err($m) }
                Ok($es) {
                    match g4_contains_or($subj, $rest, $es.state, $env) {
                        Err($m) { Err($m) }
                        Ok($acc) {
                            $term = "guji_str_equal(" ~ $subj ~ ", " ~ $es.tmp ~ ")"
                            $rel = "\tguji_release(" ~ $es.tmp ~ ");\n" ~ $acc.rel
                            $expr = if $acc.expr == "" {
                                $term
                            } else {
                                $term ~ " || " ~ $acc.expr
                            }
                            Ok(ContainsAcc(state: $acc.state, expr: $expr, rel: $rel))
                        }
                    }
                }
            }
        }
    }
}

# Lower `[<Str literals...>].contains(<Str expr>)` to an `int64_t` membership
# test. The subject is lowered once to an owned temp; each list element lowers
# to its interned static; the result is the OR of the per-element equality
# terms, computed into a `gb_N` temp before the subject and element temps are
# released exactly once. This is the literal-receiver `contains` shape the real
# lexer uses (`is_punct_char`/`is_op_char`/keyword checks).
sub g4_contains_literal($elems: ExprList, $arg: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g3_str_lower($arg, $state, $env) {
        Err($m) { Err($m) }
        Ok($sl) {
            match g4_contains_or($sl.tmp, $elems, $sl.state, $env) {
                Err($m) { Err($m) }
                Ok($acc) {
                    $st = $acc.state
                    $bi = c_int($st.ntmp)
                    $bt = "gb" ~ $bi
                    $rhs = if $acc.expr == "" {
                        "0LL"
                    } else {
                        "((" ~ $acc.expr ~ ") ? 1LL : 0LL)"
                    }
                    Ok(BoolLower(
                        state: CgState(
                            interns: $st.interns,
                            decls: $st.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                            body: $st.body ~
                                "\t" ~ $bt ~ " = " ~ $rhs ~ ";\n" ~
                                $acc.rel ~
                                "\tguji_release(" ~ $sl.tmp ~ ");\n",
                            nstr: $st.nstr,
                            ntmp: $st.ntmp + 1
                        ),
                        c: $bt
                    ))
                }
            }
        }
    }
}

# §15 list `contains(@xs, $x)` / `@xs.contains($x)` -> Bool for a DYNAMIC list
# receiver (bound var / call / index) with scalar elements. Mirrors native's
# lowering: a `gb_N` flag temp starts 0 and a linear scan compares each element
# against the needle (counted equality for Str, `==` for Int/Bool/Float), setting
# the flag and breaking on the first hit; an empty list simply never sets it.
# The receiver is materialized to an OWNED slice via g7_lower_list_value (deep
# copy for a bound var — the sum/min/max convention, so the post-loop release is
# not a double-free); the receiver lowers BEFORE the needle to keep interp's
# left-to-right argument evaluation order, and an owned Str needle is released
# after the scan. `CgList` elements decline — native rejects nested-list
# `contains` ("unsupported for List[List]"), an oracle-limit. A user
# `sub contains` shadows the prelude (defer to the general call path).
sub g4_contains_dynamic($recv: Expr, $needle: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match cg_env_lookup_sub($env, "contains") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match g7_list_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($elem) {
                    $scalar = cgkind_eq($elem, CgInt) || cgkind_eq($elem, CgFloat) ||
                        cgkind_eq($elem, CgBool) || cgkind_eq($elem, CgStr)
                    if $scalar {
                        match g7_list_c_type($elem) {
                            Err($m) { Err($m) }
                            Ok($ctype) {
                                match g7_lower_list_value($elem, $recv, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($src) {
                                        match g7_lower_scalar_elem($elem, $needle, $src.state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($nv) {
                                                $st = $nv.state
                                                $flag = "gb" ~ c_int($st.ntmp)
                                                $idx = "gi" ~ c_int($st.ntmp + 1)
                                                $cand = "((" ~ $ctype ~ "*)" ~ $src.c ~ ".data)[" ~ $idx ~ "]"
                                                $cmp = if cgkind_eq($elem, CgStr) {
                                                    "guji_str_equal(" ~ $cand ~ ", " ~ $nv.c ~ ")"
                                                } else {
                                                    $cand ~ " == " ~ $nv.c
                                                }
                                                $nrel = if cgkind_eq($elem, CgStr) {
                                                    "\tguji_release(" ~ $nv.c ~ ");\n"
                                                } else {
                                                    ""
                                                }
                                                Ok(BoolLower(
                                                    state: CgState(
                                                        interns: $st.interns,
                                                        decls: $st.decls ~
                                                            "\tint64_t " ~ $flag ~ " = 0;\n" ~
                                                            "\tint64_t " ~ $idx ~ " = 0;\n",
                                                        body: $st.body ~
                                                            "\tfor (" ~ $idx ~ " = 0; " ~ $idx ~ " < " ~ $src.c ~ ".len; " ~ $idx ~ " = guji_add(" ~ $idx ~ ", 1)) \{\n" ~
                                                            "\t\tif (" ~ $cmp ~ ") \{ " ~ $flag ~ " = 1; break; }\n" ~
                                                            "\t}\n" ~
                                                            g7_slice_release($src.c) ~
                                                            $nrel,
                                                        nstr: $st.nstr,
                                                        ntmp: $st.ntmp + 2
                                                    ),
                                                    c: $flag
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

# Dispatch both `contains` spellings in Bool position: the method form keeps the
# original literal-receiver OR-chain shape when it applies (falling back to the
# dynamic scan otherwise, e.g. an Int-literal receiver), and the data-first
# function form goes straight to the dynamic scan.
sub g4_list_contains_lower($e: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                EField($recv, $method) {
                    if $method == "contains" {
                        match $args {
                            ExprCons($arg, ExprNil) {
                                match $recv {
                                    EList($elems) {
                                        match g4_contains_literal($elems, $arg, $state, $env) {
                                            Ok($v) { Ok($v) }
                                            Err($lm) { g4_contains_dynamic($recv, $arg, $state, $env) }
                                        }
                                    }
                                    _ { g4_contains_dynamic($recv, $arg, $state, $env) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                EName($fname) {
                    if $fname == "contains" {
                        match $args {
                            ExprCons($recv, ExprCons($needle, ExprNil)) {
                                g4_contains_dynamic($recv, $needle, $state, $env)
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15 list `is_empty(@xs)` / `@xs.is_empty()` -> Bool: whether the list has no
# elements (spec §15 table, "whether the list has no elements"). Native lowers
# this to `(<len> == 0)`; we mirror it by reusing `count`'s length machinery
# (`g7_lower_list_count_receiver`), which yields a borrowed `.len` for a bound var
# or class field and a materialize-len-release temp for a call/index receiver, so
# `is_empty` never rescans the elements. A user `sub is_empty` shadows the prelude
# (defer to the general call path). List-only, matching interp/native — Str/Map
# receivers are rejected by the front end, so no non-list receiver reaches here.
sub g4_list_is_empty_lower($e: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match cg_env_lookup_sub($env, "is_empty") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $e {
                ECall($callee, $args) {
                    match $args {
                        ExprNil {
                            match $callee {
                                EField($recv, $method) {
                                    if $method == "is_empty" {
                                        g4_is_empty_from_len($recv, $state, $env)
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        ExprCons($arg, ExprNil) {
                            match $callee {
                                EName($name) {
                                    if $name == "is_empty" {
                                        g4_is_empty_from_len($arg, $state, $env)
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Shared tail for both `is_empty` spellings: lower the list receiver to its length
# expression (borrowed or materialized) and wrap it as the Bool `(<len> == 0)`.
sub g4_is_empty_from_len($recv: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match g7_lower_list_count_receiver($recv, $state, $env) {
        Err($m) { Err($m) }
        Ok($cv) { Ok(BoolLower(state: $cv.state, c: "((" ~ $cv.c ~ ") == 0)")) }
    }
}

sub g4_bodyless_state($state: CgState): CgState {
    CgState(
        interns: $state.interns,
        decls: $state.decls,
        body: "",
        nstr: $state.nstr,
        ntmp: $state.ntmp
    )
}

sub g4_value_tmp($kind: CgKind, $i: Int): Str {
    match $kind {
        CgInt { "gi" ~ c_int($i) }
        CgFloat { "gd" ~ c_int($i) }
        CgBool { "gb" ~ c_int($i) }
        CgStr { "gt" ~ c_int($i) }
        CgMatch { "gmt" ~ c_int($i) }
        CgBush { "gbu" ~ c_int($i) }
        CgHandle { "gh" ~ c_int($i) }
        CgUnit { "gu" ~ c_int($i) }
        CgOptInt { "go" ~ c_int($i) }
        CgOptFloat { "go" ~ c_int($i) }
        CgOptBool { "go" ~ c_int($i) }
        CgOptStr { "go" ~ c_int($i) }
        CgOptClass($n) { "go" ~ c_int($i) }
        CgOptEnum($n) { "go" ~ c_int($i) }
        CgOptList($el) { "go" ~ c_int($i) }
        CgOptMap($v) { "go" ~ c_int($i) }
        CgOptMatch { "go" ~ c_int($i) }
        CgOptBush { "go" ~ c_int($i) }
        CgOptCarrier($inner) { "go" ~ c_int($i) }
        CgRes($ok, $err) { "gr" ~ c_int($i) }
        CgEnum($n) { "ge" ~ c_int($i) }
        CgBoxEnum($n) { "geb" ~ c_int($i) }
        CgBoxClass($n) { "gcb" ~ c_int($i) }
        CgBoxOptClass($n) { "gco" ~ c_int($i) }
        CgBoxOptEnum($n) { "geo" ~ c_int($i) }
        CgClass($n) { "gc" ~ c_int($i) }
        CgList($el) { "gl" ~ c_int($i) }
        CgMap($v) { "gmv" ~ c_int($i) }
        CgFn($p, $r) { "gfv" ~ c_int($i) }
        CgChan($el) { "gch" ~ c_int($i) }
        CgClosed { "gcl" ~ c_int($i) }
    }
}

sub g4_value_decl($kind: CgKind, $tmp: Str): Str {
    match $kind {
        CgInt { "\tint64_t " ~ $tmp ~ " = 0;\n" }
        CgFloat { "\tdouble " ~ $tmp ~ " = 0.0;\n" }
        CgBool { "\tint64_t " ~ $tmp ~ " = 0;\n" }
        CgStr { "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n" }
        CgMatch { "\tguji_match_t* " ~ $tmp ~ " = NULL;\n" }
        CgBush { "\tguji_bush_t* " ~ $tmp ~ " = NULL;\n" }
        CgHandle { "\tguji_reader_t* " ~ $tmp ~ " = NULL;\n" }
        CgUnit { "\tint64_t " ~ $tmp ~ " = 0;\n" }
        CgOptInt { "\tguji_opt_int " ~ $tmp ~ " = \{0};\n" }
        CgOptFloat { "\tguji_opt_float " ~ $tmp ~ " = \{0};\n" }
        CgOptBool { "\tguji_opt_bool " ~ $tmp ~ " = \{0};\n" }
        CgOptStr { "\tguji_opt_str " ~ $tmp ~ " = \{0};\n" }
        CgOptClass($n) { "\tguji_opt_" ~ $n ~ " " ~ $tmp ~ " = \{0};\n" }
        CgOptEnum($n) { "\tguji_opt_" ~ $n ~ " " ~ $tmp ~ " = \{0};\n" }
        CgOptList($el) { "\tguji_opt_list " ~ $tmp ~ " = \{0};\n" }
        CgOptMap($v) { "\tguji_opt_map " ~ $tmp ~ " = \{0};\n" }
        CgOptMatch { "\tguji_opt_match " ~ $tmp ~ " = \{0};\n" }
        CgOptBush { "\tguji_opt_bush " ~ $tmp ~ " = \{0};\n" }
        CgOptCarrier($inner) { "\t" ~ g6_option_ctype(CgOptCarrier($inner)) ~ " " ~ $tmp ~ " = \{0};\n" }
        CgRes($ok, $err) { "\t" ~ g6_result_ctype($kind) ~ " " ~ $tmp ~ " = \{0};\n" }
        CgEnum($n) { "\t" ~ $n ~ " " ~ $tmp ~ " = \{0};\n" }
        CgBoxEnum($n) { "\t" ~ $n ~ "* " ~ $tmp ~ " = 0;\n" }
        CgBoxClass($n) { "\t" ~ $n ~ "* " ~ $tmp ~ " = 0;\n" }
        CgBoxOptClass($n) { "\tguji_opt_" ~ $n ~ "* " ~ $tmp ~ " = 0;\n" }
        CgBoxOptEnum($n) { "\tguji_opt_" ~ $n ~ "* " ~ $tmp ~ " = 0;\n" }
        CgClass($n) { "\t" ~ $n ~ " " ~ $tmp ~ " = \{0};\n" }
        CgList($el) { "\tguji_slice_t " ~ $tmp ~ " = \{0};\n" }
        CgMap($v) { "\tguji_map_t " ~ $tmp ~ " = \{0};\n" }
        CgFn($p, $r) { "\tguji_fn_t " ~ $tmp ~ " = \{0};\n" }
        CgChan($el) { "\tguji_chan_t* " ~ $tmp ~ " = NULL;\n" }
        CgClosed { "\tint64_t " ~ $tmp ~ " = 0;\n" }
    }
}

sub g4_value_zero($kind: CgKind): Str {
    match $kind {
        CgFloat { "0.0" }
        CgStr { "GUJI_EMPTY_STR" }
        CgOptInt { "(guji_opt_int)\{0}" }
        CgOptFloat { "(guji_opt_float)\{0}" }
        CgOptBool { "(guji_opt_bool)\{0}" }
        CgOptStr { "(guji_opt_str)\{0}" }
        CgOptClass($n) { "(guji_opt_" ~ $n ~ ")\{0}" }
        CgOptEnum($n) { "(guji_opt_" ~ $n ~ ")\{0}" }
        CgOptList($el) { "(guji_opt_list)\{0}" }
        CgOptMap($v) { "(guji_opt_map)\{0}" }
        CgOptMatch { "(guji_opt_match)\{0}" }
        CgOptBush { "(guji_opt_bush)\{0}" }
        CgOptCarrier($inner) { "(" ~ g6_option_ctype(CgOptCarrier($inner)) ~ ")\{0}" }
        CgMatch { "NULL" }
        CgBush { "NULL" }
        CgHandle { "NULL" }
        CgRes($ok, $err) { "(" ~ g6_result_ctype($kind) ~ ")\{0}" }
        CgEnum($n) { "(" ~ $n ~ ")\{0}" }
        CgBoxEnum($n) { "0" }
        CgBoxClass($n) { "0" }
        CgBoxOptClass($n) { "0" }
        CgBoxOptEnum($n) { "0" }
        CgClass($n) { "(" ~ $n ~ ")\{0}" }
        CgList($el) { "(guji_slice_t)\{0}" }
        CgMap($v) { "(guji_map_t)\{0}" }
        CgFn($p, $r) { "(guji_fn_t)\{0}" }
        _ { "0LL" }
    }
}

sub g4_panic_arg($callee: Expr, $args: ExprList, $env: CgEnv): Result[Expr, Str] {
    match cg_env_lookup_sub($env, "panic") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($name) {
                    if $name == "panic" {
                        match $args {
                            ExprCons($msg, ExprNil) { Ok($msg) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15.4 exit($code: Int): Never. Same builtin-vs-user-sub shadowing rule as
# panic: a user sub named `exit` wins in codegen (cg_env_lookup_sub guard), so
# the builtin only fires for the prelude name with exactly one argument.
sub g4_exit_arg($callee: Expr, $args: ExprList, $env: CgEnv): Result[Expr, Str] {
    match cg_env_lookup_sub($env, "exit") {
        Some($sig) { Err(g3_unsupported()) }
        None {
            match $callee {
                EName($name) {
                    if $name == "exit" {
                        match $args {
                            ExprCons($code, ExprNil) { Ok($code) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g4_exit_state($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g4_exit_arg($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($code) {
            match g3_int_rvalue_state($code, $state, $env) {
                Err($m) { Err($m) }
                Ok($cv) {
                    Ok(CgState(
                        interns: $cv.state.interns,
                        decls: $cv.state.decls,
                        body: $cv.state.body ~ "\tguji_exit((int)(" ~ $cv.c ~ "));\n",
                        nstr: $cv.state.nstr,
                        ntmp: $cv.state.ntmp
                    ))
                }
            }
        }
    }
}

# Lowers BOTH Never-typed builtins: §11.2 panic($msg: Str) and §15.4
# exit($code: Int). In value position (g4_panic_value) the runtime call never
# returns, so the expected kind's zero value stands in for the branch result —
# native likewise emits the call and no assignment.
sub g4_panic_state($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g4_panic_arg($callee, $args, $env) {
        Err($m) { g4_exit_state($callee, $args, $state, $env) }
        Ok($msg) {
            match g3_str_lower($msg, $state, $env) {
                Err($m) { Err($m) }
                Ok($ms) {
                    Ok(CgState(
                        interns: $ms.state.interns,
                        decls: $ms.state.decls,
                        body: $ms.state.body ~ "\tguji_panic(" ~ $ms.tmp ~ ");\n",
                        nstr: $ms.state.nstr,
                        ntmp: $ms.state.ntmp
                    ))
                }
            }
        }
    }
}

sub g4_panic_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_panic_state($callee, $args, $state, $env) {
        Err($m) { Err($m) }
        Ok($st) { Ok(CgValueOut(state: $st, c: g4_value_zero($kind))) }
    }
}

# A literal scalar/container is provably not a function value. D rejects such a
# call before evaluating its arguments; emit the same terminal panic and use the
# requested kind's zero only as unreachable C scaffolding. Calls through names,
# fields, qualified names, type names, and lambdas retain their ordinary dispatch
# paths (including later function-value work).
sub g4_definitely_noncallable($callee: Expr): Bool {
    match $callee {
        EInt($t) { true }
        EFloat($t) { true }
        EStr($t) { true }
        ERawStr($t) { true }
        EBool($t) { true }
        EUnit { true }
        EList($xs) { true }
        EMap($xs) { true }
        ERegex($p, $l, $c) { true }
        _ { false }
    }
}

sub g4_bad_call_value($kind: CgKind, $callee: Expr, $state: CgState): Result[CgValueOut, Str] {
    if g4_definitely_noncallable($callee) {
        Ok(CgValueOut(
            state: CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ "\tguji_panic(\"expression is not callable\");\n",
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ),
            c: g4_value_zero($kind)
        ))
    } else {
        Err(g3_unsupported())
    }
}

# Lower a Bool-typed expression to an `int64_t` C rvalue/temp. `&&` and `||`
# emit a guarded RHS block so §5.2 short-circuiting remains true even when the
# RHS condition needs preparatory statements (for example Str comparisons).
sub g4_bool_lower($e: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $e {
        EBool($text) {
            if $text == "true" {
                Ok(BoolLower(state: $state, c: "1LL"))
            } else {
                Ok(BoolLower(state: $state, c: "0LL"))
            }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgBool { Ok(BoolLower(state: $state, c: $v.cname)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EUnary($op, $x) {
            if $op == "!" {
                match g4_bool_lower($x, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($v) { Ok(BoolLower(state: $v.state, c: "((" ~ $v.c ~ ") ? 0LL : 1LL)")) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EBinary($op, $l, $r) {
            if $op == "&&" {
                match g4_bool_lower($l, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($lv) {
                        $rhs_start = g4_bodyless_state($lv.state)
                        match g4_bool_lower($r, $rhs_start, $env) {
                            Err($m) { Err($m) }
                            Ok($rv) {
                                $ti = c_int($rv.state.ntmp)
                                $bt = "gb" ~ $ti
                                Ok(BoolLower(
                                    state: CgState(
                                        interns: $rv.state.interns,
                                        decls: $rv.state.decls ~ "\tint64_t " ~ $bt ~ " = 0;\n",
                                        body: $lv.state.body ~
                                            "\t" ~ $bt ~ " = ((" ~ $lv.c ~ ") ? 1LL : 0LL);\n" ~
                                            "\tif (" ~ $lv.c ~ ") \{\n" ~
                                            $rv.state.body ~
                                            "\t\t" ~ $bt ~ " = " ~ $rv.c ~ ";\n" ~
                                            "\t}\n",
                                        nstr: $rv.state.nstr,
                                        ntmp: $rv.state.ntmp + 1
                                    ),
                                    c: $bt
                                ))
                            }
                        }
                    }
                }
            } else if $op == "||" {
                match g4_bool_lower($l, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($lv) {
                        $rhs_start = g4_bodyless_state($lv.state)
                        match g4_bool_lower($r, $rhs_start, $env) {
                            Err($m) { Err($m) }
                            Ok($rv) {
                                $ti = c_int($rv.state.ntmp)
                                $bt = "gb" ~ $ti
                                Ok(BoolLower(
                                    state: CgState(
                                        interns: $rv.state.interns,
                                        decls: $rv.state.decls ~ "\tint64_t " ~ $bt ~ " = 1;\n",
                                        body: $lv.state.body ~
                                            "\t" ~ $bt ~ " = ((" ~ $lv.c ~ ") ? 1LL : 0LL);\n" ~
                                            "\tif (!(" ~ $lv.c ~ ")) \{\n" ~
                                            $rv.state.body ~
                                            "\t\t" ~ $bt ~ " = " ~ $rv.c ~ ";\n" ~
                                            "\t}\n",
                                        nstr: $rv.state.nstr,
                                        ntmp: $rv.state.ntmp + 1
                                    ),
                                    c: $bt
                                ))
                            }
                        }
                    }
                }
            } else {
                g4_comparison_lower($op, $l, $r, $state, $env)
            }
        }
        EIf($cond, $then, $elifs, $els) {
            match g4_lower_if_value(CgBool, $cond, $then, $elifs, $els, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(BoolLower(state: $v.state, c: $v.c)) }
            }
        }
        ECall($c, $a) {
            match g4_panic_value(CgBool, $c, $a, $state, $env) {
                Ok($pv) { Ok(BoolLower(state: $pv.state, c: $pv.c)) }
                Err($pm) {
            match g4_regex_is_some_lower($e, $state, $env) {
                Ok($v) { Ok($v) }
                Err($rm) {
                  match g4_option_is_some_lower($e, $state, $env) {
                    Ok($v) { Ok($v) }
                    Err($om) {
                    match g4_result_is_ok_lower($e, $state, $env) {
                      Ok($v) { Ok($v) }
                      Err($resm) {
                    match g4_unwrap_or_value(CgBool, $c, $a, $state, $env) {
                      Ok($uv) { Ok(BoolLower(state: $uv.state, c: $uv.c)) }
                      Err($um) {
                    match g4_result_unwrap_or_value(CgBool, $c, $a, $state, $env) {
                      Ok($ruv) { Ok(BoolLower(state: $ruv.state, c: $ruv.c)) }
                      Err($rum) {
                    match g4_result_unwrap_or_else_value(CgBool, $c, $a, $state, $env) {
                      Ok($ruev) { Ok(BoolLower(state: $ruev.state, c: $ruev.c)) }
                      Err($ruem) {
                    match g4_result_expect_value(CgBool, $c, $a, $state, $env) {
                      Ok($rev) { Ok(BoolLower(state: $rev.state, c: $rev.c)) }
                      Err($rem) {
                    match g4_option_unwrap_value(CgBool, $c, $a, $state, $env) {
                      Ok($ouv) { Ok(BoolLower(state: $ouv.state, c: $ouv.c)) }
                      Err($oum) {
                    match g7_lower_map_has_key_call($c, $a, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($hm) {
                            match g4_list_contains_lower($e, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($cm) {
                                  match g4_list_is_empty_lower($e, $state, $env) {
                                    Ok($v) { Ok($v) }
                                    Err($em) {
                                    match g5_call_value(RBool, $c, $a, $state, $env) {
                                        Err($m) {
                                            match g5_fn_call_value(CgBool, $c, $a, $state, $env) {
                                                Err($fm) {
                                                    match g7_reduce_value(CgBool, $c, $a, 0, $state, $env) {
                                                        Ok($rv) { Ok(BoolLower(state: $rv.state, c: $rv.c)) }
                                                        Err($rm) { Err($m) }
                                                    }
                                                }
                                                Ok($v) { Ok(BoolLower(state: $v.state, c: $v.c)) }
                                            }
                                        }
                                        Ok($v) { Ok(BoolLower(state: $v.state, c: $v.c)) }
                                    }
                                    }
                                  }
                                }
                            }
                        }
                    }
                      }
                    }
                      }
                    }
                      }
                    }
                      }
                    }
                      }
                    }
                      }
                    }
                  }
                }
            }
            }
                }
            }
        }
        EMatch($subj, $arms) {
            match g6_lower_match(CgBool, $subj, $arms, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(BoolLower(state: $v.state, c: $v.c)) }
            }
        }
        EIndex($obj, $idx) {
            match g7_lower_index(CgBool, $obj, $idx, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(BoolLower(state: $v.state, c: $v.c)) }
            }
        }
        EField($obj, $name) {
            match g8_lower_field_value(CgBool, $obj, $name, $state, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(BoolLower(state: $v.state, c: $v.c)) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Result of lowering a block-valued `if`/`elif`/`else` branch: the updated state
# (decls/interns/counters threaded), the branch's prep statements (`body`, emitted
# INSIDE the branch's `{ }`), the final rvalue/temp assigned into the shared result
# temp, and the releases for the branch's own Str locals (emitted after the
# assignment, still inside the branch block). `terminated` is true when the branch
# ends in an explicit `return` (§11.2 Never): callers must NOT assign into the
# shared result temp (native emitBranch skips the assign when terminated).
class BranchOut {
    has $.state: CgState
    has $.body: Str
    has $.rvalue: Str
    has $.releases: Str
    has $.terminated: Bool
}

# Emit the inside of a value-position if branch: either a terminal `return` body
# (no result-temp assign) or the ordinary `tmp = rvalue; releases` fall-through.
sub g5_if_value_branch_seg($tmp: Str, $br: BranchOut): Str {
    if $br.terminated {
        $br.body
    } else {
        $br.body ~ "\t\t" ~ $tmp ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases
    }
}

# Lower a block-valued branch ending in a value of `$kind`. Leading statements may
# be `print(...)` or scalar/Str bindings; those bindings are visible ONLY within
# the branch (the outer `$env` is passed by value and not extended for siblings),
# and any branch-local Str bindings are released at branch exit so they do not
# outlive it. `$state` must already have an empty body (caller passes
# g4_bodyless_state); the returned `body` is the branch's prep, `rvalue` its final
# value.
sub g4_branch_block_kind($kind: CgKind, $stmts: StmtList, $state: CgState, $env: CgEnv): Result[BranchOut, Str] {
    g4_branch_stmts_kind($kind, $stmts, $state, $env, cg_env_len($env))
}

# A function-valued branch must hand an owned environment reference to the
# shared if/match result. Fresh lambdas and calls already return +1; an alias is
# borrowed and must be retained before branch-local cleanup can release its
# binding.
sub g5_branch_value_retain($kind: CgKind, $e: Expr, $c: Str): Str {
    match $kind {
        CgFn($p, $r) {
            if g5_fn_init_fresh($e) { "" } else { "\t\tguji_retain(" ~ $c ~ ".env);\n" }
        }
        _ { "" }
    }
}

sub g4_branch_stmts_kind($kind: CgKind, $stmts: StmtList, $state: CgState, $env: CgEnv, $baselen: Int): Result[BranchOut, Str] {
    match $stmts {
        StmtNil { Err(g3_unsupported()) }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil {
                    match $head {
                        SExpr($e) {
                            match g4_lower_value($kind, $e, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($v) {
                                    Ok(BranchOut(
                                        state: $v.state,
                                        body: $v.state.body ~ g5_branch_value_retain($kind, $e, $v.c),
                                        rvalue: $v.c,
                                        releases: cg_env_release_strs_n($env, cg_env_len($env) - $baselen),
                                        terminated: false
                                    ))
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                StmtCons($h2, $t2) {
                    match g5_lower_unit_stmt_scoped($head, $state, $env, $baselen) {
                        Err($m) { Err($m) }
                        Ok($next) { g4_branch_stmts_kind($kind, $tail, $next.state, $next.env, $baselen) }
                    }
                }
            }
        }
    }
}

# P3b-2b-2c-4m: `$extra_cleanup` is release code (e.g. an owned match scrutinee)
# that the hoisted `?`'s Err early-return must emit before the C `return`. Every
# recursive dispatch below threads it (dropping it silently leaks on early-exit
# paths — the P3b-2b-2c-4i lesson).
sub g5_branch_final_question_carrier_extra($kind: CgKind, $e: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $baselen: Int, $extra_cleanup: Str): Result[BranchOut, Str] {
    match $e {
        ECall($callee, $args) {
            match $callee {
                ETypeName($ctor) {
                    if $ctor == "Some" || $ctor == "Ok" {
                        match $args {
                            ExprCons($arg, ExprNil) {
                                match g5_question_hoist_all_extra($arg, $state, $env, $retkind, $extra_cleanup) {
                                    Err($m) { Err($m) }
                                    Ok(None) { Err(g3_unsupported()) }
                                    Ok(Some($h)) {
                                        match g4_lower_value($kind, ECall(ETypeName($ctor), ExprCons($h.expr, ExprNil)), $h.state, $h.env) {
                                            Err($m) { Err($m) }
                                            Ok($v) {
                                                Ok(BranchOut(
                                                    state: $v.state,
                                                    body: $v.state.body,
                                                    rvalue: $v.c,
                                                    releases: cg_env_release_strs_n($h.env, cg_env_len($h.env) - $baselen),
                                                    terminated: false
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g5_branch_final_question_value_extra($kind: CgKind, $e: Expr, $state: CgState, $env: CgEnv, $retkind: CgRet, $baselen: Int, $extra_cleanup: Str): Result[BranchOut, Str] {
    match g5_question_hoist_all_extra($e, $state, $env, $retkind, $extra_cleanup) {
        Err($m) { Err($m) }
        Ok(None) { Err(g3_unsupported()) }
        Ok(Some($h)) {
            match g4_lower_value($kind, $h.expr, $h.state, $h.env) {
                Err($m) { Err($m) }
                Ok($v) {
                    Ok(BranchOut(
                        state: $v.state,
                        body: $v.state.body,
                        rvalue: $v.c,
                        releases: cg_env_release_strs_n($h.env, cg_env_len($h.env) - $baselen),
                        terminated: false
                    ))
                }
            }
        }
    }
}

sub g5_branch_stmts_kind_ret_extra($kind: CgKind, $stmts: StmtList, $state: CgState, $env: CgEnv, $baselen: Int, $retkind: CgRet, $extra_cleanup: Str): Result[BranchOut, Str] {
    match $stmts {
        StmtNil { Err(g3_unsupported()) }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil {
                    match $head {
                        # P9-10a: explicit `return` is §11.2 Never — lower like a
                        # statement-position guard return and mark the branch
                        # terminated so the if-value emitter skips `tmp = …`.
                        SReturn($ov) {
                            match g5_guard_return_extra($ov, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok($ret) {
                                    Ok(BranchOut(
                                        state: $ret,
                                        body: $ret.body,
                                        rvalue: "0LL",
                                        releases: "",
                                        terminated: true
                                    ))
                                }
                            }
                        }
                        SExpr($e) {
                            match g5_branch_final_question_carrier_extra($kind, $e, $state, $env, $retkind, $baselen, $extra_cleanup) {
                                Ok($b) { Ok($b) }
                                Err($qm) {
                                    match g5_branch_final_question_value_extra($kind, $e, $state, $env, $retkind, $baselen, $extra_cleanup) {
                                        Ok($b) { Ok($b) }
                                        Err($qv) { g4_branch_stmts_kind($kind, $stmts, $state, $env, $baselen) }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                StmtCons($h2, $t2) {
                    # P9-7b question_deep_chain: a multi-statement Result/Option
                    # if-value (or match-value) branch may contain statement-level
                    # `?` binds and retkind-aware control (`while`/`for`/nested
                    # guard/match/select). Mirror g5_lower_loop_stmts_extra so the
                    # enclosing return carrier reaches those prefixes — falling
                    # straight to g5_lower_unit_stmt forced RUnit and declined
                    # `$n = f()?` / `while { …? }` inside the branch.
                    match g5_stmt_question_bind_extra($head, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok(Some($next)) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                        Ok(None) {
                            match g5_stmt_while_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                Err($m) { Err($m) }
                                Ok(Some($next)) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                                Ok(None) {
                                    match g5_stmt_for_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                        Err($m) { Err($m) }
                                        Ok(Some($next)) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                                        Ok(None) {
                                            match g5_stmt_if_guard_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                Err($m) { Err($m) }
                                                Ok(Some($next)) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                                                Ok(None) {
                                                    match g5_stmt_match_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                        Err($m) { Err($m) }
                                                        Ok(Some($next)) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                                                        Ok(None) {
                                                            match g5_stmt_select_stmt_extra($head, $state, $env, $retkind, $extra_cleanup) {
                                                                Err($m) { Err($m) }
                                                                Ok(Some($next)) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                                                                Ok(None) {
                                                                    match g5_lower_unit_stmt_scoped($head, $state, $env, $baselen) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($next) { g5_branch_stmts_kind_ret_extra($kind, $tail, $next.state, $next.env, $baselen, $retkind, $extra_cleanup) }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_branch_block_kind_ret_extra($kind: CgKind, $stmts: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BranchOut, Str] {
    g5_branch_stmts_kind_ret_extra($kind, $stmts, $state, $env, cg_env_len($env), $retkind, $extra_cleanup)
}

sub g5_branch_block_kind_ret($kind: CgKind, $stmts: StmtList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BranchOut, Str] {
    g5_branch_block_kind_ret_extra($kind, $stmts, $state, $env, $retkind, "")
}

sub g4_if_tail_c($kind: CgKind, $tmp: Str, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv): Result[IfTail, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) {
                    $br_start = g4_bodyless_state($state)
                    match g4_branch_block_kind($kind, $body, $br_start, $env) {
                        Err($m) { Err($m) }
                        Ok($eb) { Ok(IfTail(state: $eb.state, code: " else \{\n" ~ $eb.body ~ "\t\t" ~ $tmp ~ " = " ~ $eb.rvalue ~ ";\n" ~ $eb.releases ~ "\t}")) }
                    }
                }
            }
        }
        ElifCons($head, $rest) {
            $cond_start = g4_bodyless_state($state)
            match g4_bool_lower($head.cond, $cond_start, $env) {
                Err($m) { Err($m) }
                Ok($cond) {
                    $br_start = g4_bodyless_state($cond.state)
                    match g4_branch_block_kind($kind, $head.body, $br_start, $env) {
                        Err($m) { Err($m) }
                        Ok($eb) {
                            match g4_if_tail_c($kind, $tmp, $rest, $els, $eb.state, $env) {
                                Err($m) { Err($m) }
                                Ok($tail) {
                                    Ok(IfTail(
                                        state: $tail.state,
                                        code: " else \{\n" ~ $cond.state.body ~ "\tif (" ~ $cond.c ~ ") \{\n" ~ $eb.body ~ "\t\t" ~ $tmp ~ " = " ~ $eb.rvalue ~ ";\n" ~ $eb.releases ~ "\t}" ~ $tail.code ~ "\n\t}"
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_if_tail_ret($kind: CgKind, $tmp: Str, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[IfTail, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) {
                    $br_start = g4_bodyless_state($state)
                    match g5_branch_block_kind_ret($kind, $body, $br_start, $env, $retkind) {
                        Err($m) { Err($m) }
                        Ok($eb) { Ok(IfTail(state: $eb.state, code: " else \{\n" ~ g5_if_value_branch_seg($tmp, $eb) ~ "\t}")) }
                    }
                }
            }
        }
        ElifCons($head, $rest) {
            $cond_start = g4_bodyless_state($state)
            match g4_bool_lower($head.cond, $cond_start, $env) {
                Err($m) { Err($m) }
                Ok($cond) {
                    $br_start = g4_bodyless_state($cond.state)
                    match g5_branch_block_kind_ret($kind, $head.body, $br_start, $env, $retkind) {
                        Err($m) { Err($m) }
                        Ok($eb) {
                            match g5_if_tail_ret($kind, $tmp, $rest, $els, $eb.state, $env, $retkind) {
                                Err($m) { Err($m) }
                                Ok($tail) {
                                    Ok(IfTail(
                                        state: $tail.state,
                                        code: " else \{\n" ~ $cond.state.body ~ "\tif (" ~ $cond.c ~ ") \{\n" ~ g5_if_value_branch_seg($tmp, $eb) ~ "\t}" ~ $tail.code ~ "\n\t}"
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g5_lower_if_value_ret($kind: CgKind, $cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[CgValueOut, Str] {
    match g4_bool_lower($cond, $state, $env) {
        Err($m) { Err($m) }
        Ok($cc) {
            $tmp = g4_value_tmp($kind, $cc.state.ntmp)
            $branch_state = CgState(
                interns: $cc.state.interns,
                decls: $cc.state.decls ~ g4_value_decl($kind, $tmp),
                body: $cc.state.body,
                nstr: $cc.state.nstr,
                ntmp: $cc.state.ntmp + 1
            )
            $then_start = g4_bodyless_state($branch_state)
            match g5_branch_block_kind_ret($kind, $then, $then_start, $env, $retkind) {
                Err($m) { Err($m) }
                Ok($tb) {
                    match g5_if_tail_ret($kind, $tmp, $elifs, $els, $tb.state, $env, $retkind) {
                        Err($m) { Err($m) }
                        Ok($tail) {
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $tail.state.interns,
                                    decls: $tail.state.decls,
                                    body: $branch_state.body ~ "\tif (" ~ $cc.c ~ ") \{\n" ~ g5_if_value_branch_seg($tmp, $tb) ~ "\t}" ~ $tail.code ~ "\n",
                                    nstr: $tail.state.nstr,
                                    ntmp: $tail.state.ntmp
                                ),
                                c: $tmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g4_lower_if_value($kind: CgKind, $cond: Expr, $then: StmtList, $elifs: ElifList, $els: Option[StmtList], $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_bool_lower($cond, $state, $env) {
        Err($m) { Err($m) }
        Ok($cc) {
            $ti = c_int($cc.state.ntmp)
            $tmp = g4_value_tmp($kind, $cc.state.ntmp)
            $branch_state = CgState(
                interns: $cc.state.interns,
                decls: $cc.state.decls ~ g4_value_decl($kind, $tmp),
                body: $cc.state.body,
                nstr: $cc.state.nstr,
                ntmp: $cc.state.ntmp + 1
            )
            $then_start = g4_bodyless_state($branch_state)
            match g4_branch_block_kind($kind, $then, $then_start, $env) {
                Err($m) { Err($m) }
                Ok($tb) {
                    match g4_if_tail_c($kind, $tmp, $elifs, $els, $tb.state, $env) {
                        Err($m) { Err($m) }
                        Ok($tail) {
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $tail.state.interns,
                                    decls: $tail.state.decls,
                                    body: $branch_state.body ~ "\tif (" ~ $cc.c ~ ") \{\n" ~ $tb.body ~ "\t\t" ~ $tmp ~ " = " ~ $tb.rvalue ~ ";\n" ~ $tb.releases ~ "\t}" ~ $tail.code ~ "\n",
                                    nstr: $tail.state.nstr,
                                    ntmp: $tail.state.ntmp
                                ),
                                c: $tmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g4_lower_value_nonbad($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EMatch($subj, $arms) {
            match $kind {
                CgFn($p, $r) {
                    match g5_fn_arg_kind($value, $env) {
                        Ok($actual) {
                            if cgkind_eq($actual, CgFn($p, $r)) {
                                g6_lower_match($kind, $subj, $arms, $state, $env)
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        Err($m) { Err($m) }
                    }
                }
                _ { g6_lower_match($kind, $subj, $arms, $state, $env) }
            }
        }
        _ {
            match $kind {
                CgInt {
                    match $value {
                        EIf($cond, $then, $elifs, $els) { g4_lower_if_value(CgInt, $cond, $then, $elifs, $els, $state, $env) }
                        ECall($c, $a) {
                            match g4_panic_value(CgInt, $c, $a, $state, $env) {
                                Ok($pv) { Ok($pv) }
                                Err($pm) { g3_int_rvalue_state($value, $state, $env) }
                            }
                        }
                        _ { g3_int_rvalue_state($value, $state, $env) }
                    }
                }
                CgFloat {
                    match $value {
                        EIf($cond, $then, $elifs, $els) { g4_lower_if_value(CgFloat, $cond, $then, $elifs, $els, $state, $env) }
                        ECall($c, $a) {
                            match g4_panic_value(CgFloat, $c, $a, $state, $env) {
                                Ok($pv) { Ok($pv) }
                                Err($pm) { g3b_float_rvalue_state($value, $state, $env) }
                            }
                        }
                        _ { g3b_float_rvalue_state($value, $state, $env) }
                    }
                }
                CgBool {
                    match g4_bool_lower($value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($bv) { Ok(CgValueOut(state: $bv.state, c: $bv.c)) }
                    }
                }
                CgStr {
                    match $value {
                        ECall($c, $a) {
                            match g4_panic_value(CgStr, $c, $a, $state, $env) {
                                Ok($pv) { Ok($pv) }
                                Err($pm) {
                                    match g3_str_lower($value, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($sv) { Ok(CgValueOut(state: $sv.state, c: $sv.tmp)) }
                                    }
                                }
                            }
                        }
                        _ {
                            match g3_str_lower($value, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($sv) { Ok(CgValueOut(state: $sv.state, c: $sv.tmp)) }
                            }
                        }
                    }
                }
                # `Unit` as a value is the literal `()`, a Never-typed panic/exit
                # call (g4_panic_value), or `Result[Unit, Str].unwrap()` /
                # `.expect($m)` (write_file/append_file). Unit carries no data, so
                # it lowers to the int64_t sentinel `0LL`.
                CgUnit {
                    match $value {
                        EUnit { Ok(CgValueOut(state: $state, c: "0LL")) }
                        ECall($c, $a) {
                            match g4_panic_value(CgUnit, $c, $a, $state, $env) {
                                Ok($pv) { Ok($pv) }
                                Err($np) { g4_result_expect_unit($c, $a, $state, $env) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                CgOptInt { g6_option_value(CgOptInt, $value, $state, $env) }
                CgOptFloat { g6_option_value(CgOptFloat, $value, $state, $env) }
                CgOptBool { g6_option_value(CgOptBool, $value, $state, $env) }
                CgOptStr { g6_option_value(CgOptStr, $value, $state, $env) }
                CgOptClass($n) { g6_option_value(CgOptClass($n), $value, $state, $env) }
                CgOptEnum($n) { g6_option_value(CgOptEnum($n), $value, $state, $env) }
                CgOptList($el) { g6_option_value(CgOptList($el), $value, $state, $env) }
                CgOptMap($v) { g6_option_value(CgOptMap($v), $value, $state, $env) }
                CgOptMatch { g6_option_value(CgOptMatch, $value, $state, $env) }
                CgOptBush { g6_option_value(CgOptBush, $value, $state, $env) }
                CgOptCarrier($inner) { g6_option_value(CgOptCarrier($inner), $value, $state, $env) }
                CgMatch { g6_match_value($value, $state, $env) }
                CgBush { g10_bush_owned_value($value, $state, $env) }
                CgHandle { g4_handle_owned_value($value, $state, $env) }
                CgRes($ok, $err) { g6_result_value($kind, $value, $state, $env) }
                CgEnum($n) {
                    match $value {
                        EIf($cond, $then, $elifs, $els) { g4_lower_if_value(CgEnum($n), $cond, $then, $elifs, $els, $state, $env) }
                        _ { g6e_enum_value($n, $value, $state, $env) }
                    }
                }
                CgBoxEnum($n) { Err(g3_unsupported()) }
                CgBoxClass($n) { Err(g3_unsupported()) }
                CgBoxOptClass($n) { Err(g3_unsupported()) }
                CgBoxOptEnum($n) { Err(g3_unsupported()) }
                CgClass($n) { g8_class_value($n, $value, $state, $env) }
                CgList($el) { g7_lower_list_value($el, $value, $state, $env) }
                CgMap($v) { g7_lower_map_value($v, $value, $state, $env) }
                CgFn($p, $r) {
                    match $value {
                        # A lambda VALUE in fn position (e.g. the trailing
                        # expression of an RFn sub): lift it exactly like the
                        # binding path does; the pair hands its env to the
                        # caller.
                        ELambda($lp, $lr, $lb, $lt) {
                            match g5_resolve_lambda_ann($lp, $lr, $lb, $env) {
                                Err($m) { Err($m) }
                                Ok($ann) {
                                    if cgkind_list_eq($p, $ann.pk) && cg_ret_eq($r, $ann.rk) {
                                        g5_emit_lambda_value_ann($ann, $lb, $state, $env)
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                        # Every branch is checked against this exact signature
                        # before the shared result temp is emitted. Branch
                        # lowering retains aliases and transfers fresh lambda/
                        # call environments, so the result always owns +1.
                        EIf($cond, $then, $elifs, $els) {
                            match g5_fn_arg_kind($value, $env) {
                                Ok($actual) {
                                    if cgkind_eq($actual, CgFn($p, $r)) {
                                        g4_lower_if_value(CgFn($p, $r), $cond, $then, $elifs, $els, $state, $env)
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                Err($m) { Err($m) }
                            }
                        }
                        # A call to an RFn sub: materialize the returned pair
                        # into an owned `guji_fn_t` temp (P9-9a).
                        ECall($c, $a) {
                            match g4_option_unwrap_fresh_carrier(CgFn($p, $r), $c, $a, $state, $env) {
                                Ok($fv) { Ok($fv) }
                                Err($not_recv) { g5_call_value(RFn($p, $r), $c, $a, $state, $env) }
                            }
                        }
                        # A bound fn local (alias / rebind source). The C name
                        # is returned as-is; the bind/rebind site retains the
                        # shared env (native emitFnBinding / fnInitFresh=false).
                        EName($n) {
                            match cg_env_lookup($env, $n) {
                                None { Err(g3_unsupported()) }
                                Some($v) {
                                    if cgkind_eq($v.kind, CgFn($p, $r)) {
                                        Ok(CgValueOut(state: $state, c: $v.cname))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                CgChan($el) { g11_chan_value(CgChan($el), $value, $state, $env) }
                CgClosed { Err(g3_unsupported()) }
            }
        }
    }
}

sub g4_lower_value($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        ECall($callee, $args) {
            match g4_bad_call_value($kind, $callee, $state) {
                Ok($v) { Ok($v) }
                Err($not_bad_call) { g4_lower_value_nonbad($kind, $value, $state, $env) }
            }
        }
        _ { g4_lower_value_nonbad($kind, $value, $state, $env) }
    }
}

# ---- G6b-b-2a/b: Option carriers (Int/Float/Bool/Str) --------------------
# The native compiler lowers Option[T] to a small tagged C struct:
# tag 1 = Some(.val), tag 0 = None. Scalar payloads are plain by-value fields;
# Option[Str] owns its active payload and must retain on copies and release on
# scope cleanup. Collection payload carriers own their embedded runtime handles.
sub g6_option_typedefs(): Str {
    "typedef struct \{\n\tint64_t tag;\n\tint64_t val;\n} guji_opt_int;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tdouble val;\n} guji_opt_float;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tint64_t val;\n} guji_opt_bool;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tint64_t val;\n} guji_opt_unit;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tconst char* val;\n} guji_opt_str;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_slice_t val;\n} guji_opt_list;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_map_t val;\n} guji_opt_map;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_match_t* val;\n} guji_opt_match;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_bush_t* val;\n} guji_opt_bush;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_fn_t val;\n} guji_opt_fn;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_int val;\n} guji_opt_opt_int;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_float val;\n} guji_opt_opt_float;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_bool val;\n} guji_opt_opt_bool;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_str val;\n} guji_opt_opt_str;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_list val;\n} guji_opt_opt_list;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_map val;\n} guji_opt_opt_map;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_match val;\n} guji_opt_opt_match;\n\n" ~
    "typedef struct \{\n\tint64_t tag;\n\tguji_opt_bush val;\n} guji_opt_opt_bush;\n\n" ~
    "static const char* guji_carrier_str_guji_opt_int(const guji_opt_int* v) \{\n" ~
    "\tguji_disp_buf b = \{0, 0, 0};\n" ~
    "\tif (v->tag == 0LL) \{ guji_disp_puts(&b, \"None\"); return guji_disp_finish(&b); }\n" ~
    "\tguji_disp_puts(&b, \"Some(\");\n" ~
    "\t\{ const char* _ds = guji_int_str(v->val); guji_disp_puts(&b, _ds); guji_release(_ds); }\n" ~
    "\tguji_disp_puts(&b, \")\");\n" ~
    "\treturn guji_disp_finish(&b);\n}\n\n" ~
    "static const char* guji_carrier_str_guji_opt_float(const guji_opt_float* v) \{\n" ~
    "\tguji_disp_buf b = \{0, 0, 0};\n" ~
    "\tif (v->tag == 0LL) \{ guji_disp_puts(&b, \"None\"); return guji_disp_finish(&b); }\n" ~
    "\tguji_disp_puts(&b, \"Some(\");\n" ~
    "\t\{ const char* _ds = guji_float_str(v->val); guji_disp_puts(&b, _ds); guji_release(_ds); }\n" ~
    "\tguji_disp_puts(&b, \")\");\n" ~
    "\treturn guji_disp_finish(&b);\n}\n\n" ~
    "static const char* guji_carrier_str_guji_opt_bool(const guji_opt_bool* v) \{\n" ~
    "\tguji_disp_buf b = \{0, 0, 0};\n" ~
    "\tif (v->tag == 0LL) \{ guji_disp_puts(&b, \"None\"); return guji_disp_finish(&b); }\n" ~
    "\tguji_disp_puts(&b, \"Some(\");\n" ~
    "\t\{ const char* _ds = guji_bool_str(v->val); guji_disp_puts(&b, _ds); guji_release(_ds); }\n" ~
    "\tguji_disp_puts(&b, \")\");\n" ~
    "\treturn guji_disp_finish(&b);\n}\n\n" ~
    "static const char* guji_carrier_str_guji_opt_str(const guji_opt_str* v) \{\n" ~
    "\tguji_disp_buf b = \{0, 0, 0};\n" ~
    "\tif (v->tag == 0LL) \{ guji_disp_puts(&b, \"None\"); return guji_disp_finish(&b); }\n" ~
    "\tguji_disp_puts(&b, \"Some(\");\n" ~
    "\tguji_disp_putn(&b, v->val, (size_t)GUJI_HDR(v->val)->count);\n" ~
    "\tguji_disp_puts(&b, \")\");\n" ~
    "\treturn guji_disp_finish(&b);\n}\n\n" ~
    "static void guji_chan_drop_opt_str(void* slot) \{\n" ~
    "\tguji_opt_str v = *(guji_opt_str*)slot;\n" ~
    "\tif (v.tag != 0LL) \{ guji_release(v.val); }\n}\n\n" ~
    "static void guji_chan_drop_opt_list(void* slot) \{\n" ~
    "\tguji_opt_list v = *(guji_opt_list*)slot;\n" ~
    "\tif (v.tag != 0LL) \{ guji_release((const void*)v.val.data); }\n}\n\n" ~
    "static void guji_chan_drop_opt_map(void* slot) \{\n" ~
    "\tguji_opt_map v = *(guji_opt_map*)slot;\n" ~
    "\tif (v.tag != 0LL) \{ guji_release((const void*)v.val.keys); guji_release(v.val.vals); }\n}\n\n" ~
    "static void guji_chan_drop_opt_match(void* slot) \{\n" ~
    "\tguji_opt_match v = *(guji_opt_match*)slot;\n" ~
    "\tif (v.tag != 0LL) \{ guji_release((const void*)v.val); }\n}\n\n" ~
    "static void guji_chan_drop_opt_bush(void* slot) \{\n" ~
    "\tguji_opt_bush v = *(guji_opt_bush*)slot;\n" ~
    "\tif (v.tag != 0LL) \{ guji_release((const void*)v.val); }\n}\n\n"
}

sub g6_is_option_kind($kind: CgKind): Bool {
    match $kind {
        CgOptInt { true }
        CgOptFloat { true }
        CgOptBool { true }
        CgOptStr { true }
        CgOptClass($n) { true }
        CgOptEnum($n) { true }
        CgOptList($el) { true }
        CgOptMap($v) { true }
        CgOptMatch { true }
        CgOptBush { true }
        CgOptCarrier($inner) { true }
        CgBoxOptClass($n) { true }
        CgBoxOptEnum($n) { true }
        _ { false }
    }
}

sub g6_option_logical_kind($kind: CgKind): CgKind {
    match $kind {
        CgBoxOptClass($n) { CgOptClass($n) }
        CgBoxOptEnum($n) { CgOptEnum($n) }
        _ { $kind }
    }
}

# Suffix of a by-value Option carrier when embedded as the payload of the
# recv-presence wrapper (`guji_opt_` + `opt_list` → `guji_opt_opt_list`).
sub g6_option_scalar_word($kind: CgKind): Str {
    match $kind {
        CgUnit { "unit" }
        CgOptInt { "opt_int" }
        CgOptFloat { "opt_float" }
        CgOptBool { "opt_bool" }
        CgOptStr { "opt_str" }
        CgOptList($el) { "opt_list" }
        CgOptMap($v) { "opt_map" }
        CgOptMatch { "opt_match" }
        CgOptBush { "opt_bush" }
        CgFn($p, $r) { "fn" }
        _ { "opt_int" }
    }
}

sub g6_option_ctype($kind: CgKind): Str {
    match $kind {
        CgOptInt { "guji_opt_int" }
        CgOptFloat { "guji_opt_float" }
        CgOptBool { "guji_opt_bool" }
        CgOptStr { "guji_opt_str" }
        CgOptList($el) { "guji_opt_list" }
        CgOptMap($v) { "guji_opt_map" }
        CgOptMatch { "guji_opt_match" }
        CgOptBush { "guji_opt_bush" }
        # Recv of Chan[Result[T,E]] is Option[Result] → guji_opt_res_{ok}_{err}
        # (native's wrapper name). Option-of-Option keeps guji_opt_opt_*.
        CgOptCarrier($inner) {
            match $inner {
                CgRes($ok, $err) {
                    "guji_opt_res_" ~ g6_result_kindword($ok) ~ "_" ~ g6_result_kindword($err)
                }
                CgFn($p, $r) { "guji_opt_fn" }
                _ { "guji_opt_" ~ g6_option_scalar_word($inner) }
            }
        }
        # An Option[<class>] carrier is named per wrapped class (E5d-7c-2d-5); the
        # `guji_opt_<Class>` typedef is emitted right after the class's own typedef
        # (see g8_class_typedef_one), so the name is in scope wherever it is used.
        CgOptClass($n) { "guji_opt_" ~ $n }
        # An Option[<enum>] carrier is named per wrapped enum (E5d-7c-2d-7); the
        # `guji_opt_<Enum>` typedef is emitted right after the enum's own typedef
        # (see g6e_enum_typedef_one), so the name is in scope wherever it is used.
        CgOptEnum($n) { "guji_opt_" ~ $n }
        CgBoxOptClass($n) { "guji_opt_" ~ $n }
        CgBoxOptEnum($n) { "guji_opt_" ~ $n }
        _ { "guji_opt_int" }
    }
}

sub g6_option_zero($kind: CgKind): Str {
    match $kind {
        CgOptFloat { "0.0" }
        CgOptStr { "GUJI_EMPTY_STR" }
        CgOptMatch { "NULL" }
        CgOptBush { "NULL" }
        CgOptList($el) { "(guji_slice_t)\{0}" }
        CgOptMap($v) { "(guji_map_t)\{0}" }
        CgOptCarrier($inner) {
            match $inner {
                CgRes($ok, $err) { "(" ~ g6_result_ctype(CgRes($ok, $err)) ~ ")\{0}" }
                CgFn($p, $r) { "(guji_fn_t)\{0}" }
                _ { "(" ~ g6_option_ctype($inner) ~ ")\{0}" }
            }
        }
        # The None slot's inactive payload is a zeroed by-value class struct.
        CgOptClass($n) { "(" ~ $n ~ ")\{0}" }
        # The None slot's inactive payload is a zeroed by-value enum struct.
        CgOptEnum($n) { "(" ~ $n ~ ")\{0}" }
        _ { "0LL" }
    }
}

sub g6_option_retain($kind: CgKind, $c: Str): Str {
    match $kind {
        CgOptStr { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain(" ~ $c ~ ".val); }\n" }
        CgOptMatch { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain((const void*)" ~ $c ~ ".val); }\n" }
        CgOptBush { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain((const void*)" ~ $c ~ ".val); }\n" }
        CgOptList($el) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain((const void*)" ~ $c ~ ".val.data); }\n" }
        CgOptMap($v) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain((const void*)" ~ $c ~ ".val.keys); guji_retain((const void*)" ~ $c ~ ".val.vals); }\n" }
        # A Some(class) payload retains its own owned fields (the embedded class is
        # by value, so there is no pointer to retain — recurse into its fields).
        CgOptClass($n) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain_" ~ $n ~ "_fields(&" ~ $c ~ ".val); }\n" }
        # A Some(enum) payload retains its own owned fields (the embedded enum is
        # by value; recurse into its variant fields via the enum's helper).
        CgOptEnum($n) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_retain_" ~ $n ~ "_fields(&" ~ $c ~ ".val); }\n" }
        CgBoxOptClass($n) { g6_option_retain(CgOptClass($n), $c) }
        CgBoxOptEnum($n) { g6_option_retain(CgOptEnum($n), $c) }
        _ { "" }
    }
}

sub g6_option_release($kind: CgKind, $c: Str): Str {
    match $kind {
        CgOptStr { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release(" ~ $c ~ ".val); " ~ $c ~ ".val = NULL; }\n" }
        CgOptMatch { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $c ~ ".val); " ~ $c ~ ".val = NULL; }\n" }
        CgOptBush { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $c ~ ".val); " ~ $c ~ ".val = NULL; }\n" }
        CgOptList($el) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $c ~ ".val.data); " ~ $c ~ ".val.data = NULL; " ~ $c ~ ".val.len = 0; }\n" }
        CgOptMap($v) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $c ~ ".val.keys); guji_release((const void*)" ~ $c ~ ".val.vals); " ~ $c ~ ".val.keys = NULL; " ~ $c ~ ".val.vals = NULL; " ~ $c ~ ".val.len = 0; }\n" }
        # A Some(class) payload releases its own owned fields; the struct is by
        # value, so there is no pointer to NULL afterward.
        CgOptClass($n) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release_" ~ $n ~ "_fields(&" ~ $c ~ ".val); }\n" }
        # A Some(enum) payload releases its own owned fields; the struct is by
        # value, so there is no pointer to NULL afterward.
        CgOptEnum($n) { "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release_" ~ $n ~ "_fields(&" ~ $c ~ ".val); }\n" }
        CgBoxOptClass($n) { g6_option_release(CgOptClass($n), $c) }
        CgBoxOptEnum($n) { g6_option_release(CgOptEnum($n), $c) }
        # Releasing a recv-presence carrier releases its DELIVERED inner payload
        # (native nests the inner release under the outer tag guard). Option
        # inners use g6_option_release; Result inners use g6_result_release
        # (Chan[Result] recv is Option[Result]). Scalar inners own nothing.
        CgOptCarrier($inner) {
            match $inner {
                CgRes($ok, $err) {
                    $s = g6_result_release(CgRes($ok, $err), $c ~ ".val")
                    if $s == "" {
                        ""
                    } else {
                        "\tif (" ~ $c ~ ".tag != 0LL) \{\n\t" ~ $s ~ "\t}\n"
                    }
                }
                CgFn($p, $r) {
                    "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_release(" ~ $c ~ ".val.env); " ~ $c ~ ".val.env = NULL; }\n"
                }
                _ {
                    $s = g6_option_release($inner, $c ~ ".val")
                    if $s == "" {
                        ""
                    } else {
                        "\tif (" ~ $c ~ ".tag != 0LL) \{\n\t" ~ $s ~ "\t}\n"
                    }
                }
            }
        }
        _ { "" }
    }
}

sub g6_option_retain_or_release($kind: CgKind, $c: Str, $op: Str): Str {
    match $kind {
        CgOptStr {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "(" ~ $c ~ ".val); }\n"
        }
        CgOptMatch {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ ".val); }\n"
        }
        CgOptBush {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ ".val); }\n"
        }
        CgOptList($el) {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ ".val.data); }\n"
        }
        CgOptMap($v) {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ ".val.keys); guji_" ~ $op ~ "((const void*)" ~ $c ~ ".val.vals); }\n"
        }
        CgOptClass($n) {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "_" ~ $n ~ "_fields(&" ~ $c ~ ".val); }\n"
        }
        CgOptEnum($n) {
            "\tif (" ~ $c ~ ".tag != 0LL) \{ guji_" ~ $op ~ "_" ~ $n ~ "_fields(&" ~ $c ~ ".val); }\n"
        }
        CgBoxOptClass($n) { g6_option_retain_or_release(CgOptClass($n), $c, $op) }
        CgBoxOptEnum($n) { g6_option_retain_or_release(CgOptEnum($n), $c, $op) }
        _ { "" }
    }
}

sub g6_option_payload_kind($kind: CgKind): Result[CgKind, Str] {
    match $kind {
        CgOptInt { Ok(CgInt) }
        CgOptFloat { Ok(CgFloat) }
        CgOptBool { Ok(CgBool) }
        CgOptStr { Ok(CgStr) }
        CgOptMatch { Ok(CgMatch) }
        CgOptBush { Ok(CgBush) }
        CgOptList($el) { Ok(CgList($el)) }
        CgOptMap($v) { Ok(CgMap($v)) }
        CgOptClass($n) { Ok(CgClass($n)) }
        CgOptEnum($n) { Ok(CgEnum($n)) }
        CgBoxOptClass($n) { Ok(CgClass($n)) }
        CgBoxOptEnum($n) { Ok(CgEnum($n)) }
        CgOptCarrier($inner) { Ok($inner) }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_option_kind_from_type($ty: Option[TypeRef]): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Option" {
                match typelist_at($tr.args, 0) {
                    None { Err(g3_unsupported()) }
                    Some($elem) {
                        if $elem.name == "Int" {
                            Ok(CgOptInt)
                        } else if $elem.name == "Float" {
                            Ok(CgOptFloat)
                        } else if $elem.name == "Bool" {
                            Ok(CgOptBool)
                        } else if $elem.name == "Str" {
                            Ok(CgOptStr)
                        } else if $elem.name == "Regex" {
                            # Regex is byte-identical to a counted Str in the C
                            # representation. The binding's listlen sentinel
                            # distinguishes Option[Regex] from Option[Str] so a
                            # Some-pattern payload remains Regex-marked.
                            Ok(CgOptStr)
                        } else if $elem.name == "Match" {
                            Ok(CgOptMatch)
                        } else if $elem.name == "Bush" {
                            Ok(CgOptBush)
                        } else if $elem.name == "List" {
                            match g7_list_elem_kind_from_type(Some($elem)) {
                                Ok($el) { Ok(CgOptList($el)) }
                                Err($m) { Err($m) }
                            }
                        } else if $elem.name == "Map" {
                            match g7_map_val_kind_from_type(Some($elem)) {
                                Ok($v) { Ok(CgOptMap($v)) }
                                Err($m) { Err($m) }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# Resolve an `Option[T]` PARAMETER/RETURN type to its carrier kind, env-aware so a
# user-class or user-enum element resolves to the program's per-type carrier
# (`guji_opt_<Class>` / `guji_opt_<Enum>`, already emitted by g8_class_option_typedef
# / g6e_enum_typedef_one for every supported class/enum). This is the signature
# analogue of g8_class_field_kind's Option branch (E5d-7c-2d-5/8): native REJECTS
# user-carrier options, so an `Option[<user class>]`/`Option[<user enum>]` signature
# is interp-oracle (COVERED-BEYOND) work (slice 5 E5d-7c-2d-9). Scalar/Str elements
# fall back to the scalar resolver; a non-Option type or unknown element is
# unsupported.
sub g6_option_kind_from_type_env($ty: Option[TypeRef], $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Option" {
                match typelist_at($tr.args, 0) {
                    None { g6_option_kind_from_type($ty) }
                    Some($elem) {
                        match cg_env_lookup_class($env, $elem.name) {
                            Some($info) { Ok(CgOptClass($elem.name)) }
                            None {
                                match cg_env_lookup_enum($env, $elem.name) {
                                    Some($einfo) {
                                        if g6e_enum_fields_supported($einfo) { Ok(CgOptEnum($elem.name)) } else { Err(g3_unsupported()) }
                                    }
                                    None { g6_option_kind_from_type($ty) }
                                }
                            }
                        }
                    }
                }
            } else {
                g6_option_kind_from_type($ty)
            }
        }
    }
}

sub g6_option_one_arg($args: ExprList): Result[Expr, Str] {
    match $args {
        ExprCons($arg, ExprNil) { Ok($arg) }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_option_kind_for_result_slot($slot: CgKind): Result[CgKind, Str] {
    match $slot {
        CgInt { Ok(CgOptInt) }
        CgFloat { Ok(CgOptFloat) }
        CgBool { Ok(CgOptBool) }
        CgStr { Ok(CgOptStr) }
        _ { Err(g3_unsupported()) }
    }
}

class ResultOkErrParts {
    has $.v: CgVar
    has $.slot: Str
    has $.cmp: Str
}

sub g6_result_ok_err_recv($want: CgKind, $method: Str, $recv: Expr, $env: CgEnv): Result[ResultOkErrParts, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgRes($ok, $err) {
                            $slot_kind = if $method == "ok" { $ok } else { $err }
                            match g6_option_kind_for_result_slot($slot_kind) {
                                Err($m) { Err($m) }
                                Ok($actual) {
                                    if cgkind_eq($want, $actual) {
                                        $slot = if $method == "ok" { "ok" } else { "err" }
                                        $cmp = if $method == "ok" { "== 0LL" } else { "!= 0LL" }
                                        Ok(ResultOkErrParts(v: $v, slot: $slot, cmp: $cmp))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_result_ok_err_parts($want: CgKind, $callee: Expr, $args: ExprList, $env: CgEnv): Result[ResultOkErrParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "ok" || $method == "err" {
                match $args {
                    ExprNil { g6_result_ok_err_recv($want, $method, $recv, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "ok" || $fn == "err" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprNil) { g6_result_ok_err_recv($want, $fn, $recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15.5 Result `ok`/`err`: convert a bound Result local to Option[Ok] or
# Option[Err]. Native leaves the fresh Option at its zero-value None and fills
# tag/val only when the requested Result arm is active; a Str slot is retained so
# the produced Option owns its Some payload independently of the source Result.
sub g6_result_ok_err_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_result_ok_err_parts($kind, $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            $tmp = g4_value_tmp($kind, $state.ntmp)
            $retain = match $kind {
                CgOptStr { "\tif (" ~ $p.v.cname ~ ".tag " ~ $p.cmp ~ ") \{ guji_retain(" ~ $tmp ~ ".val); }\n" }
                _ { "" }
            }
            Ok(CgValueOut(
                state: CgState(
                    interns: $state.interns,
                    decls: $state.decls ~ g4_value_decl($kind, $tmp),
                    body: $state.body ~
                        "\tif (" ~ $p.v.cname ~ ".tag " ~ $p.cmp ~ ") \{ " ~ $tmp ~ ".tag = 1LL; " ~ $tmp ~ ".val = " ~ $p.v.cname ~ "." ~ $p.slot ~ "; }\n" ~
                        $retain,
                    nstr: $state.nstr,
                    ntmp: $state.ntmp + 1
                ),
                c: $tmp
            ))
        }
    }
}

# §15.5 Option `ok_or`: convert a bound Option[T] local into a fresh Result[T, E].
# `Some(v)` -> `Ok(v)`, `None` -> `Err($err)`. Native lowers a bound-Option receiver
# and an err expression to a zeroed Result temp filled per the source Option tag:
#   if (opt.tag != 0) { r.tag = 0; r.ok = opt.val; } else { r.tag = 1; r.err = <err>; }
# then retains the Str Ok slot on the Some path (opt.val is borrowed from the Option
# binding, so the fresh Result must co-own it). For a Str err native retains the
# borrowed err on the None path; the selfhost port instead lowers the err to an OWNED
# tmp (g4_lower_value/g3_str_lower), retains it into the Err slot under the None guard,
# then releases the owned tmp unconditionally — refcount-balanced on BOTH arms (the
# tmp is freed on the Some path where the err is discarded, and co-owned by the Result
# on the None path). The source Result binding cleanup releases the active slot.
class OkOrParts {
    has $.recv: CgVar
    has $.err: Expr
}

# The Err slot must be a scalar or Str for this port; user class/enum err payloads
# need field-level retains that this uniform lowering does not emit, so decline them.
sub g6_ok_or_err_supported($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        CgStr { true }
        _ { false }
    }
}

sub g6_ok_or_recv($kind: CgKind, $recv: Expr, $errarg: Expr, $env: CgEnv): Result[OkOrParts, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $kind {
                        CgRes($ok, $err) {
                            match g6_option_kind_for_result_slot($ok) {
                                Err($m) { Err($m) }
                                Ok($want_opt) {
                                    if cgkind_eq($v.kind, $want_opt) {
                                        if g6_ok_or_err_supported($err) {
                                            Ok(OkOrParts(recv: $v, err: $errarg))
                                        } else {
                                            Err(g3_unsupported())
                                        }
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Method form `$o.ok_or($e)` is prelude in native (a user `sub ok_or` does not shadow
# the data-first method), matching Result `ok`/`err`. Function form `ok_or($o, $e)`
# defers to a user shadow via cg_env_lookup_sub.
sub g6_ok_or_parts($kind: CgKind, $callee: Expr, $args: ExprList, $env: CgEnv): Result[OkOrParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "ok_or" {
                match $args {
                    ExprCons($errarg, ExprNil) { g6_ok_or_recv($kind, $recv, $errarg, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "ok_or" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($errarg, ExprNil)) { g6_ok_or_recv($kind, $recv, $errarg, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_ok_or_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_ok_or_parts($kind, $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            $ok_kind = g6_result_ok_kind($kind)
            $err_kind = g6_result_err_kind($kind)
            match g4_lower_value($err_kind, $p.err, $state, $env) {
                Err($m) { Err($m) }
                Ok($ev) {
                    $tmp = g4_value_tmp($kind, $ev.state.ntmp)
                    $recv_c = $p.recv.cname
                    $fill = "\tif (" ~ $recv_c ~ ".tag != 0LL) \{ " ~ $tmp ~ ".tag = 0LL; " ~ $tmp ~ ".ok = " ~ $recv_c ~ ".val; } else \{ " ~ $tmp ~ ".tag = 1LL; " ~ $tmp ~ ".err = " ~ $ev.c ~ "; }\n"
                    $ok_retain = match $ok_kind {
                        CgStr { "\tif (" ~ $recv_c ~ ".tag != 0LL) \{ guji_retain(" ~ $tmp ~ ".ok); }\n" }
                        _ { "" }
                    }
                    $err_retain = match $err_kind {
                        CgStr { "\tif (" ~ $recv_c ~ ".tag == 0LL) \{ guji_retain(" ~ $tmp ~ ".err); }\n" }
                        _ { "" }
                    }
                    $err_release = match $err_kind {
                        CgStr { "\tguji_release(" ~ $ev.c ~ ");\n" }
                        _ { "" }
                    }
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $ev.state.interns,
                            decls: $ev.state.decls ~ g4_value_decl($kind, $tmp),
                            body: $ev.state.body ~ $fill ~ $ok_retain ~ $err_retain ~ $err_release,
                            nstr: $ev.state.nstr,
                            ntmp: $ev.state.ntmp + 1
                        ),
                        c: $tmp
                    ))
                }
            }
        }
    }
}

# P5b-2b(carrier-conversion): infer the OPTION carrier kind a §15.5 Result->Option
# conversion produces, so an UNANNOTATED bind `$o = $r.ok()` / `$o = err($r)` lowers
# through the IDENTICAL g6_result_ok_err_value path the annotated form takes. The
# receiver must be a bound Result local whose requested slot is scalar/Str (the same
# g6_option_kind_for_result_slot boundary the lowering enforces), so inference never
# accepts a shape the lowering would then decline.
sub g6_conv_ok_err_recv_kind($method: Str, $recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgRes($ok, $err) {
                            $slot_kind = if $method == "ok" { $ok } else { $err }
                            g6_option_kind_for_result_slot($slot_kind)
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Shadow semantics mirror g6_result_ok_err_parts exactly: the method form is prelude
# (data-first, a user `sub ok`/`sub err` does not shadow it), the function form
# defers to a user shadow via cg_env_lookup_sub so inference and lowering resolve
# the SAME callee.
sub g6_conv_option_kind_from_call($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "ok" || $method == "err" {
                match $args {
                    ExprNil { g6_conv_ok_err_recv_kind($method, $recv, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "ok" || $fn == "err" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprNil) { g6_conv_ok_err_recv_kind($fn, $recv, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# P5b-2b(carrier-conversion): infer the RESULT carrier kind a §15.5 Option->Result
# `ok_or` conversion produces (`$s.ok_or("missing")` / `ok_or($n, "absent")`), the
# ok_or twin of g6_conv_option_kind_from_call. The Ok slot comes from the bound
# Option receiver's scalar/Str payload (the g6_option_kind_for_result_slot inverse,
# restricted to the four kinds the lowering accepts); the Err slot from the err
# argument's inferred kind, gated by the SAME g6_ok_or_err_supported boundary
# g6_ok_or_recv enforces.
sub g6_conv_ok_or_payload($k: CgKind): Result[CgKind, Str] {
    match $k {
        CgOptInt { Ok(CgInt) }
        CgOptFloat { Ok(CgFloat) }
        CgOptBool { Ok(CgBool) }
        CgOptStr { Ok(CgStr) }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_conv_ok_or_recv_kind($recv: Expr, $errarg: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match g6_conv_ok_or_payload($v.kind) {
                        Err($m) { Err($m) }
                        Ok($payload) {
                            match g5_kind_from_expr($errarg, $env) {
                                None { Err(g3_unsupported()) }
                                Some($ek) {
                                    if g6_ok_or_err_supported($ek) {
                                        Ok(CgRes($payload, $ek))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Shadow semantics mirror g6_ok_or_parts: method form is prelude, function form
# defers to a user `sub ok_or`.
sub g6_conv_ok_or_kind_from_call($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "ok_or" {
                match $args {
                    ExprCons($errarg, ExprNil) { g6_conv_ok_or_recv_kind($recv, $errarg, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "ok_or" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($errarg, ExprNil)) { g6_conv_ok_or_recv_kind($recv, $errarg, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §15.5 Option `map`: transform a bound Option[T] local into a fresh Option[U]
# through a single-expression inline lambda, `Some(v)` -> `Some(f(v))`, `None` ->
# `None`. Native (cc-wrapper captured) lowers it to a zeroed Option[U] temp filled
# only under the Some guard:
#   if (opt.tag != 0) { <binder> = opt.val; <body>; r.tag = 1; r.val = <result>; }
# The binder BORROWS the source payload (no retain — the source binding keeps it
# alive for the guard's duration, exactly like the unwrap_or_else Err binder); a
# Str body result is an OWNED tmp (g4_lower_value CgStr -> g3_str_lower) MOVED into
# the fresh Some slot with no extra retain, matching native — the produced Option
# owns its payload and the consuming binding's cleanup releases it once. Source T
# and result U are independently scalar/Str (cross-kind maps like Int->Str are
# native-accepted); list/class/enum payloads decline (binder/slot ownership for
# those needs per-field handling this uniform path does not emit).
class OptionMapParts {
    has $.recv: CgVar
    has $.lam: Expr
}

sub g6_option_map_payload($kind: CgKind): Result[CgKind, Str] {
    match $kind {
        CgOptInt { Ok(CgInt) }
        CgOptFloat { Ok(CgFloat) }
        CgOptBool { Ok(CgBool) }
        CgOptStr { Ok(CgStr) }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_option_map_recv($recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match g6_option_map_payload($v.kind) {
                        Err($m) { Err($m) }
                        Ok($t) { Ok($v) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Method form `$o.map(f)` is prelude in native (a user `sub map` does not shadow
# the data-first method); function form `map($o, f)` defers to a user shadow via
# cg_env_lookup_sub (the parts matcher declines, so the chain falls through to
# g5_call_value which resolves the user sub).
sub g6_option_map_parts($callee: Expr, $args: ExprList, $env: CgEnv): Result[OptionMapParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "map" {
                match $args {
                    ExprCons($lam, ExprNil) {
                        match g6_option_map_recv($recv, $env) {
                            Err($m) { Err($m) }
                            Ok($v) { Ok(OptionMapParts(recv: $v, lam: $lam)) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "map" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) {
                                match g6_option_map_recv($recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($v) { Ok(OptionMapParts(recv: $v, lam: $lam)) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_option_map_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_map_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_map_payload($kind) {
                Err($m) { Err($m) }
                Ok($u) {
                    match g6_option_map_payload($p.recv.kind) {
                        Err($m) { Err($m) }
                        Ok($t) {
                            match $p.lam {
                                ELambda($params, $ret, $body, $topic) {
                                    match g7_lambda_body_expr($body) {
                                        Err($m) { Err($m) }
                                        Ok($expr) {
                                            $tmp = g4_value_tmp($kind, $state.ntmp)
                                            $binder = g4_value_tmp($t, $state.ntmp + 1)
                                            match g7_lambda_env($params, $t, $binder, $env) {
                                                Err($m) { Err($m) }
                                                Ok($lenv) {
                                                    $guard_start = CgState(
                                                        interns: $state.interns,
                                                        decls: $state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($t, $binder),
                                                        body: "",
                                                        nstr: $state.nstr,
                                                        ntmp: $state.ntmp + 2
                                                    )
                                                    match g4_lower_value($u, $expr, $guard_start, $lenv) {
                                                        Err($m) { Err($m) }
                                                        Ok($fb) {
                                                            Ok(CgValueOut(
                                                                state: CgState(
                                                                    interns: $fb.state.interns,
                                                                    decls: $fb.state.decls,
                                                                    body: $state.body ~
                                                                        "\tif (" ~ $p.recv.cname ~ ".tag != 0) \{\n" ~
                                                                        "\t\t" ~ $binder ~ " = " ~ $p.recv.cname ~ ".val;\n" ~
                                                                        $fb.state.body ~
                                                                        "\t\t" ~ $tmp ~ ".tag = 1; " ~ $tmp ~ ".val = " ~ $fb.c ~ ";\n" ~
                                                                        "\t}\n",
                                                                    nstr: $fb.state.nstr,
                                                                    ntmp: $fb.state.ntmp
                                                                ),
                                                                c: $tmp
                                                            ))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# §15.5 Option/Result higher-order carriers share a method/function spelling:
# `$x.name(lam)` or `name($x, lam)`. Bound EName receivers stay on the borrow
# path; call/expression receivers materialize to an owned temp (P9-7b-3).
class CarrierLamParts {
    has $.recv: Expr
    has $.lam: Expr
}

class MatCarrierRecv {
    has $.v: CgVar
    has $.state: CgState
    has $.owned_tmp: Bool
}

sub g6_carrier_lam_parts($name: Str, $callee: Expr, $args: ExprList, $env: CgEnv): Result[CarrierLamParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == $name {
                match $args {
                    ExprCons($lam, ExprNil) { Ok(CarrierLamParts(recv: $recv, lam: $lam)) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == $name {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) { Ok(CarrierLamParts(recv: $recv, lam: $lam)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Resolve an Option and_then/map-shaped receiver kind: bound scalar Option local,
# or any expression whose Option kind has a scalar/Str payload (call-produced).
sub g6_option_and_then_recv_kind($recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $recv {
        EName($n) {
            match g6_option_map_recv($recv, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok($v.kind) }
            }
        }
        _ {
            match g6_option_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($opkind) {
                    match g6_option_map_payload($opkind) {
                        Err($m) { Err($m) }
                        Ok($t) { Ok($opkind) }
                    }
                }
            }
        }
    }
}

# Materialize a non-EName Option receiver into an owned carrier temp; EName stays
# a borrow of the binding (owned_tmp=false). Matches native `gt0 = gf_...(…);`.
sub g6_option_materialize_map_recv($recv: Expr, $state: CgState, $env: CgEnv): Result[MatCarrierRecv, Str] {
    match $recv {
        EName($n) {
            match g6_option_map_recv($recv, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(MatCarrierRecv(v: $v, state: $state, owned_tmp: false)) }
            }
        }
        _ {
            match g6_option_and_then_recv_kind($recv, $env) {
                Err($m) { Err($m) }
                Ok($opkind) {
                    match g6_option_value($opkind, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cv) {
                            $qtmp = g4_value_tmp($opkind, $cv.state.ntmp)
                            Ok(MatCarrierRecv(
                                v: CgVar(name: "", cname: $qtmp, kind: $opkind, mutable: false, borrowed: false, listlen: 0),
                                state: CgState(
                                    interns: $cv.state.interns,
                                    decls: $cv.state.decls ~ g4_value_decl($opkind, $qtmp),
                                    body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                    nstr: $cv.state.nstr,
                                    ntmp: $cv.state.ntmp + 1
                                ),
                                owned_tmp: true
                            ))
                        }
                    }
                }
            }
        }
    }
}

# §15.5 Option `and_then`: transform a bound Option[T] local OR a call-produced
# Option[T] temp into a fresh Option[U] through a single-expression inline lambda
# returning an Option carrier. Native lowers it as `map`'s carrier-returning
# sibling: only the Some arm binds the borrowed payload and evaluates the
# callback, then copies the callback's carrier result into the output temp; the
# None arm writes an explicit zeroed carrier of the requested result kind. A
# materialized call receiver is released after the if/else (scalar payloads are
# no-ops; Str payloads drop the owned Some slot).
sub g6_option_and_then_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_carrier_lam_parts("and_then", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_and_then_recv_kind($p.recv, $env) {
                Err($m) { Err($m) }
                Ok($src_kind) {
                    match g6_option_map_payload($src_kind) {
                        Err($m) { Err($m) }
                        Ok($t) {
                            match $p.lam {
                                ELambda($params, $ret, $body, $topic) {
                                    match g7_lambda_body_expr($body) {
                                        Err($m) { Err($m) }
                                        Ok($expr) {
                                            match g7_lambda_env($params, $t, "gopt_and_then_probe", $env) {
                                                Err($m) { Err($m) }
                                                Ok($lenv) {
                                                    match g6_option_kind_from_value($expr, $lenv) {
                                                        Err($m0) {
                                                            match g6_option_kind_from_type($ret) {
                                                                Err($tm) { Err($tm) }
                                                                Ok($rk) {
                                                                    match g6_option_map_payload($rk) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($u) { Ok($rk) }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        Ok($rk) {
                                                            match g6_option_map_payload($rk) {
                                                                Err($m) { Err($m) }
                                                                Ok($u) { Ok($rk) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g6_option_and_then_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_carrier_lam_parts("and_then", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_map_payload($kind) {
                Err($m) { Err($m) }
                Ok($u) {
                    match g6_option_materialize_map_recv($p.recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($mr) {
                            match g6_option_map_payload($mr.v.kind) {
                                Err($m) { Err($m) }
                                Ok($t) {
                                    match $p.lam {
                                        ELambda($params, $ret, $body, $topic) {
                                            match g7_lambda_body_expr($body) {
                                                Err($m) { Err($m) }
                                                Ok($expr) {
                                                    $tmp = g4_value_tmp($kind, $mr.state.ntmp)
                                                    $binder = g4_value_tmp($t, $mr.state.ntmp + 1)
                                                    match g7_lambda_env($params, $t, $binder, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($lenv) {
                                                            $guard_start = CgState(
                                                                interns: $mr.state.interns,
                                                                decls: $mr.state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($t, $binder),
                                                                body: "",
                                                                nstr: $mr.state.nstr,
                                                                ntmp: $mr.state.ntmp + 2
                                                            )
                                                            match g6_option_value($kind, $expr, $guard_start, $lenv) {
                                                                Err($m) { Err($m) }
                                                                Ok($fb) {
                                                                    $release = if $mr.owned_tmp { g6_option_release($mr.v.kind, $mr.v.cname) } else { "" }
                                                                    Ok(CgValueOut(
                                                                        state: CgState(
                                                                            interns: $fb.state.interns,
                                                                            decls: $fb.state.decls,
                                                                            body: $mr.state.body ~
                                                                                "\tif (" ~ $mr.v.cname ~ ".tag != 0) \{\n" ~
                                                                                "\t\t" ~ $binder ~ " = " ~ $mr.v.cname ~ ".val;\n" ~
                                                                                $fb.state.body ~
                                                                                "\t\t" ~ $tmp ~ " = " ~ $fb.c ~ ";\n" ~
                                                                                "\t} else \{\n" ~
                                                                                "\t\t" ~ $tmp ~ ".tag = 0; " ~ $tmp ~ ".val = " ~ g6_option_zero($kind) ~ ";\n" ~
                                                                                "\t}\n" ~
                                                                                $release,
                                                                            nstr: $fb.state.nstr,
                                                                            ntmp: $fb.state.ntmp
                                                                        ),
                                                                        c: $tmp
                                                                    ))
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# §15.5 Option `filter`: keep a bound Option[T] local's payload iff a predicate
# lambda `sub($v: T): Bool { ... }` holds, else yield None; the result carrier is
# Option[T] (the SAME payload kind — filter never changes T). Native lowers it to
# a zeroed Option[T] temp filled only under the Some+predicate guard:
#   if (opt.tag != 0) {
#       binder = opt.val;
#       if (<pred>) { r.tag = 1; r.val = opt.val; }
#   }
# For a Str payload native emits a SEPARATE `if (<pred>) { guji_retain(r.val); }`
# (both the source Option and the fresh result carry the same heap Str, so the
# result must co-own it). The selfhost port folds that retain into the SAME
# tag-set block — observably identical (three-way = stdout+stderr+exit) and it
# lowers the predicate ONCE (re-emitting it would duplicate temps/interns); being
# cleaner than native's twice-evaluated retain is fine (precedent: `ok_or`). The
# borrowed binder never retains/releases (g7_lambda_env marks it borrowed), and
# the None path leaves the zeroed temp untouched.
sub g6_option_filter_retain($t: CgKind, $tmp: Str): Str {
    match $t {
        CgStr { " guji_retain(" ~ $tmp ~ ".val);" }
        _ { "" }
    }
}

sub g6_option_filter_parts($callee: Expr, $args: ExprList, $env: CgEnv): Result[OptionMapParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "filter" {
                match $args {
                    ExprCons($lam, ExprNil) {
                        match g6_option_map_recv($recv, $env) {
                            Err($m) { Err($m) }
                            Ok($v) { Ok(OptionMapParts(recv: $v, lam: $lam)) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "filter" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) {
                                match g6_option_map_recv($recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($v) { Ok(OptionMapParts(recv: $v, lam: $lam)) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_option_filter_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_filter_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_map_payload($kind) {
                Err($m) { Err($m) }
                Ok($u) {
                    match g6_option_map_payload($p.recv.kind) {
                        Err($m) { Err($m) }
                        Ok($t) {
                            if cgkind_eq($kind, $p.recv.kind) {
                                match $p.lam {
                                    ELambda($params, $ret, $body, $topic) {
                                        match g7_lambda_body_expr($body) {
                                            Err($m) { Err($m) }
                                            Ok($expr) {
                                                $tmp = g4_value_tmp($kind, $state.ntmp)
                                                $binder = g4_value_tmp($t, $state.ntmp + 1)
                                                match g7_lambda_env($params, $t, $binder, $env) {
                                                    Err($m) { Err($m) }
                                                    Ok($lenv) {
                                                        $guard_start = CgState(
                                                            interns: $state.interns,
                                                            decls: $state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($t, $binder),
                                                            body: "",
                                                            nstr: $state.nstr,
                                                            ntmp: $state.ntmp + 2
                                                        )
                                                        match g4_lower_value(CgBool, $expr, $guard_start, $lenv) {
                                                            Err($m) { Err($m) }
                                                            Ok($fb) {
                                                                Ok(CgValueOut(
                                                                    state: CgState(
                                                                        interns: $fb.state.interns,
                                                                        decls: $fb.state.decls,
                                                                        body: $state.body ~
                                                                            "\tif (" ~ $p.recv.cname ~ ".tag != 0) \{\n" ~
                                                                            "\t\t" ~ $binder ~ " = " ~ $p.recv.cname ~ ".val;\n" ~
                                                                            $fb.state.body ~
                                                                            "\t\tif (" ~ $fb.c ~ ") \{ " ~ $tmp ~ ".tag = 1; " ~ $tmp ~ ".val = " ~ $p.recv.cname ~ ".val;" ~ g6_option_filter_retain($t, $tmp) ~ " }\n" ~
                                                                            "\t}\n",
                                                                        nstr: $fb.state.nstr,
                                                                        ntmp: $fb.state.ntmp
                                                                    ),
                                                                    c: $tmp
                                                                ))
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                    }
                }
            }
        }
    }
}

# Kind inference for UNANNOTATED `$o = <opt>.map(f)` / `map(<opt>, f)` binds,
# the Option twin of g6_result_map_kind_for. The parts matcher supplies the
# lowering's exact shadow semantics (method form is prelude, function form
# defers to a user `sub map`), the source payload T comes through the SAME
# g6_option_map_payload boundary the lowering enforces, and the result payload
# U is probed from the lambda body under a throwaway binder env via
# g7_scalar_elem_kind (the mechanism g6_result_map_kind_for proved) — so
# inference never accepts a shape g6_option_map_value then declines.
sub g6_option_map_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_option_map_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_map_payload($p.recv.kind) {
                Err($m) { Err($m) }
                Ok($t) {
                    match $p.lam {
                        ELambda($params, $ret, $body, $topic) {
                            match g7_lambda_body_expr($body) {
                                Err($m) { Err($m) }
                                Ok($expr) {
                                    match g7_lambda_env($params, $t, "gopt_map_probe", $env) {
                                        Err($m) { Err($m) }
                                        Ok($lenv) {
                                            match g7_scalar_elem_kind($expr, $lenv) {
                                                Err($m) { Err($m) }
                                                Ok($u) { g6_option_kind_for_result_slot($u) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# Kind inference for UNANNOTATED `$o = <opt>.filter(f)` binds. filter never
# changes the payload kind, so the result carrier IS the receiver's kind; the
# predicate body is probed as CgBool against a throwaway state (verdict-only,
# no C emitted) so inference accepts exactly the shapes g6_option_filter_value
# lowers.
sub g6_option_filter_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_option_filter_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_map_payload($p.recv.kind) {
                Err($m) { Err($m) }
                Ok($t) {
                    match $p.lam {
                        ELambda($params, $ret, $body, $topic) {
                            match g7_lambda_body_expr($body) {
                                Err($m) { Err($m) }
                                Ok($expr) {
                                    match g7_lambda_env($params, $t, "gopt_filter_probe", $env) {
                                        Err($m) { Err($m) }
                                        Ok($lenv) {
                                            $probe = CgState(interns: "", decls: "", body: "", nstr: 0, ntmp: 0)
                                            match g4_lower_value(CgBool, $expr, $probe, $lenv) {
                                                Err($m) { Err($m) }
                                                Ok($bv) { Ok($p.recv.kind) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# §15.5 Result `map` / `map_err`: transform a bound Result[T,E] local into a
# fresh carrier through a single-expression inline lambda. Native lowers only
# the mapped arm through the callback and copies the other slot unchanged.
# `map` (Ok arm mapped, Result[U,E]):
#   if (res.tag == 0) { binder = res.ok; <body>; out.tag = 0; out.ok = <body>; }
#   else { out.tag = 1; out.err = res.err; retain-if-Str(out.err); }
# `map_err` (Err arm mapped, Result[T,F]) is the exact polarity swap:
#   if (res.tag != 0) { binder = res.err; <body>; out.tag = 1; out.err = <body>; }
#   else { out.tag = 0; out.ok = res.ok; retain-if-Str(out.ok); }
# The mapped-arm binder BORROWS the source payload, and a Str callback result is
# an owned tmp MOVED into the fresh slot. The copied slot is borrowed from the
# source Result, so a Str copy must be retained for the fresh carrier to co-own it.
sub g6_result_map_recv($recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgRes($ok, $err) {
                            if g6_ok_or_err_supported($ok) && g6_ok_or_err_supported($err) {
                                Ok($v)
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_result_map_parts($name: Str, $callee: Expr, $args: ExprList, $env: CgEnv): Result[OptionMapParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == $name {
                match $args {
                    ExprCons($lam, ExprNil) {
                        match g6_result_map_recv($recv, $env) {
                            Err($m) { Err($m) }
                            Ok($v) { Ok(OptionMapParts(recv: $v, lam: $lam)) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == $name {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($lam, ExprNil)) {
                                match g6_result_map_recv($recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($v) { Ok(OptionMapParts(recv: $v, lam: $lam)) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_result_map_kind_for($name: Str, $callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_result_map_parts($name, $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.recv.kind {
                CgRes($ok, $err) {
                    $src = if $name == "map_err" { $err } else { $ok }
                    match $p.lam {
                        ELambda($params, $ret, $body, $topic) {
                            match g7_lambda_body_expr($body) {
                                Err($m) { Err($m) }
                                Ok($expr) {
                                    match g7_lambda_env($params, $src, "gres_map_probe", $env) {
                                        Err($m) { Err($m) }
                                        Ok($lenv) {
                                            match g7_scalar_elem_kind($expr, $lenv) {
                                                Err($m) { Err($m) }
                                                Ok($u) {
                                                    if $name == "map_err" { Ok(CgRes($ok, $u)) } else { Ok(CgRes($u, $err)) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g6_result_map_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_result_map_kind_for("map", $callee, $args, $env) {
        Ok($k) { Ok($k) }
        Err($not_map) { g6_result_map_kind_for("map_err", $callee, $args, $env) }
    }
}

sub g6_result_map_err_retain($err: CgKind, $tmp: Str): Str {
    match $err {
        CgStr { "\t\tguji_retain(" ~ $tmp ~ ".err);\n" }
        _ { "" }
    }
}

sub g6_result_map_ok_retain($ok: CgKind, $tmp: Str): Str {
    match $ok {
        CgStr { "\t\tguji_retain(" ~ $tmp ~ ".ok);\n" }
        _ { "" }
    }
}

sub g6_result_map_ok_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_result_map_parts("map", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $kind {
                CgRes($u, $want_err) {
                    if g6_ok_or_err_supported($u) && g6_ok_or_err_supported($want_err) {
                        match $p.recv.kind {
                            CgRes($t, $src_err) {
                                if cgkind_eq($want_err, $src_err) {
                                    match $p.lam {
                                        ELambda($params, $ret, $body, $topic) {
                                            match g7_lambda_body_expr($body) {
                                                Err($m) { Err($m) }
                                                Ok($expr) {
                                                    $tmp = g4_value_tmp($kind, $state.ntmp)
                                                    $binder = g4_value_tmp($t, $state.ntmp + 1)
                                                    match g7_lambda_env($params, $t, $binder, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($lenv) {
                                                            $ok_start = CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($t, $binder),
                                                                body: "",
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 2
                                                            )
                                                            match g4_lower_value($u, $expr, $ok_start, $lenv) {
                                                                Err($m) { Err($m) }
                                                                Ok($fb) {
                                                                    Ok(CgValueOut(
                                                                        state: CgState(
                                                                            interns: $fb.state.interns,
                                                                            decls: $fb.state.decls,
                                                                            body: $state.body ~
                                                                                "\tif (" ~ $p.recv.cname ~ ".tag == 0) \{\n" ~
                                                                                "\t\t" ~ $binder ~ " = " ~ $p.recv.cname ~ ".ok;\n" ~
                                                                                $fb.state.body ~
                                                                                "\t\t" ~ $tmp ~ ".tag = 0; " ~ $tmp ~ ".ok = " ~ $fb.c ~ ";\n" ~
                                                                                "\t} else \{\n" ~
                                                                                "\t\t" ~ $tmp ~ ".tag = 1; " ~ $tmp ~ ".err = " ~ $p.recv.cname ~ ".err;\n" ~
                                                                                g6_result_map_err_retain($want_err, $tmp) ~
                                                                                "\t}\n",
                                                                            nstr: $fb.state.nstr,
                                                                            ntmp: $fb.state.ntmp
                                                                        ),
                                                                        c: $tmp
                                                                    ))
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15.5 Result `map_err`: the polarity swap of `map`. The Err arm runs the
# callback into the fresh `.err` slot; the Ok arm copies `.ok` across (a Str Ok
# copy is borrowed from the source, so the fresh carrier retains it to co-own).
sub g6_result_map_err_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_result_map_parts("map_err", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $kind {
                CgRes($want_ok, $f) {
                    if g6_ok_or_err_supported($want_ok) && g6_ok_or_err_supported($f) {
                        match $p.recv.kind {
                            CgRes($src_ok, $src_err) {
                                if cgkind_eq($want_ok, $src_ok) {
                                    match $p.lam {
                                        ELambda($params, $ret, $body, $topic) {
                                            match g7_lambda_body_expr($body) {
                                                Err($m) { Err($m) }
                                                Ok($expr) {
                                                    $tmp = g4_value_tmp($kind, $state.ntmp)
                                                    $binder = g4_value_tmp($src_err, $state.ntmp + 1)
                                                    match g7_lambda_env($params, $src_err, $binder, $env) {
                                                        Err($m) { Err($m) }
                                                        Ok($lenv) {
                                                            $err_start = CgState(
                                                                interns: $state.interns,
                                                                decls: $state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($src_err, $binder),
                                                                body: "",
                                                                nstr: $state.nstr,
                                                                ntmp: $state.ntmp + 2
                                                            )
                                                            match g4_lower_value($f, $expr, $err_start, $lenv) {
                                                                Err($m) { Err($m) }
                                                                Ok($fb) {
                                                                    Ok(CgValueOut(
                                                                        state: CgState(
                                                                            interns: $fb.state.interns,
                                                                            decls: $fb.state.decls,
                                                                            body: $state.body ~
                                                                                "\tif (" ~ $p.recv.cname ~ ".tag != 0) \{\n" ~
                                                                                "\t\t" ~ $binder ~ " = " ~ $p.recv.cname ~ ".err;\n" ~
                                                                                $fb.state.body ~
                                                                                "\t\t" ~ $tmp ~ ".tag = 1; " ~ $tmp ~ ".err = " ~ $fb.c ~ ";\n" ~
                                                                                "\t} else \{\n" ~
                                                                                "\t\t" ~ $tmp ~ ".tag = 0; " ~ $tmp ~ ".ok = " ~ $p.recv.cname ~ ".ok;\n" ~
                                                                                g6_result_map_ok_retain($want_ok, $tmp) ~
                                                                                "\t}\n",
                                                                            nstr: $fb.state.nstr,
                                                                            ntmp: $fb.state.ntmp
                                                                        ),
                                                                        c: $tmp
                                                                    ))
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g6_result_map_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_result_map_ok_value($kind, $callee, $args, $state, $env) {
        Ok($v) { Ok($v) }
        Err($not_map) { g6_result_map_err_value($kind, $callee, $args, $state, $env) }
    }
}

# §15.5 Result `and_then` / `or_else`: bound Result[T,E] locals OR call-produced
# Result temps through a single-expression inline lambda returning a Result
# carrier. and_then: Ok arm binds borrowed `.ok` and assigns the callback's
# whole Result; Err arm copies `.err` with retain-if-Str. or_else is the polarity
# swap (Err runs the callback; Ok copies the source + retain). Materialized call
# receivers are released after the if/else (native keeps them to frame end —
# behaviour-identical for sanitizers).
sub g6_result_and_then_kind_ok($src_err: CgKind, $rk: CgKind): Result[CgKind, Str] {
    match $rk {
        CgRes($u, $body_err) {
            if cgkind_eq($body_err, $src_err) && g6_ok_or_err_supported($u) && g6_ok_or_err_supported($body_err) {
                Ok($rk)
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_result_and_then_recv_kind($recv: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $recv {
        EName($n) {
            match g6_result_map_recv($recv, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok($v.kind) }
            }
        }
        _ {
            match g6_result_carrier_of($recv, $env) {
                Err($m) { Err($m) }
                Ok($rk) {
                    match $rk {
                        CgRes($ok, $err) {
                            if g6_ok_or_err_supported($ok) && g6_ok_or_err_supported($err) {
                                Ok($rk)
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g6_result_materialize_map_recv($recv: Expr, $state: CgState, $env: CgEnv): Result[MatCarrierRecv, Str] {
    match $recv {
        EName($n) {
            match g6_result_map_recv($recv, $env) {
                Err($m) { Err($m) }
                Ok($v) { Ok(MatCarrierRecv(v: $v, state: $state, owned_tmp: false)) }
            }
        }
        _ {
            match g6_result_and_then_recv_kind($recv, $env) {
                Err($m) { Err($m) }
                Ok($rk) {
                    match g6_result_value($rk, $recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cv) {
                            $qtmp = g4_value_tmp($rk, $cv.state.ntmp)
                            Ok(MatCarrierRecv(
                                v: CgVar(name: "", cname: $qtmp, kind: $rk, mutable: false, borrowed: false, listlen: 0),
                                state: CgState(
                                    interns: $cv.state.interns,
                                    decls: $cv.state.decls ~ g4_value_decl($rk, $qtmp),
                                    body: $cv.state.body ~ "\t" ~ $qtmp ~ " = " ~ $cv.c ~ ";\n",
                                    nstr: $cv.state.nstr,
                                    ntmp: $cv.state.ntmp + 1
                                ),
                                owned_tmp: true
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g6_result_and_then_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_carrier_lam_parts("and_then", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_result_and_then_recv_kind($p.recv, $env) {
                Err($m) { Err($m) }
                Ok($src_kind) {
                    match $src_kind {
                        CgRes($src_ok, $src_err) {
                            match $p.lam {
                                ELambda($params, $ret, $body, $topic) {
                                    match g7_lambda_body_expr($body) {
                                        Err($m) { Err($m) }
                                        Ok($expr) {
                                            match g7_lambda_env($params, $src_ok, "gres_and_then_probe", $env) {
                                                Err($m) { Err($m) }
                                                Ok($lenv) {
                                                    match g6_result_kind_from_value($expr, $lenv) {
                                                        Err($m) {
                                                            match g6_result_kind_from_type($ret, $lenv) {
                                                                Err($tm) { Err($tm) }
                                                                Ok($rk) { g6_result_and_then_kind_ok($src_err, $rk) }
                                                            }
                                                        }
                                                        Ok($rk) { g6_result_and_then_kind_ok($src_err, $rk) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g6_result_and_then_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_carrier_lam_parts("and_then", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $kind {
                CgRes($u, $want_err) {
                    if g6_ok_or_err_supported($u) && g6_ok_or_err_supported($want_err) {
                        match g6_result_materialize_map_recv($p.recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($mr) {
                                match $mr.v.kind {
                                    CgRes($src_ok, $src_err) {
                                        if cgkind_eq($want_err, $src_err) {
                                            match $p.lam {
                                                ELambda($params, $ret, $body, $topic) {
                                                    match g7_lambda_body_expr($body) {
                                                        Err($m) { Err($m) }
                                                        Ok($expr) {
                                                            $tmp = g4_value_tmp($kind, $mr.state.ntmp)
                                                            $binder = g4_value_tmp($src_ok, $mr.state.ntmp + 1)
                                                            match g7_lambda_env($params, $src_ok, $binder, $env) {
                                                                Err($m) { Err($m) }
                                                                Ok($lenv) {
                                                                    $ok_start = CgState(
                                                                        interns: $mr.state.interns,
                                                                        decls: $mr.state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($src_ok, $binder),
                                                                        body: "",
                                                                        nstr: $mr.state.nstr,
                                                                        ntmp: $mr.state.ntmp + 2
                                                                    )
                                                                    match g6_result_value($kind, $expr, $ok_start, $lenv) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($fb) {
                                                                            $release = if $mr.owned_tmp { g6_result_release($mr.v.kind, $mr.v.cname) } else { "" }
                                                                            Ok(CgValueOut(
                                                                                state: CgState(
                                                                                    interns: $fb.state.interns,
                                                                                    decls: $fb.state.decls,
                                                                                    body: $mr.state.body ~
                                                                                        "\tif (" ~ $mr.v.cname ~ ".tag == 0) \{\n" ~
                                                                                        "\t\t" ~ $binder ~ " = " ~ $mr.v.cname ~ ".ok;\n" ~
                                                                                        $fb.state.body ~
                                                                                        "\t\t" ~ $tmp ~ " = " ~ $fb.c ~ ";\n" ~
                                                                                        "\t} else \{\n" ~
                                                                                        "\t\t" ~ $tmp ~ ".tag = 1; " ~ $tmp ~ ".err = " ~ $mr.v.cname ~ ".err;\n" ~
                                                                                        g6_result_map_err_retain($want_err, $tmp) ~
                                                                                        "\t}\n" ~
                                                                                        $release,
                                                                                    nstr: $fb.state.nstr,
                                                                                    ntmp: $fb.state.ntmp
                                                                                ),
                                                                                c: $tmp
                                                                            ))
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                _ { Err(g3_unsupported()) }
                                            }
                                        } else {
                                            Err(g3_unsupported())
                                        }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# §15.5 Result `or_else`: the polarity swap of `and_then`. The Err arm binds the
# borrowed `.err` payload and assigns the callback's whole Result carrier into the
# fresh temp; the Ok arm keeps the SOURCE carrier by-value and retains its active
# slot (native re-lowers the source as a generic Result copy — a whole-struct copy
# plus `g6_result_retain`). Native/interp unify the callback's return type with the
# source, so the output kind == the source kind exactly (T AND E preserved).
sub g6_result_or_else_kind_ok($src_ok: CgKind, $src_err: CgKind, $rk: CgKind): Result[CgKind, Str] {
    match $rk {
        CgRes($body_ok, $body_err) {
            if cgkind_eq($body_ok, $src_ok) && cgkind_eq($body_err, $src_err) && g6_ok_or_err_supported($src_ok) && g6_ok_or_err_supported($src_err) {
                Ok($rk)
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_result_or_else_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g6_carrier_lam_parts("or_else", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_result_and_then_recv_kind($p.recv, $env) {
                Err($m) { Err($m) }
                Ok($src_kind) {
                    match $src_kind {
                        CgRes($src_ok, $src_err) {
                            match $p.lam {
                                ELambda($params, $ret, $body, $topic) {
                                    match g7_lambda_body_expr($body) {
                                        Err($m) { Err($m) }
                                        Ok($expr) {
                                            match g7_lambda_env($params, $src_err, "gres_or_else_probe", $env) {
                                                Err($m) { Err($m) }
                                                Ok($lenv) {
                                                    match g6_result_kind_from_value($expr, $lenv) {
                                                        Err($m) {
                                                            match g6_result_kind_from_type($ret, $lenv) {
                                                                Err($tm) { Err($tm) }
                                                                Ok($rk) { g6_result_or_else_kind_ok($src_ok, $src_err, $rk) }
                                                            }
                                                        }
                                                        Ok($rk) { g6_result_or_else_kind_ok($src_ok, $src_err, $rk) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g6_result_or_else_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_carrier_lam_parts("or_else", $callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $kind {
                CgRes($want_ok, $want_err) {
                    if g6_ok_or_err_supported($want_ok) && g6_ok_or_err_supported($want_err) {
                        match g6_result_materialize_map_recv($p.recv, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($mr) {
                                match $mr.v.kind {
                                    CgRes($src_ok, $src_err) {
                                        if cgkind_eq($want_ok, $src_ok) && cgkind_eq($want_err, $src_err) {
                                            match $p.lam {
                                                ELambda($params, $ret, $body, $topic) {
                                                    match g7_lambda_body_expr($body) {
                                                        Err($m) { Err($m) }
                                                        Ok($expr) {
                                                            $tmp = g4_value_tmp($kind, $mr.state.ntmp)
                                                            $binder = g4_value_tmp($src_err, $mr.state.ntmp + 1)
                                                            match g7_lambda_env($params, $src_err, $binder, $env) {
                                                                Err($m) { Err($m) }
                                                                Ok($lenv) {
                                                                    $err_start = CgState(
                                                                        interns: $mr.state.interns,
                                                                        decls: $mr.state.decls ~ g4_value_decl($kind, $tmp) ~ g4_value_decl($src_err, $binder),
                                                                        body: "",
                                                                        nstr: $mr.state.nstr,
                                                                        ntmp: $mr.state.ntmp + 2
                                                                    )
                                                                    match g6_result_value($kind, $expr, $err_start, $lenv) {
                                                                        Err($m) { Err($m) }
                                                                        Ok($fb) {
                                                                            $release = if $mr.owned_tmp { g6_result_release($mr.v.kind, $mr.v.cname) } else { "" }
                                                                            Ok(CgValueOut(
                                                                                state: CgState(
                                                                                    interns: $fb.state.interns,
                                                                                    decls: $fb.state.decls,
                                                                                    body: $mr.state.body ~
                                                                                        "\tif (" ~ $mr.v.cname ~ ".tag != 0) \{\n" ~
                                                                                        "\t\t" ~ $binder ~ " = " ~ $mr.v.cname ~ ".err;\n" ~
                                                                                        $fb.state.body ~
                                                                                        "\t\t" ~ $tmp ~ " = " ~ $fb.c ~ ";\n" ~
                                                                                        "\t} else \{\n" ~
                                                                                        "\t\t" ~ $tmp ~ " = " ~ $mr.v.cname ~ ";\n" ~
                                                                                        g6_result_retain($kind, $tmp) ~
                                                                                        "\t}\n" ~
                                                                                        $release,
                                                                                    nstr: $fb.state.nstr,
                                                                                    ntmp: $fb.state.ntmp
                                                                                ),
                                                                                c: $tmp
                                                                            ))
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                _ { Err(g3_unsupported()) }
                                            }
                                        } else {
                                            Err(g3_unsupported())
                                        }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# ---- G6b-b-2b-ii-b: Result carriers (`Result[T, E]`) ---------------------
# The native compiler lowers Result[T,E] to a tagged C struct:
# tag 0 = Ok(.ok), tag 1 = Err(.err). Scalar payloads are by-value; Str payloads
# own their active slot and must retain on copies and release on scope/match/
# reassign cleanup. Unlike Option, a Result cannot be constructed in an annotated
# LOCAL context in the native oracle (`Ok(7)` leaves E un-pinned); construction is
# only in a sub's annotated Result return context and branches of that return.
# Broader user-enum variants remain later widening.
sub g6_is_result_kind($kind: CgKind): Bool {
    match $kind {
        CgRes($ok, $err) { true }
        _ { false }
    }
}

sub g6_result_ok_kind($kind: CgKind): CgKind {
    match $kind {
        CgRes($ok, $err) { $ok }
        _ { CgInt }
    }
}

sub g6_result_err_kind($kind: CgKind): CgKind {
    match $kind {
        CgRes($ok, $err) { $err }
        _ { CgInt }
    }
}

sub g6_result_kindword($k: CgKind): Str {
    match $k {
        CgInt { "int" }
        CgFloat { "float" }
        CgBool { "bool" }
        CgStr { "str" }
        # Match is a counted `guji_match_t*` payload. Keep its own carrier word
        # (native: `guji_res_match_str`) rather than collapsing it to Str: the
        # pointer's recursive drop differs from a counted string buffer.
        CgMatch { "match" }
        CgBush { "bush" }
        CgHandle { "reader" }
        CgOptInt { "opt_int" }
        CgOptFloat { "opt_float" }
        CgOptBool { "opt_bool" }
        CgOptStr { "opt_str" }
        # User payloads key the carrier struct name by type name (e.g.
        # guji_res_TokenList_str or guji_res_Scan_str). Pascal names are unique, so
        # this stays distinct from the scalar keywords above.
        CgEnum($n) { $n }
        CgClass($n) { $n }
        CgOptClass($n) { "opt_" ~ $n }
        CgOptEnum($n) { "opt_" ~ $n }
        # A `List[T]` payload keys the carrier by the element-agnostic word `list`
        # (native's spelling: `guji_res_list_str`). The slot stores a by-value
        # `guji_slice_t`, whose element C type is tracked statically at the
        # comparison/build site, so two `Result[List[X], E]` with different X
        # share the one typedef — sound because the field type is element-agnostic.
        CgList($el) { "list" }
        # A `Map[Str, V]` payload keys the carrier by the value-agnostic word `map`
        # (native's spelling: `guji_res_map_str`). The slot stores a by-value
        # `guji_map_t`; V is tracked statically at the comparison/build site, so
        # two `Result[Map[Str, X], E]` with different X share one typedef.
        CgMap($v) { "map" }
        _ { "int" }
    }
}

sub g6_result_field_ctype($k: CgKind): Str {
    match $k {
        CgFloat { "double" }
        CgStr { "const char*" }
        CgMatch { "guji_match_t*" }
        CgBush { "guji_bush_t*" }
        CgHandle { "guji_reader_t*" }
        CgOptInt { g6_option_ctype(CgOptInt) }
        CgOptFloat { g6_option_ctype(CgOptFloat) }
        CgOptBool { g6_option_ctype(CgOptBool) }
        CgOptStr { g6_option_ctype(CgOptStr) }
        # User payloads are embedded by value as their own struct type.
        CgEnum($n) { $n }
        CgClass($n) { $n }
        CgOptClass($n) { g6_option_ctype(CgOptClass($n)) }
        CgOptEnum($n) { g6_option_ctype(CgOptEnum($n)) }
        # A List payload slot is a by-value `guji_slice_t` (native's shape).
        CgList($el) { "guji_slice_t" }
        # A Map payload slot is a by-value `guji_map_t` (native's shape).
        CgMap($v) { "guji_map_t" }
        _ { "int64_t" }
    }
}

sub g6_result_ctype($kind: CgKind): Str {
    match $kind {
        CgRes($ok, $err) {
            # Native hardcodes Result[Unit, Closed] as guji_res_unit_closed even
            # though both slots are int64_t (Unit's kindword here is still "int").
            if cgkind_eq($ok, CgUnit) && cgkind_eq($err, CgClosed) {
                "guji_res_unit_closed"
            } else {
                "guji_res_" ~ g6_result_kindword($ok) ~ "_" ~ g6_result_kindword($err)
            }
        }
        _ { "guji_res_int_int" }
    }
}

sub g6_result_one_typedef($ok: CgKind, $err: CgKind): Str {
    "typedef struct \{\n\tint64_t tag;\n\t" ~ g6_result_field_ctype($ok) ~ " ok;\n\t" ~ g6_result_field_ctype($err) ~ " err;\n} " ~ g6_result_ctype(CgRes($ok, $err)) ~ ";\n\n"
}

# Emit all scalar/Str (T,E) combinations unconditionally (mirrors g6_option_typedefs);
# unused typedefs are harmless in C and keep emission program-independent.
# Also emit Option[Result] recv wrappers (guji_opt_res_*) and Str-arm channel
# elem_drop hooks so Chan[Result[T,E]] for flat T/E needs no program walk.
sub g6_result_opt_one_typedef($ok: CgKind, $err: CgKind): Str {
    "typedef struct \{\n\tint64_t tag;\n\t" ~ g6_result_ctype(CgRes($ok, $err)) ~ " val;\n} guji_opt_res_" ~
    g6_result_kindword($ok) ~ "_" ~ g6_result_kindword($err) ~ ";\n\n"
}

sub g6_result_chan_drop_ok_body($ok: CgKind): Str {
    match $ok {
        CgStr { "\tif (v.tag == 0LL) \{ guji_release(v.ok); }\n" }
        CgMatch { "\tif (v.tag == 0LL) \{ guji_release(v.ok); }\n" }
        CgBush { "\tif (v.tag == 0LL) \{ guji_release((const void*)v.ok); }\n" }
        CgList($el) { "\tif (v.tag == 0LL) \{ guji_release((const void*)v.ok.data); }\n" }
        CgMap($v) { "\tif (v.tag == 0LL) \{ guji_release((const void*)v.ok.keys); guji_release(v.ok.vals); }\n" }
        _ { "" }
    }
}

sub g6_result_chan_drop_err_body($err: CgKind): Str {
    match $err {
        CgStr { "\tif (v.tag != 0LL) \{ guji_release(v.err); }\n" }
        CgMatch { "\tif (v.tag != 0LL) \{ guji_release(v.err); }\n" }
        CgBush { "\tif (v.tag != 0LL) \{ guji_release((const void*)v.err); }\n" }
        CgList($el) { "\tif (v.tag != 0LL) \{ guji_release((const void*)v.err.data); }\n" }
        CgMap($v) { "\tif (v.tag != 0LL) \{ guji_release((const void*)v.err.keys); guji_release(v.err.vals); }\n" }
        _ { "" }
    }
}

sub g6_result_chan_drop_one($ok: CgKind, $err: CgKind): Str {
    # Emit whenever either arm owns heap (Str / Match / Bush / List / Map).
    # Scalar+scalar Result channels keep NULL elem_drop.
    if !g6_result_slot_owns($ok) && !g6_result_slot_owns($err) {
        ""
    } else {
        $ct = g6_result_ctype(CgRes($ok, $err))
        $dn = "guji_chan_drop_res_" ~ g6_result_kindword($ok) ~ "_" ~ g6_result_kindword($err)
        "static void " ~ $dn ~ "(void* slot) \{\n\t" ~ $ct ~ " v = *(" ~ $ct ~ "*)slot;\n" ~
        g6_result_chan_drop_ok_body($ok) ~
        g6_result_chan_drop_err_body($err) ~
        "}\n\n"
    }
}

sub g6_result_one_pair_extras($ok: CgKind, $err: CgKind): Str {
    g6_result_opt_one_typedef($ok, $err) ~ g6_result_chan_drop_one($ok, $err)
}

sub g6_result_typedefs(): Str {
    g6_result_one_typedef(CgInt, CgInt) ~ g6_result_one_typedef(CgInt, CgFloat) ~ g6_result_one_typedef(CgInt, CgBool) ~
    g6_result_one_typedef(CgInt, CgStr) ~
    g6_result_one_typedef(CgFloat, CgInt) ~ g6_result_one_typedef(CgFloat, CgFloat) ~ g6_result_one_typedef(CgFloat, CgBool) ~
    g6_result_one_typedef(CgFloat, CgStr) ~
    g6_result_one_typedef(CgBool, CgInt) ~ g6_result_one_typedef(CgBool, CgFloat) ~ g6_result_one_typedef(CgBool, CgBool) ~
    g6_result_one_typedef(CgBool, CgStr) ~
    g6_result_one_typedef(CgStr, CgInt) ~ g6_result_one_typedef(CgStr, CgFloat) ~ g6_result_one_typedef(CgStr, CgBool) ~ g6_result_one_typedef(CgStr, CgStr) ~
    # §15.4 open/create return Result[Handle, Str]. The runtime helper and
    # guji_reader_t are program-independent, so emit this carrier with the
    # scalar matrix rather than relying on a signature-only collector.
    g6_result_one_typedef(CgHandle, CgStr) ~
    # §17.3 channel ops always yield Result[Unit, Closed]; emit unconditionally
    # so send/close discards never depend on a program-specific typedef walk.
    g6_result_one_typedef(CgUnit, CgClosed) ~
    # §17 nested Option/Result channel carriers (element-agnostic List/Map names;
    # Match/Bush pointer Ok arms). Emit with Str Err — the native gate shape —
    # so Chan[Result[List|Map|Match|Bush, Str]] needs no signature walk.
    g6_result_one_typedef(CgList(CgInt), CgStr) ~
    g6_result_one_typedef(CgMap(CgInt), CgStr) ~
    g6_result_one_typedef(CgMatch, CgStr) ~
    g6_result_one_typedef(CgBush, CgStr) ~
    # Option[Result] wrappers + Str-arm drops (after the guji_res_* they embed).
    g6_result_one_pair_extras(CgInt, CgInt) ~ g6_result_one_pair_extras(CgInt, CgFloat) ~ g6_result_one_pair_extras(CgInt, CgBool) ~
    g6_result_one_pair_extras(CgInt, CgStr) ~
    g6_result_one_pair_extras(CgFloat, CgInt) ~ g6_result_one_pair_extras(CgFloat, CgFloat) ~ g6_result_one_pair_extras(CgFloat, CgBool) ~
    g6_result_one_pair_extras(CgFloat, CgStr) ~
    g6_result_one_pair_extras(CgBool, CgInt) ~ g6_result_one_pair_extras(CgBool, CgFloat) ~ g6_result_one_pair_extras(CgBool, CgBool) ~
    g6_result_one_pair_extras(CgBool, CgStr) ~
    g6_result_one_pair_extras(CgStr, CgInt) ~ g6_result_one_pair_extras(CgStr, CgFloat) ~ g6_result_one_pair_extras(CgStr, CgBool) ~
    g6_result_one_pair_extras(CgStr, CgStr) ~
    g6_result_one_pair_extras(CgList(CgInt), CgStr) ~
    g6_result_one_pair_extras(CgMap(CgInt), CgStr) ~
    g6_result_one_pair_extras(CgMatch, CgStr) ~
    g6_result_one_pair_extras(CgBush, CgStr)
}

sub g6_result_payload_kind($tr: TypeRef, $env: CgEnv): Result[CgKind, Str] {
    if $tr.name == "Int" {
        Ok(CgInt)
    } else if $tr.name == "Float" {
        Ok(CgFloat)
    } else if $tr.name == "Bool" {
        Ok(CgBool)
    } else if $tr.name == "Str" {
        Ok(CgStr)
    } else if $tr.name == "Regex" {
        # §13 `Result[Regex, Str]` (Regex.compile): the Regex slot is the
        # validated pattern text — a counted Str — so the carrier reuses
        # guji_res_str_str (native names its typedef guji_res_regex_str but the
        # layout and ownership are identical).
        Ok(CgStr)
    } else if $tr.name == "Match" {
        # Result[Match, E] embeds the counted match graph pointer by value.
        # Unlike Regex (whose representation is a counted Str), Match needs its
        # own carrier identity so retain/release recurse through guji_drop_match.
        Ok(CgMatch)
    } else if $tr.name == "Bush" {
        # Result[Bush, E] embeds the counted parse-tree pointer by value —
        # mirror of Match (guji_bush_t* slot; retain/release via guji_drop_bush).
        Ok(CgBush)
    } else if $tr.name == "Unit" {
        # A Result carrier may carry `Unit` in a slot (the compiler's own
        # type-checker helpers return `Result[Unit, Str]`). Unit owns nothing and
        # lowers to an int64_t slot; via the `g6_result_kindword` wildcard the
        # carrier reuses the unconditional `guji_res_int_*` typedef. Slice 5
        # E5d-7c-2d-11.
        Ok(CgUnit)
    } else if $tr.name == "Handle" {
        Ok(CgHandle)
    } else if $tr.name == "Closed" {
        # §17.3 channel-error unit type — Err slot of Result[Unit, Closed].
        Ok(CgClosed)
    } else if $tr.name == "List" {
        # A `Result[List[T], E]` payload (P5b-2b-carrier-eq-collections). The ok
        # slot embeds a by-value `guji_slice_t`; native accepts this, so it is a
        # three-way carrier. Resolve the element kind via the shared list resolver.
        match g7_list_elem_kind_from_type(Some($tr)) {
            Ok($el) { Ok(CgList($el)) }
            Err($m) { Err($m) }
        }
    } else if $tr.name == "Map" {
        # A `Result[Map[Str, V], E]` payload (P9-7b result_map_ownership). The ok
        # slot embeds a by-value `guji_map_t`; native accepts flat Map[Str,
        # scalar|Str] (and nested List/Map values on later slices). Resolve V via
        # the shared map-value resolver — same path Option[Map] uses.
        match g7_map_val_kind_from_type(Some($tr)) {
            Ok($v) { Ok(CgMap($v)) }
            Err($m) { Err($m) }
        }
    } else if $tr.name == "Option" {
        g6_option_kind_from_type_env(Some($tr), $env)
    } else {
        # E5d-7c-2d/E5d-7c-2d-2: a Result carrier payload may also be a user
        # CLASS or ENUM. Native rejects these, so this is interp-oracle: the
        # carrier struct embeds the user struct by value, after that struct's
        # typedef has been emitted.
        match cg_env_lookup_enum($env, $tr.name) {
            Some($info) {
                if g6e_enum_fields_supported($info) { Ok(CgEnum($tr.name)) } else { Err(g3_unsupported()) }
            }
            None {
                match cg_env_lookup_class($env, $tr.name) {
                    Some($info) { Ok(CgClass($tr.name)) }
                    None { Err(g3_unsupported()) }
                }
            }
        }
    }
}

sub g6_result_zero($k: CgKind): Str {
    match $k {
        CgFloat { "0.0" }
        CgStr { "GUJI_EMPTY_STR" }
        CgMatch { "NULL" }
        CgBush { "NULL" }
        CgHandle { "NULL" }
        CgOptInt { "(" ~ g6_option_ctype(CgOptInt) ~ ")\{0LL, 0LL}" }
        CgOptFloat { "(" ~ g6_option_ctype(CgOptFloat) ~ ")\{0LL, 0.0}" }
        CgOptBool { "(" ~ g6_option_ctype(CgOptBool) ~ ")\{0LL, 0LL}" }
        CgOptStr { "(" ~ g6_option_ctype(CgOptStr) ~ ")\{0LL, GUJI_EMPTY_STR}" }
        # The inactive user slot of a Result carrier is a zeroed by-value struct.
        CgEnum($n) { "(" ~ $n ~ ")\{0}" }
        CgClass($n) { "(" ~ $n ~ ")\{0}" }
        CgOptClass($n) { "(" ~ g6_option_ctype(CgOptClass($n)) ~ ")\{0LL, (" ~ $n ~ ")\{0}}" }
        CgOptEnum($n) { "(" ~ g6_option_ctype(CgOptEnum($n)) ~ ")\{0LL, (" ~ $n ~ ")\{0}}" }
        # The inactive List slot is a zeroed by-value slice (native: `(guji_slice_t){0}`).
        CgList($el) { "(guji_slice_t)\{0}" }
        # The inactive Map slot is a zeroed by-value map (native: `(guji_map_t){0}`).
        CgMap($v) { "(guji_map_t)\{0}" }
        _ { "0LL" }
    }
}

# True iff a Result carrier OWNS a heap resource in either slot — a Str payload, or
# a user payload (whose own fields may own strings). Drives the borrowed-vs-owned
# decision for a whole-result bind and the result-argument copy path.
sub g6_result_has_str($kind: CgKind): Bool {
    match $kind {
        CgRes($ok, $err) { g6_result_slot_owns($ok) || g6_result_slot_owns($err) }
        _ { false }
    }
}

sub g6_result_slot_owns($k: CgKind): Bool {
    match $k {
        CgStr { true }
        CgMatch { true }
        CgBush { true }
        CgHandle { true }
        CgEnum($n) { true }
        CgClass($n) { true }
        CgOptStr { true }
        CgOptClass($n) { true }
        CgOptEnum($n) { true }
        # A List slot owns its heap element storage via `.data`.
        CgList($el) { true }
        # A Map slot owns its paired counted arrays via `.keys` + `.vals`.
        CgMap($v) { true }
        _ { false }
    }
}

sub g6_result_retain($kind: CgKind, $c: Str): Str {
    match $kind {
        CgRes($ok, $err) {
            g6_result_slot_retain($ok, $c, "ok", "== 0LL") ~ g6_result_slot_retain($err, $c, "err", "!= 0LL")
        }
        _ { "" }
    }
}

# Retain the active slot of a Result carrier on a by-value copy. A Str slot retains
# the pointer; a user struct slot retains its own owned fields.
sub g6_result_slot_retain($k: CgKind, $c: Str, $slot: Str, $cmp: Str): Str {
    match $k {
        CgStr { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain(" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgMatch { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain((const void*)" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgBush { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain((const void*)" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgHandle { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain((const void*)" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgEnum($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain_" ~ $n ~ "_fields(&" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgClass($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain_" ~ $n ~ "_fields(&" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgOptStr { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_retain(CgOptStr, $c ~ "." ~ $slot) ~ "\t}\n" }
        CgOptClass($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_retain(CgOptClass($n), $c ~ "." ~ $slot) ~ "\t}\n" }
        CgOptEnum($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_retain(CgOptEnum($n), $c ~ "." ~ $slot) ~ "\t}\n" }
        # A List slot retains its heap `.data` on a by-value copy (native's shape).
        CgList($el) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain((const void*)" ~ $c ~ "." ~ $slot ~ ".data); }\n" }
        # A Map slot retains BOTH counted arrays on a by-value copy (native's shape;
        # mirrors CgOptMap retain of `.val.keys`/`.val.vals`).
        CgMap($v) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_retain((const void*)" ~ $c ~ "." ~ $slot ~ ".keys); guji_retain((const void*)" ~ $c ~ "." ~ $slot ~ ".vals); }\n" }
        _ { "" }
    }
}

sub g6_result_release($kind: CgKind, $c: Str): Str {
    match $kind {
        CgRes($ok, $err) {
            g6_result_slot_release($ok, $c, "ok", "== 0LL") ~ g6_result_slot_release($err, $c, "err", "!= 0LL")
        }
        _ { "" }
    }
}

# Non-NULLing retain/release for a Result carrier's active Str slots. Channel
# send lowers a bound Result with g6_result_retain (+1), then deep-copies the
# active arm into the message; the sender must drop that +1 WITHOUT wiping a
# still-live local (mirrors g6_option_retain_or_release for Option[Str]).
sub g6_result_retain_or_release($kind: CgKind, $c: Str, $op: Str): Str {
    match $kind {
        CgRes($ok, $err) {
            g6_result_slot_retain_or_release($ok, $c, "ok", "== 0LL", $op) ~
            g6_result_slot_retain_or_release($err, $c, "err", "!= 0LL", $op)
        }
        _ { "" }
    }
}

sub g6_result_slot_retain_or_release($k: CgKind, $c: Str, $slot: Str, $cmp: Str, $op: Str): Str {
    match $k {
        CgStr { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "(" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgMatch { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgBush { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgEnum($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "_" ~ $n ~ "_fields(&" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgClass($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "_" ~ $n ~ "_fields(&" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgOptStr { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_retain_or_release(CgOptStr, $c ~ "." ~ $slot, $op) ~ "\t}\n" }
        CgOptClass($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_retain_or_release(CgOptClass($n), $c ~ "." ~ $slot, $op) ~ "\t}\n" }
        CgOptEnum($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_retain_or_release(CgOptEnum($n), $c ~ "." ~ $slot, $op) ~ "\t}\n" }
        # List/Map Ok slots: non-NULLing retain/release of the counted storage so
        # channel send can drop the sender's +1 without wiping a still-live local.
        CgList($el) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ "." ~ $slot ~ ".data); }\n" }
        CgMap($v) {
            "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_" ~ $op ~ "((const void*)" ~ $c ~ "." ~ $slot ~ ".keys); guji_" ~ $op ~ "((const void*)" ~ $c ~ "." ~ $slot ~ ".vals); }\n"
        }
        _ { "" }
    }
}

# Release the active slot of a Result carrier at scope/match/reassign cleanup. A Str
# slot releases the pointer and NULLs it; a user struct slot releases its own owned
# fields — the struct itself is by-value so there is no pointer to NULL.
sub g6_result_slot_release($k: CgKind, $c: Str, $slot: Str, $cmp: Str): Str {
    match $k {
        CgStr { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release(" ~ $c ~ "." ~ $slot ~ "); " ~ $c ~ "." ~ $slot ~ " = NULL; }\n" }
        CgMatch { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $c ~ "." ~ $slot ~ "); " ~ $c ~ "." ~ $slot ~ " = NULL; }\n" }
        CgBush { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $c ~ "." ~ $slot ~ "); " ~ $c ~ "." ~ $slot ~ " = NULL; }\n" }
        CgHandle { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $c ~ "." ~ $slot ~ "); " ~ $c ~ "." ~ $slot ~ " = NULL; }\n" }
        CgEnum($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release_" ~ $n ~ "_fields(&" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgClass($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release_" ~ $n ~ "_fields(&" ~ $c ~ "." ~ $slot ~ "); }\n" }
        CgOptStr { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_release(CgOptStr, $c ~ "." ~ $slot) ~ "\t}\n" }
        CgOptClass($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_release(CgOptClass($n), $c ~ "." ~ $slot) ~ "\t}\n" }
        CgOptEnum($n) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{\n" ~ g6_option_release(CgOptEnum($n), $c ~ "." ~ $slot) ~ "\t}\n" }
        # A List slot releases its heap `.data` and nulls the slice (mirrors the
        # CgOptList release: null + zero len so a double-release is impossible).
        CgList($el) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $c ~ "." ~ $slot ~ ".data); " ~ $c ~ "." ~ $slot ~ ".data = NULL; " ~ $c ~ "." ~ $slot ~ ".len = 0; }\n" }
        # A Map slot releases BOTH counted arrays and nulls the map (mirrors the
        # CgOptMap release: null keys/vals + zero len so a double-release is impossible).
        CgMap($v) { "\tif (" ~ $c ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $c ~ "." ~ $slot ~ ".keys); guji_release((const void*)" ~ $c ~ "." ~ $slot ~ ".vals); " ~ $c ~ "." ~ $slot ~ ".keys = NULL; " ~ $c ~ "." ~ $slot ~ ".vals = NULL; " ~ $c ~ "." ~ $slot ~ ".len = 0; }\n" }
        _ { "" }
    }
}

sub g6_result_kind_from_type($ty: Option[TypeRef], $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Result" {
                match typelist_at($tr.args, 0) {
                    None { Err(g3_unsupported()) }
                    Some($okt) {
                        match typelist_at($tr.args, 1) {
                            None { Err(g3_unsupported()) }
                            Some($errt) {
                                match g6_result_payload_kind($okt, $env) {
                                    Err($m) { Err($m) }
                                    Ok($ok) {
                                        match g6_result_payload_kind($errt, $env) {
                                            Err($m) { Err($m) }
                                            Ok($er) { Ok(CgRes($ok, $er)) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# Infer the Result carrier kind of a value expression for unannotated local
# bindings. This is the Result analogue of the enum/class RHS-kind inference used
# by E5d-8t/E5d-8u: value lowering already supports `if`/`match` once the carrier
# is known, but a fresh `$x = if ... { Ok(..) } else { Err(..) }` binding has no
# TypeRef to supply that carrier.
sub g6_result_kind_from_block($stmts: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match g6e_block_final_expr($stmts) {
        None { Err(g3_unsupported()) }
        Some($e) { g6_result_kind_from_value($e, $env) }
    }
}

sub g6_result_kind_from_if_tail($elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) { g6_result_kind_from_block($body, $env) }
            }
        }
        ElifCons($head, $tail) {
            match g6_result_kind_from_block($head.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g6_result_kind_from_if_tail($tail, $els, $env) }
            }
        }
    }
}

sub g6_result_kind_from_if($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match g6_result_kind_from_block($then, $env) {
        Ok($k) { Ok($k) }
        Err($m) { g6_result_kind_from_if_tail($elifs, $els, $env) }
    }
}

sub g6_result_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) { if g6_is_result_kind($v.kind) { Ok($v.kind) } else { Err(g3_unsupported()) } }
            }
        }
        # Option->Result `ok_or` conversion tried FIRST, matching g6_result_value's
        # try-order (g6_ok_or_value before the general call fallback); the conv sub
        # defers to a user `sub ok_or` shadow for the function form.
        ECall($callee, $args) {
            match g11_chan_op_result_kind($callee, $args, $env) {
                Ok($k) { Ok($k) }
                Err($not_chan) {
                    match g6_conv_ok_or_kind_from_call($callee, $args, $env) {
                        Ok($k) { Ok($k) }
                        Err($m) { g6_result_carrier_of($value, $env) }
                    }
                }
            }
        }
        EIf($cond, $then, $elifs, $els) { g6_result_kind_from_if($then, $elifs, $els, $env) }
        EMatch($subj, $arms) { g6_result_kind_from_arms($arms, $env) }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_result_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g6e_block_final_expr($arm.body) {
                None { g6_result_kind_from_arms($rest, $env) }
                Some($e) {
                    match g6_result_kind_from_value($e, $env) {
                        Ok($k) { Ok($k) }
                        Err($m) { g6_result_kind_from_arms($rest, $env) }
                    }
                }
            }
        }
    }
}

# A Result constructor owns its active pointer payload independently of the
# source expression. `g6_match_value` deliberately returns a borrowed Match
# alias, so either `Ok($m)` or `Err($m)` must take +1 before an enclosing
# Option[Match] scrutinee or bare Match binding is released. Scalar/Str/List/Map
# construction already returns owned values from their lowerers.
sub g6_result_construct_payload_retain($kind: CgKind, $c: Str): Str {
    match $kind {
        CgMatch { "\tguji_retain((const void*)" ~ $c ~ ");\n" }
        _ { "" }
    }
}

# Infer the Option carrier kind of a value expression for UNANNOTATED local
# bindings (`$o = wrap(21)`), the Option analogue of g6_result_kind_from_value.
# An Option-typed name, an Option-returning call (user sub, monomorphized generic
# spec via g5_resolve_call_target's g5g fallback, or the find() builtin — all
# through g5_question_option_carrier_of), or an if/match whose first inferable
# branch yields one. A bare `None` branch never infers a kind on its own — native
# REJECTS it at build ("cannot infer the Option/Result type for None"), so the
# sibling-branch try-order below matches the accepted-program space exactly.
sub g6_option_kind_from_block($stmts: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match g6e_block_final_expr($stmts) {
        None { Err(g3_unsupported()) }
        Some($e) { g6_option_kind_from_value($e, $env) }
    }
}

sub g6_option_kind_from_if_tail($elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) { g6_option_kind_from_block($body, $env) }
            }
        }
        ElifCons($head, $tail) {
            match g6_option_kind_from_block($head.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g6_option_kind_from_if_tail($tail, $els, $env) }
            }
        }
    }
}

sub g6_option_kind_from_if($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match g6_option_kind_from_block($then, $env) {
        Ok($k) { Ok($k) }
        Err($m) { g6_option_kind_from_if_tail($elifs, $els, $env) }
    }
}

sub g6_option_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g6e_block_final_expr($arm.body) {
                None { g6_option_kind_from_arms($rest, $env) }
                Some($e) {
                    match g6_option_kind_from_value($e, $env) {
                        Ok($k) { Ok($k) }
                        Err($m) { g6_option_kind_from_arms($rest, $env) }
                    }
                }
            }
        }
    }
}

sub g6_option_unwrap_carrier_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g4_option_unwrap_fresh_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match g6_option_kind_from_value($p.recv, $env) {
                Err($m) { Err($m) }
                Ok($outer) {
                    match $outer {
                        CgOptCarrier($inner) { Ok($inner) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g6_option_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $value {
        EBinary($op, $left, $right) {
            # `~~` ALWAYS yields Option[Match] (§13) — for a literal RHS and for
            # a first-class Regex VALUE alike (the typechecker has already
            # verified the RHS is a Regex); an unloweraable RHS still declines
            # at the lowering site.
            if $op == "~~" {
                Ok(CgOptMatch)
            } else {
                Err(g3_unsupported())
            }
        }
        EIf($cond, $then, $elifs, $els) { g6_option_kind_from_if($then, $elifs, $els, $env) }
        EMatch($subj, $arms) { g6_option_kind_from_arms($arms, $env) }
        # Result->Option conversion (`$r.ok()` / `err($r)`) tried FIRST, matching the
        # lowering's try-order in g4_lower_value's Option ECall fallback (prelude wins
        # for the method form; the conv sub itself defers to a user-sub shadow for the
        # function form before this falls through to the general resolver).
        ECall($callee, $args) {
            match g6_option_unwrap_carrier_kind($callee, $args, $env) {
                Ok($inner) { Ok($inner) }
                Err($not_outer_unwrap) {
            match g11_chan_op_option_kind($callee, $args, $env) {
                Ok($k) { Ok($k) }
                Err($not_chan) {
            match g10_grammar_parse_parts($callee, $args, $env) {
                Ok($p) { Ok(CgOptBush) }
                Err($mgp) {
            match g6_conv_option_kind_from_call($callee, $args, $env) {
                Ok($k) { Ok($k) }
                Err($m) {
                    # List `get` inference tried next: `$got = @xs.get(1)` has no
                    # annotation, so recover its Option kind from the receiver's
                    # element kind (the find twin). Distinct method name, so order
                    # vs map/filter/find is immaterial — only `get` matches here.
                    match g6_get_option_kind($callee, $args, $env) {
                        Ok($gk) { Ok($gk) }
                        Err($mgk) {
                    # Option map/and_then/filter tried next, mirroring
                    # g6_option_value's prelude-first try-order (map before
                    # and_then before filter before the general call resolver);
                    # parts matchers defer to a user-sub shadow for the function
                    # form, so previously accepted programs resolve the same.
                    match g6_option_map_kind($callee, $args, $env) {
                        Ok($mk) { Ok($mk) }
                        Err($mm) {
                            match g6_option_and_then_kind($callee, $args, $env) {
                                Ok($atk) { Ok($atk) }
                                Err($mat) {
                                    match g6_option_filter_kind($callee, $args, $env) {
                                        Ok($fk) { Ok($fk) }
                                        Err($mf) { g5_question_option_carrier_of($value, $env) }
                                    }
                                }
                            }
                        }
                    }
                        }
                    }
                }
            }
                }
            }
                }
            }
                }
            }
        }
        EIndex($obj, $idx) {
            match $obj {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        Some($v) {
                            match $v.kind {
                                CgMatch { Ok(CgOptStr) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        None { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        ECapture($obj, $name) {
            match $obj {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        Some($v) {
                            match $v.kind {
                                CgMatch { Ok(CgOptStr) }
                                CgBush { Ok(CgOptBush) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        None { Err(g3_unsupported()) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { g5_question_option_carrier_of($value, $env) }
    }
}

# If `$subject` is a Result-typed name or a Result-returning user-sub call, return its
# carrier kind so g6_lower_scrutinee can lower+materialise it. Anything else is not a
# Result scrutinee.
sub g6_result_carrier_of($subject: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $subject {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) { if g6_is_result_kind($v.kind) { Ok($v.kind) } else { Err(g3_unsupported()) } }
            }
        }
        ECall($callee, $args) {
            match g6_result_map_kind($callee, $args, $env) {
                Ok($rk) { Ok($rk) }
                Err($not_result_map) {
                    match g6_result_and_then_kind($callee, $args, $env) {
                        Ok($rk) { Ok($rk) }
                        Err($not_result_and_then) {
                            match g6_result_or_else_kind($callee, $args, $env) {
                        Ok($rk2) { Ok($rk2) }
                        Err($not_result_or_else) {
                            match g6_regex_compile_args($callee, $args, $env) {
                                Ok($pat) { Ok(CgRes(CgStr, CgStr)) }
                                Err($not_regex_compile) {
                            match g5_parse_int_arg($callee, $args, $env) {
                                Ok($src) { Ok(CgRes(CgInt, CgStr)) }
                                Err($not_parse_int) {
                                    match g5_read_file_arg($callee, $args) {
                                        Ok($path) { Ok(CgRes(CgStr, CgStr)) }
                                        Err($not_read_file) {
                                            match g5_handle_open_args($callee, $args, $env) {
                                                Ok($ha) { Ok(CgRes(CgHandle, CgStr)) }
                                                Err($not_handle_open) {
                                            match g5_write_file_args($callee, $args, $env) {
                                                Ok($wf) { Ok(CgRes(CgUnit, CgStr)) }
                                                Err($not_write_file) {
                                                    match g5_run_args($callee, $args, $env) {
                                                        Ok($ra) { Ok(CgRes(CgClass("Proc"), CgStr)) }
                                                        Err($not_run) {
                                                            match g5_resolve_call_target($callee, $args, $env) {
                                                                Err($m) { Err($m) }
                                                                Ok($t) { match $t.sig.ret { RRes($k) { Ok($k) } _ { Err(g3_unsupported()) } } }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower a Result value of carrier kind `$kind`. `Ok(x)`/`Err(x)` build a struct
# literal with the payload lowered under its field kind (the unused slot is
# zeroed). An existing Result name is copied, retaining any active Str slot. A
# user-sub call routes through g5_call_value(RRes). `if`/`match` carrying a Result
# reuse the generic value lowerers.
sub g6_result_value($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    if cgkind_eq($v.kind, $kind) {
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $state.interns,
                                decls: $state.decls,
                                body: $state.body ~ g6_result_retain($kind, $v.cname),
                                nstr: $state.nstr,
                                ntmp: $state.ntmp
                            ),
                            c: $v.cname
                        ))
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
        ECall($callee, $args) {
            match $callee {
                ETypeName($n) {
                    if $n == "Ok" {
                        match g6_option_one_arg($args) {
                            Err($m) { Err($m) }
                            Ok($arg) {
                                match g4_lower_value(g6_result_ok_kind($kind), $arg, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($pv) {
                                        match cg_reg_builtin_variant(cg_reg_result().variants, "Ok") {
                                            Err($m) { Err($m) }
                                            Ok($vm) {
                                                Ok(CgValueOut(
                                                    state: CgState(
                                                        interns: $pv.state.interns,
                                                        decls: $pv.state.decls,
                                                        body: $pv.state.body ~ g6_result_construct_payload_retain(g6_result_ok_kind($kind), $pv.c),
                                                        nstr: $pv.state.nstr,
                                                        ntmp: $pv.state.ntmp
                                                    ),
                                                    c: "(" ~ g6_result_ctype($kind) ~ ")\{" ~ c_int($vm.tag) ~ "LL, " ~ $pv.c ~ ", " ~ g6_result_zero(g6_result_err_kind($kind)) ~ "}"
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else if $n == "Err" {
                        match g6_option_one_arg($args) {
                            Err($m) { Err($m) }
                            Ok($arg) {
                                match g4_lower_value(g6_result_err_kind($kind), $arg, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($pv) {
                                        match cg_reg_builtin_variant(cg_reg_result().variants, "Err") {
                                            Err($m) { Err($m) }
                                            Ok($vm) {
                                                Ok(CgValueOut(
                                                    state: CgState(
                                                        interns: $pv.state.interns,
                                                        decls: $pv.state.decls,
                                                        body: $pv.state.body ~ g6_result_construct_payload_retain(g6_result_err_kind($kind), $pv.c),
                                                        nstr: $pv.state.nstr,
                                                        ntmp: $pv.state.ntmp
                                                    ),
                                                    c: "(" ~ g6_result_ctype($kind) ~ ")\{" ~ c_int($vm.tag) ~ "LL, " ~ g6_result_zero(g6_result_ok_kind($kind)) ~ ", " ~ $pv.c ~ "}"
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ {
                    match g4_option_unwrap_fresh_carrier($kind, $callee, $args, $state, $env) {
                        Ok($unwrapped) { Ok($unwrapped) }
                        Err($not_outer_unwrap) {
                    match g11_chan_op_value($kind, $callee, $args, $state, $env) {
                        Ok($cv) { Ok($cv) }
                        Err($not_chan) {
                    match g6_result_map_value($kind, $callee, $args, $state, $env) {
                        Ok($rmv) { Ok($rmv) }
                        Err($not_result_map) {
                            match g6_result_and_then_value($kind, $callee, $args, $state, $env) {
                                Ok($atv) { Ok($atv) }
                                Err($not_result_and_then) {
                                    match g6_result_or_else_value($kind, $callee, $args, $state, $env) {
                                Ok($oev) { Ok($oev) }
                                Err($not_result_or_else) {
                                    match g6_ok_or_value($kind, $callee, $args, $state, $env) {
                                        Ok($okorv) { Ok($okorv) }
                                        Err($not_ok_or) {
                                            if cgkind_eq($kind, CgRes(CgStr, CgStr)) {
                                                match g6_regex_compile_value($callee, $args, $state, $env) {
                                                    Ok($v) { Ok($v) }
                                                    Err($not_regex_compile) {
                                                match g5_lower_read_file_value($callee, $args, $state, $env) {
                                                    Ok($v) { Ok($v) }
                                                    Err($not_read_file) { g5_call_value(RRes($kind), $callee, $args, $state, $env) }
                                                }
                                                    }
                                                }
                                            } else if cgkind_eq($kind, CgRes(CgInt, CgStr)) {
                                                match g5_lower_parse_int_value($callee, $args, $state, $env) {
                                                    Ok($v) { Ok($v) }
                                                    Err($not_parse_int) { g5_call_value(RRes($kind), $callee, $args, $state, $env) }
                                                }
                                            } else if cgkind_eq($kind, CgRes(CgHandle, CgStr)) {
                                                match g5_lower_handle_open_value($callee, $args, $state, $env) {
                                                    Ok($v) { Ok($v) }
                                                    Err($not_handle_open) { g5_call_value(RRes($kind), $callee, $args, $state, $env) }
                                                }
                                            } else if cgkind_eq($kind, CgRes(CgUnit, CgStr)) {
                                                match g5_lower_write_file_value($callee, $args, $state, $env) {
                                                    Ok($v) { Ok($v) }
                                                    Err($not_write_file) { g5_call_value(RRes($kind), $callee, $args, $state, $env) }
                                                }
                                            } else if cgkind_eq($kind, CgRes(CgClass("Proc"), CgStr)) {
                                                match g5_lower_run_value($callee, $args, $state, $env) {
                                                    Ok($v) { Ok($v) }
                                                    Err($not_run) { g5_call_value(RRes($kind), $callee, $args, $state, $env) }
                                                }
                                            } else {
                                                g5_call_value(RRes($kind), $callee, $args, $state, $env)
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                        }
                        }
                    }
                        }
                    }
                }
            }
        }
        }
        EIf($cond, $then, $elifs, $els) { g4_lower_if_value($kind, $cond, $then, $elifs, $els, $state, $env) }
        EMatch($subj, $arms) { g6_lower_match($kind, $subj, $arms, $state, $env) }
        EField($obj, $name) { g8_lower_field_value($kind, $obj, $name, $state, $env) }
        _ { Err(g3_unsupported()) }
    }
}

# ---- G6b-b-2b-ii-b-3-iii/v: user-enum value + match lowering ----------------
# A user enum lowers to a native-shaped `struct <Name> { int64_t tag; f0... }`.
# Construction of a fieldless variant `<Variant>` (parsed as `ETypeName`) or a
# scalar-field variant `Variant(args...)` (parsed as `ECall(ETypeName, args)`) is
# a by-value struct literal. A by-value copy of an existing enum local `$v`
# (parsed as `EName`) is just that local's C name. Str fields are owned and use
# generated per-enum retain/release helpers, including when Str shares a mixed
# union slot with scalar variants.
sub g6_is_enum_kind($kind: CgKind): Bool {
    match $kind {
        CgEnum($n) { true }
        _ { false }
    }
}

# Resolve an annotated binding/param type to a CgEnum kind iff its name is a
# known user enum. Used by g4_lower_fresh_bind to lower `$c: Color = Green`.
sub g6e_enum_kind_from_type($ty: Option[TypeRef], $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            match g8_generic_enum_name_from_type($tr) {
                Some($specn) {
                    match cg_env_lookup_enum($env, $specn) {
                        Some($info) { Ok(CgEnum($specn)) }
                        None { Err(g3_unsupported()) }
                    }
                }
                None {
                    match cg_env_lookup_enum($env, $tr.name) {
                        Some($info) { Ok(CgEnum($tr.name)) }
                        None { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# Find the user enum that owns a constructor variant. This uses the same
# registry-shaped metadata bridge that constructor and PVariant lowering use, so
# inferred enum bindings cannot drift from the generic variant path.
# P9-10b-3b-2b: the lexicographically FIRST collected concrete generic spec
# `<template>__*` registered in $env, or None when no spec of that template was
# collected. Mirrors native concreteEnumKeyForReceiver (sort.Strings + first):
# a generic enum's BARE nullary variant (`Empty`) has no payload arguments to
# monomorphize from, so codegen selects an already-collected concrete spec.
sub g6e_first_enum_spec($env: CgEnv, $template: Str, $best: Option[Str]): Option[Str] {
    match $env {
        CgEnvNil { $best }
        CgEnvCons($h, $t) { g6e_first_enum_spec($t, $template, $best) }
        CgEnvSub($s, $t) { g6e_first_enum_spec($t, $template, $best) }
        CgEnvClass($c, $t) { g6e_first_enum_spec($t, $template, $best) }
        CgEnvSubIdx($i, $t) { g6e_first_enum_spec($t, $template, $best) }
        CgEnvEnum($info, $t) {
            if starts_with($info.name, $template ~ "__") {
                match $best {
                    None { g6e_first_enum_spec($t, $template, Some($info.name)) }
                    Some($b) {
                        if $info.name < $b { g6e_first_enum_spec($t, $template, Some($info.name)) } else { g6e_first_enum_spec($t, $template, $best) }
                    }
                }
            } else {
                g6e_first_enum_spec($t, $template, $best)
            }
        }
    }
}

# Resolve the registered enum owning variant $vname. $full is the whole env:
# when the first owner is a generic TEMPLATE (`Box` in `Box[T]`), its name is
# redirected to the first collected concrete spec (`Box__Int`) so a bare
# nullary variant lowers against a struct that actually exists; with no
# collected spec the template name is kept (native declines that shape).
sub g6e_enum_name_from_variant($env: CgEnv, $full: CgEnv, $vname: Str): Result[Str, Str] {
    match $env {
        CgEnvNil { Err(g3_unsupported()) }
        CgEnvCons($h, $t) { g6e_enum_name_from_variant($t, $full, $vname) }
        CgEnvSub($s, $t) { g6e_enum_name_from_variant($t, $full, $vname) }
        CgEnvEnum($info, $t) {
            $meta = cg_reg_meta_from_info($info)
            match cg_reg_lookup_variant($meta.variants, $vname) {
                Some($vm) {
                    match g6e_first_enum_spec($full, $info.name, None) {
                        Some($spec) { Ok($spec) }
                        None { Ok($info.name) }
                    }
                }
                None { g6e_enum_name_from_variant($t, $full, $vname) }
            }
        }
        CgEnvClass($c, $t) { g6e_enum_name_from_variant($t, $full, $vname) }
        CgEnvSubIdx($i, $t) { g6e_enum_name_from_variant($t, $full, $vname) }
    }
}

# Whether any enum registered in $env owns a variant named $vname. Used below to
# detect the multi-owner ambiguity concrete generic enum SPECS introduce
# (Box__Int and Box__Str both own `Wrap`) without perturbing the single-owner
# resolution above.
sub g6e_enum_variant_owned($env: CgEnv, $vname: Str): Bool {
    match $env {
        CgEnvNil { false }
        CgEnvCons($h, $t) { g6e_enum_variant_owned($t, $vname) }
        CgEnvSub($s, $t) { g6e_enum_variant_owned($t, $vname) }
        CgEnvClass($c, $t) { g6e_enum_variant_owned($t, $vname) }
        CgEnvSubIdx($i, $t) { g6e_enum_variant_owned($t, $vname) }
        CgEnvEnum($info, $t) {
            $meta = cg_reg_meta_from_info($info)
            match cg_reg_lookup_variant($meta.variants, $vname) {
                Some($vm) { true }
                None { g6e_enum_variant_owned($t, $vname) }
            }
        }
    }
}

# Whether a candidate variant's registered field kinds all match the constructor
# argument kinds (per g5_kind_from_expr). Any unresolvable field (FtParam) or
# argument kind fails the candidate — the caller then tries later owners.
# The kind of a constructor argument for variant-spec disambiguation. Extends
# g5_kind_from_expr past scalars/locals/calls to ENUM and CLASS constructor
# VALUES (`Red(9)` -> CgEnum("Color"), `Point(...)` -> CgClass("Point")), which
# g5_kind_from_expr leaves as None (g5_resolve_call_target has no ETypeName arm).
# Needed so a generic enum with a fixed enum/class payload monomorphized at
# several types (`Pair__Int` / `Pair__Str`, both owning `Both`) disambiguates
# `Both(7, Red(1))` -> Pair__Int by matching the enum field kind. Self-compile-
# neutral: single-owner variant names short-circuit on the !owned fallback below,
# so the arg kind only affects multi-owner generic specs.
sub g6e_arg_kind($a: Expr, $env: CgEnv): Option[CgKind] {
    match g5_kind_from_expr($a, $env) {
        Some($k) { Some($k) }
        None {
            match $a {
                # P5b-2h: scalar OPERATOR arguments (`Push("x" ~ "1", ..)`) infer
                # through the same §5.1-5.2 result-kind table generic-sub call
                # args use — g5_kind_from_expr is deliberately scalar/call-only,
                # and only multi-owner variants reach this dispatcher.
                EBinary($op, $l, $r) { g5g_binop_kind($op, $l, $r, $env) }
                EUnary($op, $x) { g5g_unary_kind($op, $x, $env) }
                _ {
                    match g6e_enum_kind_from_value($a, $env) {
                        Ok($k) { Some($k) }
                        Err($m) {
                            match g8_class_kind_from_value($a, $env) {
                                Ok($k) { Some($k) }
                                Err($m2) { None }
                            }
                        }
                    }
                }
            }
        }
    }
}

# P5b-2h: a nested VARIANT argument in a multi-owner disambiguation matches an
# enum(-boxed) payload slot by CONSTRUCTOR CONTEXT: the slot's enum must own the
# argument's variant (fieldless `Nil`, or `Push(..)` whose own args recursively
# match that variant's slots). Independent resolution of the nested variant is
# wrong here — a fieldless `Nil` alone is owned by EVERY spec of a recursive
# generic template (Stack__Int AND Stack__Str), and its independently-inferred
# kind is never the BOXED payload kind, so the kind-equality path below can
# neither pick nor verify the owner. Mirrors native, where the enclosing slot's
# monomorphized type pins the nested constructor.
sub g6e_ctx_enum_arg_matches($en: Str, $a: Expr, $env: CgEnv): Bool {
    match $a {
        ETypeName($vn) { g6e_ctx_enum_owns($en, $vn, ExprNil, $env) }
        ECall($callee, $cargs) {
            match $callee {
                ETypeName($vn) { g6e_ctx_enum_owns($en, $vn, $cargs, $env) }
                _ { false }
            }
        }
        _ { false }
    }
}

sub g6e_ctx_enum_owns($en: Str, $vn: Str, $cargs: ExprList, $env: CgEnv): Bool {
    match cg_env_lookup_enum($env, $en) {
        None { false }
        Some($info) {
            $meta = cg_reg_meta_from_info($info)
            match cg_reg_lookup_variant($meta.variants, $vn) {
                None { false }
                Some($vm) { g6e_variant_fields_match_args($vm.fields, $cargs, $env) }
            }
        }
    }
}

sub g6e_ctx_field_enum_matches($fk: CgKind, $a: Expr, $env: CgEnv): Bool {
    match $fk {
        CgEnum($en) { g6e_ctx_enum_arg_matches($en, $a, $env) }
        CgBoxEnum($en) { g6e_ctx_enum_arg_matches($en, $a, $env) }
        _ { false }
    }
}

sub g6e_variant_fields_match_args($fields: CgFieldTyList, $args: ExprList, $env: CgEnv): Bool {
    match $fields {
        FtNil { match $args { ExprNil { true } _ { false } } }
        FtCons($ft, $frest) {
            match $args {
                ExprNil { false }
                ExprCons($a, $arest) {
                    match cg_reg_ft_kind($ft) {
                        Err($m) { false }
                        Ok($fk) {
                            if g6e_ctx_field_enum_matches($fk, $a, $env) {
                                g6e_variant_fields_match_args($frest, $arest, $env)
                            } else {
                            match g6e_arg_kind($a, $env) {
                                # P5b-2f: a LIST payload slot also matches an inline
                                # list-literal argument (`Items([1.5, 2.5])`) via its
                                # first element's kind — only multi-owner variants
                                # reach this (single owners short-circuit above).
                                None { g8_list_lit_kind_matches($fk, $a, $env) && g6e_variant_fields_match_args($frest, $arest, $env) }
                                Some($ak) { cgkind_eq($fk, $ak) && g6e_variant_fields_match_args($frest, $arest, $env) }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Argument-aware twin of g6e_enum_name_from_variant for CONSTRUCTOR calls: when
# only one registered enum owns $vname the resolution is byte-identical to the
# plain helper (first owner wins, matching or not — the typechecker already
# accepted the program). When several own it — concrete generic enum specs —
# pick the first whose field kinds match the argument kinds, so `Wrap(42)`
# resolves Box__Int while `Wrap("guji")` resolves Box__Str. $full is the whole
# env (argument kind lookups need it while $env recurses toward the tail).
sub g6e_enum_name_from_variant_args($env: CgEnv, $full: CgEnv, $vname: Str, $args: ExprList): Result[Str, Str] {
    match $env {
        CgEnvNil { Err(g3_unsupported()) }
        CgEnvCons($h, $t) { g6e_enum_name_from_variant_args($t, $full, $vname, $args) }
        CgEnvSub($s, $t) { g6e_enum_name_from_variant_args($t, $full, $vname, $args) }
        CgEnvClass($c, $t) { g6e_enum_name_from_variant_args($t, $full, $vname, $args) }
        CgEnvSubIdx($i, $t) { g6e_enum_name_from_variant_args($t, $full, $vname, $args) }
        CgEnvEnum($info, $t) {
            $meta = cg_reg_meta_from_info($info)
            match cg_reg_lookup_variant($meta.variants, $vname) {
                None { g6e_enum_name_from_variant_args($t, $full, $vname, $args) }
                Some($vm) {
                    # Cheap `!owned` first (|| is commutative and both operands are
                    # pure): a SOLE owner short-circuits before the arg-kind match,
                    # so single-owner variant names — all of the compiler's own
                    # enums — never pay for g6e_arg_kind's enum/class resolution.
                    # Only genuinely multi-owner variants (generic enum specs) run
                    # the field-kind disambiguation.
                    if !g6e_enum_variant_owned($t, $vname) || g6e_variant_fields_match_args($vm.fields, $args, $full) {
                        Ok($info.name)
                    } else {
                        g6e_enum_name_from_variant_args($t, $full, $vname, $args)
                    }
                }
            }
        }
    }
}

# The final value expression of a block (its last statement, when that statement
# is an `SExpr`). Used to infer the result kind of a value-position `match` from
# one of its arms (E5d-8t). A block ending in a non-value statement yields None.
sub g6e_block_final_expr($stmts: StmtList): Option[Expr] {
    match $stmts {
        StmtNil { None }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil { match $head { SExpr($e) { Some($e) } _ { None } } }
                StmtCons($h2, $t2) { g6e_block_final_expr($tail) }
            }
        }
    }
}

# Infer the enum result kind of a value-position `match` (E5d-8t) from its arms:
# return the first arm whose final value expression yields a definitive enum kind.
# The typechecker has already verified every arm produces the same type, so the
# first definitive arm is authoritative. An arm whose final expression names a
# pattern-bound variable (not in $env) yields no kind, so the next arm is tried.
sub g6e_enum_kind_from_arms($arms: ArmList, $env: CgEnv): Result[CgKind, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match g6e_block_final_expr($arm.body) {
                None { g6e_enum_kind_from_arms($rest, $env) }
                Some($e) {
                    match g6e_enum_kind_from_value($e, $env) {
                        Ok($k) { Ok($k) }
                        Err($m) { g6e_enum_kind_from_arms($rest, $env) }
                    }
                }
            }
        }
    }
}

# Infer the enum result kind of a value-position `if` (E5d-8u) from its branch
# final expressions. As with match arms above, the typechecker has already
# verified that all value branches agree; codegen only needs one definitive
# branch to choose the registered enum representation.
sub g6e_enum_kind_from_block($stmts: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match g6e_block_final_expr($stmts) {
        None { Err(g3_unsupported()) }
        Some($e) { g6e_enum_kind_from_value($e, $env) }
    }
}

sub g6e_enum_kind_from_if_tail($elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match $elifs {
        ElifNil {
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) { g6e_enum_kind_from_block($body, $env) }
            }
        }
        ElifCons($head, $tail) {
            match g6e_enum_kind_from_block($head.body, $env) {
                Ok($k) { Ok($k) }
                Err($m) { g6e_enum_kind_from_if_tail($tail, $els, $env) }
            }
        }
    }
}

sub g6e_enum_kind_from_if($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Result[CgKind, Str] {
    match g6e_enum_kind_from_block($then, $env) {
        Ok($k) { Ok($k) }
        Err($m) { g6e_enum_kind_from_if_tail($elifs, $els, $env) }
    }
}

# Infer a user-enum kind from the value expression when a local binding has no
# annotation, e.g. `$x = A(7)`. The typechecker has already accepted the source;
# this helper only teaches codegen which registered enum representation to use.
sub g6e_enum_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $value {
        ECall($callee, $args) {
            match $callee {
                ETypeName($vn) {
                    match g6e_enum_name_from_variant_args($env, $env, $vn, $args) {
                        Ok($en) { Ok(CgEnum($en)) }
                        Err($m) { Err($m) }
                    }
                }
                _ {
                    # Unannotated `$a = $ch.recv().unwrap()` peels the Option[E]
                    # carrier before the general call-target resolver (unwrap is
                    # not a user sub returning REnum).
                    match g4_option_unwrap_enum_name($callee, $args, $env) {
                        Ok($en) { Ok(CgEnum($en)) }
                        Err($not_unwrap) {
                            match g5_resolve_call_target($callee, $args, $env) {
                                Err($m) { Err($m) }
                                Ok($target) {
                                    match $target.sig.ret {
                                        REnum($en) { Ok(CgEnum($en)) }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ETypeName($vn) {
            match g6e_enum_name_from_variant($env, $env, $vn) {
                Ok($en) { Ok(CgEnum($en)) }
                Err($m) { Err($m) }
            }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) { match $v.kind { CgEnum($en) { Ok(CgEnum($en)) } _ { Err(g3_unsupported()) } } }
                None { Err(g3_unsupported()) }
            }
        }
        # An unannotated binding from an ENUM-typed class field read (`$x =
        # $obj.field`) infers the field's enum kind. The value path below retains
        # the embedded enum before the by-value copy is consumed.
        EField($obj, $field) {
            match g8_resolve_field_acc($obj, $field, $env) {
                Err($m) { Err($m) }
                Ok($fa) {
                    match $fa.kind {
                        CgEnum($en) { Ok(CgEnum($en)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        # A non-final binding from a value-position `match` whose arms produce a
        # user enum (`$sym = match $v.fields { SemTNil { $enum_ty } _ { TFn(..) } }`,
        # E5d-8t): infer the carrier enum from the arms. g4_lower_enum_bind then
        # lowers the RHS via g4_lower_value(CgEnum, EMatch) -> g6_lower_match, the
        # same value-position match path already used in final/return position.
        EMatch($subj, $arms) { g6e_enum_kind_from_arms($arms, $env) }
        # E5d-8u: the `if` analogue of the value-position match case above
        # (`$final_ty = if is_unknown($bound) { $actual } else { $bound }` in
        # `check_stmt_t2`). Once the carrier is inferred, the existing
        # g4_lower_value(CgEnum, EIf) -> g4_lower_if_value path owns lowering.
        EIf($cond, $then, $elifs, $els) { g6e_enum_kind_from_if($then, $elifs, $els, $env) }
        EIndex($obj, $idx) {
            match g7_list_kind_from_value($obj, $env) {
                Ok(CgEnum($en)) { Ok(CgEnum($en)) }
                _ {
                    match g7_map_val_kind_from_value($obj, $env) {
                        Ok(CgEnum($en)) { Ok(CgEnum($en)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# If `$subject` is a name bound to a user-enum local, return that enum's name (so
# a `match` discovers its scrutinee kind without re-synthesising types).
sub g6e_enum_carrier_of($subject: Expr, $env: CgEnv): Option[Str] {
    match $subject {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) { match $v.kind { CgEnum($en) { Some($en) } _ { None } } }
                None { None }
            }
        }
        _ { None }
    }
}

class CgEnumCtorOut {
    has $.state: CgState
    has $.fields: Str
}

sub g6e_field_supported($kind: CgKind): Bool {
    match $kind {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        CgStr { true }
        CgList($el) { g6e_enum_collection_elem_supported($el) }
        CgMap($v) { g6e_enum_collection_elem_supported($v) }
        # A nested user-enum field is embedded BY VALUE (slice 4d-D3). The referenced
        # enum's own layout is validated when ITS typedef is emitted, so admitting it
        # here only commits to a by-value struct member. A same-enum recursive
        # self-reference is represented separately as CgBoxEnum below.
        CgEnum($n) { true }
        CgBoxEnum($n) { true }
        CgBoxClass($n) { true }
        CgBoxOptClass($n) { true }
        CgBoxOptEnum($n) { true }
        # A user-CLASS variant field is embedded BY VALUE (slice 5 E5d-8h), the class
        # analogue of the nested-enum field above. The referenced class's own layout
        # is validated when ITS typedef is emitted, so admitting it here only commits
        # to a by-value struct member; its `guji_<op>_<Class>_fields` helper drives rc.
        CgClass($n) { true }
        # An Option[<user class>] variant field is stored as the per-class
        # `guji_opt_<Class>` carrier by value (E5d-8k), the class analogue of the
        # Option[<user enum>] field below; admitting it here only commits to a
        # by-value struct member, validated when the carrier typedef is emitted
        # (after the wrapped class's typedef).
        CgOptClass($n) { true }
        # An Option[<user enum>] variant field is stored as the per-enum
        # `guji_opt_<Enum>` carrier by value (E5d-7c-2d-7); admitting it here only
        # commits to a by-value struct member, validated when the carrier typedef is
        # emitted (after the wrapped enum's typedef).
        CgOptEnum($n) { true }
        # Homogeneous scalar Option positions are by-value tagged carriers. They
        # own no heap data; mixed positions are rejected by
        # g6e_kind_blocks_union because the carrier is a struct, not an int slot.
        CgOptInt { true }
        CgOptFloat { true }
        CgOptBool { true }
        # I8d bootstrap boundary: evaluator Values need to own file-backed
        # Handles before D can preserve open/create results across expressions.
        CgHandle { true }
        # I10a1 admitted scalar channel fields. I10c2a keeps the same pointer
        # storage/RC for collection and user-enum elements, restricted to the
        # native channel payload predicates before D adds those Value variants.
        CgChan($el) {
            match $el {
                CgUnit { true }
                CgInt { true }
                CgBool { true }
                CgFloat { true }
                CgStr { true }
                CgList($inner) { g11_chan_list_elem_supported($inner) }
                CgMap($val) { g11_chan_map_val_supported($val) }
                CgEnum($name) { true }
                _ { false }
            }
        }
        _ { false }
    }
}

# The flat element/value kind shared class/channel/hatch collection fields admit.
# Their wider nested boundaries are separate native-parity tasks.
sub g6e_collection_elem_supported($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgFloat { true }
        CgBool { true }
        CgStr { true }
        _ { false }
    }
}

# Enum payload and class field collections are KIND-tagged at every level, so
# nested List/Map shapes compose through the same representation as flat leaves.
# Channel/hatch deep detach keeps its own cross-heap constraints.
sub g6e_enum_collection_elem_supported($k: CgKind): Bool {
    match $k {
        CgList($inner) { g6e_enum_collection_elem_supported($inner) }
        CgMap($value) { g6e_enum_collection_elem_supported($value) }
        CgClass($name) { true }
        CgEnum($name) { true }
        _ { g6e_collection_elem_supported($k) }
    }
}

sub g6e_enum_retain($ename: Str, $c: Str): Str {
    "\tguji_retain_" ~ $ename ~ "_fields(&" ~ $c ~ ");\n"
}

sub g6e_enum_release($ename: Str, $c: Str): Str {
    "\tguji_release_" ~ $ename ~ "_fields(&" ~ $c ~ ");\n"
}

# Render a single constructor field initializer. A union (mixed-kind) position needs the
# native member designator (`{.i = <v>}` / `{.f = <v>}`); a plain scalar position is bare.
sub g6e_ctor_field_c($allvars: CgVariantInfoList, $idx: Int, $fk: CgKind, $valc: Str): Str {
    if g6e_pos_is_union($allvars, $idx) {
        '{' ~ g6e_union_member($fk) ~ " = " ~ $valc ~ '}'
    } else {
        $valc
    }
}

sub g6e_lower_boxed_enum_arg($en: Str, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g4_lower_value(CgEnum($en), $arg, $state, $env) {
        Err($m) { Err($m) }
        Ok($ev) {
            $box = g4_value_tmp(CgBoxEnum($en), $ev.state.ntmp)
            Ok(CgValueOut(
                state: CgState(
                    interns: $ev.state.interns,
                    decls: $ev.state.decls ~ g4_value_decl(CgBoxEnum($en), $box),
                    body: $ev.state.body ~ "\t" ~ $box ~ " = (" ~ $en ~ "*)guji_alloc(GUJI_KIND_" ~ $en ~ ", 0, sizeof(" ~ $en ~ "));\n\t*" ~ $box ~ " = " ~ $ev.c ~ ";\n",
                    nstr: $ev.state.nstr,
                    ntmp: $ev.state.ntmp + 1
                ),
                c: $box
            ))
        }
    }
}

sub g6e_lower_boxed_class_arg($cn: Str, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g8_class_value($cn, $arg, $state, $env) {
        Err($m) { Err($m) }
        Ok($cv) {
            $box = "gcp" ~ c_int($cv.state.ntmp)
            Ok(CgValueOut(
                state: CgState(
                    interns: $cv.state.interns,
                    decls: $cv.state.decls ~ "\t" ~ $cn ~ "* " ~ $box ~ " = 0;\n",
                    body: $cv.state.body ~ "\t" ~ $box ~ " = (" ~ $cn ~ "*)guji_alloc(GUJI_KIND_" ~ $cn ~ ", 0, sizeof(" ~ $cn ~ "));\n\t*" ~ $box ~ " = " ~ $cv.c ~ ";\n",
                    nstr: $cv.state.nstr,
                    ntmp: $cv.state.ntmp + 1
                ),
                c: $box
            ))
        }
    }
}

# The wrapped element name of an Option-carrier kind (`Option[<name>]`), used to
# build the per-carrier box kind macro `GUJI_KIND_opt_<name>` and the carrier ctype.
sub g6_option_wrapped_name($fk: CgKind): Result[Str, Str] {
    match $fk {
        CgOptClass($n) { Ok($n) }
        CgOptEnum($n) { Ok($n) }
        CgBoxOptClass($n) { Ok($n) }
        CgBoxOptEnum($n) { Ok($n) }
        _ { Err(g3_unsupported()) }
    }
}

# Lower an Option[class]/Option[enum] carrier constructor argument into a counted
# heap box (E5d-8h-3b), so it can occupy a mixed enum union slot's `.p` member. The
# carrier value owns its active Some payload; moving it into the box transfers that
# ownership (no aliased temp left live). The box is released by the enclosing enum's
# RC, and its drop helper `guji_drop_opt_<name>` releases the payload at rc==0.
sub g6e_lower_boxed_carrier_arg($fk: CgKind, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_wrapped_name($fk) {
        Err($m) { Err($m) }
        Ok($n) {
            $logical = g6_option_logical_kind($fk)
            $cty = g6_option_ctype($logical)
            match g4_lower_value($logical, $arg, $state, $env) {
                Err($m) { Err($m) }
                Ok($cv) {
                    $box = "gcp" ~ c_int($cv.state.ntmp)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $cv.state.interns,
                            decls: $cv.state.decls ~ "\t" ~ $cty ~ "* " ~ $box ~ " = 0;\n",
                            body: $cv.state.body ~ "\t" ~ $box ~ " = (" ~ $cty ~ "*)guji_alloc(GUJI_KIND_opt_" ~ $n ~ ", 0, sizeof(" ~ $cty ~ "));\n\t*" ~ $box ~ " = " ~ $cv.c ~ ";\n",
                            nstr: $cv.state.nstr,
                            ntmp: $cv.state.ntmp + 1
                        ),
                        c: $box
                    ))
                }
            }
        }
    }
}

sub g6e_lower_field_value($fk: CgKind, $arg: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $fk {
        CgBoxEnum($en) { g6e_lower_boxed_enum_arg($en, $arg, $state, $env) }
        CgBoxClass($cn) { g6e_lower_boxed_class_arg($cn, $arg, $state, $env) }
        CgBoxOptClass($cn) { g6e_lower_boxed_carrier_arg($fk, $arg, $state, $env) }
        CgBoxOptEnum($en) { g6e_lower_boxed_carrier_arg($fk, $arg, $state, $env) }
        _ { g4_lower_value($fk, $arg, $state, $env) }
    }
}

sub g6e_lower_ctor_field_value($allvars: CgVariantInfoList, $idx: Int, $fk: CgKind, $arg: Expr, $state: CgState, $env: CgEnv, $owner: Str, $all: DeclList): Result[CgValueOut, Str] {
    if g6e_pos_is_union($allvars, $idx) || g6e_field_carrier_boxed($allvars, $idx, $fk, $owner, $all) {
        match $fk {
            CgEnum($en) { g6e_lower_boxed_enum_arg($en, $arg, $state, $env) }
            CgClass($cn) { g6e_lower_boxed_class_arg($cn, $arg, $state, $env) }
            CgOptClass($cn) { g6e_lower_boxed_carrier_arg($fk, $arg, $state, $env) }
            CgOptEnum($cn) { g6e_lower_boxed_carrier_arg($fk, $arg, $state, $env) }
            CgBoxOptClass($cn) { g6e_lower_boxed_carrier_arg($fk, $arg, $state, $env) }
            CgBoxOptEnum($en) { g6e_lower_boxed_carrier_arg($fk, $arg, $state, $env) }
            _ { g6e_lower_field_value($fk, $arg, $state, $env) }
        }
    } else {
        g6e_lower_field_value($fk, $arg, $state, $env)
    }
}

sub g6e_lower_ctor_args($allvars: CgVariantInfoList, $idx: Int, $fields: CgKindList, $args: ExprList, $state: CgState, $env: CgEnv, $owner: Str, $all: DeclList): Result[CgEnumCtorOut, Str] {
    match $fields {
        CgKindNil {
            match $args {
                ExprNil { Ok(CgEnumCtorOut(state: $state, fields: "")) }
                _ { Err(g3_unsupported()) }
            }
        }
        CgKindCons($fk, $frest) {
            if !g6e_field_supported($fk) {
                Err(g3_unsupported())
            } else {
                match $args {
                    ExprNil { Err(g3_unsupported()) }
                    ExprCons($a, $arest) {
                                match g6e_lower_ctor_field_value($allvars, $idx, $fk, $a, $state, $env, $owner, $all) {
                                    Err($m) { Err($m) }
                                    Ok($fv) {
                                        $fc = g6e_ctor_field_c($allvars, $idx, $fk, $fv.c)
                                        match g6e_lower_ctor_args($allvars, $idx + 1, $frest, $arest, $fv.state, $env, $owner, $all) {
                                    Err($m) { Err($m) }
                                    Ok($rest) {
                                        Ok(CgEnumCtorOut(state: $rest.state, fields: ", " ~ $fc ~ $rest.fields))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Lower a user-enum value expression of enum `$ename` to a C rvalue.
sub g6e_enum_value($ename: Str, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match cg_env_lookup_enum($env, $ename) {
        None { Err(g3_unsupported()) }
        Some($info) {
            match $value {
                ECall($callee, $args) {
                    match $callee {
                        ETypeName($vn) {
                            match cg_reg_user_variant($env, $ename, $vn) {
                                Err($m) { Err($m) }
                                Ok($vu) {
                                    match cg_reg_lower_ctor_args($info.variants, 0, $vu.meta.fields, $args, $state, $env, $ename) {
                                        Err($m) { Err($m) }
                                        Ok($ctor) { Ok(CgValueOut(state: $ctor.state, c: "(" ~ $ename ~ ")\{" ~ c_int($vu.meta.tag) ~ "LL" ~ $ctor.fields ~ "}")) }
                                    }
                                }
                            }
                        }
                        _ {
                            # Recv-carrier extraction (P8d-2c-3d-2c): `$ch.recv().unwrap()`
                            # / bound `$opt.unwrap()` / function `unwrap($opt)` yield a
                            # scalar enum before the general REnum call resolver
                            # (unwrap/expect are not user subs).
                            match g4_option_unwrap_enum($ename, $callee, $args, $state, $env) {
                                Ok($ev) { Ok($ev) }
                                Err($not_unwrap) { g5_call_value(REnum($ename), $callee, $args, $state, $env) }
                            }
                        }
                    }
                }
                ETypeName($vn) {
                    match cg_reg_user_variant($env, $ename, $vn) {
                        Err($m) { Err($m) }
                        Ok($vu) {
                            match $vu.meta.fields {
                                FtNil { Ok(CgValueOut(state: $state, c: "(" ~ $ename ~ ")\{" ~ c_int($vu.meta.tag) ~ "LL}")) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                EName($vn) {
                    match cg_env_lookup($env, $vn) {
                        Some($var) {
                            match $var.kind {
                                CgEnum($en2) {
                                    if $en2 == $ename {
                                        Ok(CgValueOut(
                                            state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g6e_enum_retain($ename, $var.cname), nstr: $state.nstr, ntmp: $state.ntmp),
                                            c: $var.cname
                                        ))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        None { Err(g3_unsupported()) }
                    }
                }
                EField($obj, $field) {
                    g8_lower_field_value(CgEnum($ename), $obj, $field, $state, $env)
                }
                EIndex($obj, $idx) { g7_lower_index(CgEnum($ename), $obj, $idx, $state, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# A reference to a list's element storage for the `get` prelude (slice 5 E5d-8d):
# `$data` is the C element-pointer expression (already cast to the element ctype),
# `$len` the C length expression, and `$release` the cleanup to run after extracting
# (EMPTY for a BORROWED bound-var receiver whose owner releases it; the slice `.data`
# release for an OWNED producer like `split(...)` / a list literal / a list-returning
# sub call).
class GetListRef {
    has $.state: CgState
    has $.data: Str
    has $.len: Str
    has $.release: Str
}

# Reference the list receiver of `get(@list, $idx)` (slice 5 E5d-8d). A bound List
# local of the matching element kind is referenced BORROWED (g7_list_var_data/len, no
# release — its binding owns the storage); any other receiver (split(...), a list
# literal, a list-returning call) is lowered to an OWNED slice and released after the
# extract via g7_slice_release. Mirrors g7_lower_index's two-path receiver handling.
sub g6_get_list_ref($obj: Expr, $pk: CgKind, $state: CgState, $env: CgEnv): Result[GetListRef, Str] {
    match g7_list_c_type($pk) {
        Err($m) { Err($m) }
        Ok($ctype) {
            match $obj {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { g6_get_list_ref_owned($obj, $pk, $ctype, $state, $env) }
                        Some($v) {
                            match $v.kind {
                                CgList($actual) {
                                    if cgkind_eq($actual, $pk) {
                                        Ok(GetListRef(state: $state, data: g7_list_var_data($v, $ctype), len: g7_list_var_len($v), release: ""))
                                    } else {
                                        g6_get_list_ref_owned($obj, $pk, $ctype, $state, $env)
                                    }
                                }
                                _ { g6_get_list_ref_owned($obj, $pk, $ctype, $state, $env) }
                            }
                        }
                    }
                }
                _ { g6_get_list_ref_owned($obj, $pk, $ctype, $state, $env) }
            }
        }
    }
}

sub g6_get_list_ref_owned($obj: Expr, $pk: CgKind, $ctype: Str, $state: CgState, $env: CgEnv): Result[GetListRef, Str] {
    match g7_lower_list_value($pk, $obj, $state, $env) {
        Err($m) { Err($m) }
        Ok($lv) {
            Ok(GetListRef(
                state: $lv.state,
                data: "((" ~ $ctype ~ "*)" ~ $lv.c ~ ".data)",
                len: $lv.c ~ ".len",
                release: g7_slice_release($lv.c)
            ))
        }
    }
}

# A successful collection `get` copies a borrowed slot into an Option carrier.
# The carrier must take its own reference before its source collection can be
# released: Str owns one pointer, List owns `.data`, and Map owns both arrays.
# The indentation parameter lets list-get and map-get share this one ownership
# classifier while retaining native-shaped placement inside their hit blocks.
sub g6_get_hit_retain($kind: CgKind, $opt: Str, $indent: Str): Str {
    match $kind {
        CgOptStr { $indent ~ "guji_retain(" ~ $opt ~ ".val);\n" }
        CgOptList($elem) { $indent ~ "guji_retain((const void*)" ~ $opt ~ ".val.data);\n" }
        CgOptMap($val) {
            $indent ~ "guji_retain((const void*)" ~ $opt ~ ".val.keys);\n" ~
            $indent ~ "guji_retain((const void*)" ~ $opt ~ ".val.vals);\n"
        }
        _ { "" }
    }
}

# Lower the core list `get` prelude (§15) to an `Option[<elem>]` carrier, mirroring
# native codegen's listGet (slice 5 E5d-8d): an in-range index yields Some(element)
# (a Str element is retained so the carrier OWNS its own +1), an out-of-range index
# yields None with the kind-appropriate zero payload. Only scalar element kinds
# (Int/Float/Bool/Str) — g7_list_c_type rejects a class/enum element, so a get over a
# List[<user>] declines to the generic call path. The list receiver is referenced
# borrowed-or-owned by g6_get_list_ref; an owned receiver's storage is released after
# the extract (the retained Some payload survives the array drop).
sub g6_get_option_core($kind: CgKind, $listExpr: Expr, $idxExpr: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_option_payload_kind($kind) {
        Err($m) { Err($m) }
        Ok($pk) {
            match g6_get_list_ref($listExpr, $pk, $state, $env) {
                Err($m) { Err($m) }
                Ok($lr) {
                    match g3_int_rvalue_state($idxExpr, $lr.state, $env) {
                        Err($m) { Err($m) }
                        Ok($iv) {
                            $idxtmp = "gi" ~ c_int($iv.state.ntmp)
                            $opt = g4_value_tmp($kind, $iv.state.ntmp + 1)
                            $retain = g6_get_hit_retain($kind, $opt, "\t\t")
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $iv.state.interns,
                                    decls: $iv.state.decls ~ "\tint64_t " ~ $idxtmp ~ " = 0;\n" ~ g4_value_decl($kind, $opt),
                                    body: $iv.state.body ~
                                        "\t" ~ $idxtmp ~ " = " ~ $iv.c ~ ";\n" ~
                                        "\tif (" ~ $idxtmp ~ " >= 0LL && " ~ $idxtmp ~ " < " ~ $lr.len ~ ") \{\n" ~
                                        "\t\t" ~ $opt ~ ".tag = 1LL; " ~ $opt ~ ".val = " ~ $lr.data ~ "[" ~ $idxtmp ~ "];\n" ~
                                        $retain ~
                                        "\t} else \{\n" ~
                                        "\t\t" ~ $opt ~ ".tag = 0LL; " ~ $opt ~ ".val = " ~ g6_option_zero($kind) ~ ";\n" ~
                                        "\t}\n" ~
                                        $lr.release,
                                    nstr: $iv.state.nstr,
                                    ntmp: $iv.state.ntmp + 2
                                ),
                                c: $opt
                            ))
                        }
                    }
                }
            }
        }
    }
}

# Dispatch list `get` as either ordinary `get(@list, $idx)` or method-form
# `@list.get($idx)`. Native lets a user `sub get` shadow the ordinary call, but
# method form still lowers through the prelude listGet path.
sub g6_get_option_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $callee {
        EName($fn) {
            if $fn == "get" {
                match cg_env_lookup_sub($env, "get") {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($listExpr, ExprCons($idxExpr, ExprNil)) { g6_get_option_core($kind, $listExpr, $idxExpr, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "get" {
                match $args {
                    ExprCons($idxExpr, ExprNil) { g6_get_option_core($kind, $recv, $idxExpr, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}


# ---- P6a: Option[Match] from `~~` + Match accessors (§13) --------------------
# Native lowers `$s ~~ /pat/` to guji_regex_match_pattern_engine + a guji_opt_match
# carrier whose .val owns the Match (+1). Capture group count/names are recovered
# from the literal pattern text (same CapNames shape as native's parseRegex).
# Match accessors: $m.text (retain), $m[i] / $m<name> -> Option[Str] (retain).

class NamedCapInfo {
    has $.name: Str
    has $.next: Int
}

# Finish a named-capture ident after the first char (recursive — no while/
# reassignment; those are out of the selfhost subset that compiles this file).
sub g6_take_cap_ident(@chars: List[Str], $i: Int, $acc: Str): NamedCapInfo {
    if is_ident_cont(at(@chars, $i)) {
        g6_take_cap_ident(@chars, $i + 1, $acc ~ at(@chars, $i))
    } else {
        NamedCapInfo(name: $acc, next: $i)
    }
}

sub g6_try_named_cap_at(@chars: List[Str], $i: Int): Option[NamedCapInfo] {
    # Accept `<name>` starting at $i.
    if at(@chars, $i) == "<" {
        if is_ident_start(at(@chars, $i + 1)) {
            $id = g6_take_cap_ident(@chars, $i + 2, at(@chars, $i + 1))
            if at(@chars, $id.next) == ">" {
                Some(NamedCapInfo(name: $id.name, next: $id.next + 1))
            } else {
                None
            }
        } else {
            None
        }
    } else {
        None
    }
}

sub g6_try_named_cap(@chars: List[Str], $i: Int): Option[NamedCapInfo] {
    # Accept P?<name> or <name> at $i (after the "(?" already consumed).
    if at(@chars, $i) == "P" {
        g6_try_named_cap_at(@chars, $i + 1)
    } else {
        g6_try_named_cap_at(@chars, $i)
    }
}

sub g6_strlist_rev($xs: StrList, $acc: StrList): StrList {
    match $xs {
        StrNil { $acc }
        StrCons($h, $t) { g6_strlist_rev($t, StrCons($h, $acc)) }
    }
}

sub g6_strlist_len($xs: StrList): Int {
    match $xs {
        StrNil { 0 }
        StrCons($h, $t) { 1 + g6_strlist_len($t) }
    }
}

sub g6_cap_names_c_parts($names: StrList, $acc: Str): Str {
    match $names {
        StrNil { $acc }
        StrCons($h, $t) {
            $one = if $h == "" { "NULL" } else { "\"" ~ g2_c_escape($h) ~ "\"" }
            $next = if $acc == "" { $one } else { $acc ~ ", " ~ $one }
            g6_cap_names_c_parts($t, $next)
        }
    }
}

sub g6_cap_names_c_expr($names: StrList): Str {
    match $names {
        StrNil { "NULL" }
        StrCons($h, $t) { "((const char*[])\{" ~ g6_cap_names_c_parts($names, "") ~ "})" }
    }
}

# Capture-name scan for public Match slots. class_phase is -1 outside a class,
# 0 at class start, 1 after a leading ^, and 2 after an ordinary member. The
# verbose-mode stack prevents parentheses in (?x) comments from becoming slots;
# reserved private splice captures are excluded from the public list.
sub g6_cap_names_scan(@chars: List[Str], $i: Int, $names: StrList, $class_phase: Int, $verbose: Bool, $modes: RegexSpliceModes): StrList {
    $c = at(@chars, $i)
    if $c == "" {
        $names
    } else if $c == "\\" {
        # Skip escaped char (or lone trailing backslash).
        if at(@chars, $i + 1) == "" {
            $names
        } else {
            $next_phase = if $class_phase < 0 { 0 - 1 } else { 2 }
            g6_cap_names_scan(@chars, $i + 2, $names, $next_phase, $verbose, $modes)
        }
    } else if $class_phase >= 0 {
        if $c == "]" && $class_phase == 2 {
            g6_cap_names_scan(@chars, $i + 1, $names, 0 - 1, $verbose, $modes)
        } else if $class_phase == 0 && $c == "^" {
            g6_cap_names_scan(@chars, $i + 1, $names, 1, $verbose, $modes)
        } else {
            g6_cap_names_scan(@chars, $i + 1, $names, 2, $verbose, $modes)
        }
    } else if regex_splice_starts_comment($verbose, $c) {
        g6_cap_names_scan(@chars, regex_splice_comment_end(@chars, $i), $names, 0 - 1, $verbose, $modes)
    } else if $c == "[" {
        g6_cap_names_scan(@chars, $i + 1, $names, 0, $verbose, $modes)
    } else if $c == "(" {
        if at(@chars, $i + 1) != "?" {
            g6_cap_names_scan(@chars, $i + 1, StrCons("", $names), 0 - 1, $verbose, RegexSpliceModeCons($verbose, $modes))
        } else {
            match regex_splice_flag_info(@chars, $i, $verbose) {
                Some($flags) {
                    if $flags.scoped {
                        g6_cap_names_scan(@chars, $flags.next, $names, 0 - 1, $flags.verbose, RegexSpliceModeCons($verbose, $modes))
                    } else {
                        g6_cap_names_scan(@chars, $flags.next, $names, 0 - 1, $flags.verbose, $modes)
                    }
                }
                None {
                    match regex_splice_try_cap(@chars, $i + 2) {
                        Some($info) {
                            $next_names = if starts_with($info.name, "0H") { $names } else { StrCons($info.name, $names) }
                            g6_cap_names_scan(@chars, $info.next, $next_names, 0 - 1, $verbose, RegexSpliceModeCons($verbose, $modes))
                        }
                        None {
                            # Other (?...) forms inherit the current verbose mode.
                            g6_cap_names_scan(@chars, $i + 2, $names, 0 - 1, $verbose, RegexSpliceModeCons($verbose, $modes))
                        }
                    }
                }
            }
        }
    } else if $c == ")" {
        match $modes {
            RegexSpliceModeNil { g6_cap_names_scan(@chars, $i + 1, $names, 0 - 1, false, RegexSpliceModeNil) }
            RegexSpliceModeCons($outer, $rest) { g6_cap_names_scan(@chars, $i + 1, $names, 0 - 1, $outer, $rest) }
        }
    } else {
        g6_cap_names_scan(@chars, $i + 1, $names, 0 - 1, $verbose, $modes)
    }
}

sub g6_regex_cap_names($pattern: Str): StrList {
    g6_strlist_rev(g6_cap_names_scan(split($pattern, ""), 0, StrNil, 0 - 1, false, RegexSpliceModeNil), StrNil)
}

# ---- P6e: host-provided regex splice parts (§13) ----------------------------
# A Regex value is still a counted Str (P6d), so Str vs Regex splices are told
# apart by a listlen sentinel on CgStr bindings: -3 marks a Regex-as-Str local
# (pattern text inserted raw). Ordinary Str splices go through
# guji_regex_escape_literal. Native's parseRegexParts finds `<{` WITHOUT a
# bracket-depth guard (unlike the lexer opener), so detection matches that.

enum RegexPart {
    RPText($text: Str)
    RPSplice($expr: Expr)
}

enum RegexPartList {
    RPNil
    RPCons($h: RegexPart, $t: RegexPartList)
}

class RegexPartsOut {
    has $.state: CgState
    has $.parts: Str
    has $.count: Int
    has $.release: Str
}

sub g6_regex_str_listlen(): Int { 0 - 3 }

sub g6_is_regex_compile_callee($c: Expr): Bool {
    match $c {
        EField($recv, $method) {
            if $method == "compile" {
                match $recv {
                    ETypeName($tn) { $tn == "Regex" }
                    _ { false }
                }
            } else {
                false
            }
        }
        _ { false }
    }
}

sub g6_ty_is_regex($ty: Option[TypeRef]): Bool {
    match $ty {
        Some($tr) { $tr.name == "Regex" }
        None { false }
    }
}

sub g6_ty_is_option_regex($ty: Option[TypeRef]): Bool {
    match $ty {
        Some($tr) {
            if $tr.name == "Option" {
                match typelist_at($tr.args, 0) {
                    Some($elem) { $elem.name == "Regex" }
                    None { false }
                }
            } else {
                false
            }
        }
        None { false }
    }
}

# Result[Regex, E] collapses to CgRes(CgStr, …) like Option[Regex]→CgOptStr.
# listlen -3 on the Result binding marks the Ok arm as Regex for display/splice.
sub g6_ty_is_result_regex($ty: Option[TypeRef]): Bool {
    match $ty {
        Some($tr) {
            if $tr.name == "Result" {
                match typelist_at($tr.args, 0) {
                    Some($ok) { $ok.name == "Regex" }
                    None { false }
                }
            } else {
                false
            }
        }
        None { false }
    }
}

# True when `$ch` is a Chan[Option[Regex]] handle. Channels reuse CgChan(CgOptStr)
# for both Option[Str] and Option[Regex]; listlen -3 is the type mark (same sentinel
# Option[Regex] locals use).
sub g6_chan_var_is_option_regex($v: CgVar): Bool {
    match $v.kind {
        CgChan($el) {
            match $el {
                CgOptStr { $v.listlen == g6_regex_str_listlen() }
                _ { false }
            }
        }
        _ { false }
    }
}

# Chan[Result[Regex, E]] reuses CgChan(CgRes(CgStr, …)); listlen -3 marks it.
sub g6_chan_var_is_result_regex($v: CgVar): Bool {
    match $v.kind {
        CgChan($el) {
            match $el {
                CgRes($ok, $err) {
                    if cgkind_eq($ok, CgStr) {
                        $v.listlen == g6_regex_str_listlen()
                    } else {
                        false
                    }
                }
                _ { false }
            }
        }
        _ { false }
    }
}

# True when an expression yields Option[Option[Regex]] (outer receive-presence
# wrapper over an Option[Regex] element) — typically `$ch.recv()` on a marked
# Chan[Option[Regex]], or a held OptCarrier marked the same way.
sub g6_expr_is_opt_carrier_option_regex($e: Expr, $env: CgEnv): Bool {
    match $e {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgOptCarrier($inner) {
                            match $inner {
                                CgOptStr { $v.listlen == g6_regex_str_listlen() }
                                _ { false }
                            }
                        }
                        _ { false }
                    }
                }
                None { false }
            }
        }
        ECall($c, $a) {
            match $c {
                EField($recv, $method) {
                    if $method == "recv" {
                        match $recv {
                            EName($n) {
                                match cg_env_lookup($env, $n) {
                                    Some($v) { g6_chan_var_is_option_regex($v) }
                                    None { false }
                                }
                            }
                            _ { false }
                        }
                    } else {
                        false
                    }
                }
                _ { false }
            }
        }
        _ { false }
    }
}

# True when an expression yields Option[Result[Regex, E]] — `$ch.recv()` on a
# marked Chan[Result[Regex, …]], or a held OptCarrier with the Regex sentinel.
sub g6_expr_is_opt_carrier_result_regex($e: Expr, $env: CgEnv): Bool {
    match $e {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgOptCarrier($inner) {
                            match $inner {
                                CgRes($ok, $err) {
                                    if cgkind_eq($ok, CgStr) {
                                        $v.listlen == g6_regex_str_listlen()
                                    } else {
                                        false
                                    }
                                }
                                _ { false }
                            }
                        }
                        _ { false }
                    }
                }
                None { false }
            }
        }
        ECall($c, $a) {
            match $c {
                EField($recv, $method) {
                    if $method == "recv" {
                        match $recv {
                            EName($n) {
                                match cg_env_lookup($env, $n) {
                                    Some($v) { g6_chan_var_is_result_regex($v) }
                                    None { false }
                                }
                            }
                            _ { false }
                        }
                    } else {
                        false
                    }
                }
                _ { false }
            }
        }
        _ { false }
    }
}

# True when an expression yields Result[Regex, E] (CgRes(CgStr,…) + listlen -3).
# Also recognizes `$ch.recv().unwrap()` / `.expect()` on Chan[Result[Regex, …]]
# and bare calls whose CgSig.ret is RRes with retregex (Result[Regex] returns).
sub g6_expr_is_result_regex($e: Expr, $env: CgEnv): Bool {
    match $e {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgRes($ok, $err) {
                            if cgkind_eq($ok, CgStr) {
                                $v.listlen == g6_regex_str_listlen()
                            } else {
                                false
                            }
                        }
                        _ { false }
                    }
                }
                None { false }
            }
        }
        ECall($c, $a) {
            match $c {
                EField($recv, $method) {
                    if $method == "unwrap" || $method == "expect" {
                        g6_expr_is_opt_carrier_result_regex($recv, $env)
                    } else {
                        false
                    }
                }
                EName($f) {
                    match cg_env_lookup_sub($env, $f) {
                        Some($sig) {
                            match $sig.ret {
                                RRes($k) { $sig.retregex }
                                _ { false }
                            }
                        }
                        None { false }
                    }
                }
                _ { false }
            }
        }
        _ { false }
    }
}

# True when an expression names/yields an Option[Regex] carrier. Both Option[Regex]
# and Option[Str] use CgOptStr; listlen -3 is the representation-side type mark.
# Also recognizes `$ch.recv().unwrap()` / `.expect()` when `$ch` is Chan[Option[Regex]].
sub g6_expr_is_option_regex($e: Expr, $env: CgEnv): Bool {
    match $e {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgOptStr { $v.listlen == g6_regex_str_listlen() }
                        _ { false }
                    }
                }
                None { false }
            }
        }
        ECall($c, $a) {
            match $c {
                EField($recv, $method) {
                    if $method == "unwrap" || $method == "expect" {
                        g6_expr_is_opt_carrier_option_regex($recv, $env)
                    } else {
                        false
                    }
                }
                _ { false }
            }
        }
        _ { false }
    }
}

# Decide whether every arm of a match over Option[Regex] yields Regex. The Some
# binder is temporarily marked as Regex so `$rx` is recognized in its arm tail.
sub g6_option_regex_arm_is_regex($arm: Arm, $env: CgEnv): Bool {
    match $arm.pat {
        PVariant($name, $args) {
            if $name == "Some" {
                match $args {
                    PatCons($p, PatNil) {
                        match $p {
                            PBind($n) {
                                $renv = CgEnvCons(CgVar(name: $n, cname: "", kind: CgStr, mutable: false, borrowed: true, listlen: g6_regex_str_listlen()), $env)
                                g6_block_tail_is_regex($arm.body, $renv)
                            }
                            PWild { g6_block_tail_is_regex($arm.body, $env) }
                            _ { false }
                        }
                    }
                    _ { false }
                }
            } else {
                g6_block_tail_is_regex($arm.body, $env)
            }
        }
        _ { g6_block_tail_is_regex($arm.body, $env) }
    }
}

sub g6_option_regex_arms_are_regex($arms: ArmList, $env: CgEnv): Bool {
    match $arms {
        ArmNil { true }
        ArmCons($arm, $rest) {
            g6_option_regex_arm_is_regex($arm, $env) && g6_option_regex_arms_are_regex($rest, $env)
        }
    }
}

sub g6_expr_is_regex_val($e: Expr, $env: CgEnv): Bool {
    match $e {
        ERegex($p, $l, $c) { true }
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) {
                    match $v.kind {
                        CgStr { $v.listlen == g6_regex_str_listlen() }
                        _ { false }
                    }
                }
                None { false }
            }
        }
        ECall($c, $a) {
            match $c {
                EField($recv, $method) {
                    if $method == "literal" {
                        match $recv {
                            ETypeName($tn) { $tn == "Regex" }
                            _ { false }
                        }
                    } else if $method == "unwrap" || $method == "expect" || $method == "unwrap_or" {
                        match $recv {
                            ECall($c2, $a2) { g6_is_regex_compile_callee($c2) }
                            _ { false }
                        }
                    } else {
                        false
                    }
                }
                EName($f) {
                    # A declared `(): Regex` sub keeps its marking across the
                    # call (CgSig.retregex); unknown names read false.
                    match cg_env_lookup_sub($env, $f) {
                        Some($sig) { $sig.retregex }
                        None { false }
                    }
                }
                _ { false }
            }
        }
        EMatch($subj, $arms) {
            match $subj {
                ECall($c, $a) { g6_is_regex_compile_callee($c) }
                _ {
                    g6_expr_is_option_regex($subj, $env) && g6_option_regex_arms_are_regex($arms, $env)
                }
            }
        }
        EIf($cond, $then, $elifs, $els) {
            # An if-EXPRESSION is Regex-valued only when EVERY branch tail is —
            # a mixed Str/Regex if is a type error in both oracles, so the
            # all-branches bar is exact, not merely conservative. A tail that
            # references branch-local binds is invisible to $env and reads
            # false; such shapes keep the unmarked (plain Str) path.
            match $els {
                None { false }
                Some($eb) {
                    g6_block_tail_is_regex($then, $env) && g6_elif_tails_are_regex($elifs, $env) && g6_block_tail_is_regex($eb, $env)
                }
            }
        }
        _ { false }
    }
}

sub g6_block_tail_expr($body: StmtList): Option[Expr] {
    match $body {
        StmtNil { None }
        StmtCons($h, $t) {
            match $t {
                StmtNil {
                    match $h {
                        SExpr($e) { Some($e) }
                        _ { None }
                    }
                }
                StmtCons($h2, $t2) { g6_block_tail_expr($t) }
            }
        }
    }
}

sub g6_block_tail_is_regex($body: StmtList, $env: CgEnv): Bool {
    match g6_block_tail_expr($body) {
        Some($e) { g6_expr_is_regex_val($e, $env) }
        None { false }
    }
}

sub g6_elif_tails_are_regex($elifs: ElifList, $env: CgEnv): Bool {
    match $elifs {
        ElifNil { true }
        ElifCons($h, $t) {
            g6_block_tail_is_regex($h.body, $env) && g6_elif_tails_are_regex($t, $env)
        }
    }
}

sub g6_str_bind_listlen($ty: Option[TypeRef], $value: Expr, $env: CgEnv): Int {
    if g6_ty_is_regex($ty) || g6_expr_is_regex_val($value, $env) {
        g6_regex_str_listlen()
    } else {
        0
    }
}

sub g6_option_bind_listlen($ty: Option[TypeRef]): Int {
    if g6_ty_is_option_regex($ty) { g6_regex_str_listlen() } else { 0 }
}

# Unannotated Option binds (`$first = $ch.recv().unwrap()`) have no TypeRef; keep
# the Regex marker when the RHS is already Option[Regex]-valued. The same peel
# also binds Chan[Result[T]].recv().unwrap() as the inner Result via
# g6_option_unwrap_carrier_kind — stamp Result[Regex] the same way.
sub g6_option_bind_listlen_value($ty: Option[TypeRef], $value: Expr, $env: CgEnv): Int {
    if g6_ty_is_option_regex($ty) || g6_expr_is_option_regex($value, $env) || g6_expr_is_result_regex($value, $env) {
        g6_regex_str_listlen()
    } else {
        0
    }
}

sub g6_result_bind_listlen_value($ty: Option[TypeRef], $value: Expr, $env: CgEnv): Int {
    if g6_ty_is_result_regex($ty) || g6_expr_is_result_regex($value, $env) {
        g6_regex_str_listlen()
    } else {
        0
    }
}

# Chan[Option[Regex]] / Chan[Result[Regex, E]] reuse Str-shaped carriers; mark
# the handle so recv→unwrap binds can re-derive the Regex Ok/payload marker.
sub g11_chan_bind_listlen($ty: Option[TypeRef]): Int {
    match $ty {
        None { 0 }
        Some($tr) {
            if $tr.name == "Chan" {
                match typelist_at($tr.args, 0) {
                    Some($elem) {
                        if g6_ty_is_option_regex(Some($elem)) || g6_ty_is_result_regex(Some($elem)) {
                            g6_regex_str_listlen()
                        } else {
                            0
                        }
                    }
                    None { 0 }
                }
            } else {
                0
            }
        }
    }
}

# Native parseRegexParts: an escaped `\<` never opens a splice; bracket depth is
# NOT consulted (a `<{` left inside `[...]` by the lexer is still a splice).
sub g6_regex_splice_scan(@chars: List[Str], $i: Int): Bool {
    $c = at(@chars, $i)
    if $c == "" {
        false
    } else if $c == "\\" {
        if at(@chars, $i + 1) == "" {
            false
        } else {
            g6_regex_splice_scan(@chars, $i + 2)
        }
    } else if $c == "<" && at(@chars, $i + 1) == '{' {
        true
    } else {
        g6_regex_splice_scan(@chars, $i + 1)
    }
}

sub g6_regex_pattern_has_splice($pattern: Str): Bool {
    g6_regex_splice_scan(split($pattern, ""), 0)
}

# Host-capture name scan: each splice becomes an empty non-capturing atom so
# surrounding host groups keep their indices (native uses an empty Regex part).
sub g6_regex_host_pattern_acc(@chars: List[Str], $i: Int, $acc: Str): Str {
    $c = at(@chars, $i)
    if $c == "" {
        $acc
    } else if $c == "\\" {
        $e = at(@chars, $i + 1)
        if $e == "" {
            $acc ~ $c
        } else {
            g6_regex_host_pattern_acc(@chars, $i + 2, $acc ~ $c ~ $e)
        }
    } else if $c == "<" && at(@chars, $i + 1) == '{' {
        match g6_regex_find_splice_end(@chars, $i + 2) {
            None { $acc }
            Some($end) {
                g6_regex_host_pattern_acc(@chars, $end + 1, $acc ~ "(?:)")
            }
        }
    } else {
        g6_regex_host_pattern_acc(@chars, $i + 1, $acc ~ $c)
    }
}

sub g6_regex_host_pattern($pattern: Str): Str {
    g6_regex_host_pattern_acc(split($pattern, ""), 0, "")
}

sub g6_regex_cap_names_host($pattern: Str): StrList {
    if g6_regex_pattern_has_splice($pattern) {
        g6_regex_cap_names(g6_regex_host_pattern($pattern))
    } else {
        g6_regex_cap_names($pattern)
    }
}

# findRegexSpliceEnd: returns the index of `>` in `}>` closing the splice that
# started at $i (first char of the expression body). None = unterminated.
sub g6_regex_find_splice_end(@chars: List[Str], $i: Int): Option[Int] {
    g6_regex_find_splice_end_d(@chars, $i, 1)
}

sub g6_regex_find_splice_end_d(@chars: List[Str], $i: Int, $depth: Int): Option[Int] {
    $c = at(@chars, $i)
    if $c == "" {
        None
    } else if $c == "\\" {
        if at(@chars, $i + 1) == "" {
            None
        } else {
            g6_regex_find_splice_end_d(@chars, $i + 2, $depth)
        }
    } else if $c == "\"" || $c == "'" {
        match g6_regex_skip_splice_string(@chars, $i + 1, $c) {
            None { None }
            Some($ni) { g6_regex_find_splice_end_d(@chars, $ni, $depth) }
        }
    } else if $c == '{' {
        g6_regex_find_splice_end_d(@chars, $i + 1, $depth + 1)
    } else if $c == '}' {
        if $depth == 1 {
            if at(@chars, $i + 1) == ">" {
                Some($i + 1)
            } else {
                None
            }
        } else {
            g6_regex_find_splice_end_d(@chars, $i + 1, $depth - 1)
        }
    } else {
        g6_regex_find_splice_end_d(@chars, $i + 1, $depth)
    }
}

sub g6_regex_skip_splice_string(@chars: List[Str], $i: Int, $quote: Str): Option[Int] {
    $c = at(@chars, $i)
    if $c == "" {
        None
    } else if $c == "\\" {
        if at(@chars, $i + 1) == "" {
            None
        } else {
            g6_regex_skip_splice_string(@chars, $i + 2, $quote)
        }
    } else if $c == $quote {
        Some($i + 1)
    } else {
        g6_regex_skip_splice_string(@chars, $i + 1, $quote)
    }
}

sub g6_regex_slice(@chars: List[Str], $from: Int, $to: Int, $acc: Str): Str {
    if $from >= $to {
        $acc
    } else {
        g6_regex_slice(@chars, $from + 1, $to, $acc ~ at(@chars, $from))
    }
}

sub g6_regex_parse_splice_expr($src: Str): Result[Expr, Str] {
    $t = trim($src)
    if $t == "" {
        Err(g3_unsupported())
    } else {
        match g3_parse_interpolation_expr($t) {
            None { Err(g3_unsupported()) }
            Some($e) { Ok($e) }
        }
    }
}

sub g6_regex_parse_parts_acc(@chars: List[Str], $i: Int, $start: Int, $acc: RegexPartList): Result[RegexPartList, Str] {
    $c = at(@chars, $i)
    if $c == "" {
        if $start == 0 {
            Ok(RPNil)
        } else if $start < $i {
            Ok(g6_rplist_rev(RPCons(RPText(g6_regex_slice(@chars, $start, $i, "")), $acc), RPNil))
        } else {
            Ok(g6_rplist_rev($acc, RPNil))
        }
    } else if $c == "\\" {
        if at(@chars, $i + 1) == "" {
            if $start == 0 {
                Ok(RPNil)
            } else {
                Ok(g6_rplist_rev(RPCons(RPText(g6_regex_slice(@chars, $start, $i + 1, "")), $acc), RPNil))
            }
        } else {
            g6_regex_parse_parts_acc(@chars, $i + 2, $start, $acc)
        }
    } else if $c == "<" && at(@chars, $i + 1) == '{' {
        $text_acc = if $i > $start {
            RPCons(RPText(g6_regex_slice(@chars, $start, $i, "")), $acc)
        } else {
            $acc
        }
        match g6_regex_find_splice_end(@chars, $i + 2) {
            None { Err(g3_unsupported()) }
            Some($close) {
                $src = g6_regex_slice(@chars, $i + 2, $close - 1, "")
                match g6_regex_parse_splice_expr($src) {
                    Err($m) { Err($m) }
                    Ok($e) {
                        g6_regex_parse_parts_acc(@chars, $close + 1, $close + 1, RPCons(RPSplice($e), $text_acc))
                    }
                }
            }
        }
    } else {
        g6_regex_parse_parts_acc(@chars, $i + 1, $start, $acc)
    }
}

sub g6_rplist_rev($xs: RegexPartList, $acc: RegexPartList): RegexPartList {
    match $xs {
        RPNil { $acc }
        RPCons($h, $t) { g6_rplist_rev($t, RPCons($h, $acc)) }
    }
}

sub g6_regex_parse_parts($pattern: Str): Result[RegexPartList, Str] {
    g6_regex_parse_parts_acc(split($pattern, ""), 0, 0, RPNil)
}

sub g6_rplist_len($xs: RegexPartList): Int {
    match $xs {
        RPNil { 0 }
        RPCons($h, $t) { 1 + g6_rplist_len($t) }
    }
}

# Emit greparts[N] assignments. Str splices escape; Regex splices set .pattern.
# Returns the parts array name, count, and a release snippet for escape temps
# (and any owned Str temps produced while lowering fresh splice exprs).
sub g6_regex_emit_parts_acc($parts: RegexPartList, $pname: Str, $idx: Int, $state: CgState, $env: CgEnv, $body: Str, $decls: Str, $release: Str): Result[RegexPartsOut, Str] {
    match $parts {
        RPNil {
            Ok(RegexPartsOut(
                state: CgState(
                    interns: $state.interns,
                    decls: $state.decls ~ $decls,
                    body: $state.body ~ $body,
                    nstr: $state.nstr,
                    ntmp: $state.ntmp
                ),
                parts: $pname,
                count: $idx,
                release: $release
            ))
        }
        RPCons($h, $t) {
            match $h {
                RPText($text) {
                    $line = $pname ~ "[" ~ c_int($idx) ~ "].text = \"" ~ g2_c_escape($text) ~ "\"; " ~
                        $pname ~ "[" ~ c_int($idx) ~ "].pattern = NULL;\n"
                    g6_regex_emit_parts_acc($t, $pname, $idx + 1, $state, $env, $body ~ "\t" ~ $line, $decls, $release)
                }
                RPSplice($expr) {
                    if g6_expr_is_regex_val($expr, $env) {
                        match $expr {
                            EName($n) {
                                match cg_env_lookup($env, $n) {
                                    None { Err(g3_unsupported()) }
                                    Some($v) {
                                        $line = $pname ~ "[" ~ c_int($idx) ~ "].text = NULL; " ~
                                            $pname ~ "[" ~ c_int($idx) ~ "].pattern = " ~ $v.cname ~ ";\n"
                                        g6_regex_emit_parts_acc($t, $pname, $idx + 1, $state, $env, $body ~ "\t" ~ $line, $decls, $release)
                                    }
                                }
                            }
                            _ {
                                match g3_str_lower($expr, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($sl) {
                                        $line = $pname ~ "[" ~ c_int($idx) ~ "].text = NULL; " ~
                                            $pname ~ "[" ~ c_int($idx) ~ "].pattern = " ~ $sl.tmp ~ ";\n"
                                        $rel = $release ~ "\tguji_release(" ~ $sl.tmp ~ ");\n"
                                        g6_regex_emit_parts_acc($t, $pname, $idx + 1, $sl.state, $env, $body ~ "\t" ~ $line, $decls, $rel)
                                    }
                                }
                            }
                        }
                    } else {
                        match g3_str_lower($expr, $state, $env) {
                            Err($m) { Err($m) }
                            Ok($sl) {
                                $esc = "gresc" ~ c_int($sl.state.ntmp)
                                $st2 = CgState(
                                    interns: $sl.state.interns,
                                    decls: $sl.state.decls ~ "\tchar* " ~ $esc ~ " = NULL;\n",
                                    body: $sl.state.body ~
                                        "\t" ~ $esc ~ " = guji_regex_escape_literal(" ~ $sl.tmp ~ ");\n" ~
                                        "\tguji_release(" ~ $sl.tmp ~ ");\n",
                                    nstr: $sl.state.nstr,
                                    ntmp: $sl.state.ntmp + 1
                                )
                                $line = $pname ~ "[" ~ c_int($idx) ~ "].text = " ~ $esc ~ "; " ~
                                    $pname ~ "[" ~ c_int($idx) ~ "].pattern = NULL;\n"
                                $rel = $release ~ "\tguji_release(" ~ $esc ~ ");\n"
                                g6_regex_emit_parts_acc($t, $pname, $idx + 1, $st2, $env, $body ~ "\t" ~ $line, $decls, $rel)
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g6_regex_emit_parts($parts: RegexPartList, $state: CgState, $env: CgEnv): Result[RegexPartsOut, Str] {
    $n = g6_rplist_len($parts)
    $cap = if $n < 1 { 1 } else { $n }
    $pname = "greparts" ~ c_int($state.ntmp)
    $st1 = CgState(
        interns: $state.interns,
        decls: $state.decls ~ "\tguji_regex_part_t " ~ $pname ~ "[" ~ c_int($cap) ~ "];\n",
        body: $state.body,
        nstr: $state.nstr,
        ntmp: $state.ntmp + 1
    )
    g6_regex_emit_parts_acc($parts, $pname, 0, $st1, $env, "", "", "")
}

# §13 first-class Regex associated functions with a Str result rep.
# `Regex.literal($s)` (a Regex whose pattern matches $s literally) and
# `Regex.escape($s)` (the escaped pattern TEXT as a Str) share one runtime
# call — native lowers BOTH to `guji_regex_escape_literal(arg)`, an owned
# counted Str; a Regex VALUE is byte-identical to a Str (the validated
# pattern), so both come back as an owned StrLower.
sub g6_regex_assoc_str($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $callee {
        EField($recv, $method) {
            match $recv {
                ETypeName($tn) {
                    if $tn == "Regex" && ($method == "literal" || $method == "escape") {
                        match $args {
                            ExprCons($arg, ExprNil) {
                                match g3_str_lower($arg, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($sl) {
                                        $tmp = "gt" ~ c_int($sl.state.ntmp)
                                        Ok(StrLower(
                                            state: CgState(
                                                interns: $sl.state.interns,
                                                decls: $sl.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                                                body: $sl.state.body ~
                                                    "\t" ~ $tmp ~ " = guji_regex_escape_literal(" ~ $sl.tmp ~ ");\n" ~
                                                    "\tguji_release(" ~ $sl.tmp ~ ");\n",
                                                nstr: $sl.state.nstr,
                                                ntmp: $sl.state.ntmp + 1
                                            ),
                                            tmp: $tmp
                                        ))
                                    }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Public `Regex.compile($s)` and the evaluator-only internal bridge both return
# Result[Regex, Str]. Match the exact callee shape and single argument for the
# carrier classifier and lowerer below.
sub g6_regex_compile_is_internal($callee: Expr, $env: CgEnv): Bool {
    match $callee {
        EName($name) {
            if $name == "__guji_regex_compile_internal" {
                match cg_env_lookup_sub($env, $name) {
                    Some($sig) { $sig.cname == "gf_imp_lexer___guji_regex_compile_internal" }
                    None { false }
                }
            } else {
                false
            }
        }
        _ { false }
    }
}

sub g6_regex_compile_args($callee: Expr, $args: ExprList, $env: CgEnv): Result[Expr, Str] {
    match $callee {
        EName($name) {
            if g6_regex_compile_is_internal($callee, $env) {
                match $args {
                    ExprCons($arg, ExprNil) { Ok($arg) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            match $recv {
                ETypeName($tn) {
                    if $tn == "Regex" && $method == "compile" {
                        match $args {
                            ExprCons($arg, ExprNil) { Ok($arg) }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower regex compilation to an inline validation block. Public calls use the
# ordinary parser; the exact evaluator bridge enables reserved hidden names in
# already-materialized splice values. On success the Ok slot owns a fresh copy
# of the pattern text and the temporary compiled program is freed.
sub g6_regex_compile_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_regex_compile_args($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($arg) {
            match g3_str_lower($arg, $state, $env) {
                Err($m) { Err($m) }
                Ok($sl) {
                    $tmp = "gt" ~ c_int($sl.state.ntmp)
                    $internal = g6_regex_compile_is_internal($callee, $env)
                    $compile_fn = if $internal { "guji_regex_compile_internal" } else { "guji_regex_compile" }
                    $private_mark = if $internal {
                        " GUJI_HDR(" ~ $tmp ~ ".ok)->flags |= GUJI_REGEX_PRIVATE;"
                    } else {
                        ""
                    }
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $sl.state.interns,
                            decls: $sl.state.decls ~ "\tguji_res_str_str " ~ $tmp ~ " = \{0};\n",
                            body: $sl.state.body ~
                                "\t\{ guji_regex_compile_result_t cr = " ~ $compile_fn ~ "(" ~ $sl.tmp ~ "); if (cr.ok) \{ " ~ $tmp ~ ".tag = 0; " ~ $tmp ~ ".ok = guji_str_copy(" ~ $sl.tmp ~ ");" ~ $private_mark ~ " guji_regex_program_free(cr.prog); } else \{ " ~ $tmp ~ ".tag = 1; " ~ $tmp ~ ".err = guji_regex_compile_error_message(&cr); } }\n" ~
                                "\tguji_release(" ~ $sl.tmp ~ ");\n",
                            nstr: $sl.state.nstr,
                            ntmp: $sl.state.ntmp + 1
                        ),
                        c: $tmp
                    ))
                }
            }
        }
    }
}

# §15.3 template replacement. The runtime owns template expansion (`$0`,
# `$1`, `$<name>`, `$$`) and returns a fresh counted Str. Spliced literals reuse
# P6e-match's host parts + `guji_regex_replace_engine_parts` (native order:
# subject → parts → template).
sub g6_replace_core($recv: Expr, $regex: Expr, $template: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $regex {
        ERegex($pattern, $rline, $rcol) {
            match g3_str_lower($recv, $state, $env) {
                Err($m) { Err($m) }
                Ok($subject) {
                    if g6_regex_pattern_has_splice($pattern) {
                        match g6_regex_parse_parts($pattern) {
                            Err($m) { Err($m) }
                            Ok($parts) {
                                match g6_regex_emit_parts($parts, $subject.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($po) {
                                        match g3_str_lower($template, $po.state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($tmpl) {
                                                $names = g6_regex_cap_names_host($pattern)
                                                $names_c = g6_cap_names_c_expr($names)
                                                $nsubs = g6_strlist_len($names)
                                                $loc = c_int($rline) ~ ":" ~ c_int($rcol)
                                                $out = "gt" ~ c_int($tmpl.state.ntmp)
                                                Ok(StrLower(
                                                    state: CgState(
                                                        interns: $tmpl.state.interns,
                                                        decls: $tmpl.state.decls ~ "\tconst char* " ~ $out ~ " = NULL;\n",
                                                        body: $tmpl.state.body ~
                                                            "\t" ~ $out ~ " = guji_regex_replace_engine_parts(\"" ~ $loc ~ "\", " ~
                                                                $subject.tmp ~ ", " ~ $po.parts ~ ", " ~ c_int($po.count) ~ ", " ~
                                                                c_int($nsubs) ~ ", " ~ $tmpl.tmp ~ ", " ~ $names_c ~ ");\n" ~
                                                            $po.release ~
                                                            "\tguji_release(" ~ $tmpl.tmp ~ ");\n" ~
                                                            "\tguji_release(" ~ $subject.tmp ~ ");\n",
                                                        nstr: $tmpl.state.nstr,
                                                        ntmp: $tmpl.state.ntmp + 1
                                                    ),
                                                    tmp: $out
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        match g3_str_lower($template, $subject.state, $env) {
                            Err($m) { Err($m) }
                            Ok($tmpl) {
                                $names = g6_regex_cap_names($pattern)
                                $names_c = g6_cap_names_c_expr($names)
                                $nsubs = g6_strlist_len($names)
                                $out = "gt" ~ c_int($tmpl.state.ntmp)
                                Ok(StrLower(
                                    state: CgState(
                                        interns: $tmpl.state.interns,
                                        decls: $tmpl.state.decls ~ "\tconst char* " ~ $out ~ " = NULL;\n",
                                        body: $tmpl.state.body ~
                                            "\t" ~ $out ~ " = guji_regex_replace_engine(" ~ $subject.tmp ~ ", \"" ~
                                                g2_c_escape($pattern) ~ "\", " ~ c_int($nsubs) ~ ", " ~ $tmpl.tmp ~ ", " ~ $names_c ~ ");\n" ~
                                            "\tguji_release(" ~ $tmpl.tmp ~ ");\n" ~
                                            "\tguji_release(" ~ $subject.tmp ~ ");\n",
                                        nstr: $tmpl.state.nstr,
                                        ntmp: $tmpl.state.ntmp + 1
                                    ),
                                    tmp: $out
                                ))
                            }
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_replace_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $callee {
        EName($name) {
            if $name == "replace" {
                match cg_env_lookup_sub($env, $name) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($regex, ExprCons($template, ExprNil))) { g6_replace_core($recv, $regex, $template, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "replace" {
                match $args {
                    ExprCons($regex, ExprCons($template, ExprNil)) { g6_replace_core($recv, $regex, $template, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# §13 replace_with: replace every non-overlapping regex match with the Str
# returned by a Match callback.  This deliberately lives beside the other regex
# lowerings rather than in the generic string-prelude code: the callback borrows
# a fresh guji_match_t for exactly one loop iteration, and its result must be
# owned before that match object is released.
sub g6_replace_with_callback($callback: Expr, $match_c: Str, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $callback {
        ELambda($params, $ret, $body, $topic) {
            match g7_lambda_body_expr($body) {
                Err($m) { Err($m) }
                Ok($expr) {
                    match g7_lambda_env($params, CgMatch, $match_c, $env) {
                        Err($m) { Err($m) }
                        Ok($lenv) { g3_str_lower($expr, $state, $lenv) }
                    }
                }
            }
        }
        _ {
            # The synthetic name is present only in the temporary callback
            # environment.  Routing through the ordinary call lowerers admits
            # both a declared `sub($m: Match): Str` and a bound Match->Str
            # function value, while preserving their normal signature checks.
            $mname = '$__replace_match'
            $lenv = CgEnvCons(CgVar(name: $mname, cname: $match_c, kind: CgMatch, mutable: false, borrowed: true, listlen: 0), $env)
            match g5_call_value(RStr, $callback, ExprCons(EName($mname), ExprNil), $state, $lenv) {
                Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                Err($m) {
                    match g5_fn_call_value(CgStr, $callback, ExprCons(EName($mname), ExprNil), $state, $lenv) {
                        Err($fm) { Err($m) }
                        Ok($v) { Ok(StrLower(state: $v.state, tmp: $v.c)) }
                    }
                }
            }
        }
    }
}

sub g6_replace_with_lowered($subject: StrLower, $pattern: Str, $callback: Expr, $po: RegexPartsOut, $env: CgEnv): Result[StrLower, Str] {
                    $names = g6_regex_cap_names_host($pattern)
                    $nsubs = g6_strlist_len($names)
                    $names_c = g6_cap_names_c_expr($names)
                    $n = $po.state.ntmp
                    $out = "gt" ~ c_int($n)
                    $prog = "gprog" ~ c_int($n + 1)
                    $pos = "gpos" ~ c_int($n + 2)
                    $slen = "gslen" ~ c_int($n + 3)
                    $prev = "gpre" ~ c_int($n + 4)
                    $last = "glast" ~ c_int($n + 5)
                    $cap = "gcap" ~ c_int($n + 6)
                    $len = "glen" ~ c_int($n + 7)
                    $match_c = "gmt" ~ c_int($n + 8)
                    $accept = "gacc" ~ c_int($n + 9)
                    $start = "gstart" ~ c_int($n + 10)
                    $end = "gend" ~ c_int($n + 11)
                    $loop_state = CgState(
                        interns: $po.state.interns,
                        decls: $po.state.decls ~
                            "\tchar* " ~ $out ~ " = NULL;\n" ~
                            "\tguji_regex_program_t* " ~ $prog ~ " = NULL;\n" ~
                            "\tint32_t " ~ $pos ~ " = 0;\n" ~
                            "\tint32_t " ~ $slen ~ " = 0;\n" ~
                            "\tint32_t " ~ $prev ~ " = -1;\n" ~
                            "\tint32_t " ~ $last ~ " = 0;\n" ~
                            "\tsize_t " ~ $cap ~ " = 0;\n" ~
                            "\tsize_t " ~ $len ~ " = 0;\n" ~
                            "\tguji_match_t* " ~ $match_c ~ " = NULL;\n" ~
                            "\tint " ~ $accept ~ " = 1;\n" ~
                            "\tint32_t " ~ $start ~ " = 0;\n" ~
                            "\tint32_t " ~ $end ~ " = 0;\n",
                        body: "",
                        nstr: $po.state.nstr,
                        ntmp: $n + 12
                    )
                    match g6_replace_with_callback($callback, $match_c, $loop_state, $env) {
                        Err($m) { Err($m) }
                        Ok($replacement) {
                            $compile = if $po.count == 0 { "guji_regex_compile(" ~ $po.parts ~ ")" } else { "guji_regex_compile_spliced(" ~ $po.parts ~ ", " ~ c_int($po.count) ~ ")" }
                            $setup = "\t\{ guji_regex_compile_result_t cr = " ~ $compile ~ "; if (!cr.ok) \{ guji_regex_compile_fail(\"1:1\", &cr); } " ~ $prog ~ " = cr.prog; }\n" ~
                                $po.release ~
                                "\t" ~ $slen ~ " = (int32_t)strlen(" ~ $subject.tmp ~ ");\n" ~
                                "\t" ~ $cap ~ " = (size_t)" ~ $slen ~ " + 1;\n" ~
                                "\t" ~ $out ~ " = (char*)guji_alloc(GUJI_KIND_STR, 0, " ~ $cap ~ ");\n" ~
                                "\t" ~ $out ~ "[0] = '\\0';\n" ~
                                "\twhile (" ~ $pos ~ " <= " ~ $slen ~ ") \{\n" ~
                                "\t\tguji_regex_match_t m = guji_regex_find(" ~ $prog ~ ", " ~ $subject.tmp ~ ", " ~ $pos ~ ");\n" ~
                                "\t\tif (!m.matched) \{ break; }\n" ~
                                "\t\t" ~ $start ~ " = m.spans[0][0];\n" ~
                                "\t\t" ~ $end ~ " = m.spans[0][1];\n" ~
                                "\t\t" ~ $accept ~ " = 1;\n" ~
                                "\t\tif (" ~ $start ~ " == " ~ $pos ~ " && " ~ $end ~ " == " ~ $pos ~ ") \{\n" ~
                                "\t\t\tif (" ~ $start ~ " == " ~ $prev ~ ") \{ " ~ $accept ~ " = 0; }\n" ~
                                "\t\t\tif (" ~ $pos ~ " < " ~ $slen ~ ") \{ " ~ $pos ~ " = guji_regex_next_start(" ~ $subject.tmp ~ ", " ~ $slen ~ ", " ~ $pos ~ "); } else \{ " ~ $pos ~ " = " ~ $slen ~ " + 1; }\n" ~
                                "\t\t} else \{\n" ~
                                "\t\t\t" ~ $pos ~ " = " ~ $end ~ ";\n" ~
                                "\t\t}\n" ~
                                "\t\t" ~ $prev ~ " = " ~ $end ~ ";\n" ~
                                "\t\tif (!" ~ $accept ~ ") \{ continue; }\n" ~
                                "\t\t" ~ $out ~ " = guji_buf_append(" ~ $out ~ ", &" ~ $len ~ ", &" ~ $cap ~ ", " ~ $subject.tmp ~ " + " ~ $last ~ ", (size_t)(" ~ $start ~ " - " ~ $last ~ "));\n" ~
                                "\t\t" ~ $match_c ~ " = guji_match_from_regex_match(" ~ $subject.tmp ~ ", m, " ~ c_int($nsubs) ~ ", " ~ $names_c ~ ", " ~ $prog ~ "->public_cap_indexes);\n"
                            $tail = "\t\tguji_release(" ~ $match_c ~ ");\n" ~
                                "\t\t" ~ $match_c ~ " = NULL;\n" ~
                                "\t\t" ~ $out ~ " = guji_buf_append(" ~ $out ~ ", &" ~ $len ~ ", &" ~ $cap ~ ", " ~ $replacement.tmp ~ ", strlen(" ~ $replacement.tmp ~ "));\n" ~
                                "\t\tguji_release(" ~ $replacement.tmp ~ ");\n" ~
                                "\t\t" ~ $last ~ " = " ~ $end ~ ";\n" ~
                                "\t}\n" ~
                                "\t" ~ $out ~ " = guji_buf_append(" ~ $out ~ ", &" ~ $len ~ ", &" ~ $cap ~ ", " ~ $subject.tmp ~ " + " ~ $last ~ ", (size_t)(" ~ $slen ~ " - " ~ $last ~ "));\n" ~
                                "\tGUJI_HDR(" ~ $out ~ ")->count = (int64_t)" ~ $len ~ ";\n" ~
                                "\tguji_regex_program_free(" ~ $prog ~ ");\n" ~
                                "\tguji_release(" ~ $subject.tmp ~ ");\n"
                            Ok(StrLower(
                                state: CgState(
                                    interns: $replacement.state.interns,
                                    decls: $replacement.state.decls,
                                    body: $po.state.body ~ $setup ~ $replacement.state.body ~ $tail,
                                    nstr: $replacement.state.nstr,
                                    ntmp: $replacement.state.ntmp
                                ),
                                tmp: $out
                            ))
                        }
                    }
}

sub g6_replace_with_core($recv: Expr, $regex: Expr, $callback: Expr, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $regex {
        ERegex($pattern, $rline, $rcol) {
            match g3_str_lower($recv, $state, $env) {
                Err($m) { Err($m) }
                Ok($subject) {
                    if g6_regex_pattern_has_splice($pattern) {
                        match g6_regex_parse_parts($pattern) {
                            Err($m) { Err($m) }
                            Ok($parts) {
                                match g6_regex_emit_parts($parts, $subject.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($po) { g6_replace_with_lowered($subject, $pattern, $callback, $po, $env) }
                                }
                            }
                        }
                    } else {
                        $po = RegexPartsOut(state: $subject.state, parts: "\"" ~ g2_c_escape($pattern) ~ "\"", count: 0, release: "")
                        g6_replace_with_lowered($subject, $pattern, $callback, $po, $env)
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Resolve the data-first and method spellings. Function form defers to a user
# sub of the same name; method form is prelude syntax, matching the other
# receiver-first text helpers.
sub g6_replace_with_value($callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[StrLower, Str] {
    match $callee {
        EName($name) {
            if $name == "replace_with" {
                match cg_env_lookup_sub($env, $name) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, ExprCons($regex, ExprCons($callback, ExprNil))) { g6_replace_with_core($recv, $regex, $callback, $state, $env) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EField($recv, $method) {
            if $method == "replace_with" {
                match $args {
                    ExprCons($regex, ExprCons($callback, ExprNil)) { g6_replace_with_core($recv, $regex, $callback, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower `$s ~~ /pat/` to an owned guji_opt_match carrier (native shape).
# Spliced literals emit greparts[] + guji_regex_match_parts_engine (P6e).
sub g6_regex_match_op_value($left: Expr, $right: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $right {
        ERegex($pattern, $line, $col) {
            match g3_str_lower($left, $state, $env) {
                Err($m) { Err($m) }
                Ok($sl) {
                    $names = g6_regex_cap_names_host($pattern)
                    $nsubs = g6_strlist_len($names)
                    $names_c = g6_cap_names_c_expr($names)
                    $loc = c_int($line) ~ ":" ~ c_int($col)
                    if g6_regex_pattern_has_splice($pattern) {
                        match g6_regex_parse_parts($pattern) {
                            Err($m) { Err($m) }
                            Ok($parts) {
                                match g6_regex_emit_parts($parts, $sl.state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($po) {
                                        $mi = c_int($po.state.ntmp)
                                        $oi = c_int($po.state.ntmp + 1)
                                        $mt = "gmt" ~ $mi
                                        $ot = "go" ~ $oi
                                        $body = $po.state.body ~
                                            "\t" ~ $mt ~ " = guji_regex_match_parts_engine(\"" ~ $loc ~ "\", " ~ $po.parts ~ ", " ~ c_int($po.count) ~ ", " ~ $sl.tmp ~ ", " ~ c_int($nsubs) ~ ", " ~ $names_c ~ ");\n" ~
                                            "\tif (" ~ $mt ~ " != NULL) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = " ~ $mt ~ "; } else \{ " ~ $ot ~ ".tag = 0; " ~ $ot ~ ".val = NULL; }\n" ~
                                            "\tguji_release(" ~ $sl.tmp ~ ");\n" ~
                                            $po.release
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $po.state.interns,
                                                decls: $po.state.decls ~
                                                    "\tguji_match_t* " ~ $mt ~ " = NULL;\n" ~
                                                    "\tguji_opt_match " ~ $ot ~ " = \{0};\n",
                                                body: $body,
                                                nstr: $po.state.nstr,
                                                ntmp: $po.state.ntmp + 2
                                            ),
                                            c: $ot
                                        ))
                                    }
                                }
                            }
                        }
                    } else {
                        $pat = g2_c_escape($pattern)
                        $mi = c_int($sl.state.ntmp)
                        $oi = c_int($sl.state.ntmp + 1)
                        $mt = "gmt" ~ $mi
                        $ot = "go" ~ $oi
                        $body = $sl.state.body ~
                            "\t" ~ $mt ~ " = guji_regex_match_pattern_engine(\"" ~ $pat ~ "\", " ~ $sl.tmp ~ ", " ~ c_int($nsubs) ~ ", " ~ $names_c ~ ");\n" ~
                            "\tif (" ~ $mt ~ " != NULL) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = " ~ $mt ~ "; } else \{ " ~ $ot ~ ".tag = 0; " ~ $ot ~ ".val = NULL; }\n" ~
                            "\tguji_release(" ~ $sl.tmp ~ ");\n"
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $sl.state.interns,
                                decls: $sl.state.decls ~
                                    "\tguji_match_t* " ~ $mt ~ " = NULL;\n" ~
                                    "\tguji_opt_match " ~ $ot ~ " = \{0};\n",
                                body: $body,
                                nstr: $sl.state.nstr,
                                ntmp: $sl.state.ntmp + 2
                            ),
                            c: $ot
                        ))
                    }
                }
            }
        }
        # §13 Regex VALUE on the RHS (bound name, param, Regex.literal /
        # Regex.compile result, if/match value…): native calls
        # `guji_regex_match_value_engine(pattern, subject)` — the runtime
        # recompiles the validated pattern text and the resulting guji_match_t
        # carries group_count/groups itself, so the existing accessors need no
        # compile-time pattern. Both operands are owned Str temps released right
        # after the call (the match object deep-copies text and groups); subject
        # first, regex second — source order, matching native.
        _ {
            match g3_str_lower($left, $state, $env) {
                Err($m) { Err($m) }
                Ok($sl) {
                    match g3_str_lower($right, $sl.state, $env) {
                        Err($m) { Err($m) }
                        Ok($rv) {
                            $mi = c_int($rv.state.ntmp)
                            $oi = c_int($rv.state.ntmp + 1)
                            $mt = "gmt" ~ $mi
                            $ot = "go" ~ $oi
                            $body = $rv.state.body ~
                                "\t" ~ $mt ~ " = guji_regex_match_value_engine(" ~ $rv.tmp ~ ", " ~ $sl.tmp ~ ");\n" ~
                                "\tif (" ~ $mt ~ " != NULL) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = " ~ $mt ~ "; } else \{ " ~ $ot ~ ".tag = 0; " ~ $ot ~ ".val = NULL; }\n" ~
                                "\tguji_release(" ~ $rv.tmp ~ ");\n" ~
                                "\tguji_release(" ~ $sl.tmp ~ ");\n"
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $rv.state.interns,
                                    decls: $rv.state.decls ~
                                        "\tguji_match_t* " ~ $mt ~ " = NULL;\n" ~
                                        "\tguji_opt_match " ~ $ot ~ " = \{0};\n",
                                    body: $body,
                                    nstr: $rv.state.nstr,
                                    ntmp: $rv.state.ntmp + 2
                                ),
                                c: $ot
                            ))
                        }
                    }
                }
            }
        }
    }
}

# Lower a Match value: bound name (borrowed alias — no retain; owner keeps +1).
sub g6_match_value($value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgMatch { Ok(CgValueOut(state: $state, c: $v.cname)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# ---- P8d-1/P8d-2a/P8d-2b/P8d-2c-3c: channel builder + operations ---------
# Mirror native scalar + Str + List/Map + scalar-enum channel lowering: guji_chan_new /
# send / recv / close + guji_chan_release at scope exit. Heap values use
# copy-on-send and guji_chan_drop_{str,list,map} for undelivered/rejected copies.
# Scalar Option carrier elements are also admitted by value; counted carrier/
# enum payloads remain later P8d-2c-3c chunks. Hatch/select remain P8e/P8f.

sub g11_chan_closed_res(): CgKind { CgRes(CgUnit, CgClosed) }

# Scalar/String leaves shared by recursively supported channel collection
# payloads.
sub g11_chan_flat_elem($el: CgKind): Bool {
    match $el {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        _ { false }
    }
}

# Channel List/Map storage is KIND-tagged at each row. Copy, drop, send detach,
# receive adoption, and channel teardown therefore compose at arbitrary nesting
# depth for supported scalar/String leaves.
sub g11_chan_collection_elem_supported($el: CgKind): Bool {
    match $el {
        CgList($inner) { g11_chan_collection_elem_supported($inner) }
        CgMap($value) { g11_chan_collection_elem_supported($value) }
        _ { g11_chan_flat_elem($el) }
    }
}

# Counted user-enum channel boundary: every payload field is scalar, Str, a
# nested List/Map graph the enum layout itself admits
# (g6e_enum_collection_elem_supported — KIND-tagged rows cascade through
# guji_copy_arr / guji_release, matching native enumHatchCopyable nested
# families), or a recursive SELF-box (CgBoxEnum — send deep-clones via
# guji_clone_<E>_value/_box). Nested BY-VALUE (non-self) enum fields remain a
# native REJECT ("enum payloads containing enum boxes over a channel are not
# implemented"). Class payloads and carrier fields are later chunks.
sub g11_chan_enum_field_supported($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgList($el) { g6e_enum_collection_elem_supported($el) }
        CgMap($v) { g6e_enum_collection_elem_supported($v) }
        CgBoxEnum($n) { true }
        _ { false }
    }
}

sub g11_chan_enum_fields_one_supported($fs: CgKindList): Bool {
    match $fs {
        CgKindNil { true }
        CgKindCons($h, $t) {
            if g11_chan_enum_field_supported($h) {
                g11_chan_enum_fields_one_supported($t)
            } else {
                false
            }
        }
    }
}

sub g11_chan_enum_fields_supported($vs: CgVariantInfoList): Bool {
    match $vs {
        CgVarNil { true }
        CgVarCons($h, $t) {
            if g11_chan_enum_fields_one_supported($h.fields) {
                g11_chan_enum_fields_supported($t)
            } else {
                false
            }
        }
    }
}

# Option channel elements: scalar payloads (by-value slots, NULL drop) plus
# counted Option[Str], Option[List[recursive]], Option[Map[Str,recursive]],
# Option[Match], and Option[Bush] payloads (deep-copied on send via
# guji_match_copy / guji_bush_copy / guji_copy_arr; dropped through
# carrier-specific hooks). Result elements use the same recursive collection
# predicate through g11_chan_result_elem_supported.
sub g11_chan_option_elem_supported($el: CgKind): Bool {
    match $el {
        CgOptInt { true }
        CgOptBool { true }
        CgOptFloat { true }
        CgOptStr { true }
        CgOptMatch { true }
        CgOptBush { true }
        CgOptList($inner) { g11_chan_carrier_list_elem_supported($inner) }
        CgOptMap($v) { g11_chan_map_val_supported($v) }
        _ { false }
    }
}

# Result channel Ok/Err slots: scalar|Str, counted Match/Bush pointers, and
# recursively supported List/Map graphs.
sub g11_chan_result_slot_ok($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgMatch { true }
        CgBush { true }
        CgList($inner) { g11_chan_carrier_list_elem_supported($inner) }
        CgMap($v) { g11_chan_result_map_val_ok($v) }
        _ { false }
    }
}

sub g11_chan_result_elem_supported($el: CgKind): Bool {
    match $el {
        CgRes($ok, $err) { g11_chan_result_slot_ok($ok) && g11_chan_result_slot_ok($err) }
        _ { false }
    }
}

# Chan[List[T]] payload elements use the inner-agnostic guji_slice_t ABI.
# KIND-tagged guji_copy_arr send detach and cascading release recurse through
# List/Map row storage.
sub g11_chan_list_elem_supported($el: CgKind): Bool {
    g11_chan_collection_elem_supported($el)
}

# Option/Result List payload inners use the same recursively tagged storage.
sub g11_chan_carrier_list_elem_supported($el: CgKind): Bool {
    g11_chan_collection_elem_supported($el)
}

# Result[Map[Str, V], E] values use the same recursively tagged storage.
sub g11_chan_result_map_val_ok($val: CgKind): Bool {
    g11_chan_collection_elem_supported($val)
}

# Map[Str, V] channel values use the same two-array guji_map_t ABI at every
# depth; guji_chan_drop_map and guji_copy_arr recurse via runtime KIND tags.
sub g11_chan_map_val_supported($val: CgKind): Bool {
    g11_chan_collection_elem_supported($val)
}

sub g11_chan_elem_supported($el: CgKind): Bool {
    match $el {
        CgUnit { true }
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgList($inner) { g11_chan_list_elem_supported($inner) }
        CgMap($val) { g11_chan_map_val_supported($val) }
        CgEnum($name) { true }
        CgOptInt { true }
        CgOptBool { true }
        CgOptFloat { true }
        CgOptStr { true }
        CgOptMatch { true }
        CgOptBush { true }
        CgOptList($inner) { g11_chan_carrier_list_elem_supported($inner) }
        CgOptMap($v) { g11_chan_map_val_supported($v) }
        CgRes($ok, $err) { g11_chan_result_elem_supported(CgRes($ok, $err)) }
        CgFn($p, $r) { true }
        _ { false }
    }
}

sub g11_chan_elem_sizeof($el: CgKind): Str {
    match $el {
        CgUnit { "sizeof(int64_t)" }
        CgInt { "sizeof(int64_t)" }
        CgBool { "sizeof(int64_t)" }
        CgFloat { "sizeof(double)" }
        CgStr { "sizeof(const char*)" }
        CgList($inner) { "sizeof(guji_slice_t)" }
        CgMap($val) { "sizeof(guji_map_t)" }
        CgEnum($name) { "sizeof(" ~ $name ~ ")" }
        CgOptCarrier($inner) { "sizeof(" ~ g6_option_ctype(CgOptCarrier($inner)) ~ ")" }
        CgOptInt { "sizeof(guji_opt_int)" }
        CgOptBool { "sizeof(guji_opt_bool)" }
        CgOptFloat { "sizeof(guji_opt_float)" }
        CgOptStr { "sizeof(guji_opt_str)" }
        CgOptMatch { "sizeof(guji_opt_match)" }
        CgOptBush { "sizeof(guji_opt_bush)" }
        CgOptList($inner) { "sizeof(guji_opt_list)" }
        CgOptMap($v) { "sizeof(guji_opt_map)" }
        CgRes($ok, $err) { "sizeof(" ~ g6_result_ctype(CgRes($ok, $err)) ~ ")" }
        CgFn($p, $r) { "sizeof(guji_fn_t)" }
        _ { "sizeof(int64_t)" }
    }
}

# Non-owning scalars pass NULL; Str/List/Map need the prologue drop that releases
# one detached copy (undelivered buffer slot or send-on-closed reject). An
# Option[Str] element owns its detached Some payload, so it gets the emitted
# carrier drop (see g6_option_typedefs). Result elements with a Str arm use the
# emitted guji_chan_drop_res_* from g6_result_typedefs.
sub g11_chan_elem_drop($el: CgKind, $env: CgEnv): Str {
    match $el {
        CgStr { "guji_chan_drop_str" }
        CgList($inner) { "guji_chan_drop_list" }
        CgMap($val) { "guji_chan_drop_map" }
        CgEnum($name) {
            match cg_env_lookup_enum($env, $name) {
                Some($info) {
                    if g6e_enum_has_heap($info) { "guji_chan_drop_" ~ $name } else { "NULL" }
                }
                None { "NULL" }
            }
        }
        CgOptStr { "guji_chan_drop_opt_str" }
        CgOptMatch { "guji_chan_drop_opt_match" }
        CgOptBush { "guji_chan_drop_opt_bush" }
        CgOptList($inner) { "guji_chan_drop_opt_list" }
        CgOptMap($v) { "guji_chan_drop_opt_map" }
        CgRes($ok, $err) {
            if g6_result_slot_owns($ok) || g6_result_slot_owns($err) {
                "guji_chan_drop_res_" ~ g6_result_kindword($ok) ~ "_" ~ g6_result_kindword($err)
            } else {
                "NULL"
            }
        }
        CgFn($p, $r) { "guji_chan_drop_fn" }
        _ { "NULL" }
    }
}

sub g11_chan_opt_kind($el: CgKind): Result[CgKind, Str] {
    match $el {
        CgUnit { Ok(CgOptCarrier(CgUnit)) }
        CgInt { Ok(CgOptInt) }
        CgBool { Ok(CgOptBool) }
        CgFloat { Ok(CgOptFloat) }
        CgStr { Ok(CgOptStr) }
        CgList($inner) { Ok(CgOptList($inner)) }
        CgMap($val) { Ok(CgOptMap($val)) }
        CgEnum($name) { Ok(CgOptEnum($name)) }
        CgOptInt { Ok(CgOptCarrier(CgOptInt)) }
        CgOptBool { Ok(CgOptCarrier(CgOptBool)) }
        CgOptFloat { Ok(CgOptCarrier(CgOptFloat)) }
        CgOptStr { Ok(CgOptCarrier(CgOptStr)) }
        CgOptMatch { Ok(CgOptCarrier(CgOptMatch)) }
        CgOptBush { Ok(CgOptCarrier(CgOptBush)) }
        CgOptList($inner) { Ok(CgOptCarrier(CgOptList($inner))) }
        CgOptMap($v) { Ok(CgOptCarrier(CgOptMap($v))) }
        CgRes($ok, $err) { Ok(CgOptCarrier(CgRes($ok, $err))) }
        CgFn($p, $r) { Ok(CgOptCarrier(CgFn($p, $r))) }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_chan_kind_from_type($ty: Option[TypeRef], $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        None { Err(g3_unsupported()) }
        Some($tr) {
            if $tr.name == "Chan" {
                match typelist_at($tr.args, 0) {
                    None { Err(g3_unsupported()) }
                    Some($elem) {
                        if $elem.name == "Unit" {
                            Ok(CgChan(CgUnit))
                        } else if $elem.name == "Int" {
                            Ok(CgChan(CgInt))
                        } else if $elem.name == "Bool" {
                            Ok(CgChan(CgBool))
                        } else if $elem.name == "Float" {
                            Ok(CgChan(CgFloat))
                        } else if $elem.name == "Str" {
                            Ok(CgChan(CgStr))
                        } else if $elem.name == "Func" {
                            match g5_func_kind_from_type_args($elem.args, $env) {
                                Ok($fk) { Ok(CgChan($fk)) }
                                Err($m) { Err($m) }
                            }
                        } else if $elem.name == "List" {
                            match g7_list_elem_kind_from_type(Some($elem)) {
                                Err($m) { Err($m) }
                                Ok($inner) {
                                    if g11_chan_list_elem_supported($inner) {
                                        Ok(CgChan(CgList($inner)))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        } else if $elem.name == "Map" {
                            match g7_map_val_kind_from_type(Some($elem)) {
                                Err($m) { Err($m) }
                                Ok($val) {
                                    if g11_chan_map_val_supported($val) {
                                        Ok(CgChan(CgMap($val)))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        } else if $elem.name == "Option" {
                            match g6_option_kind_from_type(Some($elem)) {
                                Err($m) { Err($m) }
                                Ok($okind) {
                                    if g11_chan_option_elem_supported($okind) {
                                        Ok(CgChan($okind))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        } else if $elem.name == "Result" {
                            match g6_result_kind_from_type(Some($elem), $env) {
                                Err($m) { Err($m) }
                                Ok($rkind) {
                                    if g11_chan_result_elem_supported($rkind) {
                                        Ok(CgChan($rkind))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                            }
                        } else {
                            # Scalar, Str, flat-collection, and recursive
                            # self-box enums share one flat struct slot.
                            # Heap fields use active-variant deep detach (or
                            # guji_clone_<E>_value for boxed graphs) + a
                            # per-enum drop hook.
                            match g6e_enum_kind_from_type(Some($elem), $env) {
                                Err($m) { Err($m) }
                                Ok($ek) {
                                    match $ek {
                                        CgEnum($name) {
                                            match cg_env_lookup_enum($env, $name) {
                                                Some($info) {
                                                    if g11_chan_enum_fields_supported($info.variants) {
                                                        Ok(CgChan(CgEnum($name)))
                                                    } else {
                                                        Err(g3_unsupported())
                                                    }
                                                }
                                                None { Err(g3_unsupported()) }
                                            }
                                        }
                                        _ { Err(g3_unsupported()) }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

# Unannotated channel binds infer the handle kind from a bound channel name
# (`$alias = $ch`) or from an RChan-returning user-sub call (`$ch = make_chan()`).
# A bare `channel()` builder still requires an annotation context.
sub g11_chan_kind_from_value($value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgChan($el) { Ok(CgChan($el)) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        ECall($callee, $args) {
            match g4_handle_unary_recv($callee, $args, "lines", $env) {
                Ok($recv) {
                    match g4_handle_recv($recv, CgState(interns: "", decls: "", body: "", nstr: 0, ntmp: 0), $env) {
                        Ok($hr) { Ok(CgChan(CgStr)) }
                        Err($m) { Err($m) }
                    }
                }
                Err($not_lines) {
                    match g5_resolve_call_target($callee, $args, $env) {
                        Err($m) { Err($m) }
                        Ok($target) {
                            match $target.sig.ret {
                                RChan($el) { Ok(CgChan($el)) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# An annotated `: Chan[T]` wins; only a missing annotation consults the RHS.
sub g11_chan_bind_kind($ty: Option[TypeRef], $value: Expr, $env: CgEnv): Result[CgKind, Str] {
    match $ty {
        Some($tr) { g11_chan_kind_from_type($ty, $env) }
        None { g11_chan_kind_from_value($value, $env) }
    }
}

sub g11_chan_recv_name($recv: Expr, $env: CgEnv): Result[CgVar, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgChan($el) {
                            if g11_chan_elem_supported($el) { Ok($v) } else { Err(g3_unsupported()) }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

class ChanOpParts {
    has $.ch: CgVar
    has $.method: Str
    has $.args: ExprList
}

sub g11_chan_method_parts($callee: Expr, $args: ExprList, $env: CgEnv): Result[ChanOpParts, Str] {
    match $callee {
        EField($recv, $method) {
            if $method == "send" || $method == "recv" || $method == "close" {
                match g11_chan_recv_name($recv, $env) {
                    Err($m) { Err($m) }
                    Ok($ch) { Ok(ChanOpParts(ch: $ch, method: $method, args: $args)) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EName($fn) {
            if $fn == "send" || $fn == "recv" || $fn == "close" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $args {
                            ExprCons($recv, $rest) {
                                match g11_chan_recv_name($recv, $env) {
                                    Err($m) { Err($m) }
                                    Ok($ch) { Ok(ChanOpParts(ch: $ch, method: $fn, args: $rest)) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_chan_builder_value($el: CgKind, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    if !g11_chan_elem_supported($el) {
        Err(g3_unsupported())
    } else {
        match $args {
            ExprNil {
                $tmp = g4_value_tmp(CgChan($el), $state.ntmp)
                Ok(CgValueOut(
                    state: CgState(
                        interns: $state.interns,
                        decls: $state.decls ~ g4_value_decl(CgChan($el), $tmp),
                        body: $state.body ~ "\t" ~ $tmp ~ " = guji_chan_new(0LL, " ~ g11_chan_elem_sizeof($el) ~ ", " ~ g11_chan_elem_drop($el, $env) ~ ");\n",
                        nstr: $state.nstr,
                        ntmp: $state.ntmp + 1
                    ),
                    c: $tmp
                ))
            }
            ExprCons($cap, ExprNil) {
                match g4_lower_value(CgInt, $cap, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($cv) {
                        $tmp = g4_value_tmp(CgChan($el), $cv.state.ntmp)
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $cv.state.interns,
                                decls: $cv.state.decls ~ g4_value_decl(CgChan($el), $tmp),
                                body: $cv.state.body ~ "\t" ~ $tmp ~ " = guji_chan_new(" ~ $cv.c ~ ", " ~ g11_chan_elem_sizeof($el) ~ ", " ~ g11_chan_elem_drop($el, $env) ~ ");\n",
                                nstr: $cv.state.nstr,
                                ntmp: $cv.state.ntmp + 1
                            ),
                            c: $tmp
                        ))
                    }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    }
}

sub g11_chan_value($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $kind {
        CgChan($el) {
            match $value {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgChan($vel) {
                                    if cgkind_eq($el, $vel) {
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $state.interns,
                                                decls: $state.decls,
                                                body: $state.body,
                                                nstr: $state.nstr,
                                                ntmp: $state.ntmp
                                            ),
                                            c: "guji_chan_retain(" ~ $v.cname ~ ")"
                                        ))
                                    } else {
                                        Err(g3_unsupported())
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                ECall($callee, $args) {
                    match g4_handle_lines_value($el, $callee, $args, $state, $env) {
                        Ok($lv) { Ok($lv) }
                        Err($not_lines) {
                            match $callee {
                                EName($fn) {
                                    if $fn == "channel" {
                                        g11_chan_builder_value($el, $args, $state, $env)
                                    } else {
                                        g5_call_value(RChan($el), $callee, $args, $state, $env)
                                    }
                                }
                                _ { g5_call_value(RChan($el), $callee, $args, $state, $env) }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Owned Chan rvalue for RETURN position and fresh `for` iterators. Bound names
# retain into a fresh temp as a STATEMENT before scope-exit cleanup (native
# emitOwnedReturn); inlining `guji_chan_retain(gv)` into the C `return` after
# cleanup is a use-after-free. Fresh `channel()` builders, `Handle.lines()`
# (`guji_reader_lines`, native materializeForChanIter's §15.4 case), and
# RChan-returning calls TRANSFER their +1.
sub g11_chan_owned_value($el: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgChan($vel) {
                            if cgkind_eq($el, $vel) {
                                $tmp = g4_value_tmp(CgChan($el), $state.ntmp)
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $state.interns,
                                        decls: $state.decls ~ g4_value_decl(CgChan($el), $tmp),
                                        body: $state.body ~
                                            "\t" ~ $tmp ~ " = " ~ $v.cname ~ ";\n" ~
                                            "\tguji_chan_retain(" ~ $tmp ~ ");\n",
                                        nstr: $state.nstr,
                                        ntmp: $state.ntmp + 1
                                    ),
                                    c: $tmp
                                ))
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        ECall($c, $a) {
            match g4_handle_lines_value($el, $c, $a, $state, $env) {
                Ok($lv) { Ok($lv) }
                Err($not_lines) {
                    match $c {
                        EName($fn) {
                            if $fn == "channel" {
                                g11_chan_builder_value($el, $a, $state, $env)
                            } else {
                                g5_call_value(RChan($el), $c, $a, $state, $env)
                            }
                        }
                        _ { g5_call_value(RChan($el), $c, $a, $state, $env) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Return-position value lowering: Chan uses the owned-return discipline; every
# other kind reuses the ordinary value path (bind/arg retain shapes stay there).
sub g4_lower_ret_value($retkind: CgRet, $kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $retkind {
        RChan($el) { g11_chan_owned_value($el, $value, $state, $env) }
        RFn($p, $r) {
            # P9-10b-3b-2b: returning a BOUND fn value (e.g. a bare-`Func`
            # parameter) materializes the pair into a temp and retains the shared
            # env — the sub hands the caller an OWNED +1 while the frame's own
            # scope-exit release proceeds normally (native's exact shape).
            match $value {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        Some($v) {
                            if cgkind_eq($v.kind, CgFn($p, $r)) {
                                $tmp = g4_value_tmp(CgFn($p, $r), $state.ntmp)
                                Ok(CgValueOut(
                                    state: CgState(
                                        interns: $state.interns,
                                        decls: $state.decls ~ g4_value_decl(CgFn($p, $r), $tmp),
                                        body: $state.body ~ "\t" ~ $tmp ~ " = " ~ $v.cname ~ ";\n\tguji_retain(" ~ $tmp ~ ".env);\n",
                                        nstr: $state.nstr,
                                        ntmp: $state.ntmp + 1
                                    ),
                                    c: $tmp
                                ))
                            } else {
                                g4_lower_value($kind, $value, $state, $env)
                            }
                        }
                        None { g4_lower_value($kind, $value, $state, $env) }
                    }
                }
                _ { g4_lower_value($kind, $value, $state, $env) }
            }
        }
        _ { g4_lower_value($kind, $value, $state, $env) }
    }
}

sub g11_chan_close_value($ch: CgVar, $state: CgState): Result[CgValueOut, Str] {
    $rkind = g11_chan_closed_res()
    $tmp = g4_value_tmp($rkind, $state.ntmp)
    Ok(CgValueOut(
        state: CgState(
            interns: $state.interns,
            decls: $state.decls ~ g4_value_decl($rkind, $tmp),
            body: $state.body ~ "\t" ~ $tmp ~ ".tag = guji_chan_close(" ~ $ch.cname ~ ") ? 0 : 1;\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        ),
        c: $tmp
    ))
}

# Detach every active heap payload of a flat enum message. Field access goes
# through the shared enum-layout accessor so homogeneous and mixed union slots
# use the same `.fN` / `.fN.s` / `.fN.l` / `.fN.m` representation as
# constructors and matches. Str fields detach via guji_str_copy; List/Map
# fields deep-detach their counted storage via KIND-tagged guji_copy_arr (the
# struct copy already carried `.len`, so only the storage pointers are
# replaced — Map detaches BOTH paired arrays). Native inlines per-element copy
# loops here (hatchCopyEnum); guji_copy_arr performs the same recursive detach.
sub g11_chan_enum_copy_one_fields($allvars: CgVariantInfoList, $fields: CgKindList, $idx: Int, $msg: Str, $src: Str): Str {
    match $fields {
        CgKindNil { "" }
        CgKindCons($fk, $rest) {
            $one = match $fk {
                CgStr {
                    $dst = g6e_field_accessor($allvars, $msg, $idx, CgStr)
                    $from = g6e_field_accessor($allvars, $src, $idx, CgStr)
                    "\t\t" ~ $dst ~ " = guji_str_copy(" ~ $from ~ ");\n"
                }
                CgList($el) {
                    $dst = g6e_field_accessor($allvars, $msg, $idx, CgList($el))
                    $from = g6e_field_accessor($allvars, $src, $idx, CgList($el))
                    "\t\t" ~ $dst ~ ".data = guji_copy_arr((const void*)" ~ $from ~ ".data);\n"
                }
                CgMap($v) {
                    $dst = g6e_field_accessor($allvars, $msg, $idx, CgMap($v))
                    $from = g6e_field_accessor($allvars, $src, $idx, CgMap($v))
                    "\t\t" ~ $dst ~ ".keys = (const char**)guji_copy_arr((const void*)" ~ $from ~ ".keys);\n" ~
                    "\t\t" ~ $dst ~ ".vals = guji_copy_arr((const void*)" ~ $from ~ ".vals);\n"
                }
                _ { "" }
            }
            $one ~ g11_chan_enum_copy_one_fields($allvars, $rest, $idx + 1, $msg, $src)
        }
    }
}

sub g11_chan_enum_copy_cases($allvars: CgVariantInfoList, $todo: CgVariantInfoList, $tag: Int, $msg: Str, $src: Str): Str {
    match $todo {
        CgVarNil { "" }
        CgVarCons($v, $rest) {
            "\tcase " ~ c_int($tag) ~ "LL: \{\n" ~
            g11_chan_enum_copy_one_fields($allvars, $v.fields, 0, $msg, $src) ~
            "\t\tbreak;\n\t}\n" ~
            g11_chan_enum_copy_cases($allvars, $rest, $tag + 1, $msg, $src)
        }
    }
}

sub g11_chan_enum_copy_fields($info: CgEnumInfo, $msg: Str, $src: Str): Str {
    "\tswitch (" ~ $src ~ ".tag) \{\n" ~
    g11_chan_enum_copy_cases($info.variants, $info.variants, 0, $msg, $src) ~
    "\t}\n"
}

sub g11_chan_send_fill($el: CgKind, $msg: Str, $src: Str, $env: CgEnv): Str {
    match $el {
        # §17 copy-on-send: channel owns a detached Str; guji_chan_send consumes
        # the copy on every outcome (delivered or Err(Closed) via elem_drop).
        CgStr { "\t" ~ $msg ~ " = guji_str_copy(" ~ $src ~ ");\n" }
        # List: deep-copy the already-owned lowered slice via KIND-tagged
        # guji_copy_arr (Str elements get guji_str_copy; scalars copy by value).
        # Mirror of native hatchCopyList for heap-backed guji_slice_t sources.
        CgList($inner) {
            "\t" ~ $msg ~ ".len = " ~ $src ~ ".len;\n" ~
            "\t" ~ $msg ~ ".data = guji_copy_arr((const void*)" ~ $src ~ ".data);\n"
        }
        # Map: detach both counted arrays. guji_copy_arr recursively copies every
        # Str key/value, so the receiver shares no sender-task heap pointers.
        CgMap($val) {
            "\t" ~ $msg ~ ".len = " ~ $src ~ ".len;\n" ~
            "\t" ~ $msg ~ ".keys = (const char**)guji_copy_arr((const void*)" ~ $src ~ ".keys);\n" ~
            "\t" ~ $msg ~ ".vals = guji_copy_arr((const void*)" ~ $src ~ ".vals);\n"
        }
        # Counted enums: recursive self-box graphs deep-clone through the
        # generated guji_clone_<E>_value helper (fresh RC boxes + Str/List/Map
        # detach inside every node). Flat Str/List/Map enums still struct-copy
        # then overwrite active heap slots in place.
        CgEnum($name) {
            match cg_env_lookup_enum($env, $name) {
                Some($info) {
                    if g6e_variants_have_box($info.variants) {
                        "\t" ~ $msg ~ " = guji_clone_" ~ $name ~ "_value(&" ~ $src ~ ");\n"
                    } else if g6e_enum_has_heap($info) {
                        "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~ g11_chan_enum_copy_fields($info, $msg, $src)
                    } else {
                        "\t" ~ $msg ~ " = " ~ $src ~ ";\n"
                    }
                }
                None { "\t" ~ $msg ~ " = " ~ $src ~ ";\n" }
            }
        }
        # Option[Str]: copy the carrier struct, then detach the Some payload so
        # the channel owns an independent buffer (native: struct copy +
        # conditional guji_str_copy).
        CgOptStr {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~ $msg ~ ".val = guji_str_copy(" ~ $src ~ ".val); }\n"
        }
        # Option[Match]: copy the carrier, then deep-detach the Some Match graph
        # (text + groups) so the channel owns an independent rc==1 tree.
        CgOptMatch {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~ $msg ~ ".val = guji_match_copy(" ~ $src ~ ".val); }\n"
        }
        # Option[Bush]: same counted-pointer shape as Match (guji_bush_copy).
        CgOptBush {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~ $msg ~ ".val = guji_bush_copy(" ~ $src ~ ".val); }\n"
        }
        # Option[List]: copy the carrier, then deep-detach the active slice
        # graph through its runtime KIND tags (native's hatchCopyList shape).
        CgOptList($inner) {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~
            $msg ~ ".val.len = " ~ $src ~ ".val.len; " ~
            $msg ~ ".val.data = guji_copy_arr((const void*)" ~ $src ~ ".val.data); }\n"
        }
        # Option[Map]: copy the carrier, then detach BOTH counted arrays of an
        # active payload; guji_copy_arr cascades through Str keys/values and
        # nested rows via runtime KIND tags (native's conditional pair copy).
        CgOptMap($mval) {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~
            $msg ~ ".val.len = " ~ $src ~ ".val.len; " ~
            $msg ~ ".val.keys = (const char**)guji_copy_arr((const void*)" ~ $src ~ ".val.keys); " ~
            $msg ~ ".val.vals = guji_copy_arr((const void*)" ~ $src ~ ".val.vals); }\n"
        }
        # Result[T,E]: struct-copy then detach every active Str arm (Ok tag==0,
        # Err tag!=0). Scalar arms need no deep copy (native's shape). Built as
        # one expression — no mutable `$fill` rebind (selfhost rejects that).
        CgRes($ok, $err) {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            g11_chan_result_send_copy_ok($ok, $msg, $src) ~
            g11_chan_result_send_copy_err($err, $msg, $src)
        }
        # Function code pointers are process-static, but closure environments
        # live on per-task non-atomic heaps.  The lambda-specific callback
        # recreates the exact capture layout as a detached rc==1 Env.
        CgFn($p, $r) {
            "\t" ~ $msg ~ " = " ~ $src ~ ";\n" ~
            "\t" ~ $msg ~ ".env = (" ~ $src ~ ".env != NULL && " ~ $src ~ ".copy_env != NULL) ? " ~
            $src ~ ".copy_env(" ~ $src ~ ".env) : NULL;\n"
        }
        _ { "\t" ~ $msg ~ " = " ~ $src ~ ";\n" }
    }
}

sub g11_chan_result_send_copy_ok($ok: CgKind, $msg: Str, $src: Str): Str {
    match $ok {
        CgStr {
            "\tif (" ~ $src ~ ".tag == 0LL) \{ " ~ $msg ~ ".ok = guji_str_copy(" ~ $src ~ ".ok); }\n"
        }
        CgMatch {
            "\tif (" ~ $src ~ ".tag == 0LL) \{ " ~ $msg ~ ".ok = guji_match_copy(" ~ $src ~ ".ok); }\n"
        }
        CgBush {
            "\tif (" ~ $src ~ ".tag == 0LL) \{ " ~ $msg ~ ".ok = guji_bush_copy(" ~ $src ~ ".ok); }\n"
        }
        CgList($el) {
            "\tif (" ~ $src ~ ".tag == 0LL) \{ " ~
            $msg ~ ".ok.len = " ~ $src ~ ".ok.len; " ~
            $msg ~ ".ok.data = guji_copy_arr((const void*)" ~ $src ~ ".ok.data); }\n"
        }
        CgMap($v) {
            "\tif (" ~ $src ~ ".tag == 0LL) \{ " ~
            $msg ~ ".ok.len = " ~ $src ~ ".ok.len; " ~
            $msg ~ ".ok.keys = (const char**)guji_copy_arr((const void*)" ~ $src ~ ".ok.keys); " ~
            $msg ~ ".ok.vals = guji_copy_arr((const void*)" ~ $src ~ ".ok.vals); }\n"
        }
        _ { "" }
    }
}

sub g11_chan_result_send_copy_err($err: CgKind, $msg: Str, $src: Str): Str {
    match $err {
        CgStr {
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~ $msg ~ ".err = guji_str_copy(" ~ $src ~ ".err); }\n"
        }
        CgMatch {
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~ $msg ~ ".err = guji_match_copy(" ~ $src ~ ".err); }\n"
        }
        CgBush {
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~ $msg ~ ".err = guji_bush_copy(" ~ $src ~ ".err); }\n"
        }
        CgList($el) {
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~
            $msg ~ ".err.len = " ~ $src ~ ".err.len; " ~
            $msg ~ ".err.data = guji_copy_arr((const void*)" ~ $src ~ ".err.data); }\n"
        }
        CgMap($v) {
            "\tif (" ~ $src ~ ".tag != 0LL) \{ " ~
            $msg ~ ".err.len = " ~ $src ~ ".err.len; " ~
            $msg ~ ".err.keys = (const char**)guji_copy_arr((const void*)" ~ $src ~ ".err.keys); " ~
            $msg ~ ".err.vals = guji_copy_arr((const void*)" ~ $src ~ ".err.vals); }\n"
        }
        _ { "" }
    }
}

# g4_lower_value(CgStr|CgList) hands send an owned temporary. The channel
# consumes its detached copy, while the sender must still release that original.
sub g11_chan_send_source_release($el: CgKind, $src: Str, $env: CgEnv, $fresh: Bool): Str {
    match $el {
        CgStr { "\tguji_release(" ~ $src ~ ");\n" }
        CgList($inner) { g7_slice_release($src) }
        CgMap($val) { g7_map_value_release($src) }
        # The lowered Option[Str] source owns a +1 on its Some payload (bound
        # names retain on read). Release WITHOUT NULLing: the source may be a
        # still-live local whose scope cleanup runs later.
        CgOptStr { g6_option_retain_or_release(CgOptStr, $src, "release") }
        CgOptMatch { g6_option_retain_or_release(CgOptMatch, $src, "release") }
        CgOptBush { g6_option_retain_or_release(CgOptBush, $src, "release") }
        CgOptList($inner) { g6_option_retain_or_release(CgOptList($inner), $src, "release") }
        CgOptMap($v) { g6_option_retain_or_release(CgOptMap($v), $src, "release") }
        CgRes($ok, $err) { g6_result_retain_or_release(CgRes($ok, $err), $src, "release") }
        CgEnum($name) {
            match cg_env_lookup_enum($env, $name) {
                Some($info) {
                    if g6e_enum_has_heap($info) { g6e_enum_release($name, $src) } else { "" }
                }
                None { "" }
            }
        }
        CgFn($p, $r) { if $fresh { "\tguji_release(" ~ $src ~ ".env);\n" } else { "" } }
        _ { "" }
    }
}

sub g11_chan_send_value($ch: CgVar, $el: CgKind, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $args {
        ExprCons($payload, ExprNil) {
            match g4_lower_value($el, $payload, $state, $env) {
                Err($m) { Err($m) }
                Ok($pv) {
                    $rkind = g11_chan_closed_res()
                    $msg = g4_value_tmp($el, $pv.state.ntmp)
                    $tmp = g4_value_tmp($rkind, $pv.state.ntmp + 1)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $pv.state.interns,
                            decls: $pv.state.decls ~ g4_value_decl($el, $msg) ~ g4_value_decl($rkind, $tmp),
                            body: $pv.state.body ~
                                g11_chan_send_fill($el, $msg, $pv.c, $env) ~
                                "\t" ~ $tmp ~ ".tag = guji_chan_send(" ~ $ch.cname ~ ", &" ~ $msg ~ ") ? 0 : 1;\n" ~
                                g11_chan_send_source_release($el, $pv.c, $env, g5_fn_init_fresh($payload)),
                            nstr: $pv.state.nstr,
                            ntmp: $pv.state.ntmp + 2
                        ),
                        c: $tmp
                    ))
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_chan_recv_fill($el: CgKind, $tmp: Str, $out: Str): Str {
    match $el {
        # Adopt the channel's detached copy (rc==1) into Option[Str]; None keeps
        # GUJI_EMPTY_STR so the carrier-Str release path stays a no-op.
        CgStr { "\t" ~ $tmp ~ ".val = (" ~ $tmp ~ ".tag != 0) ? " ~ $out ~ " : GUJI_EMPTY_STR;\n" }
        # Adopt the detached guji_slice_t into Option[List]; None keeps a zeroed
        # slice so option-list release is a no-op.
        CgList($inner) {
            "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; } else \{ " ~ $tmp ~ ".val = (guji_slice_t)\{0}; }\n"
        }
        # Adopt the detached pair of map arrays; None stays safely zeroed.
        CgMap($val) {
            "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; } else \{ " ~ $tmp ~ ".val = (guji_map_t)\{0}; }\n"
        }
        # Scalar-payload enum slots are plain by-value structs. None keeps a
        # fully zeroed inactive payload, matching native's Option[Enum] shape.
        CgEnum($name) {
            "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; } else \{ " ~ $tmp ~ ".val = (" ~ $name ~ ")\{0}; }\n"
        }
        CgOptCarrier($inner) {
            match $inner {
                CgRes($ok, $err) {
                    "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; } else \{ " ~
                    $tmp ~ ".val = (" ~ g6_result_ctype(CgRes($ok, $err)) ~ ")\{0}; }\n"
                }
                CgFn($p, $r) {
                    "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; } else \{ " ~
                    $tmp ~ ".val = (guji_fn_t)\{0}; }\n"
                }
                _ {
                    "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; } else \{ " ~
                    $tmp ~ ".val = (" ~ g6_option_ctype($inner) ~ ")\{0}; }\n"
                }
            }
        }
        _ { "\tif (" ~ $tmp ~ ".tag != 0) \{ " ~ $tmp ~ ".val = " ~ $out ~ "; }\n" }
    }
}

sub g11_chan_recv_value($ch: CgVar, $el: CgKind, $args: ExprList, $state: CgState): Result[CgValueOut, Str] {
    match $args {
        ExprNil {
            match g11_chan_opt_kind($el) {
                Err($m) { Err($m) }
                Ok($okind) {
                    $out = g4_value_tmp($el, $state.ntmp)
                    $tmp = g4_value_tmp($okind, $state.ntmp + 1)
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $state.interns,
                            decls: $state.decls ~ g4_value_decl($el, $out) ~ g4_value_decl($okind, $tmp),
                            body: $state.body ~
                                "\t" ~ $tmp ~ ".tag = guji_chan_recv(" ~ $ch.cname ~ ", &" ~ $out ~ ") ? 1 : 0;\n" ~
                                g11_chan_recv_fill($el, $tmp, $out),
                            nstr: $state.nstr,
                            ntmp: $state.ntmp + 2
                        ),
                        c: $tmp
                    ))
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_chan_op_value($kind: CgKind, $callee: Expr, $args: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g11_chan_method_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            match $p.ch.kind {
                CgChan($el) {
                    if $p.method == "close" {
                        if cgkind_eq($kind, g11_chan_closed_res()) {
                            match $p.args {
                                ExprNil { g11_chan_close_value($p.ch, $state) }
                                _ { Err(g3_unsupported()) }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    } else if $p.method == "send" {
                        if cgkind_eq($kind, g11_chan_closed_res()) {
                            g11_chan_send_value($p.ch, $el, $p.args, $state, $env)
                        } else {
                            Err(g3_unsupported())
                        }
                    } else if $p.method == "recv" {
                        match g11_chan_opt_kind($el) {
                            Err($m) { Err($m) }
                            Ok($okind) {
                                if cgkind_eq($kind, $okind) {
                                    g11_chan_recv_value($p.ch, $el, $p.args, $state)
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g11_chan_op_result_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g11_chan_method_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            if $p.method == "send" || $p.method == "close" {
                Ok(g11_chan_closed_res())
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g11_chan_op_option_kind($callee: Expr, $args: ExprList, $env: CgEnv): Result[CgKind, Str] {
    match g11_chan_method_parts($callee, $args, $env) {
        Err($m) { Err($m) }
        Ok($p) {
            if $p.method == "recv" {
                match $p.ch.kind {
                    CgChan($el) { g11_chan_opt_kind($el) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g11_chan_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g11_chan_bind_kind($ty, $value, $env) {
        Err($m) { Err($m) }
        Ok($kind) {
            match g4_lower_value($kind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($cv) {
                    $cn = "gv" ~ c_int($cv.state.ntmp)
                    $st2 = CgState(
                        interns: $cv.state.interns,
                        decls: $cv.state.decls ~ g4_value_decl($kind, $cn),
                        body: $cv.state.body ~ "\t" ~ $cn ~ " = " ~ $cv.c ~ ";\n",
                        nstr: $cv.state.nstr,
                        ntmp: $cv.state.ntmp + 1
                    )
                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: g11_chan_bind_listlen($ty)), $env)))
                }
            }
        }
    }
}

# ---- P8f-1: scalar `select` emission (§17.5–§17.6) -----------------------
#
# The concurrency runtime already exposes the native oracle's tri-state
# guji_chan_try_recv / guji_chan_try_send operations and progress-counter wait.
# This first coherent SELECT slice wires those hooks for Int/Bool/Float element
# channels. Heap-bearing elements and carrier/user values deliberately remain at
# the next P8f checklist boundary: admitting them also requires arm-local adopted
# payload ownership on normal exit and every early-return path.

sub g11_select_scalar_elem($el: CgKind): Bool {
    match $el {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        _ { false }
    }
}

# P8f-2a widens select arms from scalars to the FLAT heap elements. A Str/
# List/Map recv arm adopts one detached rc==1 message per ready poll, so the
# arm binding becomes OWNED (arm-exit + early-return release); an unbound arm
# discards the ready message immediately. Send arms reuse the ordinary
# copy-on-send fill: guji_chan_try_send consumes the fresh per-pass copy in
# EVERY outcome. P8f-2b widens further to carrier elements (Option[T] /
# Result[T,E], including Option[Match]) and user-enum elements: the recv
# binding is Option[element] (CgOptCarrier / CgOptEnum); ownership still
# rides the env borrowed flag + g5_guard_body release walk.
sub g11_select_elem_ok($el: CgKind): Bool {
    match $el {
        CgStr { true }
        CgList($inner) { true }
        CgMap($val) { true }
        CgEnum($name) { true }
        CgOptInt { true }
        CgOptBool { true }
        CgOptFloat { true }
        CgOptStr { true }
        CgOptMatch { true }
        CgOptBush { true }
        CgOptList($inner) { true }
        CgOptMap($v) { true }
        CgRes($ok, $err) { true }
        CgFn($p, $r) { true }
        _ { g11_select_scalar_elem($el) }
    }
}

# Unbound select recv arms discard the ready message. A Some heap payload was
# still adopted from the channel (rc==1) and must be released BEFORE the arm
# body runs so an early return out of the arm cannot leak it — native's exact
# discard shape (reset keeps a stray later release a no-op). Scalars own
# nothing and keep the P8f-1 body byte-for-byte. Carrier/enum elements release
# the adopted ELEMENT itself (native materializes an Option wrapper temp and
# drains it; releasing `out` is ownership-equivalent and avoids a dead local).
sub g11_select_recv_discard($el: CgKind, $out: Str, $ready: Str): Str {
    match $el {
        CgStr { "\t\t\tif (" ~ $ready ~ " == 1) \{ guji_release(" ~ $out ~ "); " ~ $out ~ " = GUJI_EMPTY_STR; }\n" }
        CgList($inner) { "\t\t\tif (" ~ $ready ~ " == 1) \{ guji_release((const void*)" ~ $out ~ ".data); " ~ $out ~ " = (guji_slice_t)\{0}; }\n" }
        CgMap($val) { "\t\t\tif (" ~ $ready ~ " == 1) \{ guji_release((const void*)" ~ $out ~ ".keys); guji_release(" ~ $out ~ ".vals); " ~ $out ~ " = (guji_map_t)\{0}; }\n" }
        CgOptStr {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ if (" ~ $out ~ ".tag != 0LL) \{ guji_release(" ~ $out ~ ".val); } " ~
            $out ~ " = (guji_opt_str)\{0}; }\n"
        }
        CgOptMatch {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ if (" ~ $out ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $out ~ ".val); } " ~
            $out ~ " = (guji_opt_match)\{0}; }\n"
        }
        CgOptBush {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ if (" ~ $out ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $out ~ ".val); } " ~
            $out ~ " = (guji_opt_bush)\{0}; }\n"
        }
        CgOptList($inner) {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ if (" ~ $out ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $out ~ ".val.data); } " ~
            $out ~ " = (guji_opt_list)\{0}; }\n"
        }
        CgOptMap($v) {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ if (" ~ $out ~ ".tag != 0LL) \{ guji_release((const void*)" ~ $out ~ ".val.keys); guji_release(" ~ $out ~ ".val.vals); } " ~
            $out ~ " = (guji_opt_map)\{0}; }\n"
        }
        CgRes($ok, $err) {
            "\t\t\tif (" ~ $ready ~ " == 1) \{\n" ~
            g11_select_recv_discard_result_indent(CgRes($ok, $err), $out) ~
            "\t\t\t\t" ~ $out ~ " = (" ~ g6_result_ctype(CgRes($ok, $err)) ~ ")\{0};\n" ~
            "\t\t\t}\n"
        }
        CgEnum($name) {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ guji_release_" ~ $name ~ "_fields(&" ~ $out ~ "); " ~
            $out ~ " = (" ~ $name ~ ")\{0}; }\n"
        }
        CgFn($p, $r) {
            "\t\t\tif (" ~ $ready ~ " == 1) \{ guji_release(" ~ $out ~ ".env); " ~
            $out ~ " = (guji_fn_t)\{0}; }\n"
        }
        _ { "" }
    }
}

# Indent a Result-element release for the unbound select discard block. Scalar
# Result arms contribute nothing; Str arms drop the active Ok/Err payload.
sub g11_select_recv_discard_result_indent($kind: CgKind, $out: Str): Str {
    match $kind {
        CgRes($ok, $err) {
            g11_select_recv_discard_result_slot($ok, $out, "ok", "== 0LL") ~
            g11_select_recv_discard_result_slot($err, $out, "err", "!= 0LL")
        }
        _ { "" }
    }
}

sub g11_select_recv_discard_result_slot($k: CgKind, $out: Str, $slot: Str, $cmp: Str): Str {
    match $k {
        CgStr {
            "\t\t\t\tif (" ~ $out ~ ".tag " ~ $cmp ~ ") \{ guji_release(" ~ $out ~ "." ~ $slot ~ "); }\n"
        }
        CgMatch {
            "\t\t\t\tif (" ~ $out ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $out ~ "." ~ $slot ~ "); }\n"
        }
        CgBush {
            "\t\t\t\tif (" ~ $out ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $out ~ "." ~ $slot ~ "); }\n"
        }
        CgList($el) {
            "\t\t\t\tif (" ~ $out ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $out ~ "." ~ $slot ~ ".data); }\n"
        }
        CgMap($v) {
            "\t\t\t\tif (" ~ $out ~ ".tag " ~ $cmp ~ ") \{ guji_release((const void*)" ~ $out ~ "." ~ $slot ~ ".keys); guji_release(" ~ $out ~ "." ~ $slot ~ ".vals); }\n"
        }
        _ { "" }
    }
}

sub g11_select_parts($op: Expr, $env: CgEnv): Result[ChanOpParts, Str] {
    match $op {
        ECall($callee, $args) {
            match g11_chan_method_parts($callee, $args, $env) {
                Err($m) { Err($m) }
                Ok($p) {
                    match $p.ch.kind {
                        CgChan($el) {
                            if g11_select_elem_ok($el) && ($p.method == "recv" || $p.method == "send") {
                                Ok($p)
                            } else {
                                Err(g3_unsupported())
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# One try-send poll. The payload lowering lives INSIDE the select loop, exactly
# like native emitSelect -> chanTrySend: each unsuccessful poll consumes the
# detached message and a later poll evaluates/copies the send expression again.
class SelectSendOut {
    has $.state: CgState
    has $.carrier: Str
    has $.ready: Str
}

sub g11_select_try_send($ch: CgVar, $el: CgKind, $args: ExprList, $state: CgState, $env: CgEnv): Result[SelectSendOut, Str] {
    match $args {
        ExprCons($payload, ExprNil) {
            match g4_lower_value($el, $payload, $state, $env) {
                Err($m) { Err($m) }
                Ok($pv) {
                    $msg = g4_value_tmp($el, $pv.state.ntmp)
                    $carrier = g4_value_tmp(g11_chan_closed_res(), $pv.state.ntmp + 1)
                    $ready = "gsel" ~ c_int($pv.state.ntmp + 2)
                    Ok(SelectSendOut(
                        state: CgState(
                            interns: $pv.state.interns,
                            decls: $pv.state.decls ~
                                g4_value_decl($el, $msg) ~
                                g4_value_decl(g11_chan_closed_res(), $carrier) ~
                                "\tint " ~ $ready ~ " = -1;\n",
                            body: $pv.state.body ~
                                g11_chan_send_fill($el, $msg, $pv.c, $env) ~
                                "\t\t" ~ $ready ~ " = guji_chan_try_send(" ~ $ch.cname ~ ", &" ~ $msg ~ ");\n" ~
                                "\t\t" ~ $carrier ~ ".tag = (" ~ $ready ~ " == 1) ? 0 : 1;\n" ~
                                g11_chan_send_source_release($el, $pv.c, $env, g5_fn_init_fresh($payload)),
                            nstr: $pv.state.nstr,
                            ntmp: $pv.state.ntmp + 3
                        ),
                        carrier: $carrier,
                        ready: $ready
                    ))
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_select_send_arm($arm: SelectArm, $p: ChanOpParts, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $p.ch.kind {
        CgChan($el) {
            # Start body-less so payload preparation is emitted inside the poll
            # loop rather than before it.
            match g11_select_try_send($p.ch, $el, $p.args, g4_bodyless_state($state), $env) {
                Err($m) { Err($m) }
                Ok($so) {
                    $arm_env = match $arm.bind {
                        None { $env }
                        Some($name) {
                            # Result[Unit,Closed] is scalar-only. Alias the
                            # try-send result temp for the lexical arm body.
                            CgEnvCons(CgVar(name: $name, cname: $so.carrier, kind: g11_chan_closed_res(), mutable: false, borrowed: true, listlen: 0), $env)
                        }
                    }
                    match g5_guard_body_extra($arm.body, g4_bodyless_state($so.state), $arm_env, cg_env_len($env), $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($bo) {
                            Ok(CgState(
                                interns: $bo.interns,
                                decls: $bo.decls,
                                body: $state.body ~ $so.state.body ~
                                    "\t\tif (" ~ $so.ready ~ " != -1) \{\n" ~
                                    $bo.body ~
                                    "\t\t\tbreak;\n\t\t}\n",
                                nstr: $bo.nstr,
                                ntmp: $bo.ntmp
                            ))
                        }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_select_recv_arm_body($arm: SelectArm, $el: CgKind, $out: Str, $ready: Str, $start: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $arm.bind {
        None {
            match g5_guard_body_extra($arm.body, $start, $env, cg_env_len($env), $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($bo) {
                    Ok(CgState(
                        interns: $bo.interns,
                        decls: $bo.decls,
                        body: "\t\tif (" ~ $ready ~ " != -1) \{\n" ~
                            g11_select_recv_discard($el, $out, $ready) ~
                            $bo.body ~ "\t\t\tbreak;\n\t\t}\n",
                        nstr: $bo.nstr,
                        ntmp: $bo.ntmp
                    ))
                }
            }
        }
        Some($name) {
            match g11_chan_opt_kind($el) {
                Err($m) { Err($m) }
                Ok($okind) {
                    $carrier = g4_value_tmp($okind, $start.ntmp)
                    $with_decl = CgState(
                        interns: $start.interns,
                        decls: $start.decls ~ g4_value_decl($okind, $carrier),
                        body: "",
                        nstr: $start.nstr,
                        ntmp: $start.ntmp + 1
                    )
                    # A scalar Option binding is borrowed (owns nothing — the
                    # P8f-1 C byte-for-byte). A Str/List/Map/carrier/enum
                    # binding ADOPTS the detached message: OWNED, so
                    # g5_guard_body's fall-through releases it at arm exit and
                    # an early return releases it with the frame (native's
                    # owned-carrier-local registries / setSelectCarrierOwned /
                    # setEnumCarrierOwned). Scalar carriers (Option[Int] etc.)
                    # still mark borrowed=false here; their g6_option_release
                    # is empty so the walk is a no-op.
                    $arm_env = CgEnvCons(CgVar(name: $name, cname: $carrier, kind: $okind, mutable: false, borrowed: g11_select_scalar_elem($el), listlen: 0), $env)
                    match g5_guard_body_extra($arm.body, $with_decl, $arm_env, cg_env_len($env), $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($bo) {
                            Ok(CgState(
                                interns: $bo.interns,
                                decls: $bo.decls,
                                body: "\t\tif (" ~ $ready ~ " != -1) \{\n" ~
                                    "\t\t\t" ~ $carrier ~ ".tag = (" ~ $ready ~ " == 1) ? 1 : 0;\n" ~
                                    g11_chan_recv_fill($el, $carrier, $out) ~
                                    $bo.body ~
                                    "\t\t\tbreak;\n\t\t}\n",
                                nstr: $bo.nstr,
                                ntmp: $bo.ntmp
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g11_select_recv_arm($arm: SelectArm, $p: ChanOpParts, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $p.args {
        ExprNil {
            match $p.ch.kind {
                CgChan($el) {
                    $out = g4_value_tmp($el, $state.ntmp)
                    $ready = "gsel" ~ c_int($state.ntmp + 1)
                    $start = CgState(
                        interns: $state.interns,
                        decls: $state.decls ~ g4_value_decl($el, $out) ~ "\tint " ~ $ready ~ " = -1;\n",
                        body: "",
                        nstr: $state.nstr,
                        ntmp: $state.ntmp + 2
                    )
                    match g11_select_recv_arm_body($arm, $el, $out, $ready, $start, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($bo) {
                            Ok(CgState(
                                interns: $bo.interns,
                                decls: $bo.decls,
                                body: $state.body ~
                                    "\t\t" ~ $ready ~ " = guji_chan_try_recv(" ~ $p.ch.cname ~ ", &" ~ $out ~ ");\n" ~
                                    $bo.body,
                                nstr: $bo.nstr,
                                ntmp: $bo.ntmp
                            ))
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g11_select_arms($arms: SelectArmList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $arms {
        SelectArmNil { Ok($state) }
        SelectArmCons($arm, $rest) {
            match g11_select_parts($arm.op, $env) {
                Err($m) { Err($m) }
                Ok($p) {
                    $one = if $p.method == "recv" {
                        g11_select_recv_arm($arm, $p, $state, $env, $retkind, $extra_cleanup)
                    } else {
                        g11_select_send_arm($arm, $p, $state, $env, $retkind, $extra_cleanup)
                    }
                    match $one {
                        Err($m) { Err($m) }
                        Ok($next) { g11_select_arms($rest, $next, $env, $retkind, $extra_cleanup) }
                    }
                }
            }
        }
    }
}

sub g11_select_else($els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[CgState, Str] {
    match $els {
        None { Ok($state) }
        Some($body) {
            match g5_guard_body_extra($body, g4_bodyless_state($state), $env, cg_env_len($env), $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($bo) {
                    Ok(CgState(
                        interns: $bo.interns,
                        decls: $bo.decls,
                        body: $state.body ~ $bo.body,
                        nstr: $bo.nstr,
                        ntmp: $bo.ntmp
                    ))
                }
            }
        }
    }
}

sub g11_emit_select_extra($arms: SelectArmList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    match $arms {
        SelectArmNil {
            # `select { else { ... } }` is simply its always-ready else body.
            match $els {
                None { Err(g3_unsupported()) }
                Some($body) {
                    match g11_select_else($els, $state, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($eo) { Ok(BindOut(state: $eo, env: $env)) }
                    }
                }
            }
        }
        _ {
            $seen = "gseen" ~ c_int($state.ntmp)
            $loop_start = CgState(
                interns: $state.interns,
                decls: $state.decls ~ "\tuint64_t " ~ $seen ~ " = 0;\n",
                body: "",
                nstr: $state.nstr,
                ntmp: $state.ntmp + 1
            )
            match g11_select_arms($arms, $loop_start, $env, $retkind, $extra_cleanup) {
                Err($m) { Err($m) }
                Ok($ao) {
                    match g11_select_else($els, $ao, $env, $retkind, $extra_cleanup) {
                        Err($m) { Err($m) }
                        Ok($eo) {
                            $tail = match $els {
                                Some($body) { $eo.body ~ "\t\tbreak;\n" }
                                None { $ao.body ~ "\t\tguji_select_wait(" ~ $seen ~ ");\n" }
                            }
                            Ok(BindOut(
                                state: CgState(
                                    interns: $eo.interns,
                                    decls: $eo.decls,
                                    body: $state.body ~
                                        "\tfor (;;) \{\n" ~
                                        "\t\t" ~ $seen ~ " = guji_progress_snapshot();\n" ~
                                        $tail ~
                                        "\t}\n",
                                    nstr: $eo.nstr,
                                    ntmp: $eo.ntmp
                                ),
                                env: $env
                            ))
                        }
                    }
                }
            }
        }
    }
}

sub g11_emit_select($arms: SelectArmList, $els: Option[StmtList], $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g11_emit_select_extra($arms, $els, $state, $env, $retkind, "")
}

# $m.text — retain the whole-match Str (native retains before handing out).
sub g6_match_text_value($obj: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_match_value($obj, $state, $env) {
        Err($m) { Err($m) }
        Ok($mv) {
            $ti = c_int($mv.state.ntmp)
            $tmp = "gt" ~ $ti
            Ok(CgValueOut(
                state: CgState(
                    interns: $mv.state.interns,
                    decls: $mv.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                    body: $mv.state.body ~
                        "\t" ~ $tmp ~ " = " ~ $mv.c ~ "->text;\n" ~
                        "\tguji_retain(" ~ $tmp ~ ");\n",
                    nstr: $mv.state.nstr,
                    ntmp: $mv.state.ntmp + 1
                ),
                c: $tmp
            ))
        }
    }
}

# Lower a Bush value bound by `Some($b)` in a grammar-parse match arm. The
# Option carrier owns the tree; the arm binding is a borrowed alias. Call-arg
# lowering uses this path (borrow — no retain).
sub g10_bush_value($value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) { match $v.kind { CgBush { Ok(CgValueOut(state: $state, c: $v.cname)) } _ { Err(g3_unsupported()) } } }
                None { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Owned Bush rvalue for returns / binds / reassigns. Named Bushes retain into a
# fresh temp (borrowed params and owned locals both need +1 for the consumer);
# unwrap/expect extract a payload; user-sub calls use RBush.
sub g10_bush_owned_value($value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgBush {
                            $tmp = g4_value_tmp(CgBush, $state.ntmp)
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $state.interns,
                                    decls: $state.decls ~ g4_value_decl(CgBush, $tmp),
                                    body: $state.body ~
                                        "\t" ~ $tmp ~ " = " ~ $v.cname ~ ";\n" ~
                                        "\tguji_retain((const void*)" ~ $tmp ~ ");\n",
                                    nstr: $state.nstr,
                                    ntmp: $state.ntmp + 1
                                ),
                                c: $tmp
                            ))
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        ECall($c, $a) {
            match g10_bush_unwrap_value($c, $a, $state, $env) {
                Ok($uv) { Ok($uv) }
                Err($not_unwrap) { g5_call_value(RBush, $c, $a, $state, $env) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Parse `$o.unwrap()` / `unwrap($o)` / `$o.expect($m)` / `expect($o, $m)` into the
# Option[Bush] receiver plus an optional expect-message expression.
class BushExtract {
    has $.recv: Expr
    has $.expect_msg: Option[Expr]
}

sub g10_bush_extract_from_call($c: Expr, $a: ExprList, $env: CgEnv): Result[BushExtract, Str] {
    match $c {
        EField($recv, $method) {
            if $method == "unwrap" {
                match $a {
                    ExprNil { Ok(BushExtract(recv: $recv, expect_msg: None)) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                if $method == "expect" {
                    match $a {
                        ExprCons($msg, ExprNil) { Ok(BushExtract(recv: $recv, expect_msg: Some($msg))) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        EName($fn) {
            if $fn == "unwrap" {
                match cg_env_lookup_sub($env, $fn) {
                    Some($sig) { Err(g3_unsupported()) }
                    None {
                        match $a {
                            ExprCons($recv, ExprNil) { Ok(BushExtract(recv: $recv, expect_msg: None)) }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                if $fn == "expect" {
                    match cg_env_lookup_sub($env, $fn) {
                        Some($sig) { Err(g3_unsupported()) }
                        None {
                            match $a {
                                ExprCons($recv, ExprCons($msg, ExprNil)) { Ok(BushExtract(recv: $recv, expect_msg: Some($msg))) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g10_bush_unwrap_panic_prefix($carrier: Str, $expect_msg: Option[Expr], $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $expect_msg {
        None {
            Ok(CgState(
                interns: $state.interns,
                decls: $state.decls,
                body: $state.body ~ "\tif (" ~ $carrier ~ ".tag == 0) \{ guji_panic(\"unwrap on None\"); }\n",
                nstr: $state.nstr,
                ntmp: $state.ntmp
            ))
        }
        Some($msg) {
            match g3_str_lower($msg, $state, $env) {
                Err($m) { Err($m) }
                Ok($ms) {
                    Ok(CgState(
                        interns: $ms.state.interns,
                        decls: $ms.state.decls,
                        body: $ms.state.body ~
                            "\tif (" ~ $carrier ~ ".tag == 0) \{ guji_panic(" ~ $ms.tmp ~ "); }\n" ~
                            "\tguji_release(" ~ $ms.tmp ~ ");\n",
                        nstr: $ms.state.nstr,
                        ntmp: $ms.state.ntmp
                    ))
                }
            }
        }
    }
}

# Value-position Bush unwrap/expect: bound carriers retain; fresh carriers transfer.
sub g10_bush_unwrap_value($c: Expr, $a: ExprList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g10_bush_extract_from_call($c, $a, $env) {
        Err($m) { Err($m) }
        Ok($ex) {
            match $ex.recv {
                EName($n) {
                    match cg_env_lookup($env, $n) {
                        None { Err(g3_unsupported()) }
                        Some($v) {
                            match $v.kind {
                                CgOptBush {
                                    match g10_bush_unwrap_panic_prefix($v.cname, $ex.expect_msg, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($st1) {
                                            $tmp = g4_value_tmp(CgBush, $st1.ntmp)
                                            Ok(CgValueOut(
                                                state: CgState(
                                                    interns: $st1.interns,
                                                    decls: $st1.decls ~ g4_value_decl(CgBush, $tmp),
                                                    body: $st1.body ~
                                                        "\tguji_retain((const void*)" ~ $v.cname ~ ".val);\n" ~
                                                        "\t" ~ $tmp ~ " = " ~ $v.cname ~ ".val;\n",
                                                    nstr: $st1.nstr,
                                                    ntmp: $st1.ntmp + 1
                                                ),
                                                c: $tmp
                                            ))
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ {
                    match g4_lower_value(CgOptBush, $ex.recv, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($fresh) {
                            match g10_bush_unwrap_panic_prefix($fresh.c, $ex.expect_msg, $fresh.state, $env) {
                                Err($m) { Err($m) }
                                Ok($st1) {
                                    $tmp = g4_value_tmp(CgBush, $st1.ntmp)
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $st1.interns,
                                            decls: $st1.decls ~ g4_value_decl(CgBush, $tmp),
                                            body: $st1.body ~ "\t" ~ $tmp ~ " = " ~ $fresh.c ~ ".val;\n",
                                            nstr: $st1.nstr,
                                            ntmp: $st1.ntmp + 1
                                        ),
                                        c: $tmp
                                    ))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g10_bush_bind_ty_ok($ty: Option[TypeRef]): Bool {
    match $ty {
        None { true }
        Some($tr) { $tr.name == "Bush" }
    }
}

# Bind-position `$b = <Option[Bush]>.unwrap()` / `.expect($m)` — same retain vs
# transfer split as Option[Match] unwrap (P6f), mirrored for Bush.
sub g10_bush_unwrap_emit($mutable: Bool, $name: Str, $carrier: Str, $retain: Bool, $expect_msg: Option[Expr], $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g10_bush_unwrap_panic_prefix($carrier, $expect_msg, $state, $env) {
        Err($m) { Err($m) }
        Ok($st1) {
            $cn = "gv" ~ c_int($st1.ntmp)
            $keep = if $retain { "\tguji_retain((const void*)" ~ $carrier ~ ".val);\n" } else { "" }
            Ok(BindOut(
                state: CgState(
                    interns: $st1.interns,
                    decls: $st1.decls ~ g4_value_decl(CgBush, $cn),
                    body: $st1.body ~ $keep ~ "\t" ~ $cn ~ " = " ~ $carrier ~ ".val;\n",
                    nstr: $st1.nstr,
                    ntmp: $st1.ntmp + 1
                ),
                env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgBush, mutable: $mutable, borrowed: false, listlen: 0), $env)
            ))
        }
    }
}

sub g10_bush_unwrap_bind_recv($mutable: Bool, $name: Str, $recv: Expr, $expect_msg: Option[Expr], $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgOptBush { g10_bush_unwrap_emit($mutable, $name, $v.cname, true, $expect_msg, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ {
            match g4_lower_value(CgOptBush, $recv, $state, $env) {
                Err($m) { Err($m) }
                Ok($fresh) { g10_bush_unwrap_emit($mutable, $name, $fresh.c, false, $expect_msg, $fresh.state, $env) }
            }
        }
    }
}

sub g10_bush_unwrap_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    if g10_bush_bind_ty_ok($ty) {
        match $value {
            ECall($c, $a) {
                match g10_bush_extract_from_call($c, $a, $env) {
                    Err($m) { Err($m) }
                    Ok($ex) { g10_bush_unwrap_bind_recv($mutable, $name, $ex.recv, $ex.expect_msg, $state, $env) }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g10_bush_value_is_bush($value: Expr, $env: CgEnv): Bool {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                Some($v) { match $v.kind { CgBush { true } _ { false } } }
                None { false }
            }
        }
        ECall($c, $a) {
            match g10_bush_extract_from_call($c, $a, $env) {
                Ok($ex) { true }
                Err($not_unwrap) {
                    match g5_resolve_call_target($c, $a, $env) {
                        Ok($target) { match $target.sig.ret { RBush { true } _ { false } } }
                        Err($m) { false }
                    }
                }
            }
        }
        _ { false }
    }
}

# Unannotated / `: Bush` binds of owned Bush rvalues (call returns, named copies).
sub g10_bush_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    if g10_bush_bind_ty_ok($ty) {
        match $ty {
            Some($tr) {
                match g10_bush_owned_value($value, $state, $env) {
                    Err($m) { Err($m) }
                    Ok($bv) {
                        $cn = "gv" ~ c_int($bv.state.ntmp)
                        Ok(BindOut(
                            state: CgState(
                                interns: $bv.state.interns,
                                decls: $bv.state.decls ~ g4_value_decl(CgBush, $cn),
                                body: $bv.state.body ~ "\t" ~ $cn ~ " = " ~ $bv.c ~ ";\n",
                                nstr: $bv.state.nstr,
                                ntmp: $bv.state.ntmp + 1
                            ),
                            env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgBush, mutable: $mutable, borrowed: false, listlen: 0), $env)
                        ))
                    }
                }
            }
            None {
                if g10_bush_value_is_bush($value, $env) {
                    match g10_bush_owned_value($value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($bv) {
                            $cn = "gv" ~ c_int($bv.state.ntmp)
                            Ok(BindOut(
                                state: CgState(
                                    interns: $bv.state.interns,
                                    decls: $bv.state.decls ~ g4_value_decl(CgBush, $cn),
                                    body: $bv.state.body ~ "\t" ~ $cn ~ " = " ~ $bv.c ~ ";\n",
                                    nstr: $bv.state.nstr,
                                    ntmp: $bv.state.ntmp + 1
                                ),
                                env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgBush, mutable: $mutable, borrowed: false, listlen: 0), $env)
                            ))
                        }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

# `$b.text` returns an owned Str view: retain the Bush-owned text before the
# surrounding string consumer releases it.
sub g10_bush_text_value($obj: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g10_bush_value($obj, $state, $env) {
        Err($m) { Err($m) }
        Ok($bv) {
            $tmp = "gt" ~ c_int($bv.state.ntmp)
            Ok(CgValueOut(
                state: CgState(
                    interns: $bv.state.interns,
                    decls: $bv.state.decls ~ "\tconst char* " ~ $tmp ~ " = GUJI_EMPTY_STR;\n",
                    body: $bv.state.body ~ "\t" ~ $tmp ~ " = " ~ $bv.c ~ "->text;\n\tguji_retain(" ~ $tmp ~ ");\n",
                    nstr: $bv.state.nstr,
                    ntmp: $bv.state.ntmp + 1
                ),
                c: $tmp
            ))
        }
    }
}

# `$b<name>` returns Option[Bush]. `guji_bush_cap` borrows the parent's child,
# so retain it into the fresh carrier; statement/match cleanup owns that +1.
sub g10_bush_capture_value($obj: Expr, $name: Str, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g10_bush_value($obj, $state, $env) {
        Err($m) { Err($m) }
        Ok($bv) {
            $ot = "go" ~ c_int($bv.state.ntmp)
            $sub = "gbu" ~ c_int($bv.state.ntmp + 1)
            Ok(CgValueOut(
                state: CgState(
                    interns: $bv.state.interns,
                    decls: $bv.state.decls ~ "\tguji_opt_bush " ~ $ot ~ " = \{0};\n\tguji_bush_t* " ~ $sub ~ " = NULL;\n",
                    body: $bv.state.body ~
                        "\t" ~ $sub ~ " = guji_bush_cap(" ~ $bv.c ~ ", \"" ~ g2_c_escape($name) ~ "\");\n" ~
                        "\tif (" ~ $sub ~ " != NULL) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = " ~ $sub ~ "; guji_retain((const void*)" ~ $ot ~ ".val); }\n",
                    nstr: $bv.state.nstr,
                    ntmp: $bv.state.ntmp + 2
                ),
                c: $ot
            ))
        }
    }
}

# $m[i] — Option[Str] positional capture (0 = whole match text).
sub g6_match_index_value($obj: Expr, $idx: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_match_value($obj, $state, $env) {
        Err($m) { Err($m) }
        Ok($mv) {
            match g3_int_rvalue_state($idx, $mv.state, $env) {
                Err($m) { Err($m) }
                Ok($iv) {
                    $ii = c_int($iv.state.ntmp)
                    $oi = c_int($iv.state.ntmp + 1)
                    $it = "gi" ~ $ii
                    $ot = "go" ~ $oi
                    $recv = $mv.c
                    $body = $iv.state.body ~
                        "\t" ~ $it ~ " = " ~ $iv.c ~ ";\n" ~
                        "\tif (" ~ $it ~ " == 0) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = " ~ $recv ~ "->text; guji_retain(" ~ $ot ~ ".val); } else if (" ~ $it ~ " > 0 && " ~ $it ~ " <= " ~ $recv ~ "->group_count && " ~ $recv ~ "->groups[" ~ $it ~ " - 1] != NULL) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = " ~ $recv ~ "->groups[" ~ $it ~ " - 1]; guji_retain(" ~ $ot ~ ".val); } else \{ " ~ $ot ~ ".tag = 0; " ~ $ot ~ ".val = GUJI_EMPTY_STR; }\n"
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $iv.state.interns,
                            decls: $iv.state.decls ~
                                "\tint64_t " ~ $it ~ " = 0;\n" ~
                                "\tguji_opt_str " ~ $ot ~ " = \{0};\n",
                            body: $body,
                            nstr: $iv.state.nstr,
                            ntmp: $iv.state.ntmp + 2
                        ),
                        c: $ot
                    ))
                }
            }
        }
    }
}

# $m<name> — Option[Str] named capture via guji_match_cap.
sub g6_match_capture_value($obj: Expr, $name: Str, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_match_value($obj, $state, $env) {
        Err($m) { Err($m) }
        Ok($mv) {
            $oi = c_int($mv.state.ntmp)
            $ot = "go" ~ $oi
            $esc = g2_c_escape($name)
            $body = $mv.state.body ~
                "\t\{\n" ~
                "\t\tconst char* _gc = guji_match_cap(" ~ $mv.c ~ ", \"" ~ $esc ~ "\");\n" ~
                "\t\tif (_gc != NULL) \{ " ~ $ot ~ ".tag = 1; " ~ $ot ~ ".val = _gc; guji_retain(" ~ $ot ~ ".val); } else \{ " ~ $ot ~ ".tag = 0; " ~ $ot ~ ".val = GUJI_EMPTY_STR; }\n" ~
                "\t}\n"
            Ok(CgValueOut(
                state: CgState(
                    interns: $mv.state.interns,
                    decls: $mv.state.decls ~ "\tguji_opt_str " ~ $ot ~ " = \{0};\n",
                    body: $body,
                    nstr: $mv.state.nstr,
                    ntmp: $mv.state.ntmp + 1
                ),
                c: $ot
            ))
        }
    }
}

# A Match bind annotation must be absent or exactly `Match` (§13).
sub g6_match_bind_ty_ok($ty: Option[TypeRef]): Bool {
    match $ty {
        None { true }
        Some($tr) { $tr.name == "Match" }
    }
}

# P6f: `$m = <Option[Match]>.unwrap()` in bind position (native shape, dumpc-
# verified): guard `if (c.tag == 0) { guji_panic("unwrap on None"); }` then bind
# the payload. A BOUND carrier RETAINS it (the carrier keeps its +1; scope exit
# releases both); a FRESH carrier TRANSFERS ownership out of the consumed temp
# (no retain, no carrier release). The CgMatch local then feeds the existing
# $m.text / $m[i] / $m<name> lowerings unchanged — capture names resolve at
# RUNTIME via guji_match_cap, so the match object carries its own provenance.
sub g6_match_unwrap_emit($mutable: Bool, $name: Str, $carrier: Str, $retain: Bool, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    $cn = "gv" ~ c_int($state.ntmp)
    $keep = if $retain { "\tguji_retain((const void*)" ~ $carrier ~ ".val);\n" } else { "" }
    Ok(BindOut(
        state: CgState(
            interns: $state.interns,
            decls: $state.decls ~ g4_value_decl(CgMatch, $cn),
            body: $state.body ~
                "\tif (" ~ $carrier ~ ".tag == 0) \{ guji_panic(\"unwrap on None\"); }\n" ~
                $keep ~
                "\t" ~ $cn ~ " = " ~ $carrier ~ ".val;\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        ),
        env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgMatch, mutable: $mutable, borrowed: false, listlen: 0), $env)
    ))
}

sub g6_match_unwrap_bind_recv($mutable: Bool, $name: Str, $recv: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $recv {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgOptMatch { g6_match_unwrap_emit($mutable, $name, $v.cname, true, $state, $env) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ {
            match g6_option_kind_from_value($recv, $env) {
                Err($m) { Err($m) }
                Ok($okind) {
                    match $okind {
                        CgOptMatch {
                            match g4_lower_value(CgOptMatch, $recv, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($fresh) { g6_match_unwrap_emit($mutable, $name, $fresh.c, false, $fresh.state, $env) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g6_match_unwrap_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    if g6_match_bind_ty_ok($ty) {
        match $value {
            ECall($c, $a) {
                match g4_option_unwrap_fresh_recv($c, $a, $env) {
                    Err($m) { Err($m) }
                    Ok($recv) { g6_match_unwrap_bind_recv($mutable, $name, $recv, $state, $env) }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub g6_option_value($kind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match $value {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    if g6_is_option_kind($v.kind) {
                        match $v.kind {
                            CgOptInt { match $kind { CgOptInt { Ok(CgValueOut(state: $state, c: $v.cname)) } _ { Err(g3_unsupported()) } } }
                            CgOptFloat { match $kind { CgOptFloat { Ok(CgValueOut(state: $state, c: $v.cname)) } _ { Err(g3_unsupported()) } } }
                            CgOptBool { match $kind { CgOptBool { Ok(CgValueOut(state: $state, c: $v.cname)) } _ { Err(g3_unsupported()) } } }
                            CgOptStr {
                                match $kind {
                                    CgOptStr {
                                        # A named carrier returned after a match
                                        # binding needs a distinct result temp.
                                        # Frame cleanup releases and NULLs the
                                        # source local before C `return`; returning
                                        # that same struct name would therefore
                                        # erase its active Str payload. Retain into
                                        # a fresh copy, matching CgOptMatch below.
                                        $tmp = g4_value_tmp(CgOptStr, $state.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $state.interns,
                                                decls: $state.decls ~ g4_value_decl(CgOptStr, $tmp),
                                                body: $state.body ~ g6_option_retain(CgOptStr, $v.cname) ~ "\t" ~ $tmp ~ " = " ~ $v.cname ~ ";\n",
                                                nstr: $state.nstr,
                                                ntmp: $state.ntmp + 1
                                            ),
                                            c: $tmp
                                        ))
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            # A bound Option[<class>]/Option[<enum>] local read as a value
                            # (slice 5 E5d-7c-2d-9): retain the active Some payload's owned
                            # fields so the produced value owns its own copy, exactly like the
                            # CgOptStr read above. Used when an Option[<user type>] binding/param
                            # is passed onward as a by-value carrier argument.
                            CgOptClass($cn) {
                                match $kind {
                                    CgOptClass($kn) {
                                        if $cn == $kn {
                                            Ok(CgValueOut(
                                                state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g6_option_retain(CgOptClass($cn), $v.cname), nstr: $state.nstr, ntmp: $state.ntmp),
                                                c: $v.cname
                                            ))
                                        } else { Err(g3_unsupported()) }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            CgOptEnum($cn) {
                                match $kind {
                                    CgOptEnum($kn) {
                                        if $cn == $kn {
                                            Ok(CgValueOut(
                                                state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g6_option_retain(CgOptEnum($cn), $v.cname), nstr: $state.nstr, ntmp: $state.ntmp),
                                                c: $v.cname
                                            ))
                                        } else { Err(g3_unsupported()) }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            CgOptList($el) {
                                match $kind {
                                    CgOptList($kel) {
                                        if cgkind_eq($el, $kel) {
                                            Ok(CgValueOut(
                                                state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g6_option_retain(CgOptList($el), $v.cname), nstr: $state.nstr, ntmp: $state.ntmp),
                                                c: $v.cname
                                            ))
                                        } else { Err(g3_unsupported()) }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            CgOptMap($mv) {
                                match $kind {
                                    CgOptMap($kmv) {
                                        if cgkind_eq($mv, $kmv) {
                                            Ok(CgValueOut(
                                                state: CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ g6_option_retain(CgOptMap($mv), $v.cname), nstr: $state.nstr, ntmp: $state.ntmp),
                                                c: $v.cname
                                            ))
                                        } else { Err(g3_unsupported()) }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            CgOptMatch {
                                match $kind {
                                    CgOptMatch {
                                        # Always materialize a FRESH carrier temp and retain
                                        # the payload into it. Returning a bound local as
                                        # `$o` must not share the local's C name — frame
                                        # cleanup would release+NULL the returned payload
                                        # (native: `gt2 = gv; retain(gt2.val); release(gv.val); return gt2`).
                                        $tmp = g4_value_tmp(CgOptMatch, $state.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $state.interns,
                                                decls: $state.decls ~ g4_value_decl(CgOptMatch, $tmp),
                                                body: $state.body ~ g6_option_retain(CgOptMatch, $v.cname) ~ "\t" ~ $tmp ~ " = " ~ $v.cname ~ ";\n",
                                                nstr: $state.nstr,
                                                ntmp: $state.ntmp + 1
                                            ),
                                            c: $tmp
                                        ))
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            CgOptBush {
                                match $kind {
                                    CgOptBush {
                                        $tmp = g4_value_tmp(CgOptBush, $state.ntmp)
                                        Ok(CgValueOut(
                                            state: CgState(
                                                interns: $state.interns,
                                                decls: $state.decls ~ g4_value_decl(CgOptBush, $tmp),
                                                body: $state.body ~ g6_option_retain(CgOptBush, $v.cname) ~ "\t" ~ $tmp ~ " = " ~ $v.cname ~ ";\n",
                                                nstr: $state.nstr,
                                                ntmp: $state.ntmp + 1
                                            ),
                                            c: $tmp
                                        ))
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            # Bound Option[Result]/Option[Option] recv carrier: return the
                            # local by name. Unwrap retains the inner payload; the Option
                            # local keeps scope-exit ownership (native bound-carrier shape).
                            CgOptCarrier($inner) {
                                match $kind {
                                    CgOptCarrier($kinner) {
                                        if cgkind_eq($inner, $kinner) {
                                            Ok(CgValueOut(state: $state, c: $v.cname))
                                        } else {
                                            Err(g3_unsupported())
                                        }
                                    }
                                    _ { Err(g3_unsupported()) }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
        ETypeName($n) {
            if $n == "None" {
                match cg_reg_builtin_variant(cg_reg_option().variants, "None") {
                    Err($m) { Err($m) }
                    Ok($vm) { Ok(CgValueOut(state: $state, c: "(" ~ g6_option_ctype($kind) ~ ")\{" ~ c_int($vm.tag) ~ "LL, " ~ g6_option_zero($kind) ~ "}")) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        ECall($callee, $args) {
            match $callee {
                ETypeName($n) {
                    if $n == "Some" {
                        match g6_option_one_arg($args) {
                            Err($m) { Err($m) }
                            Ok($arg) {
                                match g6_option_payload_kind($kind) {
                                    Err($m) { Err($m) }
                                    Ok($pk) {
                                        match g4_lower_value($pk, $arg, $state, $env) {
                                            Err($m) { Err($m) }
                                            Ok($pv) {
                                                match cg_reg_builtin_variant(cg_reg_option().variants, "Some") {
                                                    Err($m) { Err($m) }
                                                    Ok($vm) { Ok(CgValueOut(state: $pv.state, c: "(" ~ g6_option_ctype($kind) ~ ")\{" ~ c_int($vm.tag) ~ "LL, " ~ $pv.c ~ "}")) }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ {
                    match g4_option_unwrap_fresh_carrier($kind, $callee, $args, $state, $env) {
                        Ok($unwrapped) { Ok($unwrapped) }
                        Err($not_outer_unwrap) {
                    match g11_chan_op_value($kind, $callee, $args, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($not_chan) {
                    match g10_grammar_parse_value($kind, $callee, $args, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($mgp) {
                    match g6_result_ok_err_value($kind, $callee, $args, $state, $env) {
                        Ok($v) { Ok($v) }
                        Err($mr) {
                            match g7_map_get_value($kind, $callee, $args, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($mmg) {
                            match g6_get_option_value($kind, $callee, $args, $state, $env) {
                                Ok($v) { Ok($v) }
                                Err($mg) {
                                    match g7_find_value($kind, $callee, $args, $state, $env) {
                                        Ok($v) { Ok($v) }
                                        Err($mf) {
                                            match g6_option_map_value($kind, $callee, $args, $state, $env) {
                                                Ok($v) { Ok($v) }
                                                Err($mm) {
                                                    match g6_option_and_then_value($kind, $callee, $args, $state, $env) {
                                                        Ok($v) { Ok($v) }
                                                        Err($ma) {
                                                            match g6_option_filter_value($kind, $callee, $args, $state, $env) {
                                                                Ok($v) { Ok($v) }
                                                                Err($mfl) { g5_call_value(ROpt($kind), $callee, $args, $state, $env) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                        }
                    }
                        }
                    }
                        }
                    }
                        }
                    }
                }
            }
        }
        EIndex($obj, $idx) {
            match $kind {
                CgOptStr { g6_match_index_value($obj, $idx, $state, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
        ECapture($obj, $name) {
            match $kind {
                CgOptStr { g6_match_capture_value($obj, $name, $state, $env) }
                CgOptBush { g10_bush_capture_value($obj, $name, $state, $env) }
                _ { Err(g3_unsupported()) }
            }
        }
        EField($obj, $name) { g8_lower_field_value($kind, $obj, $name, $state, $env) }
        EIf($cond, $then, $elifs, $els) { g4_lower_if_value($kind, $cond, $then, $elifs, $els, $state, $env) }
        EMatch($subj, $arms) { g6_lower_match($kind, $subj, $arms, $state, $env) }
        EBinary($op, $left, $right) {
            if $op == "~~" {
                match $kind {
                    CgOptMatch { g6_regex_match_op_value($left, $right, $state, $env) }
                    _ { Err(g3_unsupported()) }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# ---- G6a: `match` over a scalar scrutinee (PLit + final PWild/PBind) -------
# A `match` whose subject is a scalar (Int/Float/Bool/Str) and whose arms are zero
# or more literal patterns (`PLit`) followed by a final catch-all (`PWild`/`PBind`),
# producing a value of kind `$rkind` (§6.2/§10). The subject is evaluated ONCE into
# a scrutinee temp `gm`; each PLit arm compiles to an `if`/`else if` testing
# equality — numeric `==` (Int/Float/Bool) or counted Str equality, the SAME
# structural equality the interpreter's `value_eq` uses; the catch-all becomes the
# trailing `else if (1)` (`guji build` emits the wildcard exactly this way). Each
# arm body is a block lowered like an `if` branch (g4_branch_block_kind), so leading
# prints/bindings and the Str-result RC discipline are reused unchanged. A Str
# scrutinee owns its temp (released after the match); a Str PBind aliases it
# borrowed (the scrutinee keeps the value alive for the arm). Arm GUARDS
# (`pat if cond`, §10.2) are supported when the guard lowers to a pure C bool (see
# g6_guard_pure); PVariant patterns remain deferred (out of subset). Stateful scalar
# lowerers can compose match results inside arithmetic, comparison, and logical
# operands. Exhaustiveness is
# already enforced upstream by typecheck_verdict — every scalar match needs a
# `_`/bind arm, so the last arm is always a catch-all.
class ScrutOut {
    has $.state: CgState
    has $.gm: Str
    has $.kind: CgKind
    # OWNERSHIP: false when `gm` is a fresh OWNED value the match itself must drop
    # after the chain (an enum scrutinee materialised from an inline construction /
    # niladic value); true when `gm` merely aliases a value owned elsewhere (a sub
    # PARAM or a bound CgEnum local — the binding/caller owns it, so the match must
    # NOT release it). Consulted for CgEnum and for fresh-OWNED CgOptEnum/CgOptClass
    # scrutinees (see g6_lower_match's release block); scalar/Str/CgOptStr/Res
    # release is decided by kind alone.
    has $.borrowed: Bool
}

# Emit the program-scope intern for a Str pattern literal and return its `gs_N.b`
# reference (no body temp — the comparison references the immortal static directly,
# mirroring `guji build`). Mirrors the EStr intern shape used by g3_str_lower.
sub g6_str_intern($text: Str, $state: CgState): CgValueOut {
    $si = c_int($state.nstr)
    $esc = g2_c_escape($text)
    $intern = 'static const struct { guji_obj_t h; char b[sizeof("' ~ $esc ~ '")]; } gs_' ~ $si ~ ' = { {0, GUJI_KIND_STR, GUJI_IMMORTAL, (int64_t)(sizeof("' ~ $esc ~ '") - 1)}, "' ~ $esc ~ '" };' ~ "\n"
    CgValueOut(
        state: CgState(interns: $state.interns ~ $intern, decls: $state.decls, body: $state.body, nstr: $state.nstr + 1, ntmp: $state.ntmp),
        c: "gs_" ~ $si ~ ".b"
    )
}

# Materialise an Int/Float/Bool scrutinee rvalue into a fresh single-use temp `gm`,
# so the subject is evaluated exactly once before any arm comparison.
sub g6_materialize($kind: CgKind, $v: CgValueOut): ScrutOut {
    $gm = g4_value_tmp($kind, $v.state.ntmp)
    ScrutOut(
        state: CgState(
            interns: $v.state.interns,
            decls: $v.state.decls ~ g4_value_decl($kind, $gm),
            body: $v.state.body ~ "\t" ~ $gm ~ " = " ~ $v.c ~ ";\n",
            nstr: $v.state.nstr,
            ntmp: $v.state.ntmp + 1
        ),
        gm: $gm,
        kind: $kind,
        borrowed: true
    )
}

# Materialise a freshly-produced (OWNED) enum value into `gm` for use as a match
# scrutinee. Unlike g6_materialize's default, this marks the temp NOT borrowed, so
# g6_lower_match drops its fields after the chain (the value has no binding owner —
# it was constructed inline / from a niladic variant / returned just for the match).
sub g6_materialize_owned_enum($en: Str, $v: CgValueOut): ScrutOut {
    $sc = g6_materialize(CgEnum($en), $v)
    ScrutOut(state: $sc.state, gm: $sc.gm, kind: $sc.kind, borrowed: false)
}

# Lower an enum-valued scrutinee EXPRESSION (inline construction `A(7)`, niladic
# value `Green`, or enum-returning call `mk()`) into an owned `gm`, mirroring the
# scalar branch's materialisation but through the generic enum value path
# (g6e_enum_value resolves the owning enum via the registry metadata/signature; NO
# bespoke per-position lowering). A bound EName is never reached here —
# g6e_enum_carrier_of handles it first as a borrowed alias.
sub g6_scrut_enum_value($subject: Expr, $state: CgState, $env: CgEnv): Result[ScrutOut, Str] {
    match g6e_enum_kind_from_value($subject, $env) {
        Err($m) { Err($m) }
        Ok($ekind) {
            match $ekind {
                CgEnum($en) {
                    match g6e_enum_value($en, $subject, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($v) { Ok(g6_materialize_owned_enum($en, $v)) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Materialise a `match $obj.field` scrutinee whose `field` is a BY-VALUE enum class
# field (slice 5 E4b-2a). The class object owns the field, so the materialised temp is
# BORROWED (g6_materialize's default) and g6_lower_match leaves it un-released -- the
# class's own `guji_release_<Class>_fields` drops the embedded enum exactly once. The
# match reads the by-value copy's tag/payload the same way it reads a bound enum local.
sub g6_scrut_class_enum_field($subject: Expr, $state: CgState, $env: CgEnv): Result[ScrutOut, Str] {
    match $subject {
        EField($obj, $field) {
            match $obj {
                EName($name) {
                    match cg_env_lookup($env, $name) {
                        None { Err(g3_unsupported()) }
                        Some($var) {
                            match $var.kind {
                                CgClass($cn) {
                                    match cg_env_lookup_class($env, $cn) {
                                        None { Err(g3_unsupported()) }
                                        Some($info) {
                                            match g8_class_field_lookup($info.fields, $field) {
                                                None { Err(g3_unsupported()) }
                                                Some($f) {
                                                    $fa = g8_field_acc_of($var.cname, false, $f)
                                                    match $f.kind {
                                                        CgEnum($en) {
                                                            Ok(g6_materialize(CgEnum($en), CgValueOut(state: $state, c: $fa.acc)))
                                                        }
                                                        # `match $obj.field` where field is an Option[<class>]
                                                        # carrier (E5d-7c-2d-5). The object owns the field, so the
                                                        # materialised temp is BORROWED (g6_materialize's default)
                                                        # and g6_lower_match leaves it un-released — the class's own
                                                        # release helper drops the embedded Some payload once. The
                                                        # None/Some arms read its tag/`.val` the same way a scalar
                                                        # Option scrutinee does.
                                                        CgOptClass($en) {
                                                            Ok(g6_materialize(CgOptClass($en), CgValueOut(state: $state, c: $fa.acc)))
                                                        }
                                                        # `match $obj.field` where field is an Option[<enum>]
                                                        # carrier (E5d-7c-2d-8). As with Option[class], this is a
                                                        # BORROWED scrutinee: the owning class releases the active
                                                        # Some enum payload exactly once.
                                                        CgOptEnum($en) {
                                                            Ok(g6_materialize(CgOptEnum($en), CgValueOut(state: $state, c: $fa.acc)))
                                                        }
                                                        _ { Err(g3_unsupported()) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Materialise a `match $x` scrutinee where `$x` is a BOUND local of a by-value
# Option carrier kind (Option[<class>] or Option[<enum>], slice 5 E5d-7c-2d-7). The
# scalar Option scrutinee path (g6_option_value CgOptInt..CgOptStr) cannot reach a
# carrier whose name is program-dependent, so this looks the bound var up directly
# and materialises a BORROWED copy (g6_materialize's default). The match must NOT
# release it — the binding's owner (the enclosing enum/class) drops the payload
# exactly once — and the None/Some arms read its `.tag`/`.val` like a scalar Option.
sub g6_scrut_bound_option($subject: Expr, $state: CgState, $env: CgEnv): Result[ScrutOut, Str] {
    match $subject {
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgOptClass($cn) { Ok(g6_materialize(CgOptClass($cn), CgValueOut(state: $state, c: $v.cname))) }
                        CgOptEnum($en) { Ok(g6_materialize(CgOptEnum($en), CgValueOut(state: $state, c: $v.cname))) }
                        CgOptList($el) { Ok(g6_materialize(CgOptList($el), CgValueOut(state: $state, c: $v.cname))) }
                        # A bound Option[Map] recv carrier (`$opt = $ch.recv()` on
                        # Chan[Map[Str,V]]) matched with Some(%m)/None (P8d-2c-3d-2).
                        # Borrowed like the List arm: the local keeps scope-exit
                        # ownership of both counted arrays; the Some binder reads
                        # `.val.keys`/`.val.vals` through the struct-form sentinel.
                        CgOptMap($mval) { Ok(g6_materialize(CgOptMap($mval), CgValueOut(state: $state, c: $v.cname))) }
                        CgOptMatch { Ok(g6_materialize(CgOptMatch, CgValueOut(state: $state, c: $v.cname))) }
                        CgOptBush { Ok(g6_materialize(CgOptBush, CgValueOut(state: $state, c: $v.cname))) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# A value-position `match` whose scrutinee is an Option[<user enum>]/Option[<user
# class>] EXPRESSION rather than a bound name — the real source's `env_lookup` /
# `bind_lookup` chains match the FRESH `Option[Value]` returned by a call directly
# (`match bind_lookup($binds, $name) { Some($v) {..} None {..} }`). The scalar
# Option carriers already reach g6_lower_scrutinee through g6_option_value, but the
# CgOptEnum/CgOptClass carriers need their name resolved from the call's return
# signature before the value can be lowered. Discover the carrier kind via
# g5_resolve_call_target, lower the fresh OWNED option value through g6_option_value
# (the same path used for an Option[scalar] call scrutinee), and materialise it
# un-borrowed so g6_lower_match releases the active Some payload's owned fields after
# the arm chain. The EName case stays borrowed (its binding/caller owns it) above.
sub g6_scrut_call_option($subject: Expr, $state: CgState, $env: CgEnv): Result[ScrutOut, Str] {
    match $subject {
        ECall($callee, $args) {
            match g5_resolve_call_target($callee, $args, $env) {
                Err($m) { Err($m) }
                Ok($t) {
                    match $t.sig.ret {
                        ROpt($k) {
                            match $k {
                                CgOptEnum($en) { g6_scrut_owned_option(CgOptEnum($en), $subject, $state, $env) }
                                CgOptClass($cn) { g6_scrut_owned_option(CgOptClass($cn), $subject, $state, $env) }
                                CgOptList($el) { g6_scrut_owned_option(CgOptList($el), $subject, $state, $env) }
                                CgOptMap($mval) { g6_scrut_owned_option(CgOptMap($mval), $subject, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Lower a fresh OWNED Option[<carrier>] scrutinee value into `gm` and mark it
# un-borrowed, so g6_lower_match drops its active Some payload after the chain.
sub g6_scrut_owned_option($kind: CgKind, $subject: Expr, $state: CgState, $env: CgEnv): Result[ScrutOut, Str] {
    match g6_option_value($kind, $subject, $state, $env) {
        Err($m) { Err($m) }
        Ok($v) {
            $sc = g6_materialize($kind, $v)
            Ok(ScrutOut(state: $sc.state, gm: $sc.gm, kind: $sc.kind, borrowed: false))
        }
    }
}

# Discover the scrutinee's scalar kind and materialise it into `gm`. The try-order
# (Int -> Float -> Bool -> Str) is unambiguous because each kind-lowerer rejects a
# non-matching operand kind (typecheck already accepted the program). A Str
# scrutinee uses g3_str_lower's owned temp directly (released after the match).
sub g6_lower_scrutinee($subject: Expr, $state: CgState, $env: CgEnv): Result[ScrutOut, Str] {
    match g6e_enum_carrier_of($subject, $env) {
        Some($en) {
            match cg_env_lookup($env, match $subject { EName($n) { $n } _ { "" } }) {
                Some($var) { Ok(g6_materialize(CgEnum($en), CgValueOut(state: $state, c: $var.cname))) }
                None { Err(g3_unsupported()) }
            }
        }
        None {
    match g6_scrut_bound_option($subject, $state, $env) {
        Ok($sc) { Ok($sc) }
        Err($mbo) {
    match g6_scrut_call_option($subject, $state, $env) {
        Ok($sc) { Ok($sc) }
        Err($mco) {
    match g6_scrut_class_enum_field($subject, $state, $env) {
        Ok($sc) { Ok($sc) }
        Err($mcf) {
    match g6_scrut_enum_value($subject, $state, $env) {
        Ok($sc) { Ok($sc) }
        Err($menum) {
    match g3_int_rvalue_state($subject, $state, $env) {
        Ok($v) { Ok(g6_materialize(CgInt, $v)) }
        Err($mi) {
            match g3b_float_rvalue_state($subject, $state, $env) {
                Ok($v) { Ok(g6_materialize(CgFloat, $v)) }
                Err($mf) {
                    match g4_bool_lower($subject, $state, $env) {
                        Ok($bl) { Ok(g6_materialize(CgBool, CgValueOut(state: $bl.state, c: $bl.c))) }
                        Err($mb) {
                            match g3_str_lower($subject, $state, $env) {
                                Ok($sl) { Ok(ScrutOut(state: $sl.state, gm: $sl.tmp, kind: CgStr, borrowed: false)) }
                                Err($ms) {
                                    match g6_option_value(CgOptInt, $subject, $state, $env) {
                                        Ok($v) { Ok(g6_materialize(CgOptInt, $v)) }
                                        Err($moi) {
                                            match g6_option_value(CgOptFloat, $subject, $state, $env) {
                                                Ok($v) { Ok(g6_materialize(CgOptFloat, $v)) }
                                                Err($mof) {
                                                    match g6_option_value(CgOptBool, $subject, $state, $env) {
                                                        Ok($v) { Ok(g6_materialize(CgOptBool, $v)) }
                                                        Err($mob) {
                                                            match g6_option_value(CgOptStr, $subject, $state, $env) {
                                                                Ok($v) { Ok(g6_materialize(CgOptStr, $v)) }
                                                                Err($mos) {
                                                                    match g6_option_value(CgOptMatch, $subject, $state, $env) {
                                                                        Ok($v) {
                                                                            $sc = g6_materialize(CgOptMatch, $v)
                                                                            Ok(ScrutOut(state: $sc.state, gm: $sc.gm, kind: $sc.kind, borrowed: false))
                                                                        }
                                                                        Err($mom) {
                                                                            match g6_option_value(CgOptBush, $subject, $state, $env) {
                                                                                Ok($v) {
                                                                                    $sc = g6_materialize(CgOptBush, $v)
                                                                                    Ok(ScrutOut(state: $sc.state, gm: $sc.gm, kind: $sc.kind, borrowed: false))
                                                                                }
                                                                                Err($mobu) {
                                                                            match g6_get_option_kind_from_value($subject, $env) {
                                                                                Ok($okind) { g6_scrut_owned_option($okind, $subject, $state, $env) }
                                                                                Err($mget) {
                                                                            match g7_find_option_kind_from_value($subject, $env) {
                                                                                Ok($okind) { g6_scrut_owned_option($okind, $subject, $state, $env) }
                                                                                Err($mfl) {
                                                                                    match g6_result_carrier_of($subject, $env) {
                                                                                        Err($mr) { Err(g3_unsupported()) }
                                                                                        Ok($rk) {
                                                                                            match g6_result_value($rk, $subject, $state, $env) {
                                                                                                Ok($v) { Ok(g6_materialize($rk, $v)) }
                                                                                                Err($mrv) { Err($mrv) }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                            }
                                                                            }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
}

# Compile a PLit arm's condition: equality of the scrutinee temp `$gm` against the
# pattern literal, in the scrutinee's kind. Pure for Int/Float/Bool; Str adds an
# intern and compares by counted value. The literal lowers under the scrutinee kind
# (typecheck guarantees the pattern type matches the scrutinee).
sub g6_arm_cond($skind: CgKind, $gm: Str, $lit: Expr, $state: CgState, $env: CgEnv): Result[BoolLower, Str] {
    match $skind {
        CgInt {
            match g3_int_rvalue($lit, $env) {
                Err($m) { Err($m) }
                Ok($lc) { Ok(BoolLower(state: $state, c: "((" ~ $gm ~ ") == (" ~ $lc ~ "))")) }
            }
        }
        CgFloat {
            match g3b_float_rvalue($lit, $env) {
                Err($m) { Err($m) }
                Ok($lc) { Ok(BoolLower(state: $state, c: "((" ~ $gm ~ ") == (" ~ $lc ~ "))")) }
            }
        }
        CgBool {
            match g4_bool_lower($lit, $state, $env) {
                Err($m) { Err($m) }
                Ok($bl) { Ok(BoolLower(state: $bl.state, c: "((" ~ $gm ~ ") == (" ~ $bl.c ~ "))")) }
            }
        }
        CgStr {
            match $lit {
                EStr($text) {
                    $intern = g6_str_intern(pattern_static_string_text($text), $state)
                    Ok(BoolLower(state: $intern.state, c: "guji_str_equal(" ~ $gm ~ ", " ~ $intern.c ~ ")"))
                }
                ERawStr($text) {
                    $intern = g6_str_intern($text, $state)
                    Ok(BoolLower(state: $intern.state, c: "guji_str_equal(" ~ $gm ~ ", " ~ $intern.c ~ ")"))
                }
                _ { Err(g3_unsupported()) }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# ---- G6b-b (guards): lower a match-arm guard (`pat if cond`, §10.2) ---------
# A guard is an extra Bool condition that must hold for the arm to fire even after
# its pattern matches (§10.2). Codegen lowers a guard into the SAME `if`/`else if`
# chain as the pattern test: a PLit-with-guard arm becomes
# `if (((gm) == lit) && (guard))`, and a `_`/bind-with-guard arm becomes
# `else if (guard)`. C's `&&` short-circuits, so the guard is evaluated only after
# the pattern test passes — exactly the interpreter's "match pattern, then guard"
# order (§10.2). A guarded arm is NOT a catch-all (it can fail), so it may appear in
# any position and the chain still requires a final UNCONDITIONAL `_`/bind arm
# (typecheck enforces exhaustiveness; g6_lower_arms Errs if the chain ends on a
# guarded arm). The inline path accepts only nontrapping atomic numeric operands;
# arithmetic, calls, and owned values decline into the stateful guard path so their
# preparation and traps remain in Guji source order.
sub g6_guard_float_atomic($e: Expr, $env: CgEnv): Result[Str, Str] {
    match $e {
        EFloat($t) { g3b_float_rvalue($e, $env) }
        EName($n) { g3b_float_rvalue($e, $env) }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_guard_cmp_pure($op: Str, $l: Expr, $r: Expr, $env: CgEnv): Result[Str, Str] {
    match g3_int_atomic_rvalue($l, $env) {
        Ok($lc) {
            match g3_int_atomic_rvalue($r, $env) {
                Ok($rc) { g4_compare_c($op, $lc, $rc) }
                Err($m) { Err($m) }
            }
        }
        Err($mi) {
            match g6_guard_float_atomic($l, $env) {
                Ok($lc) {
                    match g6_guard_float_atomic($r, $env) {
                        Ok($rc) { g4_compare_c($op, $lc, $rc) }
                        Err($m) { Err($m) }
                    }
                }
                Err($mf) {
                    if $op == "==" || $op == "!=" {
                        match g6_guard_pure($l, $env) {
                            Ok($lc) {
                                match g6_guard_pure($r, $env) {
                                    Ok($rc) { g4_compare_c($op, $lc, $rc) }
                                    Err($m) { Err($m) }
                                }
                            }
                            Err($m) { Err($m) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
            }
        }
    }
}

sub g6_guard_pure($e: Expr, $env: CgEnv): Result[Str, Str] {
    match $e {
        EBool($text) {
            if $text == "true" { Ok("1LL") } else { Ok("0LL") }
        }
        EName($n) {
            match cg_env_lookup($env, $n) {
                None { Err(g3_unsupported()) }
                Some($v) {
                    match $v.kind {
                        CgBool { Ok($v.cname) }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
        EUnary($op, $x) {
            if $op == "!" {
                match g6_guard_pure($x, $env) {
                    Err($m) { Err($m) }
                    Ok($c) { Ok("(!(" ~ $c ~ "))") }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        EBinary($op, $l, $r) {
            if $op == "&&" || $op == "||" {
                match g6_guard_pure($l, $env) {
                    Err($m) { Err($m) }
                    Ok($lc) {
                        match g6_guard_pure($r, $env) {
                            Err($m) { Err($m) }
                            Ok($rc) { Ok("((" ~ $lc ~ ") " ~ $op ~ " (" ~ $rc ~ "))") }
                        }
                    }
                }
            } else {
                g6_guard_cmp_pure($op, $l, $r, $env)
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

# Emit one guarded arm's `if`/`else if (cond) { body }` segment. `$cond` is the full
# already-combined condition (pattern test `&&` guard, or just the guard for a
# catch-all-shaped pattern). `$body_env` carries any PBind capture so the body (and
# the guard, lowered by the caller) can reference it. Returns the chain state; the
# caller recurses on the remaining arms with the ORIGINAL env (the capture scopes
# only this arm).
sub g6_emit_guarded_seg($rkind: CgKind, $res: Str, $cond: Str, $body: StmtList, $first: Bool, $state: CgState, $body_env: CgEnv): Result[CgState, Str] {
    $outer_body = $state.body
    $br_start = g4_bodyless_state($state)
    match g4_branch_block_kind($rkind, $body, $br_start, $body_env) {
        Err($m) { Err($m) }
        Ok($br) {
            $kw = if $first { "\tif (" } else { " else if (" }
            $seg = $kw ~ $cond ~ ") \{\n" ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t}"
            Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
        }
    }
}

# Emit the trailing catch-all arm (`else if (1) { ... }`, or `if (1)` when it is the
# only arm). `$bind` is Some(name) for a PBind catch-all: a fresh local of the
# scrutinee kind aliases `$gm` (borrowed for Str, so branch cleanup does not release
# it — the scrutinee owns the value). The arm body lowers like an `if` branch.
sub g6_emit_catchall($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $bind: Option[Str], $body: StmtList, $first: Bool, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    $outer_body = $state.body
    $kw = if $first { "\tif (1) \{\n" } else { " else if (1) \{\n" }
    match $bind {
        None {
            $br_start = g4_bodyless_state($state)
            match g4_branch_block_kind($rkind, $body, $br_start, $env) {
                Err($m) { Err($m) }
                Ok($br) {
                    $seg = $kw ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t}\n"
                    Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
                }
            }
        }
        Some($name) {
            $bindtmp = "gv" ~ c_int($state.ntmp)
            $borrowed = match $skind { CgStr { true } CgOptStr { true } CgRes($ok, $err) { g6_result_has_str($skind) } CgEnum($n) { true } _ { false } }
            $st_decl = CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl($skind, $bindtmp), body: "", nstr: $state.nstr, ntmp: $state.ntmp + 1)
            $arm_env = CgEnvCons(CgVar(name: $name, cname: $bindtmp, kind: $skind, mutable: false, borrowed: $borrowed, listlen: 0), $env)
            match g4_branch_block_kind($rkind, $body, $st_decl, $arm_env) {
                Err($m) { Err($m) }
                Ok($br) {
                    $assign = "\t\t" ~ $bindtmp ~ " = " ~ $gm ~ ";\n"
                    $seg = $kw ~ $assign ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t}\n"
                    Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
                }
            }
        }
    }
}

sub g6_and_cond($left: Str, $right: Str): Str {
    if $left == "" {
        $right
    } else if $right == "" {
        $left
    } else {
        $left ~ " && " ~ $right
    }
}

sub g6_nested_pattern_cond($fk: CgKind, $value: Str, $pat: Pattern, $env: CgEnv): Result[Str, Str] {
    match $pat {
        PBind($name) { Ok("") }
        PWild { Ok("") }
        PVariant($name, $args) {
            if g6_is_option_kind($fk) {
                # A nested `None` / `Some(...)` sub-pattern over an Option carrier
                # field (CgOptEnum/CgOptClass etc.) — the carrier struct decides the
                # arm by its `.tag` (0 = None, 1 = Some), exactly like the top-level
                # option branch of g6_variant_cond. The Some payload binding (if any)
                # is established in g6_nested_pattern_env; deeper sub-patterns inside
                # Some are rejected there, so checking the tag alone is sufficient
                # here (slice 5 E5d-8m).
                match cg_reg_builtin_variant(cg_reg_option().variants, $name) {
                    Err($m) { Err($m) }
                    Ok($vm) {
                        if cg_ftlist_len($vm.fields) == patternlist_len($args) {
                            Ok("(" ~ $value ~ ").tag == " ~ c_int($vm.tag) ~ "LL")
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            } else {
                match $fk {
                    CgEnum($en) {
                        match cg_reg_user_variant($env, $en, $name) {
                            Err($m) { Err($m) }
                            Ok($vu) {
                                if cg_ftlist_len($vu.meta.fields) == patternlist_len($args) {
                                    match g6_nested_pattern_conds($vu.info.variants, $vu.meta.fields, $args, "(" ~ $value ~ ")", 0, $env) {
                                        Err($m) { Err($m) }
                                        Ok($extra) { Ok(g6_and_cond("(" ~ $value ~ ").tag == " ~ c_int($vu.meta.tag) ~ "LL", $extra)) }
                                    }
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                        }
                    }
                    CgBoxEnum($en) {
                        match cg_reg_user_variant($env, $en, $name) {
                            Err($m) { Err($m) }
                            Ok($vu) {
                                if cg_ftlist_len($vu.meta.fields) == patternlist_len($args) {
                                    match g6_nested_pattern_conds($vu.info.variants, $vu.meta.fields, $args, "(" ~ $value ~ ")", 0, $env) {
                                        Err($m) { Err($m) }
                                        Ok($extra) { Ok(g6_and_cond("(" ~ $value ~ ").tag == " ~ c_int($vu.meta.tag) ~ "LL", $extra)) }
                                    }
                                } else {
                                    Err(g3_unsupported())
                                }
                            }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6_nested_pattern_conds($allvars: CgVariantInfoList, $fields: CgFieldTyList, $args: PatternList, $gm: Str, $idx: Int, $env: CgEnv): Result[Str, Str] {
    match $fields {
        FtNil {
            match $args {
                PatNil { Ok("") }
                _ { Err(g3_unsupported()) }
            }
        }
        FtCons($ft, $frest) {
            match cg_reg_ft_kind($ft) {
                Err($m) { Err($m) }
                Ok($fk) {
                    if !g6e_field_supported($fk) {
                        Err(g3_unsupported())
                    } else {
                        match $args {
                            PatNil { Err(g3_unsupported()) }
                            PatCons($p, $prest) {
                                $field = g6e_field_accessor($allvars, $gm, $idx, $fk)
                                match g6_nested_pattern_cond($fk, $field, $p, $env) {
                                    Err($m) { Err($m) }
                                    Ok($here) {
                                        match g6_nested_pattern_conds($allvars, $frest, $prest, $gm, $idx + 1, $env) {
                                            Err($m) { Err($m) }
                                            Ok($rest) { Ok(g6_and_cond($here, $rest)) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Extra match condition for a NESTED sub-pattern in a builtin carrier's payload
# slot. A simple payload pattern (PBind/PWild/PLit) adds NOTHING beyond the
# variant tag test — the binding side (g6_variant_env) fully decides the arm. But a
# nested PVariant payload (e.g. `Ok(Some($n))`/`Ok(None)` over
# `Result[Option[T], Str]`) must ALSO test the inner carrier tag, or `Ok(Some(..))`
# and `Ok(None)` would emit the SAME condition and the first arm would always win.
# We recurse through g6_nested_pattern_cond against the slot's value kind: `.ok`/
# `.err` for a Result carrier, `.val` for an Option Some. (slice 5 E5d-8x; matches
# the source's `match g5_unit_call_code(..) { Ok(Some($next)).. Ok(None).. }`.)
sub g6_carrier_payload_cond($skind: CgKind, $gm: Str, $name: Str, $args: PatternList, $env: CgEnv): Result[Str, Str] {
    match $args {
        PatNil { Ok("") }
        PatCons($p, PatNil) {
            match $p {
                PVariant($vn, $va) {
                    if $name == "Ok" {
                        g6_nested_pattern_cond(g6_result_ok_kind($skind), $gm ~ ".ok", $p, $env)
                    } else if $name == "Err" {
                        g6_nested_pattern_cond(g6_result_err_kind($skind), $gm ~ ".err", $p, $env)
                    } else if $name == "Some" {
                        match g6_option_payload_kind($skind) {
                            Err($m) { Err($m) }
                            Ok($pk) { g6_nested_pattern_cond($pk, $gm ~ ".val", $p, $env) }
                        }
                    } else {
                        Err(g3_unsupported())
                    }
                }
                _ { Ok("") }
            }
        }
        _ { Ok("") }
    }
}

sub g6_variant_cond($skind: CgKind, $gm: Str, $name: Str, $args: PatternList, $env: CgEnv): Result[Str, Str] {
    if g6_is_enum_kind($skind) {
        match $skind {
            CgEnum($en) {
                match cg_reg_user_variant($env, $en, $name) {
                    Err($m) { Err($m) }
                    Ok($vu) {
                        if cg_ftlist_len($vu.meta.fields) == patternlist_len($args) {
                            match g6_nested_pattern_conds($vu.info.variants, $vu.meta.fields, $args, $gm, 0, $env) {
                                Err($m) { Err($m) }
                                Ok($extra) { Ok(g6_and_cond($gm ~ ".tag == " ~ c_int($vu.meta.tag) ~ "LL", $extra)) }
                            }
                        } else {
                            Err(g3_unsupported())
                        }
                    }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else if g6_is_option_kind($skind) {
        match cg_reg_builtin_variant(cg_reg_option().variants, $name) {
            Err($m) { Err($m) }
            Ok($vm) {
                if cg_ftlist_len($vm.fields) == patternlist_len($args) {
                    match g6_carrier_payload_cond($skind, $gm, $name, $args, $env) {
                        Err($m) { Err($m) }
                        Ok($extra) { Ok(g6_and_cond($gm ~ ".tag == " ~ c_int($vm.tag) ~ "LL", $extra)) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
    } else if g6_is_result_kind($skind) {
        match cg_reg_builtin_variant(cg_reg_result().variants, $name) {
            Err($m) { Err($m) }
            Ok($vm) {
                if cg_ftlist_len($vm.fields) == patternlist_len($args) {
                    match g6_carrier_payload_cond($skind, $gm, $name, $args, $env) {
                        Err($m) { Err($m) }
                        Ok($extra) { Ok(g6_and_cond($gm ~ ".tag == " ~ c_int($vm.tag) ~ "LL", $extra)) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
    } else {
        Err(g3_unsupported())
    }
}

sub cgkindlist_len($ks: CgKindList): Int {
    match $ks {
        CgKindNil { 0 }
        CgKindCons($h, $t) { 1 + cgkindlist_len($t) }
    }
}

sub patternlist_len($ps: PatternList): Int {
    match $ps {
        PatNil { 0 }
        PatCons($h, $t) { 1 + patternlist_len($t) }
    }
}

# C accessor for the field at position $idx of scrutinee $gm: a plain scalar slot is `gm.fN`;
# a union slot adds the kind-appropriate member designator (`gm.fN.i` / `gm.fN.f`).
sub g6e_field_accessor($allvars: CgVariantInfoList, $gm: Str, $idx: Int, $fk: CgKind): Str {
    $raw = if g6e_pos_is_union($allvars, $idx) {
        $gm ~ ".f" ~ c_int($idx) ~ g6e_union_member($fk)
    } else {
        $gm ~ ".f" ~ c_int($idx)
    }
    match $fk {
        CgEnum($en) {
            if g6e_pos_is_union($allvars, $idx) {
                "(*((" ~ $en ~ "*)" ~ $raw ~ "))"
            } else {
                $raw
            }
        }
        CgBoxEnum($en) { "*((" ~ $en ~ "*)" ~ $raw ~ ")" }
        CgBoxClass($cn) { "(*((" ~ $cn ~ "*)" ~ $raw ~ "))" }
        CgBoxOptClass($cn) { "(*((guji_opt_" ~ $cn ~ "*)" ~ $raw ~ "))" }
        CgBoxOptEnum($en) { "(*((guji_opt_" ~ $en ~ "*)" ~ $raw ~ "))" }
        CgClass($cn) {
            if g6e_pos_is_union($allvars, $idx) {
                "(*((" ~ $cn ~ "*)" ~ $raw ~ "))"
            } else {
                $raw
            }
        }
        # An Option[class]/Option[enum] carrier in a mixed union slot is a counted
        # heap box at `.p` (E5d-8h-3b); dereference it to a borrowed carrier lvalue
        # so nested `.tag`/`.val` pattern access works. A non-union (homogeneous)
        # carrier slot stays the by-value member.
        CgOptClass($cn) {
            if g6e_pos_is_union($allvars, $idx) {
                "(*((guji_opt_" ~ $cn ~ "*)" ~ $raw ~ "))"
            } else {
                $raw
            }
        }
        CgOptEnum($cn) {
            if g6e_pos_is_union($allvars, $idx) {
                "(*((guji_opt_" ~ $cn ~ "*)" ~ $raw ~ "))"
            } else {
                $raw
            }
        }
        CgHandle {
            if g6e_pos_is_union($allvars, $idx) {
                "((guji_reader_t*)" ~ $raw ~ ")"
            } else {
                $raw
            }
        }
        CgChan($el) {
            if g6e_pos_is_union($allvars, $idx) {
                "((guji_chan_t*)" ~ $raw ~ ")"
            } else {
                $raw
            }
        }
        _ { $raw }
    }
}

# The `listlen` to record for a match-bound carrier field. A bound `List` field is a
# by-value `guji_slice_t` accessed via `.data`/`.len` — the SAME slice form a
# listlen-0 list binding uses (g7_list_var_data/len), so 0 is correct (empty list
# bindings are out of subset, so listlen 0 is unambiguously the slice form). A bound
# `Map` field is a by-value `guji_map_t` accessed via `.keys`/`.vals`/`.len`; that
# struct form is keyed by the NEGATIVE listlen sentinel (g7_map_var_*), because a
# listlen-0 map binding is the empty NAMED two-array form, not the struct form.
sub g6e_field_bind_listlen($fk: CgKind): Int {
    match $fk {
        CgMap($v) { 0 - 1 }
        _ { 0 }
    }
}

sub g6e_field_bind_kind($fk: CgKind): CgKind {
    match $fk {
        CgBoxEnum($en) { CgEnum($en) }
        CgBoxClass($cn) { CgClass($cn) }
        CgBoxOptClass($cn) { CgOptClass($cn) }
        CgBoxOptEnum($en) { CgOptEnum($en) }
        _ { $fk }
    }
}

sub g6_nested_pattern_env($fk: CgKind, $pat: Pattern, $field: Str, $env: CgEnv): Result[CgEnv, Str] {
    match $pat {
        PBind($bind_name) {
            Ok(CgEnvCons(CgVar(name: $bind_name, cname: $field, kind: g6e_field_bind_kind($fk), mutable: false, borrowed: true, listlen: g6e_field_bind_listlen($fk)), $env))
        }
        PWild { Ok($env) }
        PVariant($name, $args) {
            if g6_is_option_kind($fk) {
                # Bind the payload of a nested `Some($v)` over an Option-carrier field
                # to the carrier's borrowed `.val` slot (the enclosing enum owns it),
                # mirroring the top-level option branch of g6_variant_env. `None` binds
                # nothing; deeper sub-patterns inside Some are out of subset (slice 5
                # E5d-8m).
                if $name == "Some" {
                    match $args {
                        PatCons($p, PatNil) {
                            match $p {
                                PBind($bind_name) {
                                    match g6_option_payload_kind($fk) {
                                        Err($m) { Err($m) }
                                        Ok($pk) { Ok(CgEnvCons(CgVar(name: $bind_name, cname: $field ~ ".val", kind: $pk, mutable: false, borrowed: true, listlen: 0), $env)) }
                                    }
                                }
                                PWild { Ok($env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                } else if $name == "None" {
                    match $args {
                        PatNil { Ok($env) }
                        _ { Err(g3_unsupported()) }
                    }
                } else {
                    Err(g3_unsupported())
                }
            } else {
                match $fk {
                    CgEnum($en) {
                        match cg_reg_user_variant($env, $en, $name) {
                            Err($m) { Err($m) }
                            Ok($vu) { cg_reg_variant_field_env($vu.info.variants, $vu.meta.fields, $args, "(" ~ $field ~ ")", 0, $env) }
                        }
                    }
                    CgBoxEnum($en) {
                        match cg_reg_user_variant($env, $en, $name) {
                            Err($m) { Err($m) }
                            Ok($vu) { cg_reg_variant_field_env($vu.info.variants, $vu.meta.fields, $args, "(" ~ $field ~ ")", 0, $env) }
                        }
                    }
                    _ { Err(g3_unsupported()) }
                }
            }
        }
        _ { Err(g3_unsupported()) }
    }
}

sub g6e_variant_field_env($allvars: CgVariantInfoList, $fields: CgKindList, $args: PatternList, $gm: Str, $idx: Int, $env: CgEnv): Result[CgEnv, Str] {
    match $fields {
        CgKindNil {
            match $args {
                PatNil { Ok($env) }
                _ { Err(g3_unsupported()) }
            }
        }
        CgKindCons($fk, $frest) {
            if !g6e_field_supported($fk) {
                Err(g3_unsupported())
            } else {
                match $args {
                    PatNil { Err(g3_unsupported()) }
                    PatCons($p, $prest) {
                        $field = g6e_field_accessor($allvars, $gm, $idx, $fk)
                        match g6_nested_pattern_env($fk, $p, $field, $env) {
                            Err($m) { Err($m) }
                            Ok($env2) { g6e_variant_field_env($allvars, $frest, $prest, $gm, $idx + 1, $env2) }
                        }
                    }
                }
            }
        }
    }
}

sub cg_reg_variant_field_env($allvars: CgVariantInfoList, $fields: CgFieldTyList, $args: PatternList, $gm: Str, $idx: Int, $env: CgEnv): Result[CgEnv, Str] {
    match $fields {
        FtNil {
            match $args {
                PatNil { Ok($env) }
                _ { Err(g3_unsupported()) }
            }
        }
        FtCons($ft, $frest) {
            match cg_reg_ft_kind($ft) {
                Err($m) { Err($m) }
                Ok($fk) {
                    if !g6e_field_supported($fk) {
                        Err(g3_unsupported())
                    } else {
                        match $args {
                            PatNil { Err(g3_unsupported()) }
                            PatCons($p, $prest) {
                                $field = g6e_field_accessor($allvars, $gm, $idx, $fk)
                                match g6_nested_pattern_env($fk, $p, $field, $env) {
                                    Err($m) { Err($m) }
                                    Ok($env2) { cg_reg_variant_field_env($allvars, $frest, $prest, $gm, $idx + 1, $env2) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g6_variant_env($skind: CgKind, $gm: Str, $name: Str, $args: PatternList, $env: CgEnv): Result[CgEnv, Str] {
    if g6_is_enum_kind($skind) {
        match $skind {
            CgEnum($en) {
                match cg_reg_user_variant($env, $en, $name) {
                    Err($m) { Err($m) }
                    Ok($vu) { cg_reg_variant_field_env($vu.info.variants, $vu.meta.fields, $args, $gm, 0, $env) }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else if $name == "Some" {
        match $args {
            PatCons($p, PatNil) {
                match $p {
                    PBind($bind_name) {
                        match g6_option_payload_kind($skind) {
                            Err($m) { Err($m) }
                            Ok($pk) {
                                # A Map payload binder is the by-value guji_map_t at
                                # `.val` — mark it with the struct-form NEGATIVE
                                # listlen sentinel so g7_map_var_* read
                                # `.val.keys`/`.vals`/`.len` (a listlen-0 map would
                                # misread as the named two-array form; see
                                # g7_map_var_keys). List payloads keep 0: that IS
                                # the slice form.
                                $ll = match $pk {
                                    CgMap($mval) { 0 - 1 }
                                    _ { if g6_option_regex_marker($gm, $env) { g6_regex_str_listlen() } else { 0 } }
                                }
                                Ok(CgEnvCons(CgVar(name: $bind_name, cname: $gm ~ ".val", kind: $pk, mutable: false, borrowed: true, listlen: $ll), $env))
                            }
                        }
                    }
                    PWild { Ok($env) }
                    _ { Err(g3_unsupported()) }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else if $name == "None" {
        match $args {
            PatNil { Ok($env) }
            _ { Err(g3_unsupported()) }
        }
    } else if $name == "Ok" {
        match $args {
            PatCons($p, PatNil) {
                match $p {
                    # A Map Ok payload binder is the by-value guji_map_t at `.ok` —
                    # mark it with the struct-form NEGATIVE listlen sentinel so
                    # g7_map_var_* read `.ok.keys`/`.vals`/`.len` (a listlen-0 map
                    # would misread as the named two-array form; mirrors Some(%m)
                    # over Option[Map] and g6e_field_bind_listlen). List Ok payloads
                    # keep 0: that IS the slice form.
                    PBind($bind_name) {
                        $pk = g6_result_ok_kind($skind)
                        $ll = match $pk {
                            CgMap($mval) { 0 - 1 }
                            CgStr {
                                if g6_option_regex_marker($gm, $env) {
                                    g6_regex_str_listlen()
                                } else {
                                    0
                                }
                            }
                            _ { 0 }
                        }
                        Ok(CgEnvCons(CgVar(name: $bind_name, cname: $gm ~ ".ok", kind: $pk, mutable: false, borrowed: true, listlen: $ll), $env))
                    }
                    PWild { Ok($env) }
                    # A unit pattern `Ok(())` binds nothing — `Unit` has a single
                    # value, so the tag test (`g6_variant_cond`) fully decides the
                    # arm. NATIVE rejects this LiteralPattern in codegen; the real
                    # source uses it pervasively in `Result[Unit, Str]` matches, so
                    # this is interp-oracle / beyond-native (slice 5 E5d-7c-2d-11).
                    PLit($lit) { match $lit { EUnit { Ok($env) } _ { Err(g3_unsupported()) } } }
                    # A nested carrier sub-pattern `Ok(Some($n))`/`Ok(None)` over a
                    # `Result[Option[T], _]` Ok slot: bind through the inner Option
                    # carrier at `.ok` (slice 5 E5d-8x). The cond side
                    # (g6_carrier_payload_cond) emits the matching inner tag test.
                    PVariant($vn, $va) { g6_nested_pattern_env(g6_result_ok_kind($skind), $p, $gm ~ ".ok", $env) }
                    _ { Err(g3_unsupported()) }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else if $name == "Err" {
        match $args {
            PatCons($p, PatNil) {
                match $p {
                    # Same Map struct-form listlen rule as Ok(%m) — an Err(Map)
                    # binder aliases `.err` as a by-value guji_map_t.
                    PBind($bind_name) {
                        $pk = g6_result_err_kind($skind)
                        $ll = match $pk {
                            CgMap($mval) { 0 - 1 }
                            _ { 0 }
                        }
                        Ok(CgEnvCons(CgVar(name: $bind_name, cname: $gm ~ ".err", kind: $pk, mutable: false, borrowed: true, listlen: $ll), $env))
                    }
                    PWild { Ok($env) }
                    PVariant($vn, $va) { g6_nested_pattern_env(g6_result_err_kind($skind), $p, $gm ~ ".err", $env) }
                    _ { Err(g3_unsupported()) }
                }
            }
            _ { Err(g3_unsupported()) }
        }
    } else {
        Err(g3_unsupported())
    }
}

# Match lowering materializes a carrier into a fresh C temp, losing the source
# binding's listlen metadata. An internal empty-name env row carries that one bit
# into g6_variant_env; empty is not a legal guji binding name and the row is
# borrowed, so it cannot collide with or release user state.
sub g6_option_regex_marker($gm: Str, $env: CgEnv): Bool {
    match $env {
        CgEnvNil { false }
        CgEnvCons($h, $t) {
            if $h.name == "" && $h.cname == $gm && $h.listlen == g6_regex_str_listlen() {
                true
            } else {
                g6_option_regex_marker($gm, $t)
            }
        }
        CgEnvSub($s, $t) { g6_option_regex_marker($gm, $t) }
        CgEnvEnum($e, $t) { g6_option_regex_marker($gm, $t) }
        CgEnvClass($c, $t) { g6_option_regex_marker($gm, $t) }
        CgEnvSubIdx($i, $t) { g6_option_regex_marker($gm, $t) }
    }
}

sub g6_match_payload_env($subject: Expr, $gm: Str, $env: CgEnv): CgEnv {
    if g6_expr_is_option_regex($subject, $env) {
        CgEnvCons(CgVar(name: "", cname: $gm, kind: CgOptStr, mutable: false, borrowed: true, listlen: g6_regex_str_listlen()), $env)
    } else if g6_expr_is_result_regex($subject, $env) {
        # Same empty-name marker row as Option[Regex]: Ok($r) reads it via
        # g6_option_regex_marker and stamps listlen -3 onto the Str Ok binder.
        CgEnvCons(CgVar(name: "", cname: $gm, kind: CgRes(CgStr, CgStr), mutable: false, borrowed: true, listlen: g6_regex_str_listlen()), $env)
    } else {
        $env
    }
}

sub g6_emit_variant_seg($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $name: Str, $args: PatternList, $guard: Option[Expr], $body: StmtList, $first: Bool, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match g6_variant_cond($skind, $gm, $name, $args, $env) {
        Err($m) { Err($m) }
        Ok($cond) {
            match g6_variant_env($skind, $gm, $name, $args, $env) {
                Err($m) { Err($m) }
                Ok($arm_env) {
                    $base = "(" ~ $cond ~ ")"
                    match $guard {
                        None { g6_emit_guarded_seg($rkind, $res, $base, $body, $first, $state, $arm_env) }
                        Some($g) {
                            match g6_guard_pure($g, $arm_env) {
                                # P9-8b-2a: a leading variant guard may need
                                # preparatory statements (notably counted Str
                                # comparisons such as `$m.text == "never"`).
                                # Run that prep only after the pattern matched,
                                # cache the Bool, then reuse the ordinary arm
                                # chain so a false guard reaches the wildcard.
                                Err($m) { g6_emit_variant_seg_stateful_first_guard($rkind, $res, $cond, $g, $body, $first, $state, $arm_env) }
                                Ok($gc) { g6_emit_guarded_seg($rkind, $res, $base ~ " && (" ~ $gc ~ ")", $body, $first, $state, $arm_env) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Stateful guards cannot be placed directly in an `if` condition because their
# lowering may allocate/release counted values. For the leading guarded variant,
# first condition that work on the pattern itself (so payload binders are safe),
# save the result in a zero-initialized Bool temp, and then emit the usual first
# arm with `pattern && saved_guard`. Later arms keep the existing path; this slice
# deliberately covers the native gate's guarded-variant + wildcard ownership
# shape without evaluating a later guard before an earlier arm has won.
# P9-8b-2b: when ANY arm needs a stateful guard, `g6_lower_match` prefers the
# matched-flag path below instead of this leading-only special case.
sub g6_emit_variant_seg_stateful_first_guard($rkind: CgKind, $res: Str, $cond: Str, $guard: Expr, $body: StmtList, $first: Bool, $state: CgState, $arm_env: CgEnv): Result[CgState, Str] {
    if !$first {
        Err(g3_unsupported())
    } else {
        match g4_bool_lower($guard, g4_bodyless_state($state), $arm_env) {
            Err($m) { Err($m) }
            Ok($gl) {
                $saved = g4_value_tmp(CgBool, $gl.state.ntmp)
                $prep = CgState(
                    interns: $gl.state.interns,
                    decls: $gl.state.decls ~ g4_value_decl(CgBool, $saved),
                    body: $state.body ~ "\tif (" ~ $cond ~ ") \{\n" ~ $gl.state.body ~ "\t\t" ~ $saved ~ " = " ~ $gl.c ~ ";\n\t}\n",
                    nstr: $gl.state.nstr,
                    ntmp: $gl.state.ntmp + 1
                )
                g6_emit_guarded_seg($rkind, $res, "(" ~ $cond ~ ") && (" ~ $saved ~ ")", $body, true, $prep, $arm_env)
            }
        }
    }
}

# P9-8b-2b: a guard that fails `g6_guard_pure` needs preparatory statements
# (counted Str compares, etc.). Those must run only after the pattern matches
# AND only if no earlier arm already won — native's matched-flag shape.
sub g6_guard_is_stateful($guard: Option[Expr], $arm_env: CgEnv): Bool {
    match $guard {
        None { false }
        Some($g) {
            match g6_guard_pure($g, $arm_env) {
                Ok($gc) { false }
                Err($m) { true }
            }
        }
    }
}

sub g6_option_arms_need_matched($arms: ArmList, $skind: CgKind, $gm: Str, $env: CgEnv): Bool {
    match $arms {
        ArmNil { false }
        ArmCons($arm, $rest) {
            match $arm.pat {
                PVariant($name, $args) {
                    match g6_variant_env($skind, $gm, $name, $args, $env) {
                        Err($m) { g6_guard_is_stateful($arm.guard, $env) || g6_option_arms_need_matched($rest, $skind, $gm, $env) }
                        Ok($arm_env) { g6_guard_is_stateful($arm.guard, $arm_env) || g6_option_arms_need_matched($rest, $skind, $gm, $env) }
                    }
                }
                PWild { g6_guard_is_stateful($arm.guard, $env) || g6_option_arms_need_matched($rest, $skind, $gm, $env) }
                PBind($name) {
                    $arm_env = CgEnvCons(CgVar(name: $name, cname: $gm, kind: $skind, mutable: false, borrowed: true, listlen: 0), $env)
                    g6_guard_is_stateful($arm.guard, $arm_env) || g6_option_arms_need_matched($rest, $skind, $gm, $env)
                }
                PLit($lit) {
                    g6_guard_is_stateful($arm.guard, $env) || g6_option_arms_need_matched($rest, $skind, $gm, $env)
                }
                _ { g6_option_arms_need_matched($rest, $skind, $gm, $env) }
            }
        }
    }
}

# Emit one matched-flag arm: `if (!matched && pattern) { [guard prep; if (g)] body; matched=1 }`.
# Independent `if`s (not else-if) so a later arm's stateful guard prep never runs when an
# earlier arm already set the flag — mirroring native `matchCarrierExpr`.
sub g6_emit_matched_variant_seg($rkind: CgKind, $res: Str, $matched: Str, $cond: Str, $guard: Option[Expr], $body: StmtList, $state: CgState, $arm_env: CgEnv): Result[CgState, Str] {
    $header = "\tif (!" ~ $matched ~ " && (" ~ $cond ~ ")) \{\n"
    $outer_body = $state.body
    $br_start = g4_bodyless_state($state)
    match $guard {
        None {
            match g4_branch_block_kind($rkind, $body, $br_start, $arm_env) {
                Err($m) { Err($m) }
                Ok($br) {
                    $seg = $header ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t\t" ~ $matched ~ " = 1;\n\t}\n"
                    Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
                }
            }
        }
        Some($g) {
            match g4_bool_lower($g, $br_start, $arm_env) {
                Err($m) { Err($m) }
                Ok($gl) {
                    match g4_branch_block_kind($rkind, $body, g4_bodyless_state($gl.state), $arm_env) {
                        Err($m) { Err($m) }
                        Ok($br) {
                            $seg = $header ~ $gl.state.body ~ "\t\tif (" ~ $gl.c ~ ") \{\n" ~ $br.body ~ "\t\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t\t\t" ~ $matched ~ " = 1;\n\t\t}\n\t}\n"
                            Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
                        }
                    }
                }
            }
        }
    }
}

sub g6_emit_matched_catchall($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $matched: Str, $bind: Option[Str], $body: StmtList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    $outer_body = $state.body
    $header = "\tif (!" ~ $matched ~ ") \{\n"
    match $bind {
        None {
            $br_start = g4_bodyless_state($state)
            match g4_branch_block_kind($rkind, $body, $br_start, $env) {
                Err($m) { Err($m) }
                Ok($br) {
                    $seg = $header ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t\t" ~ $matched ~ " = 1;\n\t}\n"
                    Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
                }
            }
        }
        Some($name) {
            $bindtmp = "gv" ~ c_int($state.ntmp)
            $borrowed = match $skind { CgStr { true } CgOptStr { true } CgRes($ok, $err) { g6_result_has_str($skind) } CgEnum($n) { true } _ { false } }
            $st_decl = CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl($skind, $bindtmp), body: "", nstr: $state.nstr, ntmp: $state.ntmp + 1)
            $arm_env = CgEnvCons(CgVar(name: $name, cname: $bindtmp, kind: $skind, mutable: false, borrowed: $borrowed, listlen: 0), $env)
            match g4_branch_block_kind($rkind, $body, $st_decl, $arm_env) {
                Err($m) { Err($m) }
                Ok($br) {
                    $assign = "\t\t" ~ $bindtmp ~ " = " ~ $gm ~ ";\n"
                    $seg = $header ~ $assign ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t\t" ~ $matched ~ " = 1;\n\t}\n"
                    Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
                }
            }
        }
    }
}

sub g6_lower_option_arms_matched($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $matched: Str, $arms: ArmList, $state: CgState, $env: CgEnv, $saw_arm: Bool): Result[CgState, Str] {
    match $arms {
        ArmNil {
            if !$saw_arm {
                Err(g3_unsupported())
            } else {
                Ok(CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ "\tif (!" ~ $matched ~ ") \{\n\t\tguji_panic(\"non-exhaustive match\");\n\t}\n", nstr: $state.nstr, ntmp: $state.ntmp))
            }
        }
        ArmCons($arm, $rest) {
            match $arm.pat {
                # C08: scalar literal arms use the same matched-flag guard
                # discipline as carrier variants.  The pattern condition is
                # still pure and checked first; potentially trapping guard prep
                # runs inside that condition and only while no earlier arm has
                # won.
                PLit($lit) {
                    match g6_arm_cond($skind, $gm, $lit, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($cl) {
                            match g6_emit_matched_variant_seg($rkind, $res, $matched, $cl.c, $arm.guard, $arm.body, $cl.state, $env) {
                                Err($m) { Err($m) }
                                Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                            }
                        }
                    }
                }
                PVariant($name, $args) {
                    match g6_variant_cond($skind, $gm, $name, $args, $env) {
                        Err($m) { Err($m) }
                        Ok($cond) {
                            match g6_variant_env($skind, $gm, $name, $args, $env) {
                                Err($m) { Err($m) }
                                Ok($arm_env) {
                                    match g6_emit_matched_variant_seg($rkind, $res, $matched, $cond, $arm.guard, $arm.body, $state, $arm_env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                            }
                        }
                    }
                }
                PWild {
                    match $arm.guard {
                        None {
                            match $rest {
                                ArmNil {
                                    match g6_emit_matched_catchall($rkind, $skind, $gm, $res, $matched, None, $arm.body, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        Some($g) {
                            # Pure catch-all guards can still fold into the matched if-head;
                            # stateful catch-all guards lower via the same nested path.
                            match g6_guard_pure($g, $env) {
                                Ok($gc) {
                                    match g6_emit_matched_variant_seg($rkind, $res, $matched, $gc, None, $arm.body, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                                Err($m) {
                                    match g6_emit_matched_variant_seg($rkind, $res, $matched, "1", Some($g), $arm.body, $state, $env) {
                                        Err($m2) { Err($m2) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                            }
                        }
                    }
                }
                PBind($name) {
                    $arm_env = CgEnvCons(CgVar(name: $name, cname: $gm, kind: $skind, mutable: false, borrowed: true, listlen: 0), $env)
                    match $arm.guard {
                        None {
                            match $rest {
                                ArmNil {
                                    match g6_emit_matched_catchall($rkind, $skind, $gm, $res, $matched, Some($name), $arm.body, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        Some($g) {
                            match g6_guard_pure($g, $arm_env) {
                                Ok($gc) {
                                    match g6_emit_matched_variant_seg($rkind, $res, $matched, $gc, None, $arm.body, $state, $arm_env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                                Err($m) {
                                    match g6_emit_matched_variant_seg($rkind, $res, $matched, "1", Some($g), $arm.body, $state, $arm_env) {
                                        Err($m2) { Err($m2) }
                                        Ok($next) { g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $rest, $next, $env, true) }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g6_lower_option_arms_dispatch($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $arms: ArmList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    if g6_option_arms_need_matched($arms, $skind, $gm, $env) {
        $matched = g4_value_tmp(CgInt, $state.ntmp)
        $st0 = CgState(
            interns: $state.interns,
            decls: $state.decls ~ g4_value_decl(CgInt, $matched),
            body: $state.body ~ "\t" ~ $matched ~ " = 0;\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        )
        g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $arms, $st0, $env, false)
    } else {
        g6_lower_option_arms($rkind, $skind, $gm, $res, $arms, true, $state, $env)
    }
}

# Scalar matches normally keep the compact if/else-if chain.  Switch to the
# shared matched-flag emitter only when a PLit/wildcard/binder guard needs
# stateful lowering; this keeps pure scalar output stable while admitting the
# exact §5.6 trap order required by C08.
sub g6_lower_scalar_arms_dispatch($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $arms: ArmList, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    if g6_option_arms_need_matched($arms, $skind, $gm, $env) {
        $matched = g4_value_tmp(CgInt, $state.ntmp)
        $st0 = CgState(
            interns: $state.interns,
            decls: $state.decls ~ g4_value_decl(CgInt, $matched),
            body: $state.body ~ "\t" ~ $matched ~ " = 0;\n",
            nstr: $state.nstr,
            ntmp: $state.ntmp + 1
        )
        g6_lower_option_arms_matched($rkind, $skind, $gm, $res, $matched, $arms, $st0, $env, false)
    } else {
        g6_lower_arms($rkind, $skind, $gm, $res, $arms, true, $state, $env)
    }
}

sub stmtlist_ends_return($stmts: StmtList): Bool {
    match $stmts {
        StmtNil { false }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil {
                    match $head {
                        SReturn($ov) { true }
                        _ { false }
                    }
                }
                StmtCons($h2, $t2) { stmtlist_ends_return($tail) }
            }
        }
    }
}

sub g6_emit_variant_seg_ret($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $name: Str, $args: PatternList, $guard: Option[Expr], $body: StmtList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    if stmtlist_ends_return($body) {
        match $guard {
            Some($g) { Err(g3_unsupported()) }
            None {
                match g6_variant_cond($skind, $gm, $name, $args, $env) {
                    Err($m) { Err($m) }
                    Ok($cond) {
                        match g6_variant_env($skind, $gm, $name, $args, $env) {
                            Err($m) { Err($m) }
                            Ok($arm_env) {
                                $outer_body = $state.body
                                $br_start = g4_bodyless_state($state)
                                match g5_guard_body_extra($body, $br_start, $arm_env, cg_env_len($env), $retkind, $match_cleanup) {
                                    Err($m) { Err($m) }
                                    Ok($br) {
                                        $kw = if $first { "\tif (" } else { " else if (" }
                                        $seg = $kw ~ "(" ~ $cond ~ ")) \{\n" ~ $br.body ~ "\t}"
                                        Ok(CgState(interns: $br.interns, decls: $br.decls, body: $outer_body ~ $seg, nstr: $br.nstr, ntmp: $br.ntmp))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        match g6_emit_variant_seg($rkind, $skind, $gm, $res, $name, $args, $guard, $body, $first, $state, $env) {
            Ok($next) { Ok($next) }
            Err($plain_decline) { g6_emit_variant_seg_question($rkind, $skind, $gm, $res, $name, $args, $guard, $body, $first, $state, $env, $retkind, $match_cleanup) }
        }
    }
}

# P3b-2b-2c-4m: a VALUE-position match arm whose final expression carries a
# hoistable `?` (e.g. `Ok($v) { parse_int($q)? + $v }` inside `$x = match ...`).
# The plain arm emitter has no `?` support, so this only runs after it declines.
# The body lowers through the retkind-aware branch walker; the hoisted carrier
# guard's Err early-return receives `$match_cleanup` (the scrutinee release) so an
# owned scrutinee is dropped before the C `return`, mirroring native's ordering
# (cc-captured: `?` carrier err release, then scrutinee release, then return).
# Synthetic `?qN` locals above the arm env base are released at arm end. A pure
# guard is folded into the same `variant-test && guard` condition as the plain
# arm emitter, after the variant payload bindings have been added to the arm env.
sub g6_emit_variant_seg_question_cond($rkind: CgKind, $res: Str, $cond: Str, $body: StmtList, $first: Bool, $state: CgState, $arm_env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    $outer_body = $state.body
    $br_start = g4_bodyless_state($state)
    match g5_branch_block_kind_ret_extra($rkind, $body, $br_start, $arm_env, $retkind, $match_cleanup) {
        Err($m) { Err($m) }
        Ok($br) {
            $kw = if $first { "\tif (" } else { " else if (" }
            $seg = $kw ~ $cond ~ ") \{\n" ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t}"
            Ok(CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp))
        }
    }
}

sub g6_emit_variant_seg_question($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $name: Str, $args: PatternList, $guard: Option[Expr], $body: StmtList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    match g6_variant_cond($skind, $gm, $name, $args, $env) {
        Err($m) { Err($m) }
        Ok($cond) {
            match g6_variant_env($skind, $gm, $name, $args, $env) {
                Err($m) { Err($m) }
                Ok($arm_env) {
                    $base = "(" ~ $cond ~ ")"
                    match $guard {
                        None { g6_emit_variant_seg_question_cond($rkind, $res, $base, $body, $first, $state, $arm_env, $retkind, $match_cleanup) }
                        Some($g) {
                            match g6_guard_pure($g, $arm_env) {
                                Err($m) { Err($m) }
                                Ok($gc) { g6_emit_variant_seg_question_cond($rkind, $res, $base ~ " && (" ~ $gc ~ ")", $body, $first, $state, $arm_env, $retkind, $match_cleanup) }
                            }
                        }
                    }
                }
            }
        }
    }
}

sub g6_lower_option_arms($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $arms: ArmList, $first: Bool, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $arms {
        ArmNil {
            if $first {
                Err(g3_unsupported())
            } else {
                Ok(CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ " else \{\n\t\tguji_panic(\"non-exhaustive match\");\n\t}\n", nstr: $state.nstr, ntmp: $state.ntmp))
            }
        }
        ArmCons($arm, $rest) {
            match $arm.pat {
                PVariant($name, $args) {
                    match g6_emit_variant_seg($rkind, $skind, $gm, $res, $name, $args, $arm.guard, $arm.body, $first, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($next) { g6_lower_option_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env) }
                    }
                }
                PWild {
                    match $arm.guard {
                        None {
                            match $rest {
                                ArmNil { g6_emit_catchall($rkind, $skind, $gm, $res, None, $arm.body, $first, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        Some($g) {
                            match g6_guard_pure($g, $env) {
                                Err($m) { Err($m) }
                                Ok($gc) {
                                    match g6_emit_guarded_seg($rkind, $res, $gc, $arm.body, $first, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env) }
                                    }
                                }
                            }
                        }
                    }
                }
                PBind($name) {
                    match $arm.guard {
                        None {
                            match $rest {
                                ArmNil { g6_emit_catchall($rkind, $skind, $gm, $res, Some($name), $arm.body, $first, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        Some($g) {
                            $arm_env = CgEnvCons(CgVar(name: $name, cname: $gm, kind: $skind, mutable: false, borrowed: true, listlen: 0), $env)
                            match g6_guard_pure($g, $arm_env) {
                                Err($m) { Err($m) }
                                Ok($gc) {
                                    match g6_emit_guarded_seg($rkind, $res, $gc, $arm.body, $first, $state, $arm_env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_option_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env) }
                                    }
                                }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

sub g6_lower_result_arms_ret($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $arms: ArmList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    match $arms {
        ArmNil {
            if $first {
                Err(g3_unsupported())
            } else {
                Ok(CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ " else \{\n\t\tguji_panic(\"non-exhaustive match\");\n\t}\n", nstr: $state.nstr, ntmp: $state.ntmp))
            }
        }
        ArmCons($arm, $rest) {
            match $arm.pat {
                PVariant($name, $args) {
                    match g6_emit_variant_seg_ret($rkind, $skind, $gm, $res, $name, $args, $arm.guard, $arm.body, $first, $state, $env, $retkind, $match_cleanup) {
                        Err($m) { Err($m) }
                        Ok($next) { g6_lower_result_arms_ret($rkind, $skind, $gm, $res, $rest, false, $next, $env, $retkind, $match_cleanup) }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Emit the `if`/`else if` chain over the arms. Earlier arms must be PLit; the final
# arm must be the catch-all (PWild/PBind). Anything else (guards, PVariant, a
# non-final catch-all) is out of subset.
sub g6_lower_arms($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $arms: ArmList, $first: Bool, $state: CgState, $env: CgEnv): Result[CgState, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match $arm.guard {
                Some($g) {
                    match $arm.pat {
                        PLit($lit) {
                            match g6_arm_cond($skind, $gm, $lit, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($cl) {
                                    match g6_guard_pure($g, $env) {
                                        Err($m) { Err($m) }
                                        Ok($gc) {
                                            $cond = $cl.c ~ " && (" ~ $gc ~ ")"
                                            match g6_emit_guarded_seg($rkind, $res, $cond, $arm.body, $first, $cl.state, $env) {
                                                Err($m) { Err($m) }
                                                Ok($next) { g6_lower_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        PWild {
                            match g6_guard_pure($g, $env) {
                                Err($m) { Err($m) }
                                Ok($gc) {
                                    match g6_emit_guarded_seg($rkind, $res, $gc, $arm.body, $first, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env) }
                                    }
                                }
                            }
                        }
                        PBind($name) {
                            $borrowed = match $skind { CgStr { true } _ { false } }
                            $arm_env = CgEnvCons(CgVar(name: $name, cname: $gm, kind: $skind, mutable: false, borrowed: $borrowed, listlen: 0), $env)
                            match g6_guard_pure($g, $arm_env) {
                                Err($m) { Err($m) }
                                Ok($gc) {
                                    match g6_emit_guarded_seg($rkind, $res, $gc, $arm.body, $first, $state, $arm_env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env) }
                                    }
                                }
                            }
                        }
                        PVariant($n, $a) { Err(g3_unsupported()) }
                    }
                }
                None {
                    match $arm.pat {
                        PLit($lit) {
                            match g6_arm_cond($skind, $gm, $lit, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($cl) {
                                    $outer_body = $cl.state.body
                                    $br_start = g4_bodyless_state($cl.state)
                                    match g4_branch_block_kind($rkind, $arm.body, $br_start, $env) {
                                        Err($m) { Err($m) }
                                        Ok($br) {
                                            $kw = if $first { "\tif (" } else { " else if (" }
                                            $seg = $kw ~ $cl.c ~ ") \{\n" ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t}"
                                            $next = CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp)
                                            g6_lower_arms($rkind, $skind, $gm, $res, $rest, false, $next, $env)
                                        }
                                    }
                                }
                            }
                        }
                        PWild {
                            match $rest {
                                ArmNil { g6_emit_catchall($rkind, $skind, $gm, $res, None, $arm.body, $first, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        PBind($name) {
                            match $rest {
                                ArmNil { g6_emit_catchall($rkind, $skind, $gm, $res, Some($name), $arm.body, $first, $state, $env) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        PVariant($n, $a) { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# Lower a whole `match` expression to a value of kind `$rkind`. Evaluate the subject
# once into `gm`, declare the result temp, emit the arm chain (assigning the result
# temp in each arm), then release a Str scrutinee. Returns the result temp as the
# value rvalue for the enclosing consumer (final stmt / return / binding RHS / branch
# / print arg), exactly like g4_lower_if_value.
sub g6_lower_match($rkind: CgKind, $subject: Expr, $arms: ArmList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g6_lower_scrutinee($subject, $state, $env) {
        Err($m) { Err($m) }
        Ok($sc) {
            $match_env = g6_match_payload_env($subject, $sc.gm, $env)
            $res = g4_value_tmp($rkind, $sc.state.ntmp)
            $st2 = CgState(
                interns: $sc.state.interns,
                decls: $sc.state.decls ~ g4_value_decl($rkind, $res),
                body: $sc.state.body,
                nstr: $sc.state.nstr,
                ntmp: $sc.state.ntmp + 1
            )
            $arms_out = if g6_is_option_kind($sc.kind) || g6_is_result_kind($sc.kind) || g6_is_enum_kind($sc.kind) {
                # P9-8b-2b: stateful guards switch the whole carrier match onto
                # native's matched-flag lowering so later guard prep never runs
                # before an earlier arm has won.
                g6_lower_option_arms_dispatch($rkind, $sc.kind, $sc.gm, $res, $arms, $st2, $match_env)
            } else {
                g6_lower_scalar_arms_dispatch($rkind, $sc.kind, $sc.gm, $res, $arms, $st2, $match_env)
            }
            match $arms_out {
                Err($m) { Err($m) }
                Ok($chain) {
                    $rel = match $sc.kind {
                        CgStr { "\tguji_release(" ~ $sc.gm ~ ");\n" }
                        CgOptStr { g6_option_release(CgOptStr, $sc.gm) }
                        CgOptMatch { if $sc.borrowed { "" } else { g6_option_release(CgOptMatch, $sc.gm) } }
                        CgOptBush { if $sc.borrowed { "" } else { g6_option_release(CgOptBush, $sc.gm) } }
                        CgRes($ok, $err) { g6_result_release($sc.kind, $sc.gm) }
                        # A fresh OWNED Option[<user enum/class>] scrutinee (a call
                        # result, e.g. `match bind_lookup(..) {..}`) must drop its
                        # active Some payload's owned fields after the chain; a Some
                        # arm that re-uses the payload retains its own copy, so this
                        # release balances. A BORROWED carrier (a bound name/param —
                        # the owner releases it) is left alone.
                        CgOptEnum($oen) { if $sc.borrowed { "" } else { g6_option_release(CgOptEnum($oen), $sc.gm) } }
                        CgOptClass($ocn) { if $sc.borrowed { "" } else { g6_option_release(CgOptClass($ocn), $sc.gm) } }
                        CgOptList($el) { if $sc.borrowed { "" } else { g6_option_release(CgOptList($el), $sc.gm) } }
                        CgOptMap($mval) { if $sc.borrowed { "" } else { g6_option_release(CgOptMap($mval), $sc.gm) } }
                        # An enum scrutinee materialised from a fresh OWNED value
                        # (inline construction / niladic / returned call) must drop
                        # its fields after the chain — mirroring `guji build`, which emits the same
                        # guji_release_<enum>_fields here. A BORROWED scrutinee (a sub
                        # param, or a bound CgEnum local released at scope end) is left
                        # alone so its owner releases it exactly once.
                        CgEnum($en) { if $sc.borrowed { "" } else { g6e_enum_release($en, $sc.gm) } }
                        _ { "" }
                    }
                    Ok(CgValueOut(
                        state: CgState(
                            interns: $chain.interns,
                            decls: $chain.decls,
                            body: $chain.body ~ $rel,
                            nstr: $chain.nstr,
                            ntmp: $chain.ntmp
                        ),
                        c: $res
                    ))
                }
            }
        }
    }
}

sub g6_scrut_cleanup($sc: ScrutOut): Str {
    match $sc.kind {
        CgStr { "\tguji_release(" ~ $sc.gm ~ ");\n" }
        CgOptStr { g6_option_release(CgOptStr, $sc.gm) }
        CgOptMatch { if $sc.borrowed { "" } else { g6_option_release(CgOptMatch, $sc.gm) } }
        CgOptBush { if $sc.borrowed { "" } else { g6_option_release(CgOptBush, $sc.gm) } }
        CgRes($ok, $err) { g6_result_release($sc.kind, $sc.gm) }
        CgOptEnum($oen) { if $sc.borrowed { "" } else { g6_option_release(CgOptEnum($oen), $sc.gm) } }
        CgOptClass($ocn) { if $sc.borrowed { "" } else { g6_option_release(CgOptClass($ocn), $sc.gm) } }
        CgOptList($el) { if $sc.borrowed { "" } else { g6_option_release(CgOptList($el), $sc.gm) } }
        CgOptMap($mval) { if $sc.borrowed { "" } else { g6_option_release(CgOptMap($mval), $sc.gm) } }
        CgEnum($en) { if $sc.borrowed { "" } else { g6e_enum_release($en, $sc.gm) } }
        _ { "" }
    }
}

sub g6_lower_match_ret($rkind: CgKind, $subject: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[CgValueOut, Str] {
    match g6_lower_scrutinee($subject, $state, $env) {
        Err($m) { Err($m) }
        Ok($sc) {
            $match_env = g6_match_payload_env($subject, $sc.gm, $env)
            # P3b-2b-2c-4q: any variant-armed carrier scrutinee (Result, Option,
            # user enum) uses the same ret-aware arm chain — the variant cond/env
            # helpers and the scrutinee cleanup are already kind-generic. Arms must
            # all be PVariant (no catch-all), mirroring the Result-only original.
            # P9-10b-3a: an ALL-return (Never-valued) match is admitted at ANY
            # rkind here — the result temp is dead (every arm returns), so any
            # kind's zero value is valid C; the wrong-kind hazard lives only in
            # the fresh-BIND path, which is screened in g5_match_bind_str.
            if g6_is_result_kind($sc.kind) || g6_is_option_kind($sc.kind) || g6_is_enum_kind($sc.kind) {
                $res = g4_value_tmp($rkind, $sc.state.ntmp)
                $st2 = CgState(
                    interns: $sc.state.interns,
                    decls: $sc.state.decls ~ g4_value_decl($rkind, $res),
                    body: $sc.state.body,
                    nstr: $sc.state.nstr,
                    ntmp: $sc.state.ntmp + 1
                )
                match g6_lower_result_arms_ret($rkind, $sc.kind, $sc.gm, $res, $arms, true, $st2, $match_env, $retkind, g6_scrut_cleanup($sc)) {
                    Err($m) { Err($m) }
                    Ok($chain) {
                        Ok(CgValueOut(
                            state: CgState(
                                interns: $chain.interns,
                                decls: $chain.decls,
                                body: $chain.body ~ g6_scrut_cleanup($sc),
                                nstr: $chain.nstr,
                                ntmp: $chain.ntmp
                            ),
                            c: $res
                        ))
                    }
                }
            } else {
                # P9-10b-2: scalar scrutinee whose arms explicit-return (§11.2
                # Never). Take over only when a return is present so a
                # return-free scalar match keeps the plain g6_lower_match path
                # byte-identical; the ret-aware chain mirrors g6_lower_arms,
                # with return-ending arms lowered through g5_guard_body_extra so
                # the owned scrutinee temp is released before the C `return`
                # (mirroring native's early-return cleanup ordering).
                # P9-10b-3a: an ALL-return (Never-valued) scalar match is
                # admitted at ANY rkind — no value arm remains to validate the
                # kind, but the result temp is dead (every arm returns), so any
                # kind's zero value is valid C (native uses int64_t). The arms
                # still release an owned scrutinee before each C `return` via
                # g5_guard_body_extra; native omits that release in this exact
                # shape (a dead-path leak), which is behaviorally identical
                # three-way and sanitizer-cleaner here. The fresh-BIND kind
                # discipline (CgInt) lives in g5_match_bind_str.
                if g6_arms_any_return($arms) {
                    $res = g4_value_tmp($rkind, $sc.state.ntmp)
                    $st2 = CgState(
                        interns: $sc.state.interns,
                        decls: $sc.state.decls ~ g4_value_decl($rkind, $res),
                        body: $sc.state.body,
                        nstr: $sc.state.nstr,
                        ntmp: $sc.state.ntmp + 1
                    )
                    match g6_lower_scalar_arms_ret($rkind, $sc.kind, $sc.gm, $res, $arms, true, $st2, $match_env, $retkind, g6_scrut_cleanup($sc)) {
                        Err($m) { Err($m) }
                        Ok($chain) {
                            Ok(CgValueOut(
                                state: CgState(
                                    interns: $chain.interns,
                                    decls: $chain.decls,
                                    body: $chain.body ~ g6_scrut_cleanup($sc),
                                    nstr: $chain.nstr,
                                    ntmp: $chain.ntmp
                                ),
                                c: $res
                            ))
                        }
                    }
                } else {
                    Err(g3_unsupported())
                }
            }
        }
    }
}

# P9-10b-2: true when any match arm body ends in an explicit `return`
# (§11.2 Never). Pre-screens the scalar ret-aware chain so a return-free match
# keeps its byte-identical plain lowering.
sub g6_arms_any_return($arms: ArmList): Bool {
    match $arms {
        ArmNil { false }
        ArmCons($arm, $rest) {
            if stmtlist_ends_return($arm.body) { true } else { g6_arms_any_return($rest) }
        }
    }
}

# P9-10b-2: true when EVERY arm body ends in an explicit `return` — the match
# value is Never, so no arm can pin the result kind. P9-10b-3a: the ret-aware
# chain admits such a match at any rkind (the temp is dead); the fresh-BIND
# kind discipline (CgInt, native's default) lives in g5_match_bind_str.
sub g6_arms_all_return($arms: ArmList): Bool {
    match $arms {
        ArmNil { true }
        ArmCons($arm, $rest) {
            if stmtlist_ends_return($arm.body) { g6_arms_all_return($rest) } else { false }
        }
    }
}

# P9-10b-2: ret-aware counterpart of g6_emit_catchall for the scalar ret chain.
# A catch-all body ending in an explicit `return` lowers through
# g5_guard_body_extra with the scrutinee release as the extra cleanup (the C
# `return` then runs the full env cleanup, exactly like a variant-arm return);
# a value body keeps the plain g6_emit_catchall shape byte-identical.
sub g6_emit_catchall_ret($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $bind: Option[Str], $body: StmtList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    if stmtlist_ends_return($body) {
        $outer_body = $state.body
        $kw = if $first { "\tif (1) \{\n" } else { " else if (1) \{\n" }
        match $bind {
            None {
                $br_start = g4_bodyless_state($state)
                match g5_guard_body_extra($body, $br_start, $env, cg_env_len($env), $retkind, $match_cleanup) {
                    Err($m) { Err($m) }
                    Ok($br) {
                        $seg = $kw ~ $br.body ~ "\t}\n"
                        Ok(CgState(interns: $br.interns, decls: $br.decls, body: $outer_body ~ $seg, nstr: $br.nstr, ntmp: $br.ntmp))
                    }
                }
            }
            Some($name) {
                $bindtmp = "gv" ~ c_int($state.ntmp)
                $borrowed = match $skind { CgStr { true } CgOptStr { true } CgRes($ok, $err) { g6_result_has_str($skind) } CgEnum($n) { true } _ { false } }
                $st_decl = CgState(interns: $state.interns, decls: $state.decls ~ g4_value_decl($skind, $bindtmp), body: "", nstr: $state.nstr, ntmp: $state.ntmp + 1)
                $arm_env = CgEnvCons(CgVar(name: $name, cname: $bindtmp, kind: $skind, mutable: false, borrowed: $borrowed, listlen: 0), $env)
                match g5_guard_body_extra($body, $st_decl, $arm_env, cg_env_len($env), $retkind, $match_cleanup) {
                    Err($m) { Err($m) }
                    Ok($br) {
                        $assign = "\t\t" ~ $bindtmp ~ " = " ~ $gm ~ ";\n"
                        $seg = $kw ~ $assign ~ $br.body ~ "\t}\n"
                        Ok(CgState(interns: $br.interns, decls: $br.decls, body: $outer_body ~ $seg, nstr: $br.nstr, ntmp: $br.ntmp))
                    }
                }
            }
        }
    } else {
        g6_emit_catchall($rkind, $skind, $gm, $res, $bind, $body, $first, $state, $env)
    }
}

# P9-10b-2: ret-aware counterpart of g6_lower_arms for scalar scrutinees,
# entered only when g6_arms_any_return pre-screens at least one explicit-return
# arm. Return-ending PLit arms lower through g5_guard_body_extra with the
# scrutinee release as extra cleanup — mirroring native, which drops the owned
# scrutinee/carrier temps before the arm's C `return`. Non-returning arms reuse
# the plain g6_lower_arms segment shapes; guarded return arms decline, matching
# g6_emit_variant_seg_ret's boundary.
sub g6_lower_scalar_arms_ret($rkind: CgKind, $skind: CgKind, $gm: Str, $res: Str, $arms: ArmList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    match $arms {
        ArmNil { Err(g3_unsupported()) }
        ArmCons($arm, $rest) {
            match $arm.guard {
                Some($g) {
                    match $arm.pat {
                        PLit($lit) {
                            match g6_arm_cond($skind, $gm, $lit, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($cl) {
                                    match g6_guard_pure($g, $env) {
                                        Err($m) { Err($m) }
                                        Ok($gc) {
                                            $cond = $cl.c ~ " && (" ~ $gc ~ ")"
                                            match g6_emit_guarded_seg($rkind, $res, $cond, $arm.body, $first, $cl.state, $env) {
                                                Err($m) { Err($m) }
                                                Ok($next) { g6_lower_scalar_arms_ret($rkind, $skind, $gm, $res, $rest, false, $next, $env, $retkind, $match_cleanup) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        PWild {
                            match g6_guard_pure($g, $env) {
                                Err($m) { Err($m) }
                                Ok($gc) {
                                    match g6_emit_guarded_seg($rkind, $res, $gc, $arm.body, $first, $state, $env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_scalar_arms_ret($rkind, $skind, $gm, $res, $rest, false, $next, $env, $retkind, $match_cleanup) }
                                    }
                                }
                            }
                        }
                        PBind($name) {
                            $borrowed = match $skind { CgStr { true } _ { false } }
                            $arm_env = CgEnvCons(CgVar(name: $name, cname: $gm, kind: $skind, mutable: false, borrowed: $borrowed, listlen: 0), $env)
                            match g6_guard_pure($g, $arm_env) {
                                Err($m) { Err($m) }
                                Ok($gc) {
                                    match g6_emit_guarded_seg($rkind, $res, $gc, $arm.body, $first, $state, $arm_env) {
                                        Err($m) { Err($m) }
                                        Ok($next) { g6_lower_scalar_arms_ret($rkind, $skind, $gm, $res, $rest, false, $next, $env, $retkind, $match_cleanup) }
                                    }
                                }
                            }
                        }
                        PVariant($n, $a) { Err(g3_unsupported()) }
                    }
                }
                None {
                    match $arm.pat {
                        PLit($lit) {
                            if stmtlist_ends_return($arm.body) {
                                match g6_arm_cond($skind, $gm, $lit, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($cl) {
                                        $outer_body = $cl.state.body
                                        $br_start = g4_bodyless_state($cl.state)
                                        match g5_guard_body_extra($arm.body, $br_start, $env, cg_env_len($env), $retkind, $match_cleanup) {
                                            Err($m) { Err($m) }
                                            Ok($br) {
                                                $kw = if $first { "\tif (" } else { " else if (" }
                                                $seg = $kw ~ $cl.c ~ ") \{\n" ~ $br.body ~ "\t}"
                                                $next = CgState(interns: $br.interns, decls: $br.decls, body: $outer_body ~ $seg, nstr: $br.nstr, ntmp: $br.ntmp)
                                                g6_lower_scalar_arms_ret($rkind, $skind, $gm, $res, $rest, false, $next, $env, $retkind, $match_cleanup)
                                            }
                                        }
                                    }
                                }
                            } else {
                                match g6_arm_cond($skind, $gm, $lit, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($cl) {
                                        $outer_body = $cl.state.body
                                        $br_start = g4_bodyless_state($cl.state)
                                        match g4_branch_block_kind($rkind, $arm.body, $br_start, $env) {
                                            Err($m) { Err($m) }
                                            Ok($br) {
                                                $kw = if $first { "\tif (" } else { " else if (" }
                                                $seg = $kw ~ $cl.c ~ ") \{\n" ~ $br.body ~ "\t\t" ~ $res ~ " = " ~ $br.rvalue ~ ";\n" ~ $br.releases ~ "\t}"
                                                $next = CgState(interns: $br.state.interns, decls: $br.state.decls, body: $outer_body ~ $seg, nstr: $br.state.nstr, ntmp: $br.state.ntmp)
                                                g6_lower_scalar_arms_ret($rkind, $skind, $gm, $res, $rest, false, $next, $env, $retkind, $match_cleanup)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        PWild {
                            match $rest {
                                ArmNil { g6_emit_catchall_ret($rkind, $skind, $gm, $res, None, $arm.body, $first, $state, $env, $retkind, $match_cleanup) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        PBind($name) {
                            match $rest {
                                ArmNil { g6_emit_catchall_ret($rkind, $skind, $gm, $res, Some($name), $arm.body, $first, $state, $env, $retkind, $match_cleanup) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                        PVariant($n, $a) { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

# ---- E5d-7c-2b-4: statement-position `match` (value DISCARDED) -------------
# A NON-final statement-position `match` over an enum scrutinee, used for its side
# effects (e.g. the driver's verdict match: reject arms `note($m); return N`, accept
# arm yields a discarded `0`). The match value is unused, so no result temp is
# allocated: each arm body is lowered for side effects, an arm ending in `return`
# releases the scrutinee + all owned locals inline before the C `return`, and an arm
# that falls through discards its final value and releases only its own block-local
# Str bindings. The scrutinee cleanup for the fall-through path is emitted once after
# the arm chain. Mirrors g6_lower_match_ret, but for a discarded (statement) result.

# True when a statement is a pure value expression whose result is side-effect-free
# and can be DROPPED in statement-position match (a scalar literal or a bare name
# read — neither has a side effect nor allocates fresh heap). Used to discard a
# non-returning arm's trailing value (the match result is unused).
sub g5_stmt_is_discardable($s: Stmt): Bool {
    match $s {
        SExpr($e) {
            match $e {
                EInt($t) { true }
                EFloat($t) { true }
                EBool($t) { true }
                EName($n) { true }
                _ { false }
            }
        }
        _ { false }
    }
}

# Final-position `match` can be lowered through the statement-match path only
# when every arm is visibly Unit-shaped. This guard must be syntactic and
# conservative: a value match whose value lowering declines must not silently
# become a Unit body returning 0.
sub g5_final_stmt_unit_shaped($s: Stmt, $env: CgEnv): Bool {
    match g3_as_print($s) {
        Some($arg) { true }
        None {
            match g3_as_note($s) {
                Some($arg) { true }
                None {
                    match $s {
                        SExpr($e) {
                            match $e {
                                EUnit { true }
                                ECall($callee, $args) {
                                    match g5_resolve_call_target($callee, $args, $env) {
                                        Ok($target) {
                                            match $target.sig.ret {
                                                RUnit { true }
                                                _ { false }
                                            }
                                        }
                                        Err($m) { false }
                                    }
                                }
                                EMatch($subj, $arms) { g6_final_match_arms_unit_shaped($arms, $env) }
                                EIf($cond, $then, $elifs, $els) { g5_if_bodies_unit_shaped($then, $elifs, $els, $env) }
                                _ { false }
                            }
                        }
                        _ { false }
                    }
                }
            }
        }
    }
}

# A nested statement-shaped `if` is Unit-shaped when every branch body is; used by
# g5_final_stmt_unit_shaped so a final match arm ending in an `if` guard (all leaf
# statements print/note/Unit calls) still routes the outer match through the
# statement path. A value `if` (branches ending in value expressions) stays false,
# so value matches keep the g6_lower_match_ret path.
sub g5_elif_bodies_unit_shaped($elifs: ElifList, $env: CgEnv): Bool {
    match $elifs {
        ElifNil { true }
        ElifCons($head, $rest) {
            if g5_final_body_unit_shaped($head.body, $env) {
                g5_elif_bodies_unit_shaped($rest, $env)
            } else {
                false
            }
        }
    }
}

sub g5_if_bodies_unit_shaped($then: StmtList, $elifs: ElifList, $els: Option[StmtList], $env: CgEnv): Bool {
    if g5_final_body_unit_shaped($then, $env) {
        if g5_elif_bodies_unit_shaped($elifs, $env) {
            match $els {
                None { true }
                Some($body) { g5_final_body_unit_shaped($body, $env) }
            }
        } else {
            false
        }
    } else {
        false
    }
}

sub g5_final_body_unit_shaped($stmts: StmtList, $env: CgEnv): Bool {
    match $stmts {
        StmtNil { true }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil { g5_final_stmt_unit_shaped($head, $env) }
                StmtCons($h2, $t2) { g5_final_body_unit_shaped($tail, $env) }
            }
        }
    }
}

sub g6_final_match_arms_unit_shaped($arms: ArmList, $env: CgEnv): Bool {
    match $arms {
        ArmNil { true }
        ArmCons($arm, $rest) {
            if g5_final_body_unit_shaped($arm.body, $env) {
                g6_final_match_arms_unit_shaped($rest, $env)
            } else {
                false
            }
        }
    }
}

# If the final statement of an arm body is a discardable pure value expression,
# return the body without it (its value is unused in statement position). Non-final
# statements and a returning final statement are preserved.
sub g6_drop_discardable_tail($stmts: StmtList): StmtList {
    match $stmts {
        StmtNil { StmtNil }
        StmtCons($head, $tail) {
            match $tail {
                StmtNil {
                    if g5_stmt_is_discardable($head) { StmtNil } else { $stmts }
                }
                StmtCons($h2, $t2) { StmtCons($head, g6_drop_discardable_tail($tail)) }
            }
        }
    }
}

# Emit one `if`/`else if` segment for a PVariant arm of a statement-position match.
# The arm body lowers via g5_guard_body_extra (a `return` is terminal — its full
# cleanup plus the scrutinee cleanup `$match_cleanup` are emitted inline; a
# fall-through releases only the arm's block-local bindings), after dropping a
# discardable trailing value. Pure guards fold into the same `variant && guard`
# if-head as value-position `g6_emit_variant_seg` (payload names resolve through
# arm_env field exprs against the scrutinee temp), so a failing guard falls
# through to the next arm instead of declining the whole statement match.
# Unguarded arms keep the historical `((cond))` paren shape so existing C pins
# stay stable; guarded arms wrap as `((cond) && (guard))`.
sub g6_emit_stmt_variant_seg($skind: CgKind, $gm: Str, $name: Str, $args: PatternList, $guard: Option[Expr], $body: StmtList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    match g6_variant_cond($skind, $gm, $name, $args, $env) {
        Err($m) { Err($m) }
        Ok($cond) {
            match g6_variant_env($skind, $gm, $name, $args, $env) {
                Err($m) { Err($m) }
                Ok($arm_env) {
                    match $guard {
                        None { g6_emit_stmt_variant_seg_body($cond, $body, $first, $state, $arm_env, $env, $retkind, $match_cleanup) }
                        Some($g) {
                            match g6_guard_pure($g, $arm_env) {
                                Err($m) { Err($m) }
                                Ok($gc) { g6_emit_stmt_variant_seg_body("(" ~ $cond ~ ") && (" ~ $gc ~ ")", $body, $first, $state, $arm_env, $env, $retkind, $match_cleanup) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Shared body emit for statement-position PVariant arms (unguarded or pure-guarded).
# `$cond` is placed inside the historical `((…))` wrapper the stmt-match path
# always emitted — callers pass either a bare variant test or `(variant) && (guard)`.
sub g6_emit_stmt_variant_seg_body($cond: Str, $body: StmtList, $first: Bool, $state: CgState, $arm_env: CgEnv, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    $outer_body = $state.body
    $br_start = g4_bodyless_state($state)
    match g5_guard_body_extra(g6_drop_discardable_tail($body), $br_start, $arm_env, cg_env_len($env), $retkind, $match_cleanup) {
        Err($m) { Err($m) }
        Ok($br) {
            $kw = if $first { "\tif (" } else { " else if (" }
            $seg = $kw ~ "(" ~ $cond ~ ")) \{\n" ~ $br.body ~ "\t}"
            Ok(CgState(interns: $br.interns, decls: $br.decls, body: $outer_body ~ $seg, nstr: $br.nstr, ntmp: $br.ntmp))
        }
    }
}

# Trailing statement-position wildcard arm. Unlike a value match there is no
# shared result temp to fill; the arm only runs its effects (or an early return),
# then the enclosing statement-match path releases the scrutinee on fall-through.
sub g6_emit_stmt_catchall($body: StmtList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    $outer_body = $state.body
    $br_start = g4_bodyless_state($state)
    match g5_guard_body_extra(g6_drop_discardable_tail($body), $br_start, $env, cg_env_len($env), $retkind, $match_cleanup) {
        Err($m) { Err($m) }
        Ok($br) {
            $kw = if $first { "\tif (1) \{\n" } else { " else if (1) \{\n" }
            Ok(CgState(
                interns: $br.interns,
                decls: $br.decls,
                body: $outer_body ~ $kw ~ $br.body ~ "\t}",
                nstr: $br.nstr,
                ntmp: $br.ntmp
            ))
        }
    }
}

# Emit the arm chain for a statement-position match. Every arm must be a PVariant
# (the enum shape); a trailing `else { guji_panic("non-exhaustive match"); }` guards
# an unreachable tag, mirroring g6_lower_result_arms_ret.
sub g6_lower_stmt_arms($skind: CgKind, $gm: Str, $arms: ArmList, $first: Bool, $state: CgState, $env: CgEnv, $retkind: CgRet, $match_cleanup: Str): Result[CgState, Str] {
    match $arms {
        ArmNil {
            if $first {
                Err(g3_unsupported())
            } else {
                Ok(CgState(interns: $state.interns, decls: $state.decls, body: $state.body ~ " else \{\n\t\tguji_panic(\"non-exhaustive match\");\n\t}\n", nstr: $state.nstr, ntmp: $state.ntmp))
            }
        }
        ArmCons($arm, $rest) {
            match $arm.pat {
                PVariant($name, $args) {
                    match g6_emit_stmt_variant_seg($skind, $gm, $name, $args, $arm.guard, $arm.body, $first, $state, $env, $retkind, $match_cleanup) {
                        Err($m) { Err($m) }
                        Ok($next) { g6_lower_stmt_arms($skind, $gm, $rest, false, $next, $env, $retkind, $match_cleanup) }
                    }
                }
                PWild {
                    match $arm.guard {
                        Some($g) { Err(g3_unsupported()) }
                        None {
                            match $rest {
                                ArmNil { g6_emit_stmt_catchall($arm.body, $first, $state, $env, $retkind, $match_cleanup) }
                                _ { Err(g3_unsupported()) }
                            }
                        }
                    }
                }
                _ { Err(g3_unsupported()) }
            }
        }
    }
}

# Lower a NON-final statement-position `match` whose value is discarded. An ENUM,
# OPTION, or RESULT scrutinee is in subset (the driver's verdict match is an enum; its
# `write_file(...)` match — `Result[Unit, Str]`, Ok arm yields a discarded Unit, Err
# arm `note(...); return N` — is a result). The arms are PVariant (with a possible
# early `return`). The arm machinery (g6_lower_stmt_arms -> g6_emit_stmt_variant_seg ->
# g6_variant_cond/g6_variant_env) and the scrutinee cleanup (g6_scrut_cleanup) are
# already kind-generic over enum/option/result, so the same dispatcher the
# value-position g6_lower_match uses applies here. Returns a BindOut threading like any
# Unit statement (the environment is unchanged — arm-local bindings go out of scope).
sub g6_lower_stmt_match_extra($subject: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet, $extra_cleanup: Str): Result[BindOut, Str] {
    match g6_lower_scrutinee($subject, $state, $env) {
        Err($m) { Err($m) }
        Ok($sc) {
            if g6_is_enum_kind($sc.kind) || g6_is_option_kind($sc.kind) || g6_is_result_kind($sc.kind) {
                # Mirror g6_lower_match / g6_lower_match_ret: materializing the
                # scrutinee into $sc.gm drops CgVar listlen, so Option[Regex]
                # needs the empty-name marker before Some($x) binds (otherwise
                # statement-arm `print($x)` prints the bare pattern, not /…/).
                $match_env = g6_match_payload_env($subject, $sc.gm, $env)
                # An early return from a nested statement match releases its own
                # scrutinee first, then every enclosing owned statement-match
                # scrutinee threaded through the guard-body walker. Fall-through
                # still releases only this match's scrutinee below; its owner will
                # release the enclosing values after the outer arm chain.
                match g6_lower_stmt_arms($sc.kind, $sc.gm, $arms, true, $sc.state, $match_env, $retkind, g6_scrut_cleanup($sc) ~ $extra_cleanup) {
                    Err($m) { Err($m) }
                    Ok($chain) {
                        Ok(BindOut(
                            state: CgState(
                                interns: $chain.interns,
                                decls: $chain.decls,
                                body: $chain.body ~ g6_scrut_cleanup($sc),
                                nstr: $chain.nstr,
                                ntmp: $chain.ntmp
                            ),
                            env: $env
                        ))
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
    }
}

sub g6_lower_stmt_match($subject: Expr, $arms: ArmList, $state: CgState, $env: CgEnv, $retkind: CgRet): Result[BindOut, Str] {
    g6_lower_stmt_match_extra($subject, $arms, $state, $env, $retkind, "")
}

# ---- G4/G4b-a: binding statements (Int/Float/Bool/Str) --------------------
# A fresh binding declares a new C local `gvN` (default-initialised in `decls`,
# assigned in `body` so sequential evaluation order — and references to earlier
# bindings — are preserved) and extends the environment. The bound value's kind
# is discovered by trying the Int, then Float, Bool, then Str lowerer; the typechecker
# already accepted the program, so a well-typed scalar value lowers under exactly
# one of them. `gvN` shares CgState.ntmp with the other temps, so for a Bool
# value (whose lowering may itself allocate `gb`/`gi` temps) the local is named
# from the POST-lowering counter to avoid a collision.
sub g4_lower_enum_bind($mutable: Bool, $name: Str, $ekind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g4_lower_value($ekind, $value, $state, $env) {
        Err($m) { Err($m) }
        Ok($ev) {
            $cn = "gv" ~ c_int($ev.state.ntmp)
            $st2 = CgState(
                interns: $ev.state.interns,
                decls: $ev.state.decls ~ g4_value_decl($ekind, $cn),
                body: $ev.state.body ~ "\t" ~ $cn ~ " = " ~ $ev.c ~ ";\n",
                nstr: $ev.state.nstr,
                ntmp: $ev.state.ntmp + 1
            )
            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $ekind, mutable: $mutable, borrowed: false, listlen: 0), $env)))
        }
    }
}

sub g4_lower_class_bind($mutable: Bool, $name: Str, $ckind: CgKind, $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g4_lower_value($ckind, $value, $state, $env) {
        Err($m) { Err($m) }
        Ok($cv) {
            $cn = "gv" ~ c_int($cv.state.ntmp)
            $st2 = CgState(
                interns: $cv.state.interns,
                decls: $cv.state.decls ~ g4_value_decl($ckind, $cn),
                body: $cv.state.body ~ "\t" ~ $cn ~ " = " ~ $cv.c ~ ";\n",
                nstr: $cv.state.nstr,
                ntmp: $cv.state.ntmp + 1
            )
            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $ckind, mutable: $mutable, borrowed: false, listlen: 0), $env)))
        }
    }
}

# ---- §7.4 closure capture analysis (P1c-b) ----------------------------------
# A lambda body may reference bindings from its enclosing scope. §7.4 captures
# those by value at creation. Native lowers each capture set to a `genv_lambda_N`
# struct (one `capI` field per captured local), allocates it with
# `guji_alloc(GUJI_KIND_ENV, owned_count, sizeof(...))`, fills it from the enclosing
# locals, and stores the pointer in `guji_fn_t.env`; the lifted function casts
# `g_env` back to the struct and reads `genv->capI`. Scalar Int/Bool/Float captures
# own nothing. Str captures own a retained pointer. Class/enum captures own a
# counted one-element `<Type>_ARR` box whose generated drop helper recursively
# releases the copied value's fields. List/Map captures similarly own a counted
# one-element ARR_SLICE/ARR_MAP box; the wrapper recursively owns the collection's
# backing arrays and makes a collection capture one leading pointer slot just like
# Str/nominal captures. All owned pointer slots are laid out FIRST; the env's count
# covers exactly those slots, so guji_drop_env releases them.
#
# fv_* collects every NAME the body references (an over-approximation of free
# variables); bn_* collects every name the body BINDS (SBind targets, nested
# lambda params, match-pattern binds). A capture is a referenced name that is not
# locally bound, not a lambda parameter, and resolves to an enclosing scalar local.

sub fv_opt_expr($e: Option[Expr], $acc: StrList): StrList {
    match $e { None { $acc } Some($x) { fv_expr($x, $acc) } }
}

# Interpolated strings keep their source text in EStr, so ordinary AST walking
# cannot see bindings used only as `$name` / `{ expr }` segments. Mirror
# g3_interp_parts here: skip escaped markers, collect bare sigil names, and
# parse balanced brace expressions back into Expr nodes for the normal fv walk.
sub fv_interp_parts(@chars: List[Str], $i: Int, $n: Int, $acc: StrList): StrList {
    if $i >= $n {
        $acc
    } else {
        $c = at(@chars, $i)
        $nxt = at(@chars, $i + 1)
        if $c == "\\" && ($nxt == '{' || $nxt == '}' || $nxt == '$' || $nxt == '@' || $nxt == '%') {
            fv_interp_parts(@chars, $i + 2, $n, $acc)
        } else if ($c == '$' || $c == '@' || $c == '%') && is_ident_start($nxt) {
            $run = take_ident(@chars, $i + 1, $c)
            fv_interp_parts(@chars, $run.next, $n, StrCons($run.text, $acc))
        } else if $c == '{' {
            match g3_interp_find_close(@chars, $i + 1, $n, 0, "") {
                None { fv_interp_parts(@chars, $i + 1, $n, $acc) }
                Some($scan) {
                    $a2 = match g3_parse_interpolation_expr($scan.text) {
                        None { $acc }
                        Some($expr) { fv_expr($expr, $acc) }
                    }
                    fv_interp_parts(@chars, $scan.next, $n, $a2)
                }
            }
        } else {
            fv_interp_parts(@chars, $i + 1, $n, $acc)
        }
    }
}

sub fv_interp($text: Str, $acc: StrList): StrList {
    if has_char($text, '$') || has_char($text, '@') || has_char($text, '%') || has_char($text, '{') {
        @chars = split($text, "")
        fv_interp_parts(@chars, 0, @chars.count(), $acc)
    } else {
        $acc
    }
}

sub fv_expr($e: Expr, $acc: StrList): StrList {
    match $e {
        EStr($text) { fv_interp($text, $acc) }
        EName($n) { StrCons($n, $acc) }
        EList($items) { fv_exprs($items, $acc) }
        EMap($items) { fv_map_entries($items, $acc) }
        EUnary($op, $x) { fv_expr($x, $acc) }
        EBinary($op, $l, $r) { fv_expr($r, fv_expr($l, $acc)) }
        ENamedArg($n, $v) { fv_expr($v, $acc) }
        ECall($callee, $args) { fv_exprs($args, fv_expr($callee, $acc)) }
        EField($o, $n) { fv_expr($o, $acc) }
        EIndex($o, $i) { fv_expr($i, fv_expr($o, $acc)) }
        EIf($c, $then, $elifs, $els) { fv_opt_stmts($els, fv_elifs($elifs, fv_stmts($then, fv_expr($c, $acc)))) }
        EMatch($subj, $arms) { fv_arms($arms, fv_expr($subj, $acc)) }
        ELambda($ps, $rt, $bd, $tp) { fv_stmts($bd, $acc) }
        EQuestion($x) { fv_expr($x, $acc) }
        _ { $acc }
    }
}

sub fv_exprs($xs: ExprList, $acc: StrList): StrList {
    match $xs {
        ExprNil { $acc }
        ExprCons($h, $t) { fv_exprs($t, fv_expr($h, $acc)) }
    }
}

sub fv_map_entries($xs: MapEntryList, $acc: StrList): StrList {
    match $xs {
        MapEntryNil { $acc }
        MapEntryCons($h, $t) { fv_map_entries($t, fv_expr($h.value, fv_expr($h.key, $acc))) }
    }
}

sub fv_stmt($s: Stmt, $acc: StrList): StrList {
    match $s {
        SBind($m, $n, $ty, $v) { fv_expr($v, $acc) }
        SReturn($v) { fv_opt_expr($v, $acc) }
        SExpr($x) { fv_expr($x, $acc) }
        SWhile($c, $bd) { fv_stmts($bd, fv_expr($c, $acc)) }
        SFor($vars, $iter, $bd) { fv_stmts($bd, fv_expr($iter, $acc)) }
        SHatch($bd) { fv_stmts($bd, $acc) }
        SSelect($arms, $els) { fv_select($arms, $els, $acc) }
    }
}

sub fv_select($arms: SelectArmList, $els: Option[StmtList], $acc: StrList): StrList {
    match $arms {
        SelectArmNil { fv_opt_stmts($els, $acc) }
        SelectArmCons($h, $t) { fv_select($t, $els, fv_stmts($h.body, fv_expr($h.op, $acc))) }
    }
}

sub fv_stmts($xs: StmtList, $acc: StrList): StrList {
    match $xs {
        StmtNil { $acc }
        StmtCons($h, $t) { fv_stmts($t, fv_stmt($h, $acc)) }
    }
}

sub fv_opt_stmts($xs: Option[StmtList], $acc: StrList): StrList {
    match $xs { None { $acc } Some($ss) { fv_stmts($ss, $acc) } }
}

sub fv_elifs($xs: ElifList, $acc: StrList): StrList {
    match $xs {
        ElifNil { $acc }
        ElifCons($h, $t) { fv_elifs($t, fv_stmts($h.body, fv_expr($h.cond, $acc))) }
    }
}

sub fv_arms($xs: ArmList, $acc: StrList): StrList {
    match $xs {
        ArmNil { $acc }
        ArmCons($h, $t) { fv_arms($t, fv_stmts($h.body, $acc)) }
    }
}

sub param_names($ps: ParamList, $acc: StrList): StrList {
    match $ps {
        ParamNil { $acc }
        ParamCons($h, $t) { param_names($t, StrCons($h.name, $acc)) }
    }
}

sub pat_bind_names($p: Pattern, $acc: StrList): StrList {
    match $p {
        PBind($n) { StrCons($n, $acc) }
        PVariant($n, $args) { pat_list_bind_names($args, $acc) }
        _ { $acc }
    }
}

sub pat_list_bind_names($ps: PatternList, $acc: StrList): StrList {
    match $ps {
        PatNil { $acc }
        PatCons($h, $t) { pat_list_bind_names($t, pat_bind_names($h, $acc)) }
    }
}

sub bn_opt_expr($e: Option[Expr], $acc: StrList): StrList {
    match $e { None { $acc } Some($x) { bn_expr($x, $acc) } }
}

sub bn_expr($e: Expr, $acc: StrList): StrList {
    match $e {
        EList($items) { bn_exprs($items, $acc) }
        EMap($items) { bn_map_entries($items, $acc) }
        EUnary($op, $x) { bn_expr($x, $acc) }
        EBinary($op, $l, $r) { bn_expr($r, bn_expr($l, $acc)) }
        ENamedArg($n, $v) { bn_expr($v, $acc) }
        ECall($callee, $args) { bn_exprs($args, bn_expr($callee, $acc)) }
        EField($o, $n) { bn_expr($o, $acc) }
        EIndex($o, $i) { bn_expr($i, bn_expr($o, $acc)) }
        EIf($c, $then, $elifs, $els) { bn_opt_stmts($els, bn_elifs($elifs, bn_stmts($then, bn_expr($c, $acc)))) }
        EMatch($subj, $arms) { bn_arms($arms, bn_expr($subj, $acc)) }
        ELambda($ps, $rt, $bd, $tp) { bn_stmts($bd, param_names($ps, $acc)) }
        EQuestion($x) { bn_expr($x, $acc) }
        _ { $acc }
    }
}

sub bn_exprs($xs: ExprList, $acc: StrList): StrList {
    match $xs {
        ExprNil { $acc }
        ExprCons($h, $t) { bn_exprs($t, bn_expr($h, $acc)) }
    }
}

sub bn_map_entries($xs: MapEntryList, $acc: StrList): StrList {
    match $xs {
        MapEntryNil { $acc }
        MapEntryCons($h, $t) { bn_map_entries($t, bn_expr($h.value, bn_expr($h.key, $acc))) }
    }
}

sub bn_stmt($s: Stmt, $acc: StrList): StrList {
    match $s {
        SBind($m, $n, $ty, $v) { bn_expr($v, StrCons($n, $acc)) }
        SReturn($v) { bn_opt_expr($v, $acc) }
        SExpr($x) { bn_expr($x, $acc) }
        SWhile($c, $bd) { bn_stmts($bd, bn_expr($c, $acc)) }
        SFor($vars, $iter, $bd) { bn_stmts($bd, bn_add_vars($vars, bn_expr($iter, $acc))) }
        SHatch($bd) { bn_stmts($bd, $acc) }
        SSelect($arms, $els) { bn_select($arms, $els, $acc) }
    }
}

sub bn_select($arms: SelectArmList, $els: Option[StmtList], $acc: StrList): StrList {
    match $arms {
        SelectArmNil { bn_opt_stmts($els, $acc) }
        SelectArmCons($h, $t) {
            $a1 = bn_expr($h.op, $acc)
            $a2 = bn_select_bind($h.bind, $a1)
            bn_select($t, $els, bn_stmts($h.body, $a2))
        }
    }
}

sub bn_select_bind($bind: Option[Str], $acc: StrList): StrList {
    match $bind { None { $acc } Some($n) { StrCons($n, $acc) } }
}

# The `for` loop variables are bound within the loop body; add them to the
# accumulated bound-name set (used by §7.4 closure capture analysis).
sub bn_add_vars($vars: StrList, $acc: StrList): StrList {
    match $vars {
        StrNil { $acc }
        StrCons($h, $t) { bn_add_vars($t, StrCons($h, $acc)) }
    }
}

sub bn_stmts($xs: StmtList, $acc: StrList): StrList {
    match $xs {
        StmtNil { $acc }
        StmtCons($h, $t) { bn_stmts($t, bn_stmt($h, $acc)) }
    }
}

sub bn_opt_stmts($xs: Option[StmtList], $acc: StrList): StrList {
    match $xs { None { $acc } Some($ss) { bn_stmts($ss, $acc) } }
}

sub bn_elifs($xs: ElifList, $acc: StrList): StrList {
    match $xs {
        ElifNil { $acc }
        ElifCons($h, $t) { bn_elifs($t, bn_stmts($h.body, bn_expr($h.cond, $acc))) }
    }
}

sub bn_arms($xs: ArmList, $acc: StrList): StrList {
    match $xs {
        ArmNil { $acc }
        ArmCons($h, $t) { bn_arms($t, bn_stmts($h.body, pat_bind_names($h.pat, $acc))) }
    }
}

# Runtime guji_copy_arr recursively detaches the standard scalar/Str/List/Map
# array graph. Keep closure collection captures to that copyable shape so every
# emitted copy_env helper remains valid if the function later crosses a channel
# or hatch boundary. Nominal collection leaves need generated per-type detach
# walkers and remain a distinct extension.
sub g5_capture_collection_ok($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgList($inner) { g5_capture_collection_ok($inner) }
        CgMap($val) { g5_capture_collection_ok($val) }
        _ { false }
    }
}

# Is a captured binding's kind in the by-value closure-capture subset? Scalar
# Int/Bool/Float own nothing. Str owns +1 directly. Class/enum values are copied
# into counted one-element user-type arrays, retaining any owned fields; the env
# owns those box pointers. Standard List/Map graphs use wrapper arrays.
sub g5_capture_capturable($k: CgKind): Bool {
    match $k {
        CgInt { true }
        CgBool { true }
        CgFloat { true }
        CgStr { true }
        CgEnum($n) { true }
        CgClass($n) { true }
        CgList($inner) { g5_capture_collection_ok($inner) }
        CgMap($val) { g5_capture_collection_ok($val) }
        _ { false }
    }
}

# Whether one capture is represented by an owned counted pointer in the env.
sub g5_capture_owns_ptr($k: CgKind): Bool {
    match $k {
        CgStr { true }
        CgEnum($n) { true }
        CgClass($n) { true }
        CgList($inner) { true }
        CgMap($val) { true }
        _ { false }
    }
}

# Str, nominal, and collection captures own counted pointers in the env; scalars
# do not. The env's guji_alloc count = the owned-pointer count, and guji_drop_env
# releases exactly the LEADING count pointer slots, so every owned capture must
# lead.
# Append a CgVar to the end of a capture list, preserving discovery order (so
# struct field index == fill index == body-binding index).
sub cg_env_append_var($env: CgEnv, $v: CgVar): CgEnv {
    match $env {
        CgEnvNil { CgEnvCons($v, CgEnvNil) }
        CgEnvCons($h, $t) { CgEnvCons($h, cg_env_append_var($t, $v)) }
        _ { CgEnvCons($v, $env) }
    }
}

# Walk the enclosing env collecting the distinct capturable locals that the body
# references but does not itself bind — the by-value capture set.
sub g5_collect_captures($env: CgEnv, $refs: StrList, $bound: StrList, $acc: CgEnv): CgEnv {
    match $env {
        CgEnvNil { $acc }
        CgEnvCons($h, $t) {
            $take = g5_capture_capturable($h.kind) && strlist_contains($refs, $h.name) && (!strlist_contains($bound, $h.name)) && capture_absent($acc, $h.name)
            if $take {
                g5_collect_captures($t, $refs, $bound, cg_env_append_var($acc, $h))
            } else {
                g5_collect_captures($t, $refs, $bound, $acc)
            }
        }
        CgEnvSub($s, $t) { g5_collect_captures($t, $refs, $bound, $acc) }
        CgEnvEnum($e, $t) { g5_collect_captures($t, $refs, $bound, $acc) }
        CgEnvClass($c, $t) { g5_collect_captures($t, $refs, $bound, $acc) }
        CgEnvSubIdx($i, $t) { g5_collect_captures($t, $refs, $bound, $acc) }
    }
}

sub capture_absent($caps: CgEnv, $name: Str): Bool {
    match cg_env_lookup($caps, $name) { Some($v) { false } None { true } }
}

sub capture_empty($caps: CgEnv): Bool {
    match $caps { CgEnvNil { true } _ { false } }
}

# Collect the owned-pointer captures (in order), appended onto $acc.
sub g5_captures_owned($caps: CgEnv, $acc: CgEnv): CgEnv {
    match $caps {
        CgEnvNil { $acc }
        CgEnvCons($h, $t) {
            if g5_capture_owns_ptr($h.kind) {
                g5_captures_owned($t, cg_env_append_var($acc, $h))
            } else {
                g5_captures_owned($t, $acc)
            }
        }
        _ { $acc }
    }
}

# Collect the unowned scalar captures (in order), appended onto $acc.
sub g5_captures_unowned($caps: CgEnv, $acc: CgEnv): CgEnv {
    match $caps {
        CgEnvNil { $acc }
        CgEnvCons($h, $t) {
            if g5_capture_owns_ptr($h.kind) {
                g5_captures_unowned($t, $acc)
            } else {
                g5_captures_unowned($t, cg_env_append_var($acc, $h))
            }
        }
        _ { $acc }
    }
}

# Partition the capture set owned-pointer-first (stable within each group).
# guji_drop_env releases the LEADING count pointer slots, so Str, nominal, and
# collection boxes must precede the scalar (count-0) fields in genv_*.
sub g5_order_captures_owned_first($caps: CgEnv): CgEnv {
    g5_captures_unowned($caps, g5_captures_owned($caps, CgEnvNil))
}

# The number of owned pointer captures — the count field for the GUJI_KIND_ENV
# allocation (guji_drop_env releases exactly this many leading pointer slots).
sub g5_capture_owned_count($caps: CgEnv): Int {
    match $caps {
        CgEnvNil { 0 }
        CgEnvCons($h, $t) {
            $here = if g5_capture_owns_ptr($h.kind) { 1 } else { 0 }
            $here + g5_capture_owned_count($t)
        }
        _ { 0 }
    }
}

# Nominal and collection values live in counted one-element boxes; other capture
# fields retain their ordinary scalar/Str C type.
sub g5_capture_field_ctype($k: CgKind): Str {
    match $k {
        CgEnum($n) { $n ~ "*" }
        CgClass($n) { $n ~ "*" }
        CgList($inner) { "guji_slice_t*" }
        CgMap($val) { "guji_map_t*" }
        _ { g5_kind_ctype($k) }
    }
}

# The `genv_lambda_N` struct field declarations, one `capI` per capture.
sub g5_capture_fields($caps: CgEnv, $idx: Int): Str {
    match $caps {
        CgEnvNil { "" }
        CgEnvCons($h, $t) { "\t" ~ g5_capture_field_ctype($h.kind) ~ " cap" ~ c_int($idx) ~ ";\n" ~ g5_capture_fields($t, $idx + 1) }
        _ { "" }
    }
}

# Fill a captured List wrapper. Slice-form lists and heap-backed Str literals
# share their immutable backing array with a retain. Fixed scalar literals live
# in stack arrays, so materialize counted ARR_SCALAR storage before the enclosing
# frame can disappear. The borrowed empty-list representation takes the same
# materialization path and produces a valid zero-count array.
sub g5_capture_fill_list($el: CgKind, $var: CgVar, $field: Str): Str {
    $len = g7_list_var_len($var)
    $raw = if $var.listlen == 0 { $var.cname ~ ".data" } else { $var.cname ~ "_data" }
    $heap = if $var.listlen == 0 {
        true
    } else {
        match $el {
            CgStr { !$var.borrowed }
            CgList($inner) { true }
            CgMap($val) { true }
            _ { false }
        }
    }
    $head = "\t" ~ $field ~ " = (guji_slice_t*)guji_arr_alloc(GUJI_KIND_ARR_SLICE, sizeof(guji_slice_t), 1);\n" ~
        "\t" ~ $field ~ "->len = " ~ $len ~ ";\n"
    if $heap {
        $head ~
        "\t" ~ $field ~ "->data = (void*)" ~ $raw ~ ";\n" ~
        "\tguji_retain(" ~ $field ~ "->data);\n"
    } else {
        $ct = match $el { CgFloat { "double" } CgStr { "const char*" } _ { "int64_t" } }
        $ak = if cgkind_eq($el, CgStr) { "GUJI_KIND_ARR_STR" } else { "GUJI_KIND_ARR_SCALAR" }
        $one = match $el {
            CgStr { "guji_str_copy(" ~ $raw ~ "[gclc])" }
            _ { $raw ~ "[gclc]" }
        }
        $head ~
        "\t" ~ $field ~ "->data = guji_arr_alloc(" ~ $ak ~ ", sizeof(" ~ $ct ~ "), " ~ $len ~ ");\n" ~
        "\t\{ int64_t gclc = 0;\n" ~
        "\t\tfor (gclc = 0; gclc < " ~ $len ~ "; gclc = guji_add(gclc, 1)) \{\n" ~
        "\t\t\t((" ~ $ct ~ "*)" ~ $field ~ "->data)[gclc] = " ~ $one ~ ";\n" ~
        "\t\t}\n" ~
        "\t}\n"
    }
}

# A map binding's named keys/vals arrays are always counted. The wrapper retains
# both arrays, and ARR_MAP teardown releases them after the closure dies.
sub g5_capture_fill_map($val: CgKind, $var: CgVar, $field: Str): Str {
    "\t" ~ $field ~ " = (guji_map_t*)guji_arr_alloc(GUJI_KIND_ARR_MAP, sizeof(guji_map_t), 1);\n" ~
    "\t" ~ $field ~ "->len = " ~ g7_map_var_len($var) ~ ";\n" ~
    "\t" ~ $field ~ "->keys = (const char**)" ~ g7_map_var_keys($var) ~ ";\n" ~
    "\t" ~ $field ~ "->vals = (void*)" ~ g7_map_var_vals($var) ~ ";\n" ~
    "\tguji_retain((const void*)" ~ $field ~ "->keys);\n" ~
    "\tguji_retain(" ~ $field ~ "->vals);\n"
}

# At the creation site: copy each enclosing local into the freshly allocated env.
# A Str capture retains its slot. A nominal capture allocates a one-element
# generated user-type array, copies the struct, then retains its fields.
# Collections allocate one-element wrapper arrays and retain/materialize their
# backing storage. In every owned case guji_drop_env releases the leading pointer
# and its kind-specific drop recursively releases the value.
sub g5_capture_fills($caps: CgEnv, $idx: Int, $etmp: Str): Str {
    match $caps {
        CgEnvNil { "" }
        CgEnvCons($h, $t) {
            $field = $etmp ~ "->cap" ~ c_int($idx)
            $fill = match $h.kind {
                CgStr {
                    "\t" ~ $field ~ " = " ~ $h.cname ~ ";\n" ~
                    "\tguji_retain(" ~ $field ~ ");\n"
                }
                CgEnum($n) {
                    "\t" ~ $field ~ " = (" ~ $n ~ "*)guji_alloc(GUJI_KIND_" ~ $n ~ "_ARR, 1, sizeof(" ~ $n ~ "));\n" ~
                    "\t*" ~ $field ~ " = " ~ $h.cname ~ ";\n" ~
                    "\tguji_retain_" ~ $n ~ "_fields(" ~ $field ~ ");\n"
                }
                CgClass($n) {
                    "\t" ~ $field ~ " = (" ~ $n ~ "*)guji_alloc(GUJI_KIND_" ~ $n ~ "_ARR, 1, sizeof(" ~ $n ~ "));\n" ~
                    "\t*" ~ $field ~ " = " ~ $h.cname ~ ";\n" ~
                    "\tguji_retain_" ~ $n ~ "_fields(" ~ $field ~ ");\n"
                }
                CgList($el) { g5_capture_fill_list($el, $h, $field) }
                CgMap($val) { g5_capture_fill_map($val, $h, $field) }
                _ { "\t" ~ $field ~ " = " ~ $h.cname ~ ";\n" }
            }
            $fill ~ g5_capture_fills($t, $idx + 1, $etmp)
        }
        _ { "" }
    }
}

# A channel cannot retain an ordinary closure Env across task heaps: its RC is
# deliberately non-atomic.  Each capturing lambda therefore emits one
# layout-aware copier which recreates the Env and detaches every owned capture.
# Scalar captures copy by value; Str, nominal, and collection boxes become fresh
# rc==1 graphs, matching hatch/channel copy-on-send ownership.
sub g5_capture_copy_fills($caps: CgEnv, $idx: Int, $src: Str, $dst: Str, $env: CgEnv): Str {
    match $caps {
        CgEnvNil { "" }
        CgEnvCons($h, $t) {
            $from = $src ~ "->cap" ~ c_int($idx)
            $to = $dst ~ "->cap" ~ c_int($idx)
            $fill = match $h.kind {
                CgStr { "\t" ~ $to ~ " = guji_str_copy(" ~ $from ~ ");\n" }
                CgEnum($n) {
                    match cg_env_lookup_enum($env, $n) {
                        None { "" }
                        Some($info) {
                            $alloc = "\t" ~ $to ~ " = (" ~ $n ~ "*)guji_alloc(GUJI_KIND_" ~ $n ~ "_ARR, 1, sizeof(" ~ $n ~ "));\n"
                            if g6e_variants_have_box($info.variants) {
                                $alloc ~ "\t*" ~ $to ~ " = guji_clone_" ~ $n ~ "_value(" ~ $from ~ ");\n"
                            } else if g6e_enum_has_heap($info) {
                                $alloc ~ "\t*" ~ $to ~ " = *" ~ $from ~ ";\n" ~
                                g11_chan_enum_copy_fields($info, "(*" ~ $to ~ ")", "(*" ~ $from ~ ")")
                            } else {
                                $alloc ~ "\t*" ~ $to ~ " = *" ~ $from ~ ";\n"
                            }
                        }
                    }
                }
                CgClass($n) {
                    match cg_env_lookup_class($env, $n) {
                        None { "" }
                        Some($info) {
                            "\t" ~ $to ~ " = (" ~ $n ~ "*)guji_alloc(GUJI_KIND_" ~ $n ~ "_ARR, 1, sizeof(" ~ $n ~ "));\n" ~
                            "\t*" ~ $to ~ " = *" ~ $from ~ ";\n" ~
                            g5_hatch_copy_class_fields($info.fields, "(*" ~ $to ~ ")")
                        }
                    }
                }
                CgList($el) {
                    "\t" ~ $to ~ " = (guji_slice_t*)guji_copy_arr((const void*)" ~ $from ~ ");\n"
                }
                CgMap($val) {
                    "\t" ~ $to ~ " = (guji_map_t*)guji_copy_arr((const void*)" ~ $from ~ ");\n"
                }
                _ { "\t" ~ $to ~ " = " ~ $from ~ ";\n" }
            }
            $fill ~ g5_capture_copy_fills($t, $idx + 1, $src, $dst, $env)
        }
        _ { "" }
    }
}

sub g5_capture_copy_helper($caps: CgEnv, $sname: Str, $copyname: Str, $env: CgEnv): Str {
    "static void* " ~ $copyname ~ "(void* p) \{\n" ~
    "\tif (p == NULL) \{ return NULL; }\n" ~
    "\t" ~ $sname ~ "* src = (" ~ $sname ~ "*)p;\n" ~
    "\t" ~ $sname ~ "* out = (" ~ $sname ~ "*)guji_alloc(GUJI_KIND_ENV, " ~ c_int(g5_capture_owned_count($caps)) ~ ", sizeof(" ~ $sname ~ "));\n" ~
    g5_capture_copy_fills($caps, 0, "src", "out", $env) ~
    "\treturn out;\n}\n\n"
}

# Captured nominal and collection bindings are borrowed dereferences of their
# owned env boxes.
sub g5_capture_body_cname($k: CgKind, $idx: Int): Str {
    match $k {
        CgEnum($n) { "(*genv->cap" ~ c_int($idx) ~ ")" }
        CgClass($n) { "(*genv->cap" ~ c_int($idx) ~ ")" }
        CgList($inner) { "(*genv->cap" ~ c_int($idx) ~ ")" }
        CgMap($val) { "(*genv->cap" ~ c_int($idx) ~ ")" }
        _ { "genv->cap" ~ c_int($idx) }
    }
}

# A captured Map is a borrowed struct-form view, distinguished from the named
# three-local map representation by the usual negative listlen sentinel.
sub g5_capture_body_listlen($k: CgKind): Int {
    match $k {
        CgMap($val) { 0 - 1 }
        _ { 0 }
    }
}

# Rebind each captured local in the lambda body's env so a reference lowers to
# `genv->capI` instead of the (out-of-scope) enclosing C local.
sub g5_capture_env($caps: CgEnv, $idx: Int, $base: CgEnv): CgEnv {
    match $caps {
        CgEnvNil { $base }
        CgEnvCons($h, $t) {
            CgEnvCons(CgVar(name: $h.name, cname: g5_capture_body_cname($h.kind, $idx), kind: $h.kind, mutable: false, borrowed: true, listlen: g5_capture_body_listlen($h.kind)), g5_capture_env($t, $idx + 1, $base))
        }
        _ { $base }
    }
}

# I4c: when an unannotated topic/parameterized lambda param appears next to a
# known-kind sibling in a homogeneous op, that sibling's kind is the param's.
sub g5_infer_name_kind_binop($name: Str, $op: Str, $l: Expr, $r: Expr, $env: CgEnv): Option[CgKind] {
    if $op == "+" || $op == "-" || $op == "*" || $op == "/" || $op == "%" || $op == "**" || $op == "~" || $op == "==" || $op == "!=" || $op == "<" || $op == "<=" || $op == ">" || $op == ">=" || $op == "&&" || $op == "||" {
        match $l {
            EName($ln) {
                if $ln == $name {
                    g5g_arg_kind_from_expr($r, $env)
                } else {
                    match $r {
                        EName($rn) {
                            if $rn == $name { g5g_arg_kind_from_expr($l, $env) } else { None }
                        }
                        _ { None }
                    }
                }
            }
            _ {
                match $r {
                    EName($rn) {
                        if $rn == $name { g5g_arg_kind_from_expr($l, $env) } else { None }
                    }
                    _ { None }
                }
            }
        }
    } else {
        None
    }
}

sub g5_infer_name_kind_exprs($name: Str, $xs: ExprList, $env: CgEnv): Option[CgKind] {
    match $xs {
        ExprNil { None }
        ExprCons($h, $t) {
            match g5_infer_name_kind_expr($name, $h, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_exprs($name, $t, $env) }
            }
        }
    }
}

sub g5_infer_name_kind_elifs($name: Str, $xs: ElifList, $env: CgEnv): Option[CgKind] {
    match $xs {
        ElifNil { None }
        ElifCons($h, $t) {
            match g5_infer_name_kind_expr($name, $h.cond, $env) {
                Some($k) { Some($k) }
                None {
                    match g5_infer_name_kind_stmts($name, $h.body, $env) {
                        Some($k) { Some($k) }
                        None { g5_infer_name_kind_elifs($name, $t, $env) }
                    }
                }
            }
        }
    }
}

sub g5_infer_name_kind_arms($name: Str, $xs: ArmList, $env: CgEnv): Option[CgKind] {
    match $xs {
        ArmNil { None }
        ArmCons($h, $t) {
            match g5_infer_name_kind_stmts($name, $h.body, $env) {
                Some($k) { Some($k) }
                None {
                    match $h.guard {
                        None { g5_infer_name_kind_arms($name, $t, $env) }
                        Some($g) {
                            match g5_infer_name_kind_expr($name, $g, $env) {
                                Some($k) { Some($k) }
                                None { g5_infer_name_kind_arms($name, $t, $env) }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Infer a scalar/Str param kind from uses in the lambda body. Nested ELambda
# bodies are skipped so an outer `$_` is not confused with an inner topic `$_`.
sub g5_infer_name_kind_expr($name: Str, $e: Expr, $env: CgEnv): Option[CgKind] {
    match $e {
        EBinary($op, $l, $r) {
            match g5_infer_name_kind_binop($name, $op, $l, $r, $env) {
                Some($k) { Some($k) }
                None {
                    match g5_infer_name_kind_expr($name, $l, $env) {
                        Some($k) { Some($k) }
                        None { g5_infer_name_kind_expr($name, $r, $env) }
                    }
                }
            }
        }
        EUnary($op, $x) { g5_infer_name_kind_expr($name, $x, $env) }
        ECall($c, $a) {
            match g5_infer_name_kind_expr($name, $c, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_exprs($name, $a, $env) }
            }
        }
        EIf($c, $then, $elifs, $els) {
            match g5_infer_name_kind_expr($name, $c, $env) {
                Some($k) { Some($k) }
                None {
                    match g5_infer_name_kind_stmts($name, $then, $env) {
                        Some($k) { Some($k) }
                        None {
                            match g5_infer_name_kind_elifs($name, $elifs, $env) {
                                Some($k) { Some($k) }
                                None {
                                    match $els {
                                        None { None }
                                        Some($b) { g5_infer_name_kind_stmts($name, $b, $env) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        EMatch($subject, $arms) {
            match g5_infer_name_kind_expr($name, $subject, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_arms($name, $arms, $env) }
            }
        }
        EField($o, $n) { g5_infer_name_kind_expr($name, $o, $env) }
        EIndex($o, $i) {
            match g5_infer_name_kind_expr($name, $o, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_expr($name, $i, $env) }
            }
        }
        EList($xs) { g5_infer_name_kind_exprs($name, $xs, $env) }
        ENamedArg($n, $v) { g5_infer_name_kind_expr($name, $v, $env) }
        ELambda($p, $r, $b, $t) { None }
        EQuestion($x) { g5_infer_name_kind_expr($name, $x, $env) }
        _ { None }
    }
}

sub g5_infer_name_kind_stmt($name: Str, $s: Stmt, $env: CgEnv): Option[CgKind] {
    match $s {
        SBind($m, $n, $ty, $v) { g5_infer_name_kind_expr($name, $v, $env) }
        SExpr($e) { g5_infer_name_kind_expr($name, $e, $env) }
        SReturn($v) {
            match $v {
                None { None }
                Some($e) { g5_infer_name_kind_expr($name, $e, $env) }
            }
        }
        SWhile($c, $b) {
            match g5_infer_name_kind_expr($name, $c, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_stmts($name, $b, $env) }
            }
        }
        SFor($vars, $iter, $b) {
            match g5_infer_name_kind_expr($name, $iter, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_stmts($name, $b, $env) }
            }
        }
        _ { None }
    }
}

sub g5_infer_name_kind_stmts($name: Str, $stmts: StmtList, $env: CgEnv): Option[CgKind] {
    match $stmts {
        StmtNil { None }
        StmtCons($h, $t) {
            match g5_infer_name_kind_stmt($name, $h, $env) {
                Some($k) { Some($k) }
                None { g5_infer_name_kind_stmts($name, $t, $env) }
            }
        }
    }
}

sub g5_infer_param_kind($param: Param, $body: StmtList, $env: CgEnv): Result[CgKind, Str] {
    match $param.ty {
        Some($tr) { g5_param_kind($param.ty, $env) }
        None {
            match g5_infer_name_kind_stmts($param.name, $body, $env) {
                Some($k) {
                    match $k {
                        CgInt { Ok(CgInt) }
                        CgBool { Ok(CgBool) }
                        CgFloat { Ok(CgFloat) }
                        CgStr { Ok(CgStr) }
                        _ { Err(g3_unsupported()) }
                    }
                }
                None { Err(g3_unsupported()) }
            }
        }
    }
}

sub g5_infer_param_kinds($params: ParamList, $body: StmtList, $env: CgEnv): Result[CgKindList, Str] {
    match $params {
        ParamNil { Ok(CgKindNil) }
        ParamCons($h, $t) {
            match g5_infer_param_kind($h, $body, $env) {
                Err($m) { Err($m) }
                Ok($k) {
                    match g5_infer_param_kinds($t, $body, $env) {
                        Err($m) { Err($m) }
                        Ok($rest) { Ok(CgKindCons($k, $rest)) }
                    }
                }
            }
        }
    }
}

sub g5_params_with_kinds($params: ParamList, $kinds: CgKindList): Result[ParamList, Str] {
    match $params {
        ParamNil {
            match $kinds {
                CgKindNil { Ok(ParamNil) }
                _ { Err(g3_unsupported()) }
            }
        }
        ParamCons($h, $pt) {
            match $kinds {
                CgKindNil { Err(g3_unsupported()) }
                CgKindCons($k, $kt) {
                    match g5_params_with_kinds($pt, $kt) {
                        Err($m) { Err($m) }
                        Ok($rest) {
                            match $h.ty {
                                Some($tr) { Ok(ParamCons($h, $rest)) }
                                None {
                                    match g5g_typeref_from_kind($k) {
                                        None { Err(g3_unsupported()) }
                                        Some($tr) { Ok(ParamCons(Param(name: $h.name, ty: Some($tr)), $rest)) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Seed an inference env with prefix binds so a trailing `$g(...)` can see a
# nested topic/parameterized lambda bound earlier in the same body (I4c).
sub g5_seed_lambda_infer_env($stmts: StmtList, $env: CgEnv): CgEnv {
    match $stmts {
        StmtNil { $env }
        StmtCons($h, $t) {
            match $t {
                StmtNil { $env }
                _ {
                    match $h {
                        SBind($m, $n, $ty, $v) {
                            match $v {
                                ELambda($ps, $rt, $bd, $tp) {
                                    match g5_resolve_lambda_ann($ps, $rt, $bd, $env) {
                                        Err($em) { g5_seed_lambda_infer_env($t, $env) }
                                        Ok($ann) {
                                            g5_seed_lambda_infer_env($t, CgEnvCons(CgVar(name: $n, cname: "ginfer_" ~ $n, kind: CgFn($ann.pk, $ann.rk), mutable: false, borrowed: true, listlen: 0), $env))
                                        }
                                    }
                                }
                                _ {
                                    match g5g_arg_kind_from_expr($v, $env) {
                                        None { g5_seed_lambda_infer_env($t, $env) }
                                        Some($k) {
                                            g5_seed_lambda_infer_env($t, CgEnvCons(CgVar(name: $n, cname: "ginfer_" ~ $n, kind: $k, mutable: false, borrowed: true, listlen: 0), $env))
                                        }
                                    }
                                }
                            }
                        }
                        _ { g5_seed_lambda_infer_env($t, $env) }
                    }
                }
            }
        }
    }
}

class LambdaAnn {
    has $.pk: CgKindList
    has $.rk: CgRet
    has $.params: ParamList
    has $.ret: Option[TypeRef]
}

# Resolve a lambda's concrete param/ret kinds: prefer annotations, else I4c
# body-use inference (topic blocks and bare parameterized forms).
sub g5_resolve_lambda_ann($params: ParamList, $ret: Option[TypeRef], $body: StmtList, $env: CgEnv): Result[LambdaAnn, Str] {
    match g5_param_kinds($params, $env) {
        Ok($pk) {
            match g5_ret_kind($ret, $env) {
                Ok($rk) { Ok(LambdaAnn(pk: $pk, rk: $rk, params: $params, ret: $ret)) }
                Err($rm) {
                    match g5_param_env_kinds($params, $pk, 0, cg_env_without_vars($env)) {
                        Err($m) { Err($m) }
                        Ok($penv) {
                            $ienv = g5_seed_lambda_infer_env($body, $penv)
                            match g8_stmts_trailing_expr($body) {
                                None { Err(g3_unsupported()) }
                                Some($te) {
                                    match g5_infer_ret_from_expr($te, $ienv) {
                                        Err($m) { Err($m) }
                                        Ok($rk) {
                                            match g5g_typeref_from_ret($rk) {
                                                None { Err(g3_unsupported()) }
                                                Some($rtr) { Ok(LambdaAnn(pk: $pk, rk: $rk, params: $params, ret: Some($rtr))) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Err($pm) {
            match g5_infer_param_kinds($params, $body, $env) {
                Err($m) { Err($m) }
                Ok($pk) {
                    match g5_params_with_kinds($params, $pk) {
                        Err($m) { Err($m) }
                        Ok($ap) {
                            match g5_ret_kind($ret, $env) {
                                Ok($rk) { Ok(LambdaAnn(pk: $pk, rk: $rk, params: $ap, ret: $ret)) }
                                Err($rm) {
                                    match g5_param_env_kinds($ap, $pk, 0, cg_env_without_vars($env)) {
                                        Err($m) { Err($m) }
                                        Ok($penv) {
                                            $ienv = g5_seed_lambda_infer_env($body, $penv)
                                            match g8_stmts_trailing_expr($body) {
                                                None { Err(g3_unsupported()) }
                                                Some($te) {
                                                    match g5_infer_ret_from_expr($te, $ienv) {
                                                        Err($m) { Err($m) }
                                                        Ok($rk) {
                                                            match g5g_typeref_from_ret($rk) {
                                                                None { Err(g3_unsupported()) }
                                                                Some($rtr) { Ok(LambdaAnn(pk: $pk, rk: $rk, params: $ap, ret: Some($rtr))) }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# Build a LambdaAnn from an expected CgFn shape (typed Func bind or call-arg).
sub g5_lambda_ann_from_fn_kind($params: ParamList, $pk: CgKindList, $rk: CgRet): Result[LambdaAnn, Str] {
    match g5_params_with_kinds($params, $pk) {
        Err($m) { Err($m) }
        Ok($ap) {
            match g5g_typeref_from_ret($rk) {
                None { Err(g3_unsupported()) }
                Some($rtr) { Ok(LambdaAnn(pk: $pk, rk: $rk, params: $ap, ret: Some($rtr))) }
            }
        }
    }
}

sub g5_emit_lambda_value_ann($ann: LambdaAnn, $body: StmtList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_ret_value_kind($ann.rk) {
        Some($rvk) {
            # The body is retkind-agnostic: g5_ret_ctype($rk)/g3_main($rk)
            # drive the C return type. Owned Str/List/Map results cross the same
            # ABI as their named-sub equivalents.
            if g5_lambda_ret_supported($rvk) {
                $lname = "gf_lambda_" ~ c_int($state.nstr)
                $stripped = cg_env_without_vars($env)
                $refs = fv_stmts($body, StrNil)
                $bnames = param_names($ann.params, bn_stmts($body, StrNil))
                $caps = g5_order_captures_owned_first(g5_collect_captures($env, $refs, $bnames, CgEnvNil))
                $capbase = g5_capture_env($caps, 0, $stripped)
                match g5_param_env($ann.params, 0, $capbase) {
                    Err($m) { Err($m) }
                    Ok($lenv) {
                        $lstate = CgState(interns: $state.interns, decls: "", body: "", nstr: $state.nstr + 1, ntmp: 0)
                        match g3_main(SubDecl(public: false, name: $lname, line: 0, col: 0, body_line: 0, body_col: 0, tparams: StrNil, params: $ann.params, ret: $ann.ret, body: BlockBody($body)), $lstate, $lenv, $ann.rk) {
                            Err($m) { Err($m) }
                            Ok($out) {
                                $head = "static " ~ g5_ret_ctype($ann.rk) ~ " " ~ $lname ~ "(" ~ g5_lambda_param_decls($ann.params, $env) ~ ")"
                                if capture_empty($caps) {
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $out.interns ~ $head ~ ";\n" ~ $head ~ " \{\n" ~ $out.decls ~ $out.body ~ "\treturn " ~ $out.ret ~ ";\n}\n\n",
                                            decls: $state.decls,
                                            body: $state.body,
                                            nstr: $out.nstr,
                                            ntmp: $state.ntmp
                                        ),
                                        c: "(guji_fn_t)\{ .fn = (void*)" ~ $lname ~ ", .env = NULL, .copy_env = NULL }"
                                    ))
                                } else {
                                    $sname = "genv_lambda_" ~ c_int($state.nstr)
                                    $copyname = "guji_copy_env_lambda_" ~ c_int($state.nstr)
                                    $struct = "typedef struct \{\n" ~ g5_capture_fields($caps, 0) ~ "} " ~ $sname ~ ";\n"
                                    $copy = g5_capture_copy_helper($caps, $sname, $copyname, $env)
                                    $cast = "\t" ~ $sname ~ "* genv = (" ~ $sname ~ "*)g_env;\n"
                                    $etmp = "ge" ~ c_int($state.ntmp)
                                    $alloc = "\t" ~ $etmp ~ " = (" ~ $sname ~ "*)guji_alloc(GUJI_KIND_ENV, " ~ c_int(g5_capture_owned_count($caps)) ~ ", sizeof(" ~ $sname ~ "));\n"
                                    $fills = g5_capture_fills($caps, 0, $etmp)
                                    Ok(CgValueOut(
                                        state: CgState(
                                            interns: $out.interns ~ $struct ~ $copy ~ $head ~ ";\n" ~ $head ~ " \{\n" ~ $cast ~ $out.decls ~ $out.body ~ "\treturn " ~ $out.ret ~ ";\n}\n\n",
                                            decls: $state.decls ~ "\t" ~ $sname ~ "* " ~ $etmp ~ " = NULL;\n",
                                            body: $state.body ~ $alloc ~ $fills,
                                            nstr: $out.nstr,
                                            ntmp: $state.ntmp + 1
                                        ),
                                        c: "(guji_fn_t)\{ .fn = (void*)" ~ $lname ~ ", .env = " ~ $etmp ~ ", .copy_env = " ~ $copyname ~ " }"
                                    ))
                                }
                            }
                        }
                    }
                }
            } else { Err(g3_unsupported()) }
        }
        None { Err(g3_unsupported()) }
    }
}

sub g5_emit_lambda_value($params: ParamList, $ret: Option[TypeRef], $body: StmtList, $state: CgState, $env: CgEnv): Result[CgValueOut, Str] {
    match g5_resolve_lambda_ann($params, $ret, $body, $env) {
        Err($m) { Err($m) }
        Ok($ann) { g5_emit_lambda_value_ann($ann, $body, $state, $env) }
    }
}

sub g4_lower_fn_bind($mutable: Bool, $name: Str, $params: ParamList, $ret: Option[TypeRef], $body: StmtList, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match g5_resolve_lambda_ann($params, $ret, $body, $env) {
        Err($m) { Err($m) }
        Ok($ann) {
            match g5_emit_lambda_value_ann($ann, $body, $state, $env) {
                Err($m) { Err($m) }
                Ok($fv) {
                    $cn = "gv" ~ c_int($fv.state.ntmp)
                    $kind = CgFn($ann.pk, $ann.rk)
                    $st2 = CgState(
                        interns: $fv.state.interns,
                        decls: $fv.state.decls ~ g4_value_decl($kind, $cn),
                        body: $fv.state.body ~ "\t" ~ $cn ~ " = " ~ $fv.c ~ ";\n",
                        nstr: $fv.state.nstr,
                        ntmp: $fv.state.ntmp + 1
                    )
                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: 0), $env)))
                }
            }
        }
    }
}

# A Handle binding owns one reader reference.  The RHS lowerer retains bound
# handles, materializes fresh standard handles, or transfers an unwrapped
# open/create result, so assigning its temp into the local transfers that +1.
sub g4_handle_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    $type_ok = match $ty {
        None { true }
        Some($tr) {
            if $tr.name == "Handle" {
                match $tr.args { TypeNil { true } _ { false } }
            } else { false }
        }
    }
    if !$type_ok {
        Err(g3_unsupported())
    } else {
        match g4_handle_owned_value($value, $state, $env) {
            Err($m) { Err($m) }
            Ok($hv) {
                $cn = "gv" ~ c_int($hv.state.ntmp)
                $st2 = CgState(
                    interns: $hv.state.interns,
                    decls: $hv.state.decls ~ g4_value_decl(CgHandle, $cn),
                    body: $hv.state.body ~ "\t" ~ $cn ~ " = " ~ $hv.c ~ ";\n",
                    nstr: $hv.state.nstr,
                    ntmp: $hv.state.ntmp + 1
                )
                Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgHandle, mutable: $mutable, borrowed: false, listlen: 0), $env)))
            }
        }
    }
}

# P9-9a/P9-9b-1: bind a function VALUE. Two RHS shapes:
#   - call (`$f = make_double()`): callee's inferred RFn signature → owned
#     pair temp transferred into the local (no retain; caller owns the +1);
#   - alias (`$g = $f`): copy the `guji_fn_t` pair and `guji_retain` the
#     shared env (native emitFnBinding / fnInitFresh=false).
# Scope-exit release goes through the existing CgFn arm of cg_env_release_strs.
# Every other RHS shape falls through to the ordinary cascade unchanged.
sub g5_fn_init_fresh($value: Expr): Bool {
    match $value {
        ELambda($p, $r, $b, $t) { true }
        ECall($c, $a) { true }
        # The control-flow lowerers normalize every selected branch to an owned
        # result, retaining aliases inside the branch before local cleanup.
        EIf($c, $t, $es, $el) { true }
        EMatch($s, $arms) { true }
        _ { false }
    }
}

sub g4_fn_call_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $ty {
        Some($tr) {
            if $tr.name == "Func" {
                match g5_func_kind_from_type_args($tr.args, $env) {
                    Err($m) { Err($m) }
                    Ok($kind) {
                        match $kind {
                            CgFn($p, $r) {
                                match g4_lower_value($kind, $value, $state, $env) {
                                    Err($m) { Err($m) }
                                    Ok($fnv) {
                                        $cn = "gv" ~ c_int($fnv.state.ntmp)
                                        $retain = if g5_fn_init_fresh($value) { "" } else { "\tguji_retain(" ~ $fnv.c ~ ".env);\n" }
                                        $st2 = CgState(
                                            interns: $fnv.state.interns,
                                            decls: $fnv.state.decls ~ g4_value_decl($kind, $cn),
                                            body: $fnv.state.body ~ $retain ~ "\t" ~ $cn ~ " = " ~ $fnv.c ~ ";\n",
                                            nstr: $fnv.state.nstr,
                                            ntmp: $fnv.state.ntmp + 1
                                        )
                                        Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: 0), $env)))
                                    }
                                }
                            }
                            _ { Err(g3_unsupported()) }
                        }
                    }
                }
            } else {
                Err(g3_unsupported())
            }
        }
        None {
            match g5_fn_arg_kind($value, $env) {
                Err($m) { Err($m) }
                Ok($kind) {
                    match $kind {
                        CgFn($p, $r) {
                            match g4_lower_value($kind, $value, $state, $env) {
                                Err($m) { Err($m) }
                                Ok($fnv) {
                                    $cn = "gv" ~ c_int($fnv.state.ntmp)
                                    $retain = if g5_fn_init_fresh($value) { "" } else { "\tguji_retain(" ~ $fnv.c ~ ".env);\n" }
                                    $st2 = CgState(
                                        interns: $fnv.state.interns,
                                        decls: $fnv.state.decls ~ g4_value_decl($kind, $cn),
                                        body: $fnv.state.body ~ $retain ~ "\t" ~ $cn ~ " = " ~ $fnv.c ~ ";\n",
                                        nstr: $fnv.state.nstr,
                                        ntmp: $fnv.state.ntmp + 1
                                    )
                                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: 0), $env)))
                                }
                            }
                        }
                        _ { Err(g3_unsupported()) }
                    }
                }
            }
        }
    }
}

sub g4_lower_fresh_bind($mutable: Bool, $name: Str, $ty: Option[TypeRef], $value: Expr, $state: CgState, $env: CgEnv): Result[BindOut, Str] {
    match $value {
        ELambda($params, $ret, $body, $topic) {
            # I4c: a `: Func[...]` annotation supplies kinds when the topic body
            # alone cannot infer them (e.g. identity `{ $_ }`).
            match $ty {
                Some($tr) {
                    if $tr.name == "Func" {
                        match g5_func_kind_from_type_args($tr.args, $env) {
                            Ok($fk) {
                                match $fk {
                                    CgFn($pk, $rk) {
                                        match g5_lambda_ann_from_fn_kind($params, $pk, $rk) {
                                            Ok($ann) {
                                                match g5_emit_lambda_value_ann($ann, $body, $state, $env) {
                                                    Err($m) { Err($m) }
                                                    Ok($fv) {
                                                        $cn = "gv" ~ c_int($fv.state.ntmp)
                                                        $kind = CgFn($ann.pk, $ann.rk)
                                                        $st2 = CgState(
                                                            interns: $fv.state.interns,
                                                            decls: $fv.state.decls ~ g4_value_decl($kind, $cn),
                                                            body: $fv.state.body ~ "\t" ~ $cn ~ " = " ~ $fv.c ~ ";\n",
                                                            nstr: $fv.state.nstr,
                                                            ntmp: $fv.state.ntmp + 1
                                                        )
                                                        Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $kind, mutable: $mutable, borrowed: false, listlen: 0), $env)))
                                                    }
                                                }
                                            }
                                            Err($am) { g4_lower_fn_bind($mutable, $name, $params, $ret, $body, $state, $env) }
                                        }
                                    }
                                    _ { g4_lower_fn_bind($mutable, $name, $params, $ret, $body, $state, $env) }
                                }
                            }
                            Err($fm) { g4_lower_fn_bind($mutable, $name, $params, $ret, $body, $state, $env) }
                        }
                    } else {
                        g4_lower_fn_bind($mutable, $name, $params, $ret, $body, $state, $env)
                    }
                }
                None { g4_lower_fn_bind($mutable, $name, $params, $ret, $body, $state, $env) }
            }
        }
        _ {
    match g4_fn_call_bind($mutable, $name, $ty, $value, $state, $env) {
        Ok($fb) { Ok($fb) }
        Err($not_fn) {
    match g4_handle_bind($mutable, $name, $ty, $value, $state, $env) {
        Ok($hb) { Ok($hb) }
        Err($not_handle) {
    # P6f Option[Match] unwrap binds: exact matcher, every other RHS falls through.
    match g6_match_unwrap_bind($mutable, $name, $ty, $value, $state, $env) {
        Ok($mub) { Ok($mub) }
        Err($not_match_unwrap) {
    # P7c-2b-2b Option[Bush] unwrap/expect binds (retain vs transfer).
    match g10_bush_unwrap_bind($mutable, $name, $ty, $value, $state, $env) {
        Ok($bub) { Ok($bub) }
        Err($not_bush_unwrap) {
    match g10_bush_bind($mutable, $name, $ty, $value, $state, $env) {
        Ok($bb) { Ok($bb) }
        Err($not_bush) {
    match g11_chan_bind($mutable, $name, $ty, $value, $state, $env) {
        Ok($cb) { Ok($cb) }
        Err($not_chan) {
    match g7_list_elem_kind_from_type($ty) {
        Ok($lelem) { g7_lower_list_bind($lelem, $mutable, $name, $value, $state, $env) }
        Err($not_list) {
    # An UNANNOTATED list binding (`@argv = args()`) carries no TypeRef, so infer the
    # element kind from the RHS value before falling through to the scalar inference.
    match g7_list_kind_from_value($value, $env) {
        Ok($vlelem) { g7_lower_list_bind($vlelem, $mutable, $name, $value, $state, $env) }
        Err($not_list_val) {
    match g7_map_val_kind_from_type($ty) {
        Ok($mval) { g7_lower_map_bind($mval, $mutable, $name, $value, $state, $env) }
        Err($not_map) {
    match g7_map_val_kind_from_value($value, $env) {
        Ok($mval) { g7_lower_map_bind($mval, $mutable, $name, $value, $state, $env) }
        Err($not_map_val) {
    match g6e_enum_kind_from_type($ty, $env) {
        Ok($ekind) { g4_lower_enum_bind($mutable, $name, $ekind, $value, $state, $env) }
        Err($not_enum) {
    match g6e_enum_kind_from_value($value, $env) {
        Ok($ekind) { g4_lower_enum_bind($mutable, $name, $ekind, $value, $state, $env) }
        Err($not_inferred_enum) {
    match g6_option_kind_from_type($ty) {
        Ok($okind) {
            match g4_lower_value($okind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($ov) {
                    $cn = "gv" ~ c_int($ov.state.ntmp)
                    $st2 = CgState(
                        interns: $ov.state.interns,
                        decls: $ov.state.decls ~ g4_value_decl($okind, $cn),
                        body: $ov.state.body ~ "\t" ~ $cn ~ " = " ~ $ov.c ~ ";\n",
                        nstr: $ov.state.nstr,
                        ntmp: $ov.state.ntmp + 1
                    )
                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $okind, mutable: $mutable, borrowed: false, listlen: g6_option_bind_listlen_value($ty, $value, $env)), $env)))
                }
            }
        }
        Err($not_opt) {
    # An UNANNOTATED Option binding (`$o = wrap(21)`) carries no TypeRef, so infer
    # the carrier kind from the RHS value (the same type→value ordering the
    # list/map/enum/result steps above and below use), then lower through the
    # IDENTICAL block the annotated form takes.
    match g6_option_kind_from_value($value, $env) {
        Ok($okind) {
            match g4_lower_value($okind, $value, $state, $env) {
                Err($m) { Err($m) }
                Ok($ov) {
                    $cn = "gv" ~ c_int($ov.state.ntmp)
                    $st2 = CgState(
                        interns: $ov.state.interns,
                        decls: $ov.state.decls ~ g4_value_decl($okind, $cn),
                        body: $ov.state.body ~ "\t" ~ $cn ~ " = " ~ $ov.c ~ ";\n",
                        nstr: $ov.state.nstr,
                        ntmp: $ov.state.ntmp + 1
                    )
                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $okind, mutable: $mutable, borrowed: false, listlen: g6_option_bind_listlen_value($ty, $value, $env)), $env)))
                }
            }
        }
        Err($not_opt_val) {
            match g6_result_kind_from_type($ty, $env) {
                Ok($rkind) {
                    match g4_lower_value($rkind, $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($rv) {
                            $cn = "gv" ~ c_int($rv.state.ntmp)
                            $st2 = CgState(
                                interns: $rv.state.interns,
                                decls: $rv.state.decls ~ g4_value_decl($rkind, $cn),
                                body: $rv.state.body ~ "\t" ~ $cn ~ " = " ~ $rv.c ~ ";\n",
                                nstr: $rv.state.nstr,
                                ntmp: $rv.state.ntmp + 1
                            )
                            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $rkind, mutable: $mutable, borrowed: false, listlen: g6_result_bind_listlen_value($ty, $value, $env)), $env)))
                        }
                    }
                }
                Err($not_res) {
            match g6_result_kind_from_value($value, $env) {
                Ok($rkind) {
                    match g4_lower_value($rkind, $value, $state, $env) {
                        Err($m) { Err($m) }
                        Ok($rv) {
                            $cn = "gv" ~ c_int($rv.state.ntmp)
                            $st2 = CgState(
                                interns: $rv.state.interns,
                                decls: $rv.state.decls ~ g4_value_decl($rkind, $cn),
                                body: $rv.state.body ~ "\t" ~ $cn ~ " = " ~ $rv.c ~ ";\n",
                                nstr: $rv.state.nstr,
                                ntmp: $rv.state.ntmp + 1
                            )
                            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: $rkind, mutable: $mutable, borrowed: false, listlen: g6_result_bind_listlen_value($ty, $value, $env)), $env)))
                        }
                    }
                }
                Err($not_inferred_res) {
            match g8_class_kind_from_type($ty, $env) {
                Ok($ckind) { g4_lower_class_bind($mutable, $name, $ckind, $value, $state, $env) }
                Err($not_class) {
            match g8_class_kind_from_value($value, $env) {
                Ok($ckind) { g4_lower_class_bind($mutable, $name, $ckind, $value, $state, $env) }
                Err($not_inferred_class) {
            match g4_lower_value(CgInt, $value, $state, $env) {
        Ok($iv) {
            $cn = "gv" ~ c_int($iv.state.ntmp)
            $st2 = CgState(
                interns: $iv.state.interns,
                decls: $iv.state.decls ~ "\tint64_t " ~ $cn ~ " = 0;\n",
                body: $iv.state.body ~ "\t" ~ $cn ~ " = " ~ $iv.c ~ ";\n",
                nstr: $iv.state.nstr,
                ntmp: $iv.state.ntmp + 1
            )
            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgInt, mutable: $mutable, borrowed: false, listlen: 0), $env)))
        }
        Err($mi) {
            match g4_lower_value(CgFloat, $value, $state, $env) {
                Ok($fv) {
                    $cn = "gv" ~ c_int($fv.state.ntmp)
                    $st2 = CgState(
                        interns: $fv.state.interns,
                        decls: $fv.state.decls ~ "\tdouble " ~ $cn ~ " = 0.0;\n",
                        body: $fv.state.body ~ "\t" ~ $cn ~ " = " ~ $fv.c ~ ";\n",
                        nstr: $fv.state.nstr,
                        ntmp: $fv.state.ntmp + 1
                    )
                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgFloat, mutable: $mutable, borrowed: false, listlen: 0), $env)))
                }
                Err($mf) {
                    match g4_lower_value(CgBool, $value, $state, $env) {
                        Ok($bl) {
                            $cn = "gv" ~ c_int($bl.state.ntmp)
                            $st2 = CgState(
                                interns: $bl.state.interns,
                                decls: $bl.state.decls ~ "\tint64_t " ~ $cn ~ " = 0;\n",
                                body: $bl.state.body ~ "\t" ~ $cn ~ " = " ~ $bl.c ~ ";\n",
                                nstr: $bl.state.nstr,
                                ntmp: $bl.state.ntmp + 1
                            )
                            Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgBool, mutable: $mutable, borrowed: false, listlen: 0), $env)))
                        }
                        Err($mb) {
                            match g4_lower_value(CgStr, $value, $state, $env) {
                                Err($ms) { Err(g3_unsupported()) }
                                Ok($sl) {
                                    $cn = "gv" ~ c_int($sl.state.ntmp)
                                    $st2 = CgState(
                                        interns: $sl.state.interns,
                                        decls: $sl.state.decls ~ "\tconst char* " ~ $cn ~ " = GUJI_EMPTY_STR;\n",
                                        body: $sl.state.body ~ "\t" ~ $cn ~ " = " ~ $sl.c ~ ";\n",
                                        nstr: $sl.state.nstr,
                                        ntmp: $sl.state.ntmp + 1
                                    )
                                    Ok(BindOut(state: $st2, env: CgEnvCons(CgVar(name: $name, cname: $cn, kind: CgStr, mutable: $mutable, borrowed: false, listlen: g6_str_bind_listlen($ty, $value, $env)), $env)))
        }
    }
        }
    }
        }
                }
            }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
                }
            }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
        }
    }
}
