sub lo(): Int { 2 }

sub find_first_sq_ge($limit: Int): Int {
    for $i in 1..100 {
        if $i * $i >= $limit {
            return $i
        }
    }
    0 - 1
}

sub main(): Int {
    mut $sum = 0

    for $i in 1..4 {
        $sum = $sum + $i
    }

    for $j in lo()..<5 {
        $sum = $sum + 10
    }

    for $k in 5..3 {
        $sum = $sum + 100
    }

    for $e in 7..<7 {
        $sum = $sum + 100
    }

    $max = 9223372036854775807
    for $b in ($max - 2)..$max {
        if $b == $max {
            $sum = $sum + 1
        }
    }

    $min = 0 - 9223372036854775807 - 1
    for $m in 5..<$min {
        $sum = $sum + 1000
    }

    for $t in 1..<3 {
        $s = "t" ~ "{ $t }"
        print($s)
    }

    print("{ find_first_sq_ge(20) }")
    print("{ $sum }")
    $sum
}
