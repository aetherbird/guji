# P9-11a: hatch capture of nested Map-value enums — Map[Str,List] /
# Map[Str,Map] detach via hatchCopyEnum → guji_copy_arr cascade.
enum Bag {
    Buckets($b: Map[Str, List[Int]])
    Grid($g: Map[Str, Map[Str, Str]])
    Empty
}

sub main(): Int {
    mut $base = 5
    $buckets = Buckets({"evens": [$base, 7], "odds": [1, 3]})
    $grid = Grid({"left": {"x": "foo"}, "right": {"y": "bar"}})
    $intCh: Chan[Int] = channel(0)
    $strCh: Chan[Str] = channel(0)

    hatch {
        mut $s = 0
        $s = match $buckets {
            Buckets($b) { $b{"evens"}[0] + $b{"evens"}[1] + $b{"odds"}[1] }
            Grid($g) { 0 }
            Empty { 0 }
        }
        $intCh.send($s)
    }

    hatch {
        mut $w = ""
        $w = match $grid {
            Buckets($b) { "buckets" }
            Grid($g) { $g{"left"}{"x"} ~ $g{"right"}{"y"} }
            Empty { "empty" }
        }
        $strCh.send($w)
    }

    $base = 999
    print($intCh.recv().unwrap())
    print($strCh.recv().unwrap())
    0
}
