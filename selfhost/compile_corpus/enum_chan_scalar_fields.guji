# I10a1 bootstrap boundary: every scalar Chan[T] can live in a user enum before
# the evaluator's Value enum adopts the same field shapes. Direct display is
# opaque and equality observes handle identity, not buffered state.
enum ScalarChannels {
    Empty
    Active($unit: Chan[Unit], $int: Chan[Int], $bool: Chan[Bool], $float: Chan[Float], $str: Chan[Str])
}

sub alias_int($ch: Chan[Int]): Chan[Int] {
    $ch
}

sub main(): Int {
    $unit: Chan[Unit] = channel()
    $int: Chan[Int] = channel(1)
    $bool: Chan[Bool] = channel(2)
    $float: Chan[Float] = channel(3)
    $str: Chan[Str] = channel(4)

    $alias = alias_int($int)
    $other: Chan[Int] = channel(1)
    print($int)
    print($int == $alias)
    print($int == $other)

    $one = Active($unit, $int, $bool, $float, $str)
    $two = Active($unit, $int, $bool, $float, $str)
    print($one)
    print($one == $two)
    0
}
