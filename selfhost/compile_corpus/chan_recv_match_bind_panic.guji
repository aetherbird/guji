# P8d-2c-3d-2 panic twin: a Some-arm key miss on a recv-derived map binder
# panics at RUNTIME ("map key not found", exit 1) while the bound carrier
# still holds its heap payload — stderr must be byte-identical
# native == selfhost (both engines share the captured C runtime).
sub main(): Int {
    $ch: Chan[Map[Str, Str]] = channel(1)
    $ch.send({"k": "v" ~ "9"})
    $opt = $ch.recv()
    match $opt {
        Some(%m) { print(%m{"missing"}) }
        None { print("none") }
    }
    0
}
