# P8d-2c-3c-2: owned Map channel payloads with scalar and Str values. Buffered
# send/recv/close stays scheduler-independent. Map messages deep-copy both
# counted arrays; rejected and undrained messages exercise guji_chan_drop_map.
sub main(): Int {
    %src: Map[Str, Int] = {"a": 10, "b": 20}
    $ch: Chan[Map[Str, Int]] = channel(1)
    $ch.send(%src)
    $ch.close()
    print(%src{"a"} + %src{"b"})
    $a: Option[Map[Str, Int]] = $ch.recv()
    print($a.is_some())
    $done: Option[Map[Str, Int]] = $ch.recv()
    print($done.is_none())
    %late: Map[Str, Int] = {"late": 1}
    $rejected = $ch.send(%late)
    print($rejected.is_err())

    # Scope cleanup drops an undelivered detached map copy.
    %undelivered: Map[Str, Int] = {"left": 9}
    $left: Chan[Map[Str, Int]] = channel(1)
    $left.send(%undelivered)

    0
}
