# P8d-2c-2: CHANNEL returns (RChan). Fresh builders/call results transfer their
# +1; bound-name tails retain into a temp before scope-exit cleanup (the UAF
# trap). Unannotated `$ch = make_chan()` binds from RChan. Sequential (no hatch)
# uses buffered channels so send does not block; recv carriers bind before
# unwrap (chained recv unwrap / method-on-call-result stay later).
sub make_chan(): Chan[Int] {
    channel(1)
}

sub make_cap($n: Int): Chan[Int] {
    channel($n)
}

sub alias_out($ch: Chan[Int]): Chan[Int] {
    $alias = $ch
    $alias
}

sub main(): Int {
    $ch = make_chan()
    $ch.send(40);
    $ch2 = alias_out($ch)
    $peek = $ch2.recv()
    print($peek.unwrap())

    $buf = make_cap(1)
    $buf.send(2);
    $got = $buf.recv()
    print($got.unwrap())
    $buf.close()
    $after = $buf.recv()
    print($after.is_none())
    0
}
