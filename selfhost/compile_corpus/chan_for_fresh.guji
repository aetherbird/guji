# P8d-2c-3c-4: fresh/non-name channel iterators (§17.4). Native materializes the
# iterator expr into an owned temp handle (RChan-returning call transfers its
# +1), drains with the ordinary recv-until-None loop, then releases the temp.
# Bound-name `for $x in $ch` stays on the no-extra-retain path.
sub make_ints(): Chan[Int] {
    $ch: Chan[Int] = channel(2)
    $ch.send(10)
    $ch.send(20)
    $ch.close()
    $ch
}

sub make_strs(): Chan[Str] {
    $ch: Chan[Str] = channel(2)
    $ch.send("a" ~ "1")
    $ch.send("b" ~ "2")
    $ch.close()
    $ch
}

sub make_empty(): Chan[Int] {
    $ch: Chan[Int] = channel(1)
    $ch.close()
    $ch
}

sub main(): Int {
    for $n in make_ints() {
        print($n)
    }
    for $s in make_strs() {
        print($s)
    }
    for $z in make_empty() {
        print($z)
    }
    0
}
