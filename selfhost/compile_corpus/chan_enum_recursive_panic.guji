# P8d-2c-3c-14 panic twin: unwrap on a closed, drained recursive-enum channel
# panics identically in every engine (exit 1, "unwrap on None").
enum Tree {
    Leaf($name: Str, $value: Int)
    Node($left: Tree, $right: Tree)
}

sub sum($t: Tree): Int {
    match $t {
        Leaf(_, $v) { $v }
        Node($l, $r) { sum($l) + sum($r) }
    }
}

sub main(): Int {
    $ch: Chan[Tree] = channel(2)
    $ch.send(Leaf("x", 5))
    $ch.close()
    $first = $ch.recv().unwrap()
    print("{ sum($first) }")
    $boom = $ch.recv().unwrap()
    print("{ sum($boom) }")
    0
}
