# P9-11a: nested List-payload enums over channels — List[List[scalar|Str]] and
# List[Map[Str,Str]] deep-detach via KIND-tagged guji_copy_arr (predicate widen
# to g6e_enum_collection_elem_supported). Maps left buffered for LSan.
enum Msg {
    Rows($xs: List[List[Int]])
    Words($ws: List[List[Str]])
    Maps($ms: List[Map[Str, Str]])
    Done
}

sub show($m: Msg): Str {
    match $m {
        Rows($xs) {
            mut $sum = 0
            for @row in $xs {
                for $n in @row {
                    $sum = $sum + $n
                }
            }
            "sum={ $sum }"
        }
        Words($ws) {
            @a = $ws[0]
            @b = $ws[1]
            @a[0] ~ "/" ~ @b[0]
        }
        Maps($ms) {
            %m = $ms[0]
            %m{"k"}
        }
        Done { "done" }
    }
}

sub main(): Unit {
    $ch: Chan[Msg] = channel(3)
    $ch.send(Rows([[1, 2, 3], [4, 5]]))
    $ch.send(Words([["red", "green"], ["blue"]]))
    $ch.send(Maps([{"k": "held"}, {"z": "drop"}]))

    print(show($ch.recv().unwrap()))
    print(show($ch.recv().unwrap()))
}
