# §15.5 Result `ok`/`err`, function and method forms, over bound
# `Result[T,E]` locals. The conversions produce Option values: Ok(v).ok() is
# Some(v), Err(_).ok() is None, Ok(_).err() is None, and Err(e).err() is Some(e).

sub ok_int(): Result[Int, Str] {
    Ok(7)
}

sub ok_bool(): Result[Bool, Str] {
    Ok(false)
}

sub ok_str(): Result[Str, Str] {
    Ok("pay" ~ "load")
}

sub err_str(): Result[Int, Str] {
    Err("bad" ~ "!")
}

sub err_int(): Result[Str, Int] {
    Err(-7)
}

sub err_bool(): Result[Int, Bool] {
    Err(true)
}

sub main(): Int {
    $ri: Result[Int, Str] = ok_int()
    $rb: Result[Bool, Str] = ok_bool()
    $rs: Result[Str, Str] = ok_str()
    $es: Result[Int, Str] = err_str()
    $ei: Result[Str, Int] = err_int()
    $eb: Result[Int, Bool] = err_bool()

    $oi: Option[Int] = $ri.ok()
    $ob: Option[Bool] = $rb.ok()
    $os: Option[Str] = ok($rs)
    $none_i: Option[Int] = $es.ok()
    $none_s: Option[Str] = $ei.ok()

    $err_s: Option[Str] = $es.err()
    $err_i: Option[Int] = err($ei)
    $err_b: Option[Bool] = err($eb)
    $none_err: Option[Str] = $rs.err()

    mut $code = 0

    match $oi {
        Some($n) { if $n == 7 { $code = $code + 1 } else { $code = $code + 1000 } }
        None { $code = $code + 1000 }
    }
    match $ob {
        Some($b) { if $b { $code = $code + 1000 } else { $code = $code + 4 } }
        None { $code = $code + 1000 }
    }
    match $os {
        Some($s) {
            print($s)
            $code = $code + 8
        }
        None { $code = $code + 1000 }
    }

    if $none_i.is_none() { $code = $code + 16 } else { $code = $code + 1000 }
    if is_none($none_s) { $code = $code + 32 } else { $code = $code + 1000 }

    match $err_s {
        Some($s) {
            print($s)
            $code = $code + 64
        }
        None { $code = $code + 1000 }
    }
    match $err_i {
        Some($n) { if $n == -7 { $code = $code + 128 } else { $code = $code + 1000 } }
        None { $code = $code + 1000 }
    }
    match $err_b {
        Some($b) { if $b { $code = $code + 512 } else { $code = $code + 1000 } }
        None { $code = $code + 1000 }
    }

    if $none_err.is_none() { $code = $code + 0 } else { $code = $code + 1000 }

    # 1+4+8+16+32+64+128+512 = 765; keep exit below 256.
    $code - 512
}
