# P8d-2c-3c-13 panic twin: unwrap on a closed, drained collection-enum channel
# panics identically in every engine (exit 1, "unwrap on None").
enum Pack {
    Nums(@xs: List[Int])
    Tag($n: Int)
}

sub main(): Int {
    $ch: Chan[Pack] = channel(2)
    $ch.send(Nums([5, 6]))
    $ch.close()
    $first = $ch.recv().unwrap()
    match $first {
        Nums(@xs) {
            $a = @xs[1]
            print("drained:$a")
        }
        Tag($n) { print("tag:$n") }
    }
    $boom = $ch.recv().unwrap()
    match $boom {
        Nums(@xs) { print("unreachable") }
        Tag($n) { print("unreachable") }
    }
    0
}
