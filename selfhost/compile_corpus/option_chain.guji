sub mk($n: Int): Option[Int] {
    if $n > 0 { Some($n) } else { None }
}
sub bump($o: Option[Int]): Option[Int] {
    match $o {
        Some($v) { Some($v + 1) }
        None { None }
    }
}
sub unwrap_or($o: Option[Int], $d: Int): Int {
    match $o {
        Some($v) { $v }
        None { $d }
    }
}
sub main(): Int {
    unwrap_or(bump(mk(5)), 0) + unwrap_or(bump(mk(-1)), 7)
}
