# P8d-2c-3d-2c: scalar-enum receive-carrier extraction — `$ch.recv().unwrap()`,
# bound `$opt.unwrap()`, and function-form `unwrap($ch.recv())` (native accepts
# all three for fieldless / Int / Bool / Float enums; expect is a native
# oracle-limit — "codegen lost track of the enum" — kept out of three-way).
# After the None guard, native materializes a named enum temp by plain by-value
# `.val` copy with no retain (scalar owns no heap).
enum Signal {
    Stop
    Go
    Wait($secs: Int)
}

enum Flag {
    Off
    On
}

enum Measure {
    Absent
    Exact($v: Float)
    Bit($b: Bool)
}

sub main(): Int {
    $ch: Chan[Signal] = channel(2)
    $ch.send(Go)
    $ch.send(Wait(4))
    $ch.close()
    $a = $ch.recv().unwrap()
    $b = unwrap($ch.recv())
    print(match $a { Stop { 0 } Go { 1 } Wait($s) { $s } })
    print(match $b { Stop { 0 } Go { 1 } Wait($s) { $s } })

    $more: Chan[Signal] = channel(1)
    $more.send(Wait(9))
    $more.close()
    $opt = $more.recv()
    $c = $opt.unwrap()
    print(match $c { Wait($s) { $s } _ { -1 } })

    $flags: Chan[Flag] = channel(1)
    $flags.send(On)
    $flags.close()
    $d = $flags.recv().unwrap()
    print(match $d { Off { 0 } On { 1 } })

    $ms: Chan[Measure] = channel(2)
    $ms.send(Exact(1.5))
    $ms.send(Bit(true))
    $ms.close()
    $e = $ms.recv().unwrap()
    $f = unwrap($ms.recv())
    print(match $e { Exact($v) { if $v > 1.0 { 1 } else { 0 } } _ { 0 } })
    print(match $f { Bit($x) { if $x { 2 } else { 0 } } _ { 0 } })

    0
}
