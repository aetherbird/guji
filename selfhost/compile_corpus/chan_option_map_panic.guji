# P8d-2c-3c-10 panic path: outer recv unwrap on a closed, drained
# Chan[Option[Map[Str,Int]]] panics; a delivered inner None is not this state.
sub main(): Int {
    $ch: Chan[Option[Map[Str,Int]]] = channel(1)
    $ch.close()
    $value: Option[Map[Str,Int]] = $ch.recv().unwrap()
    print($value.is_some())
    0
}
