# §15.5 Option `filter`, method form `$o.filter(p)` and function form
# `filter($o, p)`, over bound `Option[T]` locals: keep the payload iff the
# predicate lambda `sub($v: T): Bool { ... }` holds, else yield `None`. The
# result carrier is `Option[T]` — the SAME payload kind (filter never changes T).
# Native lowers it to a zeroed Option[T] temp filled only under the Some+predicate
# guard: `if (opt.tag != 0) { binder = opt.val; if (<pred>) { r.tag = 1; r.val =
# opt.val; } }`, with a Str payload retained (both source and result carry the
# same heap Str). The binder BORROWS the source payload (no retain); a None source
# never runs the predicate. Native `guji build` supports all of it, so this is a
# THREE-WAY case (interp == native == selfhost). Exit 255 (code 4095) iff every
# polarity/payload assertion holds.

sub mki($n: Int): Option[Int] {
    if $n > 0 { Some($n) } else { None }
}
sub mks($n: Int): Option[Str] {
    # A heap-built Some payload: a wrong retain/slot balance shows under ASan/LSan.
    if $n > 0 { Some("v" ~ "al{ $n }") } else { None }
}
sub mkf($n: Int): Option[Float] {
    if $n > 0 { Some(1.5) } else { None }
}
sub mkb($n: Int): Option[Bool] {
    if $n > 0 { Some(true) } else { None }
}

sub main(): Int {
    $si: Option[Int] = mki(5)
    $ni: Option[Int] = mki(-1)
    $ss: Option[Str] = mks(9)
    $sf: Option[Float] = mkf(1)
    $sb: Option[Bool] = mkb(1)
    $base = 3

    mut $code = 0

    # Int filter, both spellings: predicate true keeps Some, false yields None.
    $a: Option[Int] = $si.filter(sub($v: Int): Bool { $v > 2 })
    $b: Option[Int] = filter($si, sub($v: Int): Bool { $v > 100 })
    if $a.unwrap_or(0) == 5 { $code = $code + 1 }
    if $b.is_none() { $code = $code + 2 }

    # Filtering a None source never runs the predicate — stays None.
    $c: Option[Int] = $ni.filter(sub($v: Int): Bool { $v > 2 })
    if $c.is_none() { $code = $code + 4 }

    # Str filter: predicate true keeps the borrowed heap payload (retained into
    # the fresh Some slot); predicate false yields None (no retain, no leak).
    $d: Option[Str] = $ss.filter(sub($s: Str): Bool { $s == "val9" })
    $e: Option[Str] = filter($ss, sub($t: Str): Bool { $t == "nope" })
    print($d.unwrap_or("x"))
    if $e.is_none() { $code = $code + 8 }

    # Float and Bool payloads.
    $f: Option[Float] = $sf.filter(sub($x: Float): Bool { $x > 1.0 })
    $g: Option[Float] = $sf.filter(sub($y: Float): Bool { $y > 9.0 })
    if $f.unwrap_or(0.0) == 1.5 { $code = $code + 16 }
    if $g.is_none() { $code = $code + 32 }
    $h: Option[Bool] = $sb.filter(sub($w: Bool): Bool { $w })
    $i: Option[Bool] = $sb.filter(sub($z: Bool): Bool { if $z { false } else { true } })
    if $h.unwrap_or(false) { $code = $code + 64 }
    if $i.is_none() { $code = $code + 128 }

    # The predicate body may reference enclosing locals (lowered inline).
    $j: Option[Int] = $si.filter(sub($v: Int): Bool { $v > $base })
    $k: Option[Int] = filter($si, sub($v: Int): Bool { $v < $base })
    if $j.unwrap_or(0) == 5 { $code = $code + 256 }
    if $k.is_none() { $code = $code + 512 }

    # A fresh filtered Option is itself a filterable bound local (chaining).
    $l: Option[Int] = $a.filter(sub($v: Int): Bool { $v == 5 })
    if $l.unwrap_or(0) == 5 { $code = $code + 1024 }

    # A filtered Option used directly as a match SCRUTINEE (the probe-chain path
    # through g6_option_value): the retained Str payload is released by the
    # match's owned-scrutinee cleanup, not a binding.
    match $ss.filter(sub($s: Str): Bool { $s == "val9" }) {
        Some($mx) { print($mx) }
        None { print("none") }
    }
    match filter($si, sub($v: Int): Bool { $v > 100 }) {
        Some($mn) { $code = $code + 1024 }
        None { $code = $code + 2048 }
    }

    print("{ $code }")
    # 1+2+4+8+16+32+64+128+256+512+1024+2048 = 4095; keep exit below 256.
    $code - 3840
}
