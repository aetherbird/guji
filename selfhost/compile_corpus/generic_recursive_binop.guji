# P5b-2b(binop-arg): generic subs whose recursive / transitive CALLS pass an
# ARITHMETIC argument (`$n - 1`) — the canonical recursion step. Before the
# g5g_binop_kind fix these declined rc 4: g5_kind_from_expr cannot infer an
# EBinary/EUnary kind, so a generic call with an arithmetic argument found no
# monomorphized spec. Native accepts them; this pins the three-way behavior over
# Int/Float/Str type params, self- and mutual-recursion, a type argument BOUND from
# an arithmetic expression, and a comparison-result Bool argument.

sub rep[T]($x: T, $n: Int): T {
    if $n <= 1 { $x } else { rep($x, $n - 1) }
}

sub ping[T]($x: T, $n: Int): T {
    if $n <= 0 { $x } else { pong($x, $n - 1) }
}

sub pong[T]($x: T, $n: Int): T {
    if $n <= 0 { $x } else { ping($x, $n - 1) }
}

# T binds from arithmetic args (`$n - 1`, `$n + 1`); the flag arg is a
# comparison-result Bool (`$n > 0`), which now also infers as CgBool.
sub choose[T]($a: T, $b: T, $flag: Bool): T {
    if $flag { $a } else { $b }
}

sub main(): Int {
    $ri = rep(5, 4)
    print("{ $ri }")
    $rs = rep("z", 3)
    print($rs)
    $rf = rep(2.5, 2)
    print("{ $rf }")
    $p = ping("bounce", 5)
    print($p)
    $q = ping(9, 4)
    print("{ $q }")
    $n = 3
    $c = choose($n - 1, $n + 1, $n > 0)
    print("{ $c }")
    $ri + $q + $c
}
