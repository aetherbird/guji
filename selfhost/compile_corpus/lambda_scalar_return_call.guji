# P1c-b-2b-2b (§7.4): directly-called first-class lambdas with NON-Int scalar
# returns — Bool, Float, and Str — each capturing an enclosing scalar/Str local.
# Native lowers a Bool/Float/Str-returning lambda to a `gf_lambda_N` whose C return
# type is int64_t / double / const char* respectively; the direct-call site owns
# and releases a returned Str exactly like a Str-returning sub call. This slice
# mirrors that: three closures, one per non-Int scalar return, exercised twice each
# so the Str capture retain/release balance and the returned owned-Str release both
# run more than once. The heap `~` Str proves the counting is real.
sub main(): Int {
    $base = 3
    $bump = 2.5
    $suffix = "cha" ~ "rs!"
    $pred = sub($n: Int): Bool { $n > $base }
    $scale = sub($x: Float): Float { $x + $bump }
    $shout = sub($s: Str): Str { $s ~ $suffix }
    if $pred(5) { print("hi") } else { print("lo") }
    if $pred(1) { print("hi") } else { print("lo") }
    print("{ $scale(5.0) }")
    print("{ $scale(1.0) }")
    print($shout("go"))
    print($shout("guji"))
    $base + 4
}
