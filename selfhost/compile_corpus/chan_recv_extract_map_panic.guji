# P8d-2c-3d-2b: Map recv unwrap on a closed empty channel panics "unwrap on
# None" (exit 1, stderr byte-identical native==selfhost). Map `expect` binds
# are a native reject ("map bindings from map expressions only"), so the panic
# corpus uses unwrap-on-closed — the List twin's shape.
sub main(): Int {
    $ch: Chan[Map[Str,Int]] = channel(1)
    $ch.close()
    %m = $ch.recv().unwrap()
    print(%m{"a"})
    0
}
