# slice 4d-D4: a variant field whose type is the SAME enum is boxed behind a
# counted pointer. This is the AST-core shape: Tree contains Tree. The Node arm
# binds both boxed fields as borrowed Tree values and recursively consumes them.
enum Tree {
    Leaf($n: Int)
    Node($l: Tree, $r: Tree)
}

sub sum($t: Tree): Int {
    match $t {
        Leaf($n) { $n }
        Node($l, $r) { sum($l) + sum($r) }
    }
}

sub main(): Int {
    sum(Node(Leaf(3), Node(Leaf(1), Leaf(3))))
}
