# P2b-3c-5: `.find` over `List[List[Int]]` returns `Option[List[Int]]`.
# The Some arm deep-indexes the found row after the find lowering has released
# the owned source slice, proving the carrier owns a deep-copied row payload.
sub main(): Int {
    @xs = [[1, 2], [3, 4, 5], [6]]

    print(match @xs.find(sub($row: List[Int]): Bool { count($row) > 2 }) {
        Some($r) { "found { count($r) }/{ $r[2] }" }
        None { "missing" }
    })

    $score = match find(@xs, sub($row: List[Int]): Bool { $row[0] == 6 }) {
        Some($r) { $r[0] }
        None { 0 }
    }
    print("score { $score }")

    print(match @xs.find(sub($row: List[Int]): Bool { count($row) > 9 }) {
        Some($r) { "bad" }
        None { "none" }
    })

    $score
}
