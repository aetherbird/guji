# P9-1: higher-order callbacks bind a map element as a borrowed guji_map_t row.
# Map projection/display in the callback must read `.keys`/`.vals`/`.len` from
# that row, never invent named-map companion locals for the temporary binder.
sub main(): Int {
    @maps = [{"a": [1], "b": [2, 3]}, {"z": []}]

    @counts = @maps.map(sub(%m) { %m.keys().count() })
    print(@counts)

    @maps.each(sub(%m) { print(%m.keys().count()) })

    $total = @maps.reduce(0, sub($acc, %m) { $acc + %m.keys().count() })
    print($total)
    0
}
