# E5d-8s: a statement-position Unit `if`/`else if`/`else` used as a
# non-final statement inside nested blocks. The first case is a value-producing
# if branch (the real `eval_print_to` shape); the second is a statement-match
# arm. Native accepts both, so this is a normal three-way corpus case.
enum Choice { CLeft CRight }

sub branch_value($outer: Bool, $flag: Bool): Int {
    mut $score = 0
    if $outer {
        if $flag {
            $score = $score + 1
        } else if $score == 99 {
            $score = $score + 100
        } else {
            $score = $score + 2
        }
        $score + 4
    } else {
        if $flag {
            $score = $score + 8
        } else {
            $score = $score + 16
        }
        $score + 32
    }
}

sub match_branch($choice: Choice, $flag: Bool): Int {
    mut $score = 0
    match $choice {
        CLeft {
            if $flag {
                $score = $score + 3
            } else if $score == 7 {
                $score = $score + 100
            } else {
                $score = $score + 5
            }
            0
        }
        CRight {
            if $flag {
                $score = $score + 11
            } else {
                $score = $score + 13
            }
            0
        }
    }
    $score
}

sub main(): Int {
    mut $score = 0
    $score = $score + branch_value(true, true)
    $score = $score + branch_value(true, false)
    $score = $score + branch_value(false, true)
    $score = $score + match_branch(CLeft, false)
    $score = $score + match_branch(CRight, true)
    print("nested-unit-if")
    $score
}
