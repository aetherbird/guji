# P8d-2c-3c-9 panic path: outer recv unwrap on a closed, drained
# Chan[Option[List[Int]]] panics; a delivered inner None is not this state.
sub main(): Int {
    $ch: Chan[Option[List[Int]]] = channel(1)
    $ch.close()
    $value: Option[List[Int]] = $ch.recv().unwrap()
    print(match $value { Some(@xs) { @xs.count() } None { 0 } })
    0
}
