# P8d-2c-3c-5: scalar-payload enums cross channels as flat by-value structs.
enum Signal {
    Stop
    Go
    Wait($secs: Int)
}

sub main(): Int {
    $ch: Chan[Signal] = channel(4)
    $bound: Signal = Wait(4)
    $ch.send(Go)
    $ch.send($bound)
    $ch.send(Stop)
    $ch.close()

    mut $decoded = 0
    for $sig in $ch {
        $decoded = $decoded + (match $sig {
            Stop { 0 }
            Go { 1 }
            Wait($secs) { $secs }
        })
    }
    print($decoded)

    # An undelivered scalar enum owns no heap storage; dropping the channel is a
    # plain slot discard. A rejected send exercises the same by-value message.
    $left: Chan[Signal] = channel(1)
    $left.send(Wait(9))
    $closed: Chan[Signal] = channel(1)
    $closed.close()
    $closed.send(Go)
    0
}
