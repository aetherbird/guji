# EB-2 topological typedef-ordering corpus. Each enum embeds (BY VALUE, in a
# homogeneous variant position) a class that is declared LATER in source order, and
# the two enum/class pairs are INTERLEAVED. Source-order typedef emission would place
# an enum struct -- with a by-value class member -- before that class's typedef, so the
# member would be an incomplete C type (`unknown type name`). There is NO value cycle;
# this is purely a typedef-ordering problem. EB-2's topological emission places each
# embedded class before the enum that embeds it (order here: Point, Boxed, Size, Tagged).
# Native ACCEPTS this shape (it emits all class structs before all enum structs), so it
# is a THREE-WAY case: interp == native == selfhost.
enum Boxed {
    BNone
    BSome($p: Point)
}

class Point {
    has $.x: Int
    has $.y: Int
}

enum Tagged {
    TNone
    TSome($s: Size)
}

class Size {
    has $.w: Int
    has $.h: Int
}

sub area($b: Boxed): Int {
    match $b {
        BNone { 0 }
        BSome($p) { $p.x * $p.y }
    }
}

sub perim($t: Tagged): Int {
    match $t {
        TNone { 0 }
        TSome($s) { 2 * ($s.w + $s.h) }
    }
}

sub main(): Int {
    $b = BSome(Point(x: 6, y: 5))
    $t = TSome(Size(w: 3, h: 1))
    area($b) + perim($t)
}
