# Spec 17.3-17.4: close, drain, receive-after-close, send/double-close errors,
# iteration drain, and an intentionally undelivered owned buffered value.
sub main(): Int {
    $ch: Chan[Str] = channel(2)
    $ch.send("ow" ~ "ned")
    $ch.close()
    print("drain=" ~ $ch.recv().unwrap())
    match $ch.recv() { Some($value) { print("after-close=false") } None { print("after-close=true") } }
    $late = $ch.send("late")
    $again = $ch.close()
    if $late.is_err() { print("send=closed") } else { print("send=ok") }
    if $again.is_err() { print("close=closed") } else { print("close=ok") }

    $iter: Chan[Int] = channel(3)
    $iter.send(1)
    $iter.send(2)
    $iter.close()
    mut $sum = 0
    for $n in $iter { $sum = $sum + $n }
    print("iter=$sum")

    $undelivered: Chan[Str] = channel(1)
    $undelivered.send("drop" ~ "-me")
    0
}
