# Spec 17.2-17.3: buffered capacity, unbuffered blocking rendezvous, detached
# owned payload persistence, and channel handle identity.
sub main(): Int {
    $buffered: Chan[Int] = channel(2)
    $buffered.send(10)
    $buffered.send(20)
    print("buffered={ $buffered.recv().unwrap() }/{ $buffered.recv().unwrap() }")

    $handoff: Chan[List[Str]] = channel()
    @source = ["al" ~ "pha", "beta"]
    hatch { $handoff.send(@source) }
    @received = $handoff.recv().unwrap()
    print("payload=@received")
    print("source=@source")

    $alias = $handoff
    $other: Chan[List[Str]] = channel(1)
    print("identity={ $alias == $handoff }/{ $other == $handoff }")
    0
}
