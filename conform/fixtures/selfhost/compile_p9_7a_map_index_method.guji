# gujiconform - selfhost slice 6 P9-7a nested map-index method receiver.
# Pins owned Map[Str, Map] row materialization and release after keys() has
# retained its snapshot, closing option_map_map_ownership's first boundary.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "guji_map_order(gmv"))
            print(has_text($c, "guji_retain((const void*)gmv"))
            print(has_text($c, ".keys = NULL;"))
            print(has_text($c, ".vals = NULL;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
