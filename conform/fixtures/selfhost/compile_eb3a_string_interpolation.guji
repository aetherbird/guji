# gujiconform - selfhost slice 5 EB-3a compiler codegen fixture.
# Interpolated Str literals must be lowered to display-producing C, not emitted
# as literal templates such as "v{ $n }w".
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "guji_int_str("))
            print(has_text($c, "guji_bool_str("))
            print(has_text($c, "guji_str_cat("))
            print(has_text($c, 'v{ $n }w'))
            print(has_text($c, 'literal {not an expression}'))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
