# gujiconform — selfhost slice 6 P4b-2 private-field shorthand typecheck fixture.
# The stdin source proves `$!field` reads inside class methods resolve to the
# declared field types in the guji-written type checker (§8.3).
import lexer

sub main(): Int {
    match lexer::typecheck_verdict(stdin.slurp()) {
        TcAccept {
            print(lexer::typecheck_accept_token())
            0
        }
        TcRejectType($msg) {
            print($msg)
            1
        }
        TcRejectParse($msg) {
            print($msg)
            2
        }
    }
}
