sub mki($n: Int): Option[Int] {
    if $n > 0 { Some($n) } else { None }
}
sub mks($n: Int): Option[Str] {
    if $n > 0 { Some("x" ~ "y") } else { None }
}
sub main(): Int {
    $si: Option[Int] = mki(5)
    $ss: Option[Str] = mks(5)
    $a: Result[Int, Str] = $si.ok_or("e" ~ "rr")
    $b: Result[Int, Int] = ok_or($si, 99)
    $g: Result[Str, Str] = $ss.ok_or("fb")
    mut $code = 0
    if $a.is_ok() { $code = $code + 1 }
    if $b.is_ok() { $code = $code + 2 }
    if $g.is_ok() { $code = $code + 4 }
    print("{ $code }")
    0
}
