import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

# selfhost slice 6 P2b-3a: `.reduce` lowers as an inline two-parameter fold over
# an owned source `guji_slice_t`. Scalar accumulators assign directly; Str
# accumulators release the previous owned value before taking the lambda result.
sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "for (gi"))
            print(has_text($c, " = ((int64_t*)gl"))
            print(has_text($c, "guji_add("))
            print(has_text($c, "guji_mul("))
            print(has_text($c, "guji_release(gt"))
            print(has_text($c, "guji_release((const void*)gl"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
