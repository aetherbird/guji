# P8d-2c-3c-10: pin Option[Map] channel element ABI and ownership: nested
# receive carrier, map-aware drop hook (keys+vals), conditional PAIRED
# guji_copy_arr send detach, and the retain-out/release-outer extraction used
# by fresh recv unwrap plus the bound inner unwraps.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "} guji_opt_opt_map;") == 1)
            print(count_of($c, "static void guji_chan_drop_opt_map") == 1)
            print(count_of($c, "sizeof(guji_opt_map), guji_chan_drop_opt_map") == 4)
            print(count_of($c, ".tag = guji_chan_send(") == 7)
            print(count_of($c, ".tag = guji_chan_recv(") == 6)
            # Each of the 7 sends detaches BOTH counted arrays under the Some
            # guard (the keys spelling is unique to the carrier send fill).
            print(count_of($c, ".val.keys = (const char**)guji_copy_arr((const void*)") == 7)
            # 5 fresh outer unwrap guards + 4 bound inner unwraps.
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 9)
            # Five fresh unwraps release their outer carrier; the held carrier
            # contributes one additional nested cleanup at scope exit.
            print(count_of($c, ".val.val.keys = NULL;") == 6)
            0
        }
    }
}
