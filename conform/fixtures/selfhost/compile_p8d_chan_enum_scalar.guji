# P8d-2c-3c-5: scalar enums use a flat struct slot, NULL drop hook, and an
# Option[Enum] receive carrier; channel iteration must not emit field releases.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "sizeof(Signal), NULL);") == 1)
            print(count_of($c, "guji_opt_Signal") >= 2)
            print(count_of($c, ".tag = guji_chan_send(") == 2)
            print(count_of($c, ".tag = guji_chan_recv(") == 1)
            print(count_of($c, ".val = (Signal)\{0}") == 1)
            print(count_of($c, "\tguji_release_Signal_fields(&") == 0)
            0
        }
    }
}
