# P8d-2c-3c-2: pin Chan[Map[Str,V]] detached-array send/recv ABI.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "guji_chan_new(1LL, sizeof(guji_map_t), guji_chan_drop_map)") == 2)
            print(count_of($c, ".keys = (const char**)guji_copy_arr((const void*)") >= 3)
            print(count_of($c, ".vals = guji_copy_arr((const void*)") >= 3)
            print(count_of($c, "guji_opt_map") >= 1)
            print(count_of($c, ".tag = guji_chan_send(") >= 3)
            print(count_of($c, ".tag = guji_chan_recv(") == 2)
            print(count_of($c, ".tag = guji_chan_close(") == 1)
            print(count_of($c, ".val.keys); guji_release((const void*)") >= 2)
            0
        }
    }
}
