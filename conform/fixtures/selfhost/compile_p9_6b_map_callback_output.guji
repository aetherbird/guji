# gujiconform - selfhost slice 6 P9-6b Map-valued List.map callbacks.
# Pins ARR_MAP allocation plus transfer of each owned callback result into its
# destination slot by nulling both source arrays.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "guji_arr_alloc(GUJI_KIND_ARR_MAP"))
            print(has_text($c, "((guji_map_t*)"))
            print(has_text($c, ".keys = NULL;"))
            print(has_text($c, ".vals = NULL;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
