# gujiconform - selfhost slice 6 P9-6b nested List[Map]/Map→List with nominal leaves.
# Nested collection materialization must retain counted arrays (same-heap), not
# guji_copy_arr — runtime copy cannot dispatch GUJI_KIND_<T>_ARR leaves.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "GUJI_KIND_Tag_ARR"))
            print(has_text($c, "GUJI_KIND_Person_ARR"))
            # List[Map] / Map→List index: retain keys/vals or .data (not copy_arr)
            print(has_text($c, "guji_retain((const void*)"))
            print(has_text($c, "guji_retain("))
            # Must not deep-copy program-specific kinds through guji_copy_arr
            print(has_text($c, "guji_copy_arr((const void*)"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
