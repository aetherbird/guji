enum Inner {
    Named($s: Str)
    Anon
}

enum Outer {
    Wrap($g: Inner)
}

sub label($o: Outer): Int {
    match $o {
        Wrap($g) {
            match $g {
                Named($s) {
                    print($s)
                    1
                }
                Anon {
                    0
                }
            }
        }
    }
}

sub main(): Int {
    label(Wrap(Named("hi" ~ "!"))) + label(Wrap(Anon))
}
