# gujiconform - selfhost slice 6 P2c compiler codegen fixture.
# Pins §15.5 Result `map` carrier-producing lowering over a bound Result local.
# The fresh Result temp is zeroed; the Ok arm binds the source `.ok`, lowers the
# callback body, and fills `.tag = 0`/`.ok = <body>`. The Err arm copies `.err`
# and retains it when the Err slot is Str.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, ".tag == 0) \{"))
            print(has_text($c, ".ok = guji_add("))
            print(has_text($c, ".tag = 1; gr"))
            print(has_text($c, ".err = gv"))
            print(has_text($c, "guji_retain(gr"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
