sub tag($s: Str): Result[Str, Str] {
    if $s == "bad" { Err("bad") } else { Ok($s ~ ":tag") }
}

sub if_bind_int($take: Bool, $s: Str): Result[Int, Str] {
    $x: Int = if $take {
        parse_int($s)? + 5
    } else {
        70
    }
    Ok($x)
}

sub if_bind_str($take: Bool, $s: Str): Result[Str, Str] {
    $x: Str = if $take {
        tag($s)? ~ "!"
    } else {
        "idle"
    }
    Ok($x)
}

sub main(): Int {
    match if_bind_int(true, "4") {
        Ok($a) { print("int ok { $a }") }
        Err($e1) { print("int err { $e1 }") }
    }
    match if_bind_str(true, "go") {
        Ok($d) { print("str ok { $d }") }
        Err($e4) { print("str err { $e4 }") }
    }
    0
}
