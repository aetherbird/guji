# gujiconform - selfhost slice 6 P2c compiler codegen fixture.
# Pins §15.1 `sort(@xs)` / `@xs.sort()` lowering. Native `listSort` builds an index
# permutation (`order`), stable insertion-sorts it by the per-element `<` comparison
# (`strcmp(a,b) < 0` for Str, `a < b` for numeric scalars) over the source elements,
# allocates a same-length destination, copies `dst[i] = src[order[i]]` retaining Str
# slots, releases the order array, then releases the materialized source slice. This
# fixture checks those generated-C landmarks for both an Int and a Str list.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "go4 = (int64_t*)guji_arr_alloc(GUJI_KIND_ARR_SCALAR, sizeof(int64_t), gl1.len);"))
            print(has_text($c, "((int64_t*)gl1.data)[gi7] < ((int64_t*)gl1.data)[go4[gi8]]"))
            print(has_text($c, "((int64_t*)gl3.data)[gi5] = ((int64_t*)gl1.data)[go4[gi5]];"))
            print(has_text($c, "guji_release((const void*)go4);"))
            print(has_text($c, "strcmp(((const char**)gl16.data)[gi22], ((const char**)gl16.data)[go19[gi23]]) < 0"))
            print(has_text($c, "guji_retain(((const char**)gl18.data)[gi20]);"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
