sub main(): Int {
    $a: Chan[Option[Str]] = channel(1)
    $a_msg: Option[Str] = Some("x" ~ "y")
    $a.send($a_msg)
    select {
        $v = $a.recv() {
            $inner = $v.unwrap()
            match $inner {
                Some($s) { print($s) }
                None { print("none") }
            }
        }
    }
    $b: Chan[Option[Str]] = channel(1)
    $b_msg: Option[Str] = Some("z" ~ "z")
    $b.send($b_msg)
    select {
        $b.recv() { print("dropped") }
    }
    $c: Chan[Msg] = channel(1)
    $c.send(Text("ok" ~ "!"))
    select {
        $v = $c.recv() {
            if $v.is_some() {
                print(match $v.unwrap() {
                    Text($s) { $s }
                    Done { "done" }
                })
            }
            return 0
        }
    }
    1
}

enum Msg {
    Text($s: Str)
    Done
}
