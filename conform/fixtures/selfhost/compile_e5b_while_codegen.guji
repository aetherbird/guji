# gujiconform - selfhost slice 5 E5b compiler codegen fixture.
# Pins the generated-C shape for §6.3 `while`: a loop shell, a top-of-iteration
# break guard, and body reassignment code.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "while (1)"))
            print(has_text($c, "break;"))
            print(has_text($c, "guji_add"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
