# gujiconform - selfhost slice 5 E5d-8h-3b carrier-union codegen fixture.
# Pins the Option-carrier mixed-union boxing: an `Option[Expr]` carrier sharing enum
# field position 0 with a Bool payload. The carrier must be stored through union `.p`
# as a counted heap box, get a generated `GUJI_KIND_opt_Expr` runtime kind + a
# `guji_drop_opt_Expr` drop helper (tag-guarded payload release) + a drop-table entry,
# have the box retain/released from enum RC, and be re-exposed to match arms as a
# borrowed carrier lvalue so nested `SReturn(None)` / `SReturn(Some($v))` `.tag`/`.val`
# dispatch works. Expr is the first user type and non-recursive, so its carrier box is
# kind 12, after Expr's nominal array kind.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "#define GUJI_KIND_opt_Expr 12"))
            print(has_text($c, 'union { int64_t i; double f; const char* s; guji_slice_t l; guji_map_t m; void* p; } f0;'))
            print(has_text($c, "guji_alloc(GUJI_KIND_opt_Expr, 0, sizeof(guji_opt_Expr))"))
            print(has_text($c, '{.p = gcp'))
            print(has_text($c, "guji_release((const void*)p->f0.p);"))
            print(has_text($c, "guji_drop_opt_Expr, /* GUJI_KIND_opt_Expr */"))
            print(has_text($c, 'if (c->tag != 0LL) { guji_release_Expr_fields(&c->val); }'))
            print(has_text($c, "(*((guji_opt_Expr*)"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
