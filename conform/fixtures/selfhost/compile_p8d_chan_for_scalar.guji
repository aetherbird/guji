# P8d-2c-3a: pin one recv-until-None loop for each non-owning channel payload.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "for (;;) ") == 3)
            print(count_of($c, ".tag = guji_chan_recv(") == 3)
            # Prefer `.tag == 0)` over bare `.tag == 0`: unconditional Result
            # elem_drop hooks (P8d-2c-3c-11) also contain `v.tag == 0LL`.
            print(count_of($c, ".tag == 0)") == 3)
            print(count_of($c, "break;") >= 3)
            0
        }
    }
}
