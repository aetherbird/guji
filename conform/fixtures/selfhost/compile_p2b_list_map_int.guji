import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

# selfhost slice 6 P2b-1: `.map` lowers as an inline list transform over an
# owned source `guji_slice_t`, allocates a same-length result slice, binds each
# element to the lambda param inside the loop, and stores the callback result.
sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, ".data = guji_arr_alloc(GUJI_KIND_ARR_SCALAR, sizeof(int64_t), gl"))
            print(has_text($c, "for (gi"))
            print(has_text($c, " = ((int64_t*)gl"))
            print(has_text($c, "guji_mul("))
            print(has_text($c, "guji_release((const void*)gl"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
