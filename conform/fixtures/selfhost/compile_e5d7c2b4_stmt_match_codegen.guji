# gujiconform - selfhost slice 5 E5d-7c-2b-4 compiler codegen fixture.
# Pins NON-final statement-position `match` lowering (value discarded): the selfhost
# compiler emits an `if`/`else if` chain over the owned enum scrutinee's `.tag`, each
# returning arm releasing the scrutinee fields then `return N;` inline; the accept
# arm is empty (its `0` is discarded); a `non-exhaustive match` panic guards an
# unreachable tag; and the scrutinee is released once more on the fall-through path.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, ".tag == 1LL"))
            print(has_text($c, "guji_release_Verdict_fields("))
            print(has_text($c, "non-exhaustive match"))
            print(has_text($c, "return 1LL;"))
            print(has_text($c, "return 0LL;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
