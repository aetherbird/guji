# gujiconform — selfhost slice 6 P9-2 Str-prelude unary typing (accept).
# The stdin source is classified by the self-hosted type checker; this pins
# that `"lit".upper()` types as Str so a map literal's later Str value is not
# a false first-value mismatch.
import lexer

sub main(): Int {
    match lexer::typecheck_verdict(stdin.slurp()) {
        TcAccept {
            print(lexer::typecheck_accept_token())
            0
        }
        TcRejectType($msg) {
            print($msg)
            1
        }
        TcRejectParse($msg) {
            print($msg)
            2
        }
    }
}
