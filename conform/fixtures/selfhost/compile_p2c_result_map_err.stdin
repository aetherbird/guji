sub ok_s($s: Str): Result[Str, Str] { Ok($s) }
sub err_s($s: Str): Result[Str, Str] {
    if $s == "" { Ok($s) } else { Err($s) }
}

sub main(): Int {
    $r: Result[Str, Str] = ok_s("he" ~ "y")
    $e: Result[Str, Str] = err_s("bad" ~ "err")
    $a: Result[Str, Int] = $e.map_err(sub($v: Str): Int { 7 })
    $b: Result[Str, Str] = map_err($r, sub($w: Str): Str { $w ~ "!" })
    match $b {
        Ok($x) { print($x) }
        Err($m) { print($m) }
    }
    match $a {
        Ok($y) { print($y) }
        Err($n) { print("{ $n }") }
    }
    0
}
