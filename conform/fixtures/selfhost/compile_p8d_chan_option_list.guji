# P8d-2c-3c-9: pin Option[List] channel element ABI and ownership: nested
# receive carrier, list-aware drop hook, KIND-tagged send detach, and the
# retain-out/release-outer extraction used by fresh recv unwrap.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "} guji_opt_opt_list;") == 1)
            print(count_of($c, "static void guji_chan_drop_opt_list") == 1)
            print(count_of($c, "sizeof(guji_opt_list), guji_chan_drop_opt_list") == 3)
            print(count_of($c, ".tag = guji_chan_send(") == 6)
            print(count_of($c, ".tag = guji_chan_recv(") == 5)
            print(count_of($c, ".val.data = guji_copy_arr((const void*)") == 6)
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 4)
            # Four fresh unwraps retain-out and release their outer carrier;
            # the held carrier contributes one additional nested cleanup.
            print(count_of($c, ".val.val.data = NULL;") == 5)
            0
        }
    }
}
