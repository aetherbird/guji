# gujiconform - selfhost slice 6 P9-6b keys/values on set/remove receivers.
# Pins guji_map_order projection plus release of the owned set/remove temp
# (.keys/.vals null) after the list snapshot retains its slots.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "guji_map_order("))
            print(has_text($c, "guji_release((const void*)"))
            print(has_text($c, ".keys = NULL;"))
            print(has_text($c, ".vals = NULL;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
