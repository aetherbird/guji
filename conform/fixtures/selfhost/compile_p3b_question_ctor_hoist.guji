# gujiconform - selfhost slice 6 P3b-2b-2b compiler codegen fixture.
# Pins final carrier constructors whose argument CONTAINS a `?` (non-direct
# question subexpressions, e.g. `Some($o? + 1)` / `Ok(parse_int($s)? + 1)`):
# the left-spine `?` is hoisted into a synthetic scalar local (carrier guard
# early-returns first), then the rebuilt constructor lowers via the general
# final carrier path.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, " = go0.val;"))
            print(has_text($c, "return (guji_opt_int)\{1LL, guji_add(gv"))
            print(has_text($c, " = gr3.ok;"))
            print(has_text($c, "return (guji_res_int_str)\{0LL, guji_add(gv"))
            print(has_text($c, "return (guji_res_int_str)\{1LL, 0LL, gr"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
