# gujiconform — selfhost slice 5 E3 class type checker.
# Pins the canonical typecheck verdict for class data records (§8): named-arg
# construction field checks and public/private field access. The stdin source is
# run through the guji-written front end (lex -> parse -> type-check).
import lexer

sub main(): Int {
    match lexer::typecheck_verdict(stdin.slurp()) {
        TcAccept {
            print(lexer::typecheck_accept_token())
            0
        }
        TcRejectType($msg) {
            print($msg)
            1
        }
        TcRejectParse($msg) {
            print($msg)
            2
        }
    }
}
