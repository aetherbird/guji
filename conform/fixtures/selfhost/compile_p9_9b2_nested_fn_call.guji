import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "static int64_t gf_apply_twice(guji_fn_t gp0, int64_t gp1)"))
            # Two callback casts prove the inner call is materialized and then
            # passed to the outer call, rather than declining during inference.
            print(split($c, "((int64_t (*) (void*, int64_t))gp0.fn)").count() == 3)
            print(has_text($c, "gp0.env, gp1);"))
            print(has_text($c, "gp0.env, gi0);"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
