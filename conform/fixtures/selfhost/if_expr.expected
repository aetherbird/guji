Program(decls=[Sub(public=false,name="pick",params=[Param(name="$n",type=Some(Type(name="Int",args=[])))],ret=Some(Type(name="Int",args=[])),body=BlockBody(stmts=[Expr(value=If(cond=Binary(op=">",left=Name(value="$n"),right=Int(text="0")),then=Block(stmts=[Expr(value=Int(text="1"))]),elifs=[Elif(cond=Binary(op="<",left=Name(value="$n"),right=Int(text="0")),body=Block(stmts=[Expr(value=Int(text="2"))]))],else=Some(Block(stmts=[Expr(value=Int(text="0"))]))))]))])
