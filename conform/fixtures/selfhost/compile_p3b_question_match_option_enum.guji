# gujiconform - selfhost slice 6 P3b-2b-2c-4q compiler codegen fixture.
# Pins match-value binds/reassignments over OPTION and user ENUM scrutinees whose
# arms end in hoistable `?`: the Option variant arm test, the hoisted carrier
# guard's Err early-return inside the arm, the payload bind and arm result into
# the shared match temp, the owned enum scrutinee's field release BEFORE the Err
# early-return, the guarded Option arm's combined condition, and the match temp
# assigned into an existing (reassigned) local.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "if ((go1.tag == 1LL)) \{"))
            print(has_text($c, "if (gr6.tag != 0LL) \{\n\t\treturn (guji_res_int_str)\{1LL, 0LL, gr6.err};"))
            print(has_text($c, "gv7 = gr6.ok;"))
            print(has_text($c, "gi2 = guji_add(gv7, go1.val);"))
            print(has_text($c, "gv8 = gi2;"))
            print(has_text($c, "guji_release_Tagd_fields(&ge2);\n\t\treturn (guji_res_str_str)\{1LL, GUJI_EMPTY_STR, gr6.err};"))
            print(has_text($c, "if ((go2.tag == 1LL) && (((go2.val) > (10LL) ? 1LL : 0LL))) \{"))
            print(has_text($c, "gv0 = gi3;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
