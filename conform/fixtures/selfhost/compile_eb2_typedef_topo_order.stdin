enum Boxed {
    BNone
    BSome($p: Point)
}

class Point {
    has $.x: Int
    has $.y: Int
}

enum Tagged {
    TNone
    TSome($s: Size)
}

class Size {
    has $.w: Int
    has $.h: Int
}

sub area($b: Boxed): Int {
    match $b {
        BNone { 0 }
        BSome($p) { $p.x * $p.y }
    }
}

sub perim($t: Tagged): Int {
    match $t {
        TNone { 0 }
        TSome($s) { 2 * ($s.w + $s.h) }
    }
}

sub main(): Int {
    $b = BSome(Point(x: 6, y: 5))
    $t = TSome(Size(w: 3, h: 1))
    area($b) + perim($t)
}
