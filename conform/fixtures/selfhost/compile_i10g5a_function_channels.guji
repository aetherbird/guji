# I10g5a compiler inspection: function slots carry a layout-aware Env copier,
# a channel drop hook, and balanced ownership at send/recv boundaries.
import lexer

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(split($c, "sizeof(guji_fn_t)").count() > 1)
            print(split($c, "guji_chan_drop_fn").count() > 1)
            print(split($c, "guji_copy_env_lambda_").count() > 1)
            print(split($c, ".copy_env(").count() > 1)
            print(split($c, "guji_release(").count() > 1)
            0
        }
    }
}
