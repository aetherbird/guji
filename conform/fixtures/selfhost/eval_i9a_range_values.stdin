# §5.4 ranges preserve both bounds and inclusive/half-open identity as values.
# Empty and reversed shapes remain representable; iteration semantics belong to I9b.
sub main(): Int {
    $inclusive = 1 .. 3
    $same = 1 .. 3
    $half = 1 ..< 3
    $empty = 3 ..< 3
    $reversed = 3 .. 1
    print($inclusive)
    print($half)
    print($empty)
    print($reversed)
    print($inclusive == $same)
    print($inclusive == $half)
    print($empty != $reversed)
    0
}
