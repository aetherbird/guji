# gujiconform - selfhost slice 6 P2c compiler codegen fixture.
# Pins §15.5 Option `unwrap`/`expect` lowering over a bound `Option[T]` local.
# Native lowers each to a panic GUARD plus the borrowed `Some` payload:
#   if (opt.tag == 0) { guji_panic("unwrap on None"); }   value = opt.val
# `expect` swaps the fixed message for the user's Str (lowered eagerly, released on
# the success path). A scalar payload reads `opt.val` directly (no retain); a Str
# payload retains it into an owned tmp, so the carrier binding's scope-exit cleanup
# stays the ONLY release of the Some payload.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            # Int `unwrap` guards on the fixed "unwrap on None" message...
            print(has_text($c, "guji_panic(\"unwrap on None\")"))
            # ...and reads the borrowed scalar payload directly — no retain/release.
            print(has_text($c, "(gv0.val) == (5LL)"))
            # Str `expect` panics with the USER message tmp (not the fixed string)...
            print(has_text($c, "guji_panic(gt6)"))
            # ...and releases that owned message tmp on the success (fall-through) path.
            print(has_text($c, "guji_release(gt6);"))
            # The Str payload is retained into an owned tmp released by the sink.
            print(has_text($c, "gt7 = guji_retain(gv4.val)"))
            # The carrier binding's own scope-exit cleanup is still the ONLY release
            # of the Some payload (the unwrap/expect ternary never drops its count).
            print(has_text($c, "guji_release(gv4.val); gv4.val = NULL;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
