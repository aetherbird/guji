# P8d-2c-3d-2: pin recv-derived collection Some/None match binds. Bound
# Option[List]/Option[Map] recv carriers are BORROWED match scrutinees (the
# chain releases nothing); Some binders read the payload in place — Map through
# the by-value struct form (`.val.keys`/`.vals`, key scans only), List through
# the slice form (`.val.data`). Nine recvs feed eleven match chains (two held
# carriers are each matched twice; one chain is the OWNED non-channel
# Option[Map] call scrutinee, released right after its chain). The seven
# `.val.keys = NULL;` are the five bound map carriers' scope-exit releases +
# the owned call scrutinee's post-chain release + the mut carrier's
# release-before-rebind; the three `.val.data = NULL;` are the bound list
# carriers' scope-exit releases. Arm conds use the double-paren spelling so
# the unconditionally-emitted option-display/result-drop helpers' single-paren
# tag guards don't inflate the counts.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, ".tag = guji_chan_recv(") == 9)
            print(count_of($c, ".tag == 1LL))") == 11)
            print(count_of($c, ".tag == 0LL))") == 11)
            print(count_of($c, ".val.keys[") == 11)
            print(count_of($c, ".val.keys = NULL;") == 7)
            print(count_of($c, ".val.data = NULL;") == 3)
            print(count_of($c, "gf_lookup") == 3)
            0
        }
    }
}
