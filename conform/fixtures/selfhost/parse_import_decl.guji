# gujiconform — selfhost slice 5 E5d-7a. Pins parsing of top-level import
# declarations (§16.1) before ordinary declarations. Resolution is a later slice.
import lexer

sub main(): Int {
    match lexer::parse_to_string(stdin.slurp()) {
        Ok($ast) {
            print($ast)
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
