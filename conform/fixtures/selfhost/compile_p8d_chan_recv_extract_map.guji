# P8d-2c-3d-2b: pin Map receive-carrier extraction. Four fresh Map unwraps
# (Int/Str/List[Int] values) plus one bound Option[Map] unwrap. Fresh adoption
# retains BOTH counted arrays (keys+vals) out of the carrier then releases+NULLs
# the carrier slot; bound unwrap retains without releasing the named carrier —
# the 5th ".val.keys = NULL; " is that local's ordinary scope-exit release.
# Every extracted map then moves into the named two-array binding form.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, ".tag = guji_chan_recv(") == 5)
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 5)
            print(count_of($c, "guji_retain((const void*)gmv") == 10)
            print(count_of($c, ".val.keys = NULL; ") == 5)
            print(count_of($c, "sizeof(guji_map_t), guji_chan_drop_map") == 4)
            print(count_of($c, "_keys = gmv") == 5)
            0
        }
    }
}
