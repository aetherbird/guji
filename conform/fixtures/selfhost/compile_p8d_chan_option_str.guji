# P8d-2c-3c-8: pin the counted Option[Str] channel element ABI — the emitted
# guji_opt_opt_str carrier typedef + guji_chan_drop_opt_str hook, the
# deep-copy-on-send (guji_str_copy into the detached message), and the
# retain-out/carrier-slot-release unwrap ownership (3 fresh unwraps + the held
# carrier's scope-exit release = 4 nested `.val.val = NULL; }` sites).
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "} guji_opt_opt_str;") == 1)
            print(count_of($c, "static void guji_chan_drop_opt_str") == 1)
            print(count_of($c, "sizeof(guji_opt_str), guji_chan_drop_opt_str") == 2)
            print(count_of($c, ".tag = guji_chan_send(") == 5)
            print(count_of($c, ".tag = guji_chan_recv(") == 4)
            print(count_of($c, ".val = guji_str_copy(") == 5)
            # 3 outer carrier guards + 2 bound Option[Str] unwraps.
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 5)
            print(count_of($c, ".val.val = NULL; }") == 4)
            0
        }
    }
}
