enum Expr {
    EInt($n: Int)
    EStr($s: Str)
}

enum Stmt {
    SNop
    SReturn($v: Option[Expr])
}

sub eval_stmt($s: Stmt): Int {
    match $s {
        SNop { 1 }
        SReturn(None) { 7 }
        SReturn(Some($v)) {
            match $v {
                EInt($n) { 50 + $n }
                EStr($s) { 20 }
            }
        }
    }
}

sub main(): Int {
    return eval_stmt(SReturn(Some(EInt(5))))
}
