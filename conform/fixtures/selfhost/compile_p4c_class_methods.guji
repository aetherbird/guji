import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "static Counter gf_Counter_bumped(Counter gp0)"))
            print(has_text($c, "static int64_t gf_Counter_value(Counter gp0)"))
            print(has_text($c, 'return (Counter){guji_add(gp0.f0, 1LL)};'))
            print(has_text($c, "gf_Counter_bumped(gv"))
            print(has_text($c, "gf_Counter_value(gv"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
