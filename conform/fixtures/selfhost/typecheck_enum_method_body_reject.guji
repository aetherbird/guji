# gujiconform — selfhost slice 6 P5b-2b(e) generic REJECTION parity (§3.3).
# The stdin source is classified by the self-hosted type checker; this pins the
# per-call-site type-param bind/substitute verdict at the typecheck boundary.
import lexer

sub main(): Int {
    match lexer::typecheck_verdict(stdin.slurp()) {
        TcAccept {
            print(lexer::typecheck_accept_token())
            0
        }
        TcRejectType($msg) {
            print($msg)
            1
        }
        TcRejectParse($msg) {
            print($msg)
            2
        }
    }
}
