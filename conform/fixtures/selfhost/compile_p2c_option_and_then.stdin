sub mki($n: Int): Option[Int] {
    if $n > 0 { Some($n) } else { None }
}
sub mks($n: Int): Option[Str] {
    if $n > 0 { Some("x" ~ "y") } else { None }
}
sub main(): Int {
    $si: Option[Int] = mki(5)
    $ss: Option[Str] = mks(5)
    $a: Option[Int] = $si.and_then(sub($v: Int): Option[Int] { Some($v * 2) })
    $b: Option[Str] = and_then($si, sub($n: Int): Option[Str] { mks($n) })
    $c: Option[Int] = $ss.and_then(sub($s: Str): Option[Int] { None })
    mut $code = 0
    if $a.unwrap_or(0) == 10 { $code = $code + 1 }
    if $b.is_some() { $code = $code + 2 }
    if $c.is_none() { $code = $code + 4 }
    print("{ $code }")
    0
}
