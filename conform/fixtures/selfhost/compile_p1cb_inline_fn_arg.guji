import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, 'static int64_t gf_apply(guji_fn_t gp0, int64_t gp1)'))
            print(has_text($c, 'gf_apply((guji_fn_t){ .fn = (void*)gf_lambda_'))
            print(has_text($c, 'guji_alloc(GUJI_KIND_ENV, 0, sizeof(genv_lambda_'))
            print(has_text($c, 'guji_release((guji_fn_t){ .fn = (void*)gf_lambda_'))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
