# gujiconform - selfhost slice 6 P9-6b nested collection enum fields.
# Enum payloads use the same depth-generic List/Map KIND representation as ordinary
# collection values; retain/release therefore owns only the outer handle.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "GUJI_KIND_ARR_SLICE"))
            print(has_text($c, "GUJI_KIND_ARR_MAP"))
            print(has_text($c, "guji_release((const void*)p->f0.l.data)"))
            print(has_text($c, "guji_release((const void*)p->f0.m.keys)"))
            print(has_text($c, "guji_release((const void*)p->f0.m.vals)"))
            print(has_text($c, "guji_retain((const void*)p->f0.l.data)"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
