# gujiconform - selfhost slice 6 P2c compiler codegen fixture.
# Pins §15.5 Result `unwrap_or_else` over a bound Result local. Ok copies/retains
# the Ok slot; Err binds the error payload as the lambda parameter and lowers the
# fallback body inline.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "if (gv1.tag == 0)"))
            print(has_text($c, "gi7 = gv1.ok;"))
            print(has_text($c, "gi8 = gv1.err;"))
            print(has_text($c, "gi7 = guji_add(gi8, 2LL);"))
            print(has_text($c, "gt11 = guji_retain(gv6.ok);"))
            print(has_text($c, "gt11 = gt15;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
