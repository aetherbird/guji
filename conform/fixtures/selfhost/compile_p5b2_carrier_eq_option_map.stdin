sub mkMap($which: Int): Option[Map[Str, Int]] {
    if $which == 0 {
        None
    } else if $which == 1 {
        Some({"a": 1, "b": 2})
    } else if $which == 2 {
        Some({"b": 2, "a": 1})
    } else {
        Some({"a": 1, "b": 3})
    }
}

sub main(): Unit {
    $a: Option[Map[Str, Int]] = Some({"a": 1, "b": 2})
    $b: Option[Map[Str, Int]] = Some({"b": 2, "a": 1})
    $c: Option[Map[Str, Int]] = Some({"a": 1, "b": 3})
    print("{ $a == $b }")
    print("{ $a == $c }")
    print("{ mkMap(1) == mkMap(2) }")
}
