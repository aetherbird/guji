# P8d-2c-3c-1: pin the owned-List channel drain loop: binder reset before entry,
# release-before-rebind after the closed-check, adoption of the detached
# message, and the post-loop final release.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, " = (guji_slice_t)\{0};\n\tfor (;;) ") == 3)
            print(count_of($c, ".tag = guji_chan_recv(") == 3)
            print(count_of($c, "\t\tbreak;\n\t}\n\tguji_release((const void*)") == 3)
            print(count_of($c, ".val;") == 3)
            print(count_of($c, "\t}\n\tguji_release((const void*)") >= 3)
            0
        }
    }
}
