sub tag($s: Str): Result[Str, Str] {
    if $s == "bad" { Err("bad") } else { Ok($s ~ ":tag") }
}

sub half($s: Str): Result[Float, Str] {
    if $s == "bad" { Err("bad") } else { Ok(3.0) }
}

sub pick($b: Bool): Result[Bool, Str] {
    if $b { Ok(true) } else { Err("nope") }
}

sub if_bind_int($take: Bool, $s: Str): Result[Int, Str] {
    $x = if $take {
        parse_int($s)? + 5
    } else {
        70
    }
    Ok($x)
}

sub if_bind_str($take: Bool, $s: Str): Result[Str, Str] {
    $y = if $take {
        tag($s)? ~ "!"
    } else {
        "idle"
    }
    Ok($y)
}

sub if_bind_float($take: Bool, $s: Str): Result[Float, Str] {
    $z = if $take {
        half($s)? + 1.5
    } else {
        2.0
    }
    Ok($z)
}

sub if_bind_bool($take: Bool, $b: Bool): Result[Bool, Str] {
    $w = if $take {
        pick($b)?
    } else {
        false
    }
    Ok($w)
}

sub main(): Int {
    match if_bind_int(true, "4") {
        Ok($a) { print("int ok { $a }") }
        Err($e1) { print("int err { $e1 }") }
    }
    match if_bind_str(true, "go") {
        Ok($d) { print("str ok { $d }") }
        Err($e4) { print("str err { $e4 }") }
    }
    match if_bind_float(true, "ok") {
        Ok($f) { print("float ok { $f }") }
        Err($e7) { print("float err { $e7 }") }
    }
    match if_bind_bool(true, true) {
        Ok($g) { print("bool ok { $g }") }
        Err($e9) { print("bool err { $e9 }") }
    }
    0
}
