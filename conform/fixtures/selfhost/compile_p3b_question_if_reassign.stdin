sub tag($s: Str): Result[Str, Str] {
    if $s == "bad" { Err("bad") } else { Ok("<" ~ $s ~ ">") }
}

sub half($s: Str): Result[Float, Str] {
    if $s == "bad" { Err("bad float") } else { Ok(3.0) }
}

sub pick($b: Bool): Result[Bool, Str] {
    if $b { Ok(true) } else { Err("nope") }
}

sub if_reassign_int($take: Bool, $s: Str): Result[Int, Str] {
    mut $x = 1
    $x = if $take {
        parse_int($s)? + 5
    } else {
        70
    }
    Ok($x + 1)
}

sub if_reassign_str($take: Bool, $s: Str): Result[Str, Str] {
    mut $x = "start"
    $x = if $take {
        tag($s)? ~ "!"
    } else {
        "idle"
    }
    Ok($x ~ " done")
}

sub if_reassign_float($take: Bool, $s: Str): Result[Float, Str] {
    mut $x = 1.0
    $x = if $take {
        half($s)? + 1.5
    } else {
        2.0
    }
    Ok($x)
}

sub if_reassign_bool($take: Bool, $b: Bool): Result[Bool, Str] {
    mut $x = false
    $x = if $take {
        pick($b)?
    } else {
        true
    }
    Ok($x)
}

sub main(): Int { 0 }
