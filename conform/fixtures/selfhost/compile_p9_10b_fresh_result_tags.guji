import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "static const char* gf_probe(const char* gp0)"))
            print(has_text($c, ".tag == 0LL ? 1LL : 0LL"))
            print(has_text($c, ".tag != 0LL ? 1LL : 0LL"))
            print(has_text($c, ".tag == 0LL) \{ guji_release("))
            print(has_text($c, ".tag != 0LL) \{ guji_release("))
            # The owned Result is released before the enclosing if can return.
            print(has_text($c, ".err = NULL; }\n\tif (gb"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
