# P8d-2c-3c-7: pin the nested carrier ABI and plain by-value send/recv path.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "} guji_opt_opt_int;") == 1)
            print(count_of($c, "} guji_opt_opt_bool;") == 1)
            print(count_of($c, "} guji_opt_opt_float;") == 1)
            print(count_of($c, "sizeof(guji_opt_int), NULL") == 1)
            print(count_of($c, "sizeof(guji_opt_bool), NULL") == 1)
            print(count_of($c, "sizeof(guji_opt_float), NULL") == 1)
            print(count_of($c, ".tag = guji_chan_send(") == 3)
            print(count_of($c, ".tag = guji_chan_recv(") == 3)
            # Three outer recv unwraps plus the Int/Float inner unwraps.
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 5)
            0
        }
    }
}
