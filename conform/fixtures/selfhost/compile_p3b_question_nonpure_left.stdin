sub id2($n: Int): Int { $n * 2 }

sub scale($f: Float): Float { $f * 3.0 }

sub tag($s: Str): Result[Str, Str] {
    if $s == "bad" { Err("bad") } else { Ok($s ~ ":t") }
}

sub half($s: Str): Result[Float, Str] {
    if $s == "bad" { Err("nofloat") } else { Ok(1.25) }
}

sub calc($t: Str): Result[Int, Str] {
    Ok(id2(3) + parse_int($t)?)
}

sub label($p: Str, $t: Str): Result[Str, Str] {
    Ok(($p ~ "!") ~ tag($t)?)
}

sub fcalc($t: Str): Result[Float, Str] {
    Ok(scale(2.0) + half($t)?)
}

sub multi($a: Str, $b: Str): Result[Int, Str] {
    Ok(id2(4) + parse_int($a)? + parse_int($b)?)
}

sub main(): Int {
    match calc("5") { Ok($v1) { print("calc { $v1 }") } Err($e1) { print("calc err { $e1 }") } }
    match label("hi", "x") { Ok($v3) { print("label { $v3 }") } Err($e3) { print("label err { $e3 }") } }
    match fcalc("2") { Ok($v5) { print("fcalc { $v5 }") } Err($e5) { print("fcalc err { $e5 }") } }
    match multi("2", "3") { Ok($v7) { print("multi { $v7 }") } Err($e7) { print("multi err { $e7 }") } }
    0
}
