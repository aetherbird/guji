# P4c-1: class associated functions and bound instance methods lower to
# qualified static C functions and call them by the native-shaped ABI.
class Counter {
    has $.n: Int

    sub bumped($self): Counter { Counter(n: $self.n + 1) }
    sub value($self): Int { $self.n }
}

sub main(): Int {
    $c = Counter(n: 41)
    $d = $c.bumped()
    print("{ $d.value() }")
    $d.value()
}
