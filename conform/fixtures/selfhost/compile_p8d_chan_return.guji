# P8d-2c-2: pin owned channel-return shape — statement retain before cleanup
# for bound-name tails; fresh builders/calls transfer (no retain on the
# return temp).
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "guji_chan_t* gf_make_chan") >= 1)
            print(count_of($c, "guji_chan_t* gf_alias_out") >= 1)
            print(count_of($c, "guji_chan_retain(") >= 2)
            print(count_of($c, "guji_chan_new(1LL, sizeof(int64_t), NULL)") >= 1)
            0
        }
    }
}
