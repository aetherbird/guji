# P8d-2c-3b: pin the owned-Str channel drain loop: binder reset before entry,
# release-before-rebind after the closed-check, adoption of the detached
# message, and the post-loop final release (pre-rebind + final = 4 releases
# directly after a closing brace across the two loops).
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, " = GUJI_EMPTY_STR;\n\tfor (;;) ") == 2)
            print(count_of($c, ".tag = guji_chan_recv(") == 2)
            print(count_of($c, "\t\tbreak;\n\t}\n\tguji_release(") == 2)
            print(count_of($c, ".val;") == 2)
            print(count_of($c, "\t}\n\tguji_release(") == 4)
            0
        }
    }
}
