# gujiconform - selfhost slice 5 E5d-8o compiler codegen fixture.
# Pins the real-source `starts_with` shape: List[Str] locals from split,
# take(@xs, n) as a list-valued prelude operation, and join("") as a Str value.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, " = (void*)guji_split("))
            print(has_text($c, ".data = guji_arr_alloc(GUJI_KIND_ARR_STR, sizeof(const char*),"))
            print(has_text($c, "if (gi"))
            print(has_text($c, " = guji_str_cat("))
            print(has_text($c, "((const char**)gl"))
            print(has_text($c, ".data = NULL;"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
