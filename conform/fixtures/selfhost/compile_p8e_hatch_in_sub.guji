# P8e-6: pin hatch emission inside NON-MAIN subs. Nine spawns across eight
# sub/method frames get nine DISTINCT env structs (the global gs counter keeps
# task names unique across frames); param-sourced fills (gp0/gp1) prove the
# spawn sites sit in sub bodies, not main; every wrapper frees its own env
# (native hoists the env malloc out of loops and double-frees — M4 — so the
# per-spawn malloc/free pairing is the shape that must not regress).
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "guji_task_spawn(&ghatch_") == 9)
            print(count_of($c, "typedef struct ghatch_") == 9)
            print(count_of($c, "ghatch_9_env") > 0)
            print(count_of($c, "->cap_n = gp0;") == 1)
            print(count_of($c, "->cap_msg = guji_str_copy(") == 1)
            print(count_of($c, "->cap_xs.data = guji_copy_arr((const void*)gp0.data);") == 1)
            print(count_of($c, "->cap_m.keys = (const char**)guji_copy_arr(") == 1)
            print(count_of($c, "->cap_m.vals = guji_copy_arr(") == 1)
            print(count_of($c, "->cap_s = gp0;") == 1)
            print(count_of($c, " = guji_chan_retain(") == 9)
            print(count_of($c, " = env->cap_ch;") == 9)
            print(count_of($c, "_keys = (const char**)env->cap_m.keys;") == 1)
            print(count_of($c, " = env->cap_sig;") == 1)
            print(count_of($c, "free(arg);") == 9)
            0
        }
    }
}
