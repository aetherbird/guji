# Generic enum specs must be discovered from associated-function calls even when
# no direct variant constructor in user code materializes that instantiation.
# Expected output is the interpreter oracle (§7.5, §3.3).

enum Box[T] {
    Wrap($value: T)
    Empty

    sub describe($self): Str {
        match $self {
            Wrap($v) { "wrap({ $v })" }
            Empty { "empty" }
        }
    }

    sub make($v: T): Box {
        Wrap($v)
    }
}

enum Pair2[A, B] {
    Both($a: A, $b: B)
    Neither

    sub show($self): Str {
        match $self {
            Both($x, $y) { "both({ $x },{ $y })" }
            Neither { "neither" }
        }
    }

    sub of($a: A, $b: B): Pair2 {
        Both($a, $b)
    }
}

sub main(): Unit {
    print(Box.make(7).describe())
    print(Box.make("hi").describe())
    $b = Box.make("bye")
    print($b.describe())
    print(Pair2.of(1, "a").show())
    print(Pair2.of("x", false).show())
}
