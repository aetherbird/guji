# gujiconform - selfhost slice 6 P9-7b Result[Map] ownership.
# Pins guji_res_map_<E> typedef + Ok-slot keys/vals retain/release, closing
# result_map_ownership's first boundary (flat Map[Str, scalar|Str] Ok payload).
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "guji_res_map_str"))
            print(has_text($c, "guji_map_t ok"))
            print(has_text($c, ".ok.keys"))
            print(has_text($c, ".ok.vals"))
            print(has_text($c, "guji_retain((const void*)"))
            print(has_text($c, "guji_release((const void*)"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
