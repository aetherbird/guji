# gujiconform - selfhost slice 2 E5b evaluator driver fixture.
import lexer

sub main(): Int {
    match lexer::eval_main(stdin.slurp()) {
        Ok($r) {
            print(lexer::eval_env_delimiter())
            print($r.dump)
            $r.exit_code
        }
        Err($e) {
            note($e)
            1
        }
    }
}
