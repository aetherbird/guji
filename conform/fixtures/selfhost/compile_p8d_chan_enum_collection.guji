# P8d-2c-3c-13: pin the collection-payload counted-enum channel ABI — the
# make-site drop hook, the per-send active-variant switch detaching List
# storage (guji_copy_arr) and BOTH paired Map arrays, bound-unwrap retain, and
# the held carrier's tag-guarded scope-exit field release (the leak fix: held
# Option[E] carriers now release their adopted payload).
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "sizeof(Pack), guji_chan_drop_Pack") == 1)
            print(count_of($c, "static void guji_chan_drop_Pack") == 1)
            print(count_of($c, ".tag = guji_chan_send(") == 3)
            print(count_of($c, ".tag = guji_chan_recv(") == 2)
            print(count_of($c, ".l.data = guji_copy_arr(") == 6)
            print(count_of($c, ".keys = (const char**)guji_copy_arr(") == 3)
            print(count_of($c, ".vals = guji_copy_arr(") == 3)
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 2)
            print(count_of($c, "guji_retain_Pack_fields(&") == 2)
            print(count_of($c, "guji_release_Pack_fields(&") == 9)
            print(count_of($c, ".tag != 0LL) \{ guji_release_Pack_fields(&") == 1)
            0
        }
    }
}
