# I8d bootstrap fixture: inspect C emitted for an owned mixed-enum Handle slot.
import lexer

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(split($c, "guji_reader_t*").count() > 1)
            print(split($c, "guji_retain((const void*)p->f0.p);").count() > 1)
            print(split($c, "guji_release((const void*)p->f0.p);").count() > 1)
            print(split($c, "((guji_reader_t*)").count() > 1)
            0
        }
    }
}
