# P8d-2c-3c-11: pin flat Result channel element ABI — res typedef, opt_res
# recv wrapper, Str-arm drop hook, sizeof+drop make, copy-on-send, and the
# retain-out/release-outer extraction used by fresh recv unwrap.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "} guji_res_int_str;") == 1)
            print(count_of($c, "} guji_opt_res_int_str;") == 1)
            print(count_of($c, "static void guji_chan_drop_res_int_str") == 1)
            print(count_of($c, "sizeof(guji_res_int_str), guji_chan_drop_res_int_str") == 4)
            print(count_of($c, "sizeof(guji_res_int_int), NULL") == 1)
            print(count_of($c, ".tag = guji_chan_send(") == 11)
            print(count_of($c, ".tag = guji_chan_recv(") == 10)
            print(count_of($c, ".err = guji_str_copy(") == 9)
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 10)
            # Drop-hook Err(Str) release — avoid `{...}` inside the needle
            # (guji string interpolation would evaluate it).
            print(count_of($c, "guji_release(v.err);") >= 1)
            0
        }
    }
}
