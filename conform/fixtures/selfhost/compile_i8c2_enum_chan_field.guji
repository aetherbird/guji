# I8c2 bootstrap fixture: inspect the C emitted for the mixed enum channel slot.
import lexer

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(split($c, "guji_chan_t*").count() > 1)
            print(split($c, "guji_chan_retain((guji_chan_t*)").count() > 1)
            print(split($c, "guji_chan_release((guji_chan_t*)").count() > 1)
            print(split($c, "((guji_chan_t*)").count() > 1)
            0
        }
    }
}
