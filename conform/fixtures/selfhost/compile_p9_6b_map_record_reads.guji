# gujiconform - selfhost slice 6 P9-6b nominal map value reads.
# Class/enum values read through `%map{key}` need their concrete inferred kind
# and an owned field retain before the map and local are released independently.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, "guji_arr_alloc(GUJI_KIND_Tag_ARR"))
            print(has_text($c, "guji_retain_Tag_fields(&ge"))
            print(has_text($c, "guji_arr_alloc(GUJI_KIND_Person_ARR"))
            print(has_text($c, "guji_retain_Person_fields(&gc"))
            print(has_text($c, "map key not found"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
