# gujiconform - selfhost slice 6 P2c compiler codegen fixture.
# Pins §15.5 Result `map_err` carrier-producing lowering over a bound Result
# local — the polarity swap of `map`. The fresh Result temp is zeroed; the Err
# arm binds the source `.err`, lowers the callback body, and fills
# `.tag = 1`/`.err = <body>`. The Ok arm copies `.ok` and retains it when the
# Ok slot is Str.
import lexer

sub has_text($s: Str, $needle: Str): Bool {
    split($s, $needle).count() > 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Ok($c) {
            print("codegen-ok")
            print(has_text($c, ".tag != 0) \{"))
            print(has_text($c, ".err;"))
            print(has_text($c, ".tag = 1; gr"))
            print(has_text($c, ".ok = gv"))
            print(has_text($c, "guji_retain(gr"))
            0
        }
        Err($e) {
            note($e)
            1
        }
    }
}
