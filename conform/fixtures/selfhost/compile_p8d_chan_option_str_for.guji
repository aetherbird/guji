# P8d-2c-3c-15: pin Option[Str] carrier-for adoption/release and held-carrier
# unwrap ownership in the selfhost compiler's emitted C.
import lexer

sub count_of($s: Str, $needle: Str): Int {
    split($s, $needle).count() - 1
}

sub main(): Int {
    match lexer::compile_program_c(stdin.slurp()) {
        Err($e) { note($e) 1 }
        Ok($c) {
            print(count_of($c, "sizeof(guji_opt_str), guji_chan_drop_opt_str") == 2)
            print(count_of($c, ".tag = guji_chan_recv(") == 2)
            print(count_of($c, "= (guji_opt_str)\{0};") == 1)
            print(count_of($c, "guji_panic(\"unwrap on None\")") == 4)
            print(count_of($c, ".val.val = NULL; }") == 1)
            0
        }
    }
}
