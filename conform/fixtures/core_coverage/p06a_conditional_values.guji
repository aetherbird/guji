# P06a: statement/value if, scalar match values, and ordered guards.
sub describe($number: Int): Str {
    match $number {
        $n if $n < 0 { "negative" }
        0 { "zero" }
        $n if $n < 10 { "small" }
        _ { "large" }
    }
}

sub main(): Int {
    if true { print("statement if") }
    $chosen = if 4 > 2 { 7 } else { 9 }
    print($chosen)
    print(describe(-2))
    print(describe(0))
    print(describe(5))
    print(describe(20))
    0
}
