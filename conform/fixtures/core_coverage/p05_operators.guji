# P05: precedence, comparisons, concatenation, ranges, and short circuiting.
sub reached(): Bool {
    print("right")
    true
}

sub main(): Int {
    print(!false)
    print(-3)
    print(2 + 3 * 4)
    print(2 ** 3 ** 2)
    print(10 - 2 - 3)
    print(7 / 3)
    print(0 - 7 % 3)
    print(3 < 4 && 4 <= 4 && 5 != 6)
    print("ab" ~ "cd")

    print(false && reached())
    print(true || reached())
    print(true && reached())

    mut $inclusive = ""
    for $n in 2..4 { $inclusive = $inclusive ~ "{ $n }" }
    mut $half_open = ""
    for $n in 2..<4 { $half_open = $half_open ~ "{ $n }" }
    print($inclusive)
    print($half_open)
    0
}
