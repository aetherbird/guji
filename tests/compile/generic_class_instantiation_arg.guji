# A NON-generic sub whose parameter is typed as a fully-concrete generic CLASS
# instantiation must accept a matching generic class constructor directly at the
# call site. This covers the Pair[Str, Int] counterpart to the enum-param
# fixture; expected output is the interpreter/spec answer.

class Pair[A, B] {
    has $.first: A
    has $.second: B
}

sub label($p: Pair[Str, Int]): Str {
    "{ $p.first }:{ $p.second }"
}

sub flip_label($p: Pair[Int, Str]): Str {
    "{ $p.first }/{ $p.second }"
}

sub main(): Unit {
    print(label(Pair(first: "n", second: 7)))
    print(flip_label(Pair(first: 3, second: "days")))
}
