sub some_int($x: Int): Option[Int] { Some($x) }
sub none_int(): Option[Int] { None }
sub ok_int($x: Int): Result[Int, Str] { Ok($x) }
sub err_int($m: Str): Result[Int, Str] { Err($m) }

sub main(): Int {
    $s = some_int(5)
    $n = none_int()
    print("some.is_some: { $s.is_some() }")
    print("some.is_none: { $s.is_none() }")
    print("none.is_some: { is_some($n) }")
    print("none.is_none: { is_none($n) }")
    print("some.unwrap_or: { $s.unwrap_or(0) }")
    print("none.unwrap_or: { $n.unwrap_or(99) }")
    print("some.unwrap: { $s.unwrap() }")
    $ev = $s.expect("need a value")
    print("some.expect: { $ev }")

    $r = ok_int(7)
    $e = err_int("boom")
    print("ok.is_ok: { $r.is_ok() }")
    print("ok.is_err: { $r.is_err() }")
    print("err.is_ok: { is_ok($e) }")
    print("err.is_err: { is_err($e) }")
    print("ok.unwrap_or: { $r.unwrap_or(0) }")
    print("err.unwrap_or: { $e.unwrap_or(42) }")
    print("ok.unwrap: { $r.unwrap() }")
    $rv = $r.expect("need ok")
    print("ok.expect: { $rv }")
    0
}
