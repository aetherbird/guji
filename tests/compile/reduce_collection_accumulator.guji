# A-reduce-collection-accumulator: reduce may fold into a List or Map
# accumulator. The accumulator owns a heap-backed collection handle across
# iterations; each body result is copied before the prior accumulator is
# released, so identity folds and set/map-producing folds stay memory-safe.
sub main(): Unit {
    @nums = [1, 2, 3]
    @last = @nums.reduce([0], sub(@acc, $n) {
        @acc.map(sub($x) { $x + $n })
    })
    print(@last)

    @rows = [[1], [2, 3], []]
    @identity = @rows.reduce([[0]], sub(@acc, @row) {
        @acc.map(sub(@r) { @r })
    })
    print(@identity)

    %labels = @nums.reduce({"seed": [0]}, sub(%acc, $n) {
        %acc.set("k{ $n }", [$n, $n + 1])
    })
    print(%labels)

    @maps = [{"a": 1}, {"b": 2, "c": 3}]
    %merged = @maps.reduce({"seed": ["x"]}, sub(%acc, %m) {
        %acc.set("keys{ %m.keys().count() }", %m.keys())
    })
    print(%merged)
}
