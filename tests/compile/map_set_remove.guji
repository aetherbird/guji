sub main(): Int {
    %m = { "b": 2, "a": 1 }
    # set a new key (method form), then a replacement (ordinary form)
    %m2 = %m.set("c", 3)
    %m3 = set(%m, "a", 9)
    # remove an existing key (method form) and an absent key (ordinary form)
    %m4 = %m2.remove("a")
    %m5 = remove(%m, "z")
    mut $out = ""
    for $k, $v in %m2 {
        $out = $out ~ "{ $k }{ $v }"
    }
    $out = $out ~ "|"
    for $k, $v in %m3 {
        $out = $out ~ "{ $k }{ $v }"
    }
    $out = $out ~ "|"
    for $k, $v in %m4 {
        $out = $out ~ "{ $k }{ $v }"
    }
    $out = $out ~ "|"
    for $k, $v in %m5 {
        $out = $out ~ "{ $k }{ $v }"
    }
    $out = $out ~ "|"
    # value-type generality: a Str-valued map
    %s = { "x": "hi" }
    %s2 = %s.set("y", "yo")
    for $sk, $sv in %s2 {
        $out = $out ~ "{ $sk }{ $sv }"
    }
    print($out)
    0
}
