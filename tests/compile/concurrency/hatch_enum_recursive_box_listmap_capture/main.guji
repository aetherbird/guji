# Section 17 hatch capture for recursive-box enums whose boxed variants ALSO
# carry flat List/Map payload fields (H4c-rest slice).
#
# Capturing Chain into a hatched task clones the boxed child graph into the task
# heap; guji_clone_<E>_value detaches each node's flat List[Int] and Map[Str, Str]
# fields too, so the task owns a fully independent copy. The task folds the chain
# and sends scalar/Str results back, then exits; its adopted clone must release
# independently from the parent's original chain (ASan/LSan clean).
enum Chain {
    End
    Link($vals: List[Int], $tags: Map[Str, Str], $next: Chain)
}

sub total($c: Chain): Int {
    match $c {
        End { 0 }
        Link($v, _, $n) {
            mut $s = 0
            for $x in $v {
                $s = $s + $x
            }
            $s + total($n)
        }
    }
}

sub tags($c: Chain): Str {
    match $c {
        End { "" }
        Link(_, $t, $n) {
            $head = $t{"k"}
            $head ~ tags($n)
        }
    }
}

sub main(): Unit {
    @a = [1, 2]
    %ta = {"k": "x"}
    @b = [3, 4]
    %tb = {"k": "y"}
    $c = Link(@a, %ta, Link(@b, %tb, End))
    $total_ch: Chan[Int] = channel(0)
    $tag_ch: Chan[Str] = channel(0)

    hatch {
        $total_ch.send(total($c))
        $tag_ch.send(tags($c))
    }

    print("{ $total_ch.recv().unwrap() }")
    print($tag_ch.recv().unwrap())
    print("{ total($c) }")
    print(tags($c))
}
