# Section 17 native channel send/recv for nested-value-map-payload enums
# (H4c-rest slice).
#
# A variant carrying Map[Str, List[Int]] or Map[Str, Map[Str, Int]] holds a map
# whose value array is itself a counted container (ARR_SLICE / ARR_MAP). A bare
# struct copy would ALIAS the sender's outer key/value arrays AND the nested
# list/map storage. hatchCopyEnum now deep-copies each active Map field with
# hatchCopyMap, which recurses into the nested rows, so the receiver shares no
# map-, list-, or key/value-string storage with the sender's per-task heap.
# The second buffered message (a Grid variant) is left undelivered so
# LeakSanitizer proves the per-enum channel drop (guji_chan_drop_<E> ->
# guji_release_<E>_fields releasing both counted arrays, whose kind-tagged drop
# cascades into the nested storage) frees the undelivered copy. Values are read
# by fixed keys/indices, so output is deterministic.
enum Rec {
    Buckets($b: Map[Str, List[Int]])
    Grid($g: Map[Str, Map[Str, Int]])
    Done
}

sub show($r: Rec): Str {
    match $r {
        Buckets($b) {
            $sum = $b{"evens"}[0] + $b{"evens"}[1] + $b{"odds"}[0]
            "sum={ $sum }"
        }
        Grid($g) {
            $n = $g{"left"}{"x"} + $g{"left"}{"y"}
            "n={ $n }"
        }
        Done { "done" }
    }
}

sub main(): Unit {
    $ch: Chan[Rec] = channel(2)
    %buckets = {"evens": [2, 4], "odds": [1, 3]}
    %grid = {"left": {"x": 10, "y": 20}, "right": {"x": 5}}
    $first = Buckets(%buckets)
    $drop = Grid(%grid)

    hatch {
        $ch.send($first)
        $ch.send($drop)
    }

    $got = $ch.recv().unwrap()
    print(show($got))
}
