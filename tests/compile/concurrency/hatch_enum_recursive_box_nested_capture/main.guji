# Section 17 hatch capture for recursive-box enums whose boxed variants carry
# NESTED List/Map payload fields (H4c-rest slice).
#
# Each Link node stores a List[Map[Str, Int]] of rows, a Map[Str, List[Int]] of
# buckets, AND a boxed Chain child — the two nested families not exercised by the
# channel fixture (List[Map] and Map[List]). Capturing Chain into a hatched task
# clones the boxed child graph into the task heap; guji_clone_<E>_value's
# nested-detach copies each node's outer arrays AND every inner row's storage, so
# the task owns a fully independent copy. The adopted clone releases independently
# from the parent's original chain (ASan/LSan clean).
enum Chain {
    End
    Link($rows: List[Map[Str, Int]], $buckets: Map[Str, List[Int]], $next: Chain)
}

sub rowsum($c: Chain): Int {
    match $c {
        End { 0 }
        Link($r, _, $n) {
            mut $s = 0
            for $row in $r {
                $v = $row{"k"}
                $s = $s + $v
            }
            $s + rowsum($n)
        }
    }
}

sub bucketsum($c: Chain): Int {
    match $c {
        End { 0 }
        Link(_, $b, $n) {
            $lst = $b{"k"}
            mut $s = 0
            for $x in $lst {
                $s = $s + $x
            }
            $s + bucketsum($n)
        }
    }
}

sub main(): Unit {
    @r1 = [{"k": 1}, {"k": 2}]
    %b1 = {"k": [3, 4]}
    @r2 = [{"k": 5}]
    %b2 = {"k": [6]}
    $c = Link(@r1, %b1, Link(@r2, %b2, End))
    $row_ch: Chan[Int] = channel(0)
    $bkt_ch: Chan[Int] = channel(0)

    hatch {
        $row_ch.send(rowsum($c))
        $bkt_ch.send(bucketsum($c))
    }

    print("{ $row_ch.recv().unwrap() }")
    print("{ $bkt_ch.recv().unwrap() }")
    print("{ rowsum($c) }")
    print("{ bucketsum($c) }")
}
