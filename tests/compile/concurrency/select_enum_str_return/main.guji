# Section 17.5 select recv over a Str-payload enum, returning from inside the
# selected arm. LeakSanitizer proves the adopted Option[Msg].val payload is
# released by frame cleanup on that early return path.
enum Msg {
    Text($s: Str)
    Pair($a: Str, $b: Str)
    Done
}

sub show($m: Msg): Str {
    match $m {
        Text($s) { $s }
        Pair($a, $b) { $a ~ "/" ~ $b }
        Done { "done" }
    }
}

sub main(): Int {
    $ch: Chan[Msg] = channel(1)
    $ch.send(Pair("left" ~ "-one", "right" ~ "-two"))

    select {
        $v = $ch.recv() {
            if $v.is_some() {
                $m = $v.unwrap()
                print(show($m))
            } else {
                print("closed")
            }
            return 0
        }
    }
    1
}
