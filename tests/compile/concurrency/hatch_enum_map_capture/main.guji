# Section 17 hatch capture of Map-payload enum bindings (H4c-rest slice).
#
# An enum whose variant carries Map[Str, Int] or Map[Str, Str] is a flat by-value
# struct, but its two map-storage handles (and, for Map[Str, Str], each key/value
# string) are counted heap pointers; a bare struct copy would ALIAS the parent
# heap under non-atomic per-task RC. hatchCopyEnum struct-copies then deep-copies
# each active Map field with hatchCopyMap, so the task owns a fully detached value
# and releases it (guji_release_<E>_fields) at task exit — leak/UAF-clean.
#
# Deterministic: each hatch decodes its captured enum by indexing fixed keys and
# sends one Str over its OWN unbuffered channel; the parent recvs in fixed order.
enum Bag {
    Counts($c: Map[Str, Int])
    Labels($l: Map[Str, Str])
    Empty
}

sub main(): Int {
    mut $base = 5
    $counts = Counts({"a": $base, "b": 7})
    $labels = Labels({"x": "foo", "y": "bar"})
    $intCh: Chan[Str] = channel(0)
    $strCh: Chan[Str] = channel(0)

    # Capture a Map[Str, Int]-payload variant and read it inside the task.
    hatch {
        mut $s = ""
        $s = match $counts {
            Counts($c) {
                $sum = $c{"a"} + $c{"b"}
                "sum={ $sum }"
            }
            Labels($l) { "labels" }
            Empty { "empty" }
        }
        $intCh.send($s)
    }

    # Capture a Map[Str, Str]-payload variant and join it inside the task.
    hatch {
        mut $s = ""
        $s = match $labels {
            Counts($c) { "counts" }
            Labels($l) { $l{"x"} ~ $l{"y"} }
            Empty { "empty" }
        }
        $strCh.send($s)
    }

    # Mutate the parent-side source after spawn; the tasks must observe their
    # detached copies, not the rebind.
    $base = 999
    print($intCh.recv().unwrap())
    print($strCh.recv().unwrap())
    0
}
