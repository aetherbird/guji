# Section 17 hatch capture of a Map[Str, Int] binding.
#
# A Map crossing a hatch boundary must deep-copy its key array (always counted
# Str slots) and its value array into the task heap. Retaining the parent map's
# storage would share non-atomic RC heap pointers across per-task heaps. This
# fixture iterates the captured map and indexes it in the task; the parent
# rebinds its own source scalar after spawn so the task must observe its detached
# copy and the sanitizer gate must see balanced drops (keys + vals freed once).
sub main(): Int {
    mut $base = 10
    %m = {"a": $base, "b": 20, "c": 30}
    $ch: Chan[Int] = channel(0)

    hatch {
        mut $sum = 0
        for $k, $v in %m {
            $sum = $sum + $v
        }
        $ch.send($sum + %m{"a"})
    }

    $base = 999
    print($ch.recv().unwrap())
    0
}
