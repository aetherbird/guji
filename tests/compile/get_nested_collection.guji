# A-get-find: `.get(i)` / `.get(k)` over a List[List]/List[Map] receiver, and
# over a Map[Str, List]/Map[Str, Map] value, now returns Option[List]/Option[Map]
# instead of rejecting. The Some payload is the borrowed source row; the carrier
# owns a +1 on the row's counted storage (retained on the hit path) and releases
# it like any returned collection-payload carrier — match BORROWS it. The
# interpreter is the semantic oracle; the sanitizer/leak gate is the memory one.

sub main(): Unit {
    # List[List[Int]] receiver: in-range Some(row), out-of-range None.
    @rows = [[1, 2, 3], [4, 5], [6]]
    print(match @rows.get(0) { Some(@r) { sum(@r) } None { -1 } })   # 6
    print(match @rows.get(1) { Some(@r) { count(@r) } None { -1 } })  # 2
    print(match @rows.get(9) { Some(@r) { sum(@r) } None { -1 } })   # -1
    print(match get(@rows, 2) { Some(@r) { sum(@r) } None { -1 } })  # 6 (data-first)

    # Depth-3 List[List[List[Int]]]: the borrowed row is itself a List[List[Int]].
    @deep = [[[1, 2], [3]], [[4]]]
    print(match @deep.get(0) {
        Some(@r) { @r.reduce(0, sub($a, @inner) { $a + @inner.sum() }) }
        None { -1 }
    })   # 6

    # List[Map[Str, Int]] receiver: the borrowed row is a Map.
    @recs = [{"a": 1, "b": 2}, {"c": 3}]
    print(match @recs.get(0) { Some(%m) { count(keys(%m)) } None { -1 } })  # 2
    print(match @recs.get(1) {
        Some(%m) { match %m.get("c") { Some($v) { $v } None { -9 } } }
        None { -1 }
    })   # 3

    # Map[Str, List[Int]] value: get(key) returns Option[List[Int]].
    %byname = {"odds": [1, 3, 5], "evens": [2, 4]}
    print(match %byname.get("odds") { Some(@xs) { sum(@xs) } None { -1 } })   # 9
    print(match %byname.get("evens") { Some(@xs) { count(@xs) } None { -1 } })  # 2
    print(match %byname.get("missing") { Some(@xs) { sum(@xs) } None { -1 } })  # -1

    # Map[Str, Map[Str, Int]] value: get(key) returns Option[Map[Str, Int]].
    %nested = {"first": {"x": 10, "y": 20}, "second": {"z": 30}}
    print(match %nested.get("first") {
        Some(%inner) { match %inner.get("y") { Some($v) { $v } None { -9 } } }
        None { -1 }
    })   # 20
    print(match %nested.get("nope") { Some(%inner) { count(keys(%inner)) } None { -1 } })  # -1

    # Str-leaf rows: releasing the carrier cascades the inner Str releases.
    @words = [["alpha", "beta"], ["gamma"]]
    print(match @words.get(0) { Some(@r) { count(@r) } None { -1 } })  # 2

    # Discarded carrier results must free their +1, not leak.
    @rows.get(0)
    %byname.get("odds")
    print(0)
}
